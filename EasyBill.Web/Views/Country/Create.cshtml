@using EasyBill.Models.ViewModels
@model CountryVM
<style>
    .card-header {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    .custom-header th {
        background-color: #2b6ac9 !important;
        color: white !important;
        border-color: #2b6ac9 !important;
    }
</style>


<div class="card mb-3">
        <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
            Add Country
    </div>
    <div class="card-body">
        <form method="post" asp-controller="Country" asp-action="Create">
            <div class="row">

                <div class="col-md-6 d-flex align-items-center mb-2">
                    <div class="col-md-2">
                        <label asp-for="Name" class="me-2 mb-0" style="width: 100px;">
                            Name
                            <span class="text-danger">*</span>
                        </label>
                    </div>
                    <div class="col-md-10">
                        <input type="text" asp-for="Name" class="form-control form-control-sm" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>

            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="submit" class="btn btn-sm btn-primary btnBright-Sky-Blue">Save</button>
                <a asp-controller="Country" asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
            </div>
           
        </form>
    </div>
</div>