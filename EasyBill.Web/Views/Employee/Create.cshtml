@using EasyBill.Models.ViewModels
@model EmployeeVM

<div class="card mb-3">
    <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
        Add Employee
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" id="Employeefrom">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Name & Initials -->
            <div class="row mb-2 align-items-center">
                <label asp-for="Name" class="col-md-4 col-form-label text-start small">
                    Name <i class="text-danger">*</i>
                </label>
                <div class="col-md-1">
                    <select asp-for="Initials" asp-items="Html.GetEnumSelectList<Initials>()" id="initials" class="form-control form-control-sm">
                        <option value="">Select</option>
                    </select>

                    <span asp-validation-for="Initials" class="text-danger small"></span>
                </div>
                <div class="col-md-7">
                    <input asp-for="Name" id="Name" type="text" class="form-control form-control-sm" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
            </div>

            <!-- Department -->
            <div class="row mb-2 align-items-center">
                <label asp-for="DepartMentId" class="col-md-4 col-form-label text-start small">
                    Department <i class="text-danger">*</i>
                </label>
                <div class="col-md-8 d-flex align-items-center">
                    <select asp-for="DepartMentId" asp-items="@ViewBag.Department" id="DepartMentId" class="form-select form-select-sm" required>
                        <option value="">-- Select Department --</option>
                    </select>
                    <div class="shortcut-box">
                        <span id="btnF2Dept" class="shortcut-link">F2 - New</span>
                        <span id="btnF3Dept" class="shortcut-link text-danger">F3 - Mod</span>
                    </div>
                    <span asp-validation-for="DepartMentId" class="text-danger small"></span>
                </div>
            </div>

            <!-- Designation -->
            <div class="row mb-2 align-items-center">
                <label asp-for="DesignationId" class="col-md-4 col-form-label text-start small">
                    Designation <i class="text-danger">*</i>
                </label>
                <div class="col-md-8 d-flex align-items-center">
                    <select asp-for="DesignationId" asp-items="@ViewBag.Designation" id="DesignationId" class="form-select form-select-sm" required>
                        <option value="">-- Select Designation --</option>
                    </select>
                    <div class="shortcut-box">
                        <span id="btnF2Desig" class="shortcut-link">F2 - New</span>
                        <span id="btnF3Desig" class="shortcut-link text-danger">F3 - Mod</span>
                    </div>
                    <span asp-validation-for="DesignationId" class="text-danger small"></span>
                </div>
            </div>

            <!-- Email -->
            <div class="row mb-2 align-items-center">
                <label asp-for="Email" class="col-md-4 col-form-label text-start small">
                    Email <i class="text-danger">*</i>
                </label>
                <div class="col-md-8">
                    <input asp-for="Email" type="email" id="Email" class="form-control form-control-sm" oninput="validateEmail()" required />
                    <span id="emailError" class="text-danger small"></span>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <!-- Phone -->
            <div class="row mb-2 align-items-center">
                <label asp-for="Phone" class="col-md-4 col-form-label text-start small">
                    Phone <i class="text-danger">*</i>
                </label>
                <div class="col-md-8">
                    <input asp-for="Phone" id="phoneNo" class="form-control form-control-sm" maxlength="10" oninput="validateMobile(this)" required />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                    <small id="PhoneMessage" class="text-danger"></small>
                </div>
            </div>

            <!-- Required Creditional -->
            <div class="row mb-2 align-items-center">
                <label asp-for="RequiredCreditional" class="col-md-4 col-form-label text-start small">
                    Required Creditional
                </label>
                <div class="col-md-8">
                    <input asp-for="RequiredCreditional" id="requiredCreditional" class="flaticon-checked" />
                </div>
            </div>

            <!-- Role Section (conditionally visible) -->
            <div class="row mb-2 align-items-center" id="roleSection" style="display:none">
                <label asp-for="RoleId" class="col-md-4 col-form-label text-start small">
                    Role <i class="text-danger">*</i>
                </label>
                <div class="col-md-8">
                    <select asp-for="RoleId" asp-items="@Model.RoleList" class="form-select form-select-sm" required>
                        <option selected disabled>select</option>
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger small"></span>
                </div>
            </div>

            <!-- Submit Buttons -->
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="submit" class="btn btn-sm btn-primary btnBright-Sky-Blue">Submit</button>
                <a asp-controller="Employee" asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<!-- ===== DEPARTMENT MODAL ===== -->
<div class="modal fade" id="deptModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <h4 class="modal-title" id="deptModalTitle">Add Department</h4>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalDeptId" value="0" />
                <label>Name</label>
                <input type="text" id="modalDeptName" class="form-control modal-input" />
                <span id="deptError" class="text-danger small modal-error"></span>
            </div>
            <div class="modal-footer">
                <button class="btn btn-success btn-sm px-4" id="btnSaveDept">Save</button>
                <button class="btn btn-danger btn-sm px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== DESIGNATION MODAL ===== -->
<div class="modal fade" id="desigModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <h4 class="modal-title" id="desigModalTitle">Add Designation</h4>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalDesigId" value="0" />
                <label>Name</label>
                <input type="text" id="modalDesigName" class="form-control modal-input" />
                <span id="desigError" class="text-danger small modal-error"></span>
            </div>
            <div class="modal-footer">
                <button class="btn btn-success btn-sm px-4" id="btnSaveDesig">Save</button>
                <button class="btn btn-danger btn-sm px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<link href="~/css/page.css" rel="stylesheet" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            $("#EmployeeForm").on("submit", function (e) {
                e.preventDefault();
                var form = this;

                var name = $("#Name").val().trim();
                var deptId = $("#DepartMentId").val();
                var desigId = $("#DesignationId").val();
                var email = $("#Email").val().trim();
                var phone = $("#Phone").val().trim();

                if (!name || !deptId || !desigId || !email || !phone) {
                    Swal.fire("Error", "All fields are required!", "error");
                    return;
                }

                $.ajax({
                    url: '/Employee/CheckDuplicate',
                    type: 'GET',
                    data: { name: name, departmentId: deptId, designationId: desigId, email: email, phoneNo: phone },
                    success: function (resp) {
                        if (resp.exists) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Duplicate Found',
                                html: resp.message,
                                confirmButtonText: 'OK'
                            });
                        } else {
                            form.submit();
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Duplicate check failed!", "error");
                    }
                });
            });
        });
    </script>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const checkbox = document.getElementById("requiredCreditional");
        const roleSection = document.getElementById("roleSection");

        function toggleRoleSection() {
            roleSection.style.display = checkbox.checked ? "flex" : "none";
        }
        checkbox.addEventListener("change", toggleRoleSection);
    });
</script>
<script>
    $(document).ready(function () {
          $("#emailAddress").on("blur", function () {
            var email = $(this).val().trim();
            if (email === "") return;
            $.ajax({
                url: '/Employee/CheckEmailAddress',
                type: 'GET',
                data: { email: email, id:0 },
                success: function (response) {
                    if (response.exists) {
                        $("#emailMessage").text(email + " is already registered.");
                        $("#emailAddress").val('').focus();
                    } else {
                        $("#emailMessage").text('');
                    }
                },
                error: function () {
                    $("#emailMessage").text("An error occurred. Please try again.");
                }
            });
        });
        $("#phoneNo").on("blur", function () {
            var phoneNo = $(this).val().trim();
            if (phoneNo === "") return;
            $.ajax({
                url: '/Employee/CheckPhoneNo',
                type: 'GET',
                data: { phoneNo: phoneNo, id:0 },
                success: function (response) {
                    if (response.exists) {
                        $("#PhoneMessage").text( phoneNo + " is already registered.");
                        $("#phoneNo").val('').focus();
                    } else {
                        $("#PhoneMessage").text('');
                    }
                },
                error: function () {
                    $("#PhoneMessage").text("An error occurred. Please try again.");
                }
            });
        });

    });
     function validateEmail() {
        let email = document.getElementById("Email").value;
        let msg = "";

             const pattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;


        if (email.length === 0) {
            msg = "";
        }
        else if (!pattern.test(email)) {
            msg = "Invalid email format";
        }

        document.getElementById("emailError").innerText = msg;
    }
</script>
<script>
    function validateMobile(el) {
        const errorBox = document.getElementById("PhoneMessage");
        el.value = el.value.replace(/[^0-9]/g, "");

        errorBox.textContent = "";

        if (el.value.length === 0) {
            return false;
        }

        if (!/^[6-9]\d{9}$/.test(el.value)) {
            errorBox.textContent = "Please enter your mobile number.";
            return false;
        }

        return true;
    }
     let isDuplicate = false;

    function CheckDuplicate() {

        let name = $("#Name").val();
        let phone = $("#MobileNo").val();

        $.ajax({
            url: '/Employee/CheckDuplicate',
            type: 'GET',
            data: { name: name },
            success: function (res) {

                if (res.exists) {
                    isDuplicate = true;

                    $("#Name").addClass("is-invalid").removeClass("is-valid");

                }
                else {
                    isDuplicate = false;

                    $("#Name").addClass("is-valid").removeClass("is-invalid");

                }
            }
        });
    }
     $("#Name").on("blur", function () {
         CheckDuplicate();
     });

    $("form").on("submit", function (e) {

        if (isDuplicate) {
            e.preventDefault();
            alert("Duplicate record found! Cannot save.");
            return false;
        }

    });

</script>
<script>
    $(document).ready(function () {

        $("#Employeefrom").on("submit", function (e) {

            e.preventDefault();
            let form = this;

            Swal.fire({
                title: 'Confirm Save?',
                text: 'Do you want to save this Country?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#198754',
                cancelButtonColor: '#dc3545',
                reverseButtons: true,
                focusConfirm: true,
                buttonsStyling: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $("#Employeefrom").off("submit");
                    form.submit();
                }
            });

        });

        // ==========================================
        //          F2 / F3 — DEPARTMENT
        // ==========================================
        $("#btnF2Dept").click(() => openDeptModal("new"));
        $("#btnF3Dept").click(() => openDeptModal("edit"));

        function openDeptModal(mode) {
            $("#deptError").text("");
            if (mode === "new") {
                $("#modalDeptId").val(0);
                $("#modalDeptName").val("");
                $("#deptModalTitle").text("Add Department");
            } else {
                let id = $("#DepartMentId").val();
                let text = $("#DepartMentId option:selected").text();
                if (!id) { Swal.fire("Error", "Select department first!", "error"); return; }
                $("#modalDeptId").val(id);
                $("#modalDeptName").val(text);
                $("#deptModalTitle").text("Modify Department");
            }
            $("#deptModal").modal("show");
            setTimeout(() => { $("#modalDeptName").focus(); }, 200);
        }

        $("#btnSaveDept").click(function () {
            let id = $("#modalDeptId").val();
            let name = $("#modalDeptName").val().trim();
            if (!name) { $("#deptError").text("Name required!"); return; }

            $.post('/Employee/QuickSaveDepartment', { id: id, name: name }, function (res) {
                if (res.success) {
                    $("#deptModal").modal('hide');
                    $.get('/Employee/GetDepartments', function (data) {
                        let ddl = $("#DepartMentId");
                        ddl.empty();
                        ddl.append('<option value="">-- Select Department --</option>');
                        $.each(data, function (i, item) {
                            let opt = $('<option>', { value: item.value, text: item.text });
                            if (item.value == res.newId) opt.attr('selected', 'selected');
                            ddl.append(opt);
                        });
                    });
                } else {
                    $("#deptError").text(res.message);
                }
            });
        });

        // ==========================================
        //          F2 / F3 — DESIGNATION
        // ==========================================
        $("#btnF2Desig").click(() => openDesigModal("new"));
        $("#btnF3Desig").click(() => openDesigModal("edit"));

        function openDesigModal(mode) {
            $("#desigError").text("");
            if (mode === "new") {
                $("#modalDesigId").val(0);
                $("#modalDesigName").val("");
                $("#desigModalTitle").text("Add Designation");
            } else {
                let id = $("#DesignationId").val();
                let text = $("#DesignationId option:selected").text();
                if (!id) { Swal.fire("Error", "Select designation first!", "error"); return; }
                $("#modalDesigId").val(id);
                $("#modalDesigName").val(text);
                $("#desigModalTitle").text("Modify Designation");
            }
            $("#desigModal").modal("show");
            setTimeout(() => { $("#modalDesigName").focus(); }, 200);
        }

        $("#btnSaveDesig").click(function () {
            let id = $("#modalDesigId").val();
            let name = $("#modalDesigName").val().trim();
            if (!name) { $("#desigError").text("Name required!"); return; }

            $.post('/Employee/QuickSaveDesignation', { id: id, name: name }, function (res) {
                if (res.success) {
                    $("#desigModal").modal('hide');
                    $.get('/Employee/GetDesignations', function (data) {
                        let ddl = $("#DesignationId");
                        ddl.empty();
                        ddl.append('<option value="">-- Select Designation --</option>');
                        $.each(data, function (i, item) {
                            let opt = $('<option>', { value: item.value, text: item.text });
                            if (item.value == res.newId) opt.attr('selected', 'selected');
                            ddl.append(opt);
                        });
                    });
                } else {
                    $("#desigError").text(res.message);
                }
            });
        });

        // ==========================================
        //          KEYBOARD SHORTCUTS
        // ==========================================
        $(document).keydown(function (e) {
            if (e.key === "F2") {
                e.preventDefault();
                if (document.activeElement === $("#DepartMentId")[0] || document.activeElement === $("#btnF2Dept")[0] || document.activeElement === $("#btnF3Dept")[0]) {
                    openDeptModal("new");
                } else {
                    openDesigModal("new");
                }
            }
            if (e.key === "F3") {
                e.preventDefault();
                if (document.activeElement === $("#DepartMentId")[0] || document.activeElement === $("#btnF2Dept")[0] || document.activeElement === $("#btnF3Dept")[0]) {
                    openDeptModal("edit");
                } else {
                    openDesigModal("edit");
                }
            }
        });

        // Enter key in modals
        $("#modalDeptName").keypress(function (e) { if (e.which === 13) { e.preventDefault(); $("#btnSaveDept").click(); } });
        $("#modalDesigName").keypress(function (e) { if (e.which === 13) { e.preventDefault(); $("#btnSaveDesig").click(); } });

    });
</script>

@if (TempData["success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: '@TempData["success"]',
            confirmButtonText: 'OK',
            confirmButtonColor: '#2b6ac9'
        });
    </script>
}