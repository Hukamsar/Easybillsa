@model List<EasyBill.Models.ViewModels.DateWiseSalesVM>

@{
    ViewBag.Title = "Date Wise Sales Report";
    int sno = 1;

    // Calculate totals for footer
    decimal totalTaxable = Model?.Sum(x => x.TaxableAmount) ?? 0;
    decimal totalGst = Model?.Sum(x => x.GstAmount) ?? 0;
    decimal totaldiscount = Model?.Sum(x => x.TotalDiscount) ?? 0;
    decimal roundoff = Model?.Sum(x => x.RoundOff) ?? 0;
    decimal totalValue = Model?.Sum(x => x.TotalValue) ?? 0;
}
<style>
    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>
<div class="card mb-3 shadow-sm">
    <div class="card-header text-white d-flex py-2" style="background:#2b6ac9">
        <span class="fw-bold">
            Date Wise Sales Summary Report
        </span>

        <span class="ms-auto">
            Total Taxable: ₹ <span class="fw-bold">@totalTaxable.ToString("0.00")</span> |
            Total Gst: ₹ <span class="fw-bold">@totalGst.ToString("0.00")</span>|
            Total Value: ₹ <span class="fw-bold">@totalValue.ToString("0.00")</span>
        </span>
    </div>


</div>

        <!-- FILTER -->
<form method="get" class="row g-3 mt-2 mb-3">
            <div class="col-md-3">
                <label>From Date</label>
                <input type="date" name="fromDate" class="form-control"
                       value="@ViewBag.FromDate" />
            </div>

            <div class="col-md-3">
                <label>To Date</label>
                <input type="date" name="toDate" class="form-control"
                       value="@ViewBag.ToDate" />
            </div>

            <div class="col-md-3 align-self-end">
        <button type="submit" class="btn text-light" style="background:#2b6ac9">
                    Search
                </button>
            </div>
        </form>
<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="ExportDateWiseSalesExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>
        <a asp-action="ExportDateWiseSalesPdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>

        <!-- REPORT TABLE -->
<div class="table-responsive">
        <table id="dateWiseSalesTbl" class="table table-bordered table-striped">
            <thead class="table-primary">
                <tr>
                    <th>S.No</th>
                    <th>Date</th>
                    <th>No Of Bills</th>
                    <th>Taxable Amount</th>
                    <th>GST Amount</th>
                    <th>Discount</th>
                    <th>Round Off</th>
                    <th>Total Value</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@sno</td>
                            <td>@item.Date.ToString("dd-MM-yyyy")</td>
                            <td>@item.NoOfBills</td>
                            <td>@item.TaxableAmount.ToString("0.00")</td>
                            <td>@item.GstAmount.ToString("0.00")</td>
                            <td>@item.TotalDiscount</td>
                            <td>@item.RoundOff</td>
                            <td class="fw-bold">@item.TotalValue.ToString("0.00")</td>
                    </tr>
                    sno++;
                }
                }
               
            </tbody>
        <tfoot class="table-secondary fw-bold">
            <tr>
                <td colspan="3" class="text-end">TOTAL</td>
                <td>@totalTaxable.ToString("0.00")</td>
                <td>@totalGst.ToString("0.00")</td>
                <td>@totaldiscount.ToString("0.00")</td>
                <td>@roundoff.ToString("0.00")</td>
                <td>@totalValue.ToString("0.00")</td>
            </tr>
        </tfoot>
        </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var t = $("#dateWiseSalesTbl").DataTable({
                "order": [[1, "desc"]],
                "columnDefs": [
                    { "orderable": false, "targets": "_all" }
                ]
            });

            t.on('order.dt search.dt', function () {
                t.column(0, { search: 'applied', order: 'applied' }).nodes()
                    .each(function (cell, i) {
                        cell.innerHTML = i + 1;
                    });
            }).draw();
        });
    </script>
}
