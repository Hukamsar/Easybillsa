@using EasyBill.Models.ViewModels
@model IEnumerable<SalesVM>
@{
    // Calculate totals for footer
    decimal totalGst = Model?.Sum(x => x.TotalGstAmt) ?? 0;
    decimal totalAmount = Model?.Sum(x => x.TotalAmount) ?? 0;
}
<style>
    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>
<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2 d-flex align-items-center"
         style="background:#2b6ac9">

        <span class="fw-bold">
            Sales Report - Bill Wise
        </span>

   
             <span class="ms-auto">
                Total GST: ₹ <span class="fw-bold">@totalGst.ToString("0.00")</span> |
            Total Amount: ₹ <span class="fw-bold">@totalAmount.ToString("0.00")</span>
        </span>
      

    </div>
</div>
<form method="get" class="card p-3 mb-3">
    <div class="row">

        <div class="col-md-2">
            <label>Date From</label>
            <input type="date"
                   id="fromDate"
                   name="fromDate"
                   class="form-control"
                   value="@ViewBag.FromDate" />
        </div>

        <div class="col-md-2">
            <label>Date To</label>
            <input type="date"
                   id="toDate"
                   name="toDate"
                   class="form-control"
                   value="@ViewBag.ToDate" />
        </div>

        <div class="col-md-2 text-end mt-3">
            <button type="submit" class="btn text-light" style="background: #2b6ac9;">
                Search
            </button>
        </div>
    </div>


</form>
<div class="row mb-2">
    <div class="col text-end">
        <i class="fa-solid fa-file-excel text-success fs-5" onclick="exportExcel()"></i>
        <i class="fa-solid fa-file-pdf text-danger fs-5" onclick="exportPdf()"></i>
    </div>
</div>

<table id="billwiseTbl" class="table table-bordered table-striped table-sm">
    <thead class="table-primary">
        <tr>
            <th>S.No</th>
            <th>Bill No</th>
            <th>Bill Date</th>
            <th>Customer</th>
            <th>GST Amount</th>
            <th>Total Amount</th>
            <th></th> <!-- ✅ clear header for button -->
        </tr>
    </thead>
    <tbody>
        @{
            int sr = 1;
        }
        @foreach (var bill in Model)
        {
            <tr>
                <td>@sr</td>
                <td>@bill.BillNo</td>
                <td>@bill.BillDate?.ToString("dd-MM-yyyy")</td>
                <td>@bill.CustomerName</td>
                <td class="text-end">@bill.TotalGstAmt.ToString("0.00")</td>
                <td class="text-end">@bill.TotalAmount</td>
                <td>
                    <a href="javascript:void(0)" class="sales-report-edit" data-url="@Url.Action("Edit", "Sales", new { id = bill.Id })" title="Edit">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                    @if (bill.HasNarcoticItem)
                    {
                        <a href="@Url.Action("NarcoticForm7", "Sales", new { billNo = bill.BillNo })"
                           class="btn btn-sm btn-outline-primary ms-1">
                            Narcotic Form 7
                        </a>
                    }
                </td>
            </tr>
            sr++;
        }
    </tbody>
    <tfoot class="table-secondary fw-bold">
        <tr>
            <td colspan="4" class="text-end">TOTAL</td>
            <td class="text-end">@ViewBag.TotalGst.ToString("0.00")</td>
            <td class="text-end">@ViewBag.TotalAmount.ToString("0.00")</td>
            <td></td> 
        </tr>
    </tfoot>
</table>

<div class="modal fade" id="salesEditReportModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header text-white py-2" style="background:#2b6ac9">
                <h6 class="modal-title mb-0">Edit Sales</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="salesEditFrame" style="width:100%;height:calc(100vh - 50px);border:0;"></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var t = $("#billwiseTbl").DataTable({
                "order": [[2, "desc"]],
                "columnDefs": [
                    { "orderable": false, "targets": "_all" }
                ]
            });

            t.on('order.dt search.dt', function () {
                t.column(0, { search: 'applied', order: 'applied' }).nodes()
                    .each(function (cell, i) {
                        cell.innerHTML = i + 1;
                    });
            }).draw();

            $(document).on("click", ".sales-report-edit", function () {
                $("#salesEditFrame").attr("src", $(this).data("url"));
                $("#salesEditReportModal").modal("show");
            });

            $("#salesEditReportModal").on("hidden.bs.modal", function () {
                $("#salesEditFrame").attr("src", "");
            });
        });

        window.addEventListener("message", function (e) {
            if (e.data && e.data.salesEditSaved) {
                $("#salesEditReportModal").modal("hide");
                window.location.reload();
            }
            if (e.data && e.data.salesEditCancel) {
                $("#salesEditReportModal").modal("hide");
            }
        });

        function exportExcel() {
            var fromDate = document.getElementById("fromDate")?.value || "";
            var toDate = document.getElementById("toDate")?.value || "";

            window.location.href =
                `/Sales/ExportBillwiseExcel?fromDate=${fromDate}&toDate=${toDate}`;
        }

        function exportPdf() {
            var fromDate = document.getElementById("fromDate")?.value || "";
            var toDate = document.getElementById("toDate")?.value || "";

            window.location.href =
                `/Sales/ExportBillwisePdf?fromDate=${fromDate}&toDate=${toDate}`;
        }

    </script>
}
