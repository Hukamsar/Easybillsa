<script>
    $(document).on("keydown",
        "#BillNo, #BillDate, #mobilenumber, #customer, #customeraddress, #doctorMobile, #doctorname, #doctorregno",
        function (e) {
            if (e.key !== "Enter") return;
            e.preventDefault();

            const id = this.id;

            switch (id) {
                case "BillNo":
                    $("#BillDate").focus();
                    break;

                case "BillDate":
                    $("#billingType").focus();
                    break;

                case "mobilenumber":
                    if (!isValidIndianMobile(this.value)) {
                        toastr.warning("Please enter valid mobile number");
                        this.focus();
                        return;
                    }
                    setTimeout(() => $("#customer").focus(), 50);
                    break;

                case "customer":
                    $("#customeraddress").focus();
                    break;

                case "customeraddress":
                    if ($("#doctorMobile").length && $("#doctorMobile").is(":visible") &&
                        !$("#doctorMobile").is(":disabled")) {
                        $("#doctorMobile").focus();
                    } else {
                        focusItemGrid();
                    }
                    break;

                case "doctorMobile":
                    $("#doctorname").focus();
                    break;

                case "doctorname":
                    $("#doctorregno").focus();
                    break;

                case "doctorregno":
                    focusItemGrid();
                    break;
            }
        }
    );

    function focusItemGrid() {
        setTimeout(() => {
            const item = $("#SalesItemBody tr:first .item-barcode");
            if (item.length) {
                item.focus().select();
            } else {
                addNewRow();
                setTimeout(() => {
                    $("#SalesItemBody tr:first .item-barcode").focus().select();
                }, 150);
            }
        }, 150);
    }

    $('#itemModal').on('hidden.bs.modal', function () {
        setTimeout(() => {
            if (currentRowForCrossItemModal && currentRowForCrossItemModal.length) {
                const itemInput = currentRowForCrossItemModal.find(".item-barcode");
                if (itemInput.length) {
                    itemInput.focus().select();
                }
            }
        }, 150);
    });
</script>

<!-- ================================================================
     🔹 KEYBOARD NAVIGATION - ITEM GRID
     ================================================================ -->
<script>
    $(document).on("keydown", ".item-barcode", function (e) {
        const row = $(this).closest("tr");

        if (e.key === "ArrowRight") {
            e.preventDefault();
            row.find(".qty").focus().select();
            return;
        }

        if (e.key === "ArrowDown") {
            e.preventDefault();
            const nextRow = row.next("tr");
            if (nextRow.length) {
                nextRow.find(".item-barcode").focus();
            }
            return;
        }

        if (e.key === "ArrowUp") {
            e.preventDefault();
            const prevRow = row.prev("tr");
            if (prevRow.length) {
                prevRow.find(".item-barcode").focus();
            }
        }
    });

    $(document).on("keydown", ".qty, .rate, .discount", function (e) {
        const row = $(this).closest("tr");
        const input = $(this);

        const isItemBarcode = input.hasClass("item-barcode");
        const isQty = input.hasClass("qty");
        const isRate = input.hasClass("rate");
        const isDiscount = input.hasClass("discount");

        if (e.key === "Enter") {
            e.preventDefault();
            if (isQty) {
                row.find(".rate").focus().select();
            } else if (isRate) {
                row.find(".discount").focus().select();
            } else if (isDiscount) {
                const itemId = row.find(".item-id").val();
                const batch = row.find(".batch").val();

                if (!itemId || !batch) {
                    toastr.warning("Please select Item and Batch before adding new row.");

                    if (!itemId) {
                        row.find(".item-barcode").focus();
                    } else if (!batch) {
                        row.find(".item-barcode").focus();
                    }
                    return;
                }

                const $qtyInput = row.find(".qty");
                const qty = parseFloat($qtyInput.val()) || 0;

                if (qty < 1) {
                    toastr.warning("Quantity cannot be less than 1.");
                    $qtyInput.focus().select();
                    return;
                }

                const isLastRow = row.is("#SalesItemBody tr:last");

                if (isLastRow) {
                    addNewRow();

                    setTimeout(() => {
                        $("#SalesItemBody tr:last .item-barcode").focus();
                    }, 150);
                } else {
                    const nextRow = row.next("tr");

                    if (nextRow.length) {
                        nextRow.find(".item-barcode").focus();
                    }
                }
            }
            return;
        }

        if (e.key === "ArrowRight") {
            e.preventDefault();
            if (isItemBarcode) row.find(".qty").focus();
            else if (isQty) row.find(".rate").focus();
            else if (isRate) row.find(".discount").focus();
            return;
        }

        if (e.key === "ArrowLeft") {
            e.preventDefault();
            if (isDiscount) row.find(".rate").focus();
            else if (isRate) row.find(".qty").focus();
            if (isQty) row.find(".item-barcode").focus();
            return;
        }

        if (e.key === "ArrowDown") {
            e.preventDefault();
            const nextRow = row.next("tr");
            if (!nextRow.length) return;

            if (isItemBarcode) nextRow.find(".item-barcode").focus();
            else if (isQty) nextRow.find(".qty").focus();
            else if (isRate) nextRow.find(".rate").focus();
            else if (isDiscount) nextRow.find(".discount").focus();
            return;
        }

        if (e.key === "ArrowUp") {
            e.preventDefault();
            const prevRow = row.prev("tr");
            if (!prevRow.length) return;
            if (isItemBarcode) prevRow.find(".item-barcode").focus();
            else if (isQty) prevRow.find(".qty").focus();
            else if (isRate) prevRow.find(".rate").focus();
            else if (isDiscount) prevRow.find(".discount").focus();
        }
    });
</script>

<!-- ================================================================
     🔹 TAB KEY - DELETE BLANK ROW & MOVE TO DISCOUNT
     ================================================================ -->
<script>
    $(document).on(
        "keydown",
        ".item-barcode, .batch, .qty, .rate, .discount",
        function (e) {

            if (e.key !== "Tab") return;

            const row = $(this).closest("tr");

            const itemName = (row.find(".item-barcode").val() || "").trim();
            const batch = (row.find(".batch").val() || "").trim();
            const qty = parseFloat(row.find(".qty").val()) || 0;
            const rate = parseFloat(row.find(".rate").val()) || 0;

            // ✅ Blank row condition
            const isBlankRow =
                itemName === "" &&
                batch === "" &&
                rate <= 0;

            if (!isBlankRow) return;

            const totalRows = $("#SalesItemBody tr").length;

            // ❌ At least one row must remain
            if (totalRows <= 1) {
                e.preventDefault();
                toastr.error("At least one item row is required");
                return;
            }

            // ✅ Remove row on TAB
            e.preventDefault();
            row.remove();

            calculateTotalSummary();
            toggleAddRowButton();

            // ✅ Move focus to Bill Discount
            setTimeout(() => {
                $("#discountPercent").focus().select();
            }, 50);
        }
    );
</script>

<!-- ================================================================
     🔹 SMART CURSOR & SELECTION MANAGEMENT
     ================================================================ -->
<script>
    // ============================================
    // 🔹 TRACK FOCUS SOURCE (Keyboard or Mouse)
    // ============================================

    // Track keyboard navigation
    $(document).on("keydown", function (e) {
        if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Enter", "Tab"].includes(e.key)) {
            lastFocusSource = "keyboard";
        }
    });

    // Track mouse clicks
    $(document).on("mousedown", "input", function (e) {
        lastFocusSource = "mouse";
    });

    // ============================================
    // 🔹 ITEM BARCODE: Always cursor at end
    // ============================================
    $(document).on("focus", ".item-barcode", function (e) {
        const input = this;
        const value = input.value;

        // Always position cursor at end of text
        setTimeout(() => {
            input.setSelectionRange(value.length, value.length);
        }, 0);
    });

    // ============================================
    // 🔹 QTY, RATE, DISCOUNT: Smart selection
    // ============================================
    $(document).on("focus", ".qty, .rate, .discount", function (e) {
        const input = this;

        setTimeout(() => {
            if (lastFocusSource === "keyboard") {
                // Keyboard navigation → Select all text
                input.select();
            }
            // Mouse click → Cursor remains at click position

            // Reset focus source
            lastFocusSource = null;
        }, 0);
    });
</script>

<!-- ================================================================
     🔹 KEYBOARD NAVIGATION - PAYMENT GRID
     ================================================================ -->
<script>

    $(document).on("keydown", ".paymentMode-dropdown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            this.click(); // ✅ allowed
        }
    });

    $(document).on("keydown",
        ".paymentMode-dropdown, .paymentAmount, .paymentReferenceNO, .paymentDescription",
        function (e) {
            const row = $(this).closest("tr");
            const input = $(this);

            const isMode = input.hasClass("paymentMode-dropdown");
            const isAmount = input.hasClass("paymentAmount");
            const isRef = input.hasClass("paymentReferenceNO");
            const isDesc = input.hasClass("paymentDescription");

            if (e.key === "Enter") {
                e.preventDefault();
                e.stopImmediatePropagation();

                const paymentMode = row.find(".paymentMode-dropdown").val();

                if (!paymentMode) {
                    row.find(".paymentMode-dropdown").focus();
                    return;
                }

                if (isMode) {
                    const amt = row.find(".paymentAmount");
                    amt.focus();
                    setTimeout(() => {
                        if (amt.val() === "0") amt.val("");
                    }, 0);
                    return;
                }

                if (isAmount) {
                    if (input.val().trim() === "") input.val("0");
                    row.find(".paymentReferenceNO").focus();
                    return;
                }

                if (isRef) {
                    row.find(".paymentDescription").focus();
                    return;
                }

                if (isDesc) {
                    const isLastRow = row.is("#PaymentDetailsBody tr:last");
                    if (!isLastRow) return;

                    const amountInput = row.find(".paymentAmount");
                    const amountVal = parseFloat(amountInput.val());

                    if (!amountVal || amountVal <= 0) {
                        amountInput.focus().select();
                        return;
                    }

                    addPaymentRow();
                    setTimeout(() => {
                        $("#PaymentDetailsBody tr:last .paymentMode-dropdown").focus();
                    }, 150);
                    return;
                }
            }

            if (e.key === "ArrowRight") {
                e.preventDefault();
                if (isMode) row.find(".paymentAmount").focus();
                else if (isAmount) row.find(".paymentReferenceNO").focus();
                else if (isRef) row.find(".paymentDescription").focus();
            }

            if (e.key === "ArrowLeft") {
                e.preventDefault();
                if (isDesc) row.find(".paymentReferenceNO").focus();
                else if (isRef) row.find(".paymentAmount").focus();
                else if (isAmount) row.find(".paymentMode-dropdown").focus();
            }

            if (e.key === "ArrowDown") {
                e.preventDefault();
                const next = row.next("tr");
                if (!next.length) return;

                if (isMode) next.find(".paymentMode-dropdown").focus();
                else if (isAmount) next.find(".paymentAmount").focus();
                else if (isRef) next.find(".paymentReferenceNO").focus();
                else if (isDesc) next.find(".paymentDescription").focus();
            }

            if (e.key === "ArrowUp") {
                e.preventDefault();
                const prev = row.prev("tr");
                if (!prev.length) return;

                if (isMode) prev.find(".paymentMode-dropdown").focus();
                else if (isAmount) prev.find(".paymentAmount").focus();
                else if (isRef) prev.find(".paymentReferenceNO").focus();
                else if (isDesc) prev.find(".paymentDescription").focus();
            }
        }
    );

    $(document).on("keydown", "#Total, #discountPercent, #discountamount", function (e) {
        if (e.key !== "Enter") return;

        e.preventDefault();
        e.stopImmediatePropagation();

        const id = this.id;

        switch (id) {
            case "Total":
                $("#discountPercent").focus().select();
                break;

            case "discountPercent":
                $("#discountamount").focus().select();
                break;

            case "discountamount":
                paymentModeFocusSource = "keyboard";  // ✅ Mark as keyboard gesture
                openPaymentGrid();
                break;
        }
    });

    function openPaymentGrid() {
        setTimeout(() => {
            const firstPaymentMode = $("#PaymentDetailsBody tr:first .paymentMode-dropdown");

            if (firstPaymentMode.length) {
                firstPaymentMode.focus();
                return;
            }

            addPaymentRow();
            setTimeout(() => {
                paymentModeFocusSource = "keyboard";  // ✅ Mark as keyboard gesture
                $("#PaymentDetailsBody tr:first .paymentMode-dropdown").focus();
            }, 150);
        }, 100);
    }
</script>

<!-- ================================================================
     🔹 BILLING TYPE MANAGEMENT
     ================================================================ -->
<script>
    // ✅ Track keyboard Enter on BillDate
    $(document).on("keydown", "#BillDate", function (e) {
        if (e.key !== "Enter") return;

        e.preventDefault();
        e.stopImmediatePropagation();

        billingTypeFocusSource = "keyboard";  // ✅ Mark as keyboard gesture
        $("#billingType").focus();
    });

    // ✅ AUTO-OPEN ONLY IF FOCUS FROM KEYBOARD
    $(document).on("focus", "#billingType", function() {
        const select = this;

        // Only open if keyboard navigation
        if (billingTypeFocusSource === "keyboard") {
            setTimeout(() => {
                if ('showPicker' in HTMLSelectElement.prototype) {
                    try {
                        select.showPicker();
                    } catch (e) {
                        // Fallback if showPicker fails
                        $(select).trigger('click');
                    }
                } else {
                    $(select).trigger('click');
                }
            }, 50);
        }

        // Reset source
        billingTypeFocusSource = null;
    });

    function applyBillingType(type) {
        setTimeout(() => {
            if (type === "Cash") {
                $("#mobilenumber, #customer, #customeraddress")
                    .prop("disabled", true)
                    .addClass("bg-light");

                $("#mobilenumber, #customer, #customeraddress").val("");
            } else if (type === "registered") {
                $("#mobilenumber, #customer, #customeraddress")
                    .prop("disabled", false)
                    .removeClass("bg-light");

                // Don't auto-focus here - no user gesture
            }

            isEnterNavigation = false;
        }, 100);
    }

    $("#billingType").on("change", function () {
        isEnterNavigation = false;

        if (this.value === "Cash") {
            $("#mobilenumber, #customer, #customeraddress")
                .prop("disabled", true)
                .addClass("bg-light");

            $("#mobilenumber, #customer, #customeraddress").val("");
            hidePhoneError();
        } else {
            $("#mobilenumber, #customer, #customeraddress")
                .prop("disabled", false)
                .removeClass("bg-light");

            $("#mobilenumber").val(originalCustomerData.mobile);
            $("#customer").val(originalCustomerData.name);
            $("#customeraddress").val(originalCustomerData.address);
            $("#CustomerId").val(originalCustomerData.customerId);

            $("#mobilenumber").focus().select();
        }
    });

    $(document).on("keydown", "#billingType", function (e) {
        if (e.key === "ArrowUp" || e.key === "ArrowDown") return;

        if (e.key === "Enter") {
            e.preventDefault();
            e.stopImmediatePropagation();

            const type = this.value;

            if (type === "registered") {
                $("#mobilenumber").prop("disabled", false).focus();
            } else {
                $("#mobilenumber, #customer, #customeraddress")
                    .val("")
                    .prop("disabled", true);

                hidePhoneError();

                if ($("#doctorMobile").length && $("#doctorMobile").is(":visible") &&
                    !$("#doctorMobile").is(":disabled")) {
                    $("#doctorMobile").focus();
                } else {
                    focusItemGrid();
                }
            }
        }
    });

    $(document).ready(function () {
        applyBillingType($("#billingType").val());
    });
</script>

