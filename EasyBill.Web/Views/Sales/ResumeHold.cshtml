@using EasyBill.Models.ViewModels
@model SalesVM
@{
    ViewData["Title"] = "Resume Hold Sale";
}
<hr />
<style>
    /* ================================================================
               🔹 GLOBAL SELECTION STYLES
               ================================================================ */
    .batch-row.selected,
    tr.selected {
        background-color: #cfe2ff !important;
        border: 2px solid #0d6efd;
    }

    /* ================================================================
               🔹 ITEM MODAL STYLES
               ================================================================ */
    #itemModal .modal-dialog {
        max-height: 90vh;
    }

    #itemModal .modal-content {
        max-height: 90vh;
        display: flex;
        flex-direction: column;
    }

    #itemModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #itemModal .modal-header .btn-close {
            filter: invert(1);
        }

    #itemModal .modal-body {
        padding: 1rem;
        display: flex;
        flex-direction: column;
    }

    /* Item Table Wrapper */
    .item-table-wrapper {
        min-height: 50px;
        max-height: 350px;
        overflow-y: auto;
    }

        .item-table-wrapper::-webkit-scrollbar {
            width: 6px;
        }

        .item-table-wrapper::-webkit-scrollbar-thumb {
            background: #adb5bd;
            border-radius: 4px;
        }

    /* Item Table Header */
    #itemTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        z-index: 2;
    }

    /* Item Row Selection */
    .item-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    /* Keyboard Navigation - Hover Disabled */
    #itemModal.keyboard-nav .item-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* Mouse Navigation - Hover Enabled */
    #itemModal.mouse-nav .item-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .item-row {
        scroll-margin-top: 50px;
    }

        .item-row:focus {
            outline: none;
        }

    /* ================================================================
               🔹 BATCH MODAL STYLES
               ================================================================ */
    #batchModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #batchModal .modal-header .btn-close {
            filter: invert(1);
        }

    /* Batch Table Wrapper */
    .batch-table-wrapper {
        max-height: 350px;
        overflow-y: auto;
        position: relative;
    }

    /* Batch Table Header */
    #batchTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        z-index: 2;
    }

    /* Batch Row Selection */
    .batch-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    /* Keyboard Navigation - Hover Disabled */
    #batchModal.keyboard-nav .batch-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* Mouse Navigation - Hover Enabled */
    #batchModal.mouse-nav .batch-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .batch-row {
        scroll-margin-top: 50px;
    }

        .batch-row:focus {
            outline: none;
        }
</style>
<h5>Resume Hold Sale</h5>
<form asp-controller="Sales" asp-action="CreateFromHold" id="salesForm" method="post">
    <input type="hidden" asp-for="HoldId" />
    <input type="hidden" asp-for="IsHoldMode" />

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CustomerId" id="CustomerId" />
    <input type="hidden" asp-for="PharmacyDoctorId" id="DoctorId" />
    <input type="hidden" asp-for="OfferId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="container">
        <div class="row">
            <div class="row mb-2">

                <label asp-for="BillNo" class="col-md-2 col-form-label text-start small"> Bill No <i class="redColor">*</i> </label>
                <div class="col-md-2">
                    <input asp-for="BillNo" type="text" class="form-control form-control-sm" required readonly />
                    <span asp-validation-for="BillNo" class="text-danger"></span>
                </div>

                <label asp-for="BillDate" class="col-md-2 col-form-label text-start small">Bill Date <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input type="date" asp-for="BillDate" class="form-control form-control-sm" required />
                    <span asp-validation-for="BillDate" class="text-danger"></span>
                </div>

                <label class="col-md-2 ">Billing Type</label>
                <div class="col-md-2">
                    <select asp-for="billingType" id="billingType" class="form-control form-control-sm">
                        <option value="Cash">Cash</option>
                        <option value="registered">Customer</option>
                    </select>
                </div>

                <label class="col-md-2 col-form-label text-start small">Mobile No <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input asp-for="MobileNo" type="text" class="form-control form-control-sm" id="mobilenumber" required />
                    <span asp-validation-for="MobileNo" class="text-danger"></span>
                </div>

                <label class="col-md-2 col-form-label text-start small">Customer <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input asp-for="CustomerName" class="form-control form-control-sm" id="customer" required />
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>

                <label class="col-md-2 col-form-label text-start small">Address <i class="redColor">*</i></label>
                <div class="col-md-2 mt-2 mt-md-0">
                    <input asp-for="Address" id="customeraddress" class="form-control form-control-sm" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                @if (Model.DoctorRequired)
                {
                    <label class="col-md-2 col-form-label small">Doctor Mobile No <i class="redColor">*</i></label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorMobileNumber" class="form-control form-control-sm" id="doctorMobile" />
                    </div>

                    <label class="col-md-2 col-form-label small">Doctor <i class="redColor"></i></label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorName" class="form-control form-control-sm" id="doctorname" required />
                    </div>

                    <label class="col-md-2 col-form-label small">Registration Number <i class="redColor"></i></label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorRegNumber" class="form-control form-control-sm" id="doctorregno" required />
                    </div>
                }
            </div>


        </div>

        <!-- Items Table -->
        <div style="overflow-x: auto; width: 100%;">
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table custom-header">
                        <tr>
                            <th style="min-width:20%">Item</th>
                            <th style="min-width:30%">Batch</th>
                            <th class="text-center">Expiry</th>
                            <th class="text-center">Mrp</th>
                            <th class="text-center">Qty</th>
                            <th class="text-center">Rate</th>
                            <th class="text-center">Gst %</th>
                            <th class="text-center">Disc %</th>
                            <th class="text-center">Amount</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="SalesItemBody">
                        @{
                            int rowIndex = 0;
                            foreach (var item in Model.SalesItemVMs)
                            {
                                <tr>
                                    <td hidden><input name="SalesItemVMs[@rowIndex].Id" value="@item.Id" /></td>
                                    <td hidden>
                                        <input name="SalesItemVMs[@rowIndex].ItemMasterId" class="form-control form-control-sm item-id" value="@item.ItemMasterId" />
                                    </td>
                                    <td style="min-width:250px;">
                                        <input type="text" name="SalesItemVMs[@rowIndex].ItemBarcodeNumber" value="@item.ItemBarcodeNumber" class="form-control form-control-sm item-barcode" />
                                    </td>
                                    <td>
                                        <input name="SalesItemVMs[@rowIndex].Batch" class="form-control form-control-sm batch" value="@item.Batch" readonly />
                                    </td>
                                    <td>
                                        <input name="SalesItemVMs[@rowIndex].Expirydate" value="@item.Expirydate?.ToString("MM/yyyy")" class="form-control form-control-sm expirydate" readonly />
                                    </td>
                                    <td>
                                        <input name="SalesItemVMs[@rowIndex].Mrp" value="@item.Mrp" class="form-control form-control-sm mrp" readonly />
                                    </td>
                                    <td>
                                        <input name="SalesItemVMs[@rowIndex].Qty" class="form-control form-control-sm qty" value="@item.Qty" />
                                    </td>
                                    <td>
                                        <input name="SalesItemVMs[@rowIndex].Rate" class="form-control form-control-sm rate" value="@item.Rate" />
                                    </td>
                                    <td>
                                        <input name="SalesItemVMs[@rowIndex].Gst" class="form-control form-control-sm gst" value="@item.Gst" readonly />
                                    </td>
                                    <td>
                                        <input name="SalesItemVMs[@rowIndex].Discount" class="form-control form-control-sm discount" value="@item.Discount" />
                                    </td>
                                    <td>
                                        <input name="SalesItemVMs[@rowIndex].Amount" class="form-control form-control-sm Amount" value="@item.Amount" readonly />
                                    </td>
                                    <td>
                                        <u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u>
                                    </td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="8">
                                <u id="addRow" style="color:green; cursor:pointer;">Add Row</u>
                            </th>
                        </tr>
                    </tfoot>
                </table>

                <!-- Totals -->
                <div class="row mt-3">
                    <div class="col-md-7">
                        <strong>Payment Details</strong>
                        <table class="table table-bordered table-striped">
                            <thead class="table custom-header">
                                <tr>
                                    <th style="min-width:30%">Payemnt Mode</th>
                                    <th class="text-center">Amount</th>
                                    <th class="text-center">Reference NO</th>
                                    <th class="text-center">Decritption</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="PaymentDetailsBody">
                                @for (int i = 0; i < Model.SalsePaymentDetails?.Count; i++)
                                {
                                    <tr>
                                        <td hidden><input type="hidden" asp-for="@Model.SalsePaymentDetails[@i].Id" /></td>
                                        <td style="min-width:185px;">
                                            <select asp-for="SalsePaymentDetails[@i].PaymentModeId" asp-items="@ViewBag.PaymentMode" class="form-control form-control-sm paymentMode-dropdown" required>
                                                <option value="">Select</option>
                                            </select>
                                        </td>
                                        <td><input name="SalsePaymentDetails[@i].Amount" class="form-control form-control-sm paymentAmount" value="@Model.SalsePaymentDetails[i].Amount" /></td>
                                        <td><input name="SalsePaymentDetails[@i].ReferenceNo" class="form-control form-control-sm paymentReferenceNO" value="@Model.SalsePaymentDetails[i].ReferenceNo" /></td>
                                        <td><input name="SalsePaymentDetails[@i].Description" class="form-control form-control-sm paymentDescription" value="@Model.SalsePaymentDetails[i].Description" /></td>
                                        <td><u class="remove-paymentrow-btn text-danger" style="cursor:pointer;">Remove</u></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="float-start">
                                        <u id="addPaymentRow" style="color:green; text-align:right; cursor:pointer;">Add Row</u>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="col-md-5">
                        <div class="row mb-2">
                            <label asp-for="Total" class="col-md-3 col-form-label text-start small">Total</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="Total" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label class="col-md-3 col-form-label text-start small">Bill Discount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-2">
                                <input asp-for="discountPercent" id="discountPercent" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <input asp-for="discountAmount" id="discountamount" class="form-control form-control-sm" placeholder="amount" />
                            </div>

                        </div>
                        <div class="row mb-2">
                            <label asp-for="Totaldiscount" class="col-md-3 col-form-label text-start small">Total Discount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="Totaldiscount" id="Totaldiscount" class="form-control form-control-sm" readonly />
                            </div>

                        </div>
                        <div class="row mb-2">
                            <label asp-for="TotalGstAmt" class="col-md-3 col-form-label text-start small">Gst</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="TotalGstAmt" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="TotalPayable" class="col-md-3 col-form-label text-start small">Total Amount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="TotalPayable" id="totalPayable" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="PaidAmount" class="col-md-3 col-form-label text-start small">Paid Amount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="PaidAmount" id="paidAmout" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="Balance" class="col-md-3 col-form-label text-start small">Balance</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="Balance" id="balance" value="0" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="ReturnAmount" class="col-md-3 col-form-label text-start small">Return Amount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="ReturnAmount" id="returnAmount" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Buttons -->
        <div class="mt-3 d-flex justify-content-between align-items-center">

            <!-- ⬅ LEFT SIDE -->
            <div>
                <button type="button" id="holdBtn" class="btn btn-sm btn-warning me-2">
                    ⏸ Hold
                </button>

                <button type="button" id="unHoldBtn" class="btn btn-sm btn-info">
                    ▶ UnHold
                </button>
            </div>

            <!-- ➡ RIGHT SIDE -->
            <div>
                <button type="submit" class="btn btn-sm btn-primary me-2">
                    💾 Save
                </button>

                <button id="applyOfferBtn" class="btn btn-sm btn-success applyOffer">
                    🎁 Apply Offer
                </button>
            </div>

        </div>
    </div>
</form>

<div class="modal fade" id="createCustomerModal" tabindex="-1" aria-labelledby="customerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="newCustomerForm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Name</label>
                        <input type="text" name="Name" class="form-control form-control-sm" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Mobile No</label>
                        <input type="text" name="CustomerMobileNo" id="newCustomerMobile" class="form-control form-control-sm" readonly />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Address</label>
                        <input type="text" name="Address" class="form-control form-control-sm" required />
                    </div>
                    <!-- Add more fields as needed -->
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-sm btn-success">Save Customer</button>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="modal fade" id="createDoctorModal" tabindex="-1" aria-labelledby="createDoctorModalLabel" aria-hidden="true">
