    <!-- ================================================================
         🔹 ITEM GRID MANAGEMENT
         ================================================================ -->
    <script>
        function addNewRow() {
            let newRow = `
                <tr data-new-row="true">
                    <td hidden>
                        <input type="hidden" name="SalesItemVMs[${rowIndex}].Id" />
                    </td>
                    <td hidden>
                        <input name="SalesItemVMs[${rowIndex}].ItemMasterId" class="form-control form-control-sm item-id" />
                    </td>
                    <td style="min-width:250px;">
                        <input type="text" name="SalesItemVMs[${rowIndex}].ItemBarcodeNumber"
                               class="form-control form-control-sm item-barcode" />
                    </td>
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].Batch"
                               class="form-control form-control-sm batch" readonly />
                    </td>
                    <td>
                        <input type="text" name="SalesItemVMs[${rowIndex}].Expirydate"
                               class="form-control form-control-sm expirydate"
                               placeholder="MM/YYYY" maxlength="7" readonly />
                    </td>
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].Mrp"
                               class="form-control form-control-sm mrp" readonly />
                    </td>
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].Qty"
                               class="form-control form-control-sm qty" value="1" />
                    </td>
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].Rate"
                               class="form-control form-control-sm rate" />
                    </td>
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].Gst"
                               class="form-control form-control-sm gst" readonly />
                    </td>
                    <td>
                        <input type="number" name="SalesItemVMs[${rowIndex}].Discount"
                               class="form-control form-control-sm discount" value="0" />
                    </td>
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].Amount"
                               class="form-control form-control-sm Amount" readonly />
                    </td>
                    <td>
                        <u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u>
                    </td>
                </tr>`;

            $("#SalesItemBody").append(newRow);
            $("#SalesItemBody").find('.expirydate').each(function () {
                formatExpiryDateInput(this);
            });
            rowIndex++;
            updateRowIndices();
            toggleAddRowButton();
        }

        function formatExpiryDateInput(input) {
            let value = $(input).val().replace(/[^\d]/g, '');

            if (value.length >= 2) {
                let month = value.substring(0, 2);
                let year = value.substring(2, 6);

                if (parseInt(month) > 12) {
                    month = "12";
                } else if (parseInt(month) < 1) {
                    month = "01";
                }

                value = month;
                if (year) {
                    value += '/' + year;
                }
            }

            $(input).val(value.substring(0, 7));
        }

        function updateRowIndices() {
            const rows = document.querySelectorAll('#SalesItemBody tr');
            rowIndex = 0;
            rows.forEach(row => {
                row.querySelectorAll('input, select').forEach(input => {
                    const name = input.name;
                    if (name) input.name = name.replace(/\[\d+\]/, `[${rowIndex}]`);
                });
                rowIndex++;
            });
        }

        function toggleAddRowButton() {
            if ($("#SalesItemBody tr").length > 0) {
                $("#addRow").hide();
            } else {
                $("#addRow").show();
            }
        }

        $(document).ready(function () {
            $("#addRow").click(function () {
                addNewRow();
            });

            $(document).on("input", "#itemSearch", function () {
                const searchText = $(this).val().toLowerCase();
                $("#itemTableBody tr").each(function () {
                    const itemName = $(this).find("td:first").text().toLowerCase();
                    $(this).toggle(itemName.includes(searchText));
                });
            });

            $(document).on("keydown", ".item-barcode", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    isEnterNavigation = true;
                    currentRow = $(this).closest("tr");
                    currentRowForCrossItemModal = $(this).closest("tr");

                    const barcode = $(this).val().trim();
                    if (!barcode) {
                        openItemSearchModal("");
                        isEnterNavigation = false;
                        return;
                    }
                    processBarcode(barcode);
                }
            });

            $(document).on("click", ".item-row", function () {
                const itemId = $(this).data("itemid");
                const itemName = $(this).data("name");
                const gst = $(this).data("gst");

                if (!itemId || !currentRow) return;

                currentRow.find(".item-barcode").val(itemName);
                currentRow.find(".item-id").val(itemId);
                currentRow.find(".gst").val(gst);
                calculateRow(currentRow);
                $("#itemModal").modal("hide");

                processItemId(itemId);
            });

            $(document).on("focus", ".qty", function () {
                const val = parseFloat($(this).val());
                $(this).data("originalQty", isNaN(val) ? null : val);
            });

            $(document).on("input", ".qty, .rate, .discount", function () {
                let row = $(this).closest("tr");
                calculateRow(row);
            });

            $("#discountPercent, #discountamount").on("input", function () {
                calculateTotalSummary();
            });

            $(document).on("click", ".remove-row-btn", function () {
                $(this).closest("tr").remove();
                calculateTotalSummary();
                updateRowIndices();
                toggleAddRowButton();
            });

            $('.expirydate').each(function () {
                let val = $(this).val();
                if (val.includes('-')) {
                    let parts = val.split('-');
                    if (parts.length >= 2) {
                        let formatted = parts[1] + '/' + parts[0];
                        $(this).val(formatted);
                    }
                } else {
                    formatExpiryDateInput(this);
                }
            });

            $(document).on('input click', '.expirydate', function () {
                formatExpiryDateInput(this);
            });

            toggleAddRowButton();
        });

        function processItemId(itemId) {
            loadBatches(itemId);
        }

        function processBarcode(barcode) {
            $.get('/Sales/GetItemByBarcode', { barcode: barcode }, function (item) {
                if (!item || !item.itemId) {
                    openItemSearchModal(barcode);
                    return;
                }

                const itemName = item.itemname;
                currentRow.find(".item-id").val(item.itemId);
                currentRow.find(".item-barcode").val(itemName);

                $.get('/Sales/GetBatchesByItemId', { id: item.itemId }, function (data) {
                    if (data.error || !data.groupedResult.length) {
                        toastr.warning("No batches available");
                        return;
                    }

                    currentRow.find(".gst").val(data.gst);

                    let batchRows = '';
                    data.groupedResult.forEach(batch => {
                        const expiryDate = new Date(batch.expiry);
                        const month = String(expiryDate.getMonth() + 1).padStart(2, '0');
                        const year = expiryDate.getFullYear();
                        const formattedExpiry = `${month}/${year}`;
                        const encoded = encodeURIComponent(JSON.stringify(batch));

                        batchRows += `<tr class="batch-row" tabindex="0" data-batch="${encoded}">
                            <td>${batch.batch}</td>
                            <td>${formattedExpiry}</td>
                            <td>${batch.rate}</td>
                            <td>${batch.mrp}</td>
                            <td>${batch.qty}</td>
                        </tr>`;
                    });

                    $("#batchTableBody").html(batchRows);
                    const $rows = $(".batch-row");
                    currentBatchIndex = $rows.length > 0 ? 0 : -1;
                    highlightRow($rows, currentBatchIndex);
                    $("#batchModal").modal("show");
                });
            });
        }

        function highlightRow($rows, index) {
            $rows.removeClass("selected");
            const $row = $rows.eq(index);
            $row.addClass("selected");
            $row[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
        }

        function highlightItemRow($rows, index) {
            $rows.removeClass("selected");
            const $row = $rows.eq(index);
            $row.addClass("selected");
            $row[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
        }

        $('#batchModal').on('shown.bs.modal', function () {
            $(".batch-row").removeClass("selected");
            currentBatchIndex = -1;
        });

        $('#itemModal').on('shown.bs.modal', function () {
            $("#itemSearch").trigger('focus');
            $(".item-row").removeClass("selected");
            currentItemIndex = -1;
            $("#itemSearch").trigger("input");
        });

        $(document).on("click", ".batch-row", function () {
            $(".batch-row").removeClass("selected");
            $(this).addClass("selected");

            const encoded = $(this).attr("data-batch");
            try {
                const batch = JSON.parse(decodeURIComponent(encoded));
                if (currentRow) {
                    currentRow.find(".batch").val(batch.batch);
                    currentRow.find(".rate").val(batch.rate || 0);
                    currentRow.find(".mrp").val(batch.mrp || 0);

                    const qtyInput = currentRow.find(".qty");
                    const existingQty = parseFloat(qtyInput.val());

                    if (!existingQty || existingQty <= 0) {
                        qtyInput.val(1);
                    }

                    if (batch.expiry) {
                        let date = new Date(batch.expiry);
                        let formatted = ("0" + (date.getMonth() + 1)).slice(-2) + "/" + date.getFullYear();
                        currentRow.find(".expirydate").val(formatted);
                    }
                    calculateRow(currentRow);
                }
                $("#batchModal").modal("hide");

                setTimeout(() => {
                    currentRow.find(".qty").focus().select();
                }, 200);
            } catch (err) {
                alert("Invalid batch data.");
                console.error(err);
            }
        });

        function calculateRow(row) {
            let qty = parseFloat(row.find(".qty").val()) || 0;
            let rate = parseFloat(row.find(".rate").val()) || 0;
            let gst = parseFloat(row.find(".gst").val()) || 0;
            let discount = parseFloat(row.find(".discount").val()) || 0;

            let grossAmount = qty * rate;
            let discountAmt = (grossAmount * discount) / 100;
            let amountAfterDiscount = grossAmount - discountAmt;
            let gstAmt = (amountAfterDiscount * gst) / 100;
            let total = amountAfterDiscount + gstAmt;

            row.find(".discount-amt").val(discountAmt.toFixed(2));
            row.find(".Amount").val(total.toFixed(2));

            calculateTotalSummary();
        }

        function calculateTotalSummary() {
            let total = 0;
            let totalGst = 0;
            let totalDiscount = 0, totalamt = 0;
            let gstRows = [];

            $("#SalesItemBody tr").each(function () {
                let row = $(this);
                let qty = parseFloat(row.find(".qty").val()) || 0;
                let rate = parseFloat(row.find(".rate").val()) || 0;
                let gst = parseFloat(row.find(".gst").val()) || 0;
                let discount = parseFloat(row.find(".discount").val()) || 0;

                let grossAmount = qty * rate;
                let discountAmt = (grossAmount * discount) / 100;
                let amountAfterDiscount = grossAmount - discountAmt;
                let gstAmt = (amountAfterDiscount * gst) / 100;

                total += amountAfterDiscount;
                totalamt += amountAfterDiscount;
                totalGst += gstAmt;
                totalDiscount += discountAmt;

                gstRows.push({ rate: amountAfterDiscount, gst: gst });
            });

            let percentInput = parseFloat($("#discountPercent").val()) || 0;
            let amountInput = parseFloat($("#discountamount").val()) || 0;

            let globalDiscountPercent = 0;
            let globalDiscountAmt = 0;

            if ($("#discountPercent").is(":focus") || (percentInput > 0 && amountInput === 0)) {
                globalDiscountPercent = percentInput;
                globalDiscountAmt = (total * globalDiscountPercent) / 100;
                $("#discountamount").val(globalDiscountAmt.toFixed(2));
            } else if ($("#discountamount").is(":focus") || (amountInput > 0 && percentInput === 0)) {
                globalDiscountAmt = amountInput;
                globalDiscountPercent = total > 0 ? (globalDiscountAmt / total) * 100 : 0;
                $("#discountPercent").val(globalDiscountPercent.toFixed(2));
            } else if (percentInput > 0 && amountInput > 0) {
                globalDiscountPercent = percentInput;
                globalDiscountAmt = amountInput;
            }

            if (globalDiscountAmt > 0) {
                totalDiscount += globalDiscountAmt;
                totalamt = total - globalDiscountAmt;

                totalGst = 0;
                gstRows.forEach(row => {
                    let rowDiscountAmt = (row.rate * globalDiscountPercent) / 100;
                    let rowAfterGlobalDiscount = row.rate - rowDiscountAmt;
                    let gstAmt = (rowAfterGlobalDiscount * row.gst) / 100;
                    totalGst += gstAmt;
                });
            }

            let totalPayable = totalamt + totalGst;
            let roundedPayable = Math.round(totalPayable);

            // PAYMENT GRID CALCULATION
            let paidAmount = 0;
            $(".paymentAmount").each(function () {
                paidAmount += parseFloat($(this).val()) || 0;
            });

            // BALANCE & RETURN LOGIC
            let balance = 0;
            let returnAmount = 0;

            if (paidAmount > roundedPayable) {
                returnAmount = paidAmount - roundedPayable;
                balance = 0;
            } else {
                balance = roundedPayable - paidAmount;
                returnAmount = 0;
            }

            // SET VALUES TO UI
            $("[name='Total']").val(total.toFixed(2));
            $("[name='TotalGstAmt']").val(totalGst.toFixed(2));
            $("[name='Totaldiscount']").val(totalDiscount.toFixed(2));
            $("[name='TotalPayable']").val(roundedPayable);

            $("#paidAmout").val(paidAmount.toFixed(2));
            $("#balance").val(balance.toFixed(2));
            $("#returnAmount").val(returnAmount.toFixed(2));
        }
    </script>

    <!-- ================================================================
         🔹 ITEM MODAL - COMPLETE FUNCTIONALITY (FROM SALESORDER CREATE)
         ================================================================ -->
    <script>
        function openItemSearchModal(searchText = "") {
            showLoader("Loading items..."); // ✅ Show loader

            $.get('/Sales/GetAllItems', function (items) {
                hideLoader(); // ✅ Hide loader

                if (!items || items.length === 0) {
                    toastr.warning("No items found.");
                    return;
                }

                let rows = "";
                items.forEach(item => {
                    rows += `<tr class="item-row" tabindex="0" data-barcode="${item.barcode}" data-itemid="${item.id}"
                        data-name="${item.name}" data-gst="${item.gst}" data-qty="${item.qty}">
                        <td>${item.name}</td>
                        <td>${item.qty}</td>
                    </tr>`;
                });

                $("#itemTableBody").html(rows);
                $("#itemSearch").val(searchText);
                $("#itemSearch").trigger("input");
                $("#itemModal").modal("show");
            }).fail(function () {
                hideLoader(); // ✅ Hide loader on error
                toastr.error("Error loading items");
            });
        }

        // ✅ ITEM SEARCH - WORD-BY-WORD MATCHING (IMPROVED)
        $(document).on("input", "#itemSearch", function () {
            const searchWords = $(this).val()
                .toLowerCase()
                .trim()
                .split(/\s+/);

            $("#itemTableBody tr").each(function () {
                const itemText = $(this).find("td:first").text().toLowerCase();
                const itemWords = itemText.split(/\s+/);

                let match = true;

                for (let i = 0; i < searchWords.length; i++) {
                    if (!itemWords[i] || !itemWords[i].startsWith(searchWords[i])) {
                        match = false;
                        break;
                    }
                }

                $(this).toggle(match);
            });

            // ✅ RESET SELECTION AFTER SEARCH
            currentItemIndex = -1;
            $("#itemTableBody .item-row").removeClass("selected");

            // ✅ AUTO-SELECT FIRST VISIBLE ROW (NEW IMPROVEMENT)
            const $visibleRows = $("#itemTableBody .item-row:visible");
            if ($visibleRows.length > 0) {
                currentItemIndex = 0;
                highlightItemRow($visibleRows, 0);
            }
        });

        // ✅ ITEM ROW CLICK
        $(document).on("click", ".item-row", function (e) {
            e.preventDefault();

            const itemId = $(this).data("itemid");
            const itemName = $(this).data("name");
            const gst = $(this).data("gst");

            if (!itemId || !currentRow) return;

            currentRow.find(".item-barcode").val(itemName);
            currentRow.find(".item-id").val(itemId);
            currentRow.find(".gst").val(gst);

            calculateRow(currentRow);
            $("#itemModal").modal("hide");

            processItemId(itemId);
        });

        // ITEM MODAL - KEYBOARD NAVIGATION
        $(document).on("keydown", function (e) {
            if (!$("#itemModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                itemNavMode = "keyboard";
                isKeyboardScrollingItemModal = true;
                $("#itemModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".item-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentItemIndex === -1) {
                    currentItemIndex = 0;
                }
                else if (currentItemIndex < $rows.length - 1) {
                    currentItemIndex++; // ✅ INCREMENT BY 1 (NOT 2)
                }

                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();

                if (currentItemIndex <= 0) {
                    // ✅ Already at top, do nothing
                    return;
                }

                currentItemIndex--;
                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "Enter" && currentItemIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentItemIndex).trigger("click");
            }
        });

        // ✅ HIGHLIGHT FUNCTION - SMART SCROLL (NO GAP)
        function highlightItemRow($rows, index) {
            $rows.removeClass("selected");
            const $row = $rows.eq(index);
            $row.addClass("selected");

            // ✅ Smart scroll - NO GAP at top/bottom
            const container = document.querySelector("#itemModal .item-table-wrapper");
            if (!container || !$row[0]) return;

            const rowRect = $row[0].getBoundingClientRect();
            const containerRect = container.getBoundingClientRect();
            const headerHeight = document.querySelector("#itemTable thead")?.offsetHeight || 40;

            // ✅ If row is ABOVE sticky header → Scroll UP (NO GAP)
            if (rowRect.top < containerRect.top + headerHeight) {
                container.scrollTop -= (containerRect.top + headerHeight - rowRect.top);
            }
            // ✅ If row is BELOW visible area → Scroll DOWN (NO GAP)
            else if (rowRect.bottom > containerRect.bottom) {
                container.scrollTop += (rowRect.bottom - containerRect.bottom);
            }
        }

        // ✅ ITEM MODAL - MOUSE HOVER
        $(document).on("mouseenter", ".item-row", function () {
            if (!$("#itemModal").is(":visible")) return;
            if (isKeyboardScrollingItemModal) return;

            itemNavMode = "mouse";

            $("#itemModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".item-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentItemIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#itemModal", function () {
            isKeyboardScrollingItemModal = false;
        });

        // ✅ ITEM MODAL - SHOWN EVENT (AUTO-SELECT FIRST ROW)
        $('#itemModal').on('shown.bs.modal', function () {
            itemNavMode = "keyboard";

            $("#itemModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".item-row:visible");

            currentItemIndex = -1;

            if ($rows.length > 0) {
                currentItemIndex = 0;
                highlightItemRow($rows, 0);
            }

            setTimeout(() => {
                $("#itemSearch").focus().select();
            }, 200);
        });

        // ✅ ITEM MODAL - HIDDEN EVENT
        $('#itemModal').on('hidden.bs.modal', function () {
            setTimeout(() => {
                if (currentRowForCrossItemModal && currentRowForCrossItemModal.length) {
                    const itemInput = currentRowForCrossItemModal.find(".item-barcode");
                    if (itemInput.length) {
                        itemInput.focus().select();
                    }
                }
            }, 150);
        });
    </script>

    <!-- ================================================================
      🔹 FORM SUBMIT VALIDATION
      ================================================================ -->
    <script>
        let isFormSubmitting = false;

        $("#salesForm").on("submit", function (e) {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();

            if (isFormSubmitting) {
                return false;
            }

            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: 3000,
                extendedTimeOut: 1000,
                preventDuplicates: true
            };

            // VALIDATION 1: BILLING TYPE & CUSTOMER
            const billingType = $("#billingType").val();
            const mobile = ($("#mobilenumber").val() || "").trim();
            const customerName = ($("#customer").val() || "").trim();

            if (billingType === "registered") {
                if (!mobile) {
                    toastr.error("Mobile number is required.", "Mobile Required");
                    $("#mobilenumber").focus().select();
                    return false;
                }

                if (!isValidIndianMobile(mobile)) {
                    toastr.error("Please enter a valid 10-digit mobile number.", "Invalid Mobile");
                    $("#mobilenumber").focus().select();
                    return false;
                }

                if (!customerName) {
                    toastr.error("Customer name is required.", "Customer Required");
                    $("#customer").focus().select();
                    return false;
                }
            }

            // VALIDATION 2: ITEM GRID
            let hasValidItemRow = false;
            let firstZeroQtyRow = null;
            let firstIncompleteRow = null;

            $("#SalesItemBody tr").each(function () {
                const row = $(this);

                const itemId = (row.find(".item-id").val() || "").trim();
                const batch = (row.find(".batch").val() || "").trim();
                const qty = parseFloat(row.find(".qty").val()) || 0;

                if (!itemId && !batch && qty === 0) {
                    return;
                }

                if (itemId && !batch && !firstIncompleteRow) {
                    firstIncompleteRow = row;
                }

                if (itemId && qty <= 0 && !firstZeroQtyRow) {
                    firstZeroQtyRow = row;
                }

                if (itemId && batch && qty > 0) {
                    hasValidItemRow = true;
                }
            });

            if (firstIncompleteRow) {
                toastr.error("Please select batch for all items.", "Incomplete Item");
                firstIncompleteRow.find(".item-barcode").focus().select();
                return false;
            }

            if (firstZeroQtyRow) {
                toastr.error("Quantity must be at least 1.", "Invalid Quantity");

                const qtyInput = firstZeroQtyRow.find(".qty");
                const originalQty = qtyInput.data("originalQty");

                if (originalQty && originalQty > 0) {
                    qtyInput.val(originalQty);
                } else {
                    qtyInput.val(1);
                }

                calculateRow(firstZeroQtyRow);

                qtyInput.focus().select();
                return false;
            }

            if (!hasValidItemRow) {
                toastr.error("Please add at least one valid item before saving.", "No Items");

                const firstRow = $("#SalesItemBody tr:first");
                if (firstRow.length) {
                    firstRow.find(".item-barcode").focus().select();
                }
                return false;
            }

            // AJAX submission
            const form = $(this);

            confirmSave(function (ok) {
                if (!ok) { return; }

                isFormSubmitting = true;
                showLoader();

                $.ajax({
                    type: "POST",
                    url: form.attr("action"),
                    data: form.serialize(),
                    success: function (response) {
                        if (!response.success) {
                            toastr.error(response.message || "Save failed");
                            isFormSubmitting = false;
                            hideLoader();
                            return;
                        }

                        hideLoader();

                        Swal.fire({
                            title: 'Print Sales Bill?',
                            text: 'Do you want to open the sales report in a new tab?',
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonText: '🖨️ Yes, Open PDF',
                            cancelButtonText: '❌ No, Skip',
                            confirmButtonColor: '#0d6efd',
                            cancelButtonColor: '#6c757d',
                            reverseButtons: true
                        }).then((result) => {
                            if (!result.isConfirmed) {
                                window.location.href = "/Sales/Create";
                                return;
                            }

                            const reportUrl = "/Sales/Print/" + response.saleId;
                            const pdfWindow = window.open(reportUrl, "_blank");
                            if (pdfWindow) {
                                pdfWindow.focus();
                            }

                            window.location.href = "/Sales/Create";
                        });
                    },
                    error: function () {
                        toastr.error("Error while saving sales");
                        isFormSubmitting = false;
                        hideLoader();
                    }
                });
            });
        });
    </script>

