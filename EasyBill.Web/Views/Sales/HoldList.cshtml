@model IEnumerable<EasyBill.Models.ViewModels.HoldSalesListVM>

@{
    ViewData["Title"] = "Hold Sales List";
}
<style>
    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>
<div class="card mb-3 shadow-sm">
    <div class="card-header text-white d-flex align-items-center justify-content-between" style="background:#2b6ac9">
        <h6 class="mb-0">
           HoldList
        </h6>
    </div>
</div>
<table class="table" id="holdListTbl">
    <thead class="table-primary">
        <tr>
            <th>Hold No</th>
            <th>Hold Date</th>
            <th>Customer</th>
            <th>Mobile</th>
            <th>Address</th>
            <th>Items</th>
            <th style="width:120px;">Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <span class="badge bg-warning text-dark">
                        @item.HoldToken
                    </span>
                </td>

                <td>
                    @item.HoldDate.ToString("dd/MM/yyyy hh:mm tt")
                </td>

                <td>
                    @item.CustomerName ?? "Walk-in"
                </td>

                <td>
                    @item.MobileNo
                </td>

                <td>
                    @item.Address
                </td>

                <td class="text-center">
                    @item.ItemCount
                </td>

                <td>
                    <div class="btn-group" role="group">
                        <a asp-controller="Sales"
                           asp-action="ResumeHold"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-success"
                           title="Resume Sale">
                            <i class="bi bi-arrow-repeat"></i>
                        </a>

                        <a asp-controller="Sales"
                           asp-action="DeleteHold"
                           asp-route-id="@item.Id"
                           onclick="return confirm('Are you sure you want to delete this hold entry?');"
                           class="btn btn-sm btn-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#holdListTbl").DataTable({
                "order": [[2, "asc"]]
            });
        });
    </script>
}