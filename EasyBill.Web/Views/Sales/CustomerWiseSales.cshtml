@model EasyBill.Models.ViewModels.CustomerWiseSalesReportVM

@{
    // Totals for summary and details
    decimal totalSalesSummary = Model?.Summary?.Sum(x => x.TotalSales) ?? 0;
    decimal totalBillValue = Model?.Details?.Sum(x => x.BillValue) ?? 0;
}
<style>
    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>

<div class="card mb-3 shadow-sm">
    <div class="card-header text-white d-flex py-2" style="background:#2b6ac9">

        <span class="fw-bold">
            Customer Wise Sales Report
        </span>

        <span class="ms-auto">
            @if (Model.ReportType == "Summary")
            {
                <span>
                    Total Sales: ₹
                    <span class="fw-bold">@totalSalesSummary.ToString("0.00")</span>
                </span>
            }
            else if (Model.ReportType == "Details")
            {
                <span>
                    Total Bill Value: ₹
                    <span class="fw-bold">@totalBillValue.ToString("0.00")</span>
                </span>
            }
        </span>

    </div>
</div>
<form method="get" class="card p-3 mb-3">

    <div class="row">

        <div class="col-md-2">
            <label>From Date</label>
            <input type="date" name="fromDate" class="form-control"
                   value="@ViewBag.FromDate" />
        </div>

        <div class="col-md-2">
            <label>To Date</label>
            <input type="date" name="toDate" class="form-control"
                   value="@ViewBag.ToDate" />
        </div>

        <div class="col-md-3">
            <label>Customer</label>
            <select name="customerId" class="form-control"
                    asp-items="@(ViewBag.CustomerList as SelectList)">
                <option value="">All</option>
            </select>
        </div>

        <div class="col-md-3">
            <label>Report Type</label>
            <div class="mt-2">
                <label class="me-3">
                    <input type="radio" name="reportType" value="Summary"
                           @(Model.ReportType == "Summary" ? "checked" : "") />
                    Summary
                </label>

                <label>
                    <input type="radio" name="reportType" value="Details"
                           @(Model.ReportType == "Details" ? "checked" : "") />
                    Details
                </label>
            </div>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button class="btn w-100 text-light" style="background:#2b6ac9">Search</button>
        </div>
    </div>
</form>
<div class="row mb-2">
    <div class="col text-end">
<a asp-action="ExportCustomerWiseSalesExcel"
   asp-route-fromDate="@ViewBag.FromDate"
   asp-route-toDate="@ViewBag.ToDate"
   asp-route-customerId="@Context.Request.Query["customerId"]"
   asp-route-reportType="@Model.ReportType">
    <i class="fa-solid fa-file-excel text-success fs-5"></i>
</a>

<a asp-action="ExportCustomerWiseSalesPdf"
   asp-route-fromDate="@ViewBag.FromDate"
   asp-route-toDate="@ViewBag.ToDate"
   asp-route-customerId="@Context.Request.Query["customerId"]"
   asp-route-reportType="@Model.ReportType">
    <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
</a>
</div>
</div>
<!-- ================= SUMMARY TABLE ================= -->
@if (Model.ReportType == "Summary")
{
    <table id="summaryCustWiseBatchTbl" class="table table-bordered table-striped">
        <thead class="table-primary">
            <tr>
                <th>Customer Name</th>
                <th class="text-end">Total Sales Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Summary)
            {
                <tr>
                    <td>@item.CustomerName</td>
                    <td class="text-end">@item.TotalSales.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- ================= DETAILS TABLE ================= -->
@if (Model.ReportType == "Details")
{
    <table id="detailCustWiseBatchTbl" class="table table-bordered table-striped">
        <thead class="table-primary">
            <tr>
                <th style="width: 240px;">Bill No</th>
                <th>Bill Date</th>
                <th>Customer Name</th>
                <th class="text-end">Bill Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Details)
            {
                <tr>
                    <td>@item.BillNo</td>
                    <td>@item.BillDate?.ToString("dd-MM-yyyy")</td>
                    <td>@item.CustomerName</td>
                    <td class="text-end">@item.BillValue.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#summaryCustWiseBatchTbl").DataTable({
                ordering: false,
                "columnDefs": [
                    { "orderable": false, "targets": 0 }
                ]
            });
             $("#detailCustWiseBatchTbl").DataTable({
                "order": [[1, "desc"]],
                "columnDefs": [
                    { "orderable": false, "targets": "_all" }
                ]
            });
        });
    </script>
}
