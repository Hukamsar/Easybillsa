<script>
    // LOAD SETTINGS FUNCTION (Reusable)
    function loadSalesSettings() {
        $.ajax({
            url: '/SalseSetting/GetSidebarSettings',
            type: 'GET',
            success: function (data) {

                settingsSaved = data.isNotConfigured;

                // APPLY SETTINGS TO FORM (for sidebar display)
                $('#toggleDoctor').prop('checked', data.doctorRequired);
                $('#userId').val(data.applicationUserId);
                $('#doctorSection').toggle(data.doctorRequired);
                $('#itemBarCodeYes').prop('checked', data.itemBarCodeBase === true);
                $('#itemBarCodeNo').prop('checked', data.itemBarCodeBase !== true);
                $('#tabletWise').prop('checked', data.itemConversion === "TabletWise");
                $('#stripWise').prop('checked', data.itemConversion === "StripWise");
                $("#rateRoundUpToggle").prop("checked", data.rateRoundUp === true);
                $('#allowNegativeYes').prop('checked', data.allowNegative === true);
                $('#allowNegativeNo').prop('checked', data.allowNegative !== true);

                if (data.expiryAllowedDays && data.expiryAllowedDays > 0) {
                    $('#expiryAllowedDays').val(data.expiryAllowedDays);
                } else {
                    $('#expiryAllowedDays').val('');
                }

                // SET GLOBAL FLAGS FOR VALIDATION
                isTabletWiseMode = (data.itemConversion === "TabletWise");
                window.allowNegativeSetting = data.allowNegative === true;
                const incomingSalesTax = parseInt(data.salesTax ?? data.SalesTax);
                salesTaxMode = (incomingSalesTax === SALES_TAX_INCLUSIVE || incomingSalesTax === SALES_TAX_EXCLUSIVE)
                    ? incomingSalesTax
                    : SALES_TAX_EXCLUSIVE;

                window.printType = data.printType || 'normal';
                window.thermalPaperSize = data.thermalPaperSize?.toString() || '80';

                switch (data.itemConversion) {
                    case "TabletWise":
                        $('#qtyView').text('Strip');
                        break;
                    case "StripWise":
                        $('#qtyView').text('Qty');
                        break;
                    default:
                        $('#qtyView').text('Qty');
                }

                console.log("Settings Loaded:", {
                    tabletWise: isTabletWiseMode,
                    allowNegative: window.allowNegativeSetting,
                    doctorRequired: data.doctorRequired,
                    salesTaxMode: salesTaxMode === SALES_TAX_INCLUSIVE ? "Inclusive" : "Exclusive"
                });

                // APPLY TABLET-WISE MODE TO EXISTING ROWS
                $("#SalesItemBody tr").each(function() {
                    applyTabletWiseMode($(this));
                    calculateRow($(this));
                });
            },
            error: function () {
                console.error("❌ Could not load settings on page load");
            }
        });
    }

    $(document).ready(function () {
