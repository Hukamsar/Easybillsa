@using EasyBill.Models.ViewModels
@model SalesVM
@{
    ViewData["Title"] = "Create Sales";
}

<link href="~/css/page.css" rel="stylesheet" />

<!-- ================================================================
     🔹 GLOBAL STYLES
     ================================================================ -->
<style>
    /* ===============================
                           LOADER STYLES
                        =============================== */
    #globalLoader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loader-content {
        text-align: center;
        color: #fff;
    }

    .spinner {
        border: 4px solid rgba(255, 255, 255, 0.3);
        border-top: 4px solid #fff;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
        margin: 0 auto 15px;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .loader-text {
        font-size: 16px;
        font-weight: 500;
        margin-top: 10px;
    }

    /* ===============================
                           BATCH MODAL STYLES
                        =============================== */
    #batchModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #batchModal .modal-header .btn-close {
            filter: invert(1);
        }

    #batchTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        z-index: 2;
    }

    .batch-table-wrapper {
        max-height: 350px;
        overflow-y: auto;
        position: relative;
    }

    .batch-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    /* Keyboard navigation active → hover disabled */
    #batchModal.keyboard-nav .batch-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* Mouse navigation active → hover enabled */
    #batchModal.mouse-nav .batch-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .batch-row {
        scroll-margin-top: 50px;
    }

        .batch-row:focus {
            outline: none;
        }

    .batch-disabled {
        background-color: #f8d7da !important;
        color: #842029;
        cursor: not-allowed;
        opacity: 0.7;
    }

        .batch-disabled.selected {
            background-color: #f8d7da !important;
        }


    /* ===============================
                           ITEM MODAL STYLES
                        =============================== */
    #itemModal .modal-dialog {
        max-height: 90vh;
    }

    #itemModal .modal-content {
        max-height: 90vh;
        display: flex;
        flex-direction: column;
    }

    #itemModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #itemModal .modal-header .btn-close {
            filter: invert(1);
        }

    #itemModal .modal-body {
        padding: 1rem;
        display: flex;
        flex-direction: column;
    }

    .item-table-wrapper {
        min-height: 50px;
        max-height: 350px;
        overflow-y: auto;
    }

    #itemTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        z-index: 2;
    }

    .item-table-wrapper::-webkit-scrollbar {
        width: 6px;
    }

    .item-table-wrapper::-webkit-scrollbar-thumb {
        background: #adb5bd;
        border-radius: 4px;
    }

    .item-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    /* Keyboard navigation active → hover disabled */
    #itemModal.keyboard-nav .item-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* Mouse navigation active → hover enabled */
    #itemModal.mouse-nav .item-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .item-row {
        scroll-margin-top: 50px;
    }

        .item-row:focus {
            outline: none;
        }

    /* ===============================
                           OTHER EXISTING STYLES
                        =============================== */
    tr.selected {
        background-color: #d2e3fc;
        border: 2px solid green;
    }

    #settingsSidebar {
        box-shadow: -3px 0 5px rgba(0,0,0,0.2);
    }

    #offerTable tbody tr:focus {
        background-color: #198754 !important;
        color: #0d6efd;
        border: 2px solid green;
        outline: none;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 24px;
    }

        .switch input {
            display: none;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 24px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #28a745;
    }

        input:checked + .slider:before {
            transform: translateX(26px);
        }

    .slider.round {
        border-radius: 24px;
    }


    /* ===============================
                           SALES ORDER MODAL STYLING
                       =============================== */
    #salesOrderModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #salesOrderModal .modal-header .btn-close {
            filter: invert(1);
        }

    #salesOrderTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .sales-order-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    /* Keyboard navigation active → hover disabled */
    #salesOrderModal.keyboard-nav .sales-order-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* Mouse navigation active → hover enabled */
    #salesOrderModal.mouse-nav .sales-order-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .sales-order-row {
        scroll-margin-top: 50px;
    }

        .sales-order-row:focus {
            outline: none;
        }

    /* ===============================
                           CUSTOMER LIST MODAL STYLING
                       =============================== */
    #customerListModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #customerListModal .modal-header .btn-close {
            filter: invert(1);
        }

    .customer-table-wrapper {
        min-height: 50px;
        max-height: 350px;
        overflow-y: auto;
    }

    #customerTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        z-index: 2;
    }

    .customer-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    #customerListModal.keyboard-nav .customer-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #customerListModal.mouse-nav .customer-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .customer-row {
        scroll-margin-top: 50px;
    }

        .customer-row:focus {
            outline: none;
        }

    .salt-col {
        display: none;
    }
</style>
<style>
    #refreshBtn:hover {
        opacity: 0.85;
        transform: rotate(90deg);
        transition: all 0.2s ease;
    }
</style>
<style>
    /* ================================================
                           SETTINGS WARNING MODAL STYLING
                           ================================================ */
    .settings-warning-modal {
        z-index: 9999 !important;
    }

    .settings-warning-popup {
        font-size: 1rem;
        border-radius: 10px;
        padding: 20px;
    }

        .settings-warning-popup .swal2-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #856404;
        }

        .settings-warning-popup .swal2-html-container {
            font-size: 0.95rem;
        }

            .settings-warning-popup .swal2-html-container ul {
                padding-left: 20px;
            }

            .settings-warning-popup .swal2-html-container li {
                margin-bottom: 5px;
            }

        .settings-warning-popup .swal2-confirm {
            font-weight: 600;
            padding: 10px 25px;
        }
</style>
<style>
    .total-amount {
        font-size: 1.4rem;
        font-weight: 700;
        color: #198754;
    }
</style>
<style>
    .custom-header th {
        background: linear-gradient(180deg, #eef3f8, #d8e3ef);
        color: #16202b;
        font-weight: 700;
        text-align: center;
        border-bottom: 0px solid #b6c6d6;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,0.05);
    }

    .shortcut-box {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        line-height: 14px;
    }

    .shortcut-link {
        font-size: 11px;
        color: #2465c7;
        cursor: pointer;
        text-decoration: none;
        font-weight: 600;
    }

        .shortcut-link:hover {
            text-decoration: underline;
        }

        .shortcut-link.text-danger {
            color: #dc3545;
        }
</style>
<!-- ================================================================
     🔹 GLOBAL LOADER (HIDDEN BY DEFAULT)
     ================================================================ -->
<div id="globalLoader">
    <div class="loader-content">
        <div class="spinner"></div>
        <div class="loader-text">Loading...</div>
    </div>
</div>

<div class="card mb-2 shadow-sm" style="border-radius: 6px; overflow: hidden;">
    <div class="card-header text-white d-flex align-items-center py-1 px-3"
         style="background:#2b6ac9">
        <h6 class="mb-0 me-auto" style="font-size: 0.85rem;">
            Sales Bill
        </h6>
        <button type="button"
                id="refreshBtn"
                class="btn btn-sm p-1 me-2 border-0 bg-transparent text-white"
                title="Refresh">
            <span class="fs-5">🔄</span>
        </button>
        <button type="button"
                class="btn btn-sm btn-light"
                id="settingsBtn"
                style="font-size: 0.78rem; padding: 3px 10px;">
            ⚙️ Settings
        </button>
    </div>
</div>

<!-- ================================================================
     🔹 MAIN FORM
     ================================================================ -->
<form id="salesForm" asp-action="Create">
    <input type="hidden" id="SelectedItemId" />
    <input type="hidden" id="SelectedOfferId" asp-for="OfferId" />
    <input type="hidden" asp-for="CustomerId" id="CustomerId" />
    <input type="hidden" asp-for="PharmacyDoctorId" id="DoctorId" />
    <input type="hidden" asp-for="SalesOrderId" id="SalesOrderId" />
    <input type="hidden" id="isShare" name="isShare" value="false" />
    <input type="hidden" id="RedeemPoints" name="RedeemPoints" value="0" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="container-fluid px-3">

        <div class="row">
            <div class="row mb-2">

                <label asp-for="BillNo" class="col-md-2 col-form-label text-start small"> Bill No <i class="redColor">*</i> </label>
                <div class="col-md-2">
                    <input asp-for="BillNo" type="text" class="form-control form-control-sm" required />
                    <span asp-validation-for="BillNo" class="text-danger"></span>
                </div>

                <label asp-for="BillDate" class="col-md-2 col-form-label text-start small">Bill Date <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input type="date" asp-for="BillDate" class="form-control form-control-sm" required />
                    <span asp-validation-for="BillDate" class="text-danger"></span>
                </div>

                <label class="col-md-2 ">Billing Type</label>
                <div class="col-md-2">
                    <select asp-for="billingType" id="billingType" class="form-control form-control-sm">
                        <option value="walkin">Cash</option>
                        <option value="registered">Customer</option>
                    </select>
                </div>

                <label class="col-md-2 col-form-label text-start small">Mobile No <i class="redColor">*</i></label>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="w-100">
                        <input asp-for="MobileNo" type="text" class="form-control form-control-sm" id="mobilenumber" />
                        <span asp-validation-for="MobileNo" class="text-danger"></span>
                        <small id="phoneError" class="text-danger d-none"></small>
                    </div>
                    <div class="shortcut-box">
                        <span id="btnF1CustomerList" class="shortcut-link">F1 - List</span>
                    </div>
                </div>

                <label class="col-md-2 col-form-label text-start small">Customer <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input asp-for="CustomerName" class="form-control form-control-sm" id="customer" />
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>
                <input type="hidden" id="previousBalance" />
                <label class="col-md-2 col-form-label text-start small">Address <i class="redColor">*</i></label>
                <div class="col-md-2 mt-2 mt-md-0">
                    <input asp-for="Address" id="customeraddress" class="form-control form-control-sm" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                @if (Model.DoctorRequired)
                {
                    <label class="col-md-2 col-form-label small">Doctor Mobile No <i class="redColor">*</i></label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorMobileNumber" class="form-control form-control-sm" id="doctorMobile" />
                    </div>

                    <label class="col-md-2 col-form-label small">Doctor</label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorName" class="form-control form-control-sm" id="doctorname" />
                    </div>

                    <label class="col-md-2 col-form-label small">Registration Number</label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorRegNumber" class="form-control form-control-sm" id="doctorregno" />
                    </div>
                }


                <label class="col-md-2 col-form-label text-start small">Type</label>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-check form-switch">
                        <input class="form-check-input"
                               type="checkbox"
                               id="paymentToggle">
                        <label class="form-check-label fw-bold" id="paymentToggleLabel" style="color: green;">
                            Cash
                        </label>
                    </div>

                    <!-- Hidden field for model binding -->
                    <input type="hidden" asp-for="PaymentType" id="paymentTypeHidden" value="cash" />
                </div>

            </div>
        </div>

        <!-- Loyalty Program Panel -->
        <div class="row d-none" id="loyaltyPointsPanel">
            <div class="col-12 mb-3">
                <div class="card border-info" style="border-radius: 8px; background-color: #f0f8ff;">
                    <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center justify-content-between">
                        <div class="d-flex align-items-center flex-wrap gap-3">
                            <div class="d-flex align-items-center gap-2" id="loyaltyDetailsWrapper">
                                <i class="bi bi-gift-fill text-info" style="font-size: 1.2rem;" id="loyaltyGiftIcon"></i>
                                <div id="loyaltyDetailsSection">
                                    <span class="fw-bold text-dark">Customer Loyalty Program:</span>
                                    <span class="badge bg-primary text-white ms-2" style="font-size: 0.9rem;" id="loyaltyBalanceBadge">0 Points</span>
                                    <span class="text-muted ms-2 small">Available Value: <strong class="text-success">₹<span id="loyaltyValueSpan">0.00</span></strong></span>
                                    <span class="ms-3 text-secondary small" id="loyaltyMinRedeemSpan"></span>
                                </div>
                            </div>
                            
                            <div id="loyaltyDivider" style="border-left: 1px solid #ccc; height: 24px; margin: 0 10px;"></div>
                            
                            <div class="d-flex align-items-center gap-2" id="loyaltyPreviousBalanceSection">
                                <i class="bi bi-wallet2 text-danger" style="font-size: 1.2rem;"></i>
                                <div>
                                    <span class="fw-bold text-dark">Previous Balance:</span>
                                    <span class="badge bg-danger text-white ms-2" style="font-size: 0.9rem;">₹<span id="loyaltyPreviousBalanceValue">0.00</span></span>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0" id="loyaltyRedeemSection">
                            <label for="loyaltyRedeemInput" class="small fw-bold text-dark mb-0">Redeem Points:</label>
                            <input type="number" id="loyaltyRedeemInput" class="form-control form-control-sm text-end" style="width: 100px; display: inline-block;" value="0" min="0">
                            <button type="button" class="btn btn-sm btn-info text-white" id="btnApplyLoyaltyPoints">Apply Discount</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <div style="overflow-x: auto; width: 100%;">
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table custom-header">
                        <tr>
                            <th style="min-width:30%">Item</th>
                            <th style="min-width:30%">Batch</th>
                            <th class="text-center">Expiry</th>
                            <th class="text-center">Mrp</th>

                            @if (ViewBag.BusinessType == 2)
                            {
                                <th class="text-center" id="qtyView">Qty</th>
                                <th class="text-center" id="qtyTabsView">Tabs</th>
                            }
                            else
                            {
                                <th class="text-center">Qty</th>
                            }

                            <th class="text-center">Rate</th>
                            <th class="text-center">Gst %</th>
                            <th class="text-center">Cess</th>
                            <th class="text-center">Disc %</th>
                            <th class="text-center">Amount</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="SalesItemBody"></tbody>
                    <tfoot>
                        <tr>
                            <th colspan="8">
                                <u id="addRow" style="color:green; cursor:pointer;">Add Row</u>
                            </th>
                        </tr>
                    </tfoot>
                </table>

                <!-- Totals -->
                <div class="row mt-3">
                    <div class="col-md-7">
                        <strong>Payment Details</strong>
                        <table class="table table-bordered table-striped">
                            <thead class="table custom-header">
                                <tr>
                                    <th style="min-width:30%">Payment Mode</th>
                                    <th class="text-center">Amount</th>
                                    <th class="text-center">Reference NO</th>
                                    <th class="text-center">Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="PaymentDetailsBody">
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="float-start">
                                        <u id="addPaymentRow" style="color:green; text-align:right; cursor:pointer;">Add Row</u>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- RETURN AMOUNT DISPLAY -->
                        <div class="row mt-2">
                            <div class="col-md-12">
                                <span class="fw-bold text-danger" style="font-size: xx-large;">
                                    Return Amount :
                                </span>
                                <span id="returnAmountDisplay"
                                      class="fw-bold"
                                      style="font-size: xxx-large;color:#8B0000;">
                                    0.00
                                </span>
                                <input asp-for="ReturnAmount" id="ReturnAmount" value="0" class="form-control form-control-sm" hidden />
                            </div>
                        </div>

                    </div>
                    <div class="col-md-5">
                        <div class="row mb-2">
                            <label asp-for="Total" class="col-md-3 col-form-label text-start small">Total</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="Total" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label class="col-md-3 col-form-label text-start small">Bill Discount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-2">
                                <input asp-for="discountPercent" id="discountPercent" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <input asp-for="discountAmount" id="discountamount" class="form-control form-control-sm" placeholder="amount" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="Totaldiscount" class="col-md-3 col-form-label text-start small">Discount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="Totaldiscount" id="Totaldiscount" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="TotalGstAmt" class="col-md-3 col-form-label text-start small">Gst</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="TotalGstAmt" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="TotalCessAmount" class="col-md-3 col-form-label text-start small">Cess Amount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="TotalCessAmount" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="TotalPayable" class="col-md-3 col-form-label text-start small fw-bold">Total Amount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="TotalPayable" id="totalPayable" class="form-control form-control-sm total-amount" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="RoundOffAmount" class="col-md-3 col-form-label text-start small"></label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="RoundOffAmount" id="roundOffAmount" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <!-- Loyalty Points Highlights Container -->
                        <div id="loyaltySummaryContainer" style="display: none; background-color: #fffbeb !important; border: 2px solid #fbbf24 !important; border-radius: 8px !important; padding: 12px !important; margin-bottom: 12px !important; margin-top: 5px !important; box-shadow: 0 4px 6px -1px rgba(245, 158, 11, 0.1) !important;">
                            <div class="row mb-2" id="loyaltyDiscountRow" style="margin-bottom: 8px !important;">
                                <label id="loyaltyPointsDiscountLabel" class="col-md-5 col-form-label text-start small fw-bold" style="color: #b45309 !important;">Points Discount</label>
                                <div class="col-md-2"></div>
                                <div class="col-md-5">
