        function getSalesTaxBreakup(amountAfterDiscount, gstPercent, cessPercent) {
            const gst = parseFloat(gstPercent) || 0;
            const cess = parseFloat(cessPercent) || 0;
            const taxableBase = parseFloat(amountAfterDiscount) || 0;
            const totalTaxPercent = gst + cess;

            if (salesTaxMode === SALES_TAX_INCLUSIVE && totalTaxPercent > 0) {
                const divisor = 1 + (totalTaxPercent / 100);
                const taxableAmount = taxableBase / divisor;
                const gstAmt = (taxableAmount * gst) / 100;
                const cessAmt = (taxableAmount * cess) / 100;

                return {
                    taxableAmount: taxableAmount,
                    gstAmt: gstAmt,
                    cessAmt: cessAmt,
                    lineTotal: taxableBase
                };
            }

            const gstAmt = (taxableBase * gst) / 100;
            const cessAmt = (taxableBase * cess) / 100;

            return {
                taxableAmount: taxableBase,
                gstAmt: gstAmt,
                cessAmt: cessAmt,
                lineTotal: taxableBase + gstAmt + cessAmt
            };
        }

        function calculateRow(row) {
            let qty = parseFloat(row.find(".qty").val()) || 0;
            let rate = parseFloat(row.find(".rate").val()) || 0;
            let gst = parseFloat(row.find(".gst").val()) || 0;
            let cess = parseFloat(row.find(".cess").val()) || 0;
            let discount = parseFloat(row.find(".discount").val()) || 0;
            let stripRate = parseFloat(row.find(".stripe-rate").val()) || 0;
            // TABLET-WISE CALCULATION
            let grossAmount = 0;
            let totalTablets = qty; // Default for StripWise

            if (isTabletWiseMode) {
                const itemId = row.find(".item-id").val();
                let conversion = parseFloat(row.attr("data-conversion"));

                if (!conversion || conversion <= 0) {
                    conversion = itemConversionMap[itemId] || 1;
                }

                const tabletQty = parseFloat(row.find(".tablet-qty").val()) || 0;

                // TOTAL TABLETS = (Strips × Conversion) + Remaining Tablets
                totalTablets = (qty * conversion) + tabletQty;

                // RATE IS PER TABLET, SO DIRECTLY MULTIPLY
               // grossAmount = totalTablets * rate;
                grossAmount = (totalTablets / conversion) * stripRate;

                console.log("TabletWise Calculation - Strips:", qty, "Tablets:", tabletQty, "Total Tablets:", totalTablets, "Rate/Tablet:", rate, "Gross:", grossAmount);

                console.log("🔍 DEBUG TabletWise:");
                console.log("  - Qty (Strips):", qty);
                console.log("  - Q.Tablet:", tabletQty);
                console.log("  - Conversion:", conversion);
                console.log("  - Total Tablets:", totalTablets);
                console.log("  - Rate/Tablet:", rate);
                console.log("  - Gross Amount:", grossAmount);
                console.log("  - GST %:", gst);
                console.log("  - Discount %:", discount);
            } else {
                // STRIP-WISE: Rate is per strip
               // grossAmount = qty * rate;
                const itemId = row.find(".item-id").val();
                let conversion = parseFloat(row.attr("data-conversion"));
                
                if (!conversion || conversion <= 0) {
                    conversion = itemConversionMap[itemId] || 1;
                }
                
                let totalTablets = qty * conversion;
                
               // grossAmount = totalTablets * rate;
                grossAmount = totalTablets * stripRate;
            }

            // DISCOUNT
            let discountAmt = (grossAmount * discount) / 100;
            let amountAfterDiscount = grossAmount - discountAmt;

            const taxBreakup = getSalesTaxBreakup(amountAfterDiscount, gst, cess);

            row.find(".discount-amt").val(discountAmt.toFixed(2));
            row.find(".Amount").val(taxBreakup.lineTotal.toFixed(2));

            calculateTotalSummary();
        }

        function calculateTotalSummary() {
            let total = 0;
            let totalGst = 0;
            let totalCess = 0;
            let totalDiscount = 0;
            let totalamt = 0;
            let gstRows = [];

            $("#SalesItemBody tr").each(function () {
                let row = $(this);
                let qty = parseFloat(row.find(".qty").val()) || 0;
                let rate = parseFloat(row.find(".rate").val()) || 0;
                let gst = parseFloat(row.find(".gst").val()) || 0;
                let cess = parseFloat(row.find(".cess").val()) || 0;
                let discount = parseFloat(row.find(".discount").val()) || 0;
                let stripRate = parseFloat(row.find(".stripe-rate").val()) || 0;
                // ✅ TABLET-WISE CALCULATION
                let grossAmount = 0;
                let totalTablets = qty;

                if (isTabletWiseMode) {
                    const itemId = row.find(".item-id").val();
                    let conversion = parseFloat(row.attr("data-conversion"));

                    if (!conversion || conversion <= 0) {
                        conversion = itemConversionMap[itemId] || 1;
                    }

                    const tabletQty = parseFloat(row.find(".tablet-qty").val()) || 0;

                    // TOTAL TABLETS = (Strips × Conversion) + Remaining Tablets
                    totalTablets = (qty * conversion) + tabletQty;

                    // ✅ RATE IS PER TABLET
                  //  grossAmount = totalTablets * rate;
                  grossAmount = (totalTablets / conversion) * stripRate;
                } else {
                    // ✅ STRIP-WISE: Rate is per strip
                  //  grossAmount = qty * rate;
                     const itemId = row.find(".item-id").val();
                     let conversion = parseFloat(row.attr("data-conversion"));
                    
                     if (!conversion || conversion <= 0) {
                         conversion = itemConversionMap[itemId] || 1;
                     }
                    
                     let totalTablets = qty * conversion;
                    
                   //  grossAmount = totalTablets * rate;
                    grossAmount = totalTablets * stripRate;
                }

                let discountAmt = (grossAmount * discount) / 100;
                let amountAfterDiscount = grossAmount - discountAmt;
                const taxBreakup = getSalesTaxBreakup(amountAfterDiscount, gst, cess);

                total += taxBreakup.taxableAmount;
                totalamt += taxBreakup.taxableAmount;
                totalGst += taxBreakup.gstAmt;
                totalCess += taxBreakup.cessAmt;
                totalDiscount += discountAmt;

                gstRows.push({
                    taxableAmount: taxBreakup.taxableAmount,
                    gst: gst,
                    cess: cess
                });
            });

            let percentInput = parseFloat($("#discountPercent").val()) || 0;
            let amountInput = parseFloat($("#discountamount").val()) || 0;

            let globalDiscountPercent = 0;
            let globalDiscountAmt = 0;

            if ($("#discountPercent").is(":focus") || (percentInput > 0 && amountInput === 0)) {
                globalDiscountPercent = percentInput;
                globalDiscountAmt = (total * globalDiscountPercent) / 100;
                $("#discountamount").val(globalDiscountAmt.toFixed(2));
            } else if ($("#discountamount").is(":focus") || (amountInput > 0 && percentInput === 0)) {
                globalDiscountAmt = amountInput;
                globalDiscountPercent = total > 0 ? (globalDiscountAmt / total) * 100 : 0;
                $("#discountPercent").val(globalDiscountPercent.toFixed(2));
            } else if (percentInput > 0 && amountInput > 0) {
                // Both values exist (from Sales Order load)
                globalDiscountPercent = percentInput;
                globalDiscountAmt = amountInput;

                globalDiscountAmt = (total * globalDiscountPercent) / 100;
                $("#discountamount").val(globalDiscountAmt.toFixed(2));
            }

            if (globalDiscountAmt > 0) {
                totalDiscount += globalDiscountAmt;
                totalamt = total - globalDiscountAmt;

                totalGst = 0;
                totalCess = 0;
                gstRows.forEach(row => {
                    let rowDiscountAmt = (row.taxableAmount * globalDiscountPercent) / 100;
                    let rowAfterGlobalDiscount = row.taxableAmount - rowDiscountAmt;
                    let gstAmt = (rowAfterGlobalDiscount * row.gst) / 100;
                    let cessAmt = (rowAfterGlobalDiscount * row.cess) / 100;
                    totalGst += gstAmt;
                    totalCess += cessAmt;
                });
            }


            let totalPayable = totalamt + totalGst + totalCess;
            let roundedPayable = Math.round(totalPayable);
            let roundOffAmount = Number((roundedPayable - totalPayable).toFixed(2));


            let paidAmount = 0;
            $(".paymentAmount").each(function () {
                paidAmount += parseFloat($(this).val()) || 0;
            });

            let balance = 0;
            let returnAmount = 0;

            if (paidAmount > roundedPayable) {
                returnAmount = paidAmount - roundedPayable;
                balance = 0;
            } else {
                balance = roundedPayable - paidAmount;
                returnAmount = 0;
            }

            $("[name='Total']").val(totalamt.toFixed(2));
            $("[name='Totaldiscount']").val(totalDiscount.toFixed(2));
            $("[name='TotalGstAmt']").val(totalGst.toFixed(2));
            $("[name='TotalCessAmount']").val(totalCess.toFixed(2));
            $("[name='TotalPayable']").val(roundedPayable.toFixed(2));
            $("[name='RoundOffAmount']").val(roundOffAmount);

            $("#paidAmout").val(paidAmount.toFixed(2));
            $("#balance").val(balance.toFixed(2));
            $("#returnAmount").val(returnAmount.toFixed(2));
            $("#returnAmountDisplay").text(returnAmount.toFixed(2)); 
        }

        function toggleAddRowButton() {
            if ($("#SalesItemBody tr").length > 0) {
                $("#addRow").hide();
            } else {
                $("#addRow").show();
            }
        }

        setTimeout(function () {
            if ($("#SalesItemBody tr").length === 0) {
                addNewRow();
            }
            toggleAddRowButton();
        }, 300);

        // NEW VALIDATION HANDLER (Bill discount validation)
        $("#discountPercent").on("input", function() {
            let value = parseFloat($(this).val()) || 0;

            // HARD LIMIT: Cannot exceed 100%
            if (value > 100) {
                toastr.error("Discount cannot exceed 100%", "Invalid Discount");
                $(this).val(100); // Set to max 100
                return;
            }

            // WARNING: If discount > 50%
            if (value > 50) {
                toastr.warning("High discount alert: " + value + "%", "Review Required");
            }
        });
    </script>

    <!-- ================================================================
         🔹 PAYMENT GRID MANAGEMENT
         ================================================================ -->
    <script>
       $(document).ready(function () {
           $("#addPaymentRow").click(function () {
               addPaymentRow();
           });
       
           $(document).on("click", ".remove-paymentrow-btn", function () {
               $(this).closest("tr").remove();
               updatePaymentRowIndices();
               calculateTotalPaid();
               togglePaymentAddButton();
           });
       
           $(document).on("keyup", ".paymentAmount", function () {
               calculateTotalPaid();
           });
       
           togglePaymentAddButton();
       });
       
       function addPaymentRow() {
           let newRow = `
               <tr>
                   <td style="min-width:185px;">  <select name="SalsePaymentDetails[${subrowIndex}].PaymentModeId"  class="form-control form-control-sm paymentMode-dropdown" required>
                           <option value="">-- Select --</option>
                           ${getPaymentOptions()}
                       </select>
                   </td>
                   <td> <input name="SalsePaymentDetails[${subrowIndex}].Amount" class="form-control form-control-sm paymentAmount" value="0" /> </td>
                   <td> <input name="SalsePaymentDetails[${subrowIndex}].ReferenceNo" class="form-control form-control-sm paymentReferenceNO" /> </td>
                   <td> <input name="SalsePaymentDetails[${subrowIndex}].Description" class="form-control form-control-sm rate paymentDescription" /> </td>
                   <td> <u class="remove-paymentrow-btn text-danger" style="cursor:pointer;">Remove</u> </td>
               </tr>`;
       
           $("#PaymentDetailsBody").append(newRow);
       
           // AUTO FILL PAYMENT AMOUNT
           let rowCount = $("#PaymentDetailsBody tr").length;
       
           if (rowCount === 1) {
               let totalPayable = parseFloat($("#totalPayable").val()) || 0;
               if (totalPayable > 0) {
                   $("#PaymentDetailsBody tr:last .paymentAmount")
                       .val(totalPayable.toFixed(2));
               }
           } else {
               let balance = parseFloat($("#balance").val()) || 0;
               if (balance > 0) {
                   $("#PaymentDetailsBody tr:last .paymentAmount")
                       .val(balance.toFixed(2));
               } else {
                   $("#PaymentDetailsBody tr:last .paymentAmount").val("0");
               }
           }
       
           subrowIndex++;
           calculateTotalPaid();
           togglePaymentAddButton();
       }

        function getPaymentOptions() {
            return `@foreach (var item in ViewBag.PaymentMode) {
                <option value="@item.Value">@item.Text</option>
              }
            `;
        }

        function calculateTotalPaid() {
            let totalPaid = 0;
            $(".paymentAmount").each(function () {
                let val = parseFloat($(this).val()) || 0;
                totalPaid += val;
            });

            $("#paidAmout").val(totalPaid.toFixed(2));
            calculateTotalPaymentSummary();
        }

        function calculateTotalPaymentSummary() {
            let returnAmt = 0;
            let balance = 0;
            var totalPayable = parseFloat($("#totalPayable").val()) || 0;
            var paidAmt = parseFloat($("#paidAmout").val()) || 0;

            // Subtract loyalty points discount from the payable amount for cash/card calculation
            var redeemPoints = parseInt($("#RedeemPoints").val()) || 0;
            var valInRs = loyaltyInfo ? loyaltyInfo.pointValueInRs : 0;
            var pointsValue = redeemPoints * valInRs;
            var netPayable = Math.max(0, totalPayable - pointsValue);

            if (pointsValue > 0) {
                $("#loyaltyPointsDiscountInput").val(pointsValue.toFixed(2));
                $("#netPayableInput").val(netPayable.toFixed(2));
                $("#loyaltyPointsDiscountLabel").text(`Points Discount (${redeemPoints} pts)`);
                $("#loyaltyDiscountRow").show();
                $("#netPayableRow").show();
                $("#loyaltySummaryContainer").show();
            } else {
                $("#loyaltyPointsDiscountInput").val("0.00");
                $("#netPayableInput").val("0.00");
                $("#loyaltyPointsDiscountLabel").text("Points Discount");
                $("#loyaltyDiscountRow").hide();
                $("#netPayableRow").hide();
                $("#loyaltySummaryContainer").hide();
            }

            if (paidAmt > netPayable && paidAmt > 0) {
                returnAmt = paidAmt - netPayable;
                balance = 0;
            } else {
                balance = netPayable - paidAmt;
            }
            $("#returnAmount").val(returnAmt.toFixed(2));
            $("#ReturnAmount").val(returnAmt.toFixed(2));
            $("#balance").val(balance.toFixed(2));
            $("#returnAmountDisplay").text(returnAmt.toFixed(2));
        }

        function updatePaymentRowIndices() {
            const rows = document.querySelectorAll('#PaymentDetailsBody tr');
            subrowIndex = 0;
            rows.forEach(row => {
                row.querySelectorAll('input, select').forEach(input => {
                    const name = input.name;
                    if (name) {
                        input.name = name.replace(/\[\d+\]/, `[${subrowIndex}]`);
                    }
                });
                subrowIndex++;
            });
        }

        function togglePaymentAddButton() {
            if ($("#PaymentDetailsBody tr").length > 0) {
                $("#addPaymentRow").hide();
            } else {
                $("#addPaymentRow").show();
            }
        }
</script>

