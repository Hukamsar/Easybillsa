    // ================================================================
    // 🔹 KEYBOARD NAVIGATION - Q.TABLET FIELD (TabletWise Mode)
    // ================================================================
    $(document).on("keydown", ".tablet-qty", function (e) {
        const row = $(this).closest("tr");
        const input = $(this);

        // TAB KEY HANDLER
        if (e.key === "Tab") {
            e.preventDefault();

            const itemBarcode = (row.find(".item-barcode").val() || "").trim();
            const batch = (row.find(".batch").val() || "").trim();

            // Current row is BLANK
            if (!itemBarcode && !batch) {
                let validRowCount = 0;

                $("#SalesItemBody tr").each(function() {
                    const $r = $(this);
                    if ($r.is(row)) return;

                    const item = ($r.find(".item-barcode").val() || "").trim();
                    const b = ($r.find(".batch").val() || "").trim();

                    if (item && b) {
                        validRowCount++;
                    }
                });

                if (validRowCount === 0) {
                    toastr.error("At least one item row is required. Please add item before moving forward.", "Validation Error");
                    row.find(".item-barcode").focus();
                    return;
                }

                row.remove();
                calculateTotalSummary();

                setTimeout(() => {
                    $("#discountPercent").focus().select();
                }, 50);

                return;
            }

            // Current row has SOME data but incomplete
            if (itemBarcode && !batch) {
                toastr.warning("Please select batch before moving forward.", "Incomplete Row");
                row.find(".item-barcode").focus();
                return;
            }

            const qty = parseFloat(row.find(".qty").val()) || 0;
            if (qty < 1) {
                toastr.warning("Quantity must be at least 1.", "Invalid Quantity");
                row.find(".qty").focus().select();
                return;
            }

            // Current row is COMPLETE → Go to discount percent
            $("#discountPercent").focus().select();
            return;
        }

        // ENTER KEY HANDLER
        if (e.key === "Enter") {
            e.preventDefault();

            // Move to Qty field (which is readonly in TabletWise, but still in flow)
            // Then Qty's Enter will move to Rate
            row.find(".qty").focus().select();

            // Or directly move to Rate
            // row.find(".rate").focus().select();

            return;
        }

        // ARROW RIGHT
        if (e.key === "ArrowRight") {
            e.preventDefault();
            row.find(".qty").focus().select();
            return;
        }

        // ARROW LEFT
        if (e.key === "ArrowLeft") {
            e.preventDefault();
            row.find(".mrp").focus().select();
            return;
        }

        // ARROW DOWN
        if (e.key === "ArrowDown") {
            e.preventDefault();
            const nextRow = row.next("tr");
            if (!nextRow.length) return;
            nextRow.find(".tablet-qty").focus().select();
            return;
        }

        // ARROW UP
        if (e.key === "ArrowUp") {
            e.preventDefault();
            const prevRow = row.prev("tr");
            if (!prevRow.length) return;
            prevRow.find(".tablet-qty").focus().select();
        }
    });

</script>

