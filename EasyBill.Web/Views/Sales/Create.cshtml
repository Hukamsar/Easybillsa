                const row = $(this);
                const itemBarcode = (row.find(".item-barcode").val() || "").trim();
                const batch = (row.find(".batch").val() || "").trim();
                const qty = parseFloat(row.find(".qty").val()) || 0;

                // ✅ CHECK INCOMPLETE ROWS (Item but no Batch)
                if (itemBarcode && !batch && !firstIncompleteRow) {
                    firstIncompleteRow = row;
                }

                // ✅ TABLET-WISE QTY VALIDATION
                let isValidQty = false;

                if (isTabletWiseMode) {
                    const qtyTabs = parseFloat(row.find(".tablet-qty").val()) || 0;

                    // Valid if EITHER Qty > 0 OR TabletQty > 0
                    if (qty > 0 || qtyTabs > 0) {
                        isValidQty = true;
                    }

                    // Check for negative values
                    if (qty < 0 || qtyTabs < 0) {
                        isValidQty = false;
                    }

                    // Store first invalid row
                    if (!isValidQty && itemBarcode && batch && !firstZeroQtyRow) {
                        firstZeroQtyRow = row;
                    }
                } else {
                    // STRIP-WISE: Qty must be >= 1
                    if (qty >= 1) {
                        isValidQty = true;
                    }

                    // Store first invalid row
                    if (!isValidQty && itemBarcode && batch && !firstZeroQtyRow) {
                        firstZeroQtyRow = row;
                    }
                }

                // ✅ CHECK IF ROW IS VALID (has item, batch, and valid qty)
                if (itemBarcode && batch && isValidQty) {
                    hasValidItemRow = true;
                }
            });

            // ✅ ERROR: INCOMPLETE ROW (Item but no Batch)
            if (firstIncompleteRow) {
                toastr.error("Please select batch for all items or remove incomplete rows.", "Incomplete Item Row");
                firstIncompleteRow.find(".item-barcode").focus().select();
                return false;
            }

            // ✅ ERROR: INVALID QTY
            if (firstZeroQtyRow) {
                if (isTabletWiseMode) {
                    const qty = parseFloat(firstZeroQtyRow.find(".qty").val()) || 0;
                    const qtyTabs = parseFloat(firstZeroQtyRow.find(".tablet-qty").val()) || 0;

                    if (qty < 0 || qtyTabs < 0) {
                        toastr.error("Quantity cannot be negative.", "Invalid Quantity");

                        if (qty < 0) {
                            firstZeroQtyRow.find(".qty").focus().select();
                        } else {
                            firstZeroQtyRow.find(".tablet-qty").focus().select();
                        }
                    } else {
                        toastr.error("Please enter quantity or tablet quantity.", "Invalid Quantity");
                        firstZeroQtyRow.find(".tablet-qty").focus().select();
                    }
                } else {
                    toastr.error("Quantity must be at least 1. Please enter valid quantity.", "Invalid Quantity");
                    firstZeroQtyRow.find(".qty").focus().select();
                }

                return false;
            }

            // ✅ ERROR: NO VALID ITEMS
            if (!hasValidItemRow) {
                toastr.error("Please add at least one item with quantity before saving.", "Item Required");

                const firstRow = $("#SalesItemBody tr:first");
                if (firstRow.length) {
                    firstRow.find(".item-barcode").focus().select();
                }
                return false;
            }

            var form = $(this);

            confirmSave(function(ok) {
