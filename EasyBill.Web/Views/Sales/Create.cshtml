    <script>
        $(document).on("click", "#btnF1CustomerList", function (e) {
            e.preventDefault();

            showLoader("Loading customers...");

            $.get('/Sales/GetCustomer', function (res) {

                hideLoader();

                if (!res.found || !res.data || res.data.length === 0) {
                    toastr.info("No customer found.");
                    return;
                }

                let rows = "";

                res.data.forEach(customer => {

                    const customerId = customer.id || customer.Id || "";
                    const customerName = customer.name || customer.Name || "";
                    const mobileNo = customer.phoneNo || customer.PhoneNo || "";
                    const address = customer.address || customer.Address || "";

                    rows += `<tr class="customer-row" tabindex="0"
                        data-customerid="${customerId}"
                        data-name="${customerName}"
                        data-phone="${mobileNo}"
                        data-address="${address}">
                        <td>${customerName}</td>
                        <td>${mobileNo}</td>
                    </tr>`;
                });

                $("#customerTableBody").html(rows);
                $("#customerSearch").val("");
                currentCustomerIndex = -1;
                $("#customerListModal").modal("show");

            }).fail(function () {

                hideLoader();

                toastr.error("Error loading customers");
            });
        });

        $(document).on("keydown", "#mobilenumber", function (e) {
            if (e.key !== "F1") return;

            e.preventDefault();
            e.stopImmediatePropagation();

            $("#btnF1CustomerList").trigger("click");
        });

        $(document).on("input", "#customerSearch", function () {
            const searchText = $(this).val().toLowerCase().trim();

            $("#customerTableBody tr").each(function () {
                const customerName = ($(this).data("name") || "").toString().toLowerCase();
                const mobileNo = ($(this).data("phone") || "").toString().toLowerCase();

                $(this).toggle(customerName.includes(searchText) || mobileNo.includes(searchText));
            });

            currentCustomerIndex = -1;
            $("#customerTableBody .customer-row").removeClass("selected");
        });

        $(document).on("keydown", function (e) {
            if (!$("#customerListModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                customerNavMode = "keyboard";
                isKeyboardScrollingCustomerModal = true;
                $("#customerListModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".customer-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentCustomerIndex === -1) {
                    currentCustomerIndex = 0;
                }
                else if (currentCustomerIndex < $rows.length - 1) {
                    currentCustomerIndex++;
                }

                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();

                if (currentCustomerIndex <= 0) return;

                currentCustomerIndex--;

                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
            else if (e.key === "Enter") {
                e.preventDefault();

                if (currentCustomerIndex === -1) {
                    currentCustomerIndex = 0;
                }

                $rows.eq(currentCustomerIndex).trigger("click");
            }
        });

        $(document).on("click", ".customer-row", function (e) {
            e.preventDefault();

            const customerId = $(this).data("customerid");
            const customerName = $(this).data("name") || "";
            const mobileNo = $(this).data("phone") || "";
            const address = $(this).data("address") || "";

            $("#billingType").val("registered");
            $("#mobilenumber, #customer, #customeraddress").prop("disabled", false);
            $("#CustomerId").val(customerId);
            $("#mobilenumber").val(mobileNo);
            $("#customer").val(customerName);
            $("#customeraddress").val(address);

            hidePhoneError();
            loadPreviousBalance(customerId);

            $("#customerListModal").modal("hide");

            setTimeout(() => {
                $("#customer").focus().select();
            }, 150);
        });

        $(document).on("mouseenter", ".customer-row", function () {
            if (!$("#customerListModal").is(":visible")) return;
            if (isKeyboardScrollingCustomerModal) return;

            customerNavMode = "mouse";

            $("#customerListModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".customer-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentCustomerIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#customerListModal", function () {
            isKeyboardScrollingCustomerModal = false;
        });

        $('#customerListModal').on('shown.bs.modal', function () {
            customerNavMode = "keyboard";

            $("#customerListModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".customer-row:visible");

            currentCustomerIndex = -1;

            if ($rows.length) {
                currentCustomerIndex = 0;
                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }

            setTimeout(() => {
                $("#customerSearch").focus().select();
            }, 200);
        });

        $('#customerListModal').on('hidden.bs.modal', function () {
            currentCustomerIndex = -1;
            $("#customerTableBody .customer-row").removeClass("selected");
        });
    </script>

    <!-- ================================================================
         🔹 ITEM MODAL - COMPLETE FUNCTIONALITY (IMPROVED)
         ================================================================ -->
    <script>
        function openItemSearchModal(searchText = "") {

            if (window.stopAutoItemOpen === true || $("#itemMasterModal").is(":visible")) {
                return;
            }

            showLoader("Loading items...");

            $.get('/Sales/GetAllItems', function (items) {

                hideLoader();

                const businessType = @ViewBag.BusinessType;

                let rows = renderSalesItemRows(items, businessType);

                $("#itemTableBody").html(rows);

                $("#itemSearch").val(searchText);

                $("#itemSearch").trigger("input");

                $("#itemModal").modal("show");

            }).fail(function () {

                hideLoader();

                toastr.error("Error loading items");
            });
        }

        function renderSalesItemRows(items, businessType) {

            let rows = "";

            items.forEach(item => {

                rows += `<tr class="item-row" tabindex="0"
                    data-barcode="${item.barcode}"
                    data-itemid="${item.id}"
                    data-name="${item.name}"
                    data-salt="${item.salt || ''}"
                    data-gst="${item.gst}"
                    data-cess="${item.cess}"
                    data-qty="${item.qty}"
                    data-maxdiscount="${item.maximumdiscount}"
                    data-allownegative="${item.allowNegative}"
                    data-minimumqty="${item.minimumQty}"
                    data-conversion="${item.conversion || 1}">

                    <td>${item.name}</td>
                    <td class="salt-col">${item.salt || ''}</td>

                    ${
                        businessType === 2
                        ? `
                            <td style="display:none;">${item.qty}</td>
                            <td>${item.availableQty}</td>
                          `
                        : `
                            <td>${item.qty}</td>
                          `
                    }
                </tr>`;
            });

            return rows;
        }

        $(document).on("input", "#itemSearch", function () {
            const searchWords = $(this).val().toLowerCase().trim().split(/\s+/);
            const isSaltSearch = $("#searchBySalt").is(":checked");
            $("#itemTableBody tr").each(function () {
                let textToSearch = "";
               // const itemText = $(this).find("td:first").text().toLowerCase();
                if (isSaltSearch) {
                     textToSearch = ($(this).data("salt") || "").toLowerCase();
                 } else {
                     textToSearch = $(this).find("td:first").text().toLowerCase();
                 }
                const itemWords = textToSearch.split(/\s+/);

                let match = true;

                for (let i = 0; i < searchWords.length; i++) {
                    if (!itemWords[i] || !itemWords[i].startsWith(searchWords[i])) {
                        match = false;
                        break;
                    }
                }

                $(this).toggle(match);
            });

            currentItemIndex = -1;
            $("#itemTableBody .item-row").removeClass("selected");
        });

        $(document).on("input", "#itemSearch", function () {
            const searchText = $(this).val().toLowerCase().trim();
            const isSaltSearch = $("#searchBySalt").is(":checked");

            $("#itemTableBody tr").each(function () {
                let match = false;

                if (isSaltSearch) {
                    // 🔥 Salt search
                    const salt = ($(this).data("salt") || "").toLowerCase();

                    // 👉 sirf wahi rows jinke paas salt hai
                    if (!salt) {
                        match = false;
                    } else {
                        match = salt.includes(searchText); // contains
                    }

                } else {
                    // 🔥 Name search (old behavior)
                    const textToSearch = $(this).find("td:first").text().toLowerCase();

                    const searchWords = searchText.split(/\s+/);
                    const itemWords = textToSearch.split(/\s+/);

                    match = searchWords.every((word, i) =>
                        itemWords[i] && itemWords[i].startsWith(word)
                    );
                }

                $(this).toggle(match);
            });

            currentItemIndex = -1;
            $("#itemTableBody .item-row").removeClass("selected");
        });
         
        // $(document).on("change", "#searchBySalt", function () {
        //     $("#itemSearch").val("").trigger("input").focus();
        // });
        $(document).on("change", "#searchBySalt", function () {
            const isChecked = $(this).is(":checked");

            if (isChecked) {
                $(".salt-col").show();   // show salt column
            } else {
                $(".salt-col").hide();   // hide salt column
            }

            $("#itemSearch").val("").trigger("input").focus();
        });
        // ✅ KEYBOARD NAVIGATION FOR ITEM MODAL
        $(document).on("keydown", function (e) {
            if (!$("#itemModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                itemNavMode = "keyboard";
                isKeyboardScrollingItemModal = true;
                $("#itemModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".item-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentItemIndex === -1) {
                    currentItemIndex = 0;
                }
                else if (currentItemIndex < $rows.length - 1) {
                    currentItemIndex++;
                }

                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();
                if (currentItemIndex <= 0) return;
                currentItemIndex--;
                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "Enter" && currentItemIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentItemIndex).trigger("click");
            }
        });

        function highlightItemRow($rows, index) {
            $rows.removeClass("selected");
            const $row = $rows.eq(index);
            $row.addClass("selected");
            $row[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
        }

        $(document).on("click", ".item-row", function (e) {
            e.preventDefault();

            const itemId = $(this).data("itemid");
            const itemName = $(this).data("name");
            const gst = $(this).data("gst");
            const cess = $(this).data("cess");
            const maxDiscount = parseFloat($(this).data("maxdiscount")) || 0;
            const allowNegative = $(this).data("allownegative") === true || $(this).data("allownegative") === "True";
            const minimumQty = parseFloat($(this).data("minimumqty")) || 0;
            const conversion = parseFloat($(this).data("conversion")) || 1;

            if (!itemId || !currentRow) return;

            currentRow.find(".item-barcode").val(itemName);
            currentRow.find(".item-id").val(itemId);
            currentRow.find(".gst").val(gst);
            currentRow.find(".cess").val(cess);
            currentRow.attr("data-max-discount", maxDiscount);
            currentRow.attr("data-minimum-qty", minimumQty);
            currentRow.attr("data-conversion", conversion);

            // Store in global object
            itemMaxDiscounts[itemId] = maxDiscount;
            itemConversionMap[itemId] = conversion;  // ✅ GLOBAL STORE

            window.allowNegativeSetting = allowNegative;

            calculateRow(currentRow);
            $("#itemModal").modal("hide");

            processItemId(itemId);
        });

        $(document).on("mouseenter", ".item-row", function () {
            if (!$("#itemModal").is(":visible")) return;
            if (isKeyboardScrollingItemModal) return;

            itemNavMode = "mouse";

            $("#itemModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".item-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentItemIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#itemModal", function () {
            isKeyboardScrollingItemModal = false;
        });

        $('#itemModal').on('shown.bs.modal', function () {
            itemNavMode = "keyboard";

            $("#itemModal")
                .addClass("keyboard-nav")
