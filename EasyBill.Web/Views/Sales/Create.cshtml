<!-- ================================================================
     🔹 OFFER MANAGEMENT
     ================================================================ -->
<script>
    $(document).ready(function () {
        $('#applyOfferBtn').on('click', function (e) {
            e.preventDefault();

            const salesItems = [];
            $('#SalesItemBody tr').each(function () {
                salesItems.push({
                    ItemMasterId: $(this).find('.item-id').val(),
                    Batch: $(this).find('.batch').val(),
                    Qty: parseFloat($(this).find('.qty').val()) || 0,
                    Rate: parseFloat($(this).find('.rate').val()) || 0,
                    Gst: parseFloat($(this).find('.gst').val()) || 0,
                    Discount: parseFloat($(this).find('.discount').val()) || 0,
                    Amount: parseFloat($(this).find('.amount').val()) || 0
                });
            });

            const payload = {
                SalesItemVMs: salesItems,
                TotalPayable: parseFloat($('#totalPayable').val()) || 0
            };

            // ✅ Show loader
            showLoader("Evaluating offers...");

            $.ajax({
                url: '/Sales/EvaluateOfferss',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    hideLoader(); // ✅ Hide loader

                    let html = '';

                    if (response.offers && response.offers.length > 0) {
                        html += `<table class="table table-bordered table-sm" id="offerTable">
                            <thead><tr><th>Offer Name</th><th>Benefit</th></tr></thead><tbody>`;

                        response.offers.forEach((offer, i) => {
                            html += `<tr tabindex="0" data-discount="${offer.discountValue}"
                                data-name="${offer.offerName}" data-offertype="${offer.offerType}"
                                data-id="${offer.id}">
                                <td>${offer.offerName}</td>
                                <td>₹${offer.discountValue.toFixed(2)}</td>
                            </tr>`;
                        });

                        html += `</tbody></table>`;
                    } else {
                        html = '<p>No valid offers found.</p>';
                    }

                    $('#offerModalBody').html(html);
                    const offerModal = new bootstrap.Modal(document.getElementById('offerModal'));
                    offerModal.show();

                    setTimeout(() => {
                        const $rows = $('#offerTable tbody tr');
                        currentOfferIndex = 0;
                        if ($rows.length > 0) {
                            $rows.removeClass("table-success");
                            $rows.eq(0).focus().addClass("table-success");
                        }
                    }, 200);
                },
                error: function (xhr) {
                    hideLoader(); // ✅ Hide loader
                    console.error(xhr.responseText);
                    alert("Error applying offer.");
                }
            });
        });

        $(document).on("keydown", function (e) {
            if (!$("#offerModal").is(":visible")) return;

            const $rows = $("#offerTable tbody tr");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();
                currentOfferIndex = (currentOfferIndex + 1) % $rows.length;
            } else if (e.key === "ArrowUp") {
                e.preventDefault();
                currentOfferIndex = (currentOfferIndex - 1 + $rows.length) % $rows.length;
            } else if (e.key === "Enter") {
                e.preventDefault();
                const $selectedRow = $rows.eq(currentOfferIndex);

                selectedOffer = {
                    id: $selectedRow.data("id"),
                    name: $selectedRow.data("name"),
                    discount: parseFloat($selectedRow.data("discount")) || 0,
                    type: $selectedRow.data("offertype")
                };

                $("#SelectedOfferId").val(selectedOffer.id);
                $(".applyOffer").prop("disabled", true);
                bootstrap.Modal.getInstance(document.getElementById('offerModal')).hide();

                if (selectedOffer.type === 3) {
                    applyBuyXGetXOffer(selectedOffer.id);
                } else if (selectedOffer.type === 4) {
                    applyComboOffer(selectedOffer.id);
                } else if (selectedOffer.type === 5 || selectedOffer.type === 6) {
                    applySelectedOfferCashback();
                } else {
                    applySelectedOfferDiscount();
                }

                toastr.success(`Offer "${selectedOffer.name}" applied`);
            }

            $rows.removeClass("table-success");
            $rows.eq(currentOfferIndex).focus().addClass("table-success");
        });
    });

    function applyComboOffer(offerId) {
        showLoader("Applying combo offer..."); // ✅ Show loader

        $.get(`/Sales/ApplyComboOffer?offerId=${offerId}`, function (comboItems) {
            hideLoader(); // ✅ Hide loader

            if (!comboItems || comboItems.length === 0) {
                toastr.warning("No combo items found.");
                $(".applyOffer").prop("disabled", false);
                return;
            }

            const existingItems = [];
            $('#SalesItemBody tr').each(function () {
                const $row = $(this);
                existingItems.push({
                    row: $row,
                    itemId: $row.find('.item-id').val()
                });
            });

            comboItems.forEach(comboItem => {
                const match = existingItems.find(x => x.itemId == comboItem.itemId);

                if (match) {
                    match.row.find('.rate').val(comboItem.rate);
                    calculateRow(match.row);
                    toastr.info(`Updated rate for ${comboItem.itemName}`);
                } else {
                    window.addNewRow(comboItem.itemId, comboItem.itemName, comboItem.qty, comboItem.rate);
                    toastr.success(`Added new combo item: ${comboItem.itemName}`);
                }
            });
        }).fail(function () {
            hideLoader(); // ✅ Hide loader
            toastr.error("Failed to apply combo offer.");
            $(".applyOffer").prop("disabled", false);
        });
    }

    function applyBuyXGetXOffer(offerId) {
        showLoader("Applying BuyX GetX offer..."); // ✅ Show loader

        $.get(`/Sales/GetBuyXGetXFreeItems?offerId=${offerId}`, function (response) {
            hideLoader(); // ✅ Hide loader

            if (!response || response.length === 0) {
                toastr.warning("No free items found.");
                return;
            }

            response.forEach(item => {
                window.addNewRow(item.itemId, item.itemName, item.qty);
            });
        }).fail(function() {
            hideLoader(); // ✅ Hide loader
            toastr.error("Failed to apply offer");
        });
    }

    // function applySelectedOfferDiscount() {
    //     if (!selectedOffer) return;

    //     const baseTotal = parseFloat($("[name='Total']").val()) || 0;
    //     const baseGst = parseFloat($("[name='TotalGstAmt']").val()) || 0;
    //     const totalBeforeDiscount = baseTotal + baseGst;
    //     const discountAmount = selectedOffer.discount;
    //     const finalAmount = totalBeforeDiscount - discountAmount;

    //     $("#Totaldiscount").val(discountAmount.toFixed(2));
    //     $("#totalPayable").val(finalAmount.toFixed(2));
    // }

    function applySelectedOfferDiscount() {
        if (!selectedOffer) return;

        const baseTotal = parseFloat($("[name='Total']").val()) || 0;  // 310 (Total only)
        const baseGst = parseFloat($("[name='TotalGstAmt']").val()) || 0;
        const discountAmount = selectedOffer.discount;

        // Discount Total (310) pe apply karo
        const totalAfterDiscount = baseTotal - discountAmount;

        // GST recalculate karo discount ke baad
        const finalAmount = totalAfterDiscount + baseGst;
        const roundedFinal = Math.round(finalAmount);

        $("#Totaldiscount").val(discountAmount.toFixed(2));
        $("#totalPayable").val(roundedFinal.toFixed(2));

        // Focus discountamount field
        setTimeout(() => {
            $("#discountamount").focus().select();
        }, 300);
    }

    function applySelectedOfferCashback() {
        if (!selectedOffer) return;

        setTimeout(() => {
            toastr.info(`Cashback ₹${selectedOffer.discount.toFixed(2)} will be added to wallet.`);
        }, 200);
    }
</script>

