    // ================================================================
    // 🔹 CUSTOMER LOYALTY POINTS INTEGRATION
    // ================================================================
    var loyaltyInfo = null;

    var currentLoyaltyActive = false;
    var currentPreviousBalance = 0;

    function updateLoyaltyPanelVisibility() {
        if (currentLoyaltyActive || currentPreviousBalance > 0) {
            $("#loyaltyPointsPanel").removeClass("d-none");
        } else {
            $("#loyaltyPointsPanel").addClass("d-none");
        }

        // Show/hide loyalty specific details
        if (currentLoyaltyActive) {
            $("#loyaltyGiftIcon").show();
            $("#loyaltyDetailsSection").show();
            if (loyaltyInfo && loyaltyInfo.allowPointRedemption && loyaltyInfo.pointsBalance >= loyaltyInfo.minPointsToRedeem) {
                $("#loyaltyRedeemSection").removeClass("d-none").show();
            } else {
                $("#loyaltyRedeemSection").addClass("d-none").hide();
            }
        } else {
            $("#loyaltyGiftIcon").hide();
            $("#loyaltyDetailsSection").hide();
            $("#loyaltyRedeemSection").addClass("d-none").hide();
        }

        // Show/hide divider
        if (currentLoyaltyActive && currentPreviousBalance > 0) {
            $("#loyaltyDivider").show();
        } else {
            $("#loyaltyDivider").hide();
        }

        // Show/hide previous balance section
        if (currentPreviousBalance > 0) {
            $("#loyaltyPreviousBalanceSection").show();
            $("#loyaltyPreviousBalanceValue").text(currentPreviousBalance.toFixed(2));
        } else {
            $("#loyaltyPreviousBalanceSection").hide();
        }
    }

    function loadCustomerLoyaltyInfo(customerId) {
        if (!customerId) {
            currentLoyaltyActive = false;
            loyaltyInfo = null;
            updateLoyaltyPanelVisibility();
            return;
        }

        $.get('/Customer/GetLoyaltyData', { id: customerId }, function (res) {
            if (res.success && res.data && res.data.isPointProgramActive && res.data.pointsBalance > 0) {
                loyaltyInfo = res.data;
                currentLoyaltyActive = true;
                
                $("#loyaltyBalanceBadge").text(loyaltyInfo.pointsBalance + " Points");
                $("#loyaltyValueSpan").text(loyaltyInfo.pointsBalanceValueInRs.toFixed(2));
                
                if (loyaltyInfo.minPointsToRedeem > 0) {
                    $("#loyaltyMinRedeemSpan").text(`(Min points to redeem: ${loyaltyInfo.minPointsToRedeem})`);
                } else {
                    $("#loyaltyMinRedeemSpan").text('');
                }
                
                $("#loyaltyRedeemInput")
                    .attr("max", loyaltyInfo.pointsBalance)
                    .data("valinrs", loyaltyInfo.pointValueInRs)
                    .val("0");

                $("#RedeemPoints").val("0");

                if (!loyaltyInfo.allowPointRedemption) {
                    $("#loyaltyMinRedeemSpan").text("(Redemption is currently disabled)");
                } else if (loyaltyInfo.pointsBalance < loyaltyInfo.minPointsToRedeem) {
                    $("#loyaltyMinRedeemSpan").append(" - Insufficient points balance to redeem.");
                }
            } else {
                currentLoyaltyActive = false;
                loyaltyInfo = null;
            }
            updateLoyaltyPanelVisibility();
        }).fail(function () {
            currentLoyaltyActive = false;
            loyaltyInfo = null;
            updateLoyaltyPanelVisibility();
        });
    }

    function resetLoyaltyUI() {
        loyaltyInfo = null;
        currentLoyaltyActive = false;
        currentPreviousBalance = 0;
        updateLoyaltyPanelVisibility();
        $("#loyaltyRedeemInput").val("0").removeAttr("max").removeData("valinrs");
        $("#RedeemPoints").val("0");
        calculateTotalPaymentSummary();
    }

    $(document).on("click", "#btnApplyLoyaltyPoints", function () {
        applyLoyaltyPointsRedemption();
    });

    $(document).on("keypress", "#loyaltyRedeemInput", function (e) {
        if (e.which === 13) {
            e.preventDefault();
            applyLoyaltyPointsRedemption();
        }
    });

    function applyLoyaltyPointsRedemption() {
        if (!loyaltyInfo) return;

        let points = parseInt($("#loyaltyRedeemInput").val()) || 0;

        if (points < 0) {
            toastr.error("Redemption points cannot be negative.");
            $("#loyaltyRedeemInput").val("0");
            $("#RedeemPoints").val("0");
            calculateTotalPaymentSummary();
            return;
        }

        if (points === 0) {
            $("#RedeemPoints").val("0");
            calculateTotalPaymentSummary();
            toastr.info("Loyalty points discount removed.");
            return;
        }

        if (points > loyaltyInfo.pointsBalance) {
            toastr.error(`Cannot redeem more than available balance of ${loyaltyInfo.pointsBalance} points.`);
            $("#loyaltyRedeemInput").val("0");
            $("#RedeemPoints").val("0");
            calculateTotalPaymentSummary();
            return;
        }

        if (points < loyaltyInfo.minPointsToRedeem) {
            toastr.error(`Minimum ${loyaltyInfo.minPointsToRedeem} points are required to redeem.`);
            $("#loyaltyRedeemInput").val("0");
            $("#RedeemPoints").val("0");
            calculateTotalPaymentSummary();
            return;
        }

        let pointValue = points * loyaltyInfo.pointValueInRs;
        let totalPayable = parseFloat($("#totalPayable").val()) || 0;

        if (pointValue > totalPayable) {
            toastr.error(`Redemption value (₹${pointValue.toFixed(2)}) cannot exceed total bill amount (₹${totalPayable.toFixed(2)}).`);
            $("#loyaltyRedeemInput").val("0");
            $("#RedeemPoints").val("0");
            calculateTotalPaymentSummary();
            return;
        }

        $("#RedeemPoints").val(points);
        calculateTotalPaymentSummary();

        let remaining = Math.max(0, totalPayable - pointValue);
        let firstRowPayment = $("#PaymentDetailsBody tr:first .paymentAmount");
        if (firstRowPayment.length) {
            firstRowPayment.val(remaining.toFixed(2));
            calculateTotalPaid();
        }

        toastr.success(`Successfully applied ₹${pointValue.toFixed(2)} discount using ${points} loyalty points.`);
    }

</script>
}
