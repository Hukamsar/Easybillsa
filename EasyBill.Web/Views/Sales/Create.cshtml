<script>
    $(document).on("keydown", ".item-barcode", function (e) {
        const row = $(this).closest("tr");

        // TAB KEY HANDLER - Item field pe bhi
        if (e.key === "Tab") {
            e.preventDefault();

            const itemBarcode = (row.find(".item-barcode").val() || "").trim();
            const batch = (row.find(".batch").val() || "").trim();

            // Current row is BLANK
            if (!itemBarcode && !batch) {

                // Check: At least 1 other valid row exists?
                let validRowCount = 0;

                $("#SalesItemBody tr").each(function() {
                    const $r = $(this);
                    if ($r.is(row)) return; // Skip current row

                    const item = ($r.find(".item-barcode").val() || "").trim();
                    const b = ($r.find(".batch").val() || "").trim();

                    if (item && b) {
                        validRowCount++;
                    }
                });

                if (validRowCount === 0) {
                    toastr.error("At least one item row is required. Please add item before moving forward.", "Validation Error");
                    row.find(".item-barcode").focus();
                    return;
                }

                // Valid rows exist → Remove current blank row
                row.remove();
                calculateTotalSummary();

                setTimeout(() => {
                    $("#discountPercent").focus().select();
                }, 50);

                return;
            }

            // Current row has SOME data but incomplete
            if (itemBarcode && !batch) {
                toastr.warning("Please select batch before moving forward.", "Incomplete Row");
                row.find(".item-barcode").focus();
                return;
            }

            const qty = parseFloat(row.find(".qty").val()) || 0;
            if (qty < 1) {
                toastr.warning("Quantity must be at least 1.", "Invalid Quantity");
                row.find(".qty").focus().select();
                return;
            }

            // Current row is COMPLETE → Go to discount percent
            $("#discountPercent").focus().select();
            return;
        }

        if (e.key === "ArrowRight") {
            e.preventDefault();
            row.find(".mrp").focus().select();
            return;
        }

        if (e.key === "ArrowDown") {
            e.preventDefault();
            const nextRow = row.next("tr");
            if (nextRow.length) {
                nextRow.find(".item-barcode").focus();
            }
            return;
        }

        if (e.key === "ArrowUp") {
            e.preventDefault();
            const prevRow = row.prev("tr");
            if (prevRow.length) {
                prevRow.find(".item-barcode").focus();
            }
        }
    });

    // ================================================================
    // 🔹 ITEM GRID FIELDS NAVIGATION (UPDATED FOR TABLETWISE)
    // ================================================================
    $(document).on("keydown", ".mrp, .qty, .tablet-qty, .stripe-rate, .rate, .discount", function (e) {
        const row = $(this).closest("tr");
        const input = $(this);

        const isItemName = input.hasClass("item-barcode");
        const isMRP = input.hasClass("mrp");
        const isQty = input.hasClass("qty");
        const isTabletQty = input.hasClass("tablet-qty");
        const isRate = input.hasClass("rate");
        const isStripeRate = input.hasClass("stripe-rate");
        const isDiscount = input.hasClass("discount");

        // ================================================================
        // 🔹 TAB KEY HANDLER
        // ================================================================
        if (e.key === "Tab") {
            e.preventDefault();

            const itemBarcode = (row.find(".item-barcode").val() || "").trim();
            const batch = (row.find(".batch").val() || "").trim();

            // Current row is BLANK
            if (!itemBarcode && !batch) {
                let validRowCount = 0;

                $("#SalesItemBody tr").each(function() {
                    const $r = $(this);
                    if ($r.is(row)) return;

                    const item = ($r.find(".item-barcode").val() || "").trim();
                    const b = ($r.find(".batch").val() || "").trim();

                    if (item && b) {
                        validRowCount++;
                    }
                });

                if (validRowCount === 0) {
                    toastr.error("At least one item row is required. Please add item before moving forward.", "Validation Error");
                    row.find(".item-barcode").focus();
                    return;
                }

                row.remove();
                calculateTotalSummary();

                setTimeout(() => {
                    $("#discountPercent").focus().select();
                }, 50);

                return;
            }

            // Current row has SOME data but incomplete
            if (itemBarcode && !batch) {
                toastr.warning("Please select batch before moving forward.", "Incomplete Row");
                row.find(".item-barcode").focus();
                return;
            }

            const qty = parseFloat(row.find(".qty").val()) || 0;
            if (qty < 1) {
                toastr.warning("Quantity must be at least 1.", "Invalid Quantity");
                row.find(".qty").focus().select();
                return;
            }

            // Current row is COMPLETE → Go to discount percent
            $("#discountPercent").focus().select();
            return;
        }

        // ================================================================
        // 🔹 ENTER KEY NAVIGATION
        // ================================================================
        if (e.key === "Enter") {
            e.preventDefault();

            if (isMRP) {
                // MRP → TabletQty (TabletWise) or Qty (StripWise)
                if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                    row.find(".tablet-qty").focus().select();
                } else {
                    row.find(".qty").focus().select();
                }
            }
            else if (isTabletQty) {
                      e.stopImmediatePropagation();
                        row.find(".tablet-qty").trigger("input");
                // TabletQty → Rate (skip readonly Qty)
                    row.find(".stripe-rate").focus().select();
               // row.find(".rate").focus().select();
            }
            else if (isQty) {
                // Qty → Rate
               // row.find(".rate").focus().select();
                    row.find(".stripe-rate").focus().select();
            }
            else if (isStripeRate) {
               // Qty → Rate
                   row.find(".discount").focus().select();
            }
            else if (isRate) {
                // Rate → Discount
                row.find(".discount").focus().select();
            }
            else if (isDiscount) {
                // Discount → Validation and Next Row Logic
                const itemId = row.find(".item-barcode").val();
                const batch = row.find(".batch").val();

                if (!itemId || !batch) {
                    toastr.warning("Please select Item and Batch before adding new row.");

                    if (!itemId) {
                        row.find(".item-barcode").focus();
                    } else if (!batch) {
                        row.find(".item-barcode").focus();
                    }
                    return;
                }

                // Validate quantity
                const $qtyInput = row.find(".qty");
                const qty = parseFloat($qtyInput.val()) || 0;

                if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                    const $qtyTabsInput = row.find(".tablet-qty");
                    const qtyTabs = parseFloat($qtyTabsInput.val()) || 0;

                    if (qty === 0 && qtyTabs === 0) {
                        toastr.warning("Please enter quantity or tablet quantity.");
                        $qtyTabsInput.focus().select();
                        return;
                    }

                    if (qty < 0 || qtyTabs < 0) {
                        toastr.warning("Quantity cannot be negative.");
                        (qty < 0 ? $qtyInput : $qtyTabsInput).focus().select();
                        return;
                    }
                } else {
                    if (qty < 1) {
                        toastr.warning("Quantity cannot be less than 1.");
                        $qtyInput.focus().select();
                        return;
                    }
                }

                // Add new row or go to next
                const isLastRow = row.is("#SalesItemBody tr:last");

                if (isLastRow) {
                    addNewRow();
                    setTimeout(() => {
                        $("#SalesItemBody tr:last .item-barcode").focus();
                    }, 150);
                } else {
                    const nextRow = row.next("tr");
                    if (nextRow.length) {
                        nextRow.find(".item-barcode").focus();
                    }
                }
            }

            return;
        }

        // ================================================================
        // 🔹 ARROW RIGHT NAVIGATION
        // ================================================================
        if (e.key === "ArrowRight") {
            e.preventDefault();

            if (isItemName) {
                row.find(".mrp").focus().select();
            }
            else if (isMRP) {
                // MRP → TabletQty (TabletWise) or Qty (StripWise)
                if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                    row.find(".tablet-qty").focus().select();
                } else {
                    row.find(".qty").focus().select();
                }
            }
            else if (isTabletQty) {
                // TabletQty → Rate
               // row.find(".rate").focus().select();
                    row.find(".stripe-rate").focus().select();
            }
            else if (isQty) {
                // Qty → Rate
              //  row.find(".rate").focus().select();
                   row.find(".stripe-rate").focus().select();
            }
            else if (isStripeRate) {
                // Rate → Discount
                row.find(".discount").focus().select();
            }

            return;
        }

        // ================================================================
        // 🔹 ARROW LEFT NAVIGATION
        // ================================================================
        if (e.key === "ArrowLeft") {
            e.preventDefault();

            if (isDiscount) {
                // Discount → Rate
              //  row.find(".rate").focus().select();
                   row.find(".stripe-rate").focus().select();
            }
            else if (isStripeRate) {
                // Rate → TabletQty (TabletWise) or Qty (StripWise)
                if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                    row.find(".tablet-qty").focus().select();
                } else {
                    row.find(".qty").focus().select();
                }
            }
            else if (isTabletQty) {
                // TabletQty → MRP
                row.find(".mrp").focus().select();
            }
            else if (isQty) {
                // Qty → MRP
                row.find(".mrp").focus().select();
            }
            else if (isMRP) {
                // MRP → Item
                row.find(".item-barcode").focus();
            }

            return;
        }

        // ================================================================
        // 🔹 ARROW DOWN NAVIGATION
        // ================================================================
        if (e.key === "ArrowDown") {
            e.preventDefault();
            const nextRow = row.next("tr");
            if (!nextRow.length) return;

            if (isMRP) {
                nextRow.find(".mrp").focus().select();
            }
            else if (isTabletQty) {
                nextRow.find(".tablet-qty").focus().select();
            }
            else if (isQty) {
                nextRow.find(".qty").focus().select();
            }
            else if (isStripeRate) {
                nextRow.find(".stripe-rate").focus().select();
            }
            else if (isDiscount) {
                nextRow.find(".discount").focus().select();
            }

            return;
        }

        // ================================================================
        // 🔹 ARROW UP NAVIGATION
        // ================================================================
        if (e.key === "ArrowUp") {
            e.preventDefault();
            const prevRow = row.prev("tr");
            if (!prevRow.length) return;

            if (isMRP) {
                prevRow.find(".mrp").focus().select();
            }
            else if (isTabletQty) {
                prevRow.find(".tablet-qty").focus().select();
            }
            else if (isQty) {
                prevRow.find(".qty").focus().select();
            }
            else if (isStripeRate) {
                prevRow.find(".stripe-rate").focus().select();
            }
            else if (isDiscount) {
                prevRow.find(".discount").focus().select();
            }
        }
    });


