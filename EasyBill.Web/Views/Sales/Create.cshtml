                let row = $(this).closest("tr");
            
                let stripRate = parseFloat($(this).val()) || 0;
            
                const itemId = row.find(".item-id").val();
                let conversion = parseFloat(row.attr("data-conversion"));
            
                if (!conversion || conversion <= 0) {
                    conversion = itemConversionMap[itemId] || 1;
                }
            
                // 👇 reverse calculation
                let tabletRate = stripRate / conversion;
            
                // 👇 actual rate update karo (hidden field)
                row.find(".rate").val(tabletRate.toFixed(4));
            
                // 🔥 recalculation trigger
                calculateRow(row);
