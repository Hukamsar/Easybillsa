        $(document).on("click", ".sales-order-row", function () {
            const order = $(this).data("order");
            if (!order) return;

            salesOrderSelected = true;

            $("#OrderId").val(order.id);
            $("#OrderNo").val(order.billNo);
            $("#OrderDate").val(order.billDate);
            $("#SalesOrderId").val(order.id);

            // Set discount values
            $("#discountPercent").val(order.discountPercent || 0);
            $("#discountamount").val(order.discountAmount || 0);

            // Clear existing items
            $("#SalesItemBody").empty();
            rowIndex = 0;

            // ================================================================
            // ✅ BIND ORDER ITEMS FUNCTION (conversion ke baad call hoga)
            // ================================================================
            function bindOrderItems() {
                order.items.forEach(item => {
                    let displayQty = item.qty;
                    let displayTabletQty = 0;

                    if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                        const conversion = itemConversionMap[item.itemId] || 1;

                        // qty strips mein hai → total tablets nikalo
                        const totalTablets = item.qty * conversion;

                        displayQty = Math.floor(totalTablets / conversion); // strips
                        displayTabletQty = totalTablets % conversion;        // remaining tablets

                        console.log(`📦 Item: ${item.itemName}, Conversion: ${conversion}, Strips: ${displayQty}, Tabs: ${displayTabletQty}`);
                    }

                    addNewRow(
                        item.itemId, item.itemName, displayQty, item.rate,
                        item.batchNo, item.expiryDate, item.mrp,
                        item.gstPercent, item.cess, item.discountPercent, item.amount,
                        displayTabletQty  // ✅ tablet qty
                    );
                });

                // ================================================================
                // ✅ AVAILABLE QTY + CONVERSION - Silently set karo
                // ================================================================
                setTimeout(() => {
                    const fetchPromises = [];

                    $("#SalesItemBody tr").each(function () {
                        const row = $(this);
                        const itemId = row.find(".item-id").val();
                        const batchNo = row.find(".batch").val();

                        if (!itemId || !batchNo) return;

                        // Conversion pehle se map mein hai to set karo
                        if (itemConversionMap[itemId]) {
                            row.attr("data-conversion", itemConversionMap[itemId]);
                        }

                        // applyTabletWiseMode agar exist karta ho
                        if (typeof applyTabletWiseMode === "function") {
                            applyTabletWiseMode(row);
                        }

                        // Already set hai to skip
                        const existingQty = row.attr("data-available-qty");
                        if (existingQty && parseFloat(existingQty) > 0) return;

                        const promise = $.get('/Sales/GetBatchesByItemId', { id: itemId })
                            .then(function (data) {
                                if (data.error || !data.groupedResult) return;

                                const matchedBatch = data.groupedResult.find(b =>
                                    b.batch && b.batch.trim().toLowerCase() === batchNo.trim().toLowerCase()
                                );

                                if (matchedBatch) {
                                    row.attr("data-available-qty", matchedBatch.qty || 0);
                                    row.attr("data-conversion", matchedBatch.conversion || 1);

                                    if (matchedBatch.conversion) {
                                        itemConversionMap[itemId] = parseFloat(matchedBatch.conversion) || 1;
                                    }

                                    console.log(`✅ Batch qty set for ${batchNo}: ${matchedBatch.qty}`);
                                }
                            })
                            .fail(function () {
                                console.error(`❌ Could not fetch batch for item: ${itemId}`);
                            });

                        fetchPromises.push(promise);
                    });

                    Promise.all(fetchPromises).then(() => {
                        console.log("✅ All batch quantities loaded for Sales Order items");
                    });

                }, 200);
            }

            // ================================================================
            // ✅ CONVERSION MAP CHECK - Already loaded hai to seedha bind karo
            // ================================================================
            if (@ViewBag.BusinessType === 2 && isTabletWiseMode && Object.keys(itemConversionMap).length === 0) {
                // ConversionMap empty hai - pehle load karo phir bind karo
                showLoader("Loading items...");
                $.get('/SalesOrder/GetAllItems', function (items) {
                    items.forEach(item => {
                        itemConversionMap[item.id] = parseFloat(item.conversion) || 1;
                        itemMaxDiscounts[item.id] = parseFloat(item.maximumdiscount) || 0;
                    });
                    console.log("✅ ConversionMap loaded before order bind:", itemConversionMap);
                    hideLoader();
                    bindOrderItems();
                }).fail(function () {
                    hideLoader();
                    console.error("❌ GetAllItems failed, binding without conversion");
                    bindOrderItems();
                });
            } else {
                // ConversionMap ready hai - seedha bind karo
                bindOrderItems();
            }

            // ================================================================
            // ✅ PAYMENT DETAILS
            // ================================================================
            // Clear existing payment rows
            $("#PaymentDetailsBody").empty();
            subrowIndex = 0;

            // Load payment details if exist
            if (order.paymentDetails && order.paymentDetails.length > 0) {
                order.paymentDetails.forEach(payment => {
                    addPaymentRowWithData(
                        payment.paymentModeId,
                        payment.amount,
                        payment.referenceNo || "",
                        payment.description || ""
                    );
                });
            }

            // ================================================================
            // ✅ TOTALS - Database se directly set karo
            // ================================================================
            setTimeout(() => {
                $("[name='Total']").val((order.total || 0).toFixed(2));
                $("[name='Totaldiscount']").val((order.totaldiscount || 0).toFixed(2));
                $("[name='TotalGstAmt']").val((order.totalGstAmt || 0).toFixed(2));
                $("[name='TotalPayable']").val((order.totalPayable || 0).toFixed(2));
                $("#paidAmout").val((order.paidAmount || 0).toFixed(2));
                $("#balance").val((order.balance || 0).toFixed(2));
                $("#returnAmount").val((order.returnAmount || 0).toFixed(2));
                $("#returnAmountDisplay").text((order.returnAmount || 0).toFixed(2));
            }, 100);

            $("#salesOrderModal").modal("hide");

            toastr.success("Order loaded successfully with payment details.");
        });

        $('#newCustomerForm').submit(function (e) {
            e.preventDefault();

            const accountGroupId = $('#newCustomerForm [name="AccountGroupId"]').val();
