                    $("#mobilenumber").focus().select();
                    return;
                }

                if (!isValidIndianMobile(mobile)) {
                    toastr.error("Please enter a valid 10-digit mobile number.", "Invalid Mobile");
                    $("#mobilenumber").focus().select();
                    return;
                }

                if (!customerName) {
                    toastr.error("Customer name is required to hold this sale.", "Customer Required");
                    $("#customer").focus().select();
                    return;
                }
            }

            let hasValidItemRow = false;
            let firstZeroQtyRow = null;
            let firstIncompleteRow = null;

            $("#SalesItemBody tr").each(function () {
                const row = $(this);
                const itemBarcode = (row.find(".item-barcode").val() || "").trim();
                const batch = (row.find(".batch").val() || "").trim();
                const qty = parseFloat(row.find(".qty").val()) || 0;

                if (itemBarcode && !batch && !firstIncompleteRow) {
                    firstIncompleteRow = row;
                }

                if (itemBarcode && qty <= 0 && !firstZeroQtyRow) {
                    firstZeroQtyRow = row;
                }

                if (itemBarcode && batch && qty > 0) {
                    hasValidItemRow = true;
                }
            });

            if (firstIncompleteRow) {
                toastr.error("Please select batch for all items before holding.", "Incomplete Item");
                firstIncompleteRow.find(".item-barcode").focus().select();
                return;
            }

            if (firstZeroQtyRow) {
                toastr.error("Quantity must be at least 1.", "Invalid Quantity");
                firstZeroQtyRow.find(".qty").focus().select();
                return;
            }

            if (!hasValidItemRow) {
                toastr.error("Please add at least one valid item before holding.", "No Items");

                const firstRow = $("#SalesItemBody tr:first");
                if (firstRow.length) {
                    firstRow.find(".item-barcode").focus().select();
                }
                return;
            }

            Swal.fire({
                title: 'Hold Sale?',
                text: 'Do you want to put this sale on hold?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '⏸ Yes, Hold',
                cancelButtonText: '❌ No',
                confirmButtonColor: '#f0ad4e',
                cancelButtonColor: '#6c757d',
                reverseButtons: true
            }).then((result) => {
                if (!result.isConfirmed) return;

                // ✅ Show loader
                showLoader("Holding sale...");

                $.ajax({
                    type: "POST",
                    url: "/Sales/Hold",
                    data: $("#salesForm").serialize(),
                    success: function (res) {
                        hideLoader(); // ✅ Hide loader

                        if (res.success) {
                            toastr.success("Sale put on HOLD successfully");
                            window.location.href = "/Sales/Create";
                        } else {
                            toastr.error(res.message || "Failed to hold sale", "Error");
                        }
                    },
                    error: function (xhr, status, error) {
                        hideLoader(); // ✅ Hide loader
                        console.error("Hold Error:", error);
                        toastr.error("Error while holding sale. Please try again.", "Server Error");
                    }
                });
            });
        });

        $("#unHoldBtn").on("click", function () {
            showLoader("Loading held sales..."); // ✅ Show loader

            $.get("/Sales/HoldListModal", function (html) {
                hideLoader(); // ✅ Hide loader
                $("#holdModalContainer").html(html);
                $("#holdListModal").modal("show");
            }).fail(function() {
                hideLoader(); // ✅ Hide loader
                toastr.error("Error loading held sales");
            });
        });

        $(document).on("keyup", "#holdSearch", function () {
            let value = $(this).val().toLowerCase();
            $("#holdTableBody tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });

        $(document).on("click", ".select-hold", function () {
            const holdId = $(this).data("id");
            if (!holdId) {
                toastr.error("Invalid hold selection");
                return;
            }
            showLoader("Resuming sale..."); // ✅ Show loader
            window.location.href = `/Sales/ResumeHold/${holdId}`;
        });
    </script>

