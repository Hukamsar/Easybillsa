<script>
    function loadPreviousBalance(customerId) {

        if (!customerId) {
            currentPreviousBalance = 0;
            $("#previousBalance").val("");
            resetLoyaltyUI();
            return;
        }

        loadCustomerLoyaltyInfo(customerId);

        $.get('/Sales/GetCustomerBalance', { customerId: customerId }, function (res) {

            if (res.success && res.balance > 0) {
                currentPreviousBalance = res.balance;
                $("#previousBalance").val(res.balance.toFixed(2));
            } else {
                currentPreviousBalance = 0;
                $("#previousBalance").val("");
            }
            updateLoyaltyPanelVisibility();

        }).fail(function () {
            currentPreviousBalance = 0;
            $("#previousBalance").val("");
            updateLoyaltyPanelVisibility();
        });
    }
</script>
