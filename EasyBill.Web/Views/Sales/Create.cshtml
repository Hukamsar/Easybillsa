    //     const enteredQty = parseFloat(qtyInput.val()) || 0;
    //     const availableQty = parseFloat(row.attr("data-available-qty")) || 0;
    $(document).on("blur", ".qty", function () {
        const row = $(this).closest("tr");
        const qtyInput = $(this);
        const enteredQty = parseFloat(qtyInput.val()) || 0;
        const rawAvailableQty = parseFloat(row.attr("data-available-qty")) || 0;

        // ✅ TabletWise mode mein availableQty ko tablets mein convert karo
        const itemId = row.find(".item-id").val();
        let conversion = parseFloat(row.attr("data-conversion"));
        if (!conversion || conversion <= 0) {
            conversion = itemConversionMap[itemId] || 1;
        }

        // Available stock - always in strips from backend
        // TabletWise: compare in tablets
        const availableQty = (@ViewBag.BusinessType === 2 && isTabletWiseMode)
            ? rawAvailableQty * conversion   // strips → tablets
            : rawAvailableQty;               // strips stay strips

        const minimumQty = parseFloat(row.attr("data-minimum-qty")) || 0;
        const batchNo = row.find(".batch").val();
        const itemName = row.find(".item-barcode").val();

        // Skip if no batch selected yet
        if (!batchNo || batchNo === "") {
            return;
        }

        // ✅ CALCULATE TOTAL QTY USED (SAME ITEM + SAME BATCH)
        // TabletWise mode mein total tablets calculate karo
        let totalUsedQtyInBatch = 0;

        $("#SalesItemBody tr").each(function() {
            const $r = $(this);
            const rItemId = $r.find(".item-id").val();
            const rBatch = $r.find(".batch").val();
            const rQty = parseFloat($r.find(".qty").val()) || 0;

            if (rItemId === itemId && rBatch === batchNo) {
                if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                    // ✅ Strips × conversion + remaining tablets
                    const rTabletQty = parseFloat($r.find(".tablet-qty").val()) || 0;
                    totalUsedQtyInBatch += (rQty * conversion) + rTabletQty;
                } else {
                    totalUsedQtyInBatch += rQty;
                }
            }
        });

        // ✅ Calculate remaining stock in CURRENT BATCH
        const remainingStockInBatch = availableQty - totalUsedQtyInBatch;

        // ================================================================
        // 🔸 STEP 1: CHECK OUT-OF-STOCK (BATCH-WISE - CRITICAL)
        // ================================================================
        if (totalUsedQtyInBatch > availableQty) {
            if (isStockValidationInProgress) {
                return;
            }

            isStockValidationInProgress = true;

            // ✅ Display unit label
            const unitLabel = (@ViewBag.BusinessType === 2 && isTabletWiseMode) ? "tablets" : "strips";

            // ✅ Current entry in same unit
            const currentEntryInUnits = (@ViewBag.BusinessType === 2 && isTabletWiseMode)
                ? (enteredQty * conversion) + (parseFloat(row.find(".tablet-qty").val()) || 0)
                : enteredQty;

            if (window.allowNegativeSetting === true) {
                showOutOfStockConfirmation(row, qtyInput, totalUsedQtyInBatch, availableQty, batchNo, minimumQty, itemName, itemId, unitLabel, currentEntryInUnits, conversion);
            } else {
                const remainingQtyAllowed = Math.max(0, availableQty - (totalUsedQtyInBatch - currentEntryInUnits));

                toastr.warning(
                    `Batch "${batchNo}" has only ${availableQty} ${unitLabel}. Already used: ${(totalUsedQtyInBatch - currentEntryInUnits).toFixed(2)}. Remaining: ${remainingQtyAllowed.toFixed(2)} ${unitLabel}`,
                    "Stock Limit Exceeded",
                    {
                        closeButton: true,
                        progressBar: true,
                        timeOut: 5000,
                        positionClass: "toast-top-right"
                    }
                );

            // ✅ Remaining ko strips/tablets mein convert karke set karo
            if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                const remainingStrips = Math.floor(remainingQtyAllowed / conversion);
                const remainingTabs = remainingQtyAllowed % conversion;
                qtyInput.val(remainingStrips);
                row.find(".tablet-qty").val(remainingTabs);
            } else {
                qtyInput.val(remainingQtyAllowed);
            }
            calculateRow(row);

                // ✅ Check ITEM-LEVEL minimum qty after adjustment
                setTimeout(() => {
                    checkItemMinimumQty(itemId, itemName, minimumQty);
                }, 500);

                setTimeout(() => {
                    qtyInput.focus().select();
                    isStockValidationInProgress = false;
                }, 100);
            }
            return;
        }

        // ================================================================
        // 🔸 STEP 2: CHECK MINIMUM QTY WARNING (ITEM-LEVEL - ALL BATCHES)
        // ================================================================
        checkItemMinimumQty(itemId, itemName, minimumQty);
    });

    // ✅ FIXED FUNCTION: Calculate ITEM-LEVEL remaining stock properly
    function checkItemMinimumQty(itemId, itemName, minimumQty) {
        if (minimumQty === 0) return;

        showLoader("Calculating stock..."); // ✅ Show loader

        // ✅ STEP 1: Get ALL batches for this item from backend
        $.get('/Sales/GetBatchesByItemId', { id: itemId }, function (data) {
            hideLoader();

            if (data.error || !data.groupedResult) {
                console.error("Could not fetch batch data");
                return;
            }

            // ✅ STEP 2: Calculate TOTAL AVAILABLE STOCK (all batches)
            let totalItemStock = 0;
            data.groupedResult.forEach(batch => {
                totalItemStock += parseFloat(batch.qty) || 0;
            });

            // ✅ STEP 3: Calculate TOTAL USED QTY (all batches combined)
            let totalUsedQtyAcrossAllBatches = 0;

            $("#SalesItemBody tr").each(function() {
                const $r = $(this);
                const rItemId = $r.find(".item-id").val();
                const rQty = parseFloat($r.find(".qty").val()) || 0;

                if (rItemId === itemId) {
                    totalUsedQtyAcrossAllBatches += rQty;
                }
            });

            // ✅ STEP 4: Calculate ITEM-LEVEL remaining stock
            const itemRemainingStock = totalItemStock - totalUsedQtyAcrossAllBatches;

            // ✅ STEP 5: Show warning if remaining <= minimum
            if (itemRemainingStock <= minimumQty) {
                toastr.warning(
                    `<strong>⚠️ Low Stock Alert!</strong><br>
                    <strong>Item:</strong> ${itemName}<br>
                    <strong>Total Available Stock (All Batches):</strong> ${totalItemStock.toFixed(2)}<br>
                    <strong>After This Sale:</strong> ${itemRemainingStock.toFixed(2)}<br>
                    <strong>Minimum Qty:</strong> ${minimumQty}<br>
                    <strong style="color: #d9534f;">📦 Please order soon!</strong>`,
                    "Low Stock Warning",
                    {
                        closeButton: true,
                        progressBar: true,
                        timeOut: 10000,
                        positionClass: "toast-top-right",
                        enableHtml: true
                    }
                );
            }
        }).fail(function() {
            hideLoader();
            console.error("Failed to fetch batch data");
        });
    }

    // UPDATED: Modified confirmation function
    function showOutOfStockConfirmation(row, qtyInput, totalUsedQty, availableQty, batchNo, minimumQty, itemName, itemId, unitLabel = "strips", currentEntryInUnits = 0, conversion = 1) {
            const alreadyUsed = totalUsedQty - currentEntryInUnits;
            const remainingQty = Math.max(0, availableQty - alreadyUsed);

        Swal.fire({
            title: 'Out of Stock',
            html: `
                    <p><strong>Batch:</strong> ${batchNo}</p>
                    <p><strong>Available Stock:</strong> ${availableQty.toFixed(2)} ${unitLabel}</p>
                    <p><strong>Already Used (other rows):</strong> ${alreadyUsed.toFixed(2)} ${unitLabel}</p>
                    <p><strong>Current Entry:</strong> ${currentEntryInUnits.toFixed(2)} ${unitLabel}</p>
                    <p><strong>Total Requested:</strong> ${totalUsedQty.toFixed(2)} ${unitLabel}</p>
                <hr>
                <p class="text-danger mt-3"><strong>⚠️ Total quantity exceeds available stock!</strong></p>
                <p>Do you want to continue anyway?</p>
            `,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '✅ Yes, Continue',
            cancelButtonText: '❌ No, Adjust',
            confirmButtonColor: '#f0ad4e',
            cancelButtonColor: '#6c757d',
            reverseButtons: true,
            allowOutsideClick: false,
            allowEscapeKey: false
        }).then((result) => {
            if (result.isConfirmed) {
                calculateRow(row);
                toastr.info("Proceeding with out-of-stock quantity");

                // Check ITEM-LEVEL minimum qty
                setTimeout(() => {
                    checkItemMinimumQty(itemId, itemName, minimumQty);
                }, 500);

                setTimeout(() => {
                    row.find(".rate").focus().select();
                    isStockValidationInProgress = false;
                }, 300);

            } else {
                    // TabletWise: remaining tablets ko strips+tabs mein convert karo
                    if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                        const remainingStrips = Math.floor(remainingQty / conversion);
                        const remainingTabs = remainingQty % conversion;
                        qtyInput.val(remainingStrips);
                        row.find(".tablet-qty").val(remainingTabs);
                        toastr.success(`Adjusted to: ${remainingStrips} strips + ${remainingTabs} tablets`);
                    } else {
                        qtyInput.val(remainingQty);
                        toastr.success(`Quantity adjusted to remaining stock: ${remainingQty.toFixed(2)}`);
                    }
                    calculateRow(row);

                setTimeout(() => {
                    qtyInput.focus().select();
                    isStockValidationInProgress = false;
                }, 300);
            }
        });
    }
</script>

<script>
    // ================================================================
    // 🔹 MRP VALIDATION (User manually changes MRP)
    // ================================================================

    // GLOBAL FLAG TO PREVENT MULTIPLE POPUPS
    let isMRPValidationInProgress = false;

    // MRP VALIDATION ON BLUR
    $(document).on("blur", ".mrp", function () {
        const row = $(this).closest("tr");
        const mrpInput = $(this);
        const enteredMRP = parseFloat(mrpInput.val()) || 0;
        const rate = parseFloat(row.find(".rate").val()) || 0;

        // Skip if no rate or MRP is 0
        if (rate === 0 || enteredMRP === 0) {
            return;
        }

        // Check if MRP < Rate
        if (enteredMRP >= rate) {
            return; // All good
        }

        // Skip if validation already in progress
        if (isMRPValidationInProgress) {
            return;
        }

        // Mark validation as in progress
        isMRPValidationInProgress = true;

        // Show confirmation dialog
        showMRPLessThanRateConfirmation(row, mrpInput, enteredMRP, rate);
    });

    function showMRPLessThanRateConfirmation(row, mrpInput, enteredMRP, rate) {
        Swal.fire({
            title: 'MRP Less Than Rate',
            html: `
                <p><strong>Rate:</strong> ₹${rate.toFixed(2)}</p>
                <p><strong>Entered MRP:</strong> ₹${enteredMRP.toFixed(2)}</p>
                <hr>
                <p class="text-warning mt-3"><strong>⚠️ MRP is less than Rate!</strong></p>
                <p>Do you want to continue anyway?</p>
            `,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '✅ Yes, Continue',
            cancelButtonText: '❌ No, Adjust to Rate',
            confirmButtonColor: '#f0ad4e',
            cancelButtonColor: '#6c757d',
            reverseButtons: true,
            allowOutsideClick: false,
            allowEscapeKey: false
        }).then((result) => {
            if (result.isConfirmed) {
                // YES → keep MRP, move to qty
                calculateRow(row);
                toastr.info("Proceeding with MRP lower than Rate");

                setTimeout(() => {
                    row.find(".qty").focus().select();
                    isMRPValidationInProgress = false;
                }, 300);

            } else {
                // NO → adjust MRP to Rate value, stay on MRP
                mrpInput.val(rate.toFixed(2));
                calculateRow(row);
                toastr.success(`MRP adjusted to Rate: ₹${rate.toFixed(2)}`);

                setTimeout(() => {
                    mrpInput.focus().select();
                    isMRPValidationInProgress = false;
                }, 300);
            }
        });
    }
</script>

<script>
    // ================================================================
    // 🔹 PAYMENT TOGGLE NAVIGATION
    // ================================================================
    $(document).on("keydown", "#paymentToggle", function (e) {
        // Arrow Left/Right for toggle
        if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
            e.preventDefault();

            // Toggle the checkbox
            $(this).prop("checked", !$(this).is(":checked")).trigger("change");
            return;
        }

        // Enter key - move to Billing Type
        if (e.key === "Enter") {
            e.preventDefault();
            e.stopImmediatePropagation();

            // Focus on Billing Type and open dropdown
            const billingTypeSelect = document.getElementById("billingType");
            if (billingTypeSelect) {
                billingTypeSelect.focus();

                setTimeout(() => {
                    if ('showPicker' in HTMLSelectElement.prototype) {
                        billingTypeSelect.showPicker();
                    } else {
                        $(billingTypeSelect).trigger('click');
                    }
                }, 50);
            }
        }
    });
</script>

<script>
    // ================================================================
    // 🔹 RATE ZERO VALIDATION
    // ================================================================
    let isRateZeroPopupOpen = false;
    $(document).on("blur", ".rate", function () {
        if (isRateZeroPopupOpen) return; // Loop rokne ke liye
        const rateInput = $(this);
        const enteredRate = parseFloat(rateInput.val()) || 0;

        if (enteredRate !== 0) return; // Only trigger when rate is 0

        const row = rateInput.closest("tr");
        const itemName = row.find(".item-barcode").val();
        const batchNo = row.find(".batch").val();

        // Skip if no item selected yet
        if (!itemName || !batchNo) return;

        Swal.fire({
            title: 'Rate is Zero',
            html: `
                <p><strong>Item:</strong> ${itemName}</p>
                <p class="text-warning mt-2"><strong>⚠️ Rate is set to 0!</strong></p>
                <p>Do you want to continue with Rate = 0?</p>
            `,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '✅ Yes, Keep 0',
            cancelButtonText: '❌ No, Change Rate',
            confirmButtonColor: '#f0ad4e',
            cancelButtonColor: '#6c757d',
            reverseButtons: true,
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => {
                isRateZeroPopupOpen = true; // Lock
                const confirmBtn = document.querySelector('.swal2-confirm');
                if (confirmBtn) confirmBtn.focus();
            }
       }).then((result) => {
            if (result.isConfirmed) {
                calculateRow(row);
                toastr.info("Proceeding with Rate = 0");
                setTimeout(() => {
                    isRateZeroPopupOpen = false; // Unlock BEFORE focus
                    row.find(".discount").focus().select();
                }, 300);
            } else {
                setTimeout(() => {
                    isRateZeroPopupOpen = false; // Unlock BEFORE focus
                    rateInput.focus().select();
                }, 300);
            }
        });
    });
</script>

<script>

    function applyTabletWiseMode(row) {
        const qtyInput = row.find(".qty");
        const tabletQtyInput = row.find(".tablet-qty");

        if (isTabletWiseMode) {
            // TabletWise: Qty disable, TabletQty enable
            qtyInput.prop("readonly", true).css("background-color", "#e9ecef");
            tabletQtyInput.prop("readonly", false).css("background-color", "#fff");
        } else {
            // StripWise: Qty enable, TabletQty disable + hide
            qtyInput.prop("readonly", false).css("background-color", "#fff");
            tabletQtyInput.prop("readonly", true).val("0").css("background-color", "#e9ecef");
        }
    }

    // Q.TABLET INPUT HANDLER
    $(document).on("input", ".tablet-qty", function () {
        if (!isTabletWiseMode) return;
        const row = $(this).closest("tr");
        const itemId = row.find(".item-id").val();

        // Get conversion
        let conversion = parseFloat(row.attr("data-conversion"));

        if (!conversion || conversion <= 0) {
            conversion = itemConversionMap[itemId] || 1;
        }

        console.log("Input - Conversion:", conversion);

        let tabletQty = parseFloat($(this).val()) || 0;

        // Calculate strips
        let strips = Math.floor(tabletQty / conversion);

        console.log("TabletQty:", tabletQty, "Strips:", strips);

        // Update Qty field
        row.find(".qty").val(strips);

        // Recalculate row
        calculateRow(row);
    });

    $(document).on("blur", ".tablet-qty", function () {
        if (!isTabletWiseMode) return;

        const row = $(this).closest("tr");
        const itemId = row.find(".item-id").val();

        let conversion = parseFloat(row.attr("data-conversion"));
        if (!conversion || conversion <= 0) {
            conversion = itemConversionMap[itemId] || 1;
        }

        let tabletQty = parseFloat($(this).val()) || 0;

        // Show only remaining tablets
        let remainingTablets = tabletQty % conversion;

        console.log("Blur - Remaining:", remainingTablets);

        $(this).val(remainingTablets);

        // RE-CALCULATE ROW WITH UPDATED VALUE
        calculateRow(row);
    });
</script>
