        // UPDATE processBarcode function (around line 1040)
        function processBarcode(barcode) {
            // F2/F3 Item Master popup controls item creation/modification, so skip barcode lookup there.
            if (window.stopAutoItemOpen === true || $("#itemMasterModal").is(":visible")) return;

            showLoader("Checking barcode...");

            $.get('/Sales/GetItemByBarcode', { barcode: barcode }, function (itemResponse) {
                hideLoader();

                if (!itemResponse || !itemResponse.itemId) {
                    openItemSearchModal(barcode);
                    return;
                }

                const itemId = itemResponse.itemId;
                const itemName = itemResponse.itemname;
                const maxDiscount = parseFloat(itemResponse.maximumDiscount) || 0;
                const allowNegative = itemResponse.allowNegative === true;
                const minimumQty = parseFloat(itemResponse.minimumQty) || 0;

                currentRow.find(".item-id").val(itemId);
                currentRow.find(".item-barcode").val(itemName);
                currentRow.attr("data-max-discount", maxDiscount);
                currentRow.attr("data-minimum-qty", minimumQty);

                // ✅ Store in global object
                itemMaxDiscounts[itemId] = maxDiscount;

                window.allowNegativeSetting = allowNegative;

                loadBatches(itemId);
            }).fail(function() {
                hideLoader();
                toastr.error("Error processing barcode");
            });
        }

