     🔹 SALES ORDER MODAL - KEYBOARD NAVIGATION
     ================================================================ -->
<script>
    $(document).on("keydown", function (e) {
        if (!$("#salesOrderModal").is(":visible")) return;

        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
            salesOrderNavMode = "keyboard";
            isKeyboardScrollingSalesOrderModal = true;
            $("#salesOrderModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");
        }

        const $rows = $(".sales-order-row:visible");
        if (!$rows.length) return;

        if (e.key === "ArrowDown") {
            e.preventDefault();

            if (currentSalesOrderIndex === -1) {
                currentSalesOrderIndex = 0;
            } else if (currentSalesOrderIndex < $rows.length - 1) {
                currentSalesOrderIndex++;
            }

            highlightSalesOrderRow($rows, currentSalesOrderIndex);
        }
        else if (e.key === "ArrowUp") {
            e.preventDefault();
            if (currentSalesOrderIndex <= 0) return;
            currentSalesOrderIndex--;
            highlightSalesOrderRow($rows, currentSalesOrderIndex);
        }
        else if (e.key === "Enter" && currentSalesOrderIndex >= 0) {
            e.preventDefault();
            $rows.eq(currentSalesOrderIndex).trigger("click");
        }
    });

    function highlightSalesOrderRow($rows, index) {
        $rows.removeClass("selected");
        const $row = $rows.eq(index);
        $row.addClass("selected");
        $row[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
    }

    $(document).on("mouseenter", ".sales-order-row", function () {
        if (!$("#salesOrderModal").is(":visible")) return;
        if (isKeyboardScrollingSalesOrderModal) return;

        salesOrderNavMode = "mouse";

        $("#salesOrderModal")
            .addClass("mouse-nav")
            .removeClass("keyboard-nav");

        const $rows = $(".sales-order-row:visible");
        $rows.removeClass("selected");
        $(this).addClass("selected");

        currentSalesOrderIndex = $rows.index(this);
    });

    $(document).on("mousemove", "#salesOrderModal", function () {
        isKeyboardScrollingSalesOrderModal = false;
    });

    $('#salesOrderModal').on('shown.bs.modal', function () {
        salesOrderNavMode = "keyboard";

        $("#salesOrderModal")
            .addClass("keyboard-nav")
            .removeClass("mouse-nav");

        const $rows = $(".sales-order-row:visible");

        currentSalesOrderIndex = -1;

        if ($rows.length) {
            currentSalesOrderIndex = 0;
            highlightSalesOrderRow($rows, currentSalesOrderIndex);
        }

        // ✅ Focus on table (no search box in this modal)
        setTimeout(() => {
            if ($rows.length) {
                $rows.eq(0).focus();
            }
        }, 200);
    });

    $('#salesOrderModal').on('hidden.bs.modal', function () {
        setTimeout(() => {
            if (salesOrderSelected) {
                const qtyInput = $("#SalesItemBody tr:first .qty");
                if (qtyInput.length) {
                    qtyInput.focus().select();
                }
            } else {
                const firstItem = $("#SalesItemBody tr:first .item-barcode");
                if (firstItem.length) {
                    firstItem.focus().select();
                }
            }
            salesOrderSelected = false;
        }, 200);
    });

    // UPDATE validateMaxDiscount function to also check multi-row
    function validateMaxDiscount(row) {
        const itemId = row.find(".item-id").val();
        const discount = parseFloat(row.find(".discount").val()) || 0;
        const maxDiscount = itemMaxDiscounts[itemId] || 0;

        // ✅ STEP 1: Check current row discount
        if (maxDiscount > 0 && discount > maxDiscount) {
            toastr.error(
                `Maximum allowed discount is ${maxDiscount}%. Current: ${discount}%`,
                "Discount Limit Exceeded",
                {
                    closeButton: true,
                    progressBar: true,
                    timeOut: 5000,
                    positionClass: "toast-top-right"
                }
            );

            row.find(".discount").val(maxDiscount);
            calculateRow(row);

            setTimeout(() => {
                row.find(".discount").focus().select();
            }, 100);

            return false;
        }
        if(maxDiscount > 0){
                 return validateTotalDiscountForItem(row);
        }
        return true;
        // ✅ STEP 2: Check total discount across multiple rows
       
    }

    // ADD THIS NEW FUNCTION (after validateMaxDiscount)
       function validateTotalDiscountForItem(currentRow) {
        const itemId = currentRow.find(".item-id").val();
        if (!itemId) return true;

        const maxDiscount = itemMaxDiscounts[itemId] || 0;

        // ✅ Calculate TOTAL discount used across all rows with same item
        let totalUsedDiscount = 0;
        let itemRowCount = 0;

        $("#SalesItemBody tr").each(function() {
            const row = $(this);
            const rowItemId = row.find(".item-id").val();

            if (rowItemId === itemId) {
                const discount = parseFloat(row.find(".discount").val()) || 0;
                totalUsedDiscount += discount;
                itemRowCount++;
            }
        });

        // ✅ Check if TOTAL discount exceeds maximum allowed
        if (totalUsedDiscount > maxDiscount) {
            const remainingDiscount = maxDiscount - (totalUsedDiscount - parseFloat(currentRow.find(".discount").val() || 0));

            toastr.error(
                `Maximum discount for this item is ${maxDiscount}%. Already used: ${(totalUsedDiscount - parseFloat(currentRow.find(".discount").val() || 0)).toFixed(2)}%. Remaining: ${remainingDiscount.toFixed(2)}%`,
                "Discount Limit Exceeded",
                {
                    closeButton: true,
                    progressBar: true,
                    timeOut: 8000,
                    positionClass: "toast-top-right"
                }
            );

            // ✅ Reset current row discount to remaining amount
            currentRow.find(".discount").val(Math.max(0, remainingDiscount).toFixed(2));
            calculateRow(currentRow);

            setTimeout(() => {
                currentRow.find(".discount").focus().select();
            }, 100);

            return false;
        }

        return true;
    }
</script>


