@model List<EasyBill.Models.ViewModels.ItemWisePartySalesVM>
<style>
    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>
<div class="card shadow-sm mb-3">
    <div class="card-header text-white py-2" style="background: #2b6ac9;">
       Item wise Party wise Sales
    </div>
</div>

<form method="get" class="card p-3 mb-3">
    <div class="row">

        <div class="col-md-2">
            <label>Date From</label>
            <input type="date" name="fromDate" class="form-control"
                   value="@ViewBag.FromDate" />
        </div>

        <div class="col-md-2">
            <label>Date To</label>
            <input type="date" name="toDate" class="form-control"
                   value="@ViewBag.ToDate" />
        </div>

        <div class="col-md-3">
            <label>Item Name <span class="text-danger">*</span></label>
            <select name="itemId" class="form-control" required
                    asp-items="@(ViewBag.ItemList as SelectList)">
                <option value="">Select Item</option>
            </select>
        </div>

        <div class="col-md-3">
            <label>Customer</label>
            <select name="customerId" class="form-control"
                    asp-items="@(ViewBag.CustomerList as SelectList)">
                <option value="">All</option>
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button class="btn w-100 text-light" style="background: #2b6ac9;">Search</button>
        </div>
    </div>
</form>
<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="ExportItemWisePartySalesExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           asp-route-itemId="@Context.Request.Query["itemId"]"
           asp-route-customerId="@Context.Request.Query["customerId"]">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>

        <a asp-action="ExportItemWisePartySalesPdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           asp-route-itemId="@Context.Request.Query["itemId"]"
           asp-route-customerId="@Context.Request.Query["customerId"]">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>

    </div>
</div>
<table id="itemWisePartytbl" class="table table-bordered table-striped table-sm">
    <thead class="table-primary text-center">
        <tr>
            <th>Customer</th>

            @if (ViewBag.MonthColumns != null)
            {
                foreach (var m in ViewBag.MonthColumns)
                {
                    <th>@m</th>
                }
            }
        </tr>
    </thead>

    <tbody>
        @if (Model.Any())
        {
            foreach (var row in Model)
            {
                <tr>
                    <td>@row.CustomerName</td>

                    @if (ViewBag.MonthColumns != null)
                    {
                        foreach (var m in ViewBag.MonthColumns)
                        {
                            <td>
                                @(row.MonthData.ContainsKey(m) ? row.MonthData[m] : "0")
                            </td>
                        }
                    }
                </tr>
            }
        }
     
    </tbody>
</table>
@section Scripts {
    <script>
        $(document).ready(function () {
            $("#itemWisePartytbl").DataTable({
                ordering: false,
                "columnDefs": [
                    { "orderable": false, "targets": 0 }
                ]
            });
        });
    </script>
}
