@using EasyBill.Models.ViewModels
@model SalesVM
@{
    ViewData["Title"] = "Edit Sales";
}

<link href="~/css/page.css" rel="stylesheet" />

<!-- ================================================================
     🔹 CUSTOM STYLES
     ================================================================ -->
<style>
    /* Sales Edit uses page.css for shortcut links while preserving the existing Bootstrap modal layout. */
    #itemModal .modal-header,
    #batchModal .modal-header,
    #createCustomerModal .modal-header,
    #createDoctorModal .modal-header,
    #itemMasterModal .modal-header {
        justify-content: space-between;
        padding: var(--bs-modal-header-padding);
        margin-bottom: 0;
        border-bottom: var(--bs-modal-header-border-width) solid var(--bs-modal-header-border-color);
    }

    #itemModal .modal-title,
    #batchModal .modal-title,
    #itemMasterModal .modal-title {
        font-size: var(--bs-modal-title-font-size);
        font-weight: 500;
        color: #fff;
    }

    #createCustomerModal .modal-title,
    #createDoctorModal .modal-title {
        font-size: var(--bs-modal-title-font-size);
        font-weight: 500;
        color: inherit;
    }

    #itemModal .modal-body,
    #createCustomerModal .modal-body,
    #createDoctorModal .modal-body,
    #itemMasterModal .modal-body {
        text-align: left;
        padding: var(--bs-modal-padding);
    }

    #batchModal .modal-body {
        text-align: left;
    }

    #createCustomerModal .modal-footer,
    #createDoctorModal .modal-footer {
        justify-content: flex-end;
        gap: var(--bs-modal-footer-gap);
        padding: calc(var(--bs-modal-padding) - var(--bs-modal-footer-gap) * .5);
        border-top: var(--bs-modal-footer-border-width) solid var(--bs-modal-footer-border-color);
    }

    /* ===============================
               BATCH MODAL STYLING
               =============================== */
    .batch-row.selected td {
        background-color: #d4af37 !important; /* GOLD */
        color: #000 !important;
        font-weight: 500;
    }

    #batchModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #batchModal .modal-header .btn-close {
            filter: invert(1);
        }

    /* Keyboard navigation active → hover disabled */
    #batchModal.keyboard-nav .batch-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* Mouse navigation active → hover enabled */
    #batchModal.mouse-nav .batch-row:hover td {
        background-color: #f1d27a !important; /* LIGHT GOLD */
        color: #000 !important;
        cursor: pointer;
    }

    /* Batch Modal Scroll Support */
    .batch-table-wrapper {
        max-height: 350px;
        overflow-y: auto;
        position: relative;
    }

    #batchTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7;
        color: #fff;
        font-weight: 700;
        z-index: 2;
    }

    .batch-disabled {
        background-color: #f8d7da !important;
        color: #842029;
        cursor: not-allowed;
        opacity: 0.7;
    }

        .batch-disabled.selected {
            background-color: #f8d7da !important;
        }

    /* ===============================
               ITEM MODAL STYLING
               =============================== */
    .item-row.selected td {
        background-color: #d4af37 !important; /* GOLD */
        color: #000 !important;
        font-weight: 500;
    }

    #itemModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #itemModal .modal-header .btn-close {
            filter: invert(1);
        }

    /* Keyboard navigation active → hover disabled */
    #itemModal.keyboard-nav .item-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* Mouse navigation active → hover enabled */
    #itemModal.mouse-nav .item-row:hover td {
        background-color: #f1d27a !important; /* LIGHT GOLD */
        color: #000 !important;
        cursor: pointer;
    }

    .item-row:focus {
        outline: none;
    }

    .item-row {
        scroll-margin-top: 50px;
    }

    /* Item Modal Table Header */
    #itemTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* Item Modal Scroll Support */
    .item-table-wrapper {
        min-height: 50px;
        max-height: 350px;
        overflow-y: auto;
    }

        .item-table-wrapper::-webkit-scrollbar,
        .batch-table-wrapper::-webkit-scrollbar {
            width: 6px;
        }

        .item-table-wrapper::-webkit-scrollbar-thumb,
        .batch-table-wrapper::-webkit-scrollbar-thumb {
            background: #adb5bd;
            border-radius: 4px;
        }

    /* ===============================
               CUSTOMER LIST MODAL STYLING
               =============================== */
    #customerListModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #customerListModal .modal-header .btn-close {
            filter: invert(1);
        }

    .customer-table-wrapper {
        min-height: 50px;
        max-height: 350px;
        overflow-y: auto;
    }

    #customerTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        z-index: 2;
    }

    .customer-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    #customerListModal.keyboard-nav .customer-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #customerListModal.mouse-nav .customer-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .customer-row {
        scroll-margin-top: 50px;
    }

        .customer-row:focus {
            outline: none;
        }

    .salt-col {
        display: none;
    }
</style>
<style>
    .total-amount {
        font-size: 1.4rem;
        font-weight: 700;
        color: #198754;
    }
</style>
<style>
    .custom-header th {
        background: linear-gradient(180deg, #eef3f8, #d8e3ef);
        color: #16202b;
        font-weight: 700;
        text-align: center;
        border-bottom: 0px solid #b6c6d6;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,0.05);
    }
</style>

<div class="card mb-3 shadow-sm">
    <div class="card-header text-white d-flex align-items-center"
         style="background:#2b6ac9">

        <h6 class="mb-0 me-auto">
            Edit Sales
        </h6>
    </div>
</div>

<form id="salesForm" asp-controller="Sales" asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CustomerId" id="CustomerId" />
    <input type="hidden" asp-for="PharmacyDoctorId" id="DoctorId" />
    <input type="hidden" asp-for="OfferId" />
    <input type="hidden" id="isShare" name="isShare" value="false" />
    <input type="hidden" asp-for="RedeemPoints" id="RedeemPoints" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="container">
        <div class="row">
            <div class="row mb-2">

                <label asp-for="BillNo" class="col-md-2 col-form-label text-start small">Bill No <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input asp-for="BillNo" type="text" class="form-control form-control-sm" readonly />
                    <span asp-validation-for="BillNo" class="text-danger"></span>
                </div>

                <label asp-for="BillDate" class="col-md-2 col-form-label text-start small">Bill Date <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input type="date" asp-for="BillDate" class="form-control form-control-sm" required />
                    <span asp-validation-for="BillDate" class="text-danger"></span>
                </div>

                <label class="col-md-2">Billing Type</label>
                <div class="col-md-2">
                    <select asp-for="billingType" id="billingType" class="form-control form-control-sm">
                        <option value="walkin">Cash</option>
                        <option value="registered">Customer</option>
                    </select>
                </div>

                <label class="col-md-2 col-form-label text-start small">Mobile No <i class="redColor">*</i></label>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="w-100">
                        <input asp-for="MobileNo" type="text" class="form-control form-control-sm" id="mobilenumber" />
                        <span asp-validation-for="MobileNo" class="text-danger"></span>
                    </div>
                    <div class="shortcut-box">
                        <span id="btnF1CustomerList" class="shortcut-link">F1 - List</span>
                    </div>
                </div>

                <label class="col-md-2 col-form-label text-start small">Customer <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input asp-for="CustomerName" class="form-control form-control-sm" id="customer" />
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>

                <label class="col-md-2 col-form-label text-start small">Address <i class="redColor">*</i></label>
                <div class="col-md-2 mt-2 mt-md-0">
                    <input asp-for="Address" id="customeraddress" class="form-control form-control-sm" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                @if (Model.DoctorRequired)
                {
                    <label class="col-md-2 col-form-label small">Doctor Mobile No <i class="redColor">*</i></label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorMobileNumber" class="form-control form-control-sm" id="doctorMobile" />
                    </div>

                    <label class="col-md-2 col-form-label small">Doctor <i class="redColor"></i></label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorName" class="form-control form-control-sm" id="doctorname" />
                    </div>

                    <label class="col-md-2 col-form-label small">Registration Number <i class="redColor"></i></label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorRegNumber" class="form-control form-control-sm" id="doctorregno" />
                    </div>
                }

                <label class="col-md-2 col-form-label text-start small">Type</label>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-check form-switch">
                        <input class="form-check-input"
                               type="checkbox"
                               id="paymentToggle">
                        <label class="form-check-label fw-bold" id="paymentToggleLabel" style="color: green;">
                            Cash
                        </label>
                    </div>

                    <!-- Hidden field for model binding -->
                    <input type="hidden" asp-for="PaymentType" id="paymentTypeHidden" value="cash" />
                </div>

            </div>
        </div>

        <!-- Loyalty Program Panel -->
        <div class="row d-none" id="loyaltyPointsPanel">
            <div class="col-12 mb-3">
                <div class="card border-info" style="border-radius: 8px; background-color: #f0f8ff;">
                    <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-gift-fill text-info" style="font-size: 1.2rem;"></i>
                            <div>
                                <span class="fw-bold text-dark">Customer Loyalty Program:</span>
                                <span class="badge bg-primary text-white ms-2" style="font-size: 0.9rem;" id="loyaltyBalanceBadge">0 Points</span>
                                <span class="text-muted ms-2 small">Available Value: <strong class="text-success">₹<span id="loyaltyValueSpan">0.00</span></strong></span>
                                <span class="ms-3 text-secondary small" id="loyaltyMinRedeemSpan"></span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0" id="loyaltyRedeemSection">
                            <label for="loyaltyRedeemInput" class="small fw-bold text-dark mb-0">Redeem Points:</label>
                            <input type="number" id="loyaltyRedeemInput" class="form-control form-control-sm text-end" style="width: 100px; display: inline-block;" value="0" min="0">
                            <button type="button" class="btn btn-sm btn-info text-white" id="btnApplyLoyaltyPoints">Apply Discount</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <div style="overflow-x: auto; width: 100%;">
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table custom-header">
                        <tr>
                            <th style="min-width:20%">Item</th>
                            <th style="min-width:30%">Batch</th>
                            <th class="text-center">Expiry</th>
                            <th class="text-center">Mrp</th>
                            @if (ViewBag.BusinessType == 2)
                            {
                                <th class="text-center" id="qtyView">Qty</th>
                                <th class="text-center" id="qtyTabsView">Tabs</th>
                            }
                            else
                            {
                                <th class="text-center">Qty</th>
                            }
                            <th class="text-center">Rate</th>
                            <th class="text-center">Gst %</th>
                            <th class="text-center">Cess</th>
                            <th class="text-center">Disc %</th>
                            <th class="text-center">Amount</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="SalesItemBody">
                        @{
                            int rowIndex = 0;
                            foreach (var item in Model.SalesItemVMs)
                            {
                                <tr>
                                    <td hidden><input name="SalesItemVMs[@rowIndex].Id" value="@item.Id" /></td>
                                    <td hidden>
                                        <input name="SalesItemVMs[@rowIndex].ItemMasterId" class="form-control form-control-sm item-id" value="@item.ItemMasterId" />
                                    </td>
                                    <td style="min-width:250px;">
                                        <input type="text" name="SalesItemVMs[@rowIndex].ItemBarcodeNumber" value="@item.ItemBarcodeNumber" class="form-control form-control-sm item-barcode" />
                                    </td>
                                    <td><input name="SalesItemVMs[@rowIndex].Batch" class="form-control form-control-sm batch" value="@item.Batch" readonly /></td>
                                    <td><input name="SalesItemVMs[@rowIndex].Expirydate" value="@item.Expirydate?.ToString("MM/yyyy")" class="form-control form-control-sm expirydate" readonly /></td>
                                    <td><input name="SalesItemVMs[@rowIndex].Mrp" value="@item.Mrp" class="form-control form-control-sm mrp" /></td>
                                    <td><input name="SalesItemVMs[@rowIndex].Qty" class="form-control form-control-sm qty" value="@item.Qty" /></td>
                                    @if (ViewBag.BusinessType == 2)
                                    {
                                        <td><input name="SalesItemVMs[@rowIndex].TabletQty" class="form-control form-control-sm tablet-qty" value="@item.TabletQty" /></td>
                                    }
                                    <td hidden><input name="SalesItemVMs[@rowIndex].Rate" class="form-control form-control-sm rate" value="@item.Rate" /></td>
                                    <td>
                                        <input name="SalesItemVMs[@rowIndex].StripRate" class="form-control form-control-sm stripe-rate" value="@item.StripRate" />
                                    </td>
                                    <td><input name="SalesItemVMs[@rowIndex].Gst" class="form-control form-control-sm gst" value="@item.Gst" readonly /></td>
                                    <td><input name="SalesItemVMs[@rowIndex].Cess" class="form-control form-control-sm cess" value="@item.Cess" readonly /></td>
                                    <td><input name="SalesItemVMs[@rowIndex].Discount" class="form-control form-control-sm discount" value="@item.Discount" /></td>
                                    <td><input name="SalesItemVMs[@rowIndex].Amount" class="form-control form-control-sm Amount" value="@item.Amount" readonly /></td>
                                    <td><u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u></td>
                                </tr>
                                rowIndex++;
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="8">
                                <u id="addRow" style="color:green; cursor:pointer;">Add Row</u>
                            </th>
                        </tr>
                    </tfoot>
                </table>

                <!-- Totals -->
                <div class="row mt-3">
                    <div class="col-md-7">
                        <strong>Payment Details</strong>
                        <table class="table table-bordered table-striped">
                            <thead class="table custom-header">
                                <tr>
                                    <th style="min-width:30%">Payment Mode</th>
                                    <th class="text-center">Amount</th>
                                    <th class="text-center">Reference NO</th>
                                    <th class="text-center">Description</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="PaymentDetailsBody">
                                @for (int i = 0; i < Model.SalsePaymentDetails?.Count; i++)
                                {
                                    <tr>
                                        <td hidden><input type="hidden" asp-for="@Model.SalsePaymentDetails[@i].Id" /></td>
                                        <td style="min-width:185px;">
                                            <select asp-for="SalsePaymentDetails[@i].PaymentModeId" asp-items="@ViewBag.PaymentMode" class="form-control form-control-sm paymentMode-dropdown" required>
                                                <option value="">Select</option>
                                            </select>
                                        </td>
                                        <td><input name="SalsePaymentDetails[@i].Amount" class="form-control form-control-sm paymentAmount" value="@Model.SalsePaymentDetails[i].Amount" /></td>
                                        <td><input name="SalsePaymentDetails[@i].ReferenceNo" class="form-control form-control-sm paymentReferenceNO" value="@Model.SalsePaymentDetails[i].ReferenceNo" /></td>
                                        <td><input name="SalsePaymentDetails[@i].Description" class="form-control form-control-sm paymentDescription" value="@Model.SalsePaymentDetails[i].Description" /></td>
                                        <td><u class="remove-paymentrow-btn text-danger" style="cursor:pointer;">Remove</u></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="float-start">
                                        <u id="addPaymentRow" style="color:green; text-align:right; cursor:pointer;">Add Row</u>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="row mt-2">
                            <div class="col-md-12">
                                <span class="fw-bold text-danger" style="font-size: xx-large;">
                                    Return Amount :
                                </span>
                                <span id="returnAmountDisplay"
                                      class="fw-bold"
                                      style="font-size: xxx-large;color:#8B0000;">
                                    0.00
                                </span>
                            </div>
                        </div>

                    </div>
                    <div class="col-md-5">
                        <div class="row mb-2">
                            <label asp-for="Total" class="col-md-3 col-form-label text-start small">Total</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="Total" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label class="col-md-3 col-form-label text-start small">Bill Discount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-2">
                                <input asp-for="discountPercent" id="discountPercent" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <input asp-for="discountAmount" id="discountamount" class="form-control form-control-sm" placeholder="amount" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="Totaldiscount" class="col-md-3 col-form-label text-start small">Total Discount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="Totaldiscount" id="Totaldiscount" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="TotalGstAmt" class="col-md-3 col-form-label text-start small">Gst</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="TotalGstAmt" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="TotalCessAmount" class="col-md-3 col-form-label text-start small">Total Cess</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="TotalCessAmount" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="TotalPayable" class="col-md-3 col-form-label text-start small fw-bold">Total Amount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="TotalPayable" id="totalPayable" class="form-control form-control-sm total-amount" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="RoundOffAmount" class="col-md-3 col-form-label text-start small"></label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="RoundOffAmount" id="roundOffAmount" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <!-- Loyalty Points Highlights Container -->
                        <div id="loyaltySummaryContainer" style="display: none; background-color: #fffbeb !important; border: 2px solid #fbbf24 !important; border-radius: 8px !important; padding: 12px !important; margin-bottom: 12px !important; margin-top: 5px !important; box-shadow: 0 4px 6px -1px rgba(245, 158, 11, 0.1) !important;">
                            <div class="row mb-2" id="loyaltyDiscountRow" style="margin-bottom: 8px !important;">
                                <label id="loyaltyPointsDiscountLabel" class="col-md-5 col-form-label text-start small fw-bold" style="color: #b45309 !important;">Points Discount</label>
                                <div class="col-md-2"></div>
                                <div class="col-md-5">
                                    <input id="loyaltyPointsDiscountInput" class="form-control form-control-sm fw-bold" style="background-color: #fff !important; border-color: #fbbf24 !important; color: #b45309 !important;" readonly value="0.00" />
                                </div>
                            </div>
                            <div class="row" id="netPayableRow" style="margin-bottom: 0px !important;">
                                <label class="col-md-5 col-form-label text-start small fw-bold" style="color: #92400e !important;">Net Payable</label>
                                <div class="col-md-2"></div>
                                <div class="col-md-5">
                                    <input id="netPayableInput" class="form-control form-control-sm fw-bold" style="background-color: #fff !important; border-color: #fbbf24 !important; color: #92400e !important;" readonly value="0.00" />
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2" hidden>
                            <label asp-for="PaidAmount" class="col-md-3 col-form-label text-start small">Paid Amount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="PaidAmount" id="paidAmout" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2" hidden>
                            <label asp-for="Balance" class="col-md-3 col-form-label text-start small">Balance</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="Balance" id="balance" value="0" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                @*         <div class="row mb-2">
                            <label asp-for="ReturnAmount" class="col-md-3 col-form-label text-start small">Return Amount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="ReturnAmount" id="returnAmount" class="form-control form-control-sm" readonly />
                            </div>
                        </div> *@
                    </div>
                </div>
            </div>
        </div>

        <!-- Buttons -->
        <div class="mt-3 text-end">
            <button type="submit"
                    id="btnSave"
                    class="btn btn-sm btn-primary me-2">
                End | Update 💾
            </button>
            <button type="button"
