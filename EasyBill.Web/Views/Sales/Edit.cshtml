        $(document).on("click", ".batch-row", function () {
            // Check if batch is disabled
            if ($(this).data("disabled") === true) {
                toastr.warning(
                    "Negative stock batch is not allowed.",
                    "Batch Selection Disabled"
                );
                return; // ❌ stop selection
            }

            $(".batch-row").removeClass("selected");
            $(this).addClass("selected");

            const encoded = $(this).attr("data-batch");
            try {
                const batch = JSON.parse(decodeURIComponent(encoded));
                if (currentRow) {
                    currentRow.find(".batch").val(batch.batch);
                    currentRow.find(".rate").val(batch.rate.toFixed(4) || 0);
                    currentRow.find(".mrp").val(batch.mrp || 0);
                    currentRow.find(".stripe-rate").val(batch.striprate.toFixed(2) || 0);
                    currentRow.attr("data-available-qty", batch.qty);

                    const itemId = currentRow.find(".item-id").val();
                    const conversion = parseFloat(currentRow.attr("data-conversion")) || 1;
                    itemConversionMap[itemId] = conversion;

                    // REMOVED AUTO-FILL QTY = 1
                    // ONLY SET QTY = 1 IN STRIP-WISE MODE
                    // IN TABLET-WISE MODE, LEAVE QTY AS 0
                    const qtyInput = currentRow.find(".qty");
                    const existingQty = parseFloat(qtyInput.val());

                    if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                        // STRIP-WISE: Set Qty = 1 if 0
                        if (!existingQty || existingQty <= 0) {
                            qtyInput.val(0);
                        }
                    }
                    // TABLET-WISE: Don't touch Qty (leave as 0)

                    if (batch.expiry) {
                        let date = new Date(batch.expiry);
                        let formatted = ("0" + (date.getMonth() + 1)).slice(-2) + "/" + date.getFullYear();
                        currentRow.find(".expirydate").val(formatted);
                    }
                    calculateRow(currentRow);
                }
                $("#batchModal").modal("hide");

                setTimeout(() => {
                    if (isTabletWiseMode) {
                        const existingStrips = parseFloat(currentRow.find(".qty").val()) || 0;
                        const existingTabs = parseFloat(currentRow.find(".tablet-qty").val()) || 0;

                        // Sirf tab default 1 set karo jab DONO zero hon
                        if (existingStrips === 0 && existingTabs === 0) {
                            currentRow.find(".tablet-qty").val(1);
                            currentRow.find(".tablet-qty").trigger("input");
                        }
                        
                        currentRow.find(".tablet-qty").focus().select();
                    } else {
                        if (currentRow.find(".qty").val() == 0) {
                            currentRow.find(".qty").val(1);
                        }
                        calculateRow(currentRow);
                        currentRow.find(".qty").focus().select();
                    }
                }, 200);
            } catch (err) {
                alert("Invalid batch data.");
                console.error(err);
            }
        });

