                cancelButtonColor: '#6c757d',
                reverseButtons: true,
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                        isRateZeroPopupOpen = true;
                        setTimeout(() => {
                            const confirmBtn = document.querySelector('.swal2-confirm');
                            if (confirmBtn) confirmBtn.focus();
                        }, 100);
                }
           }).then((result) => {
                if (result.isConfirmed) {
                    calculateRow(row);
                    toastr.info("Proceeding with Rate = 0");
                    setTimeout(() => {
                        isRateZeroPopupOpen = false; // Unlock BEFORE focus
                        row.find(".discount").focus().select();
                    }, 300);
                } else {
                    setTimeout(() => {
                        isRateZeroPopupOpen = false; // Unlock BEFORE focus
                        rateInput.focus().select();
                    }, 300);
                }
            });
        });
    </script>

    <script>
        // ================================================================
        // 🔹 TABLET-WISE MODE APPLY FUNCTION
        // ================================================================
        function applyTabletWiseMode(row) {
            const qtyInput = row.find(".qty");
            const tabletQtyInput = row.find(".tablet-qty");

            if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                // TabletWise: Qty disable, TabletQty enable
                qtyInput.prop("readonly", true).css("background-color", "#e9ecef");
                tabletQtyInput.prop("readonly", false).css("background-color", "#fff");
            } else {
                // StripWise: Qty enable, TabletQty disable + hide
                qtyInput.prop("readonly", false).css("background-color", "#fff");
                tabletQtyInput.prop("readonly", true).val("0").css("background-color", "#e9ecef");
            }
        }

        // ================================================================
        // 🔹 Q.TABLET INPUT HANDLER
        // ================================================================
        $(document).on("input", ".tablet-qty", function () {
            if (!isTabletWiseMode) return;

            const row = $(this).closest("tr");
            const itemId = row.find(".item-id").val();

            // Get conversion
            let conversion = parseFloat(row.attr("data-conversion"));

            if (!conversion || conversion <= 0) {
                conversion = itemConversionMap[itemId] || 1;
            }

            let tabletQty = parseFloat($(this).val()) || 0;

            // Calculate strips
            let strips = Math.floor(tabletQty / conversion);

            // Update Qty field
            row.find(".qty").val(strips);

            // Recalculate row
            calculateRow(row);
        });

        // ================================================================
        // 🔹 Q.TABLET BLUR HANDLER
        // ================================================================
        $(document).on("blur", ".tablet-qty", function () {
            if (!isTabletWiseMode) return;

            const row = $(this).closest("tr");
            const itemId = row.find(".item-id").val();

            let conversion = parseFloat(row.attr("data-conversion"));
            if (!conversion || conversion <= 0) {
                conversion = itemConversionMap[itemId] || 1;
            }

            let tabletQty = parseFloat($(this).val()) || 0;

            // Show only remaining tablets
            let remainingTablets = tabletQty % conversion;

            $(this).val(remainingTablets);

            // RE-CALCULATE ROW WITH UPDATED VALUE
            calculateRow(row);
        });
    </script>

    <script>
        //================================================================
        //🔹 COMPREHENSIVE PAGE INITIALIZATION
        //================================================================ 

        $(document).ready(function () {
            calculateTotalSummary();
            calculateTotalPaid();

            // LOAD ITEM DATA & CALCULATE EXISTING ROWS
            showLoader("Loading item data...");

            const currentSaleId = @Model.Id;
            $.get('/Sales/GetAllItemsForEdit?saleId=' + currentSaleId, function (items) {
                hideLoader();
                debugger;

                // STEP 1: Store max discount + conversion for all items
                items.forEach(item => {
                    itemMaxDiscounts[item.id] = parseFloat(item.maximumdiscount) || 0;
                    const conversion = parseFloat(item.conversion) || 1;
                    itemConversionMap[item.id] = conversion;
                });

                // STEP 2: Set allowNegative from FIRST item (global setting)
                if (items.length > 0) {
                    window.allowNegativeSetting = items[0].allowNegative === true;
                }

                // STEP 3: DETECT TABLET-WISE MODE FROM API
                if (items.length > 0) {
                    const itemConversion = items[0].itemConversion || "StripWise";
                    isTabletWiseMode = (itemConversion === "TabletWise");

                    // UPDATE HEADER TEXT
                    if (isTabletWiseMode) {
                        $('#qtyView').text('Strip');
                        $('#qtyTabsView').show();  // Show Tabs column
                    } else {
                        $('#qtyView').text('Qty');
                        $('#qtyTabsView').hide();  // Hide Tabs column
                    }

                    // APPLY MODE TO ALL EXISTING ROWS
                    $("#SalesItemBody tr").each(function() {
                        applyTabletWiseMode($(this));
                    });
                }

                // STEP 4: Set max discount + conversion + available-qty for existing rows
                $("#SalesItemBody tr").each(function() {
                    const row = $(this);
                    const itemId = row.find(".item-id").val();

                    if (!itemId) return;

                    // SET MAX DISCOUNT
                    if (itemMaxDiscounts[itemId]) {
                        row.attr("data-max-discount", itemMaxDiscounts[itemId]);
                    }

                    // SET CONVERSION
                    if (itemConversionMap[itemId]) {
                        row.attr("data-conversion", itemConversionMap[itemId]);
                    }

                    // GET MINIMUM QTY
                    const matchingItem = items.find(i => i.id == itemId);
                    if (matchingItem) {
                        const minimumQty = parseFloat(matchingItem.minimumQty) || 0;
                        row.attr("data-minimum-qty", minimumQty);
                    }

                    // GET AVAILABLE QTY FOR THIS BATCH
                    const batch = row.find(".batch").val();
                    if (batch) {
                        $.get('/Sales/GetBatchesByItemIdForEdit', { id: itemId, saleId: @Model.Id }, function(data) {
                            if (!data.groupedResult) return;

                            const matchingBatch = data.groupedResult.find(b => b.batch === batch);
                            if (matchingBatch) {
                                row.attr("data-available-qty", matchingBatch.qty);
                                console.log(`✅ Batch ${batch}: Available=${matchingBatch.qty}`);
                            }
                        });
                    }

                    // CALCULATE THIS ROW (TRIGGER CALCULATION)
                    calculateRow(row);
                });

            }).fail(function() {
                hideLoader();
                toastr.warning("Could not load item data");
            });

            setTimeout(() => {
                if (document.activeElement?.id === "BillDate") return;
                $("#BillDate").focus().select();
            }, 100);
        });
    </script>
    <script>
        function confirmCancel(callback) {
            Swal.fire({
                title: 'Confirm Cancel?',
                text: 'Changes will be lost. Do you want to cancel?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: '❌ Yes, Cancel',
                cancelButtonText: '↩ No, Stay',
                confirmButtonColor: '#dc3545', 
                cancelButtonColor: '#6c757d',
                reverseButtons: true
            }).then((result) => {
                callback(result.isConfirmed);
            });
        }

        $("#btnCancel").on("click", function (e) {
            e.preventDefault();

            confirmCancel(function (isConfirmed) {
                if (isConfirmed) {
                    window.location.href = $("#btnCancel").attr("href");
                }
            });
        });
    </script>
    <script>
        // ================================================================
        // 🔹 CUSTOMER LOYALTY POINTS INTEGRATION
        // ================================================================
        var loyaltyInfo = null;

        function loadCustomerLoyaltyInfo(customerId, isInitialLoad) {
            // Skip loyalty program panels for historical bills created before the loyalty program was configured
            var billCreatedStr = "@ViewBag.CreatedDate";
            var activationDateStr = "@ViewBag.LoyaltyActivationDate";
            if (billCreatedStr && activationDateStr) {
                var billCreated = new Date(billCreatedStr);
                var activationDate = new Date(activationDateStr);
                if (billCreated < activationDate) {
                    resetLoyaltyUI();
                    return;
                }
            }

            if (!customerId) {
                resetLoyaltyUI();
                return;
            }

            $.get('/Customer/GetLoyaltyData', { id: customerId }, function (res) {
                if (res.success && res.data && res.data.isPointProgramActive) {
                    loyaltyInfo = res.data;

                    // For Edit screen: add currently redeemed points to pointsBalance
                    var currentlyRedeemed = parseInt("@Model.RedeemPoints") || 0;
                    var effectiveBalance = loyaltyInfo.pointsBalance;
                    
                    var isOriginalCustomer = (customerId == "@Model.CustomerId");
                    if (isOriginalCustomer) {
                        effectiveBalance += currentlyRedeemed;
                    }

                    var valInRs = loyaltyInfo.pointValueInRs;
                    var effectiveValue = effectiveBalance * valInRs;
                    
                    $("#loyaltyBalanceBadge").text(effectiveBalance + " Points");
                    $("#loyaltyValueSpan").text(effectiveValue.toFixed(2));
                    
                    if (loyaltyInfo.minPointsToRedeem > 0) {
                        $("#loyaltyMinRedeemSpan").text(`(Min points to redeem: ${loyaltyInfo.minPointsToRedeem})`);
                    } else {
                        $("#loyaltyMinRedeemSpan").text('');
                    }

                    $("#loyaltyPointsPanel").removeClass("d-none");
                    
                    $("#loyaltyRedeemInput")
                        .attr("max", effectiveBalance)
                        .data("valinrs", valInRs);

                    if (isInitialLoad && isOriginalCustomer) {
                        $("#loyaltyRedeemInput").val(currentlyRedeemed);
                        $("#RedeemPoints").val(currentlyRedeemed);
                    } else {
                        $("#loyaltyRedeemInput").val("0");
                        $("#RedeemPoints").val("0");
                    }

                    if (!loyaltyInfo.allowPointRedemption) {
                        $("#loyaltyRedeemSection").addClass("d-none");
                        $("#loyaltyMinRedeemSpan").text("(Redemption is currently disabled)");
                    } else if (effectiveBalance < loyaltyInfo.minPointsToRedeem) {
                        $("#loyaltyRedeemSection").addClass("d-none");
                        $("#loyaltyMinRedeemSpan").append(" - Insufficient points balance to redeem.");
                    } else {
                        $("#loyaltyRedeemSection").removeClass("d-none");
                    }

                    if (isInitialLoad && currentlyRedeemed > 0 && isOriginalCustomer) {
                        calculateTotalPaymentSummary();
                    }
                } else {
                    resetLoyaltyUI();
                }
            }).fail(function () {
                resetLoyaltyUI();
            });
        }

        function resetLoyaltyUI() {
            loyaltyInfo = null;
            $("#loyaltyPointsPanel").addClass("d-none");
            $("#loyaltyRedeemInput").val("0").removeAttr("max").removeData("valinrs");
            $("#RedeemPoints").val("0");
            calculateTotalPaymentSummary();
        }

        $(document).on("click", "#btnApplyLoyaltyPoints", function () {
            applyLoyaltyPointsRedemption();
        });

        $(document).on("keypress", "#loyaltyRedeemInput", function (e) {
            if (e.which === 13) {
                e.preventDefault();
                applyLoyaltyPointsRedemption();
            }
        });

        function applyLoyaltyPointsRedemption() {
            if (!loyaltyInfo) return;

            let points = parseInt($("#loyaltyRedeemInput").val()) || 0;

            if (points < 0) {
                toastr.error("Redemption points cannot be negative.");
                $("#loyaltyRedeemInput").val("0");
                $("#RedeemPoints").val("0");
                calculateTotalPaymentSummary();
                return;
            }

            if (points === 0) {
                $("#RedeemPoints").val("0");
                calculateTotalPaymentSummary();
                toastr.info("Loyalty points discount removed.");
                return;
            }

            var currentlyRedeemed = parseInt("@Model.RedeemPoints") || 0;
            var isOriginalCustomer = ($("#CustomerId").val() == "@Model.CustomerId");
            var maxPoints = loyaltyInfo.pointsBalance;
            if (isOriginalCustomer) {
                maxPoints += currentlyRedeemed;
            }

            if (points > maxPoints) {
                toastr.error(`Cannot redeem more than available balance of ${maxPoints} points.`);
                $("#loyaltyRedeemInput").val("0");
                $("#RedeemPoints").val("0");
                calculateTotalPaymentSummary();
                return;
            }

            if (points < loyaltyInfo.minPointsToRedeem) {
                toastr.error(`Minimum ${loyaltyInfo.minPointsToRedeem} points are required to redeem.`);
                $("#loyaltyRedeemInput").val("0");
                $("#RedeemPoints").val("0");
                calculateTotalPaymentSummary();
                return;
            }

            let pointValue = points * loyaltyInfo.pointValueInRs;
            let totalPayable = parseFloat($("#totalPayable").val()) || 0;

            if (pointValue > totalPayable) {
                toastr.error(`Redemption value (₹${pointValue.toFixed(2)}) cannot exceed total bill amount (₹${totalPayable.toFixed(2)}).`);
                $("#loyaltyRedeemInput").val("0");
                $("#RedeemPoints").val("0");
                calculateTotalPaymentSummary();
                return;
            }

            $("#RedeemPoints").val(points);
            calculateTotalPaymentSummary();

            let remaining = Math.max(0, totalPayable - pointValue);
            let firstRowPayment = $("#PaymentDetailsBody tr:first .paymentAmount");
            if (firstRowPayment.length) {
                firstRowPayment.val(remaining.toFixed(2));
                calculateTotalPaid();
            }

            toastr.success(`Successfully applied ₹${pointValue.toFixed(2)} discount using ${points} loyalty points.`);
        }

        $(document).ready(function() {
            $("#CustomerId").on("change", function() {
                var customerId = $(this).val();
                loadCustomerLoyaltyInfo(customerId, false);
            });

            var initialCustomerId = $("#CustomerId").val();
            if (initialCustomerId) {
                loadCustomerLoyaltyInfo(initialCustomerId, true);
            }
        });
    </script>
}
