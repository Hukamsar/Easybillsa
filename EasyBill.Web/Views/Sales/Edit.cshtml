    <!-- ================================================================
         🔹 VALIDATION HELPERS
         ================================================================ -->
    <script>
        function isValidIndianMobile(mobile) {
            return phoneRegex.test(mobile);
        }

        function showPhoneError(message) {
            $("#mobilenumber").addClass("is-invalid");
            $("#phoneError").text(message).removeClass("d-none");
        }

        function hidePhoneError() {
            $("#mobilenumber").removeClass("is-invalid");
            $("#phoneError").addClass("d-none");
        }

        function isValidCustomerName(name) {
            if (!name) return false;
            name = name.trim();
            if (name.length < 3 || name.length > 150) return false;
            const regex = /^(?!\s)(?!.*\s$).+$/;
            return regex.test(name);
        }
    </script>

    <!-- ================================================================
         🔹 MOBILE NUMBER VALIDATION (MAIN FORM)
         ================================================================ -->
    <script>
        $("#mobilenumber").on("input", function () {
            let value = $(this).val().replace(/\D/g, '');
            $(this).val(value);

            if (value.length === 0) {
                showPhoneError("Phone number is required");
            } else if (!isValidIndianMobile(value)) {
                showPhoneError("Enter a valid 10-digit mobile number");
            } else {
                hidePhoneError();
            }
        });

        $("#mobilenumber").on("keypress", function (e) {
            if (this.value.length >= 10) e.preventDefault();
        });

        $("#mobilenumber").on("paste", function (e) {
            let pastedData = e.originalEvent.clipboardData.getData('text');
            let digitsOnly = pastedData.replace(/\D/g, '');
            if ((this.value.length + digitsOnly.length) > 10) {
                e.preventDefault();
            }
        });

        $("#newCustomerMobile").on("input", function () {
            let value = $(this).val().replace(/\D/g, '');
            $(this).val(value);

            if (!isValidIndianMobile(value)) {
                $(this).addClass("is-invalid");
                $(".field-error[data-field='PhoneNo']")
                    .text("Enter valid mobile number")
                    .removeClass("d-none");
            } else {
                $(this).removeClass("is-invalid");
                $(".field-error[data-field='PhoneNo']").addClass("d-none");
            }
        });

        $("#newCustomerMobile").on("keypress", function (e) {
            if (this.value.length >= 10) e.preventDefault();
        });

        $("#newCustomerMobile").on("paste", function (e) {
            let pastedData = e.originalEvent.clipboardData.getData('text');
            let digitsOnly = pastedData.replace(/\D/g, '');
            if ((this.value.length + digitsOnly.length) > 10) {
                e.preventDefault();
            }
        });

        $(document).on("input", "input[name='Name']", function () {
            const value = $(this).val();
            if (isValidCustomerName(value)) {
                $(this).removeClass("is-invalid");
                $(".field-error[data-field='Name']").addClass("d-none").text("");
            }
        });
    </script>

    <!-- ================================================================
         🔹 ORIGINAL CUSTOMER DATA BACKUP (EDIT MODE)
         ================================================================ -->
    <script>
        $(document).ready(function () {
            // ✅ Backup original customer data on page load
            originalCustomerData.mobile = $("#mobilenumber").val() || "";
            originalCustomerData.name = $("#customer").val() || "";
            originalCustomerData.address = $("#customeraddress").val() || "";
            originalCustomerData.customerId = $("#CustomerId").val() || "";
        });
    </script>

    <!-- ================================================================
         🔹 CUSTOMER & DOCTOR MANAGEMENT
         ================================================================ -->
    <script>
        $(document).ready(function () {
            $(document).on("blur", "#mobilenumber", function () {
                if (isCustomerCheckInProgress) return;
                isCustomerCheckInProgress = true;

                let mobileNo = $(this).val();

                if (mobileNo.length < 10) {
                    isCustomerCheckInProgress = false;
                    return;
                }

                $.ajax({
                    url: '/Sales/GetCustomerByMobile',
                    type: 'GET',
                    data: { mobileNo: mobileNo },
                    success: function (res) {
                        if (res.found) {
                            $('#customer').val(res.data.name);
                            $('#CustomerId').val(res.data.id).trigger('change');
                            $('#customeraddress').val(res.data.address);

                            originalCustomerData.mobile = mobileNo;
                            originalCustomerData.name = res.data.name;
                            originalCustomerData.address = res.data.address;
                            originalCustomerData.customerId = res.data.id;

                            toastr.success("Customer found and auto-filled.");
                        } else {
                            Swal.fire({
                                title: 'Customer Not Found',
                                text: 'Do you want to create a new customer?',
                                icon: 'question',
                                showCancelButton: true,
                                confirmButtonText: 'Yes, Create',
                                cancelButtonText: 'No',
                                confirmButtonColor: '#198754',
                                cancelButtonColor: '#dc3545',
                                reverseButtons: true
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    setTimeout(() => {
                                        $('#createCustomerModal').modal('show');
                                        $('#newCustomerMobile').val(mobileNo);
                                    }, 0);
                                }
                            });
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while searching for the customer.");
                    },
                    complete: function() {
                        isCustomerCheckInProgress = false;
                    }
                });
            });

            $(document).off("click.salesEditCustomerSave", "#newCustomerForm button[type='submit']")
                .on("click.salesEditCustomerSave", "#newCustomerForm button[type='submit']", function (e) {
                    e.preventDefault();
                    $("#newCustomerForm").trigger("submit");
                });

            $(document).off("submit.salesEditCustomer", "#newCustomerForm").on("submit.salesEditCustomer", "#newCustomerForm", function (e) {
                e.preventDefault();

                const accountGroupId = $('#newCustomerForm [name="AccountGroupId"]').val();
                const stateCode = $('#StateCodeHidden').val();
                const category = $('#newCustomerForm [name="Category"]').val();

                const customerData = {
                    Name: $('#newCustomerForm [name="Name"]').val(),
                    PhoneNo: $('#newCustomerForm [name="CustomerMobileNo"]').val(),
                    Address: $('#newCustomerForm [name="Address"]').val(),
                    Email: $('#newCustomerForm [name="Email"]').val(),
                    PaymentDays: parseInt($('#newCustomerForm [name="PaymentDays"]').val() || "0"),
                    Status: parseInt($('#newCustomerForm [name="Status"]').val() || "1"),
                    AccountGroupId: accountGroupId ? parseInt(accountGroupId) : null,
                    GSTNo: $('#newCustomerForm [name="GSTNo"]').val(),
                    StateCode: stateCode ? parseInt(stateCode) : null,
                    GSTType: parseInt($('#GSTTypeHidden').val() || "2"),
                    Category: category ? parseInt(category) : null
                };

                $(".field-error").text("").addClass("d-none");
                $("#newCustomerForm .is-invalid").removeClass("is-invalid");

                if (!isValidCustomerName(customerData.Name)) {
                    $('#newCustomerForm [name="Name"]').addClass("is-invalid").focus();
                    $(".field-error[data-field='Name']")
                        .text("Customer Name must be at least 3 characters and valid.")
                        .removeClass("d-none");
                    return;
                }

                if (!isValidIndianMobile(customerData.PhoneNo)) {
                    $('#newCustomerForm [name="CustomerMobileNo"]').addClass("is-invalid").focus();
                    $(".field-error[data-field='PhoneNo']")
                        .text("Enter a valid 10-digit mobile number")
                        .removeClass("d-none");
                    return;
                }

                $.ajax({
                    url: '/Sales/CreateCustomer',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(customerData),
                    success: function (res) {
                        if (res.success) {
                            var customer = res.data || res.Data || {};
                            $('#mobilenumber').val(customer.phoneNo || customer.PhoneNo);
                            $('#CustomerId').val(customer.id || customer.Id).trigger('change');
                            $('#customer').val(customer.name || customer.Name);
                            $('#customeraddress').val(customer.address || customer.Address);

                            originalCustomerData.mobile = customer.phoneNo || customer.PhoneNo;
                            originalCustomerData.name = customer.name || customer.Name;
                            originalCustomerData.address = customer.address || customer.Address;
                            originalCustomerData.customerId = customer.id || customer.Id;

                            $('#createCustomerModal').modal('hide');
                            toastr.success("Customer created and auto-filled.");
                        } else {
                            toastr.error("Customer not created.");
                        }
                    },
                    error: function (xhr) {
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.errors) {
                                Object.keys(xhr.responseJSON.errors).forEach(key => {
                                    $(`.field-error[data-field="${key}"]`)
                                        .text(xhr.responseJSON.errors[key][0])
                                        .removeClass("d-none");
                                });
                            } else if (xhr.responseJSON.message) {
                                toastr.error(xhr.responseJSON.message);
                            }
                        } else {
                            toastr.error("Something went wrong.");
                        }
                    }
                });
            });

            $('#doctorMobile').on("blur", function () {
                const mobile = $(this).val();
                if (mobile.length < 10) return;

                $.ajax({
                    url: '/PharmacyDoctor/GetDoctorByMobile',
                    type: 'GET',
                    data: { phoneNo: mobile },
                    success: function (res) {
                        if (res.found) {
                            $('#DoctorId').val(res.data.id);
                            $('#doctorname').val(res.data.name);
                            $('#doctorregno').val(res.data.registrationNo);
                            toastr.success("Doctor found and assigned.");
                        } else {
                            if (confirm("Doctor not found. Do you want to create a new one?")) {
                                $('#createDoctorModal').modal('show');
                                $('#newDoctorPhone').val(mobile);
                            }
                        }
                    },
                    error: function () {
                        alert("Error while searching doctor.");
                    }
                });
            });

            $('#newDoctorForm').submit(function (e) {
                e.preventDefault();

                const formData = {
                    Name: $('#newDoctorForm [name="Name"]').val(),
                    PhoneNo: $('#newDoctorForm [name="PhoneNo"]').val(),
                    Address: $('#newDoctorForm [name="Address"]').val(),
                    RegistrationNo: $('#newDoctorForm [name="RegistrationNo"]').val(),
                    Specialized: $('#newDoctorForm [name="Specialized"]').val(),
                    Commission: parseFloat($('#newDoctorForm [name="Commission"]').val()) || 0
                };

                $.ajax({
                    url: '/PharmacyDoctor/CreateDoctor',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function (res) {
                        if (res.success) {
                            $('#DoctorId').val(res.data.id);
                            $('#doctorname').val(res.data.name);
                            $('#doctorregno').val(res.data.registrationNo);
                            $('#createDoctorModal').modal('hide');
                            toastr.success("Doctor created and assigned.");
                        } else {
                            toastr.error("Doctor not created.");
                        }
                    },
                    error: function () {
                        toastr.error("Error saving doctor.");
                    }
                });
            });

            $('#createCustomerModal').on('shown.bs.modal', function () {
                isCustomerModalOpen = true;
                $(this).find("input[name='Name']").focus();
            });

            $('#createCustomerModal').on('hidden.bs.modal', function () {
                isCustomerModalOpen = false;
            });
        });
    </script>

    <!-- ================================================================
         🔹 CUSTOMER F1 LIST
         ================================================================ -->
    <script>
        $(document).on("click", "#btnF1CustomerList", function (e) {
            e.preventDefault();

            showLoader("Loading customers...");

            $.get('/Sales/GetCustomer', function (res) {
                hideLoader();

                if (!res.found || !res.data || res.data.length === 0) {
                    toastr.info("No customer found.");
                    return;
                }

                let rows = "";

                res.data.forEach(customer => {
                    const customerId = customer.id || customer.Id || "";
                    const customerName = customer.name || customer.Name || "";
                    const mobileNo = customer.phoneNo || customer.PhoneNo || "";
                    const address = customer.address || customer.Address || "";

                    rows += `<tr class="customer-row" tabindex="0"
                        data-customerid="${customerId}"
                        data-name="${customerName}"
                        data-phone="${mobileNo}"
                        data-address="${address}">
                        <td>${customerName}</td>
                        <td>${mobileNo}</td>
                    </tr>`;
                });

                $("#customerTableBody").html(rows);
                $("#customerSearch").val("");
                currentCustomerIndex = -1;
                $("#customerListModal").modal("show");
            }).fail(function () {
                hideLoader();
                toastr.error("Error loading customers");
            });
        });

        $(document).on("keydown", "#mobilenumber", function (e) {
            if (e.key !== "F1") return;

            e.preventDefault();
            e.stopImmediatePropagation();

            $("#btnF1CustomerList").trigger("click");
        });

        $(document).on("input", "#customerSearch", function () {
            const searchText = $(this).val().toLowerCase().trim();

            $("#customerTableBody tr").each(function () {
                const customerName = ($(this).data("name") || "").toString().toLowerCase();
                const mobileNo = ($(this).data("phone") || "").toString().toLowerCase();

                $(this).toggle(customerName.includes(searchText) || mobileNo.includes(searchText));
            });

            currentCustomerIndex = -1;
            $("#customerTableBody .customer-row").removeClass("selected");
        });

        $(document).on("keydown", function (e) {
            if (!$("#customerListModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                customerNavMode = "keyboard";
                isKeyboardScrollingCustomerModal = true;
                $("#customerListModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".customer-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentCustomerIndex === -1) {
                    currentCustomerIndex = 0;
                }
                else if (currentCustomerIndex < $rows.length - 1) {
                    currentCustomerIndex++;
                }

                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();

                if (currentCustomerIndex <= 0) return;

                currentCustomerIndex--;

                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
            else if (e.key === "Enter") {
                e.preventDefault();

                if (currentCustomerIndex === -1) {
                    currentCustomerIndex = 0;
                }

                $rows.eq(currentCustomerIndex).trigger("click");
            }
        });

        $(document).on("click", ".customer-row", function (e) {
            e.preventDefault();

            const customerId = $(this).data("customerid");
            const customerName = $(this).data("name") || "";
            const mobileNo = $(this).data("phone") || "";
            const address = $(this).data("address") || "";

            $("#billingType").val("registered");
            $("#mobilenumber, #customer, #customeraddress").prop("disabled", false);
            $("#CustomerId").val(customerId).trigger('change');
            $("#mobilenumber").val(mobileNo);
            $("#customer").val(customerName);
            $("#customeraddress").val(address);

            originalCustomerData.mobile = mobileNo;
            originalCustomerData.name = customerName;
            originalCustomerData.address = address;
            originalCustomerData.customerId = customerId;

            hidePhoneError();
            $("#customerListModal").modal("hide");

            setTimeout(() => {
                $("#customer").focus().select();
            }, 150);
        });

        $(document).on("mouseenter", ".customer-row", function () {
            if (!$("#customerListModal").is(":visible")) return;
            if (isKeyboardScrollingCustomerModal) return;

            customerNavMode = "mouse";

            $("#customerListModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".customer-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentCustomerIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#customerListModal", function () {
            isKeyboardScrollingCustomerModal = false;
        });

        $('#customerListModal').on('shown.bs.modal', function () {
            customerNavMode = "keyboard";

            $("#customerListModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".customer-row:visible");

            currentCustomerIndex = -1;

            if ($rows.length) {
                currentCustomerIndex = 0;
                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }

            setTimeout(() => {
                $("#customerSearch").focus().select();
            }, 200);
        });

        $('#customerListModal').on('hidden.bs.modal', function () {
            currentCustomerIndex = -1;
            $("#customerTableBody .customer-row").removeClass("selected");
        });
    </script>

    <!-- ================================================================
         🔹 FOCUS SOURCE TRACKING
         ================================================================ -->
    <script>
        $(document).on("keydown", function (e) {
            if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Enter", "Tab"].includes(e.key)) {
                lastFocusSource = "keyboard";
            }
        });

        $(document).on("mousedown", "input, select", function () {
            lastFocusSource = "mouse";
        });
    </script>

    <!-- ================================================================
         🔹 ITEM GRID MANAGEMENT
         ================================================================ -->
    <script>
        function addNewRow() {

            let tabletQtyColumn = '';
            
            if (@ViewBag.BusinessType === 2) {
                tabletQtyColumn = `
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].TabletQty"
                               class="form-control form-control-sm tablet-qty" value="0" />
                    </td>
                `;
            }

            let newRow = `
                <tr data-new-row="true">
                    <td hidden>
                        <input type="hidden" name="SalesItemVMs[${rowIndex}].Id" value="0" />
                    </td>
                    <td hidden>
                        <input name="SalesItemVMs[${rowIndex}].ItemMasterId" class="form-control form-control-sm item-id" />
                    </td>
                    <td style="min-width:250px;">
                        <input type="text" name="SalesItemVMs[${rowIndex}].ItemBarcodeNumber"
                               class="form-control form-control-sm item-barcode" />
                    </td>
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].Batch"
                               class="form-control form-control-sm batch" readonly />
                    </td>
                    <td>
                        <input type="text" name="SalesItemVMs[${rowIndex}].Expirydate"
                               class="form-control form-control-sm expirydate"
                               placeholder="MM/YYYY" maxlength="7" readonly />
                    </td>
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].Mrp"
                               class="form-control form-control-sm mrp" />
                    </td>
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].Qty"
                               class="form-control form-control-sm qty" />
                    </td>

                    ${tabletQtyColumn}

                    <td hidden>
                        <input name="SalesItemVMs[${rowIndex}].Rate" class="form-control form-control-sm rate" />
                    </td>
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].StripRate" class="form-control form-control-sm stripe-rate" />
                    </td>
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].Gst"
                               class="form-control form-control-sm gst" readonly />
                    </td>
                     <td>
                        <input name="SalesItemVMs[${rowIndex}].Cess"
                               class="form-control form-control-sm cess" readonly />
                    </td>
                    <td>
                        <input type="number" name="SalesItemVMs[${rowIndex}].Discount"
                               class="form-control form-control-sm discount" value="0" />
                    </td>
                    <td>
                        <input name="SalesItemVMs[${rowIndex}].Amount"
                               class="form-control form-control-sm Amount" readonly />
                    </td>
                    <td>
                        <u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u>
                    </td>
                </tr>`;

            $("#SalesItemBody").append(newRow);
            $("#SalesItemBody").find('.expirydate').each(function () {
                formatExpiryDateInput(this);
            });

            // APPLY TABLET-WISE MODE
            const $newRow = $("#SalesItemBody tr:last");
            applyTabletWiseMode($newRow);

            rowIndex++;
            updateRowIndices();
            toggleAddRowButton();
        }

        function formatExpiryDateInput(input) {
            let value = $(input).val().replace(/[^\d]/g, '');

            if (value.length >= 2) {
                let month = value.substring(0, 2);
                let year = value.substring(2, 6);

                if (parseInt(month) > 12) {
                    month = "12";
                } else if (parseInt(month) < 1) {
                    month = "01";
                }

                value = month;
                if (year) {
                    value += '/' + year;
                }
            }

            $(input).val(value.substring(0, 7));
        }

        function updateRowIndices() {
            const rows = document.querySelectorAll('#SalesItemBody tr');
            rowIndex = 0;
            rows.forEach(row => {
                row.querySelectorAll('input, select').forEach(input => {
                    const name = input.name;
                    if (name) input.name = name.replace(/\[\d+\]/, `[${rowIndex}]`);
                });
                rowIndex++;
            });
        }

        function toggleAddRowButton() {
            if ($("#SalesItemBody tr").length > 0) {
                $("#addRow").hide();
            } else {
                $("#addRow").show();
            }
        }

        $(document).ready(function () {
            $("#addRow").click(function () {
                addNewRow();
            });
             
            $(document).on("input", "#itemSearch", function () {
                const searchText = $(this).val().toLowerCase().trim();
                const isSaltSearch = $("#searchBySalt").is(":checked");
            
                $("#itemTableBody tr").each(function () {
                    let match = false;
            
                    if (isSaltSearch) {
                        // 🔥 Salt search
                        const salt = ($(this).data("salt") || "").toLowerCase();
            
                        // 👉 sirf wahi rows jinke paas salt hai
                        if (!salt) {
                            match = false;
                        } else {
                            match = salt.includes(searchText); // contains
                        }
            
                    } else {
                        // 🔥 Name search (old behavior)
                        const textToSearch = $(this).find("td:first").text().toLowerCase();
            
                        const searchWords = searchText.split(/\s+/);
                        const itemWords = textToSearch.split(/\s+/);
            
                        match = searchWords.every((word, i) =>
                            itemWords[i] && itemWords[i].startsWith(word)
                        );
                    }
            
                    $(this).toggle(match);
                });
            
                currentItemIndex = -1;
                $("#itemTableBody .item-row").removeClass("selected");
            });
             
            $(document).on("change", "#searchBySalt", function () {
                const isChecked = $(this).is(":checked");
            
                if (isChecked) {
                    $(".salt-col").show();   // show salt column
                } else {
                    $(".salt-col").hide();   // hide salt column
                }
            
                $("#itemSearch").val("").trigger("input").focus();
            });
            $(document).on("keydown", ".item-barcode", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    isEnterNavigation = true;
                    currentRow = $(this).closest("tr");
                    currentRowForCrossItemModal = $(this).closest("tr");

                    const barcode = $(this).val().trim();
                    if (!barcode) {
                        openItemSearchModal("");
                        isEnterNavigation = false;
                        return;
                    }
                    processBarcode(barcode);
                }
            });

            $(document).on("click", ".item-row", function () {
                const itemId = $(this).data("itemid");
                const itemName = $(this).data("name");
                const gst = $(this).data("gst");
                const cess = $(this).data("cess");
                const maxDiscount = parseFloat($(this).data("maxdiscount")) || 0;
                const allowNegative = $(this).data("allownegative") === true || $(this).data("allownegative") === "True";
                const minimumQty = parseFloat($(this).data("minimumqty")) || 0;
                const conversion = parseFloat($(this).data("conversion")) || 1;

                if (!itemId || !currentRow) return;

                currentRow.find(".item-barcode").val(itemName);
                currentRow.find(".item-id").val(itemId);
                currentRow.find(".gst").val(gst);
                currentRow.find(".cess").val(cess);
                currentRow.attr("data-max-discount", maxDiscount);
                currentRow.attr("data-minimum-qty", minimumQty);
                currentRow.attr("data-conversion", conversion);

                // Store in global object
                itemMaxDiscounts[itemId] = maxDiscount;
                itemConversionMap[itemId] = conversion;
                window.allowNegativeSetting = allowNegative;

                calculateRow(currentRow);
                $("#itemModal").modal("hide");

                processItemId(itemId);
            });

            $(document).on("focus", ".qty", function () {
                const val = parseFloat($(this).val());
                $(this).data("originalQty", isNaN(val) ? null : val);
            });
            $(document).on("input", ".stripe-rate", function () {
                let row = $(this).closest("tr");

                let stripRate = parseFloat($(this).val()) || 0;

                const itemId = row.find(".item-id").val();
                let conversion = parseFloat(row.attr("data-conversion"));

                if (!conversion || conversion <= 0) {
                    conversion = itemConversionMap[itemId] || 1;
                }

                // 👇 reverse calculation
                let tabletRate = stripRate / conversion;

                // 👇 actual rate update karo (hidden field)
                row.find(".rate").val(tabletRate.toFixed(4));

                // 🔥 recalculation trigger
                calculateRow(row);
            });
            
            $(document).on("input", ".qty, .rate, .discount", function () {
                let row = $(this).closest("tr");

                // Validate discount before calculating
                if ($(this).hasClass("discount")) {
                    let discountValue = parseFloat($(this).val()) || 0;

                    // Negative discount not allowed
                    if (discountValue < 0) {
                        toastr.error(
                            "Discount cannot be negative",
                            "Invalid Discount",
                            {
                                closeButton: true,
                                progressBar: true,
                                timeOut: 3000,
                                positionClass: "toast-top-right"
                            }
                        );

                        $(this).val(0);
                        calculateRow(row);

                        setTimeout(() => {
                            $(this).focus().select();
                        }, 100);

                        return;
                    }

                    // Cannot exceed 100%
                    if (discountValue > 100) {
                        toastr.error(
                            "Discount cannot exceed 100%",
                            "Invalid Discount",
                            {
                                closeButton: true,
                                progressBar: true,
                                timeOut: 3000,
                                positionClass: "toast-top-right"
                            }
                        );

                        $(this).val(100);
                        calculateRow(row);

                        setTimeout(() => {
                            $(this).focus().select();
                        }, 100);

                        return;
                    }

                    // Item-specific max discount (EXISTING)
                    if (!validateMaxDiscount(row)) {
                        return;
                    }
                }

                calculateRow(row);
            });
            $("#discountPercent, #discountamount").on("input", function () {
                calculateTotalSummary();
            });

            $(document).on("click", ".remove-row-btn", function () {
                $(this).closest("tr").remove();
                calculateTotalSummary();
                updateRowIndices();
                toggleAddRowButton();
            });

            $('.expirydate').each(function () {
                let val = $(this).val();
                if (val.includes('-')) {
                    let parts = val.split('-');
                    if (parts.length >= 2) {
                        let formatted = parts[1] + '/' + parts[0];
                        $(this).val(formatted);
                    }
                } else {
                    formatExpiryDateInput(this);
                }
            });

            $(document).on('input click', '.expirydate', function () {
                formatExpiryDateInput(this);
            });

            toggleAddRowButton();
        });

        function openItemSearchModal(searchText = "") {

            if (window.stopAutoItemOpen === true || $("#itemMasterModal").is(":visible")) {
                return;
            }

            showLoader("Loading items...");

            const currentSaleId = @Model.Id;
            $.get('/Sales/GetAllItemsForEdit?saleId=' + currentSaleId, function (items) {
                hideLoader();

                const businessType = @ViewBag.BusinessType;

                let rows = renderSalesEditItemRows(items, businessType);

                if (items.length > 0) {
                    window.allowNegativeSetting = items[0].allowNegative === true;
                }

                $("#itemTableBody").html(rows);
                $("#itemSearch").val(searchText);
                $("#itemSearch").trigger("input");
                $("#itemModal").modal("show");
            }).fail(function() {
                hideLoader();
                toastr.error("Error loading items");
            });
        }

        function renderSalesEditItemRows(items, businessType) {

            let rows = "";

            items.forEach(item => {

                rows += `<tr class="item-row" tabindex="0"
                    data-barcode="${item.barcode}"
                    data-itemid="${item.id}"
                    data-name="${item.name}"
                    data-salt="${item.salt || ''}"
                    data-gst="${item.gst}"
                    data-cess="${item.cess}"
                    data-qty="${item.qty}"
                    data-maxdiscount="${item.maximumdiscount}"
                    data-allownegative="${item.allowNegative}"
                    data-minimumqty="${item.minimumQty}"
                    data-conversion="${item.conversion || 1}">
                    <td>${item.name}</td>
                    <td class="salt-col">${item.salt || ''}</td>
                    ${
                        businessType === 2
                        ? `
                            <td style="display:none;">${item.qty}</td>
                            <td>${item.availableQty}</td>
                          `
                        : `
                            <td>${item.qty}</td>
                          `
                    }

                </tr>`;
            });

            return rows;
        }

        function processItemId(itemId) {
            showLoader("Loading batches...");

            const currentSaleId = @Model.Id;
            $.get('/Sales/GetBatchesByItemIdForEdit', { id: itemId, saleId: currentSaleId }, function (data) {
                hideLoader();

                if (data.error) {
                    alert(data.error);
                    return;
                }

                if (!data.groupedResult || data.groupedResult.length === 0) {
                    // Sales Edit Item Master save can lookup batches for a new item; suppress that warning once.
                    if (window.suppressNextBatchNotFound === true || window.stopAutoItemOpen === true) {
                        window.suppressNextBatchNotFound = false;
                        return;
                    }

                    toastr.warning("No batch available for this item.");
                    setTimeout(() => {
                        currentRow.find(".item-barcode").focus().select();
                    }, 200);
                    return;
                }

                window.suppressNextBatchNotFound = false;
                currentRow.find(".gst").val(data.gst);
                currentRow.find(".cess").val(data.cess);
                const businessType = @ViewBag.BusinessType;


                let batchRows = '';
                data.groupedResult.forEach(batch => {
                    const expiryDate = new Date(batch.expiry);
                    const month = String(expiryDate.getMonth() + 1).padStart(2, '0');
                    const year = expiryDate.getFullYear();
                    const formattedExpiry = `${month}/${year}`;
                    const encoded = encodeURIComponent(JSON.stringify(batch));

                    const isNegative = batch.qty < 0;
                    const isDisabled = (!window.allowNegativeSetting && isNegative);

                    let qtyColumns = '';
                    if (businessType === 2) {
                        qtyColumns = `
                            <td style=display:none;>${batch.qty}</td>
                            <td>${batch.stripTabsQty}</td>
                        `;
                    } else {
                        qtyColumns = `<td>${batch.qty}</td>`;
                    }

                batchRows += `
                <tr class="batch-row ${isDisabled ? 'batch-disabled' : ''}"
                    tabindex="${isDisabled ? -1 : 0}"
                    data-disabled="${isDisabled}"
                    data-batch="${encoded}">
                    <td>${batch.batch}</td>
                    <td>${formattedExpiry}</td>
                    <td hidden>${batch.rate.toFixed(4)}</td>
                    <td>${batch.striprate.toFixed(2)}</td>
                    <td>${batch.mrp}</td>
                    ${qtyColumns}
                </tr>`;

                    // batchRows += `<tr class="batch-row" tabindex="0" data-batch="${encoded}">
                    //     <td>${batch.batch}</td>
                    //     <td>${formattedExpiry}</td>
                    //     <td>${batch.rate}</td>
                    //     <td>${batch.mrp}</td>
                    //     <td>${batch.qty}</td>
                    // </tr>`;
                });

                $("#batchTableBody").html(batchRows);
                currentBatchIndex = $(".batch-row").length > 0 ? 0 : -1;
                highlightBatchRow($(".batch-row"), currentBatchIndex);
                $("#batchModal").modal("show");
            }).fail(function() {
                hideLoader();
                toastr.error("Error loading batches");
            });
        }

        function processBarcode(barcode) {
            // Ignore barcode lookup while Sales Edit F2/F3 Item Master form is active.
            if (window.stopAutoItemOpen === true || $("#itemMasterModal").is(":visible")) return;

            showLoader("Processing barcode...");

            $.get('/Sales/GetItemByBarcode', { barcode: barcode }, function (item) {
                hideLoader();

                if (!item || !item.itemId) {
                    openItemSearchModal(barcode);
                    return;
                }

                const itemName = item.itemname;
                const maxDiscount = parseFloat(item.maximumDiscount) || 0;
                const allowNegative = item.allowNegative === true;
                const minimumQty = parseFloat(item.minimumQty) || 0;
                const conversion = parseFloat(item.conversion) || 1;

                currentRow.find(".item-id").val(item.itemId);
                currentRow.find(".item-barcode").val(itemName);
                currentRow.attr("data-max-discount", maxDiscount);
                currentRow.attr("data-minimum-qty", minimumQty)
                currentRow.attr("data-conversion", conversion);


                itemMaxDiscounts[itemId] = maxDiscount;
                itemConversionMap[item.itemId] = conversion;
                window.allowNegativeSetting = allowNegative;

                showLoader("Loading batches...");

                $.get('/Sales/GetBatchesByItemIdForEdit', { id: item.itemId }, function (data) {
                    hideLoader();

                    if (data.error || !data.groupedResult.length) {
                        // Sales Edit Item Master save can trigger a new item batch check; keep the warning quiet once.
                        if (window.suppressNextBatchNotFound === true || window.stopAutoItemOpen === true) {
                            window.suppressNextBatchNotFound = false;
                            return;
                        }

                        toastr.warning("No batches available");
                        return;
                    }

                    window.suppressNextBatchNotFound = false;
                    currentRow.find(".gst").val(data.gst);
                    currentRow.find(".cess").val(data.cess);
                    let batchRows = '';
                    data.groupedResult.forEach(batch => {
                        const expiryDate = new Date(batch.expiry);
                        const month = String(expiryDate.getMonth() + 1).padStart(2, '0');
                        const year = expiryDate.getFullYear();
                        const formattedExpiry = `${month}/${year}`;
                        const encoded = encodeURIComponent(JSON.stringify(batch));

                        batchRows += `<tr class="batch-row" tabindex="0" data-batch="${encoded}">
                            <td>${batch.batch}</td>
                            <td>${formattedExpiry}</td>
                            <td hidden>${batch.rate.toFixed(2)}</td>
                            <td>${batch.striprate.toFixed(2)}</td>
                            <td>${batch.mrp}</td>
                            <td>${batch.qty}</td>
                        </tr>`;
                    });

                    $("#batchTableBody").html(batchRows);
                    const $rows = $(".batch-row");
                    currentBatchIndex = $rows.length > 0 ? 0 : -1;
                    highlightBatchRow($rows, currentBatchIndex);
                    $("#batchModal").modal("show");
                }).fail(function() {
                    hideLoader();
                    toastr.error("Error loading batches");
                });
            }).fail(function() {
                hideLoader();
                toastr.error("Error processing barcode");
            });
        }

        function highlightBatchRow($rows, index) {
            $rows.removeClass("selected");
            const $row = $rows.eq(index);
            $row.addClass("selected");
            $row[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
        }

        function highlightItemRow($rows, index) {
            $rows.removeClass("selected");
            const $row = $rows.eq(index);
            $row.addClass("selected");
            $row[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
        }

