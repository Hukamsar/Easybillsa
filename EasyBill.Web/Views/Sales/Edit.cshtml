    <script>
        function applyBillingType(type) {
            setTimeout(() => {
                if (type === "walkin") {
                    $("#mobilenumber, #customer, #customeraddress")
                        .prop("disabled", true)
                        .addClass("bg-light");

                    $("#mobilenumber, #customer, #customeraddress").val("");
                    $("#CustomerId").val("").trigger('change');
                } else if (type === "registered") {
                    $("#mobilenumber, #customer, #customeraddress")
                        .prop("disabled", false)
                        .removeClass("bg-light");

                    $("#mobilenumber").focus();
                }

                isEnterNavigation = false;
            }, 100);
        }

        $("#billingType").on("change", function () {
            isEnterNavigation = false;

            const billingType = this.value;
            
            // Auto change Payment Type based on Billing Type
            if (billingType === "registered") {
                $("#paymentToggle").prop("checked", true);
                $("#paymentToggleLabel").text("Credit");
                $("#paymentTypeHidden").val("credit");
            } else if (billingType === "walkin") {
                $("#paymentToggle").prop("checked", false);
                $("#paymentToggleLabel").text("Cash");
                $("#paymentTypeHidden").val("cash");
            }


            if (this.value === "walkin") {
                $("#mobilenumber, #customer, #customeraddress")
                    .prop("disabled", true)
                    .addClass("bg-light");

                $("#mobilenumber, #customer, #customeraddress").val("");
                hidePhoneError();
            } else {
                $("#mobilenumber, #customer, #customeraddress")
                    .prop("disabled", false)
                    .removeClass("bg-light");

                // RESTORE ORIGINAL CUSTOMER
                $("#mobilenumber").val(originalCustomerData.mobile);
                $("#customer").val(originalCustomerData.name);
                $("#customeraddress").val(originalCustomerData.address);
                $("#CustomerId").val(originalCustomerData.customerId);

                $("#mobilenumber").focus().select();
            }
        });

        // ✅ AUTO-OPEN DROPDOWN ON FOCUS (SAME AS CREATE PAGE)
        $(document).on("focus", "#billingType", function() {
            const select = this;

            setTimeout(() => {
                if ('showPicker' in HTMLSelectElement.prototype) {
                    select.showPicker();
                } else {
                    // Fallback for older browsers
                    const event = new MouseEvent('mousedown', {
                        view: window,
                        bubbles: true,
                        cancelable: true
                    });
                    select.dispatchEvent(event);
                }
            }, 50);
        });

        $(document).on("keydown", "#billingType", function (e) {
            if (e.key === "ArrowUp" || e.key === "ArrowDown") {
                // Let browser handle arrow navigation
                return;
            }

            if (e.key === "Enter") {
                e.preventDefault();
                e.stopImmediatePropagation();

                const type = this.value;

                if (type === "registered") {
                    $("#mobilenumber").prop("disabled", false).focus();
                } else {
                    $("#mobilenumber, #customer, #customeraddress")
                        .val("")
                        .prop("disabled", true);

                    hidePhoneError();

                    if ($("#doctorMobile").length && $("#doctorMobile").is(":visible") &&
                        !$("#doctorMobile").is(":disabled")) {
                        $("#doctorMobile").focus();
                    } else {
                        focusItemGrid();
                    }
                }
            }
        });
    </script>

