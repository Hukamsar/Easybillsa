                hideLoader();
                console.log(xhr.responseText);
                toastr.error("Error loading Item Master edit form");
            });
        });

        // Sales Edit item dropdown keyboard shortcuts follow the same F2/F3 click flow.
        $(document).on('keydown', function (e) {
            if (!$("#itemModal").is(":visible") || $("#itemMasterModal").is(":visible")) return;

            if (e.key === "F2") {
                e.preventDefault();
                e.stopPropagation();
                $("#btnNewItem").trigger("click");
