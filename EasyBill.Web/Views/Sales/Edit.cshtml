        $(document).on("keydown", function (e) {
            if ($("#itemModal").is(":visible")) {
                if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                    itemNavMode = "keyboard";
                    isKeyboardScrollingItemModal = true;
                    $("#itemModal")
                        .addClass("keyboard-nav")
                        .removeClass("mouse-nav");
                }

                const $rows = $(".item-row:visible");
                if (e.key === "ArrowDown") {
                    e.preventDefault();
                    if (currentItemIndex === -1) {
                        currentItemIndex = 0;
                    } else if (currentItemIndex < $rows.length - 1) {
                        currentItemIndex++;
                    }
                    highlightItemRow($rows, currentItemIndex);
                } else if (e.key === "ArrowUp") {
                    e.preventDefault();
                    if (currentItemIndex > 0) {
                        currentItemIndex--;
                        highlightItemRow($rows, currentItemIndex);
                    }
                } else if (e.key === "Enter" && currentItemIndex >= 0) {
                    e.preventDefault();
                    $rows.eq(currentItemIndex).trigger("click");
                }
            }

            if ($("#batchModal").is(":visible")) {
                if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                    batchNavMode = "keyboard";
                    isKeyboardScrollingBatchModal = true;
                    $("#batchModal")
                        .addClass("keyboard-nav")
                        .removeClass("mouse-nav");
                }

                const $rows = $(".batch-row");
                if (!$rows.length) return;

                if (e.key === "ArrowDown") {
                    e.preventDefault();
                    if (currentBatchIndex === -1) {
                        currentBatchIndex = 0;
                    } else if (currentBatchIndex < $rows.length - 1) {
                        currentBatchIndex++;
                    }
                    highlightBatchRow($rows, currentBatchIndex);
                } else if (e.key === "ArrowUp") {
                    e.preventDefault();
                    if (currentBatchIndex <= 0) return;
                    currentBatchIndex--;
                    highlightBatchRow($rows, currentBatchIndex);
                } else if (e.key === "Enter" && currentBatchIndex >= 0) {
                    e.preventDefault();
                    $rows.eq(currentBatchIndex).trigger("click");
                }
            }
        });

