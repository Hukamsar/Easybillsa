            window.stopAutoItemOpen = true;
            showLoader("Loading Item Master...");

            $.get('/ItemMaster/LoadItemMasterPartial', function (data) {
                hideLoader();
                $('#itemMasterContainer').html(data);

                var showSalesEditItemMaster = function () {
                    window.stopAutoItemOpen = true;
                    $('#itemMasterModal').modal("show");

                    setTimeout(function () {
                        $("#ItemMasterForm input[name='Name']").focus();
