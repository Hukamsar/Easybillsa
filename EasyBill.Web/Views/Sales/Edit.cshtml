    <script>
        $(document).on("keydown",
            "#BillNo, #BillDate, #mobilenumber, #customer, #customeraddress, #doctorMobile, #doctorname, #doctorregno",
            function (e) {
                if (e.key !== "Enter") return;
                e.preventDefault();

                const id = this.id;

                switch (id) {
                    case "BillNo":
                        $("#BillDate").focus();
                        break;

                    case "BillDate":
                        //$("#billingType").focus();
                        $("#paymentToggle").focus();
                        break;

                    case "mobilenumber":
                        if (!isValidIndianMobile(this.value)) {
                            toastr.warning("Please enter valid mobile number");
                            this.focus();
                            return;
                        }
                        setTimeout(() => $("#customer").focus(), 50);
                        break;

                    case "customer":
                        $("#customeraddress").focus();
                        break;

                    case "customeraddress":
                        if ($("#doctorMobile").length && $("#doctorMobile").is(":visible") &&
                            !$("#doctorMobile").is(":disabled")) {
                            $("#doctorMobile").focus();
                        } else {
                            focusItemGrid();
                        }
                        break;

                    case "doctorMobile":
                        $("#doctorname").focus();
                        break;

                    case "doctorname":
                        $("#doctorregno").focus();
                        break;

                    case "doctorregno":
                        focusItemGrid();
                        break;
                }
            }
        );

        function focusItemGrid() {
            setTimeout(() => {
                const item = $("#SalesItemBody tr:first .item-barcode");
                if (item.length) {
                    item.focus().select();
                } else {
                    addNewRow();
                    setTimeout(() => {
                        $("#SalesItemBody tr:first .item-barcode").focus().select();
                    }, 150);
                }
            }, 150);
        }

        // Sales Edit F2-New loads the existing Sales Item Master partial and saves through the same backend.
        $(document).on('click', '#btnNewItem', function (e) {
