    <script>
        let isFormSubmitting = false;

        $("form").on("submit", function (e) {
            if ($(this).attr("id") === "newCustomerForm" || $(this).attr("id") === "newDoctorForm") {
                return true;
            }

            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();

            if (isFormSubmitting) {
                return false;
            }

            const form = this;

            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: 3000,
                extendedTimeOut: 1000,
                preventDuplicates: true
            };

            const billingType = $("#billingType").val();
            const mobile = ($("#mobilenumber").val() || "").trim();
            const customerName = ($("#customer").val() || "").trim();

            if (billingType === "registered") {
                if (!mobile) {
                    toastr.error("Mobile number is required.", "Mobile Required");
                    $("#mobilenumber").focus().select();
                    return false;
                }

                if (!isValidIndianMobile(mobile)) {
                    toastr.error("Please enter a valid 10-digit mobile number.", "Invalid Mobile");
                    $("#mobilenumber").focus().select();
                    return false;
                }

                if (!customerName) {
                    toastr.error("Customer name is required.", "Customer Required");
                    $("#customer").focus().select();
                    return false;
                }
            }

            let hasValidItemRow = false;
            let firstZeroQtyRow = null;
            let firstIncompleteRow = null;

            $("#SalesItemBody tr").each(function () {
                const row = $(this);

                const itemId = (row.find(".item-id").val() || "").trim();
                const batch = (row.find(".batch").val() || "").trim();
                const qty = parseFloat(row.find(".qty").val()) || 0;

                // ✅ SKIP COMPLETELY BLANK ROWS
                if (!itemId && !batch && qty === 0) {
                    return;
                }

                // ✅ CHECK INCOMPLETE ROWS (Item but no Batch)
                if (itemId && !batch && !firstIncompleteRow) {
                    firstIncompleteRow = row;
                }

                // ✅ TABLET-WISE QTY VALIDATION
                let isValidQty = false;

                if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                    const qtyTabs = parseFloat(row.find(".tablet-qty").val()) || 0;

                    // Valid if EITHER Qty > 0 OR TabletQty > 0
                    if (qty > 0 || qtyTabs > 0) {
                        isValidQty = true;
                    }

                    // Check for negative values
                    if (qty < 0 || qtyTabs < 0) {
                        isValidQty = false;
                    }

                    // Store first invalid row
                    if (!isValidQty && itemId && batch && !firstZeroQtyRow) {
                        firstZeroQtyRow = row;
                    }
                } else {
                    // STRIP-WISE: Qty must be >= 1
                    if (qty >= 1) {
                        isValidQty = true;
                    }

                    // Store first invalid row
                    if (!isValidQty && itemId && batch && !firstZeroQtyRow) {
                        firstZeroQtyRow = row;
                    }
                }

                // ✅ CHECK IF ROW IS VALID (has item, batch, and valid qty)
                if (itemId && batch && isValidQty) {
                    hasValidItemRow = true;
                }
            });

            // ✅ ERROR: INCOMPLETE ROW (Item but no Batch)
            if (firstIncompleteRow) {
                toastr.error("Please select batch for all items.", "Incomplete Item");
                firstIncompleteRow.find(".item-barcode").focus().select();
                return false;
            }

            // ✅ ERROR: INVALID QTY
            if (firstZeroQtyRow) {
                if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                    const qty = parseFloat(firstZeroQtyRow.find(".qty").val()) || 0;
                    const qtyTabs = parseFloat(firstZeroQtyRow.find(".tablet-qty").val()) || 0;

                    if (qty < 0 || qtyTabs < 0) {
                        toastr.error("Quantity cannot be negative.", "Invalid Quantity");

                        if (qty < 0) {
                            firstZeroQtyRow.find(".qty").focus().select();
                        } else {
                            firstZeroQtyRow.find(".tablet-qty").focus().select();
                        }
                    } else {
                        toastr.error("Please enter quantity or tablet quantity.", "Invalid Quantity");
                        firstZeroQtyRow.find(".tablet-qty").focus().select();
                    }
                } else {
                    toastr.error("Quantity must be at least 1.", "Invalid Quantity");

                    const qtyInput = firstZeroQtyRow.find(".qty");
                    const originalQty = qtyInput.data("originalQty");

                    if (originalQty && originalQty > 0) {
                        qtyInput.val(originalQty);
                    } else {
                        qtyInput.val(1);
                    }

                    calculateRow(firstZeroQtyRow);
                    qtyInput.focus().select();
                }

                return false;
            }

            // ✅ ERROR: NO VALID ITEMS
            if (!hasValidItemRow) {
                toastr.error("Please add at least one valid item before saving.", "No Items");

                const firstRow = $("#SalesItemBody tr:first");
                if (firstRow.length) {
                    firstRow.find(".item-barcode").focus().select();
                }
                return false;
            }

            // // ✅ ALL VALIDATIONS PASSED - CONFIRM SAVE
            // confirmSave(function (ok) {
            //     if (!ok) return;

            //     showLoader("Updating sale...");
            //     form.submit();

            //     isFormSubmitting = true;
            // });

          confirmSave(function(ok) {
            if (!ok) return;

            showLoader("Updating sale...");
            isFormSubmitting = true;

            $.ajax({
                type: "POST",
                url: $(form).attr("action"),
                data: $(form).serialize(),
                success: function(response) {
                    hideLoader();

                    if (!response.success) {
                        isFormSubmitting = false;
                        const errorMsg = response.message || "Update failed! Please try again.";
                        toastr.error(errorMsg, "Error");
                        return;
                    }

                    if (response.walletMessage) {
                        toastr.warning(response.walletMessage, "Wallet");
                    }

                    if (window.parent && window.parent !== window && window.frameElement && window.frameElement.id === "salesEditFrame") {
                        window.parent.postMessage({ salesEditSaved: true }, window.location.origin);
                        return;
                    }

                    Swal.fire({
                        title: 'Sales Bill Action',
                        text: 'What do you want to do with the sales bill? (Press Esc to skip)',
                        icon: 'question',
                        showConfirmButton: true,
                        showDenyButton: true,
                        showCancelButton: true,
                        confirmButtonText: '🖨️ Print',
                        denyButtonText: '👁️ Preview',
                        cancelButtonText: '❌ Skip',
                        confirmButtonColor: '#0d6efd',
                        denyButtonColor: '#198754',
                        cancelButtonColor: '#6c757d',
                        reverseButtons: true,
                        allowEscapeKey: true,
                        allowOutsideClick: false
                    }).then((result) => {
                        const reportUrl = "/Sales/Print/" + response.saleId;

                        if (result.dismiss === Swal.DismissReason.cancel || result.dismiss === Swal.DismissReason.esc) {
                            window.location.href = "/Sales/Index";
                            return;
                        }

                        if (result.isDenied) {
                            window.open(reportUrl, "_blank");
                            window.location.href = "/Sales/Index";
                            return;
                        }

                       if (result.isConfirmed) {
                           if (window.printType === 'thermal') {
                               const size = window.thermalPaperSize === '58' ? '58mm' : '80mm';
                               const thermalUrl = "/ThermalReceipt/Index?saleId=" + response.saleId + "&paperSize=" + size;
                       
                               $("#thermalPrintFrame").remove();
                               const iframe = $('<iframe>', {
                                   id: 'thermalPrintFrame',
                                   src: thermalUrl
                               }).css({
                                   position: 'fixed',
                                   top: '-9999px',
                                   left: '-9999px',
                                   width: '1px',
                                   height: '1px',
                                   border: 'none',
                                   visibility: 'hidden'
                               });
                       
                               $('body').append(iframe);
                               iframe[0].onload = function() {
                                   iframe[0].contentWindow.focus();
                                   iframe[0].contentWindow.print();
                                   // Print ke BAAD redirect
                                   setTimeout(() => {
                                       $("#thermalPrintFrame").remove();
                                       window.location.href = "/Sales/Index";
                                   }, 2000);
                               };
                           } else {
                               // reportFrame check karo - agar nahi hai to create karo
                               let iframe = document.getElementById("reportFrame");
                               if (!iframe) {
                                   iframe = document.createElement("iframe");
                                   iframe.id = "reportFrame";
                                   iframe.style.display = "none";
                                   document.body.appendChild(iframe);
                               }
                               iframe.onload = function() {
                                   waitingForFocusAfterPrint = true;
                                   iframe.contentWindow.focus();
                                   iframe.contentWindow.print();
                                   setTimeout(() => {
                                       window.location.href = "/Sales/Index";
                                   }, 1000);
                               };
                               iframe.src = reportUrl;
                           }
                           // window.location.href hata diya - ab print ke baad hoga
                       }
                    });
                },
                error: function(xhr, status, error) {
                    hideLoader();
                    isFormSubmitting = false;
                    console.error("Update Error:", xhr, error);

                    let errorMessage = "An error occurred while updating. Please try again.";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        try {
                            const parsed = JSON.parse(xhr.responseText);
                            errorMessage = parsed.message || errorMessage;
                        } catch (e) {
                            errorMessage = xhr.responseText;
                        }
                    } else if (xhr.status === 400) {
                        errorMessage = "Invalid data submitted. Please check all fields.";
                    }

                    toastr.error(errorMessage, "Server Error");
                }
            });
        });
        });
    </script>

