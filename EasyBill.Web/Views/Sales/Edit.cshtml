        // Sales Edit row refresh after Item Master save keeps dropdown closed and fills current row.
        function refreshItemSearchAfterCreate(response) {
            showLoader("Refreshing items...");

            const currentSaleId = @Model.Id;
            $.get('/Sales/GetAllItemsForEdit?saleId=' + currentSaleId, function (items) {
                hideLoader();

                const businessType = @ViewBag.BusinessType;

                let rows = renderSalesEditItemRows(items, businessType);

                if (items.length > 0) {
                    window.allowNegativeSetting = items[0].allowNegative === true;
                }

                $("#itemTableBody").html(rows);

                itemConversionMap[response.itemId] = parseFloat(response.conversion) || 1;
                itemMaxDiscounts[response.itemId] = parseFloat(response.maximumDiscount) || 0;

                if (currentRow && currentRow.length) {
                    currentRow.find(".item-barcode").val(response.itemName);
                    currentRow.find(".item-id").val(response.itemId);
                    currentRow.find(".gst").val(response.gst);
                    currentRow.find(".cess").val(response.cess);
                    currentRow.attr("data-max-discount", response.maximumDiscount);
                    currentRow.attr("data-minimum-qty", response.minimumQty);
                    currentRow.attr("data-conversion", response.conversion);

                    calculateRow(currentRow);

                    window.suppressNextBatchNotFound = true;
                    processItemId(response.itemId);
                }

                $("#itemSearch").val(response.itemName);

                const isChecked = $("#searchBySalt").is(":checked");
                $(".salt-col").toggle(isChecked);
            }).fail(function () {
                hideLoader();
                toastr.error("Error refreshing items");
            });
        }

        // Item Master close should return Sales Edit to normal state without reopening item dropdown.
        $('#itemMasterModal').on('hidden.bs.modal', function () {
            if (window.stopAutoItemOpen === true) {
                setTimeout(function () {
                    window.stopAutoItemOpen = false;
                }, 800);
                return;
            }

            setTimeout(function () {
                if (currentRowForCrossItemModal && currentRowForCrossItemModal.length) {
                    const barcodeInput = currentRowForCrossItemModal.find(".item-barcode");
                    if (barcodeInput.length) {
                        barcodeInput.focus().select();
                    }
                }
            }, 200);
        });

        $('#itemModal').on('hidden.bs.modal', function () {
            // F2/F3 closes item search first; do not refocus barcode before Item Master opens.
            if (window.stopAutoItemOpen === true) {
                return;
            }

            setTimeout(() => {
                if (currentRowForCrossItemModal && currentRowForCrossItemModal.length) {
                    const itemInput = currentRowForCrossItemModal.find(".item-barcode");
                    if (itemInput.length) {
                        itemInput.focus().select();
                    }
                }
            }, 150);
        });
    </script>

