         ================================================================ -->
    <script>
        $(document).ready(function () {
            $("#addPaymentRow").click(function () {
                addPaymentRow();
                togglePaymentAddButton();
            });

            $(document).on("click", ".remove-paymentrow-btn", function () {
                $(this).closest("tr").remove();
                calculateTotalPaid();
                togglePaymentAddButton();
            });

            $(document).on("keyup", ".paymentAmount", function () {
                calculateTotalPaid();
            });

            togglePaymentAddButton();
        });

        function addPaymentRow() {
            let newRow = `
                <tr>
                    <td style="min-width:185px;">
                        <select name="SalsePaymentDetails[${subrowIndex}].PaymentModeId"
                                class="form-control form-control-sm paymentMode-dropdown" required>
                            <option value="">-- Select --</option>
                            ${getPaymentOptions()}
                        </select>
                    </td>
                    <td>
                        <input name="SalsePaymentDetails[${subrowIndex}].Amount"
                               class="form-control form-control-sm paymentAmount" value="0" />
                    </td>
                    <td>
                        <input name="SalsePaymentDetails[${subrowIndex}].ReferenceNo"
                               class="form-control form-control-sm paymentReferenceNO" />
                    </td>
                    <td>
                        <input name="SalsePaymentDetails[${subrowIndex}].Description"
                               class="form-control form-control-sm rate paymentDescription" />
                    </td>
                    <td>
                        <u class="remove-paymentrow-btn text-danger" style="cursor:pointer;">Remove</u>
                    </td>
                </tr>`;

            $("#PaymentDetailsBody").append(newRow);

            let rowCount = $("#PaymentDetailsBody tr").length;

            if (rowCount === 1) {
                let totalPayable = parseFloat($("#totalPayable").val()) || 0;
                if (totalPayable > 0) {
                    $("#PaymentDetailsBody tr:last .paymentAmount")
                        .val(totalPayable.toFixed(2));
                }
            } else {
                let balance = parseFloat($("#balance").val()) || 0;
                if (balance > 0) {
                    $("#PaymentDetailsBody tr:last .paymentAmount")
                        .val(balance.toFixed(2));
                } else {
                    $("#PaymentDetailsBody tr:last .paymentAmount").val("0");
                }
            }

            subrowIndex++;
            calculateTotalPaid();
        }

        function getPaymentOptions() {
            return `@foreach (var item in ViewBag.PaymentMode)
        {
                        <option value="@item.Value">@item.Text</option>
        }
    `;
        }

        function calculateTotalPaid() {
            let totalPaid = 0;
            $(".paymentAmount").each(function () {
                let val = parseFloat($(this).val()) || 0;
                totalPaid += val;
            });

            $("#paidAmout").val(totalPaid.toFixed(2));
            calculateTotalPaymentSummary();
        }

        function calculateTotalPaymentSummary() {
            let returnAmt = 0;
            let balance = 0;
            var totalPayable = parseFloat($("#totalPayable").val()) || 0;
            var paidAmt = parseFloat($("#paidAmout").val()) || 0;

            // Subtract loyalty points discount from the payable amount for cash/card calculation
            var redeemPoints = parseInt($("#RedeemPoints").val()) || 0;
            var valInRs = loyaltyInfo ? loyaltyInfo.pointValueInRs : 0;
            var pointsValue = redeemPoints * valInRs;
            var netPayable = Math.max(0, totalPayable - pointsValue);

            if (pointsValue > 0) {
                $("#loyaltyPointsDiscountInput").val(pointsValue.toFixed(2));
                $("#netPayableInput").val(netPayable.toFixed(2));
                $("#loyaltyPointsDiscountLabel").text(`Points Discount (${redeemPoints} pts)`);
                $("#loyaltyDiscountRow").show();
                $("#netPayableRow").show();
                $("#loyaltySummaryContainer").show();
            } else {
                $("#loyaltyPointsDiscountInput").val("0.00");
                $("#netPayableInput").val("0.00");
                $("#loyaltyPointsDiscountLabel").text("Points Discount");
                $("#loyaltyDiscountRow").hide();
                $("#netPayableRow").hide();
                $("#loyaltySummaryContainer").hide();
            }

            if (paidAmt > netPayable && paidAmt > 0) {
                returnAmt = paidAmt - netPayable;
                balance = 0;
            } else {
                balance = netPayable - paidAmt;
            }

            $("#returnAmount").val(returnAmt.toFixed(2));
            $("#balance").val(balance.toFixed(2));
            $("#returnAmountDisplay").text(returnAmt.toFixed(2));
        }

        function togglePaymentAddButton() {
            if ($("#PaymentDetailsBody tr").length > 0) {
                $("#addPaymentRow").hide();
            } else {
                $("#addPaymentRow").show();
            }
        }
    </script>

