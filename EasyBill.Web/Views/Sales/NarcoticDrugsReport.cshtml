@model IEnumerable<EasyBill.Models.ViewModels.SalesVM>

@{
    ViewData["Title"] = "Narcotic Drugs Report";
}

<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    .action-btn {
        padding: 4px 8px;
        font-size: 12px;
    }
</style>

<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2 d-flex align-items-center justify-content-between"
         style="background:#2b6ac9">
        <span class="fw-bold">Narcotic Drugs Report</span>
    </div>
</div>

<!-- Filter -->
<div class="card shadow-sm p-3 mb-4">
    <form method="get" asp-action="NarcoticDrugsReport">
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="fw-bold">From Date</label>
                <input type="text" name="fromDate"
                       value="@ViewBag.FromDate"
                       class="form-control form-control-sm datepicker" placeholder="dd-mm-yyyy" />
            </div>
            <div class="col-md-2">
                <label class="fw-bold">To Date</label>
                <input type="text" name="toDate"
                       value="@ViewBag.ToDate"
                       class="form-control form-control-sm datepicker" placeholder="dd-mm-yyyy" />
            </div>
            <div class="col-md-2">
                <button type="submit"
                        class="btn btn-sm w-100 text-white"
                        style="background:#2b6ac9">
                    Search
                </button>
            </div>
        </div>
    </form>
</div>
<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="ExportNarcoticDrugsExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>

        <a asp-action="ExportNarcoticDrugsPdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>

    </div>
</div>
<!-- Report Table -->
<div class="card shadow-sm p-3">
    <div class="table-responsive">
        <table id="collectionTable" class="table table-bordered table-striped table-sm">
            <thead>
                <tr>
                    <th style="width: 50px;">Sr</th>
                    <th>Bill No</th>
                    <th>Date</th>
                    <th>Patient</th>
                    <th>Medicine</th>
                    <th>Type</th>
                    <th class="text-end">Qty</th>
                    <th>Batch</th>
                    <th>Mfg</th>
                    <th>Expiry</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td></td>
                            <td>@item.BillNo</td>
                            <td>@item.BillDate?.ToString("dd-MM-yyyy")</td>
                            <td>@item.CustomerName</td>
                            <td>@item.ItemName</td>
                            <td>@item.Type</td>
                            <td class="text-end">@item.Qty</td>
                            <td>@item.Batch</td>
                            <td>@item.Mfg</td>
                            <td>@item.ExpiryDate?.ToString("dd-MM-yyyy")</td>
                            <td class="text-center">
                                <a href="@Url.Action("PrintNarcoticForm", "Sales", new { billNo = item.BillNo })"
                                   target="_blank"
                                   class="btn btn-sm btn-primary action-btn">
                                    🖨️
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot class="table-secondary fw-bold">
                <tr>
                    <td colspan="6" class="text-end">TOTAL QTY</td>
                    <td class="text-end">@ViewBag.TotalQty</td>
                    <td colspan="4"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var t = $("#collectionTable").DataTable({
        "order": [[2, "desc"]],
            "columnDefs": [
                { "orderable": false, "targets": "_all" }
            ],
            pageLength: 25,
                language: {
                    emptyTable: "No data available in table"
                }
            });

            t.on('order.dt search.dt', function () {
                t.column(0, { search: 'applied', order: 'applied' }).nodes()
                    .each(function (cell, i) {
                        cell.innerHTML = i + 1;
                    });
            }).draw();

            $(".datepicker").datepicker({
                dateFormat: "dd-mm-yy",
                changeMonth: true,
                changeYear: true
            });
        });
    </script>
}
