@* @using EasyBill.Models.ViewModels
@model IEnumerable<StockVM>
@{
    var companies = ViewBag.companydata as List<Company>; // adjust according to your model
    int? selectedCompanyId = ViewBag.SelectedCompanyId as int?;
}
<h3 class="mb-4">Sales Report - Company Wise</h3>


<form method="get" asp-action="SalseReportCompanywise" class="card p-3 mb-3">
    <div class="row">

        <div class="col-md-3">
            <label>Date From</label>
            <input type="date" name="fromDate" class="form-control"
                   value="@ViewBag.FromDate" />
        </div>

        <div class="col-md-3">
            <label>Date To</label>
            <input type="date" name="toDate" class="form-control"
                   value="@ViewBag.ToDate" />
        </div>

        <div class="col-md-3">
            <label>Company</label>
            <select name="companyId" class="form-select w-auto d-inline" onchange="this.form.submit()">
                <option value="">-- All Companies --</option>
                @foreach (var company in companies)
                {
                    <option value="@company.Id" selected="@(selectedCompanyId == company.Id ? "selected" : null)">
                        @company.Name
                    </option>
                }
            </select>

        </div>

        <div class="col-md-3">
            <label>Division</label>
            <select name="divisionId" class="form-control"
                    asp-items="@(ViewBag.DivisionList as SelectList)">
                <option value="">All</option>
            </select>
        </div>

        <div class="col-md-12 text-end mt-3">
            <button type="submit" class="btn btn-primary">
                Search
            </button>
        </div>
    </div>
</form>

<form method="get" asp-action="SalseReportCompanywise" asp-controller="Sales">
    <div class="row align-items-center mb-3">
        <div class="col-md-6">
            <h5 class="mb-0">Filter by Company:</h5>
        </div>
        <div class="col-md-6 text-end">
            <select name="companyId" class="form-select w-auto d-inline" onchange="this.form.submit()">
                <option value="">-- All Companies --</option>
                @foreach (var company in companies)
                {
                    <option value="@company.Id" selected="@(selectedCompanyId == company.Id ? "selected" : null)">
                        @company.Name
                    </option>
                }
            </select>
        </div>
    </div>
</form>

<table class="table table-bordered table-sm">
    <thead class="table-light">
        <tr> 
            <th>Item Code</th>
            <th>Item Name</th>
            <th>Category</th>
            <th>Total Qty</th>
            <th>Gst Amount</th>
            <th>Total Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr> 
                <td>@item.ItemCode</td>
                <td>@item.ItemName</td>
                <td>@item.CategoryName</td>
                <td>@item.Stocks</td>
                <td>@item.GstAmount?.ToString("F2")</td>
                <td>@item.Amount</td>
            </tr>
        }
    </tbody>
</table>

