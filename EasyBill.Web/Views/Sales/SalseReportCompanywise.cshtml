@model List<EasyBill.Models.ViewModels.CompanyWiseCustomerMonthVM>
@{
    ViewBag.Title = "Company Wise Customer Report";
}
<style>
    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>
<div class="card shadow-sm mb-3">
    <div class="card-header text-white py-2" style="background: #2b6ac9;">
       Company Wise Customer Sales (Month-wise)
    </div>
</div>

<!-- 🔹 FILTER HEADER -->
<form method="get" class="card p-3 mb-3 shadow-sm">
    <div class="row g-3">

        <div class="col-md-2">
            <label class="fw-bold">Date From</label>
            <input type="date" name="fromDate" class="form-control"
                   value="@ViewBag.FromDate" />
        </div>

        <div class="col-md-2">
            <label class="fw-bold">Date To</label>
            <input type="date" name="toDate" class="form-control"
                   value="@ViewBag.ToDate" />
        </div>

        <div class="col-md-2">
            <label class="fw-bold">Company</label>
            <select name="companyId" class="form-select"
                    asp-items="ViewBag.CompanyList">
                <option value="">All Companies</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="fw-bold">Division</label>
            <select name="divisionId" class="form-select"
                    asp-items="ViewBag.DivisionList">
                <option value="">All Divisions</option>
            </select>
        </div>

        <div class="col-md-2 text-end">
            <button type="submit" class="btn mt-3 text-light" style="background: #2b6ac9;">
                 Search
            </button>
        </div>

    </div>
</form>

<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="ExportSalseReportCompanywise"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           asp-route-companyId="@Context.Request.Query["companyId"]"
           asp-route-divisionId="@Context.Request.Query["divisionId"]">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>
        <a asp-action="ExportSalseReportCompanywisePdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           asp-route-companyId="@Context.Request.Query["companyId"]"
           asp-route-divisionId="@Context.Request.Query["divisionId"]">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>
<!-- 🔹 REPORT TABLE -->
<div class="table-responsive shadow-sm">
    <table class="table table-bordered table-striped">
        <thead class="table-primary">
            <tr>
                <th>Customer Name</th>
                <th>Jan</th>
                <th>Feb</th>
                <th>Mar</th>
                <th>Apr</th>
                <th>May</th>
                <th>Jun</th>
                <th>Jul</th>
                <th>Aug</th>
                <th>Sep</th>
                <th>Oct</th>
                <th>Nov</th>
                <th>Dec</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                foreach (var row in Model)
                {
                    <tr>
                        <td class="fw-bold">@row.CustomerName</td>

                        @for (int m = 1; m <= 12; m++)
                        {
                            <td class="text-end">
                                @(row.MonthAmounts.ContainsKey(m)
                                                    ? row.MonthAmounts[m].ToString("0.00")
                                                    : "-")
                </td>
                                }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="13" class="text-center text-danger">
                        No data found
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
