@using EasyBill.Models.ViewModels
@using EasyBill.UI.Controllers
@using static EasyBill.UI.Controllers.SalesController
@model object

<h3> GSTR1 Report</h3>
<style>
    .row-active td {
        background-color: #198754 !important;
        color: #fff !important;
    }
</style>
<div class="card mb-3 shadow-sm">
    <!-- Header -->
    <div class="card-header bg-light fw-semibold">
        <i class="bi bi-funnel-fill text-primary me-1"></i>
        Sales Filters
    </div>

    <!-- Body -->
    <div class="card-body">
        <form id="salesFilterForm" method="get">
            <div class="row g-3">

                <!-- Start Date -->
                <div class="col-md-3">
                    <div class="row align-items-center">
                        <label class="col-5 col-form-label fw-semibold text-end">
                            Start Date
                        </label>
                        <div class="col-7">
                            <input type="date"
                                   name="StartBillDate"
                                   value="@(Context.Request.Query["StartBillDate"].Any()
                                                   ? Context.Request.Query["StartBillDate"].ToString()
                                                   : ViewBag.StartBillDate)"
                                   class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>

                <!-- End Date -->
                <div class="col-md-3">
                    <div class="row align-items-center">
                        <label class="col-5 col-form-label fw-semibold text-end">
                            End Date
                        </label>
                        <div class="col-7">
                            <input type="date"
                                   name="EndBillDate"
                                   value="@(Context.Request.Query["EndBillDate"].Any()
                                                   ? Context.Request.Query["EndBillDate"].ToString()
                                                   : ViewBag.EndBillDate)"
                                   class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="col-md-3 d-flex align-items-center justify-content-left">
                    <button type="submit" class="btn btn-sm btn-primary me-1">
                        Search
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-secondary"
                            onclick="clearFilters()">
                        Clear
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>


@{
    var summaryTemplate = new List<(string Key, string Text)>
    {
        (SalesController.Gstr1SummaryKeys.B2B, "B2B"),
        (SalesController.Gstr1SummaryKeys.B2C_LARGE, "B2C (Large) Invoice"),
        (SalesController.Gstr1SummaryKeys.B2C_SMALL, "B2C (Small) Invoice"),
        (SalesController.Gstr1SummaryKeys.NIL, "Nil Rated/Exempted"),
        (SalesController.Gstr1SummaryKeys.NIL_RATED, " - Nil Rated"),
        (SalesController.Gstr1SummaryKeys.EXEMPTED, " - Exempted"),
        (SalesController.Gstr1SummaryKeys.EXPORT, "Export Invoices"),
        (SalesController.Gstr1SummaryKeys.ADVANCE, "Tax Liability on Advance"),
        (SalesController.Gstr1SummaryKeys.TOTAL, "Total")
    };

    var data = Model != null
        ? ((IEnumerable<Gstr1SummaryVM>)Model)
            .ToDictionary(x => x.Key)
        : new Dictionary<string, Gstr1SummaryVM>();
}

@if ((string)ViewBag.ViewType == "Summary")
{
    <table class="table table-bordered table-sm">
        <thead class="table-light text-center">
            <tr>
                <th>Description</th>
                <th>Count</th>
                <th>Taxable</th>
                <th>SGST</th>
                <th>CGST</th>
                <th>IGST</th>
                <th>Cess</th>
                <th>Total GST</th>
                <th>Invoice Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in summaryTemplate)
            {
                var d = data.ContainsKey(row.Key) ? data[row.Key] : null;

                <tr class="summary-row @(row.Key == Gstr1SummaryKeys.TOTAL ? "fw-bold table-warning" : "")"
                    data-key="@row.Key"
                    style="cursor:pointer">
                    <td>@row.Text</td>
                    <td class="text-end">@((d?.Count) ?? 0)</td>
                    <td class="text-end">@((d?.Taxable ?? 0).ToString("F2"))</td>
                    <td class="text-end">@((d?.SGST ?? 0).ToString("F2"))</td>
                    <td class="text-end">@((d?.CGST ?? 0).ToString("F2"))</td>
                    <td class="text-end">@((d?.IGST ?? 0).ToString("F2"))</td>
                    <td class="text-end">@((d?.Cess ?? 0).ToString("F2"))</td>
                    <td class="text-end">@((d?.TotalGST ?? 0).ToString("F2"))</td>
                    <td class="text-end">@((d?.InvoiceAmount ?? 0).ToString("F2"))</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="d-flex gap-2 mt-2">
        <button type="button"
                class="btn btn-sm btn-outline-secondary"
                onclick="openViewTypeModal('view')">
            View
        </button>

        <button type="button"
                class="btn btn-sm btn-outline-secondary"
                onclick="openViewTypeModal('print')">
            Print
        </button>

        <button type="button"
                class="btn btn-sm btn-outline-secondary"
                onclick="openViewTypeModal('excel')">
            Excel
        </button>
    </div>
}
<div class="modal fade" id="billDetailModal">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Bill Details</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <!-- Bills table -->
                <h6>Bills</h6>
                <table class="table table-bordered table-sm" id="billTable">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Invoice Category</th>
                            <th> Bill Date</th>
                            <th>Bill No</th> 
                            <th>Bill Amount</th>
                            <th>Taxable Amount</th>
                            <th>Tax Amount</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

                <hr />

                <!-- Items table -->
                <h6>Items</h6>
                <table class="table table-bordered table-sm" id="itemTable">
                    <thead>
                        <tr>
                            <th>HSN/SAC Code</th> 
                            <th>Amount</th>
                            <th>Taxable Amt</th>
                            <th>SGST %</th>
                            <th>SGST Tax</th>
                            <th>CGST %</th>
                            <th>CGST Tax</th>
                            <th>IGST %</th>
                            <th>IGST Tax</th>
                            <th>Cess</th>
                            <th>Total Tax</th>
                            <th>Tax Type</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="viewTypeModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">Select View Type</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <button class="btn btn-sm btn-outline-primary w-100 mb-2"
                        onclick="applyViewType('Summary')">
                    Summary
                </button>

                <button class="btn btn-sm btn-outline-primary w-100"
                        onclick="applyViewType('Details')">
                    Details
                </button>
            </div>
        </div>
    </div>
</div>



<script>
    function exportExcel() {
        const params = new URLSearchParams(window.location.search);
        window.location.href = '/Sales/ExportGSTR1Excel?' + params.toString();
    }

    function exportCsv() {
        const params = new URLSearchParams(window.location.search);
        window.location.href = '/Sales/ExportGSTR1Csv?' + params.toString();
    }
</script>
<script>
    function clearFilters() {
        window.location.href = window.location.pathname;
    }
</script>

<script>
    
    let selectedAction = '';

    function openViewTypeModal(action) {
        selectedAction = action;
        var modal = new bootstrap.Modal(document.getElementById('viewTypeModal'));
        modal.show();
    }

    function applyViewType(viewType) {
        const params = new URLSearchParams(window.location.search);
        params.set('ViewType', viewType);

        if (selectedAction === 'excel') {
            window.location.href = '/Sales/ExportGSTR1Excel?' + params.toString();
        }
        else if (selectedAction === 'print') {
            window.location.search = params.toString();
            setTimeout(() => window.print(), 300);
        }
        else {
            // view
            window.location.search = params.toString();
        }
    }

    $(document).on("click", ".summary-row", function () {

        var key = $(this).data("key");

        const params = new URLSearchParams(window.location.search);
        params.set("type", key);

        fetch("/Sales/GetGstr1Bills?" + params.toString())
            .then(res => res.json())
            .then(data => {

                let rows = "";

                data.forEach(b => {

                    rows += `<tr class="bill-row" data-id="${b.id}">
                                <td>${b.customer}</td>
                                <td>${b.invoicecategory}</td>
                                <td>${b.billDate}</td>
                                <td>${b.billNo}</td> 
                                <td>${b.invoiceAmount}</td>
                                <td>${b.taxable}</td>
                                <td>${b.gst}</td>
                             </tr>`;
                });

                $("#billTable tbody").html(rows);

                $("#itemTable tbody").html("");

                billIndex = 0;
                highlightBillRow();

                var modal = new bootstrap.Modal(document.getElementById("billDetailModal"));
                modal.show();
            });

    });

