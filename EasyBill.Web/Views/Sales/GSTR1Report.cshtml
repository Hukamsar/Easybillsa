        $(document).on("click", ".bill-row", function () {
        $(".bill-row").removeClass("row-active");

        $(this).addClass("row-active");

        billIndex = $(this).index();

        var id = $(this).data("id");
        loadBillItems(id);
    });
    function loadBillItems(id) {

        fetch("/Sales/GetBillItems?id=" + id)
            .then(res => res.json())
            .then(items => {

                let rows = "";

                items.forEach(i => {

                    rows += `<tr>
                                <td>${i.hsn}</td>
                                <td>${i.amount.toFixed(2)}</td>
                                <td>${i.taxable.toFixed(2)}</td>

                                <td>${i.sgstPer}</td>
                                <td>${i.sgstTax.toFixed(2)}</td>

                                <td>${i.cgstPer}</td>
                                <td>${i.cgstTax.toFixed(2)}</td>

                                <td>${i.igstPer}</td>
                                <td>${i.igstTax.toFixed(2)}</td>

                                <td>${i.cess}</td>

                                <td>${i.totalTax.toFixed(2)}</td>

                                <td>${i.taxType}</td>
                             </tr>`;
                });

                $("#itemTable tbody").html(rows);
            });
    }
    let summaryIndex = 0;

    function highlightSummaryRow() {

        let rows = $(".summary-row");

        rows.removeClass("row-active");

        if (rows.length > 0) {
            $(rows[summaryIndex]).addClass("row-active");
        }
    }

    $(document).ready(function () {
        summaryIndex = 0;
        highlightSummaryRow();
    });

    $(document).on("keydown", function (e) {

        let rows = $(".summary-row");

        if (rows.length === 0) return;

        if ($("#billDetailModal").hasClass("show"))
            return;

        if (e.key === "ArrowDown") {

            if (summaryIndex < rows.length - 1)
                summaryIndex++;

            highlightSummaryRow();
            e.preventDefault();
        }

        if (e.key === "ArrowUp") {

            if (summaryIndex > 0)
                summaryIndex--;

            highlightSummaryRow();
            e.preventDefault();
        }

        if (e.key === "Enter") {
            $(rows[summaryIndex]).trigger("click");
        }

    });


        let billIndex = 0;

      function highlightBillRow(){

        let rows = $("#billTable tbody tr");

        rows.removeClass("row-active");

        if(rows.length > 0){

            let row = $(rows[billIndex]);

            row.addClass("row-active");

            // auto load items
            let id = row.data("id");
            loadBillItems(id);
        }
    }

    $(document).keydown(function(e){

        if(!$("#billDetailModal").hasClass("show"))
            return;

        let rows = $("#billTable tbody tr");

        if(rows.length == 0) return;

        if(e.key === "ArrowDown"){

            if(billIndex < rows.length-1)
                billIndex++;

            highlightBillRow();
            e.preventDefault();
        }

        if(e.key === "ArrowUp"){

            if(billIndex > 0)
                billIndex--;

            highlightBillRow();
            e.preventDefault();
        }

        if(e.key === "Enter"){

            $(rows[billIndex]).click();
        }

    });
       $('#billDetailModal').on('hidden.bs.modal', function () {

        billIndex = 0;
        highlightSummaryRow();

    });
</script>