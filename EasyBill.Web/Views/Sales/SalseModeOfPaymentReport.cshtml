@using EasyBill.Models.ViewModels
@model List<SalsePaymentDetailsVM>
<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }
</style>

<div class="card mb-3">
    <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
        Sales Report - Mode of Payment Wise
    </div>
</div>

<form method="get" class="card p-3 mb-3">
    <div class="row">

        <div class="col-md-2">
            <label>Date From</label>
            <input type="date"
                   id="fromDate"
                   name="fromDate"
                   class="form-control"
                   value="@ViewBag.FromDate" />
        </div>

        <div class="col-md-2">
            <label>Date To</label>
            <input type="date"
                   id="toDate"
                   name="toDate"
                   class="form-control"
                   value="@ViewBag.ToDate" />
        </div>

        <div class="col-md-2 text-end mt-3">
            <button type="submit" class="btn text-light" style="background: #2b6ac9;">
                Search
            </button>
        </div>
    </div>
</form>

<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="ExportSalseModeOfPaymentExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>

        <a asp-action="ExportSalseModeOfPaymentPdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>

<table id="ModeOfPaymentsTbl" class="table table-bordered table-striped">
    <thead class="custom-header">
        <tr>
            <th>Payment Mode</th>
            <th>Total Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PaymentModeName</td>
                <td>@item.Amount.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#ModeOfPaymentsTbl").DataTable({
                ordering: false
                  });
        });
    </script>
}
