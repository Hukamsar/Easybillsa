@model IEnumerable<EasyBill.Models.ViewModels.SalesVM>

@{
    ViewData["Title"] = "Fast Moving Items";
    decimal totalQty = Model?.Sum(x => x.TotalQty) ?? 0;
    decimal totalAmount = Model?.Sum(x => x.TotalAmount) ?? 0;
}
<style>
    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>

<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2 d-flex align-items-center"
         style="background:#2b6ac9">

        <span class="fw-bold">
            Fast Moving Items
        </span>
        <span class="ms-auto">
            Total Qty:
            <span class="fw-bold">@totalQty.ToString("0.00")</span> |

            Total Amount:
            <span class="fw-bold">₹ @totalAmount.ToString("0.00")</span>
        </span>
    </div>
</div>

<!-- Filter Section -->
<div class="card shadow-sm p-3 mb-4">
    <form method="get" asp-action="FastMovingItems">
        <div class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="form-label fw-bold">From Date</label>
                <input type="text"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="form-control form-control-sm datepicker"
                       placeholder="dd-MM-yyyy" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">To Date</label>
                <input type="text"
                       name="toDate"
                       value="@ViewBag.FromDate"
                       class="form-control form-control-sm datepicker"
                       placeholder="dd-MM-yyyy" />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-sm w-100 text-white"
                        style="background-color: #2b6ac9 !important;">
                    Apply
                </button>
            </div>

        </div>
    </form>
</div>

<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="FastMovingItemsExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>
        <a asp-action="FastMovingItemsPdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>


<!-- Data Section -->
<div class="card shadow-sm p-3">
    <div class="table-responsive">
        <table id="fastMovingTable" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Sr No</th>
                    <th>Item Name</th>
                    <th class="text-end">Total Qty</th>
                    <th class="text-end">Total Amount</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td></td>
                            <td>@item.ItemName</td>

                            <!-- ✅ Qty Fix (decimal + fallback) -->
                            <td class="text-end">
                                @(item.TotalQty != null
                                                        ? item.TotalQty.ToString("0.00")
                                                        : item.QtyDisplay)
                                                                      </td>

                            <td class="text-end">
                                @(item.TotalAmount != null
                                                        ? item.TotalAmount.Value.ToString("0.00")
                                                        : "0.00")
                    </td>
                </tr>
                                }
                }
            </tbody>

            <tfoot class="table-secondary fw-bold">
                <tr>
                    <td></td>
                    <td class="text-end">TOTAL</td>

                    <!-- ✅ Total Qty Fix -->
                    <td class="text-end">
                        @(ViewBag.TotalQty != null
                                                ? Convert.ToDecimal(ViewBag.TotalQty).ToString("0.00")
                                                : "0.00")
                    </td>

                    <!-- ✅ Total Amount Fix -->
                    <td class="text-end">
                        @(ViewBag.TotalAmt != null
                                                ? Convert.ToDecimal(ViewBag.TotalAmt).ToString("0.00")
                                                : "0.00")
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {

            var t = $("#fastMovingTable").DataTable({
                ordering: false
            });

            // Auto Sr No
            t.on('order.dt search.dt', function () {
                t.column(0, { search: 'applied', order: 'applied' }).nodes()
                    .each(function (cell, i) {
                        cell.innerHTML = i + 1;
                    });
            }).draw();

            // Datepicker
            $(".datepicker").datepicker({
                dateFormat: "dd-mm-yy",
                changeMonth: true,
                changeYear: true
            });

        });
    </script>
}

<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }
</style>
