@model IEnumerable<Stock>

@{
    ViewData["Title"] = "Index";
}
 
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ItemCode)
            </th>
            <th>
                Item Name
            </th>
            <th>
                Category
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.Stocks)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Unit1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Unit2)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
           
            <td>
                @Html.DisplayFor(modelItem => item.ItemCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ItemMaster.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.CategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Stocks)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Unit1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Unit2)
            </td> 
        </tr>
}
    </tbody>
</table>
