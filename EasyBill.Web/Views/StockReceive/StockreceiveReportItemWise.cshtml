@using EasyBill.Models.ViewModels
@model IEnumerable<StockVM>
<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>

<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2 d-flex align-items-center" style="background: #2b6ac9;">
        Stock Receive Report - Bill Wise
        <span class="ms-auto">
            Total Qty: <span class="fw-bold">@ViewBag.TotalQty</span> |
            Total GstAmt: <span class="fw-bold">@ViewBag.GstAmount.ToString("0.00")</span> |
            Total Amt: <span class="fw-bold">@ViewBag.TotalAmount</span>
        </span>
    </div>
</div>
<form method="get" class="card p-3 mb-3">
    <div class="row align-items-end">
        <div class="col-md-2">
            <label for="fromDate">Date From</label>
            <input type="date"
                   id="fromDate"
                   name="fromDate"
                   class="form-control"
                   value="@ViewBag.FromDate" />
        </div>

        <div class="col-md-2">
            <label for="toDate">Date To</label>
            <input type="date"
                   id="toDate"
                   name="toDate"
                   class="form-control"
                   value="@ViewBag.ToDate" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn w-100 text-light" style="background: #2b6ac9;">
                <i class="bi bi-search"></i> Search
            </button>
        </div>

    </div>
</form>

<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="ExportStockReceiveItemWiseExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>
        <a asp-action="ExportStockReceiveItemWisePdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>

<table id="stockReceiveTbl" class="table table-bordered table-sm">
    <thead class="table-primary">
        <tr>
            <th>Item Code</th>
            <th>Item Name</th>
            <th>Category</th>
            <th>Total Qty</th>
            <th>Gst Amount</th>
            <th>Total Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ItemCode</td>
                <td>@item.ItemName</td>
                <td>@item.CategoryName</td>
                <td>@item.Stocks</td>
                <td>@item.GstAmount?.ToString("0.00")</td>
                <td>@item.Amount</td>
            </tr>
        }
    </tbody>
    <tfoot class="table-secondary fw-bold">
        <tr>
            <td></td>
            <td></td>
            <td>TOTAL</td>
            <td>@ViewBag.TotalQty</td>
            <td>@ViewBag.GstAmount.ToString("0.00")</td>
            <td>@ViewBag.TotalAmount</td>
        </tr>
    </tfoot>
</table>
@section Scripts {
    <script>
        $(document).ready(function () {
            $("#stockReceiveTbl").DataTable({
                ordering: false
                  });
        });

    </script>
}
