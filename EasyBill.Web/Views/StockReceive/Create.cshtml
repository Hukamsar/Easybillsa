                $("[name='TotalCGstAmt']").val(totalCgst.toFixed(2));

                $("[name='TotalSGstAmt']").val(totalSgst.toFixed(2));
                $("[name='TotalSCGstAmt']").val(totalscgst.toFixed(2));

                $("[name='TotalGstAmt']").val(0);

            }
            else {

                $("[name='TotalGstAmt']").val(totalGst.toFixed(2));

                $("[name='TotalCGstAmt']").val(0);

                $("[name='TotalSGstAmt']").val(0);
                $("[name='TotalSCGstAmt']").val(0);

            }


            $("[name='TotalPayable']").val(roundedPayable);
    $("[name='TotalCessAmount']").val(totalcess.toFixed(2));
            $("[name='RoundOffAmount']").val(roundOffAmount);
            calculateTotalPaymentSummary();

        }
