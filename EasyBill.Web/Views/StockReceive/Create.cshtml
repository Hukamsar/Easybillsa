@using EasyBill.Models.ViewModels
@model EasyBill.Models.ViewModels.StockReceiveVM
@{
    var isEdit = ViewData["IsEdit"] as bool? ?? false;
    var formAction = isEdit ? "Edit" : "Create";
    var existingStockReceiveItemsJson = System.Text.Json.JsonSerializer.Serialize(Model?.StockReceiveItemVMs ?? Array.Empty<StockReceiveItemVM>());
    var existingPaymentDetailsJson = System.Text.Json.JsonSerializer.Serialize(Model?.PaymentDetails ?? Array.Empty<SalsePaymentDetailsVM>());
    ViewData["Title"] = isEdit ? "Edit Stock Receive" : "Create Stock Receive";
}
<link href="~/css/page.css" rel="stylesheet" />
<style>
    /* ===============================
                BATCH MODAL
                =============================== */
    .batch-row.selected td {
        background-color: #d4af37 !important; /* GOLD */
        color: #000 !important;
        font-weight: 500;
    }

    /* ===============================
                    BATCH MODAL HEADER
                =============================== */
    #batchModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #batchModal .modal-header .btn-close {
            filter: invert(1);
        }
    /* ===============================
                   BATCH MODAL – ROW SELECTION (ITEM MODAL LIKE)
                   =============================== */

    /* Selected row */
    .batch-row.selected td {
        background-color: #d4af37 !important; /* GOLD */
        color: #000 !important;
        font-weight: 500;
    }

    /* ❌ Keyboard navigation active → hover disabled */
    #batchModal.keyboard-nav .batch-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* 🖱️ Mouse navigation active → hover enabled */
    #batchModal.mouse-nav .batch-row:hover td {
        background-color: #f1d27a !important; /* LIGHT GOLD */
        color: #000 !important;
        cursor: pointer;
    }

    /*BATCH MODAL – SCROLL SUPPORT*/
    .batch-table-wrapper {
        max-height: 350px; /* same feel as item modal */
        overflow-y: auto;
        position: relative;
    }

    #batchTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7; /* same blue */
        color: #fff;
        font-weight: 700;
        z-index: 2;
    }


    /* ===============================
                   BATCH MODAL HEADER
                =============================== */
    #addSupplierModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }
</style>

<style>
    /* ===============================
                   ITEM MODAL – ROW SELECTION
                   =============================== */

    /* Selected row (keyboard / click) */
    .item-row.selected td {
        background-color: #d4af37 !important; /* GOLD */
        color: #000 !important;
        font-weight: 500;
    }

    /* ❌ Keyboard navigation active → hover disabled */
    #itemModal.keyboard-nav .item-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* 🖱️ Mouse navigation active → hover enabled */
    #itemModal.mouse-nav .item-row:hover td {
        background-color: #f1d27a !important; /* LIGHT GOLD */
        color: #000 !important;
        cursor: pointer;
    }

    /* Remove focus outline */
    .item-row:focus {
        outline: none;
    }

    /* Sticky header height ke barabar gap */
    .item-row {
        scroll-margin-top: 50px;
    }

    /* Sticky header */
    #itemTable thead th {
        position: sticky;
        top: 0;
        background: #fff;
        z-index: 2;
    }

    /* ===============================
                                   ITEM MODAL HEADER
                                   =============================== */
    #itemModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #itemModal .modal-header .btn-close {
            filter: invert(1);
        }

    /* ===============================
                                   ITEM MODAL TABLE HEADER
                                   =============================== */
    #itemTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700; /* BOLD */
        position: sticky;
        top: 0;
        z-index: 2;
    }
</style>

<style>
    /* ===============================
                                   ITEM DETAILS MODAL HEADER
                                   =============================== */
    #itemDetailModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #itemDetailModal .modal-header .btn-close {
            filter: invert(1);
        }
</style>

<style>
    /* ===============================
                       SUPPLIER MODAL STYLING
                       =============================== */

    /* Modal Header */
    #supplierModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #supplierModal .modal-header .btn-close {
            filter: invert(1);
        }

    /* Table Header */
    #supplierTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* Selected Row */
    .supplier-row.selected td {
        background-color: #d4af37 !important; /* GOLD */
        color: #000 !important;
        font-weight: 500;
    }

    /* Keyboard Navigation - Hover Disabled */
    #supplierModal.keyboard-nav .supplier-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* Mouse Navigation - Hover Enabled */
    #supplierModal.mouse-nav .supplier-row:hover td {
        background-color: #f1d27a !important; /* LIGHT GOLD */
        color: #000 !important;
        cursor: pointer;
    }

    /* Sticky Header Scroll Support */
    .supplier-row {
        scroll-margin-top: 50px;
    }

        .supplier-row:focus {
            outline: none;
        }

    .po-row.selected td {
        background-color: #d4af37 !important; /* GOLD */
        color: #000 !important;
        font-weight: 500;
    }

    .challan-row.selected td {
        background-color: #d4af37 !important; /* GOLD */
        color: #000 !important;
        font-weight: 500;
    }

    .challan-row.marked td {
        background-color: #d9f3df !important;
        color: #000 !important;
        font-weight: 500;
    }

    .challan-row.selected.marked td {
        background-color: #d4af37 !important;
        box-shadow: inset 0 0 0 2px #198754;
    }

    #poModal .modal-header,
    #challanModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

    #poModal thead th,
    #challanModal thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
    }
</style>

<style>
    /* ====================================
               PURCHASE HISTORY TABLE STYLING
               ==================================== */
    #itemExtraInfoWrapper {
        background: linear-gradient(to bottom, #f8fbff, #ffffff);
        border: 1.5px solid #b3d9ff !important;
        box-shadow: 0 1px 4px rgba(0, 123, 255, 0.08);
        max-height: 250px; /* ✅ Height limit */
        overflow-y: auto; /* ✅ Scroll if needed */
    }

    .purchase-history-table {
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        border-radius: 6px;
        font-size: 11px; /* ✅ Small text */
    }

        .purchase-history-table thead tr {
            background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
            color: #ffffff;
            font-weight: 600;
            font-size: 10px; /* ✅ Compact header */
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .purchase-history-table thead th {
            border: none !important;
            padding: 6px 5px; /* ✅ Reduced from 12px */
            vertical-align: middle;
            white-space: nowrap;
            position: sticky; /* ✅ Sticky header */
            top: 0;
            z-index: 10;
        }

            .purchase-history-table thead th:first-child {
                border-top-left-radius: 6px;
            }

            .purchase-history-table thead th:last-child {
                border-top-right-radius: 6px;
            }

        .purchase-history-table tbody tr {
            border-bottom: 1px solid #d6ebff;
            transition: all 0.15s ease;
        }

            .purchase-history-table tbody tr:hover {
                background-color: #e3f2fd;
                transform: scale(1.005); /* ✅ Subtle hover */
            }

        .purchase-history-table tbody td {
            padding: 5px 5px; /* ✅ Reduced from 10px */
            font-size: 11px;
            border-left: 1px solid #d6ebff;
            border-right: 1px solid #d6ebff;
            vertical-align: middle;
            line-height: 1.3; /* ✅ Compact line height */
        }

            .purchase-history-table tbody td:first-child {
                border-left: none;
            }

            .purchase-history-table tbody td:last-child {
                border-right: none;
            }

        .purchase-history-table tbody tr:last-child td {
            border-bottom: none;
        }

        /* Alternating row colors */
        .purchase-history-table tbody tr:nth-child(even) {
            background-color: #f5f9ff;
        }

        .purchase-history-table tbody tr:nth-child(odd) {
            background-color: #ffffff;
        }

    /* Responsive scrolling */
    .table-responsive {
        border-radius: 6px;
        overflow-x: auto;
    }

    /* Custom scrollbar */
    #itemExtraInfoWrapper::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    #itemExtraInfoWrapper::-webkit-scrollbar-track {
        background: #f0f7ff;
        border-radius: 3px;
    }

    #itemExtraInfoWrapper::-webkit-scrollbar-thumb {
        background: #b3d9ff;
        border-radius: 3px;
    }

        #itemExtraInfoWrapper::-webkit-scrollbar-thumb:hover {
            background: #4a90e2;
        }

    /* Empty state */
    #itemExtraInfoBody:empty::after {
        content: "No purchase history available";
        display: block;
        text-align: center;
        padding: 20px;
        color: #6c757d;
        font-style: italic;
        font-size: 11px;
    }
</style>

<style>
    #refreshBtn:hover {
        opacity: 0.85;
        transform: rotate(90deg);
        transition: all 0.2s ease;
    }
</style>

<style>
    .custom-header th {
        background: linear-gradient(180deg, #eef3f8, #d8e3ef);
        color: #16202b;
        font-weight: 700;
        text-align: center;
        border-bottom: 0px solid #b6c6d6;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,0.05);
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">

        <div class="card mb-2 shadow-sm" style="border-radius: 6px; overflow: hidden;">
            <div class="card-header text-white d-flex align-items-center py-1 px-3"
                 style="background:#2b6ac9">

                <h6 class="mb-0 me-auto" style="font-size: 0.85rem;">
                    Stock Receive
                </h6>

                <button type="button"
                        id="refreshBtn"
                        class="btn btn-sm p-1 me-2 border-0 bg-transparent text-white"
                        title="Refresh">
                    <span class="fs-5">🔄</span>
                </button>

                @*                 <button type="button"
                        class="btn btn-sm btn-light"
                        id="settingsBtn"
                        style="font-size: 0.78rem; padding: 3px 10px;">
                    ⚙️ Settings
                </button> *@
            </div>
        </div>

        <div class="card-body">
            <form asp-action="@formAction" asp-controller="StockReceive" id="purchaseForm">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <input type="hidden" asp-for="TenanatGst" id="companygst" />
                <input type="hidden" asp-for="PurchaseOrderId" id="purchaseOrderId" />
                <input type="hidden" asp-for="SourcePurchaseChallanId" id="sourcePurchaseChallanId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Professional Document Type Selector -->
                <div class="row mb-3 pb-2 border-bottom align-items-center bg-light rounded p-2 mx-0">
                    <label class="col-md-2 col-form-label text-start small fw-bold text-primary text-uppercase" style="width: auto;">Document Type:</label>
                    <div class="col-md-10 d-flex align-items-center">
                        <div class="form-check form-check-inline mb-0">
                            <input class="form-check-input" type="radio" name="ReceiveFromType" id="receiveSupplier" value="Supplier" @(Model.ReceiveFromType == "Supplier" ? "checked" : "")>
                            <label class="form-check-label fw-bold" style="cursor: pointer;" for="receiveSupplier"><i class="bi bi-truck"></i> Standard Receive (Supplier)</label>
                        </div>
                        <div class="form-check form-check-inline mb-0 ms-4">
                            <input class="form-check-input" type="radio" name="ReceiveFromType" id="receiveBranch" value="Branch" @(Model.ReceiveFromType == "Branch" ? "checked" : "")>
                            <label class="form-check-label fw-bold" style="cursor: pointer;" for="receiveBranch"><i class="bi bi-shop"></i> In-Transit Receive (Branch)</label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious ">
                        <div class="col-md-5 ">
                            <label asp-for="ChallanNo"></label>
                        </div>
                        <div class="col-md-5 ">
                            <input asp-for="ChallanNo" id="BillNo" class="form-control form-control-sm" required />
                            <span asp-validation-for="ChallanNo" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious">
                        <div class="col-md-5 ">
                            <label asp-for="ChallanDate"></label>
                        </div>
                        <div class="col-md-5 ">
                            <input type="date" asp-for="ChallanDate" id="BillDate" class="form-control form-control-sm" />
                            <span asp-validation-for="ChallanDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious supplier-section">
                        <div class="col-md-5 ">
                            <label>Billing Type</label>
                        </div>
                        <div class="col-md-5 ">
                            <select asp-for="billingType" id="billingType" class="form-control form-control-sm">
                                <option value="walkin">Cash</option>
                                <option value="registered">Supplier</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- Branch Selection (Hidden by default) -->
                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious branch-section d-none">
                        <div class="col-md-4">
                            <label>Transfer From</label>
                        </div>
                        <div class="col-md-7">
                            <input type="hidden" asp-for="SourceStockIssueId" id="SourceStockIssueId" />
                            @if (Model.IsPendingTransfer)
                            {
                                <input type="text" class="form-control form-control-sm" value="@Model.TransferFromBranchName" readonly />
                                <input type="hidden" asp-for="TransferFromTenantId" id="TransferFromTenantIdHidden" />
                                <input type="hidden" asp-for="IsPendingTransfer" value="true" />
                            }
                            else
                            {
                                <select asp-for="TransferFromTenantId" class="form-control form-control-sm" asp-items="ViewBag.Branches">
                                    <option value="">-- Select Branch --</option>
                                </select>
                            }
                        </div>
                    </div>

                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious mb-1 supplier-section">
                        <div class="col-md-5">
                            <label asp-for="SupplierName"></label>
                        </div>
                        <div class="col-md-4">
                            <input type="hidden" asp-for="SupplierId" class="supplier-id" />
                            <input type="text"
                                   class="form-control form-control-sm supplier-input" id="supplier-input"
                                   value="@Model.SupplierName"
                                   placeholder="Press Enter to select supplier"
                                   autocomplete="off" />
                            <span asp-validation-for="SupplierId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-1">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
                                new
                            </button>
                        </div>
                    </div>

                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious ">
                        <div class="col-md-5 ">
                            <label asp-for="PartyBillNo"></label>
                        </div>
                        <div class="col-md-5">
                            <input asp-for="PartyBillNo" class="form-control form-control-sm" />
                            <span asp-validation-for="PartyBillNo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious ">
                        <div class="col-md-5 ">
                            <label asp-for="PartyBillDate"></label>
                        </div>
                        <div class="col-md-5">
                            <input type="date" asp-for="PartyBillDate" class="form-control form-control-sm" />
                            <span asp-validation-for="PartyBillDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious ">
                        <div class="col-md-5 ">
                            <label>Type</label>
                        </div>
                        <div class="col-md-5">
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="paymentToggle">
                                <label class="form-check-label fw-bold" id="paymentToggleLabel" style="color: green;">
                                    Cash
                                </label>
                            </div>

                            <input type="hidden" asp-for="PaymentType" id="paymentTypeHidden" value="cash" />
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious">
                        <div class="col-md-5 ">
                            <label>Purchase Type</label>
                        </div>
                        <div class="col-md-5 ">
                            <select id="purchasetype" class="form-control form-control-sm" disabled>
                                <option value="Local">Local</option>
                                <option value="Central">Central</option>
                            </select>
                            <input type="hidden" asp-for="PurchaseType" id="purchasetypeHidden" />
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious">
                        <div class="col-md-5 ">
                            <label for="TaxCalculation">Calculate Tax?</label>
                        </div>
                        <div class="col-md-5 ">
                            <select asp-for="TaxCalculation" id="TaxCalculation" class="form-control form-control-sm">
                                <option value="Yes">Yes</option>
                                <option value="No">No</option>
                            </select>
                        </div>
                    </div>

                </div>

                <div style="overflow-x: auto; width: 100%;">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead class="table custom-header">
                                <tr>
                                    <th style="min-width:30%">Item</th>
                                    <th style="min-width:30%">Batch</th>
                                    <th hidden class="text-center">Expiry</th>
                                    <th hidden class="text-center">Mrp</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-center">Free</th>
                                    <th class="text-center">Rate</th>
                                    <th hidden class="text-center">RateA</th>
                                    <th hidden class="text-center">RateB</th>
                                    <th class="text-center">Disc %</th>
                                    <th class="text-center gst-col">Gst %</th>
                                    <th hidden class="text-center">Gst Amt</th>
                                    <th hidden class="text-center">CGst %</th>
                                    <th hidden class="text-center">CGst Amt</th>
                                    <th hidden class="text-center">SGst %</th>
                                    <th hidden class="text-center">SGst Amt</th>
                                    <th class="text-center scgst-col">Cess</th>
                                    <th class="text-center">Amount</th>
                                    <th class="text-center"></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="PurchaseItemBody">
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="float-start">
                                        <u id="addRow" style="color:green; text-align:right;   cursor:pointer;">Add Row</u>
                                    </th>
                                </tr>

                            </tfoot>

                        </table>

                        <div class="row mt-3">

                            <div class="col-md-9">
                                <strong>Payment Details</strong>
                                <table class="table table-bordered table-striped">
                                    <thead class="table custom-header">
                                        <tr>
                                            <th style="min-width:30%">Payment Mode</th>
                                            <th class="text-center">Amount</th>
                                            <th class="text-center">Reference NO</th>
                                            <th class="text-center">Description</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="PaymentDetailsBody">
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th class="float-start">
                                                <u id="addPaymentRow" style="color:green; text-align:right; cursor:pointer;">Add Row</u>
                                            </th>
                                        </tr>
                                    </tfoot>
                                </table>
                                <div id="itemExtraInfoWrapper" class="border rounded p-3 h-90" style="display:none;">
                                    <div class="table-responsive">
                                        <table class="table table-sm mb-0 text-center purchase-history-table">
                                            <thead>
                                                <tr>
                                                    <th>Supplier</th>
                                                    <th>Bill No</th>
                                                    <th>Bill Date</th>
                                                    <th>Qty</th>
                                                    <th>Batch</th>
                                                    <th>MRP</th>
                                                    <th>Rate</th>
                                                    <th>Expiry</th>
                                                    @* <th>Disc.Amt.</th> *@
                                                    <th>Cost</th>
                                                </tr>
                                            </thead>
                                            <tbody id="itemExtraInfoBody">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- ===============================
                                 RIGHT : TOTALS (COMPACT)
                                 =============================== -->
                            <div class="col-md-3">

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Total</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="Total" class="form-control form-control-sm total-input text-end" readonly />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Bill Discount</label>
                                    <div class="col-md-3 text-end">
                                        <input asp-for="discountPercent" id="discountPercent" class="form-control form-control-sm discount-input text-end" min="0" max="100" step="0.01" />
                                    </div>
                                    <div class="col-md-3 text-end">
                                        <input asp-for="discountAmount" id="discountamount" class="form-control form-control-sm total-input text-end" />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Total Discount</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="Totaldiscount" class="form-control form-control-sm total-input text-end" readonly />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center gst-row">
                                    <label class="col-md-6 col-form-label small">Gst</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalGstAmt" class="form-control form-control-sm total-input text-end" readonly />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center sgst-row">
                                    <label class="col-md-6 col-form-label small">SGst</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalSGstAmt" class="form-control form-control-sm text-end" readonly />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center cgst-row">
                                    <label class="col-md-6 col-form-label small">CGst</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalCGstAmt" class="form-control form-control-sm text-end" readonly />
                                    </div>
                                </div>
