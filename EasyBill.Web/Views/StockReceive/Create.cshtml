<!-- ================================================================
     🔹 ADD SUPPLIER MODAL (CREATE NEW SUPPLIER)
     ================================================================ -->
<script>
    $(document).ready(function() {
        $("#supplierForm").submit(function (e) {
            e.preventDefault();

            let isFormValid = true;

            $("#addSupplierModal input").each(function () {
                if (!validateSupplierField(this, true)) {
                    $(this).focus().select();
                    isFormValid = false;
                    return false;
                }
            });

            if (!isFormValid) return;

            showLoader("Creating supplier...");

            $.post('/Supplier/CreateSupplier', $(this).serialize(), function (res) {
                hideLoader();

                if (res.success) {
                    // ✅ Update hidden supplier-id and input
                    $(".supplier-id").val(res.id);
                    $(".supplier-input").val(res.firstName);

                    $("#supplierForm")[0].reset();

                    $('#addSupplierModal').one('hidden.bs.modal', function () {
                        document.activeElement.blur();

                        requestAnimationFrame(() => {
                            $(".supplier-input").trigger('focus'); // ✅ FIXED
                        });

                    }).modal('hide');

                    toastr.success("Supplier created successfully");
                }
                else {
                    toastr.error(res.message || "Supplier already exists");
                    $("input[name='PhoneNO']").focus().select();
                }
            }).fail(function () {
                hideLoader();
                toastr.error("Server error while creating supplier");
            });
        });

        $('#addSupplierModal').on('shown.bs.modal', function () {
            $('#firstname').trigger('focus');
        });
    });

    $(document).on("keydown", "#addSupplierModal input", function (e) {
        if (e.key !== "Enter") return;

        e.preventDefault();

        if (!validateSupplierField(this, true)) {
            $(this).focus().select();
            return;
        }

        const inputs = $("#addSupplierModal input:visible");
        const index = inputs.index(this);

        if (index < inputs.length - 1) {
            inputs.eq(index + 1).focus().select();
        } else {
            $("#supplierForm button[type='submit']").focus();
        }
    });
</script>

