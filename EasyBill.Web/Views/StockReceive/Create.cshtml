<!-- ================================================================
 🔹 VALIDATION HELPERS - UPDATE EXPIRY VALIDATION
 ================================================================ -->
<script>

    function validateExpiry(showError = true) {
        const expiry = $("#popupExpiry").val().trim();
        const errorSpan = $("[data-field='popupExpiry']");
        errorSpan.text("");

        if (!expiry) {
            if (showError) errorSpan.text("Expiry Date is required");
            return false;
        }

        // ✅ Only MM/YY allowed
        const regex = /^(0[1-9]|1[0-2])\/\d{2}$/;

        if (!regex.test(expiry)) {
            if (showError) errorSpan.text("Format should be MM/YY");
            return false;
        }

        // Convert YY -> 20YY
        const [month, yy] = expiry.split("/");
        const year = "20" + yy;

        const expiryDate = new Date(parseInt(year), parseInt(month) - 1, 1);
        const currentDate = new Date();
        currentDate.setHours(0, 0, 0, 0);

        if (expiryDate < currentDate) {
            if (showError) errorSpan.text("Expiry date cannot be in the past");
            return false;
        }

        if (minPurchaseExpiryDays > 0) {
            const minExpiryDate = new Date();
            minExpiryDate.setDate(minExpiryDate.getDate() + minPurchaseExpiryDays);
            minExpiryDate.setHours(0, 0, 0, 0);

            if (expiryDate < minExpiryDate) {
                if (showError) {
                    errorSpan.text(`Expiry must be at least ${minPurchaseExpiryDays} days from today`);
                }
                return false;
            }
        }

        return true;
    }

    // Auto-format expiry date on blur
    $(document).on("blur", "#popupExpiry", function() {
        validateExpiry(false); // Auto-format without showing error
    });
</script>

<!-- ================================================================
     🔹 SETTINGS SIDEBAR - UPDATE TO LOAD minPurchaseExpiryDays
     ================================================================ -->
<script>
    $(document).ready(function () {

        // ✅ Load settings on page load to get minPurchaseExpiryDays
        function loadMinExpiryDays() {
            $.ajax({
                url: '@Url.Action("GetSidebarSettings", "PurchaseSetting")',
                type: 'GET',
                success: function (data) {
                    minPurchaseExpiryDays = data.minPurchaseExpiryDays || 0;
                    console.log("Min Purchase Expiry Days:", minPurchaseExpiryDays);
                },
                error: function (xhr) {
                    console.error("Error loading expiry settings:", xhr.status);
                }
            });
        }

        // ✅ Load on page ready
        loadMinExpiryDays();

        $('#settingsBtn').on('click', function (e) {
            e.preventDefault();

            $('#settingsSidebar').show();
            showLoader("Loading settings...");

            $.ajax({
                url: '@Url.Action("GetSidebarSettings", "PurchaseSetting")',
                type: 'GET',
                success: function (data) {
                    hideLoader();
                    $('#userId').val(data.applicationUserId);
                    $('#minPurchaseExpiryDays').val(
                        data.minPurchaseExpiryDays > 0
                            ? data.minPurchaseExpiryDays
                            : ''
                    );

                    // ✅ Update global variable
                    minPurchaseExpiryDays = data.minPurchaseExpiryDays || 0;
                },
                error: function (xhr) {
                    hideLoader();
                    alert("Error loading settings. Status: " + xhr.status);
                }
            });
        });

        $('#saveSidebarSettings').on('click', function () {
            const userId = $('#userId').val();
            const minPurchaseExpiryDaysInput =
                parseInt($("#minPurchaseExpiryDays").val()) || 0;

            if (minPurchaseExpiryDaysInput < 0 || minPurchaseExpiryDaysInput > 365) {
                alert("Expiry Allowed Days should be between 0 and 365");
                return;
            }

            showLoader("Saving settings...");

            $.ajax({
                url: '@Url.Action("SaveSidebarSettings", "PurchaseSetting")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    applicationUserId: userId,
                    MinPurchaseExpiryDays: minPurchaseExpiryDaysInput
                }),
                success: function () {
                    hideLoader();

                    // ✅ Update global variable after save
                    minPurchaseExpiryDays = minPurchaseExpiryDaysInput;

                    alert("Settings saved successfully");
                },
                error: function () {
                    hideLoader();
                    alert("Failed to save settings");
                }
            });
        });

        $('#closeSidebar').on('click', function () {
            $('#settingsSidebar').hide();
        });
    });
</script>
<script>
    $(document).on("keydown", function (e) {
        // F10 pressed
        if (e.key === "F10") {

            // ❌ Browser refresh band
            e.preventDefault();
            e.stopImmediatePropagation();

            // ❌ Agar koi modal open hai to kuch mat karo
            if ($(".modal.show").length > 0) return;

            $("#refreshBtn").trigger("click");
        }

        // F11 pressed
        if (e.key === "F11") {

            // ❌ Browser refresh band
            e.preventDefault();
            e.stopImmediatePropagation();

            // ❌ Agar koi modal open hai to kuch mat karo
            if ($(".modal.show").length > 0) return;

            $("#btnCancel").trigger("click");
        }
    });

    function confirmCancel(callback) {
        Swal.fire({
            title: 'Confirm Cancel?',
            text: 'Changes will be lost. Do you want to cancel?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '❌ Yes, Cancel',
            cancelButtonText: '↩ No, Stay',
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            reverseButtons: true
        }).then((result) => {
            callback(result.isConfirmed);
        });
    }

    $("#btnCancel").on("click", function (e) {
        e.preventDefault();

        confirmCancel(function (isConfirmed) {
            if (isConfirmed) {
                window.location.href = $("#btnCancel").attr("href");
            }
        });
    });

    $(document).on("click", "#refreshBtn", function () {
        Swal.fire({
            title: 'Refresh Page?',
            html: `
                <p class="text-danger mb-2">⚠️ Any unsaved changes will be lost!</p>
                <p class="mb-0">All items, payments, and customer details will be cleared.</p>
            `,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#0d6efd',
            cancelButtonColor: '#6c757d',
            confirmButtonText: '🔄 Yes, Refresh',
            cancelButtonText: '❌ No, Stay',
            reverseButtons: true,
            customClass: {
                confirmButton: 'btn btn-primary',
                cancelButton: 'btn btn-secondary'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                // Show loader while refreshing
                showLoader("Refreshing page...");
                location.reload();
            }
        });
    });
</script>

<script>
    $(document).ready(function () {
        $("#addPaymentRow").click(function () {
            addPaymentRow();
        });

        $(document).on("click", ".remove-paymentrow-btn", function () {
            $(this).closest("tr").remove();
            updatePaymentRowIndices();
            calculateTotalPaid();
            togglePaymentAddButton();
        });

        $(document).on("keyup", ".paymentAmount", function () {
            calculateTotalPaid();
        });

        initializeExistingPaymentRows();
        togglePaymentAddButton();
    });

    function initializeExistingPaymentRows() {
        if (!Array.isArray(existingPaymentDetails) || existingPaymentDetails.length === 0) {
            calculateTotalPaid();
            return;
        }

        $("#PaymentDetailsBody").empty();
        subrowIndex = 0;

        existingPaymentDetails.forEach(function (detail) {
            addPaymentRow(detail);
        });

        calculateTotalPaid();
    }

    function addPaymentRow(detail = null) {
        const hasExistingDetail = detail !== null && detail !== undefined;
        let newRow = `
            <tr>
                <td hidden>
                    <input type="hidden" name="PaymentDetails[${subrowIndex}].Id"
                           class="payment-detail-id" value="0" />
                </td>
                <td style="min-width:185px;">
                    <select name="PaymentDetails[${subrowIndex}].PaymentModeId"
                            class="form-control form-control-sm paymentMode-dropdown" required>
                        <option value="">-- Select --</option>
                        ${getPaymentOptions()}
                    </select>
                </td>
                <td>
                    <input name="PaymentDetails[${subrowIndex}].Amount"
                           class="form-control form-control-sm paymentAmount" value="0" />
                </td>
                <td>
                    <input name="PaymentDetails[${subrowIndex}].ReferenceNo"
                           class="form-control form-control-sm paymentReferenceNO" />
                </td>
                <td>
                    <input name="PaymentDetails[${subrowIndex}].Description"
                           class="form-control form-control-sm rate paymentDescription" />
                </td>
                <td>
                    <u class="remove-paymentrow-btn text-danger" style="cursor:pointer;">Remove</u>
                </td>
            </tr>`;

        $("#PaymentDetailsBody").append(newRow);
        const newPaymentRow = $("#PaymentDetailsBody tr:last");

        if (hasExistingDetail) {
            const paymentDetailId = readValue(detail, "id", "Id") || 0;
            const paymentModeId = readValue(detail, "paymentModeId", "PaymentModeId");
            const paymentAmount = parseFloat(readValue(detail, "amount", "Amount"));

            newPaymentRow.find(".payment-detail-id").val(paymentDetailId);
            newPaymentRow.find(".paymentMode-dropdown").val(paymentModeId || "");
            newPaymentRow.find(".paymentAmount").val(
                Number.isFinite(paymentAmount) ? paymentAmount.toFixed(2) : "0"
            );
            newPaymentRow.find(".paymentReferenceNO").val(
                readValue(detail, "referenceNo", "ReferenceNo") || ""
            );
            newPaymentRow.find(".paymentDescription").val(
                readValue(detail, "description", "Description") || ""
            );
        } else {
            // AUTO FILL PAYMENT AMOUNT
            let rowCount = $("#PaymentDetailsBody tr").length;

            if (rowCount === 1) {
                let totalPayable = parseFloat($("#totalPayable").val()) || 0;
                if (totalPayable > 0) {
                    newPaymentRow.find(".paymentAmount").val(totalPayable.toFixed(2));
                }
            } else {
                let balance = parseFloat($("#balance").val()) || 0;
                if (balance > 0) {
                    newPaymentRow.find(".paymentAmount").val(balance.toFixed(2));
                } else {
                    newPaymentRow.find(".paymentAmount").val("0");
                }
            }
        }

        subrowIndex++;
        calculateTotalPaid();
        togglePaymentAddButton();
    }

    function getPaymentOptions() {
        return `@foreach (var item in ViewBag.PaymentMode)
        {
                     <option value="@item.Value">@item.Text</option>
        }
        `;
    }
    function validatePayments() {
        let isValid = true;

        $(".paymentMode-dropdown").each(function () {
            if (!$(this).val()) {
                $(this).addClass("is-invalid");
                isValid = false;
            } else {
                $(this).removeClass("is-invalid");
            }
        });

        return isValid;
    }
    function calculateTotalPaid() {
        let totalPaid = 0;
        $(".paymentAmount").each(function () {
            let val = parseFloat($(this).val()) || 0;
            totalPaid += val;
        });

        $("#paidAmout").val(totalPaid.toFixed(2));
        calculateTotalPaymentSummary();
    }

    function calculateTotalPaymentSummary() {
        let returnAmt = 0;
        let balance = 0;
        var totalPayable = parseFloat($("#totalPayable").val()) || 0;
        var paidAmt = parseFloat($("#paidAmout").val()) || 0;

        if (paidAmt > totalPayable && paidAmt > 0) {
            returnAmt = paidAmt - totalPayable;
            balance = 0;
        } else {
            balance = totalPayable - paidAmt;
        }
        $("#returnAmount").val(returnAmt.toFixed(2));
        $("#ReturnAmount").val(returnAmt.toFixed(2));
        $("#balance").val(balance.toFixed(2));
        $("#returnAmountDisplay").text(returnAmt.toFixed(2));
    }

    function updatePaymentRowIndices() {
        const rows = document.querySelectorAll('#PaymentDetailsBody tr');
        subrowIndex = 0;
        rows.forEach(row => {
            row.querySelectorAll('input, select').forEach(input => {
                const name = input.name;
                if (name) {
                    input.name = name.replace(/\[\d+\]/, `[${subrowIndex}]`);
                }
            });
            subrowIndex++;
        });
    }

    function togglePaymentAddButton() {
        if ($("#PaymentDetailsBody tr").length > 0) {
            $("#addPaymentRow").hide();
        } else {
            $("#addPaymentRow").show();
        }
    }


    $(document).on("keydown", "#PartyBillDate", function (e) {
        if (e.key === "Enter") {
            e.preventDefault();

            focusTaxCalculationOrItemGrid();
        }
    });



    // Branch Transfer Toggle Logic
    $(document).ready(function() {
        function toggleReceiveType() {
            const receiveType = $('input[name="ReceiveFromType"]:checked').val();
            if (receiveType === 'Branch') {
                $('.supplier-section').removeClass('d-flex').addClass('d-none');
                $('.branch-section').removeClass('d-none').addClass('d-flex');
                $('#billingType').val('registered').trigger('change');
            } else {
                $('.branch-section').removeClass('d-flex').addClass('d-none');
                $('.supplier-section').removeClass('d-none').addClass('d-flex');
            }
        }

        $('input[name="ReceiveFromType"]').on('change', toggleReceiveType);
        toggleReceiveType(); // Initialize

        // Removed btnShowPendingTransfers click handler

        function loadPendingTransferDetails(issueId) {
            // showLoader("Fetching transfer details...");
            $.get('/StockReceive/GetStockIssueDetails', { issueId: issueId }, function(res) {
                // hideLoader();
                if (res.success) {
                    var data = res.data;
                    $("#pendingTransfersModal").modal('hide');
                    
                    var tIssueId = readValue(data, "issueId", "IssueId");
                    var tTenantId = readValue(data, "transferFromTenantId", "TransferFromTenantId");
                    var tBranchName = readValue(data, "transferFromBranchName", "TransferFromBranchName");
                    var tChallanNo = readValue(data, "challanNo", "ChallanNo");
                    var tChallanDate = readValue(data, "challanDate", "ChallanDate");

                    // Auto fill the form
                    $("#SourceStockIssueId").val(tIssueId);
                    
                    if ($("#TransferFromTenantIdHidden").length > 0) {
                        $("#TransferFromTenantIdHidden").val(tTenantId);
                    } else {
                        var $select = $("#TransferFromTenantId");
                        if ($select.find("option[value='" + tTenantId + "']").length === 0) {
                            $select.append(new Option(tBranchName || "Branch Transfer", tTenantId));
                        }
                        $select.val(tTenantId).trigger('change');
                        $select.prop("disabled", true); // Don't let them change the source of a pending transfer
                        
                        if ($("#DynamicTransferFromTenantId").length === 0) {
                            $("<input>").attr({
                                type: 'hidden',
                                id: 'DynamicTransferFromTenantId',
                                name: 'TransferFromTenantId',
                                value: tTenantId
                            }).appendTo("form");
                        } else {
                            $("#DynamicTransferFromTenantId").val(tTenantId);
                        }
                    }
                    
                    $("#BillNo").val(tChallanNo);
                    $("#BillDate").val(tChallanDate);
                    $("#PartyBillNo").val(tChallanNo);
                    $("#PartyBillDate").val(tChallanDate);
                    
                    // Clear existing grid and add fetched items
                    $("#PurchaseItemBody").empty();
                    rowIndex = 0; // reset global rowIndex
                    
                    var itemsList = readValue(data, "items", "Items") || [];
                    itemsList.forEach(function(item) {
                        var rRate = readValue(item, "rate", "Rate");
                        var mappedItem = {
                            itemId: readValue(item, "itemId", "ItemId"),
                            itemName: readValue(item, "itemName", "ItemName"),
                            qty: readValue(item, "qty", "Qty"),
                            freeQty: readValue(item, "freeQty", "FreeQty") || 0,
                            rate: rRate,
                            mrp: readValue(item, "mrp", "Mrp") || rRate, 
                            batch: readValue(item, "batch", "Batch"),
                            expiryDate: readValue(item, "expiryDate", "ExpiryDate"),
                            discount: readValue(item, "discountPercent", "DiscountPercent", "discount", "Discount"),
                            gst: readValue(item, "taxPercent", "TaxPercent", "gst", "Gst")
                        };
                        addNewRow(mappedItem);
                    });
                    
                    calculateTotalSummary();
                    
                    toastr.success("Data loaded! You can now review and edit the items.");
                } else {
                    toastr.error(res.message);
                }
            });
        }

        $(document).on("click", ".btn-accept-transfer", function() {
            var issueId = $(this).data("id");
            loadPendingTransferDetails(issueId);
        });

        @if (ViewBag.AutoLoadIssueId != null)
        {
            <text>
            // Automatically select Branch transfer UI
            $('input[name="ReceiveFromType"][value="Branch"]').prop("checked", true).trigger("change");
            
            setTimeout(function() {
                loadPendingTransferDetails(@ViewBag.AutoLoadIssueId);
            }, 500);
            </text>
        }
    });

</script>
