<script>
    $(document).on("input", "#addSupplierModal input[name='PhoneNO']", function () {
        this.value = this.value.replace(/\D/g, "").substring(0, 10);
    });

    $(document).on("input", "#addSupplierModal input[name='PinCode']", function () {
        this.value = this.value.replace(/\D/g, "").substring(0, 6);
    });

    $(document).on("blur", "#addSupplierModal input", function () {
        if (this.type !== "email" && this.name !== "PhoneNO" && this.name !== "PinCode") {
            this.value = normalizeText(this.value);
        }
    });

    $(document).on("input", "#addSupplierModal input", function () {
        validateSupplierField(this, false);
    });

    // $("#popupExpiry").on("input", function () {
    //     validateExpiry(false);
    // });
    $("#popupExpiry").on("input", function () {
        let val = $(this).val();

        if (val === "") return;

        let clean = val.replace(/\D/g, "");

        // limit to 4 digits (MMYY)
        clean = clean.substring(0, 4);

        // month validation
        if (clean.length >= 1) {
            let m1 = parseInt(clean.substring(0, 1));
            if (m1 > 1) clean = "0" + m1;
        }

        if (clean.length >= 2) {
            let month = parseInt(clean.substring(0, 2));

            if (month === 0) month = 1;
            if (month > 12) month = 12;

            clean = ("0" + month).slice(-2) + clean.substring(2);
        }

        // format MM/YY
        if (clean.length > 2) {
            clean = clean.substring(0, 2) + "/" + clean.substring(2);
        }

        $(this).val(clean);
    });
    $("#popupMrp").on("input", function () {
        validateMrp(false);

        let mrpVal = $(this).val();
        $("#popupSalseRateA").val(mrpVal);

    });

    $("#popupSalseRateA").on("input", function () {
        let salseRateA = $(this).val();
        $("#popupSalseRateB").val(salseRateA);
    });

    function formatExpiryDateInput(input) {
        $(input).on("input", function () {
            let value = $(this).val().replace(/[^0-9]/g, "");
            if (value.length >= 2) {
                value = value.substring(0, 2) + "/" + value.substring(2, 6);
            }
            $(this).val(value.substring(0, 7));
        });
    }

    formatExpiryDateInput("#popupExpiry");
</script>

