                        let sgstAmt = (rowAfterGlobalDiscount * row.sgst) / 100;

                        totalCgst += cgstAmt;
                        totalSgst += sgstAmt;

                    }
                    else if (taxEnabled) {

                        let gstAmt = (rowAfterGlobalDiscount * row.gst) / 100;

                        totalGst += gstAmt;

                    }
                    totalcess += cessAmt;
                });

            }


            let totalTax = !taxEnabled
                ? 0
                : purchaseType === "Local"
