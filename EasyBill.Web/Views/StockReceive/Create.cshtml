<script>
    function readValue(source, ...keys) {
        if (!source) return "";

        for (const key of keys) {
            if (Object.prototype.hasOwnProperty.call(source, key) && source[key] !== null && source[key] !== undefined) {
                return source[key];
            }
        }

        return "";
    }

    function shouldCalculateTax() {
        return ($("#TaxCalculation").val() || "Yes").toString().toLowerCase() !== "no";
    }

    function formatExpiryDateForInput(value) {
        if (!value) return "";
        if (typeof value === "string" && /^\d{2}\/\d{4}$/.test(value)) return value;

        const parsedDate = new Date(value);
        if (Number.isNaN(parsedDate.getTime())) return value;

        const month = String(parsedDate.getMonth() + 1).padStart(2, "0");
        return `${month}/${parsedDate.getFullYear()}`;
    }

    function syncPaymentToggleFromValue() {
        const paymentType = ($("#paymentTypeHidden").val() || "cash").toString().toLowerCase();
        const isCredit = paymentType === "credit";

        $("#paymentToggle").prop("checked", isCredit);
        $("#paymentToggleLabel").text(isCredit ? "Credit" : "Cash");
    }

    function openItemDetailModal() {
        const itemDetailModal = $("#itemDetailModal");

        itemDetailModal
            .off("shown.bs.modal.stockReceiveFocus")
            .one("shown.bs.modal.stockReceiveFocus", function () {
                const focusExpiryInput = () => {
                    const expiryInput = document.getElementById("popupExpiry");
                    if (!expiryInput) return;

                    expiryInput.focus();
                    expiryInput.select();
                };

                focusExpiryInput();
                setTimeout(focusExpiryInput, 80);
                setTimeout(focusExpiryInput, 180);
            });

        itemDetailModal.modal("show");
    }

    function recalculateGridAndSummary() {
        const rows = $("#PurchaseItemBody tr");

        if (!rows.length) {
            calculateTotalSummary();
            return;
        }

        rows.each(function () {
            calculateRow($(this));
        });
    }

    function openTaxCalculationPicker() {
        const dropdown = document.getElementById("TaxCalculation");
        if (!dropdown) return;

        setTimeout(() => {
            if (typeof dropdown.showPicker === "function") {
                dropdown.showPicker();
            } else {
                $(dropdown).trigger("mousedown").trigger("click");
            }
        }, 50);
    }

    function focusTaxCalculationOrItemGrid() {
        const taxCalculation = $("#TaxCalculation");

        if (taxCalculation.length) {
            taxCalculationSelectionPending = true;
            taxCalculation.focus();
            openTaxCalculationPicker();

            return;
        }

        focusItemGrid();
    }
</script>

