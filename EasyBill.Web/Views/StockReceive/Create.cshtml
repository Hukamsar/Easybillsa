        function calculateRow(row) {

            let purchaseType = $("#purchasetype").val();
            let taxEnabled = shouldCalculateTax();

            let qty = parseFloat(row.find(".qty").val()) || 0;
            let freeQty = parseFloat(row.find(".freeqty").val()) || 0;
            let rate = parseFloat(row.find(".rate").val()) || 0;

            let igst = parseFloat(row.find(".gst").val()) || 0;
            let sgst = parseFloat(row.find(".sgst").val()) || 0;
            let cgst = parseFloat(row.find(".cgst").val()) || 0;
            let cess = parseFloat(row.find(".cess").val()) || 0;
            let discount = parseFloat(row.find(".discount").val()) || 0;

            let grossAmount = qty * rate;
            let discountAmt = (grossAmount * discount) / 100;
            let amountAfterDiscount = grossAmount - discountAmt;

            let igstAmt = 0;
            let sgstAmt = 0;
            let cgstAmt = 0;

            if (taxEnabled && purchaseType === "Local") {
                sgstAmt = (amountAfterDiscount * sgst) / 100;
                cgstAmt = (amountAfterDiscount * cgst) / 100;
            } else if (taxEnabled) {
                igstAmt = (amountAfterDiscount * igst) / 100;
            }

            let cessAmt = (amountAfterDiscount * cess) / 100;
            let gstAmt = igstAmt + sgstAmt + cgstAmt;
            let total = amountAfterDiscount + gstAmt + cessAmt;

            let billDiscountPercent = parseFloat($("#discountPercent").val()) || 0;
            let billDiscountAmt = (amountAfterDiscount * billDiscountPercent) / 100;
            let finalAmount = amountAfterDiscount - billDiscountAmt;

            let finalGstAmt = 0;
            if (taxEnabled && purchaseType === "Local") {
                finalGstAmt = (finalAmount * sgst / 100) + (finalAmount * cgst / 100);
            } else if (taxEnabled) {
                finalGstAmt = (finalAmount * igst) / 100;
            }

            let totalWithBillDiscount = finalAmount + finalGstAmt + cessAmt;
            let totalQty = qty + freeQty;
            let netCost = totalQty > 0 ? totalWithBillDiscount / totalQty : 0;

            row.find(".discount-amt").val(discountAmt.toFixed(2));
            row.find(".gstamt").val(igstAmt.toFixed(2));
            row.find(".cgstamt").val(cgstAmt.toFixed(2));
            row.find(".sgstamt").val(sgstAmt.toFixed(2));
            row.find(".total").val(total.toFixed(2));
            row.find(".batch-wise").val(netCost.toFixed(4));

            calculateTotalSummary();
        }
