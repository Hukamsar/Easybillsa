    async function processPurchaseForm(form) {

        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: 3000
        };

        fixDecimalFields();

        if (!validateHeaderFields()) return false;

        if (await isDuplicateBillNumber()) {
            toastr.error("Bill number already exists!");
            $("#BillNo").focus();
            return false;
        }

        if ($("#PurchaseItemBody tr").length === 0) {
            toastr.error("Please add at least one item");
            $("#addRow").focus();
            return false;
        }

        if (!validateAllRows()) return false;

        if (!validatePayments()) {
            toastr.error("Please select payment mode.");
            return false;
        }

        if (!checkPendingItemDetailAndOpenModal()) return false;

        // confirmSave(function (ok) {
        //     if (!ok) return;

        //     showLoader("Saving stock receive...");
        //     form.submit();
        // });

        confirmSave(async function (ok) {
           if (!ok) return;

           showLoader("Saving stock receive...");

           try {
               const response = await $.ajax({
                   url: form.action,
                   type: "POST",
                   data: $(form).serialize()
               });

               if (response.success) {
                   toastr.success("Stock receive saved successfully!");
                   window.location.href = "/StockReceive/Index";
               } else {
                   toastr.error(response.message || "Failed to save stock receive.");
               }

           } catch (xhr) {

               if (xhr.status === 400 && xhr.responseJSON) {
                   toastr.error(xhr.responseJSON.message || "Validation failed");
               } else {
                   toastr.error("Something went wrong!");
               }

           } finally {
               hideLoader(); // ✅ ALWAYS RUN
           }
       });

        return true;
    }
    function fixDecimalFields() {
        $("#PurchaseItemBody tr").each(function () {
            const row = $(this);
            const decimalFields = ['.mrp', '.salserateA', '.salserateB', '.discount', '.rate', '.freeqty'];

            decimalFields.forEach(field => {
                const $input = row.find(field);
                const val = $input.val();

                if (!val || val.trim() === '' || val === 'NaN' || isNaN(parseFloat(val))) {
                    $input.val('0');
                }
            });
        });

        ['#discountPercent', '#discountamount'].forEach(field => {
            const $input = $(field);
            const val = $input.val();

            if (!val || val.trim() === '' || val === 'NaN' || isNaN(parseFloat(val))) {
                $input.val('0');
            }
        });
    }

    async function isDuplicateBillNumber() {
        const billNo = $("#BillNo").val()?.trim();
        const currentId = $("#Id").val() || 0;

        if (!billNo) return false;

        try {
           const response = await $.ajax({
               url: '/StockReceive/IsBillNumberDuplicate',
               type: 'GET',
               data: { billNumber: billNo, id: currentId }
           });

            return response.isDuplicate; // true / false
        } catch (err) {
            console.error(err);
            return false;
        }
    }
</script>

