<script>
    function openSupplierModal(searchText = "") {
        showLoader("Loading suppliers...");

        $.get('/Purchase/GetAllSuppliers', function (suppliers) {
            hideLoader();

            let rows = "";
            suppliers.forEach(sup => {
                rows += `
                    <tr class="supplier-row" tabindex="0"
                        data-supplierid="${sup.id}"
                        data-name="${sup.firstName}"
                        data-phone="${sup.phoneNO || ''}"
                        data-email="${sup.email || ''}"
                        data-gstno="${sup.gstNo || ''}">
                        <td>${sup.firstName}</td>
                        <td>${sup.area || '--'}</td>
                    </tr>`;
            });

            $("#supplierTableBody").html(rows);
            $("#supplierSearch").val(searchText);
            $("#supplierSearch").trigger("input");

            $("#supplierModal").modal("show");

        }).fail(function() {
            hideLoader();
            toastr.error("Error loading suppliers");
        });
    }

    $(document).on("input", "#supplierSearch", function () {
        const searchWords = $(this).val()
            .toLowerCase()
            .trim()
            .split(/\s+/);

        $("#supplierTableBody tr").each(function () {
            const supplierText = $(this).find("td:first").text().toLowerCase();
            const supplierWords = supplierText.split(/\s+/);

            let match = true;

            for (let i = 0; i < searchWords.length; i++) {
                if (!supplierWords[i] || !supplierWords[i].startsWith(searchWords[i])) {
                    match = false;
                    break;
                }
            }

            $(this).toggle(match);
        });

        currentSupplierIndex = -1;
        $("#supplierTableBody .supplier-row").removeClass("selected");
    });

    $(document).on("keydown", function (e) {
        if (!$("#supplierModal").is(":visible")) return;

        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
            supplierNavMode = "keyboard";
            isKeyboardScrollingSupplierModal = true;
            $("#supplierModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");
        }

        const $rows = $(".supplier-row:visible");
        if (!$rows.length) return;

        if (e.key === "ArrowDown") {
            e.preventDefault();

            if (currentSupplierIndex === -1) {
                currentSupplierIndex = 0;
            } else if (currentSupplierIndex < $rows.length - 1) {
                currentSupplierIndex++;
            }

            highlightSupplierRow($rows, currentSupplierIndex);
        }
        else if (e.key === "ArrowUp") {
            e.preventDefault();
            if (currentSupplierIndex <= 0) return;
            currentSupplierIndex--;
            highlightSupplierRow($rows, currentSupplierIndex);
        }
        else if (e.key === "Enter" && currentSupplierIndex >= 0) {
            e.preventDefault();
            $rows.eq(currentSupplierIndex).trigger("click");
        }
    });

    function highlightSupplierRow($rows, index) {
        $rows.removeClass("selected");
        const $row = $rows.eq(index);
        $row.addClass("selected");
        $row[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
    }

    $(document).on("mouseenter", ".supplier-row", function () {
        if (!$("#supplierModal").is(":visible")) return;
        if (isKeyboardScrollingSupplierModal) return;

        supplierNavMode = "mouse";

        $("#supplierModal")
            .addClass("mouse-nav")
            .removeClass("keyboard-nav");

        const $rows = $(".supplier-row:visible");
        $rows.removeClass("selected");
        $(this).addClass("selected");

        currentSupplierIndex = $rows.index(this);
    });

    $(document).on("mousemove", "#supplierModal", function () {
        isKeyboardScrollingSupplierModal = false;
    });

    $(document).on("click", ".supplier-row", function () {
        const supplierId = $(this).data("supplierid");
        const supplierName = $(this).data("name");

        if (!supplierId) return;

        $(".supplier-id").val(supplierId);
        $(".supplier-input").val(supplierName);
        $("#purchaseOrderId").val("");
        $("#sourcePurchaseChallanId").val("");

        supplierWasSelected = true;
        skipSupplierRefocus = true;
        activeSupplierSourceId = supplierId;
        checkSupplierTax(supplierId);
        $("#supplierModal").one("hidden.bs.modal", function () {
            loadSupplierSourceOptions(supplierId);
        });
        $("#supplierModal").modal("hide");
    });

    function focusPartyBillEntry() {
        supplierWasSelected = false;
        setTimeout(() => {
            $("#PartyBillNo").focus().select();
        }, 150);
    }

    function loadSupplierSourceOptions(supplierId) {
        checkSupplierPendingChallans(supplierId);
    }

    function checkSupplierPendingChallans(supplierId) {
        showLoader("Checking pending challans...");

        $.get('/Purchase/GetPendingPurchaseChallans', { supplierId: supplierId }, function (data) {
            hideLoader();

            if (!data || data.length === 0) {
                checkSupplierPendingPO(supplierId);
                return;
            }

            let rows = "";

            data.forEach(challan => {
                rows += `
                    <tr class="challan-row"
                        data-challanid="${challan.id}">
                        <td>${challan.challanNo}</td>
                        <td>${challan.date ?? "--"}</td>
                        <td>${challan.supplierBillNo ?? "--"}</td>
                        <td>${challan.totalAmount}</td>
                    </tr>`;
            });

            currentChallanIndex = -1;
            selectedChallanIds = [];
            continueToPurchaseOrderAfterChallan = true;
            $("#challanTableBody").html(rows);
            $("#challanModal").modal("show");
        })
        .fail(function () {
            hideLoader();
            toastr.error("Error loading Purchase Challans");
        });
    }

    function checkSupplierPendingPO(supplierId) {

        showLoader("Checking pending orders...");

        $.get('/Purchase/GetPendingPurchaseOrders', { supplierId: supplierId }, function (data) {

            hideLoader();

            if (!data || data.length === 0) {
                focusPartyBillEntry();
                return;
            }

            let rows = "";

            data.forEach(po => {
                rows += `
                    <tr class="po-row"
                        data-poid="${po.id}">
                        <td>${po.poNumber}</td>
                        <td>${po.date}</td>
                        <td>${po.totalAmount}</td>
                    </tr>`;
            });

            focusManualEntryAfterPO = true;
            currentPOIndex = -1;
            $("#poTableBody").html(rows);
            $("#poModal").modal("show");
        })
        .fail(function () {
            hideLoader();
            toastr.error("Error loading Purchase Orders");
        });
    }
    let currentPOIndex = -1;
    let isKeyboardScrollingPOModal = false;
    $(document).on("keydown", function (e) {

        if ($("#challanModal").is(":visible")) {
            const $challanRows = $(".challan-row:visible");
            if (!$challanRows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentChallanIndex === -1) {
                    currentChallanIndex = 0;
                } else if (currentChallanIndex < $challanRows.length - 1) {
                    currentChallanIndex++;
                }

                highlightChallanRow($challanRows, currentChallanIndex);
                return;
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();

                if (currentChallanIndex <= 0) return;
                currentChallanIndex--;

                highlightChallanRow($challanRows, currentChallanIndex);
                return;
            }
            else if ((e.key === " " || e.key === "Spacebar") && currentChallanIndex >= 0) {
                e.preventDefault();
                const $currentRow = $challanRows.eq(currentChallanIndex);
                toggleChallanSelection($currentRow);

                if (currentChallanIndex < $challanRows.length - 1) {
                    currentChallanIndex++;
                    highlightChallanRow($challanRows, currentChallanIndex);
                }
                return;
            }
            else if (e.key === "Enter" && currentChallanIndex >= 0) {
                e.preventDefault();
                applySelectedPurchaseChallans($challanRows.eq(currentChallanIndex));
                return;
            }
        }

        if (!$("#poModal").is(":visible")) return;

        const $rows = $(".po-row:visible");
        if (!$rows.length) return;

        if (e.key === "ArrowDown") {
            e.preventDefault();

            if (currentPOIndex === -1) {
                currentPOIndex = 0;
            } else if (currentPOIndex < $rows.length - 1) {
                currentPOIndex++;
            }

            highlightPORow($rows, currentPOIndex);
        }
        else if (e.key === "ArrowUp") {
            e.preventDefault();

            if (currentPOIndex <= 0) return;
            currentPOIndex--;

            highlightPORow($rows, currentPOIndex);
        }
        else if (e.key === "Enter" && currentPOIndex >= 0) {
            e.preventDefault();
            $rows.eq(currentPOIndex).trigger("click");
        }
    });
    function highlightChallanRow($rows, index) {
        $rows.removeClass("selected");
        const $row = $rows.eq(index);
        $row.addClass("selected");
        $row[0]?.scrollIntoView({ block: "nearest" });
    }
    function toggleChallanSelection($row) {
        const challanId = Number($row.data("challanid"));

        if (!challanId) return;

        if (selectedChallanIds.includes(challanId)) {
            selectedChallanIds = selectedChallanIds.filter(id => id !== challanId);
            $row.removeClass("marked");
        } else {
            selectedChallanIds.push(challanId);
            $row.addClass("marked");
        }
    }
    async function applySelectedPurchaseChallans($defaultRow = null) {
        let challanIds = selectedChallanIds.slice();

        if (!challanIds.length && $defaultRow && $defaultRow.length) {
            const defaultChallanId = Number($defaultRow.data("challanid"));
            if (defaultChallanId) {
                challanIds.push(defaultChallanId);
            }
        }

        if (!challanIds.length) {
            return;
        }

        showLoader("Loading challan details...");

        try {
            const challanResponses = await Promise.all(
                challanIds.map(challanId => $.get('/Purchase/GetPurchaseChallanDetails', { challanId: challanId }))
            );

            if (!challanResponses.length || challanResponses.some(data => !data)) {
                hideLoader();
                toastr.error("One or more selected challans are not available");
                return;
            }

            const firstChallan = challanResponses[0];
            continueToPurchaseOrderAfterChallan = false;

            // Old single-challan header field flow is kept only for compatibility; row-level challan ids now drive conversion.
            $("#sourcePurchaseChallanId").val("");
            $("#purchaseOrderId").val("");

            if (challanIds.length === 1) {
                $("#PartyBillNo").val(firstChallan.partyBillNo || "");
                $("#PartyBillDate").val(firstChallan.partyBillDate || "");
            } else {
                $("#PartyBillNo").val("");
                $("#PartyBillDate").val("");
            }

            if (firstChallan.purchaseType) {
                $("#purchasetype").val(firstChallan.purchaseType).trigger("change");
                $("#purchasetypeHidden").val(firstChallan.purchaseType);
            }

            $("#PurchaseItemBody").html("");
            rowIndex = 0;

            challanResponses.forEach(data => {
                if (data.items && data.items.length > 0) {
                    data.items.forEach(item => {
                        addNewRow(item);
                    });
                }
            });

            if ($("#PurchaseItemBody tr").length === 0) {
                addNewRow();
            }

            $("#challanModal").modal("hide");
            focusPartyBillEntry();
        }
        catch {
            hideLoader();
            toastr.error("Error loading Purchase Challan");
            return;
        }

        hideLoader();
    }
    function highlightPORow($rows, index) {
        $rows.removeClass("selected");
        const $row = $rows.eq(index);
        $row.addClass("selected");
        $row[0]?.scrollIntoView({ block: "nearest" });
    }
    $('#challanModal').on('shown.bs.modal', function () {
        const $rows = $(".challan-row:visible");

        currentChallanIndex = -1;

        if ($rows.length) {
            currentChallanIndex = 0;
            highlightChallanRow($rows, currentChallanIndex);
        }
    });
    $('#poModal').on('shown.bs.modal', function () {

        const $rows = $(".po-row:visible");

        currentPOIndex = -1;

        if ($rows.length) {
            currentPOIndex = 0;
            highlightPORow($rows, currentPOIndex);
        }
    });
    $(document).on("mouseenter", ".challan-row", function () {
        const $rows = $(".challan-row:visible");

        $rows.removeClass("selected");
        $(this).addClass("selected");

        currentChallanIndex = $rows.index(this);
    });
    $(document).on("mouseenter", ".po-row", function () {

        const $rows = $(".po-row:visible");

        $rows.removeClass("selected");
        $(this).addClass("selected");

        currentPOIndex = $rows.index(this);
    });
    $(document).on("click", ".challan-row", function () {
        const $rows = $(".challan-row:visible");
        currentChallanIndex = $rows.index(this);
        highlightChallanRow($rows, currentChallanIndex);

        // Old behavior: clicking a challan row immediately loaded one challan into the grid.
        // New behavior: click/Space only marks rows; Enter applies all marked challans together.
        toggleChallanSelection($(this));
    });
    $(document).on("dblclick", ".challan-row", function () {
        const $rows = $(".challan-row:visible");
        currentChallanIndex = $rows.index(this);
        highlightChallanRow($rows, currentChallanIndex);

        if (!selectedChallanIds.includes(Number($(this).data("challanid")))) {
            toggleChallanSelection($(this));
        }

        applySelectedPurchaseChallans($(this));
    });
    $(document).on("click", ".po-row", function () {

        const poId = $(this).data("poid");

        if (!poId) return;

        showLoader("Loading PO details...");

        $.get('/Purchase/GetPurchaseOrderDetails', { poId: poId }, function (data) {

            hideLoader();

            if (!data) return;
            focusManualEntryAfterPO = false;
            $("#purchaseOrderId").val(poId);
            $("#sourcePurchaseChallanId").val("");
            $("#PurchaseItemBody").html("");
            rowIndex = 0;

            if (data.items && data.items.length > 0) {
                data.items.forEach(item => {
                    addNewRow(item);
                });
            } else {
                addNewRow();
            }

            $("#poModal").modal("hide");
            focusPartyBillEntry();
        })
        .fail(function () {
            hideLoader();
            toastr.error("Error loading PO details");
        });
    });
    // Old button-based skip kept for reference. Skip is now handled only by Esc key.
    // $("#skipChallanBtn").on("click", function () {
    //     $("#challanModal").modal("hide");
    // });
    // $("#skipPoBtn").on("click", function () {
    //     $("#poModal").modal("hide");
    // });
    $('#challanModal').on('hidden.bs.modal', function () {
        selectedChallanIds = [];
        $("#challanTableBody .challan-row").removeClass("marked");
        if (continueToPurchaseOrderAfterChallan && activeSupplierSourceId) {
            continueToPurchaseOrderAfterChallan = false;
            checkSupplierPendingPO(activeSupplierSourceId);
        }
    });
    $('#poModal').on('hidden.bs.modal', function () {
        if (focusManualEntryAfterPO) {
            focusManualEntryAfterPO = false;
            focusPartyBillEntry();
        }
    });
    $('#supplierModal').on('shown.bs.modal', function () {
        supplierWasSelected = false;
        supplierNavMode = "keyboard";

        $("#supplierModal")
            .addClass("keyboard-nav")
            .removeClass("mouse-nav");

        const $rows = $(".supplier-row:visible");
        currentSupplierIndex = -1;

        if ($rows.length) {
            currentSupplierIndex = 0;
            highlightSupplierRow($rows, currentSupplierIndex);
        }

        setTimeout(() => {
            $("#supplierSearch").focus().select();
        }, 200);
    });

    $('#supplierModal').on('hidden.bs.modal', function () {
        setTimeout(() => {
            if (skipSupplierRefocus) {
                skipSupplierRefocus = false;
                return;
            }

            if (supplierWasSelected) {
                focusPartyBillEntry();
                supplierWasSelected = false;
            } else {
                $(".supplier-input").focus();
            }
        }, 150);
    });



    function checkSupplierTax(supplierId) {

        $.get('/Purchase/GetSupplierGst', { supplierId: supplierId }, function (data) {

            var companyGst = $("#companygst").val();

            // GST null ya empty check
            if (!data || !data.gst || data.gst.length < 2 || !companyGst || companyGst.length < 2) {
               $("#purchasetype").val("Local");
               $("#purchasetypeHidden").val("Local");
                return;
            }

            var supplierState = data.gst.substring(0, 2);
            var companyState = companyGst.substring(0, 2);

            if (supplierState === companyState) {
                $("#purchasetype").val("Local");
                $("#purchasetypeHidden").val("Local");
            } else {
                $("#purchasetype").val("Central");
                $("#purchasetypeHidden").val("Central");
            }

             $("#purchasetype").trigger("change");

        });
    }

</script>

<!-- ================================================================
     🔹 KEYBOARD NAVIGATION - ITEM GRID
     ================================================================ -->
<script>
        $(document).on("keydown", ".item-input", function (e) {
            const row = $(this).closest("tr");
            const sourcePurchaseChallanId = row.find(".source-purchase-challan-id").val();
            const sourceItemName = (row.attr("data-source-item-name") || "").trim();

            if (e.key === "ArrowRight") {
                e.preventDefault();
                row.find(".batch").focus().select();
                return;
            }

            if (e.key === "ArrowDown") {
                e.preventDefault();
                const nextRow = row.next("tr");
                if (nextRow.length) nextRow.find(".item-input").focus();
                return;
            }

            if (e.key === "ArrowUp") {
                e.preventDefault();
                const prevRow = row.prev("tr");
                if (prevRow.length) {
                    prevRow.find(".item-input").focus();
                } else {
                    $("#PartyBillDate").focus();
                }
                return;
            }

            if (e.key === "Enter") {
                e.preventDefault();

                if (sourcePurchaseChallanId && sourceItemName && $(this).val().trim() === sourceItemName) {
                    row.find(".batch").focus().select();
                    return;
                }

                currentRow = row;
                currentRowForItemModal = row;

                const typedText = $(this).val().trim();
                openItemModal(typedText);
            }
        });

        function openItemModal(searchText = "") {
             var purchaseType = $("#purchasetype").val();
            showLoader("Loading items...");

            $.get('/Purchase/GetAllItems', { purchaseType: purchaseType }, function (items) {
                hideLoader();

                let rows = "";
                const businessType = @ViewBag.BusinessType;
                items.forEach(item => {
                    rows += `
                        <tr class="item-row" tabindex="0"
                            data-itemid="${item.id}"
                            data-name="${item.name}"
                            data-gst="${item.gst}"
                            data-cgst="${item.cgst}"
                            data-sgst="${item.sgst}"
                            data-qty="${item.qty}"
                            data-cess="${item.cess}"
                            data-hsn="${item.hsn || ''}">
                            <td>${item.name}</td>

                            ${
                            businessType === 2
                            ? `
                                <td style="display:none;">${item.qty}</td>
                                <td>${item.availableQty}</td>
                              `
                            : `
                                <td>${item.qty}</td>
                              `
                            }

                            <td>${item.unit || ''}</td>
                        </tr>`;
                });

                $("#itemTableBody").html(rows);
                $("#itemSearch").val(searchText);
                $("#itemSearch").trigger("input");

                $("#itemModal").modal("show");

            }).fail(function() {
                hideLoader();
                toastr.error("Error loading items");
            });
        }

        $(document).on("input", "#itemSearch", function () {
            const searchWords = $(this).val()
                .toLowerCase()
                .trim()
                .split(/\s+/);

            $("#itemTableBody tr").each(function () {
                const itemText = $(this).find("td:first").text().toLowerCase();
                const itemWords = itemText.split(/\s+/);

                let match = true;

                for (let i = 0; i < searchWords.length; i++) {
                    if (!itemWords[i] || !itemWords[i].startsWith(searchWords[i])) {
                        match = false;
                        break;
                    }
                }

                $(this).toggle(match);
            });

            currentItemIndex = -1;
            $("#itemTableBody .item-row").removeClass("selected");
        });

        $(document).on("keydown", function (e) {
            if (!$("#itemModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                itemNavMode = "keyboard";
                isKeyboardScrollingItemModal = true;
                $("#itemModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".item-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentItemIndex === -1) {
                    currentItemIndex = 0;
                }
                else if (currentItemIndex < $rows.length - 1) {
                    currentItemIndex++;
                }

                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();
                if (currentItemIndex <= 0) return;
                currentItemIndex = (currentItemIndex - 1 + $rows.length) % $rows.length;
                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "Enter" && currentItemIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentItemIndex).trigger("click");
            }
        });

        function highlightItemRow($rows, index) {
            $rows.removeClass("selected");
            const $row = $rows.eq(index);
            $row.addClass("selected");
            $row[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
        }

        $(document).on("click", ".item-row", function () {
            const itemId = $(this).data("itemid");
            const itemName = $(this).data("name");
            const gst = $(this).data("gst");
            const hsn = $(this).data("hsn");


           const purchaseType = $("#purchasetype").val();

           const cgst = $(this).data("cgst");
           const sgst = $(this).data("sgst");
           const cess = $(this).data("cess");
           var scgst = cgst+sgst;

            if (!itemId || !currentRowForItemModal) return;

            // If an imported challan row is manually re-picked, it should behave like a manual purchase row.
            currentRowForItemModal.find(".source-purchase-challan-id").val("");
            currentRowForItemModal.removeAttr("data-source-item-name");

             if (purchaseType === "Local") {
                   currentRowForItemModal.find(".cgst").val(cgst);
                   currentRowForItemModal.find(".sgst").val(sgst);
                   currentRowForItemModal.find(".scgst").val(scgst);
                   currentRowForItemModal.find(".gst").val(0);
                   currentRowForItemModal.find(".cess").val(cess);
             } else {
                 currentRowForItemModal.find(".gst").val(gst);
                 currentRowForItemModal.find(".cgst").val(0);
                 currentRowForItemModal.find(".sgst").val(0);
                 currentRowForItemModal.find(".scgst").val(0);
                 currentRowForItemModal.find(".cess").val(cess);
             }

            currentRowForItemModal.find(".item-id").val(itemId);
            currentRowForItemModal.find(".item-input").val(itemName);
           // currentRowForItemModal.find(".gst").val(gst);
            currentRowForItemModal.find(".hsn-dropdown").val(hsn);
        isItemSelected = true;
            $("#itemModal").modal("hide");

            processItemSelection(itemId, currentRowForItemModal);
            loadItemSupplierPurchaseInfo(itemId);
        });

        $(document).on("mouseenter", ".item-row", function () {
            if (!$("#itemModal").is(":visible")) return;
            if (isKeyboardScrollingItemModal) return;

            itemNavMode = "mouse";

            $("#itemModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".item-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentItemIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#itemModal", function () {
            isKeyboardScrollingItemModal = false;
        });

        $('#itemModal').on('shown.bs.modal', function () {
        isItemSelected = false;
            itemNavMode = "keyboard";
    $("#itemModal").addClass("keyboard-nav").removeClass("mouse-nav");
        const $rows = $(".item-row:visible");
        currentItemIndex = -1;
        if ($rows.length) {
        currentItemIndex = 0;
        highlightItemRow($rows, currentItemIndex);
    }
    setTimeout(() => {
        $("#itemSearch").focus().select();
    }, 200);
        });

        $('#itemModal').on('hidden.bs.modal', function () {
            setTimeout(() => {
                if (focusBatchAfterItemSelect && currentRowForItemModal) {
                    currentRowForItemModal.find(".batch").focus().select();
                    focusBatchAfterItemSelect = false;
                    return;
                }

                if (currentRowForItemModal && currentRowForItemModal.length) {
                    currentRowForItemModal.find(".item-input").focus();
                }
            }, 150);
        });

        $(document).on("keydown", ".batch", function(e) {
            if (e.key === "Enter" && !popupOpen) {
                e.preventDefault();
                const row = $(this).closest("tr");
                if (!$(this).val().trim()) {
                    //toastr.warning("Batch is required");
                    return;
                }
                row.find(".qty").focus().select();
            }
        });

        $(document).on("keydown", ".qty", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const row = $(this).closest("tr");
                if (!isValidQty($(this).val())) {
                    toastr.warning("Quantity must be greater than 0");
                    $(this).focus().select();
                    return;
                }
                row.find(".freeqty").focus().select();
            }
        });





        $(document).on("keydown", ".freeqty", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                $(this).closest("tr").find(".rate").focus().select();
            }
        });

        $(document).on("keydown", ".rate", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const row = $(this).closest("tr");
                if (!isValidRate($(this).val())) {
                    toastr.warning("Rate must be greater than 0");
                    $(this).focus().select();
                    return;
                }
                row.find(".discount").focus().select();
            }
        });

        $(document).on("keydown", ".discount", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const row = $(this).closest("tr");

                if (!validateRow(row)) return;

                const isItemDetailValid = row.attr("data-itemdetail-valid") === "true";

                if (ENABLE_ITEM_DETAIL_VALIDATION && !isItemDetailValid) {
                    currentRow = row;
                    selectedRow = row;
                    popupOpen = true;
                    openItemDetailModal();
                    return;
                }

                const isLastRow = row.is("#PurchaseItemBody tr:last");

                if (isLastRow) {
                    addNewRow();
                    setTimeout(() => $("#PurchaseItemBody tr:last .item-input").focus(), 150);
                } else {
                    const nextRow = row.next("tr");
                    if (nextRow.length) nextRow.find(".item-input").focus();
                }
            }
        });
</script>

<!-- ================================================================
     🔹 ARROW KEY NAVIGATION
     ================================================================ -->
<script>
    $(document).on("keydown", ".batch, .qty, .freeqty, .rate, .discount", function(e) {
        const row = $(this).closest("tr");
        const current = $(this);

        if (e.key === "ArrowRight") {
            e.preventDefault();
            if (current.hasClass("batch")) row.find(".qty").focus().select();
            else if (current.hasClass("qty")) row.find(".freeqty").focus().select();
            else if (current.hasClass("freeqty")) row.find(".rate").focus().select();
            else if (current.hasClass("rate")) row.find(".discount").focus().select();
        }

        if (e.key === "ArrowLeft") {
            e.preventDefault();
            if (current.hasClass("discount")) row.find(".rate").focus().select();
            else if (current.hasClass("rate")) row.find(".freeqty").focus().select();
            else if (current.hasClass("freeqty")) row.find(".qty").focus().select();
            else if (current.hasClass("qty")) row.find(".batch").focus().select();
            else if (current.hasClass("batch")) row.find(".item-input").focus();
        }

        if (e.key === "ArrowDown") {
            e.preventDefault();
            const nextRow = row.next("tr");
            if (!nextRow.length) return;

            if (current.hasClass("batch")) nextRow.find(".batch").focus().select();
            else if (current.hasClass("qty")) nextRow.find(".qty").focus().select();
            else if (current.hasClass("freeqty")) nextRow.find(".freeqty").focus().select();
            else if (current.hasClass("rate")) nextRow.find(".rate").focus().select();
            else if (current.hasClass("discount")) nextRow.find(".discount").focus().select();
        }

        if (e.key === "ArrowUp") {
            e.preventDefault();
            const prevRow = row.prev("tr");

            if (!prevRow.length) {
                $("#PartyBillDate").focus();
                return;
            }

            if (current.hasClass("batch")) prevRow.find(".batch").focus().select();
            else if (current.hasClass("qty")) prevRow.find(".qty").focus().select();
            else if (current.hasClass("freeqty")) prevRow.find(".freeqty").focus().select();
            else if (current.hasClass("rate")) prevRow.find(".rate").focus().select();
            else if (current.hasClass("discount")) prevRow.find(".discount").focus().select();
        }
    });
</script>

<!-- ================================================================
     🔹 ADD ROW & REMOVE ROW
     ================================================================ -->
<script>
    $(document).ready(function() {
        $("#addRow").click(function() {
            if (!validateHeaderFields()) return;

            if ($("#PurchaseItemBody tr").length > 0) {
                if (!validateAllRows()) return;
            }

            let invalidRow = null;
            $("#PurchaseItemBody tr").each(function () {
                if ($(this).attr("data-itemdetail-valid") !== "true") {
                    invalidRow = $(this);
                    return false;
                }
            });

            if (ENABLE_ITEM_DETAIL_VALIDATION && invalidRow) {
                currentRow = invalidRow;
                selectedRow = invalidRow;
                popupOpen = true;
                openItemDetailModal();
                return;
            }

            addNewRow();
            setTimeout(() => $("#PurchaseItemBody tr:last .item-input").focus(), 150);
        });

        initializeExistingItemRows();
    });

    function initializeExistingItemRows() {
        if (!Array.isArray(existingStockReceiveItems) || existingStockReceiveItems.length === 0) {
            calculateTotalSummary();
            return;
        }

        $("#PurchaseItemBody").html("");
        rowIndex = 0;

        existingStockReceiveItems.forEach(function (item) {
            addNewRow(item);
        });

        calculateTotalSummary();
    }

    function addNewRow(item = null) {
        let purchasetype = $("#purchasetype").val();
        let newRow = `
            <tr data-itemdetail-valid="false">
                <td style="min-width:250px;">
                    <input type="hidden" name="StockReceiveItemVMs[${rowIndex}].Id" class="row-id" value="0" />
                   <input type="hidden" name="StockReceiveItemVMs[${rowIndex}].PurchaseItemId" class="purchase-item-id" />
            <input type="hidden" name="StockReceiveItemVMs[${rowIndex}].ItemMasterId" class="item-id" />
                   <input type="hidden" name="StockReceiveItemVMs[${rowIndex}].SourcePurchaseChallanId" class="source-purchase-challan-id" />
                   <input type="text" name="StockReceiveItemVMs[${rowIndex}].ItemName" class="form-control form-control-sm item-input" placeholder="Press Enter to select item" />
                </td>
                <td>
                  <input name="StockReceiveItemVMs[${rowIndex}].Batch" class="form-control form-control-sm batch" />
                </td>
                <td hidden>
            <input type="text" name="StockReceiveItemVMs[${rowIndex}].Expirydate" class="form-control form-control-sm expirydate" placeholder="MM/YYYY" maxlength="7" />
                </td>
                <td hidden><input name="StockReceiveItemVMs[${rowIndex}].Mrp" class="form-control form-control-sm mrp" /></td>
                <td><input name="StockReceiveItemVMs[${rowIndex}].Qty" class="form-control form-control-sm qty" value="1" /></td>
                <td><input name="StockReceiveItemVMs[${rowIndex}].FreeQty" class="form-control form-control-sm freeqty" value="0" /></td>
                <td><input name="StockReceiveItemVMs[${rowIndex}].Rate" class="form-control form-control-sm rate" /></td>
        <td hidden><input name="StockReceiveItemVMs[${rowIndex}].SalesRateA" class="form-control form-control-sm salserateA" /></td>
        <td hidden><input name="StockReceiveItemVMs[${rowIndex}].SalesRateB" class="form-control form-control-sm salserateB" /></td>
                <td hidden style="min-width:100px;">
                    <select name="StockReceiveItemVMs[${rowIndex}].HsnId" class="form-control form-control-sm hsn-dropdown">
                        <option value="">-- Select Item --</option>
        @foreach (var item in ViewBag.Hsn)
        {
                                                                            <option value="@item.Value">@item.Text</option>
        }
                    </select>
                </td>
                <td><input name="StockReceiveItemVMs[${rowIndex}].Discount" class="form-control form-control-sm discount" value="0" min="0" max="100" step="0.01" /></td>
                <td hidden><input name="StockReceiveItemVMs[${rowIndex}].DiscountAmt" class="form-control form-control-sm discount-amt" readonly /></td>
                <td class="gst-col"><input name="StockReceiveItemVMs[${rowIndex}].Gst" class="form-control form-control-sm gst" readonly /></td>
                <td hidden><input name="StockReceiveItemVMs[${rowIndex}].GstAmount" class="form-control form-control-sm gstamt" readonly /></td>
                <td hidden><input name="StockReceiveItemVMs[${rowIndex}].CGst" class="form-control form-control-sm cgst" readonly /></td>
                <td hidden><input name="StockReceiveItemVMs[${rowIndex}].CGstAmount" class="form-control form-control-sm cgstamt" readonly /></td>
                <td hidden><input name="StockReceiveItemVMs[${rowIndex}].SGst" class="form-control form-control-sm sgst" readonly /></td>
                <td hidden><input name="StockReceiveItemVMs[${rowIndex}].SGstAmount" class="form-control form-control-sm sgstamt" readonly /></td>
                <td class="scgst-col"><input name="StockReceiveItemVMs[${rowIndex}].SCGst" class="form-control form-control-sm scgst" readonly /></td>
                <td><input name="StockReceiveItemVMs[${rowIndex}].Cess" class="form-control form-control-sm cess" readonly /></td>
        <td><input name="StockReceiveItemVMs[${rowIndex}].Amount" class="form-control form-control-sm total" readonly /></td>
                <td hidden><input name="StockReceiveItemVMs[${rowIndex}].BatchWiseCose" class="form-control form-control-sm batch-wise" readonly /></td>
                <td hidden><input name="StockReceiveItemVMs[${rowIndex}].Barcode" class="form-control form-control-sm barcode" readonly /></td>
                <td><u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u></td>
            </tr>`;

        $("#PurchaseItemBody").append(newRow);

        let $newTr = $("#PurchaseItemBody tr:last");

        if (item) {
            const itemId = readValue(item, "itemId", "ItemId", "itemMasterId", "ItemMasterId");
            const itemName = readValue(item, "itemName", "ItemName");
            const sourcePurchaseChallanId = readValue(item, "sourcePurchaseChallanId", "SourcePurchaseChallanId");
            const purchaseItemId = readValue(item, "purchaseItemId", "PurchaseItemId");
            const stockReceiveItemId = readValue(item, "id", "Id");

            $newTr.find(".row-id").val(stockReceiveItemId || 0);
            $newTr.find(".purchase-item-id").val(purchaseItemId || "");
            $newTr.find(".item-id").val(itemId || 0);
            $newTr.find(".item-input").val(itemName || "");
            $newTr.find(".source-purchase-challan-id").val(sourcePurchaseChallanId || "");

            $newTr.find(".qty").val(readValue(item, "qty", "Qty") || 0);
            $newTr.find(".freeqty").val(readValue(item, "freeQty", "FreeQty") || 0);
            $newTr.find(".rate").val(readValue(item, "rate", "Rate") || 0);
            $newTr.find(".mrp").val(readValue(item, "mrp", "Mrp") || 0);
            $newTr.find(".batch").val(readValue(item, "batch", "Batch") || "");
            $newTr.find(".expirydate").val(formatExpiryDateForInput(readValue(item, "expiryDate", "ExpiryDate", "Expirydate")));
            $newTr.find(".salserateA").val(readValue(item, "salserateA", "salesRateA", "SalesRateA") || 0);
            $newTr.find(".salserateB").val(readValue(item, "salserateB", "salesRateB", "SalesRateB") || 0);
            $newTr.find(".batch-wise").val(readValue(item, "batchWiseCose", "BatchWiseCose") || 0);
            $newTr.find(".barcode").val(readValue(item, "barcode", "Barcode") || "");

            $newTr.find(".discount").val(readValue(item, "discount", "Discount") || 0);
            $newTr.find(".gst").val(readValue(item, "gst", "Gst") || 0);
            $newTr.find(".cgst").val(readValue(item, "cgst", "CGst", "cGst") || 0);
            $newTr.find(".sgst").val(readValue(item, "sgst", "SGst", "sGst") || 0);
            $newTr.find(".scgst").val(readValue(item, "scgst", "SCGst", "scGst") || 0);
            $newTr.find(".cess").val(readValue(item, "cess", "Cess") || 0);
            $newTr.find(".hsn-dropdown").val(readValue(item, "hsnId", "HsnId") || "");

            if (sourcePurchaseChallanId) {
                $newTr.attr("data-source-item-name", itemName || "");
            }

            $newTr.attr("data-itemdetail-valid", "true");
        }

        if (purchasetype === "Local") {

            $newTr.find(".gst-col").hide();
            $newTr.find(".scgst-col").show();

        } else {

            $newTr.find(".gst-col").show();
            $newTr.find(".scgst-col").hide();

        }
         calculateRow($newTr);
        rowIndex++;
    }

    $(document).on("click", ".remove-row-btn", function() {
        $(this).closest("tr").remove();
        calculateTotalSummary();
    });
</script>

<script>
    $(document).on("keydown", ".item-input, .batch, .qty, .freeqty, .rate, .discount", function (e) {
        if (e.key !== "Tab") return;

        const row = $(this).closest("tr");

