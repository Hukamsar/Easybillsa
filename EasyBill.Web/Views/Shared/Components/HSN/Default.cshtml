        max-width: 600px; /* Maximum width */
        min-width: 300px; /* Minimum width */
        background: white;
        padding: 20px;
        box-shadow: 0px 4px 8px rgba(0,0,0,0.2);
        border-radius: 5px;
        z-index: 1000;
