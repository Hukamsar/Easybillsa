 <div id="hsnpopup" class="popup">
	<div class="popup-content">
		<h2>Add HSN/SAC</h2>
		<form id="hsnform">
            <div class="row">
                <div class="col-md-6">
                    <label>HSN Code *</label>
                    <input type="text" name="HsnCode" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label>SGST (%)</label>
                    <input type="number" name="SGST" class="form-control" required step="0.01" />
                </div>
                <div class="col-md-6">
                    <label>CGST (%)</label>
                    <input type="number" name="CGST" class="form-control" required step="0.01" />
                </div>
                <div class="col-md-6">
                    <label>IGST (%)</label>
                    <input type="number" name="IGST" class="form-control" required step="0.01" />
                </div>
                <div class="col-md-6">
                    <label>Cess (%)</label>
                    <input type="number" name="Cess" class="form-control" required step="0.01" />
                </div>
                <div class="col-md-6">
                    <label>HSN Type *</label>
                    <select name="HsnType" class="form-control">
                        <option value="" disabled selected>Select HSN Type</option>
                        <option value="1">Goods</option>
                        <option value="2">Services</option>
                    </select>
                </div>
            </div>
            
            <br />
            <button type="button" class="btn btn-success" onclick="savehsn()">Save</button>
            <button type="button" class="btn btn-danger" onclick="closehsnpopup()">Close</button>
		</form>
	 </div>
 </div>

