                           style="border-radius: 20px; font-size: 0.7rem; padding: 0.35rem 0.8rem; border: 1px solid #1d4ed8; font-weight: 600;"
                           title="Open wallet recharge page">
                            <i class="bi bi-wallet2 me-1"></i> Wallet
                        </a>
                    </li>
                    <!-- Fullscreen Toggle -->
                    <li class="nav-item">
                        <a class="nav-link" href="#" data-lte-toggle="fullscreen">
                            <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                            <i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display: none"></i>
                        </a>
                    </li>
                 
                    <!-- User Menu -->
                    <li class="nav-item dropdown user-menu">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            <img src="~/assets/img/easybill-profile.jpg"
                                 class="user-image rounded-circle shadow"
                                 alt="User Image" />
                        </a>
                        <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                            <li class="user-header text-bg-primary">
                                <img src="~/assets/img/easybill-Sidebar.jpg"
                                     class="rounded-circle shadow"
                                     alt="User Image" />
                                @* <p>
                                    EasyBill
                                    <small>Digitising Businesses</small>
                                </p> *@
                                <h6 class="mt-2 mb-0">
                                    @if (user != null && user.TenantId != null)
                                    {
                                        var companyData = await _companyService.GetById(user.TenantId); 
                                        @user?.UserName
                                    }
                                </h6>
                            </li>
                            <li class="user-footer">
                                <button type="button" class="btn btn-default btn-flat" id="btnProfile">
                                    Profile
                                </button>
                                <form asp-controller="Account" asp-action="Logout" method="post"
