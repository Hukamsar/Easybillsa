                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 fw-bold" id="lblCurrentPlanName" style="font-size: 0.85rem;">Free Trial</span>
                        </div>
                    </div>

                    <!-- Pending Upgrade Alert / Redeem Panel -->
                    <div id="pendingUpgradeAlertSection" style="display: none;" class="mb-4"></div>

                    <!-- Main Selection Section (Plans vs Staff bundles) -->
                    <div id="mainSelectionSection">
                        <!-- Tabs -->
                        <ul class="nav nav-tabs border-bottom mb-4" id="modalUpgradeTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-bold px-4 py-2 border-0" id="tab-upgrade-plans-nav" data-bs-toggle="tab" data-bs-target="#tab-upgrade-plans" type="button" role="tab" aria-selected="true" style="border-bottom: 3px solid #1d4ed8 !important; color: #1d4ed8; background: transparent;">
                                    <i class="bi bi-rocket-takeoff-fill me-1"></i> Upgrade Plans
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold px-4 py-2 border-0" id="tab-add-staff-nav" data-bs-toggle="tab" data-bs-target="#tab-add-staff" type="button" role="tab" aria-selected="false" style="color: #64748b; background: transparent; border-bottom: none !important;">
                                    <i class="bi bi-people-fill me-1"></i> Add Extra Staff
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="modalUpgradeTabsContent">
                            <!-- Tab 1: Upgrade Plans -->
                            <div class="tab-pane fade show active" id="tab-upgrade-plans" role="tabpanel" aria-labelledby="tab-upgrade-plans-nav">
                                <!-- Billing Cycle Toggle -->
                                <div class="d-flex justify-content-center align-items-center gap-3 mb-4">
                                    <span class="fw-semibold text-muted" id="billingCycleLabelMonthly">Monthly Billing</span>
                                    <div class="form-check form-switch form-switch-lg m-0">
                                        <input class="form-check-input" type="checkbox" role="switch" id="switchBillingCycle" style="cursor: pointer;">
                                    </div>
                                    <span class="fw-semibold text-primary d-flex align-items-center" id="billingCycleLabelYearly">
                                        Yearly Billing <span class="badge bg-success text-white ms-2" style="font-size: 0.65rem;">Save ~16%</span>
                                    </span>
                                </div>

                                <!-- Upgrade Cards Container -->
                                <div class="row row-cols-1 row-cols-md-3 g-4" id="plansContainer">
                                    <!-- Plans will be rendered here dynamically -->
                                    <div class="col-12 text-center py-5" id="plansLoader">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        <p class="mt-2 text-muted fw-semibold">Fetching available upgrade plans...</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 2: Add Extra Staff -->
                            <div class="tab-pane fade" id="tab-add-staff" role="tabpanel" aria-labelledby="tab-add-staff-nav">
                                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 mt-1" id="extraStaffCardsContainer">
                                    <!-- Dynamic Extra Staff Cards will be rendered here -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: CHECKOUT & PAYMENT OPTIONS -->
                    <div id="checkoutSection" style="display: none;">
                        <button type="button" class="btn btn-link text-secondary fw-bold p-0 mb-3 text-decoration-none d-flex align-items-center gap-1" id="btnBackToPlans">
                            <i class="bi bi-arrow-left"></i> Back
                        </button>

                        <div class="row g-4">
                            <!-- Left: Order Summary -->
                            <div class="col-md-5">
                                <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px; background: white;">
                                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">Order Summary</h6>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted small">Selected Plan:</span>
                                        <span class="fw-bold text-dark" id="summaryPlanName">-</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted small">Billing Cycle:</span>
                                        <span class="fw-semibold text-muted text-capitalize" id="summaryBillingCycle">-</span>
                                    </div>
                                    <hr class="my-3 border-secondary-subtle">
                                    <div class="d-flex justify-content-between mb-2 align-items-baseline">
                                        <span class="fw-bold text-dark">Price:</span>
                                        <span class="fw-extrabold text-primary fs-4" id="summaryTotalPrice">₹0.00</span>
                                    </div>
                                    <div class="bg-primary bg-opacity-5 p-3 rounded-3 mt-4 text-primary d-flex align-items-center gap-2">
                                        <i class="bi bi-shield-lock-fill fs-4 text-success"></i>
                                        <div class="text-start">
                                            <div class="fw-bold small text-dark" style="line-height:1.2;">Secure Checkout</div>
                                            <div class="text-muted" style="font-size:0.72rem; line-height:1.2;">Upgrades take effect instantly upon successful payment.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Payment Methods Selection -->
                            <div class="col-md-7">
                                <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px; background: white;">
                                    <h6 class="fw-bold text-dark mb-3 border-bottom pb-2">Select Payment Method</h6>
                                    <div class="d-flex flex-column gap-3">
                                        
                                        <!-- Option 1: Wallet -->
                                        <div class="payment-option-card p-3 rounded-3 border active" id="payCardWallet">
                                            <div class="form-check w-100 m-0">
                                                <input class="form-check-input" type="radio" name="paymentOption" id="payOptWallet" checked>
                                                <label class="form-check-label w-100 cursor-pointer ms-2" for="payOptWallet">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <span class="fw-bold text-dark d-block">Company Wallet Balance</span>
                                                            <span class="small text-muted" id="payWalletBalanceLabel">Available Balance: ₹0.00</span>
                                                        </div>
                                                        <i class="bi bi-wallet2 text-primary fs-4"></i>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Option 2: Direct Gateway (Simulated) -->
                                        <div class="payment-option-card p-3 rounded-3 border" id="payCardGateway">
                                            <div class="form-check w-100 m-0">
                                                <input class="form-check-input" type="radio" name="paymentOption" id="payOptGateway">
                                                <label class="form-check-label w-100 cursor-pointer ms-2" for="payOptGateway">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <span class="fw-bold text-dark d-block">Direct Payment (UPI / Card)</span>
                                                            <span class="small text-muted">Pay instantly using Credit Card or UPI app</span>
                                                        </div>
                                                        <div class="text-primary fs-4">
                                                            <i class="bi bi-credit-card-2-back-fill me-1"></i>
                                                            <i class="bi bi-phone-fill"></i>
                                                        </div>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Nested Direct Payment Details -->
                                        <div id="gatewayPaymentDetails" class="payment-sub-tab mt-0 ms-2 p-3 rounded-3 border bg-light" style="display: none;">
                                            <ul class="nav nav-pills nav-fill mb-3" id="directPayTabs" role="tablist">
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link active" id="upi-tab" data-bs-toggle="tab" data-bs-target="#tab-upi" type="button" role="tab" aria-selected="true"><i class="bi bi-phone me-1"></i> UPI Payment</button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link" id="card-tab" data-bs-toggle="tab" data-bs-target="#tab-card" type="button" role="tab" aria-selected="false"><i class="bi bi-credit-card me-1"></i> Card Payment</button>
                                                </li>
                                            </ul>
                                            <div class="tab-content" id="directPayTabsContent">
                                                <!-- UPI Tab -->
                                                <div class="tab-pane fade show active" id="tab-upi" role="tabpanel">
                                                    <div class="mb-2 text-start">
                                                        <label class="form-label small fw-bold text-muted mb-1">Enter UPI ID</label>
                                                        <input type="text" class="form-control form-control-sm" id="txtDirectUPI" placeholder="e.g. name@@upi" value="demo@@ybl">
                                                        <span class="text-muted" style="font-size: 0.65rem;">A payment request will be simulated to this UPI ID.</span>
                                                    </div>
                                                </div>
                                                <!-- Card Tab -->
                                                <div class="tab-pane fade" id="tab-card" role="tabpanel">
                                                    <div class="row g-2 text-start">
                                                        <div class="col-12">
                                                            <label class="form-label small fw-bold text-muted mb-0.5">Card Number</label>
                                                            <input type="text" class="form-control form-control-sm" id="txtDirectCardNo" placeholder="1234 5678 1234 5678" value="4111 1111 1111 1111">
                                                        </div>
                                                        <div class="col-6">
                                                            <label class="form-label small fw-bold text-muted mb-0.5">Expiry Date</label>
                                                            <input type="text" class="form-control form-control-sm" id="txtDirectCardExpiry" placeholder="MM/YY" value="12/29">
                                                        </div>
                                                        <div class="col-6">
                                                            <label class="form-label small fw-bold text-muted mb-0.5">CVV</label>
                                                            <input type="password" class="form-control form-control-sm" id="txtDirectCardCVV" placeholder="123" value="123">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Option 3: Manual QR Scan -->
                                        <div class="payment-option-card p-3 rounded-3 border" id="payCardManual">
                                            <div class="form-check w-100 m-0">
                                                <input class="form-check-input" type="radio" name="paymentOption" id="payOptManual">
                                                <label class="form-check-label w-100 cursor-pointer ms-2" for="payOptManual">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <span class="fw-bold text-dark d-block">Manual Payment (QR Scan)</span>
                                                            <span class="small text-muted">Scan scanner QR and enter Reference No</span>
                                                        </div>
                                                        <i class="bi bi-qr-code-scan text-primary fs-4"></i>
                                                    </div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Manual QR Details -->
                                        <div id="manualPaymentDetails" class="payment-sub-tab mt-0 ms-2 p-3 rounded-3 border bg-light text-center" style="display: none;">
                                            <div class="fw-bold small text-muted mb-2">Scan QR and Pay Exactly <span class="text-primary fw-bold" id="lblManualPayAmount">₹0.00</span></div>
                                            <img src="/assets/img/hukamsarbarcode.png" alt="Payment QR Code" style="max-width:140px; border-radius: 8px; border: 1px solid #dee2e6;" onerror="this.src='/assets1/images/loader/loaderGIF.gif'"/>
                                            <div class="mt-2 text-start">
                                                <label class="form-label small fw-bold text-muted mb-1">Transaction/UPI Reference Number <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control form-control-sm" id="txtManualRefNo" placeholder="Enter 12-digit transaction ID or Ref No">
                                            </div>
                                        </div>

                                    </div>

                                    <!-- Pay Button -->
                                    <div class="mt-4">
                                        <button type="button" class="btn btn-primary w-100 fw-bold py-2.5 shadow-sm" id="btnSubmitPayment" style="border-radius: 8px;">
                                            Complete Payment & Upgrade
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ── Subscription Plan Upgrade Flow ──
        $(document).ready(function () {
            let activePlans = [];
            let currentBillingCycle = 'monthly';
            let walletBalance = 0;
            let selectedPlanId = 0;
            let selectedPlanName = '';
            let selectedPlanPrice = 0;
            let checkoutType = 'plan'; // 'plan' or 'users'
            let selectedUsersCount = 0;
            let remainingMonths = 1;
            let licenceExpiryDate = '';

            $('#btnUpgradePlanHeader').on('click', function () {
                openUpgradeModal();
            });

            $('#switchBillingCycle').on('change', function () {
                currentBillingCycle = $(this).is(':checked') ? 'yearly' : 'monthly';
                renderUpgradePlans();
            });

            // Toggle tab active styling manually to keep UI ultra premium
            $('#tab-upgrade-plans-nav').on('click', function () {
                $(this).css({'border-bottom': '3px solid #1d4ed8', 'color': '#1d4ed8'});
                $('#tab-add-staff-nav').css({'border-bottom': 'none', 'color': '#64748b'});
            });
            $('#tab-add-staff-nav').on('click', function () {
                $(this).css({'border-bottom': '3px solid #1d4ed8', 'color': '#1d4ed8'});
                $('#tab-upgrade-plans-nav').css({'border-bottom': 'none', 'color': '#64748b'});
            });

            // Back to Plans Button click
            $('#btnBackToPlans').on('click', function () {
                $('#checkoutSection').slideUp(200, function () {
                    $('#mainSelectionSection').slideDown(200);
                    $('#sharedTenantBalancePanel').slideDown(200);
                });
            });

            // Handle payment option change
            $('input[name="paymentOption"]').on('change', function () {
                $('.payment-option-card').removeClass('active border-primary bg-primary-subtle bg-opacity-10 shadow-sm');
                $(this).closest('.payment-option-card').addClass('active border-primary bg-primary-subtle bg-opacity-10 shadow-sm');

                if ($(this).attr('id') === 'payOptGateway') {
                    $('#gatewayPaymentDetails').slideDown(200);
                } else {
                    $('#gatewayPaymentDetails').slideUp(200);
                }

                if ($(this).attr('id') === 'payOptManual') {
                    $('#manualPaymentDetails').slideDown(200);
                } else {
                    $('#manualPaymentDetails').slideUp(200);
                }
            });

            function openUpgradeModal() {
                // Reset views
                $('#checkoutSection').hide();
                $('#mainSelectionSection').show();
                $('#sharedTenantBalancePanel').show();
                $('#pendingUpgradeAlertSection').hide().empty();

                // Select default tab
                $('#tab-upgrade-plans-nav').trigger('click');
                bootstrap.Tab.getInstance(document.getElementById('tab-upgrade-plans-nav'))?.show();

                $('#plansContainer').html(`
                    <div class="col-12 text-center py-5">
                        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
                        <p class="mt-2 text-muted fw-semibold">Loading available plans...</p>
                    </div>
                `);
                $('#upgradePlanModal').modal('show');

                // Check pending upgrade/redemption status first
                $.ajax({
                    url: '/Subscription/GetPendingUpgradeStatus',
                    type: 'GET',
                    success: function (statusRes) {
                        if (statusRes.success) {
                            remainingMonths = statusRes.remainingMonths || 1;
                            licenceExpiryDate = statusRes.licenceExpiryDate || '';
                            walletBalance = statusRes.walletBalance || 0;

                            if (statusRes.pendingAdminRequest) {
                                // Show Pending Admin Request Alert
                                $('#mainSelectionSection').hide();
                                $('#sharedTenantBalancePanel').hide();
                                $('#pendingUpgradeAlertSection').html(`
                                    <div class="card border-0 shadow-sm" style="border-radius: 16px; background: #fffbeb; border: 1.5px solid #fde68a !important;">
                                        <div class="card-body p-4 text-center">
                                            <div class="bg-warning bg-opacity-10 p-3 rounded-circle mx-auto mb-3 text-warning d-flex align-items-center justify-content-center" style="width: 65px; height: 65px;">
                                                <i class="bi bi-hourglass-split fs-2"></i>
                                            </div>
                                            <h5 class="fw-bold text-dark mb-2">Upgrade Awaiting Approval</h5>
                                            <p class="text-muted small px-3">
                                                You have requested <strong>${statusRes.pendingAdminRequestCount} Extra Staff</strong> slots. 
                                                This request is currently awaiting approval from the SuperAdmin. 
                                                Please check back once the SuperAdmin approves or rejects the purchase.
                                            </p>
                                            <div class="mt-4">
                                                <button type="button" class="btn btn-outline-secondary px-4 fw-bold" data-bs-dismiss="modal" style="border-radius: 8px;">Close</button>
                                            </div>
                                        </div>
                                    </div>
                                `).slideDown(200);
                            } else if (statusRes.pendingSaUpgrade) {
                                // Show Pending SA Upgrade Redemption Panel
                                $('#mainSelectionSection').hide();
                                $('#sharedTenantBalancePanel').hide();
                                $('#pendingUpgradeAlertSection').html(`
                                    <div class="card border-0 shadow-sm" style="border-radius: 16px; background: #f0fdf4; border: 1.5px solid #bbf7d0 !important;">
                                        <div class="card-body p-4 text-center">
                                            <div class="bg-success bg-opacity-10 p-3 rounded-circle mx-auto mb-3 text-success d-flex align-items-center justify-content-center" style="width: 65px; height: 65px;">
                                                <i class="bi bi-gift fs-2"></i>
                                            </div>
                                            <h5 class="fw-bold text-dark mb-2">Extra Staff Slots Ready!</h5>
                                            <p class="text-muted small px-3">
                                                SuperAdmin has assigned <strong>${statusRes.pendingSaUpgradeCount} Extra Staff</strong> slots to your workspace. 
                                                Click below to redeem and activate these slots immediately.
                                            </p>
                                            <div class="mt-4 d-flex justify-content-center gap-3">
                                                <button type="button" class="btn btn-outline-secondary px-4 fw-bold" data-bs-dismiss="modal" style="border-radius: 8px;">Cancel</button>
                                                <button type="button" class="btn btn-success px-5 fw-bold" id="btnRedeemSaUpgrade" style="border-radius: 8px;">
                                                    Redeem Extra Staff
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                `).slideDown(200);

                                // Bind Redeem Click Handler
                                $('#btnRedeemSaUpgrade').on('click', function () {
                                    $('#upgradePlanModal').modal('hide');
                                    showLoader("Activating your staff slots...");
                                    $.ajax({
                                        url: '/Subscription/RedeemSaUpgrade',
                                        type: 'POST',
                                        success: function (redeemRes) {
                                            hideLoader();
                                            if (redeemRes.success) {
                                                Swal.fire({
                                                    icon: 'success',
                                                    title: 'Redeemed Successfully!',
                                                    text: redeemRes.message + ' Logging out to apply updates...',
                                                    timer: 3000,
                                                    showConfirmButton: false
                                                }).then(() => {
                                                    let form = document.querySelector('form[action*="/Account/Logout"]');
                                                    if (form) {
                                                        form.submit();
                                                    } else {
                                                        window.location.reload();
                                                    }
                                                });
                                            } else {
                                                Swal.fire("Redemption Failed", redeemRes.message, "error");
                                            }
                                        },
                                        error: function () {
                                            hideLoader();
                                            Swal.fire("Error", "Could not complete the redemption request.", "error");
                                        }
                                    });
                                });
                            } else {
                                // No pending actions, fetch available plans
                                $.ajax({
                                    url: '/Subscription/GetUpgradePlans',
                                    type: 'GET',
                                    success: function (res) {
                                        if (res.success) {
                                            activePlans = res.plans;
                                            walletBalance = res.walletBalance;
                                            $('#lblWalletBalance').text('₹' + walletBalance.toFixed(2));
                                            $('#lblCurrentPlanName').text(res.currentPlan ? res.currentPlan.planName : 'Free Trial');
                                            renderUpgradePlans();
                                            renderExtraStaffCards();
                                        } else {
                                            Swal.fire("Error", res.message, "error");
                                            $('#upgradePlanModal').modal('hide');
                                        }
                                    },
                                    error: function () {
                                        Swal.fire("Error", "Could not fetch subscription plans. Please try again.", "error");
                                        $('#upgradePlanModal').modal('hide');
                                    }
                                });
                            }
                        } else {
                            Swal.fire("Error", statusRes.message, "error");
                            $('#upgradePlanModal').modal('hide');
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Could not check account subscription status.", "error");
                        $('#upgradePlanModal').modal('hide');
                    }
                });
            }

            function renderUpgradePlans() {
                let container = $('#plansContainer');
                container.empty();

                if (activePlans.length === 0) {
                    container.html(`
                        <div class="col-12 text-center py-5">
                            <div class="bg-light p-4 rounded-3 d-inline-block border border-secondary-subtle">
                                <i class="bi bi-info-circle text-muted fs-3"></i>
                                <h6 class="mt-2 fw-bold text-dark">No Upgrades Available</h6>
                                <p class="text-muted small mb-0">You are already on our highest tier plan!</p>
                            </div>
                        </div>
                    `);
                    return;
                }

                activePlans.forEach(plan => {
                    let price = currentBillingCycle === 'yearly' ? plan.yearlyPrice : plan.monthlyPrice;
                    let periodLabel = currentBillingCycle === 'yearly' ? '/ year' : '/ month';
                    let yearlySavings = '';
                    if (currentBillingCycle === 'yearly') {
                        let monthlyCostSum = plan.monthlyPrice * 12;
                        let savings = monthlyCostSum - plan.yearlyPrice;
                        if (savings > 0) {
                            yearlySavings = `<span class="badge bg-success-subtle text-success border border-success-subtle ms-2" style="font-size: 0.65rem;">Save ₹${savings.toFixed(0)}</span>`;
                        }
                    }

                    // Render features checklist
                    let featuresListHtml = '';
                    plan.features.forEach(feat => {
                        featuresListHtml += `
                            <li class="d-flex align-items-center mb-2 text-dark" style="font-size: 0.85rem;">
                                <i class="bi bi-check-circle-fill text-success me-2" style="font-size: 0.95rem;"></i>
                                <span>${feat}</span>
                            </li>
                        `;
                    });

                    let cardHtml = `
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm transition-hover card-plan" style="border-radius: 14px; background: white;">
                                <div class="card-body p-4 d-flex flex-column">
                                     <!-- Plan Title & Price -->
                                    <div class="mb-3">
                                        <h5 class="fw-bold text-dark mb-1">${plan.planName}</h5>
                                        <div class="d-flex align-items-baseline mt-2">
                                            <span class="fs-3 fw-extrabold text-primary">₹${price.toFixed(2)}</span>
                                            <span class="text-muted small ms-1">${periodLabel}</span>
                                            ${yearlySavings}
                                        </div>
                                    </div>

                                    <!-- Plan Limits / Details -->
                                    <div class="bg-light p-3 rounded-3 mb-3 border border-secondary-subtle">
                                        <div class="d-flex justify-content-between mb-1.5" style="font-size: 0.78rem;">
                                            <span class="text-muted">Desktop Logins</span>
                                            <span class="fw-semibold text-dark">${plan.maxDesktopLogins} Max</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1.5" style="font-size: 0.78rem;">
                                            <span class="text-muted">Mobile Logins</span>
                                            <span class="fw-semibold text-dark">${plan.maxMobileLogins} Max</span>
                                        </div>
                                        <div class="d-flex justify-content-between" style="font-size: 0.78rem;">
                                            <span class="text-muted">Daily Customer Limit</span>
                                            <span class="fw-semibold text-dark">${plan.dailyCustomerLimit} Daily</span>
                                        </div>
                                    </div>

                                    <!-- Features Toggle -->
                                    <div class="mt-2 mb-3">
                                        <button class="btn btn-link text-primary fw-bold p-0 text-decoration-none d-flex align-items-center gap-1 btn-toggle-features" type="button" style="font-size: 0.8rem;">
                                            <span>View Features</span> <i class="bi bi-chevron-down fs-xs"></i>
                                        </button>
                                        <div class="features-list-wrapper mt-3" style="display: none;">
                                            <ul class="list-unstyled mb-0">
                                                ${featuresListHtml}
                                            </ul>
                                        </div>
                                    </div>

                                    <!-- Upgrade Button -->
                                    <div class="mt-auto pt-3">
                                        <button type="button" class="btn btn-primary w-100 fw-bold py-2 shadow-sm btn-upgrade-submit" data-plan-id="${plan.id}" data-plan-name="${plan.planName}" data-price="${price}" style="border-radius: 8px;">
                                            Upgrade Now
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    container.append(cardHtml);
                });

                // Bind features toggle
                $('.btn-toggle-features').off('click').on('click', function () {
                    let wrapper = $(this).next('.features-list-wrapper');
                    let icon = $(this).find('i');
                    wrapper.slideToggle(200);
                    if (icon.hasClass('bi-chevron-down')) {
                        icon.removeClass('bi-chevron-down').addClass('bi-chevron-up');
                    } else {
                        icon.removeClass('bi-chevron-up').addClass('bi-chevron-down');
                    }
                });

                // Bind upgrade submit -> Opens Checkout View
                $('.btn-upgrade-submit').off('click').on('click', function () {
                    checkoutType = 'plan';
                    selectedPlanId = $(this).data('plan-id');
                    selectedPlanName = $(this).data('plan-name');
                    selectedPlanPrice = parseFloat($(this).data('price'));

                    // Setup Checkout Summary
                    $('#summaryPlanName').text(selectedPlanName);
                    $('#summaryBillingCycle').text(currentBillingCycle);
                    $('#summaryTotalPrice').text('₹' + selectedPlanPrice.toFixed(2));
                    $('#lblManualPayAmount').text('₹' + selectedPlanPrice.toFixed(2));

                    // Reset manual ref
                    $('#txtManualRefNo').val('');

                    // Evaluate Wallet Option Availability
                    if (walletBalance < selectedPlanPrice) {
                        // Disable Wallet
                        $('#payOptWallet').prop('disabled', true);
                        $('#payCardWallet').addClass('disabled-card').removeClass('active border-primary bg-primary-subtle bg-opacity-10 shadow-sm');
                        $('#payWalletBalanceLabel').text('Available Balance: ₹' + walletBalance.toFixed(2) + ' (Insufficient)');
                        
                        // Select and trigger Gateway
                        $('#payOptGateway').prop('checked', true).trigger('change');
                    } else {
                        // Enable Wallet
                        $('#payOptWallet').prop('disabled', false);
                        $('#payCardWallet').removeClass('disabled-card');
                        $('#payWalletBalanceLabel').text('Available Balance: ₹' + walletBalance.toFixed(2));
                        
                        // Select Wallet
                        $('#payOptWallet').prop('checked', true).trigger('change');
                    }

                    // Toggle Section Views
                    $('#mainSelectionSection').slideUp(200);
                    $('#sharedTenantBalancePanel').slideUp(200);
                    $('#checkoutSection').slideDown(200);
                });
            }

            // Bind Add Extra Staff Bundle Click -> Opens Checkout View
            $(document).on('click', '.btn-purchase-users-submit', function () {
                checkoutType = 'users';
                selectedUsersCount = parseInt($(this).data('count'));
                selectedPlanName = selectedUsersCount + " Extra Staff (Users)";
                selectedPlanPrice = parseFloat($(this).data('cost'));

                // Setup Checkout Summary
                $('#summaryPlanName').text(selectedPlanName);
                $('#summaryBillingCycle').text(remainingMonths + (remainingMonths === 1 ? ' Month' : ' Months') + ' (Aligns with License)');
                $('#summaryTotalPrice').text('₹' + selectedPlanPrice.toFixed(2));
                $('#lblManualPayAmount').text('₹' + selectedPlanPrice.toFixed(2));

                // Reset manual ref
                $('#txtManualRefNo').val('');

                // Evaluate Wallet Option Availability
                if (walletBalance < selectedPlanPrice) {
                    // Disable Wallet
                    $('#payOptWallet').prop('disabled', true);
                    $('#payCardWallet').addClass('disabled-card').removeClass('active border-primary bg-primary-subtle bg-opacity-10 shadow-sm');
                    $('#payWalletBalanceLabel').text('Available Balance: ₹' + walletBalance.toFixed(2) + ' (Insufficient)');
                    
                    // Select and trigger Gateway
                    $('#payOptGateway').prop('checked', true).trigger('change');
                } else {
                    // Enable Wallet
                    $('#payOptWallet').prop('disabled', false);
                    $('#payCardWallet').removeClass('disabled-card');
                    $('#payWalletBalanceLabel').text('Available Balance: ₹' + walletBalance.toFixed(2));
                    
                    // Select Wallet
                    $('#payOptWallet').prop('checked', true).trigger('change');
                }

                // Toggle Section Views
                $('#mainSelectionSection').slideUp(200);
                $('#sharedTenantBalancePanel').slideUp(200);
                $('#checkoutSection').slideDown(200);
            });

            // Handle Complete Payment Button
            $('#btnSubmitPayment').on('click', function () {
                let selectedMethod = $('input[name="paymentOption"]:checked').attr('id');

                if (selectedMethod === 'payOptWallet') {
                    // Pay via Wallet
                    Swal.fire({
                        title: 'Confirm Wallet Payment',
                        text: checkoutType === 'plan'
                            ? `Upgrade to ${selectedPlanName} (${currentBillingCycle})? An amount of ₹${selectedPlanPrice.toFixed(2)} will be deducted from your wallet balance.`
                            : `Purchase ${selectedPlanName}? An amount of ₹${selectedPlanPrice.toFixed(2)} will be deducted from your wallet balance.`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, Pay Now',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#1d4ed8',
                        cancelButtonColor: '#dc3545',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            if (checkoutType === 'plan') {
                                performUpgrade(selectedPlanId, currentBillingCycle, 'Wallet');
                            } else {
                                performPurchaseExtraUsers(selectedUsersCount, 'Wallet');
                            }
                        }
                    });
                }
                else if (selectedMethod === 'payOptManual') {
                    // Pay via Manual QR code
                    let refNo = $('#txtManualRefNo').val().trim();
                    if (!refNo) {
                        Swal.fire("Reference Number Required", "Please enter the Transaction/UPI Reference Number to verify your manual payment.", "warning");
                        return;
                    }

                    Swal.fire({
                        title: 'Confirm Manual Payment',
                        html: checkoutType === 'plan'
                            ? `Upgrade to <b>${selectedPlanName}</b> (${currentBillingCycle})?<br>Your payment reference <b>${refNo}</b> will be submitted for validation.`
                            : `Purchase <b>${selectedPlanName}</b>?<br>Your payment reference <b>${refNo}</b> will be submitted for validation.`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Submit & Complete',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#1d4ed8',
                        cancelButtonColor: '#dc3545',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            if (checkoutType === 'plan') {
                                performUpgrade(selectedPlanId, currentBillingCycle, 'Manual', refNo);
                            } else {
                                performPurchaseExtraUsers(selectedUsersCount, 'Manual', refNo);
                            }
                        }
                    });
                }
                else if (selectedMethod === 'payOptGateway') {
                    // Simulate Online Gateway Checkout
                    let isUpi = $('#upi-tab').hasClass('active');
                    let upiId = $('#txtDirectUPI').val().trim();
                    let cardNo = $('#txtDirectCardNo').val().trim();

                    if (isUpi && !upiId) {
                        Swal.fire("UPI ID Required", "Please enter your UPI ID.", "warning");
                        return;
                    }
                    if (!isUpi && !cardNo) {
                        Swal.fire("Card Details Required", "Please enter your card number.", "warning");
                        return;
                    }

                    // Display secure gateway simulation
                    $('#upgradePlanModal').modal('hide');
                    
                    Swal.fire({
                        title: 'Securing Connection...',
                        html: '<div class="mt-2"><div class="spinner-border text-primary mb-3"></div><p class="small text-muted">Establishing a secure connection with payment gateway...</p></div>',
                        allowOutsideClick: false,
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => {
                        Swal.fire({
                            title: 'Authorizing Transaction...',
                            html: `<div class="mt-2"><div class="spinner-border text-info mb-3"></div><p class="small text-muted">Requesting authorization for ₹${selectedPlanPrice.toFixed(2)} from bank...</p></div>`,
                            allowOutsideClick: false,
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            Swal.fire({
                                title: 'Verifying Signature...',
                                html: '<div class="mt-2"><div class="spinner-border text-success mb-3"></div><p class="small text-muted">Completing cryptographic transaction handshake...</p></div>',
                                allowOutsideClick: false,
                                showConfirmButton: false,
                                timer: 1200
                            }).then(() => {
                                // Trigger actual controller upgrade request
                                let simulatedRef = 'SIM-GW-' + Date.now();
                                if (checkoutType === 'plan') {
                                    performUpgrade(selectedPlanId, currentBillingCycle, 'Gateway', simulatedRef);
                                } else {
                                    performPurchaseExtraUsers(selectedUsersCount, 'Gateway', simulatedRef);
                                }
                            });
                        });
                    });
                }
            });

            function performUpgrade(planId, cycle, paymentMode, referenceNo) {
                $('#upgradePlanModal').modal('hide');
                showLoader("Upgrading subscription plan...");

                $.ajax({
                    url: '/Subscription/Upgrade',
                    type: 'POST',
                    data: { 
                        planId: planId, 
                        billingCycle: cycle,
                        paymentMode: paymentMode,
                        referenceNo: referenceNo
                    },
                    success: function (res) {
                        hideLoader();
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Upgrade Successful!',
                                text: 'Your plan has been upgraded. Logging out to apply new features...',
                                timer: 3000,
                                showConfirmButton: false
                            }).then(() => {
                                // Submit logout form to refresh security cookies/claims
                                let form = document.querySelector('form[action*="/Account/Logout"]');
                                if (form) {
                                    form.submit();
                                } else {
                                    window.location.reload();
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Upgrade Failed',
                                text: res.message
                            });
                        }
                    },
                    error: function () {
                        hideLoader();
                        Swal.fire("Error", "Could not complete the upgrade request. Please try again.", "error");
                    }
                });
            }

            function performPurchaseExtraUsers(count, paymentMode, referenceNo) {
                $('#upgradePlanModal').modal('hide');
                showLoader("Processing staff bundle purchase...");

                $.ajax({
                    url: '/Subscription/PurchaseExtraUsers',
                    type: 'POST',
                    data: { 
                        count: count, 
                        paymentMode: paymentMode,
                        referenceNo: referenceNo
                    },
                    success: function (res) {
                        hideLoader();
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Purchase Successful!',
                                text: res.message + ' Logging out to apply updates...',
                                timer: 3000,
                                showConfirmButton: false
                            }).then(() => {
                                // Submit logout form to refresh security cookies/claims
                                let form = document.querySelector('form[action*="/Account/Logout"]');
                                if (form) {
                                    form.submit();
                                } else {
                                    window.location.reload();
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Purchase Failed',
                                text: res.message
                            });
                        }
                    },
                    error: function () {
                        hideLoader();
                        Swal.fire("Error", "Could not complete the purchase request. Please try again.", "error");
                    }
                });
            }

            function renderExtraStaffCards() {
                let container = $('#extraStaffCardsContainer');
                if (!container.length) return;

                let bundles = [
                    { count: 5, price: 500, desc: 'Suitable for small teams', color: 'primary', isBest: false },
                    { count: 10, price: 900, desc: 'Suitable for growing teams', color: 'success', isBest: false },
                    { count: 15, price: 1300, desc: 'Mid-sized organization', color: 'warning', isBest: false },
                    { count: 20, price: 1600, desc: 'Suitable for large teams', color: 'primary', isBest: true }
                ];

                container.empty();

                let isLicenseExpired = !licenceExpiryDate || new Date(licenceExpiryDate) <= new Date();

                bundles.forEach(b => {
                    let totalCost = b.price * remainingMonths;
                    let btnClass = b.isBest ? `btn-${b.color}` : `btn-outline-${b.color}`;
                    let badgeHtml = b.isBest ? `<span class="badge bg-primary text-white position-absolute top-0 start-50 translate-middle px-3 py-1 fw-bold rounded-pill" style="font-size: 0.7rem; transform: translate(-50%, -50%) !important;">BEST VALUE</span>` : '';
                    let disabledAttr = isLicenseExpired ? 'disabled' : '';

                    let expiryText = licenceExpiryDate ? `Expires: ${licenceExpiryDate}` : 'No active license';

                    let cardHtml = `
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm transition-hover card-plan position-relative" style="border-radius: 14px; background: white; ${b.isBest ? 'border: 1.5px solid rgba(29, 78, 216, 0.2) !important;' : ''}">
                                ${badgeHtml}
                                <div class="card-body p-4 d-flex flex-column text-center">
                                    <div class="bg-${b.color} bg-opacity-10 p-3 rounded-circle mx-auto mb-3 text-${b.color} d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                        <i class="bi bi-people-fill fs-3"></i>
                                    </div>
                                    <h5 class="fw-bold text-dark mb-1">${b.count} Extra Staff</h5>
                                    <div class="text-muted small mb-3">${b.desc}</div>
                                    <div class="my-3">
                                        <div class="fs-4 fw-extrabold text-${b.color}">₹${totalCost}</div>
                                        <div class="text-muted small">₹${b.price} / mo × ${remainingMonths} ${remainingMonths === 1 ? 'month' : 'months'}</div>
                                    </div>
                                    <div class="bg-light p-2 rounded-3 mb-3" style="font-size: 0.78rem;">
                                        <div class="text-dark fw-semibold text-truncate">
                                            <i class="bi bi-info-circle me-1"></i> ${expiryText}
                                        </div>
                                    </div>
                                    <div class="mt-auto pt-3">
                                        <button type="button" class="btn ${btnClass} w-100 fw-bold py-2 btn-purchase-users-submit" 
                                                data-count="${b.count}" data-cost="${totalCost}" ${disabledAttr} style="border-radius: 8px;">
                                            ${isLicenseExpired ? 'License Expired' : 'Buy Bundle'}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    container.append(cardHtml);
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        window.dismissRequestAlert = function(id) {
            let dismissedRequests = JSON.parse(localStorage.getItem('dismissedRequests') || '[]');
            if (!dismissedRequests.includes(id)) {
                dismissedRequests.push(id);
                localStorage.setItem('dismissedRequests', JSON.stringify(dismissedRequests));
            }
            document.getElementById('req-alert-' + id)?.remove();
            
            let currentCount = parseInt(document.getElementById('pendingRequestsCount').innerText) || 0;
            if (currentCount > 0) {
                currentCount--;
                document.getElementById('pendingRequestsCount').innerText = currentCount;
                document.getElementById('pendingRequestsHeaderCount').innerText = currentCount;
            }
            if (currentCount === 0) {
                document.getElementById('pendingRequestsNotification').style.display = 'none';
            }
        };

        document.addEventListener("DOMContentLoaded", function () {
            // Fetch Pending Requests for Notification
            fetch('/StockIssue/GetPendingIncomingRequests')
                .then(response => response.json())
                .then(result => {
                    if (result && result.success && result.data) {
                        let dismissedRequests = JSON.parse(localStorage.getItem('dismissedRequests') || '[]');
                        let data = result.data.filter(r => !dismissedRequests.includes(r.id));
                        
                        if (data.length > 0) {
                            document.getElementById('pendingRequestsNotification').style.display = 'block';
                            document.getElementById('pendingRequestsCount').innerText = data.length;
                            document.getElementById('pendingRequestsHeaderCount').innerText = data.length;

                            let listHtml = '';
                            data.forEach(req => {
                                const dateStr = new Date(req.billDate).toLocaleDateString();
                                listHtml += `
                                    <div class="position-relative border-bottom pending-req-item" id="req-alert-${req.id}">
                                        <a href="/StockIssue/Create?requestId=${req.id}" class="dropdown-item d-flex flex-column py-2 pe-4" style="white-space: normal; transition: background 0.2s;">
                                            <div class="d-flex justify-content-between align-items-center w-100 mb-1">
                                                <span class="fw-bold text-dark" style="font-size: 0.85rem;">${req.requesterName}</span>
                                                <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">${dateStr}</span>
                                            </div>
                                            <div class="d-flex justify-content-between text-muted" style="font-size: 0.75rem;">
                                                <span>Req No: <strong>${req.billNo}</strong></span>
                                                <span>Click to Issue</span>
                                            </div>
                                        </a>
                                        <button class="btn btn-sm text-danger position-absolute top-50 end-0 translate-middle-y me-2 p-1" 
                                                onclick="dismissRequestAlert(${req.id}); event.preventDefault();" 
                                                style="z-index: 10;"
                                                title="Clear Alert">
                                            <i class="bi bi-x-circle-fill" style="font-size: 1.2rem;"></i>
                                        </button>
                                    </div>
                                `;
                            });
                            document.getElementById('pendingRequestsList').innerHTML = listHtml;
                        }
                    }
                })
                .catch(error => console.error("Error fetching pending requests:", error));
        });

        // --- Staff Transfer Alerts JS ---
        window.acknowledgeTransferAlert = function(id) {
            fetch('/api/EmployeeApi/AcknowledgeTransferAlert/' + id, { method: 'POST' })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        document.getElementById('staff-alert-' + id)?.remove();
                        let currentCount = parseInt(document.getElementById('staffTransferCount').innerText);
                        if (currentCount > 0) {
                            currentCount--;
                            document.getElementById('staffTransferCount').innerText = currentCount;
                            document.getElementById('staffTransferHeaderCount').innerText = currentCount;
                        }
                        if (currentCount === 0) {
                            document.getElementById('staffTransferNotification').style.display = 'none';
                        }
                    }
                });
        };

        document.addEventListener("DOMContentLoaded", function () {
            fetch('/api/EmployeeApi/GetUnreadTransferAlerts')
                .then(response => response.json())
                .then(result => {
                    if (result && result.success && result.data && result.data.length > 0) {
                        let data = result.data;
                        document.getElementById('staffTransferNotification').style.display = 'block';
                        document.getElementById('staffTransferCount').innerText = data.length;
                        document.getElementById('staffTransferHeaderCount').innerText = data.length;

                        let listHtml = '';
                        data.forEach(req => {
                            const dateStr = new Date(req.transferDate).toLocaleDateString();
                            listHtml += `
                                <div class="position-relative border-bottom p-2" id="staff-alert-${req.id}">
                                    <div class="d-flex flex-column pe-4">
                                        <div class="d-flex justify-content-between align-items-center w-100 mb-1">
                                            <span class="fw-bold text-dark" style="font-size: 0.85rem;">${req.employeeName}</span>
                                            <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">${dateStr}</span>
                                        </div>
                                        <div class="text-muted" style="font-size: 0.75rem;">
                                            <strong>Role:</strong> ${req.designation} (${req.department})<br/>
                                            <strong>From:</strong> ${req.fromTenantName}<br/>
                                            <strong>Reason:</strong> ${req.transferReason || 'N/A'}
                                        </div>
                                    </div>
                                    <button class="btn btn-sm btn-success position-absolute top-50 end-0 translate-middle-y me-2 px-3 shadow-sm" 
                                            onclick="acknowledgeTransferAlert(${req.id}); event.preventDefault();" 
                                            title="Accept Transfer" style="border-radius: 20px;">
                                        Accept
                                    </button>
                                </div>
                            `;
                        });
                        document.getElementById('staffTransferList').innerHTML = listHtml;
                    }
                })
                .catch(error => console.error("Error fetching staff transfers:", error));
        });
    </script>
