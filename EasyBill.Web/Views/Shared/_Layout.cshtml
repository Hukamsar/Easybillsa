@using EasyBill.DataAccess.Repository.IRepository
@inject UserManager<ApplicationUsers> UserManager
@inject ITenantRepository _companyService
@{
    var user = await UserManager.GetUserAsync(User);
}
<!DOCTYPE Html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>@ViewData["Title"] - Easy Bill</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="title" content="AdminLTE | Dashboard v3" />
    <meta name="author" content="ColorlibHQ" />
    <meta name="description" content="AdminLTE is a Free Bootstrap 5 Admin Dashboard, 30 example pages using Vanilla JS." />
    <meta name="keywords" content="bootstrap 5, bootstrap, bootstrap 5 admin dashboard, bootstrap 5 dashboard, bootstrap 5 charts, bootstrap 5 calendar, bootstrap 5 datepicker, bootstrap 5 tables, bootstrap 5 datatable, vanilla js datatable, colorlibhq, colorlibhq dashboard, colorlibhq admin dashboard" />

    <!-- ================================================================
    VENDOR CSS (Local)
    ================================================================ -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/overlayscrollbars.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/apexcharts.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/jquery.datatables.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/select2.min.css" rel="stylesheet" />

    <!-- ================================================================
    LOCAL CSS
    ================================================================ -->
    <link href="~/bootstrap-select/css/bootstrap-select.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/adminlte.css" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/bootstrap/dist/css/toastr.min.css" rel="stylesheet" />


    <!-- ================================================================
    CDN CSS
    ================================================================ -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/intro.js/minified/introjs.min.css" />
    <!-- ================================================================
    GLOBAL STYLES
    ================================================================ -->
    <style>
        /* ── Base Font Size ── */
        :root,
        [data-bs-theme=light] {
        --bs-body-font-size: 0.875rem;
        }

        html, body {
        font-size: 0.875rem !important;
        padding: 0 !important;
        overflow-y: auto !important;
        }

        /* ── Sticky Header ── */
        .app-header {
        position: sticky !important;
        top: 0 !important;
        z-index: 1030 !important;
        background: #fff !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08) !important;
        }

        .app-header .navbar {
        background: #fff !important;
        }

        /* ── Sticky Footer ── */
        .app-footer {
        position: sticky !important;
        bottom: 0 !important;
        z-index: 1020 !important;
        background: #fff !important;
        border-top: 1px solid #e2e8f0 !important;
        }

        /* ── Global Loader ── */
        #globalLoader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 99999;
        backdrop-filter: blur(3px);
        }

        #globalLoader.show {
        display: flex;
        }

        .loader-content {
        text-align: center;
        background: transparent;
        padding: 0;
        }

        .loader-gif {
        width: 100px;
        height: 100px;
        margin: 0;
        filter: drop-shadow(0 4px 12px rgba(138, 43, 226, 0.6));
        }

        .loader-text {
        display: none;
        }

        /* ── Sidebar Arrow Icon ── */
        .arrow-icon {
        cursor: pointer;
        color: #2b6ac9;
        }

        .company-name {
        min-width: 190px;
        max-width: 320px; /* keep header compact but do not truncate */
        white-space: normal;
        overflow: visible;
        text-overflow: clip;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        flex-shrink: 0;
        line-height: 1.15;
        }

        .company-name > span,
        .company-name > small {
        display: block;
        max-width: 100%;
        white-space: normal;
        word-break: normal;
        overflow-wrap: break-word;
        }

        .wallet-nav-btn {
        border-radius: 0.375rem !important;
        padding: 0.35rem 0.8rem !important;
        font-weight: 600;
        white-space: nowrap;
        }

        /* ── Upgrade Button & Modal Premium Styles ── */
        .btn-gradient-orange {
            background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
            border: none;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn-gradient-orange:hover {
            background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);
            transform: translateY(-1.5px);
            box-shadow: 0 4px 10px rgba(234, 88, 12, 0.35) !important;
            color: white !important;
        }
        .btn-gradient-orange:active {
            transform: translateY(0.5px);
        }
        
        .transition-hover {
            transition: all 0.25s ease;
        }
        .transition-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08) !important;
        }

        .card-plan {
            border: 1px solid rgba(0, 0, 0, 0.05) !important;
        }
        .card-plan:hover {
            border: 1px solid rgba(43, 106, 201, 0.2) !important;
        }
        
        .form-switch-lg .form-check-input {
            width: 2.8em;
            height: 1.5em;
        }
        
        /* Pulse Animation for Upgrade Button Icon */
        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @@keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: .5; }
        }
        
        /* Bounce animation for Modal Header Rocket */
        .animate-bounce {
            animation: bounce 2s infinite;
        }
        @@keyframes bounce {
            0%, 100% {
                transform: translateY(-5%);
                animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
            }
            50% {
                transform: translateY(0);
                animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
            }
        }

        /* ── Checkout Premium Styles ── */
        .payment-option-card {
            border: 1.5px solid #e2e8f0;
            transition: all 0.2s ease;
            cursor: pointer;
            background: #ffffff;
            border-radius: 10px;
        }
        .payment-option-card:hover {
            border-color: #cbd5e1;
            background-color: #f8fafc;
        }
        .payment-option-card.active {
            border-color: #1d4ed8 !important;
            background-color: #eff6ff !important;
            box-shadow: 0 4px 12px rgba(29, 78, 216, 0.08) !important;
        }
        .payment-option-card.disabled-card {
            opacity: 0.55;
            cursor: not-allowed !important;
            background-color: #f1f5f9 !important;
            border-color: #e2e8f0 !important;
            pointer-events: none;
        }
        .payment-option-card input[type="radio"] {
            cursor: pointer;
        }
        .payment-sub-tab {
            padding: 12px;
            background: #f8fafc;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
        }
        .payment-sub-tab .nav-link {
            color: #64748b;
            font-weight: 500;
            border: none;
            border-radius: 6px;
            padding: 6px 12px;
            font-size: 0.8rem;
        }
        .payment-sub-tab .nav-link.active {
            background-color: #1d4ed8 !important;
            color: #ffffff !important;
        }
    </style>
</head>

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">

    <!-- ================================================================
    GLOBAL LOADER
    ================================================================ -->
    <div id="globalLoader">
        <div class="loader-content">
            <img src="~/assets1/images/loader/loaderGIF.gif" alt="Loading..." class="loader-gif" />
        </div>
    </div>

    <!-- ================================================================
    APP WRAPPER
    ================================================================ -->
