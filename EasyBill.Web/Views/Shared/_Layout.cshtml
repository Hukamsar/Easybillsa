                                {
                                    yearFrom = new DateTime(today.Year - 1, 4, 1);
                                    yearTo = new DateTime(today.Year, 3, 31);
                                }
                                else
                                {
                                    yearFrom = new DateTime(today.Year, 4, 1);
                                    yearTo = new DateTime(today.Year + 1, 3, 31);
                                }
                            }
                            var fyDisplay = $"F.Y. {yearFrom.Value:yyyy}-{yearTo.Value:yy}";

                            <!-- Staff Transfer Alert Notification -->
                            <li class="nav-item dropdown me-3" id="staffTransferNotification" style="display:none;">
                                <a class="nav-link dropdown-toggle position-relative d-flex align-items-center justify-content-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 38px; height: 38px; background-color: #f8fafc; border-radius: 50%; border: 1px solid #e2e8f0; transition: all 0.2s;">
                                    <i class="bi bi-people-fill text-primary fs-5"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light" id="staffTransferCount" style="font-size: 0.65rem; padding: 0.25em 0.5em;">
                                        0
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" style="width: 350px; border-radius: 12px; overflow: hidden; animation: fadeIn 0.2s ease-in-out;">
                                    <li class="p-3 border-bottom bg-light d-flex justify-content-between align-items-center">
                                        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Staff Transfers</h6>
                                        <span class="badge bg-primary rounded-pill" id="staffTransferHeaderCount">0</span>
                                    </li>
                                    <li>
                                        <div id="staffTransferList" style="max-height: 300px; overflow-y: auto;">
