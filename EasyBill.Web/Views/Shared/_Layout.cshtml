                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                            <i id="toggleArrow" class="bi bi-arrow-left-circle-fill fs-3 arrow-icon"></i>
                        </a>
                    </li>
                </ul>

                <!-- Right Nav -->
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (user != null && user.TenantId != null)
                    {
                        var companyData = await _companyService.GetById(user.TenantId);
                        if (companyData != null)
                        {
                            var yearFrom = companyData.YearFrom;
                            var yearTo = companyData.YearTo;
                            if (!yearFrom.HasValue || !yearTo.HasValue)
                            {
                                var today = DateTime.Today;
                                if (today.Month <= 3)
                                {
                                    yearFrom = new DateTime(today.Year - 1, 4, 1);
                                    yearTo = new DateTime(today.Year, 3, 31);
                                }
                                else
                                {
                                    yearFrom = new DateTime(today.Year, 4, 1);
                                    yearTo = new DateTime(today.Year + 1, 3, 31);
                                }
                            }
                            var fyDisplay = $"F.Y. {yearFrom.Value:yyyy}-{yearTo.Value:yy}";
                            var planName = companyData.SubscriptionPlan?.PlanName ?? "Free Trial";

                            <!-- Workspace Details -->
                             <li class="nav-item d-flex align-items-center me-3">
                                 <div class="d-flex flex-column align-items-end me-1">
                                     <div class="fw-bold text-dark text-truncate text-nowrap" style="max-width: 220px; font-size: 0.9rem; letter-spacing: 0.1px;" title="@companyData.Name">
                                         <i class="bi bi-buildings text-primary me-1.5" style="font-size: 0.95rem;"></i>@companyData.Name
                                     </div>
                                     <div class="d-flex align-items-center gap-2 mt-1 text-nowrap" style="font-size: 0.75rem; line-height: 1.2;">
                                         @if (!string.IsNullOrEmpty(companyData.BranchCode))
                                         {
                                             <span class="badge bg-light text-secondary border px-2 py-0.5" style="font-weight: 500;">Br: @companyData.BranchCode</span>
                                         }
                                         <span class="badge bg-light text-secondary border px-2 py-0.5" style="font-weight: 500;" title="Financial Year: @yearFrom.Value.ToString("dd/MM/yyyy") - @yearTo.Value.ToString("dd/MM/yyyy")">
                                             F.Y. @yearFrom.Value.ToString("yyyy")-@yearTo.Value.ToString("yy")
                                         </span>
                                     </div>
                                 </div>
                             </li>

                            <!-- Plan Info & Upgrade Console -->
                            <li class="nav-item d-flex align-items-center me-3 border-start ps-3 border-secondary-subtle">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle d-flex align-items-center gap-1 px-2.5 py-1.5" style="font-size: 0.7rem; font-weight: 600; border-radius: 20px;">
                                        <i class="bi bi-patch-check-fill text-warning"></i> @planName
                                    </span>
                                    <button type="button" class="btn btn-xs btn-gradient-orange text-white fw-bold d-flex align-items-center gap-1 shadow-sm" id="btnUpgradePlanHeader" style="font-size: 0.7rem; border-radius: 20px; padding: 0.35rem 0.8rem; border: none; letter-spacing: 0.3px;" title="Upgrade your subscription plan">
                                        <i class="bi bi-lightning-fill animate-pulse"></i> Upgrade
                                    </button>
                                </div>
                            </li>
                        }
                    }
                    <li class="nav-item d-flex align-items-center me-3 border-start ps-3 border-secondary-subtle">
                        <a asp-controller="Wallet"
                           asp-action="Recharge"
