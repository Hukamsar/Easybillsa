    <!-- ================================================================
         GLOBAL FUNCTIONS
         ================================================================ -->
    <script>
        // ── Profile Modal ──
        document.getElementById("btnProfile").addEventListener("click", function () {
            fetch('/Account/UserProfile')
                .then(res => res.text())
                .then(html => {
                    document.getElementById('profileModalContainer').innerHTML = html;
                    var modal = new bootstrap.Modal(document.getElementById('profileModal'));
                    modal.show();
                });
        });

        // ── Sidebar Arrow Toggle ──
        const arrow = document.getElementById('toggleArrow');
        arrow.addEventListener('click', () => {
            if (arrow.classList.contains('bi-arrow-left-circle-fill')) {
                arrow.classList.remove('bi-arrow-left-circle-fill');
                arrow.classList.add('bi-arrow-right-circle-fill');
            } else {
                arrow.classList.remove('bi-arrow-right-circle-fill');
                arrow.classList.add('bi-arrow-left-circle-fill');
            }

            // ── Update Sales Button Bar Position ──
            setTimeout(() => {
                const isCollapsed = document.body.classList.contains('sidebar-collapse');
                const btnBar = document.querySelector('.sales-btn-bar');
                if (btnBar) {
                    btnBar.style.left = isCollapsed ? '75px' : '250px';
                }
            }, 350);
        });

        // ── Global Loader Functions ──
        function showLoader(message = "") {
            $("#globalLoader").addClass("show");
        }

        function hideLoader() {
            $("#globalLoader").removeClass("show");
        }

        // ── Auto-hide Loader on Page Load ──
        $(document).ready(function () {
            hideLoader();

            // Set initial sales button bar position
            setTimeout(() => {
                const isCollapsed = document.body.classList.contains('sidebar-collapse');
                const btnBar = document.querySelector('.sales-btn-bar');
                if (btnBar) {
                    btnBar.style.left = isCollapsed ? '75px' : '250px';
                }
            }, 400);
        });
    </script>

    <!-- ================================================================
    UPGRADE PLAN MODAL
    ================================================================ -->
    <!-- ================================================================
    UPGRADE PLAN MODAL
    ================================================================ -->
    <div class="modal fade" id="upgradePlanModal" tabindex="-1" aria-labelledby="upgradePlanModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden; background: #f8f9fa;">
                <div class="modal-header border-0 text-white py-3" style="background: linear-gradient(135deg, #1d4ed8 0%, #2b6ac9 100%);">
