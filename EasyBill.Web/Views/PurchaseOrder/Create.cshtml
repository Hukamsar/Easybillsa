@model EasyBill.Models.ViewModels.PurchaseOrderVM
@{
    ViewData["Title"] = "Create";
}
<style> 
    .batch-row.selected td {
        background-color: #d4af37 !important;  
        color: #000 !important;
        font-weight: 500;
    }
     
    #batchModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

    #batchModal .modal-header .btn-close {
        filter: invert(1);
    } 
    .batch-row.selected td {
        background-color: #d4af37 !important;  
        color: #000 !important;
        font-weight: 500;
    }
     
    #batchModal.keyboard-nav .batch-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }
     
    #batchModal.mouse-nav .batch-row:hover td {
        background-color: #f1d27a !important; 
        color: #000 !important;
        cursor: pointer;
    }
     
    .batch-table-wrapper {
        max-height: 350px;  
        overflow-y: auto;
        position: relative;
    }

    #batchTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7;  
        color: #fff;
        font-weight: 700;
        z-index: 2;
    }
     
    #addSupplierModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }
</style>

<style> 
    .item-row.selected td {
        background-color: #d4af37 !important;  
        color: #000 !important;
        font-weight: 500;
    }
     
    #itemModal.keyboard-nav .item-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }
     
    #itemModal.mouse-nav .item-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }
     
    .item-row:focus {
        outline: none;
    }
     
    .item-row {
        scroll-margin-top: 50px;
    }
     
    #itemTable thead th {
        position: sticky;
        top: 0;
        background: #fff;
        z-index: 2;
    }
     
    #itemModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

    #itemModal .modal-header .btn-close {
        filter: invert(1);
    }
         
    #itemTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;  
        position: sticky;
        top: 0;
        z-index: 2;
    }
</style>

<style> 
    #itemDetailModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #itemDetailModal .modal-header .btn-close {
            filter: invert(1);
        }
</style>

<style> 
    #supplierModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

    #supplierModal .modal-header .btn-close {
        filter: invert(1);
    }
         
    #supplierTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    } 
    .supplier-row.selected td {
        background-color: #d4af37 !important; 
        color: #000 !important;
        font-weight: 500;
    }
     
    #supplierModal.keyboard-nav .supplier-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }
     
    #supplierModal.mouse-nav .supplier-row:hover td {
        background-color: #f1d27a !important;  
        color: #000 !important;
        cursor: pointer;
    }
     
    .supplier-row {
        scroll-margin-top: 50px;
    }

        .supplier-row:focus {
            outline: none;
        }
</style>

<style>
    
    #itemExtraInfoWrapper {
        background: linear-gradient(to bottom, #f8fbff, #ffffff);
        border: 1.5px solid #b3d9ff !important;
        box-shadow: 0 1px 4px rgba(0, 123, 255, 0.08);
        max-height: 250px;  
        overflow-y: auto;  
    }

    .purchase-history-table {
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        border-radius: 6px;
        font-size: 11px;  
    }

        .purchase-history-table thead tr {
            background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
            color: #ffffff;
            font-weight: 600;
            font-size: 10px;  
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .purchase-history-table thead th {
            border: none !important;
            padding: 6px 5px; /* ✅ Reduced from 12px */
            vertical-align: middle;
            white-space: nowrap;
            position: sticky; /* ✅ Sticky header */
            top: 0;
            z-index: 10;
        }

            .purchase-history-table thead th:first-child {
                border-top-left-radius: 6px;
            }

            .purchase-history-table thead th:last-child {
                border-top-right-radius: 6px;
            }

        .purchase-history-table tbody tr {
            border-bottom: 1px solid #d6ebff;
            transition: all 0.15s ease;
        }

            .purchase-history-table tbody tr:hover {
                background-color: #e3f2fd;
                transform: scale(1.005); /* ✅ Subtle hover */
            }

        .purchase-history-table tbody td {
            padding: 5px 5px; /* ✅ Reduced from 10px */
            font-size: 11px;
            border-left: 1px solid #d6ebff;
            border-right: 1px solid #d6ebff;
            vertical-align: middle;
            line-height: 1.3; /* ✅ Compact line height */
        }

            .purchase-history-table tbody td:first-child {
                border-left: none;
            }

            .purchase-history-table tbody td:last-child {
                border-right: none;
            }

        .purchase-history-table tbody tr:last-child td {
            border-bottom: none;
        }

        /* Alternating row colors */
        .purchase-history-table tbody tr:nth-child(even) {
            background-color: #f5f9ff;
        }

        .purchase-history-table tbody tr:nth-child(odd) {
            background-color: #ffffff;
        }

    /* Responsive scrolling */
    .table-responsive {
        border-radius: 6px;
        overflow-x: auto;
    }

    /* Custom scrollbar */
    #itemExtraInfoWrapper::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    #itemExtraInfoWrapper::-webkit-scrollbar-track {
        background: #f0f7ff;
        border-radius: 3px;
    }

    #itemExtraInfoWrapper::-webkit-scrollbar-thumb {
        background: #b3d9ff;
        border-radius: 3px;
    }

        #itemExtraInfoWrapper::-webkit-scrollbar-thumb:hover {
            background: #4a90e2;
        }

    /* Empty state */
    #itemExtraInfoBody:empty::after {
        content: "No purchase history available";
        display: block;
        text-align: center;
        padding: 20px;
        color: #6c757d;
        font-style: italic;
        font-size: 11px;
    }
</style>

<style>
    #refreshBtn:hover {
        opacity: 0.85;
        transform: rotate(90deg);
        transition: all 0.2s ease;
    }
</style>

<style>
    .custom-header th {
        background: linear-gradient(180deg, #eef3f8, #d8e3ef);
        color: #16202b;
        font-weight: 700;
        text-align: center;
        border-bottom: 0px solid #b6c6d6;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,0.05);
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">

        <div class="card mb-2 shadow-sm" style="border-radius: 6px; overflow: hidden;">
            <div class="card-header text-white d-flex align-items-center py-1 px-3"
                 style="background:#2b6ac9">

                <h6 class="mb-0 me-auto" style="font-size: 0.85rem;">
                    Create Purchase Order
                </h6>

                <button type="button"
                        id="refreshBtn"
                        class="btn btn-sm p-1 me-2 border-0 bg-transparent text-white"
                        title="Refresh">
                    <span class="fs-5">🔄</span>
                </button>

                @*                 <button type="button"
                        class="btn btn-sm btn-light"
                        id="settingsBtn"
                        style="font-size: 0.78rem; padding: 3px 10px;">
                    ⚙️ Settings
                </button> *@
            </div>
        </div>

        <div class="card-body">
            <form asp-action="Create" id="purchaseForm">
                <input type="hidden" asp-for="TenanatGst" id="companygst" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious ">
                        <div class="col-md-5 ">
                            <label asp-for="BillNo"></label>
                        </div>
                        <div class="col-md-5 ">
                            <input asp-for="BillNo" id="BillNo" class="form-control form-control-sm" required />
                            <span asp-validation-for="BillNo" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious">
                        <div class="col-md-5 ">
                            <label asp-for="BillDate"></label>
                        </div>
                        <div class="col-md-5 ">
                            <input type="date" asp-for="BillDate" class="form-control form-control-sm" />
                            <span asp-validation-for="BillDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious">
                        <div class="col-md-5 ">
                            <label>Billing Type</label>
                        </div>
                        <div class="col-md-5 ">
                            <select asp-for="billingType" id="billingType" class="form-control form-control-sm">
                                <option value="registered">Supplier</option>
                                <option value="walkin">Cash</option>
                               
                            </select>
                        </div>
                    </div>

                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious mb-1">
                        <div class="col-md-5">
                            <label asp-for="SupplierName"></label>
                        </div>
                        <div class="col-md-4">
                            <input type="hidden" asp-for="SupplierId" class="supplier-id" />
                            <input type="text"
                                   class="form-control form-control-sm supplier-input" id="supplier-input"
                                   placeholder="Press Enter to select supplier"
                                   autocomplete="off" />
                            <span asp-validation-for="SupplierId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-1">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
                                new
                            </button>
                        </div>
                    </div>

                  @*   <div class="col-md-4 d-flex align-items-center mb-1 border-radious ">
                        <div class="col-md-5 ">
                            <label asp-for="PartyBillNo"></label>
                        </div>
                        <div class="col-md-5">
                            <input asp-for="PartyBillNo" class="form-control form-control-sm" />
                            <span asp-validation-for="PartyBillNo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious ">
                        <div class="col-md-5 ">
                            <label asp-for="PartyBillDate"></label>
                        </div>
                        <div class="col-md-5">
                            <input type="date" asp-for="PartyBillDate" class="form-control form-control-sm" />
                            <span asp-validation-for="PartyBillDate" class="text-danger small"></span>
                        </div>
                    </div> *@

                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious ">
                        <div class="col-md-5 ">
                            <label>Type</label>
                        </div>
                        <div class="col-md-5">
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="paymentToggle">
                                <label class="form-check-label fw-bold" id="paymentToggleLabel" style="color: green;">
                                    Cash
                                </label>
                            </div>

                            <input type="hidden" asp-for="PaymentType" id="paymentTypeHidden" value="cash" />
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious">
                        <div class="col-md-5 ">
                            <label>Purchase Type</label>
                        </div>
                        <div class="col-md-5 ">
                            <select id="purchasetype" class="form-control form-control-sm" disabled>
                                <option value="Local">Local</option>
                                <option value="Central">Central</option>
                            </select>
                            <input type="hidden" asp-for="PurchaseType" id="purchasetypeHidden" />
                        </div>
                    </div>

                </div>

                <div style="overflow-x: auto; width: 100%;">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead class="table custom-header">
                                <tr>
                                    <th style="min-width:30%">Item</th>
                                    <th hidden style="min-width:30%">Batch</th>
                                    <th hidden class="text-center">Expiry</th>
                                    <th hidden class="text-center">Mrp</th>
                                    <th class="text-center">Qty</th>
                                    <th hidden class="text-center">Free</th>
                                    <th class="text-center">Rate</th>
                                    <th hidden class="text-center">RateA</th>
                                    <th hidden class="text-center">RateB</th>
                                    <th class="text-center">Disc %</th>
                                    <th class="text-center gst-col">Gst %</th>
                                    <th hidden class="text-center">Gst Amt</th>
                                    <th hidden class="text-center">CGst %</th>
                                    <th hidden class="text-center">CGst Amt</th>
                                    <th hidden class="text-center">SGst %</th>
                                    <th hidden class="text-center">SGst Amt</th>
                                    <th class="text-center scgst-col">Gst %</th>
                                    <th class="text-center">Amount</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="PurchaseItemBody">
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="float-start">
                                        <u id="addRow" style="color:green; text-align:right;   cursor:pointer;">Add Row</u>
                                    </th>
                                </tr>

                            </tfoot>

                        </table>

                        <div class="row mt-3">

                            <div class="col-md-9">
                               @*  <strong>Payment Details</strong>
                                <table class="table table-bordered table-striped">
                                    <thead class="table custom-header">
                                        <tr>
                                            <th style="min-width:30%">Payment Mode</th>
                                            <th class="text-center">Amount</th>
                                            <th class="text-center">Reference NO</th>
                                            <th class="text-center">Description</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="PaymentDetailsBody">
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th class="float-start">
                                                <u id="addPaymentRow" style="color:green; text-align:right; cursor:pointer;">Add Row</u>
                                            </th>
                                        </tr>
                                    </tfoot>
                                </table> *@
                                <div id="itemExtraInfoWrapper" class="border rounded p-3 h-90" style="display:none;">
                                    <div class="table-responsive">
                                        <table class="table table-sm mb-0 text-center purchase-history-table">
                                            <thead>
                                                <tr>
                                                    <th>Supplier</th>
                                                    <th>Bill No</th>
                                                    <th>Bill Date</th>
                                                    <th>Qty</th>
                                                    <th>Batch</th>
                                                    <th>MRP</th>
                                                    <th>Rate</th>
                                                    <th>Expiry</th>
                                                    @* <th>Disc.Amt.</th> *@
                                                    <th>Cost</th>
                                                </tr>
                                            </thead>
                                            <tbody id="itemExtraInfoBody">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- ===============================
                                 RIGHT : TOTALS (COMPACT)
                                 =============================== -->
                            <div class="col-md-3">

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Total</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="Total"
                                               class="form-control form-control-sm total-input text-end"
                                               readonly />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Bill Discount</label>
                                    <div class="col-md-3 text-end">
                                        <input asp-for="discountPercent"
                                               id="discountPercent"
                                               class="form-control form-control-sm discount-input text-end"
                                               min="0"
                                               max="100"
                                               step="0.01" />
                                    </div>
                                    <div class="col-md-3 text-end">
                                        <input asp-for="discountAmount"
                                               id="discountamount"
                                               class="form-control form-control-sm total-input text-end" />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Total Discount</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="Totaldiscount"
                                               class="form-control form-control-sm total-input text-end"
                                               readonly />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center gst-row">
                                    <label class="col-md-6 col-form-label small">Gst</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalGstAmt"
                                               class="form-control form-control-sm total-input text-end"
                                               readonly />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center sgst-row">
                                    <label class="col-md-6 col-form-label small">SGst</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalSGstAmt" class="form-control form-control-sm text-end"
                                               readonly />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center cgst-row">
                                    <label class="col-md-6 col-form-label small">CGst</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalCGstAmt" class="form-control form-control-sm text-end" readonly />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center scgst-row">
                                    <label class="col-md-6 col-form-label small">Gst</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalSCGstAmt" class="form-control form-control-sm text-end" readonly />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center">
                                    <label asp-for="RoundOffAmount" class="col-md-6 col-form-label small"></label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="RoundOffAmount" id="roundOffAmount" class="form-control form-control-sm text-end" readonly />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small fw-bold">Total Payable</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalPayable" class="form-control form-control-sm total-input text-end fw-bold" id="totalPayable" readonly />
                                    </div>
                                </div>
                                <div class="row mb-2" hidden>
                                    <label asp-for="PaidAmount" class="col-md-3 col-form-label text-start small">Paid Amount</label>
                                    <div class="col-md-4"></div>
                                    <div class="col-md-5">
                                        <input asp-for="PaidAmount" id="paidAmout" value="0" class="form-control form-control-sm" readonly />
                                    </div>
                                </div>
                                <div class="row mb-2" hidden>
                                    <label asp-for="Balance" class="col-md-3 col-form-label text-start small">Balance</label>
                                    <div class="col-md-4"></div>
                                    <div class="col-md-5">
                                        <input asp-for="Balance" id="balance" value="0" class="form-control form-control-sm" readonly />
                                    </div>
                                </div>
                                <div class="row mb-2" hidden>
                                    <label asp-for="ReturnAmount" class="col-md-3 col-form-label text-start small">Return Amt</label>
                                    <div class="col-md-4"></div>
                                    <div class="col-md-5">
                                        <input asp-for="ReturnAmount" id="returnAmount" value="0" class="form-control form-control-sm" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>


                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-primary">End | Save 💾</button>
                    <a asp-controller="PurchaseOrder" asp-action="Index" id="btnCancel" class="btn btn-sm btn-outline-secondary">F11 | Cancel ❌</a>
                </div>
            </form>
        </div>

    </div>
</div>
<!-- Popup Modal -->
<div class="modal fade" id="itemDetailModal" tabindex="-1" role="dialog" aria-labelledby="itemDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Item Details</h5>
            </div>
            <div class="modal-body">
                
                <div class="form-group">
                    <label>Expiry Date</label>
                    <input type="text" class="form-control expirydate" id="popupExpiry" placeholder="MM/YYYY" maxlength="7" />
                    <span class="text-danger field-error" data-field="popupExpiry"></span>
                </div>
                <div class="form-group">
                    <label>MRP</label>
                    <input type="text" class="form-control" id="popupMrp" />
                    <span class="text-danger field-error" data-field="MRP"></span>
                </div>
                <div class="form-group">
                    <label>Sales RateA</label>
                    <input class="form-control" id="popupSalseRateA" />
                </div>
                <div class="form-group">
                    <label>Sales RateB</label>
                    <input class="form-control" id="popupSalseRateB" />
                </div>
                <div class="form-group">
                    <label>Barcode</label>
                    <input class="form-control" id="popupBarcode" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-primary" id="saveItemPopup">Save</button>
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="batchModal" tabindex="-1" aria-labelledby="batchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Batch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="batch-table-wrapper">
                    <table id="batchTable" class="table mb-0">
                        <thead class="table-light">
                            <tr><th>Batch No</th><th>Expiry</th><th>Rate</th><th>Mrp</th><th>Qty</th><th>Barcode</th></tr>
                        </thead>
                        <tbody id="batchTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="itemModal" tabindex="-1" aria-labelledby="itemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">

                <!-- Search Box -->
