    <script>
         
        function isValidSupplier() {

            const billingType = $("#billingType").val();
            const supplierId = $(".supplier-id").val();

            if (billingType === "registered") {
                if (!supplierId || supplierId === "0") {
                   // alert("Please select Supplier");
                    return false;
                }
            }

            return true;
        }
        function isValidPartyBillNo() {
            return $("#PartyBillNo").val().trim().length > 0;
        }

        function isValidPartyBillDate() {
            const date = $("#PartyBillDate").val();
            return date && date.length > 0;
        }

        function isValidQty(value) {
            const qty = parseFloat(value);
            return !isNaN(qty) && qty > 0;
        }

        function isValidRate(value) {
            const rate = parseFloat(value);
            return !isNaN(rate) && rate > 0;
        }

        function validateHeaderFields() {
            if (!isValidSupplier()) {
                toastr.error("Please select a supplier", "Validation Error");
                $(".supplier-input").focus(); // ✅ FIXED
                return false;
            }

            // if (!isValidPartyBillNo()) {
            //     toastr.error("Party Bill No is required", "Validation Error");
            //     $("#PartyBillNo").focus().select();
            //     return false;
            // }

            // if (!isValidPartyBillDate()) {
            //     toastr.error("Party Bill Date is required", "Validation Error");
            //     $("#PartyBillDate").focus();
            //     return false;
            // }

            return true;
        }

        function validateRow(row) {
            const itemId = row.find(".item-id").val();
            const batch = row.find(".batch").val().trim();
            const qty = row.find(".qty").val();
            const rate = row.find(".rate").val();

            if (!itemId || itemId === "") {
                toastr.error("Please select an item", "Validation Error");
                row.find(".item-input").focus();
                return false;
            }

            // if (!batch) {
            //     toastr.error("Batch is required", "Validation Error");
            //     row.find(".batch").focus().select();
            //     return false;
            // }

            if (!isValidQty(qty)) {
                toastr.error("Quantity must be greater than 0", "Validation Error");
                row.find(".qty").focus().select();
                return false;
            }

            if (!isValidRate(rate)) {
                toastr.error("Rate must be greater than 0", "Validation Error");
                row.find(".rate").focus().select();
                return false;
            }

            return true;
        }

        function validateAllRows() {
            let isValid = true;

            $("#PurchaseItemBody tr").each(function() {
                const row = $(this);
                const itemId = row.find(".item-id").val();
                const batch = row.find(".batch").val().trim();
                const qty = row.find(".qty").val();
                const rate = row.find(".rate").val();

                if (itemId || batch || qty || rate) {
                    if (!validateRow(row)) {
                        isValid = false;
                        return false;
                    }
                }
            });

            return isValid;
        }

        function checkPendingItemDetailAndOpenModal() {
            if (!ENABLE_ITEM_DETAIL_VALIDATION) return true;

            let invalidRow = null;

            $("#PurchaseItemBody tr").each(function () {
                const row = $(this);
                const itemId = row.find(".item-id").val();
                const batch = row.find(".batch").val().trim();

                if (!itemId && !batch) return;

                if (row.attr("data-itemdetail-valid") !== "true") {
                    invalidRow = row;
                    return false;
                }
            });

            if (invalidRow) {
                currentRow = invalidRow;
                selectedRow = invalidRow;
                popupOpen = true;

                setTimeout(() => {
                    invalidRow.find(".batch").focus().select();
                }, 50);

                $("#itemDetailModal").modal("show");
                return false;
            }

            return true;
        }

        function validateSupplierField(input, showError = true) {
            const name = input.name;
            const value = input.value.trim();
            const rule = supplierRules[name];
            const errorSpan = $(`[data-field='${name}']`);

            errorSpan.text("");

            if (!rule) return true;

            if (rule.required && !value) {
                if (showError) errorSpan.text(rule.message);
                return false;
            }

            if (rule.min && value.length < rule.min) {
                if (showError) errorSpan.text(rule.message);
                return false;
            }

            if (rule.regex && !rule.regex.test(value)) {
                if (showError) errorSpan.text(rule.message);
                return false;
            }

            return true;
        }

        function normalizeText(value) {
            return value.replace(/\s+/g, " ").trim();
        }

        function validateExpiry(showError = true) {
            if (!ENABLE_ITEM_DETAIL_VALIDATION) return true;

            const expiry = $("#popupExpiry").val().trim();
            const errorSpan = $("[data-field='popupExpiry']");
            errorSpan.text("");

            if (!expiry) {
                if (showError) errorSpan.text("Expiry Date is required");
                return false;
            }

            // ✅ Support both MM/YYYY and MM/YY formats
            const regex4Digit = /^(0[1-9]|1[0-2])\/\d{4}$/;
            const regex2Digit = /^(0[1-9]|1[0-2])\/\d{2}$/;

            let normalizedExpiry = expiry;

            if (regex2Digit.test(expiry)) {
                // Convert MM/YY to MM/YYYY
                const [month, yy] = expiry.split("/");
                const fullYear = "20" + yy;
                normalizedExpiry = `${month}/${fullYear}`;

                // Update input field
                $("#popupExpiry").val(normalizedExpiry);
            } else if (!regex4Digit.test(expiry)) {
                if (showError) errorSpan.text("Format should be MM/YYYY or MM/YY");
                return false;
            }

            // ✅ Validate year range
            const year = parseInt(normalizedExpiry.split("/")[1]);
            const currentYear = new Date().getFullYear();

            if (year < currentYear) {
                if (showError) errorSpan.text("Expiry year cannot be in the past");
                return false;
            }

            return true;
        }

        // Auto-format expiry date on blur
        $(document).on("blur", "#popupExpiry", function() {
            validateExpiry(false); // Auto-format without showing error
        });

        function validateMrp(showError = true) {
            if (!ENABLE_ITEM_DETAIL_VALIDATION) return true;

            const mrp = $("#popupMrp").val().trim();
            const errorSpan = $("[data-field='MRP']");

            errorSpan.text("");

            if (mrp === "") {
                if (showError) errorSpan.text("MRP is required");
                return false;
            }

            if (isNaN(mrp) || parseFloat(mrp) < 0) {
                if (showError) errorSpan.text("MRP must be 0 or greater");
                return false;
            }

            return true;
        }
    </script>

