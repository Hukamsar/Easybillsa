    <script>
        function loadItemSupplierPurchaseInfo(itemId) {
            $("#itemExtraInfoWrapper").show();

            $.get(`/Purchase/GetItemPurchaseHistory?id=${itemId}`, function (res) {
                if (!res || !res.success || !res.data || res.data.length === 0) {
                    $("#itemExtraInfoBody").html(`
                        <tr>
                            <td colspan="9" class="text-warning fw-semibold text-center">
                                This item has not been purchased yet
                            </td>
                        </tr>
                    `);
                    return;
                }

                let rows = "";

                res.data.forEach(x => {
                    rows += `
                        <tr>
                            <td>${x.supplier}</td>
                            <td>${x.billNo}</td>
                            <td>${x.billDate ? formatDate(x.billDate) : "--"}</td>
                            <td>${x.qty}</td>
                            <td>${x.batch ?? "--"}</td>
                            <td>${x.mrp}</td>
                            <td>${x.rate}</td>
                            <td>${x.expiryDate ? formatDate(x.expiryDate) : "--"}</td>
                            <td>${x.batchWiseCost}</td>
                        </tr>`;
                });

                $("#itemExtraInfoBody").html(rows);
            });
        }

        function formatDate(dateStr) {
            const d = new Date(dateStr);
            if (isNaN(d)) return "--";

            return (
                ("0" + d.getDate()).slice(-2) + "/" +
                ("0" + (d.getMonth() + 1)).slice(-2) + "/" +
                d.getFullYear()
            );
        }
    </script>
