    <script>
        function openSupplierModal(searchText = "") {
            showLoader("Loading suppliers...");

            $.get('/Purchase/GetAllSuppliers', function (suppliers) {
                hideLoader();

                let rows = "";
                suppliers.forEach(sup => {
                    rows += `
                        <tr class="supplier-row" tabindex="0"
                            data-supplierid="${sup.id}"
                            data-name="${sup.firstName}"
                            data-phone="${sup.phoneNO || ''}"
                            data-email="${sup.email || ''}"
                            data-gstno="${sup.gstNo || ''}">
                            <td>${sup.firstName}</td>
                            <td>${sup.area || '--'}</td>
                        </tr>`;
                });

                $("#supplierTableBody").html(rows);
                $("#supplierSearch").val(searchText);
                $("#supplierSearch").trigger("input");

                $("#supplierModal").modal("show");

            }).fail(function() {
                hideLoader();
                toastr.error("Error loading suppliers");
            });
        }

        $(document).on("input", "#supplierSearch", function () {
            const searchWords = $(this).val()
                .toLowerCase()
                .trim()
                .split(/\s+/);

            $("#supplierTableBody tr").each(function () {
                const supplierText = $(this).find("td:first").text().toLowerCase();
                const supplierWords = supplierText.split(/\s+/);

                let match = true;

                for (let i = 0; i < searchWords.length; i++) {
                    if (!supplierWords[i] || !supplierWords[i].startsWith(searchWords[i])) {
                        match = false;
                        break;
                    }
                }

                $(this).toggle(match);
            });

            currentSupplierIndex = -1;
            $("#supplierTableBody .supplier-row").removeClass("selected");
        });

        $(document).on("keydown", function (e) {
            if (!$("#supplierModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                supplierNavMode = "keyboard";
