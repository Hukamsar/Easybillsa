    <script>

        $(document).on("keydown", "#Total, #discountPercent, #discountamount", function (e) {
            if (e.key !== "Enter") return;

            e.preventDefault();
            e.stopImmediatePropagation();

            const id = this.id;

            switch (id) {
                case "Total":
                    $("#discountPercent").focus().select();
                    break;

                case "discountPercent":
                    $("#discountamount").focus().select();
                    break;

                case "discountamount":
                    openPaymentGrid();
                    break;
            }
        });

         $(document).on("keydown", function(e) {
            if (e.key === "End") {
                e.preventDefault();
                saveData();
            }
        });
        function openPaymentGrid() {
            setTimeout(() => {
                const firstPaymentMode = $("#PaymentDetailsBody tr:first .paymentMode-dropdown");

                if (firstPaymentMode.length) {
                    firstPaymentMode.focus();
                    return;
                }

                addPaymentRow();
                setTimeout(() => {
                    $("#PaymentDetailsBody tr:first .paymentMode-dropdown").focus();
                }, 150);
            }, 100);
        }
         $(document).on("focus", ".paymentMode-dropdown", function() {
            const select = this;

            if (document.activeElement === select) {
                setTimeout(() => {
                    if ('showPicker' in HTMLSelectElement.prototype) {
                        select.showPicker();
                    } else {
                        $(select).trigger('click');
                    }
                }, 50);
            }
        });

        $(document).on("keydown",
            ".paymentMode-dropdown, .paymentAmount, .paymentReferenceNO, .paymentDescription",
            function (e) {
                const row = $(this).closest("tr");
                const input = $(this);

                const isMode = input.hasClass("paymentMode-dropdown");
                const isAmount = input.hasClass("paymentAmount");
                const isRef = input.hasClass("paymentReferenceNO");
                const isDesc = input.hasClass("paymentDescription");

                if (e.key === "Enter") {
                    e.preventDefault();
                    e.stopImmediatePropagation();

                    const paymentMode = row.find(".paymentMode-dropdown").val();

                    if (!paymentMode) {
                        row.find(".paymentMode-dropdown").focus();
                        return;
                    }

                    if (isMode) {
                        const amt = row.find(".paymentAmount");
                        amt.focus();
                        setTimeout(() => {
                            amt.select();
                        }, 0);
                        return;
                    }

                    if (isAmount) {
                        if (input.val().trim() === "") input.val("0");
                        row.find(".paymentReferenceNO").focus();
                        return;
                    }

                    if (isRef) {
                        row.find(".paymentDescription").focus();
                        return;
                    }

                    if (isDesc) {
                        const isLastRow = row.is("#PaymentDetailsBody tr:last");
                        if (!isLastRow) return;

                        const amountInput = row.find(".paymentAmount");
                        const amountVal = parseFloat(amountInput.val());

                        if (!amountVal || amountVal <= 0) {
                            amountInput.focus().select();
                            return;
                        }

                        addPaymentRow();
                        setTimeout(() => {
                            $("#PaymentDetailsBody tr:last .paymentMode-dropdown").focus();
                        }, 150);
                        return;
                    }
                }

                if (e.key === "ArrowRight") {
                    e.preventDefault();
                    if (isMode) row.find(".paymentAmount").focus();
                    else if (isAmount) row.find(".paymentReferenceNO").focus();
                    else if (isRef) row.find(".paymentDescription").focus();
                }

                if (e.key === "ArrowLeft") {
                    e.preventDefault();
                    if (isDesc) row.find(".paymentReferenceNO").focus();
                    else if (isRef) row.find(".paymentAmount").focus();
                    else if (isAmount) row.find(".paymentMode-dropdown").focus();
                }

                if (e.key === "ArrowDown") {
                    e.preventDefault();
                    const next = row.next("tr");
                    if (!next.length) return;

                    if (isMode) next.find(".paymentMode-dropdown").focus();
                    else if (isAmount) next.find(".paymentAmount").focus();
                    else if (isRef) next.find(".paymentReferenceNO").focus();
                    else if (isDesc) next.find(".paymentDescription").focus();
                }

                if (e.key === "ArrowUp") {
                    e.preventDefault();
                    const prev = row.prev("tr");
                    if (!prev.length) return;

                    if (isMode) prev.find(".paymentMode-dropdown").focus();
                    else if (isAmount) prev.find(".paymentAmount").focus();
                    else if (isRef) prev.find(".paymentReferenceNO").focus();
                    else if (isDesc) prev.find(".paymentDescription").focus();
                }
            }
        );
         
        function saveData() {
            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: 3000
            };

            if (!validateHeaderFields()) return;

            if ($("#PurchaseItemBody tr").length === 0) {
                toastr.error("Please add at least one item");
                $("#addRow").focus();
                return;
            }

            if (!validateAllRows()) return;

            if (!checkPendingItemDetailAndOpenModal()) return;

            confirmSave(function (ok) {
                if (!ok) return;

                // STEP 1: Empty fields ko 0 set karo (same as form submit)
                $("#PurchaseItemBody tr").each(function() {
                    const row = $(this);
                    const decimalFields = ['.mrp', '.salserateA', '.salserateB', '.discount', '.rate', '.freeqty'];
                    decimalFields.forEach(field => {
                        const $input = row.find(field);
                        const val = $input.val();
                        if (!val || val.trim() === '' || val === 'NaN' || isNaN(parseFloat(val))) {
                            $input.val('0');
                        }
                    });
                });

                ['#discountPercent', '#discountamount'].forEach(field => {
                    const $input = $(field);
                    const val = $input.val();
                    if (!val || val.trim() === '' || val === 'NaN' || isNaN(parseFloat(val))) {
                        $input.val('0');
                    }
                });

                showLoader("Saving purchase...");
                document.getElementById("purchaseForm").submit();
            });
        }

        $("#purchaseForm").on("submit", function(e) {
            e.preventDefault();
            e.stopPropagation();

            const form = this;

           // ✅ STEP 1: Set empty decimal fields to 0 BEFORE validation
           $("#PurchaseItemBody tr").each(function() {
               const row = $(this);

               // ✅ Set empty fields to 0 (including hidden fields)
               const decimalFields = ['.mrp', '.salserateA', '.salserateB', '.discount', '.rate', '.freeqty'];
               decimalFields.forEach(field => {
                   const $input = row.find(field);
                   const val = $input.val();

                   // ✅ Check for empty, "NaN", or invalid values
                   if (!val || val.trim() === '' || val === 'NaN' || isNaN(parseFloat(val))) {
                       $input.val('0');
                   }
               });
           });

           // Bill discount fields
           ['#discountPercent', '#discountamount'].forEach(field => {
               const $input = $(field);
               const val = $input.val();

               if (!val || val.trim() === '' || val === 'NaN' || isNaN(parseFloat(val))) {
                   $input.val('0');
               }
           });


            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: 3000
            };

            if (!validateHeaderFields()) return false;

            if ($("#PurchaseItemBody tr").length === 0) {
                toastr.error("Please add at least one item");
                $("#addRow").focus();
                return false;
            }

            if (!validateAllRows()) return false;

            if (!checkPendingItemDetailAndOpenModal()) return false;

            confirmSave(function (ok) {
                if (!ok) return;

                showLoader("Saving purchase...");
                form.submit();
            });
        });
    </script>

    <!-- ================================================================
         🔹 BATCH MODAL & ITEM DETAILS
         ================================================================ -->
    <script>
        $(document).on("keydown", ".batch", function (e) {
            if (e.key !== "Enter" || popupOpen) return;

            e.preventDefault();

            let row = $(this).closest("tr");
            let itemId = row.find(".item-id").val();
            let enteredBatch = $(this).val()?.trim();

            // ✅ VALIDATION: Item aur batch dono required
            if (!itemId) {
                toastr.warning("Please select an item first");
                row.find(".item-input").focus();
                return;
            }

            if (!enteredBatch) {
                toastr.warning("Batch is required");
                return;
            }

            currentRow = row;
            showLoader("Checking batch...");

            $.get(`/Purchase/GetBatchesByItemId?id=${itemId}`, function (response) {
                hideLoader();

                // ✅ CHECK: Entered batch exist karta hai ya nahi
                let existingBatch = response.groupedResult?.find(
                    b => b.batch.toLowerCase() === enteredBatch.toLowerCase()
                );

                if (existingBatch) {
                    // ✅ CASE 1: Batch exist karta hai → Batch Modal open karo
                    let batchRows = '';
                    response.groupedResult.forEach(batch => {
                        const d = new Date(batch.expiry);
                        const formattedExpiry = ("0" + (d.getMonth() + 1)).slice(-2) + "/" + d.getFullYear();
                        const encoded = encodeURIComponent(JSON.stringify(batch));

                        batchRows += `
                            <tr class="batch-row" data-batch="${encoded}">
                                <td>${batch.batch}</td>
                                <td>${formattedExpiry}</td>
                                <td>${batch.rate}</td>
                                <td>${batch.mrp}</td>
                                <td>${batch.qty}</td>
                                <td hidden>${batch.salserateA}</td>
                                <td hidden>${batch.salserateB}</td>
                                <td>${batch.barcode}</td>
                            </tr>`;
                    });

                    $("#batchTableBody").html(batchRows);

                    // ✅ Pre-select the matching batch in modal
                    currentBatchIndex = response.groupedResult.findIndex(
                        b => b.batch.toLowerCase() === enteredBatch.toLowerCase()
                    );

                    $("#batchModal").modal("show");
                } else {
                    // ✅ CASE 2: Batch exist nahi karta → Clear fields + Open Item Details Modal

                    // Clear row values (except Item, Batch, Barcode)
                    row.find(".qty").val("1");
                    row.find(".freeqty").val("0");
                    row.find(".rate").val("");
                    row.find(".discount").val("0");
                    row.find(".mrp").val("");
                    row.find(".expirydate").val("");
                    row.find(".salserateA").val("");
                    row.find(".salserateB").val("");
                    row.find(".discount-amt").val("");
                    row.find(".total").val("");
                    row.find(".batch-wise").val("");

                    // Mark as invalid
                    row.attr("data-itemdetail-valid", "false");

                    // Clear Item Details Modal fields (except barcode)
                    $("#popupExpiry").val("");
                    $("#popupMrp").val("");
                    $("#popupSalseRateA").val("");
                    $("#popupSalseRateB").val("");

                    // Keep barcode from previous data or response
                    let existingBarcode = row.find(".barcode").val() || response.barcode || "";
                    $("#popupBarcode").val(existingBarcode);

                    // Open Item Details Modal
                    selectedRow = row;
                    popupOpen = true;
                    $("#itemDetailModal").modal("show");
                }

            }).fail(function() {
                hideLoader();
                toastr.error("Error loading batches");
            });
        });

        function openBatchModalWithData(itemId, currentRow) {
            selectedRow = currentRow;
            popupOpen = true;

            let rowExpiry = currentRow.find(".expirydate").val();
            let rowMrp = currentRow.find(".mrp").val();
            let rowRateA = currentRow.find(".salserateA").val();
            let rowRateB = currentRow.find(".salserateB").val();
            let rowBarcode = currentRow.find(".barcode").val();

            $.get(`/Purchase/GetBatchesByItemId?id=${itemId}`, function (response) {
                $("#popupExpiry").val(rowExpiry || "");
                $("#popupMrp").val(rowMrp || "");
                $("#popupSalseRateA").val(rowRateA || "");
                $("#popupSalseRateB").val(rowRateB || "");
                $("#popupBarcode").val(rowBarcode || response.barcode || "");

                $("#itemDetailModal").modal("show");
            });
        }

        $("#saveItemPopup").click(function () {
            if (!validateExpiry(true)) {
                $("#popupExpiry").focus();
                return;
            }

            if (!validateMrp(true)) {
                $("#popupMrp").focus();
                return;
            }

            itemDetailSaved = true;

            if (selectedRow) {
                selectedRow.find(".expirydate").val($("#popupExpiry").val());
                selectedRow.find(".mrp").val(parseFloat($("#popupMrp").val()).toFixed(2));
                selectedRow.find(".salserateA").val($("#popupSalseRateA").val());
                selectedRow.find(".salserateB").val($("#popupSalseRateB").val());
                selectedRow.find(".barcode").val($("#popupBarcode").val());
                selectedRow.attr("data-itemdetail-valid", "true");
            }

            $("#itemDetailModal").modal("hide");
            popupOpen = false;

            setTimeout(() => {
                if (selectedRow) selectedRow.find(".qty").focus().select();
            }, 150);
        });

        $('#itemDetailModal').on('shown.bs.modal', function () {
            $("#popupExpiry").focus().select();
        });

        $('#itemDetailModal').on('hidden.bs.modal', function () {
            popupOpen = false;
            if (!itemDetailSaved && currentRow) {
                currentRow.attr("data-itemdetail-valid", "false");
            }
            itemDetailSaved = false;
        });

        $(document).on("keydown", "#itemDetailModal input", function (e) {
            if (e.key !== "Enter") return;
            e.preventDefault();

            const id = this.id;

            if (id === "popupExpiry") {
                if (!validateExpiry(true)) return;
                $("#popupMrp").focus().select();
                return;
            }

            if (id === "popupMrp") {
                if (!validateMrp(true)) return;
                $("#popupSalseRateA").focus().select();
                return;
            }

            const inputs = $("#itemDetailModal input:visible");
            const index = inputs.index(this);

            if (index > -1 && index < inputs.length - 1) {
                inputs.eq(index + 1).focus().select();
            } else {
                $("#saveItemPopup").focus();
            }
        });

        function processItemSelection(itemId, row) {
            currentRow = row;

            showLoader("Checking batches...");

            $.get(`/Purchase/GetBatchesByItemId?id=${itemId}`, function (response) {
                hideLoader();

                if (response.groupedResult && response.groupedResult.length > 0) {
                    let batchRows = '';
                    response.groupedResult.forEach(batch => {
                        const d = new Date(batch.expiry);
                        const formattedExpiry = ("0" + (d.getMonth() + 1)).slice(-2) + "/" + d.getFullYear();
                        const encoded = encodeURIComponent(JSON.stringify(batch));

                        batchRows += `
                            <tr class="batch-row" data-batch="${encoded}">
                                <td>${batch.batch}</td>
                                <td>${formattedExpiry}</td>
                                <td>${batch.rate}</td>
                                <td>${batch.mrp}</td>
                                <td>${batch.qty}</td>
                                <td hidden>${batch.salserateA}</td>
                                <td hidden>${batch.salserateB}</td>
                                <td>${batch.barcode}</td>
                            </tr>`;
                    });

                    $("#batchTableBody").html(batchRows);
                    currentBatchIndex = -1;
                    $("#batchModal").modal("show");
                } else {
                    focusBatchAfterItemSelect = true;
                }

            }).fail(function() {
                hideLoader();
                toastr.error("Error loading batches");
                setTimeout(() => row.find(".batch").focus().select(), 150);
            });
        }
    </script>

    <!-- ================================================================
         🔹 BATCH MODAL NAVIGATION
         ================================================================ -->
    <script>
        $('#batchModal').on('shown.bs.modal', function () {
            batchNavMode = "keyboard";
            isKeyboardScrollingBatchModal = false;

            $("#batchModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".batch-row:visible");

            currentBatchIndex = -1;

            if ($rows.length) {
                currentBatchIndex = 0;
                highlightBatchRow($rows, currentBatchIndex);
            }
        });

        function highlightBatchRow($rows, index) {
            $rows.removeClass("selected");

            const $row = $rows.eq(index);
            if (!$row.length) return;

            $row.addClass("selected");

            const container = document.querySelector("#batchModal .batch-table-wrapper");
            if (!container) return;

            const rowRect = $row[0].getBoundingClientRect();
            const containerRect = container.getBoundingClientRect();
            const headerHeight = document.querySelector("#batchTable thead")?.offsetHeight || 50;

            if (rowRect.top < containerRect.top + headerHeight) {
                container.scrollTop -= (containerRect.top + headerHeight - rowRect.top);
            }
            else if (rowRect.bottom > containerRect.bottom) {
                container.scrollTop += (rowRect.bottom - containerRect.bottom);
            }
        }

        $(document).on("click", ".batch-row", function () {
            $(".batch-row").removeClass("selected");
            $(this).addClass("selected");

            const encoded = $(this).attr("data-batch");
            try {
                const batch = JSON.parse(decodeURIComponent(encoded));
                if (currentRow) {
                    let formatted = "";

                    currentRow.find(".batch").val(batch.batch);
                    currentRow.find(".rate").val(batch.rate || 0);
                    currentRow.find(".mrp").val(batch.mrp || 0);

                    if (batch.qty && parseFloat(batch.qty) > 0) {
                        currentRow.find(".qty").val(1); // Set 1 if stock available
                    } else {
                        currentRow.find(".qty").val(0); // Set 0 if no stock
                    }

                    //currentRow.find(".qty").val(batch.qty || 0);
                    currentRow.find(".salserateA").val(batch.salserateA || 0);
                    currentRow.find(".salserateB").val(batch.salserateB || 0);
                    currentRow.find(".barcode").val(batch.barcode);

                    if (batch.expiry) {
                        let date = new Date(batch.expiry);
                        formatted = ("0" + (date.getMonth() + 1)).slice(-2) + "/" + date.getFullYear();
                        currentRow.find(".expirydate").val(formatted);
                    }

                    if (formatted) {
                        $("#popupExpiry").val(formatted);
                    }

                    if (batch.mrp !== undefined && batch.mrp !== null) {
                        $("#popupMrp").val(batch.mrp);
                    }

                    if (batch.salserateA !== undefined && batch.salserateA !== null) {
                        $("#popupSalseRateA").val(batch.salserateA);
                    }

                    if (batch.salserateB !== undefined && batch.salserateB !== null) {
                        $("#popupSalseRateB").val(batch.salserateB);
                    }

                    if (batch.barcode) {
                        $("#popupBarcode").val(batch.barcode);
                    }

                    currentRow.attr("data-itemdetail-valid", "true");
                    calculateRow(currentRow);
                }
                $("#batchModal").modal("hide");

                popupOpen = true;
                selectedRow = currentRow;

                setTimeout(() => {
                    $("#itemDetailModal").modal("show");
                }, 150);

            } catch (err) {
                alert("Invalid batch data.");
                console.error(err);
            }
        });

        $(document).on("mousemove", "#batchModal", function () {
            isKeyboardScrollingBatchModal = false;
        });

        $(document).on("keydown", function (e) {
            if (!$("#batchModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                batchNavMode = "keyboard";
                isKeyboardScrollingBatchModal = true;

                $("#batchModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".batch-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentBatchIndex === -1) {
                    currentBatchIndex = 0;
                } else if (currentBatchIndex < $rows.length - 1) {
                    currentBatchIndex++;
                }

                highlightBatchRow($rows, currentBatchIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();
                if (currentBatchIndex <= 0) return;

                currentBatchIndex--;
                highlightBatchRow($rows, currentBatchIndex);
            }
            else if (e.key === "Enter" && currentBatchIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentBatchIndex).trigger("click");
            }
        });

        $(document).on("mouseenter", ".batch-row", function () {
            if (!$("#batchModal").is(":visible")) return;

            if (isKeyboardScrollingBatchModal) return;

            batchNavMode = "mouse";

            $("#batchModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".batch-row:visible");
            $rows.removeClass("selected");

            $(this).addClass("selected");
            currentBatchIndex = $rows.index(this);
        });
    </script>

    <!-- ================================================================
         🔹 CALCULATIONS
         ================================================================ -->
    <script>
        $(document).on("input", ".qty, .discount, .rate", function () {
            calculateRow($(this).closest("tr"));
        });

        // ITEM DISCOUNT VALIDATION
        $(document).on("input", ".discount", function() {
            let value = parseFloat($(this).val()) || 0;

            // HARD LIMIT: Cannot exceed 100%
            if (value > 100) {
                toastr.error("Item discount cannot exceed 100%", "Invalid Discount");
                $(this).val(100);
                calculateRow($(this).closest("tr"));
                return;
            }

            // WARNING: If discount > 50%
            if (value > 50) {
                toastr.warning("High item discount: " + value + "%", "Review Required");
            }
        });
         
        function calculateRow(row) {

            let purchaseType = $("#purchasetype").val();

            let qty = parseFloat(row.find(".qty").val()) || 0;
            let freeQty = parseFloat(row.find(".freeqty").val()) || 0;
            let rate = parseFloat(row.find(".rate").val()) || 0;

            let igst = parseFloat(row.find(".gst").val()) || 0;
            let sgst = parseFloat(row.find(".sgst").val()) || 0;
            let cgst = parseFloat(row.find(".cgst").val()) || 0;

            let discount = parseFloat(row.find(".discount").val()) || 0;

             
            let grossAmount = qty * rate;

            let discountAmt = (grossAmount * discount) / 100;
            let amountAfterDiscount = grossAmount - discountAmt;

            let igstAmt = 0;
            let sgstAmt = 0;
            let cgstAmt = 0;

            if (purchaseType === "Local") {

                sgstAmt = (amountAfterDiscount * sgst) / 100;
                cgstAmt = (amountAfterDiscount * cgst) / 100;

            } else {

                igstAmt = (amountAfterDiscount * igst) / 100;

            }

            let gstAmt = igstAmt + sgstAmt + cgstAmt;

            let total = amountAfterDiscount + gstAmt;

            // BILL DISCOUNT
            let billDiscountPercent = parseFloat($("#discountPercent").val()) || 0;
            let billDiscountAmt = (amountAfterDiscount * billDiscountPercent) / 100;

            let finalAmount = amountAfterDiscount - billDiscountAmt;

            // GST AFTER BILL DISCOUNT
            let finalGstAmt = 0;

            if (purchaseType === "Local") {

                finalGstAmt =
                    (finalAmount * sgst / 100) +
                    (finalAmount * cgst / 100);

            } else {

                finalGstAmt = (finalAmount * igst) / 100;

            }

            let totalWithBillDiscount = finalAmount + finalGstAmt;

            // BATCH-WISE COST
            let totalQty = qty + freeQty;
            let netCost = totalQty > 0 ? totalWithBillDiscount / totalQty : 0;

            // UPDATE ROW
            row.find(".discount-amt").val(discountAmt.toFixed(2));

            row.find(".gstamt").val(igstAmt.toFixed(2));
            row.find(".cgstamt").val(cgstAmt.toFixed(2));
            row.find(".sgstamt").val(sgstAmt.toFixed(2));

            row.find(".total").val(total.toFixed(2));
            row.find(".batch-wise").val(netCost.toFixed(4));

            calculateTotalSummary();
        }
        function calculateTotalSummary() {

            let total = 0, totalGst = 0, totalDiscount = 0, totalamt = 0;
            let totalCgst = 0, totalSgst = 0;

            let gstRows = [];
            let purchaseType = $("#purchasetype").val();

            $("#PurchaseItemBody tr").each(function () {

                let row = $(this);

                let qty = parseFloat(row.find(".qty").val()) || 0;
                let rate = parseFloat(row.find(".rate").val()) || 0;
                let gst = parseFloat(row.find(".gst").val()) || 0;
                let discount = parseFloat(row.find(".discount").val()) || 0;

                let igst = parseFloat(row.find(".gst").val()) || 0;
                let cgst = parseFloat(row.find(".cgst").val()) || 0;
                let sgst = parseFloat(row.find(".sgst").val()) || 0;

                let grossAmount = qty * rate;

                let discountAmt = (grossAmount * discount) / 100;

                let amountAfterDiscount = grossAmount - discountAmt;

                let igstAmt = 0;
                let cgstAmt = 0;
                let sgstAmt = 0;

                if (purchaseType === "Local") {

                    cgstAmt = (amountAfterDiscount * cgst) / 100;
                    sgstAmt = (amountAfterDiscount * sgst) / 100;

                    totalCgst += cgstAmt;
                    totalSgst += sgstAmt;

                }
                else {

                    igstAmt = (amountAfterDiscount * igst) / 100;

                    totalGst += igstAmt;

                }

                total += amountAfterDiscount;
                totalamt += amountAfterDiscount;
                totalDiscount += discountAmt;

                gstRows.push({
                    rate: amountAfterDiscount,
                    gst: gst,
                    cgst: cgst,
                    sgst: sgst
                });

            });


            let percentInput = parseFloat($("#discountPercent").val()) || 0;
            let amountInput = parseFloat($("#discountamount").val()) || 0;

            let globalDiscountPercent = 0;
            let globalDiscountAmt = 0;

            if ($("#discountPercent").is(":focus") || (percentInput > 0 && amountInput === 0)) {

                globalDiscountPercent = percentInput;

                globalDiscountAmt = (total * globalDiscountPercent) / 100;

                $("#discountamount").val(globalDiscountAmt.toFixed(2));

            }
            else if ($("#discountamount").is(":focus") || (amountInput > 0 && percentInput === 0)) {

                globalDiscountAmt = amountInput;

                globalDiscountPercent = total > 0 ? (globalDiscountAmt / total) * 100 : 0;

                $("#discountPercent").val(globalDiscountPercent.toFixed(2));

            }
            else if (percentInput > 0 && amountInput > 0) {

                globalDiscountPercent = percentInput;

                globalDiscountAmt = (total * globalDiscountPercent) / 100;

                $("#discountamount").val(globalDiscountAmt.toFixed(2));

            }


            if (globalDiscountAmt > 0) {

                totalDiscount += globalDiscountAmt;

                totalamt = total - globalDiscountAmt;

                totalGst = 0;
                totalCgst = 0;
                totalSgst = 0;

                gstRows.forEach(row => {

                    let rowDiscountAmt = (row.rate * globalDiscountPercent) / 100;

                    let rowAfterGlobalDiscount = row.rate - rowDiscountAmt;

                    if (purchaseType === "Local") {

                        let cgstAmt = (rowAfterGlobalDiscount * row.cgst) / 100;
                        let sgstAmt = (rowAfterGlobalDiscount * row.sgst) / 100;

                        totalCgst += cgstAmt;
                        totalSgst += sgstAmt;

                    }
                    else {

                        let gstAmt = (rowAfterGlobalDiscount * row.gst) / 100;

                        totalGst += gstAmt;

                    }

                });

            }


            let totalTax = purchaseType === "Local"
                ? totalCgst + totalSgst
                : totalGst;
            let totalscgst = purchaseType === "Local"
                ? totalCgst + totalSgst
                : 0;

            let totalPayable = totalamt + totalTax;

            let roundedPayable = Math.round(totalPayable);

            let roundOffAmount = Number((roundedPayable - totalPayable).toFixed(2));


            $("[name='Total']").val(total.toFixed(2));

            $("[name='Totaldiscount']").val(totalDiscount.toFixed(2));


            if (purchaseType === "Local") {

                $("[name='TotalCGstAmt']").val(totalCgst.toFixed(2));

                $("[name='TotalSGstAmt']").val(totalSgst.toFixed(2));
                $("[name='TotalSCGstAmt']").val(totalscgst.toFixed(2));

                $("[name='TotalGstAmt']").val(0);

            }
            else {

                $("[name='TotalGstAmt']").val(totalGst.toFixed(2));

                $("[name='TotalCGstAmt']").val(0);

                $("[name='TotalSGstAmt']").val(0);
                $("[name='TotalSCGstAmt']").val(0);

            }


            $("[name='TotalPayable']").val(roundedPayable);

            $("[name='RoundOffAmount']").val(roundOffAmount);

        }
         
        $("#discountPercent, #discountamount").on("input", function () {

            // Recalculate all rows (to update batch-wise cost)
            $("#PurchaseItemBody tr").each(function() {
                calculateRow($(this));
            });

            calculateTotalSummary();
        });
         
        $("#discountPercent").on("input", function() {
            let value = parseFloat($(this).val()) || 0;
             
            if (value > 100) {
                toastr.error("Discount cannot exceed 100%", "Invalid Discount");
                $(this).val(100); // Set to max 100
                return;
            }
             
            if (value > 50) {
                toastr.warning("High discount alert: " + value + "%", "Review Required");
            }
        });
    </script>

   
    <script>
        $(document).ready(function() {
            $("#supplierForm").submit(function (e) {
                e.preventDefault();

                let isFormValid = true;

                $("#addSupplierModal input").each(function () {
                    if (!validateSupplierField(this, true)) {
                        $(this).focus().select();
                        isFormValid = false;
                        return false;
                    }
                });

                if (!isFormValid) return;

                showLoader("Creating supplier...");

                $.post('/Supplier/CreateSupplier', $(this).serialize(), function (res) {
                    hideLoader();

                    if (res.success) {
                        // ✅ Update hidden supplier-id and input
                        $(".supplier-id").val(res.id);
                        $(".supplier-input").val(res.firstName);

                        $("#supplierForm")[0].reset();

                        $('#addSupplierModal').one('hidden.bs.modal', function () {
                            document.activeElement.blur();

                            requestAnimationFrame(() => {
                                $(".supplier-input").trigger('focus'); // ✅ FIXED
                            });

                        }).modal('hide');

                        toastr.success("Supplier created successfully");
                    }
                    else {
                        toastr.error(res.message || "Supplier already exists");
                        $("input[name='PhoneNO']").focus().select();
                    }
                }).fail(function () {
                    hideLoader();
                    toastr.error("Server error while creating supplier");
                });
            });

            $('#addSupplierModal').on('shown.bs.modal', function () {
                $('#firstname').trigger('focus');
            });
        });

        $(document).on("keydown", "#addSupplierModal input", function (e) {
            if (e.key !== "Enter") return;

            e.preventDefault();

            if (!validateSupplierField(this, true)) {
                $(this).focus().select();
                return;
            }

            const inputs = $("#addSupplierModal input:visible");
            const index = inputs.index(this);

            if (index < inputs.length - 1) {
                inputs.eq(index + 1).focus().select();
            } else {
                $("#supplierForm button[type='submit']").focus();
            }
        });
    </script>

