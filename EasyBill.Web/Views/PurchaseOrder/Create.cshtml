    <script>
        $(document).on("keydown", ".item-input", function (e) {
            const row = $(this).closest("tr");

            if (e.key === "ArrowRight") {
                e.preventDefault();
                row.find(".batch").focus().select();
                return;
            }

            if (e.key === "ArrowDown") {
                e.preventDefault();
                const nextRow = row.next("tr");
                if (nextRow.length) nextRow.find(".item-input").focus();
                return;
            }

            if (e.key === "ArrowUp") {
                e.preventDefault();
                const prevRow = row.prev("tr");
                if (prevRow.length) {
                    prevRow.find(".item-input").focus();
                } else {
                    $("#PartyBillDate").focus();
                }
                return;
            }

            if (e.key === "Enter") {
                e.preventDefault();
                currentRow = row;
                currentRowForItemModal = row;

                const typedText = $(this).val().trim();
                openItemModal(typedText);
            }
        });

        function openItemModal(searchText = "") {
             var purchaseType = $("#purchasetype").val();
            showLoader("Loading items...");

            $.get('/Purchase/GetAllItems', { purchaseType: purchaseType }, function (items) {
                hideLoader();

                let rows = "";
                const businessType = @ViewBag.BusinessType;
                items.forEach(item => {
                    rows += `
                        <tr class="item-row" tabindex="0"
                            data-itemid="${item.id}"
                            data-name="${item.name}"
                            data-gst="${item.gst}"
                            data-cgst="${item.cgst}"
                            data-sgst="${item.sgst}"
                            data-hsn="${item.hsn || ''}"
                            data-purchaserate="${item.purchaseRate || 0}">
                            <td>${item.name}</td>
                            ${
                            businessType === 2
                            ? `
                                <td style="display:none;">${item.qty}</td>
                                <td>${item.availableQty}</td>
                              `
                            : `
                                <td>${item.qty}</td>
                              `
                            }
                            <td>${item.unit || 'N/A'}</td>
                        </tr>`;
                });

                $("#itemTableBody").html(rows);
                $("#itemSearch").val(searchText);
                $("#itemSearch").trigger("input");

                $("#itemModal").modal("show");

            }).fail(function() {
                hideLoader();
                toastr.error("Error loading items");
            });
        }

        $(document).on("input", "#itemSearch", function () {
            const searchWords = $(this).val()
                .toLowerCase()
                .trim()
                .split(/\s+/);

            $("#itemTableBody tr").each(function () {
                const itemText = $(this).find("td:first").text().toLowerCase();
                const itemWords = itemText.split(/\s+/);

                let match = true;

                for (let i = 0; i < searchWords.length; i++) {
                    if (!itemWords[i] || !itemWords[i].startsWith(searchWords[i])) {
                        match = false;
                        break;
                    }
                }

                $(this).toggle(match);
            });

            currentItemIndex = -1;
            $("#itemTableBody .item-row").removeClass("selected");
        });

        $(document).on("keydown", function (e) {
            if (!$("#itemModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                itemNavMode = "keyboard";
                isKeyboardScrollingItemModal = true;
                $("#itemModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".item-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentItemIndex === -1) {
                    currentItemIndex = 0;
                }
                else if (currentItemIndex < $rows.length - 1) {
                    currentItemIndex++;
                }

                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();
                if (currentItemIndex <= 0) return;
                currentItemIndex = (currentItemIndex - 1 + $rows.length) % $rows.length;
                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "Enter" && currentItemIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentItemIndex).trigger("click");
            }
        });

        function highlightItemRow($rows, index) {
            $rows.removeClass("selected");
            const $row = $rows.eq(index);
            $row.addClass("selected");
            $row[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
        }

        $(document).on("click", ".item-row", function () {
            const itemId = $(this).data("itemid");
            const itemName = $(this).data("name");
            const gst = $(this).data("gst");
            const hsn = $(this).data("hsn");
            const purchaseRate = $(this).data("purchaserate");

           const purchaseType = $("#purchasetype").val();

           const cgst = $(this).data("cgst");
           const sgst = $(this).data("sgst");
           var scgst = cgst+sgst;

            if (!itemId || !currentRowForItemModal) return;

             if (purchaseType === "Local") {
                   currentRowForItemModal.find(".cgst").val(cgst);
                   currentRowForItemModal.find(".sgst").val(sgst);
                   currentRowForItemModal.find(".scgst").val(scgst);
                   currentRowForItemModal.find(".gst").val(0);
             } else {
                 currentRowForItemModal.find(".gst").val(gst);
                 currentRowForItemModal.find(".cgst").val(0);
                 currentRowForItemModal.find(".sgst").val(0);
                 currentRowForItemModal.find(".scgst").val(0);
             }

            currentRowForItemModal.find(".item-id").val(itemId);
            currentRowForItemModal.find(".item-input").val(itemName);
           // currentRowForItemModal.find(".gst").val(gst);
            currentRowForItemModal.find(".hsn-dropdown").val(hsn);
            currentRowForItemModal.find(".rate").val(purchaseRate); // ✅ SET
            currentRowForItemModal.find(".rate").val(purchaseRate).trigger("input"); 
            $("#itemModal").modal("hide");

           // processItemSelection(itemId, currentRowForItemModal);
            loadItemSupplierPurchaseInfo(itemId);
            currentRowForItemModal.find('.qty').focus().select();
        });

        $(document).on("mouseenter", ".item-row", function () {
            if (!$("#itemModal").is(":visible")) return;
            if (isKeyboardScrollingItemModal) return;

            itemNavMode = "mouse";

            $("#itemModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".item-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentItemIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#itemModal", function () {
            isKeyboardScrollingItemModal = false;
        });

        $('#itemModal').on('shown.bs.modal', function () {
            itemNavMode = "keyboard";

            $("#itemModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".item-row:visible");

            currentItemIndex = -1;

            if ($rows.length) {
                currentItemIndex = 0;
                highlightItemRow($rows, currentItemIndex);
            }

            setTimeout(() => {
                $("#itemSearch").focus().select();
            }, 200);
        });

        // $('#itemModal').on('hidden.bs.modal', function () {
        //     setTimeout(() => {
        //         if (focusBatchAfterItemSelect && currentRowForItemModal) {
        //             currentRowForItemModal.find(".batch").focus().select();
        //             focusBatchAfterItemSelect = false;
        //             return;
        //         }

        //         if (currentRowForItemModal && currentRowForItemModal.length) {
        //             currentRowForItemModal.find(".item-input").focus();
        //         }
        //     }, 150);
        // });

        $('#itemModal').on('hidden.bs.modal', function () {
            setTimeout(() => {

                if (currentRowForItemModal && currentRowForItemModal.length) {
                    currentRowForItemModal.find(".qty").focus().select(); // ✅ ALWAYS QTY
                }

            }, 150);
        });
        $(document).on("keydown", ".batch", function(e) {
            if (e.key === "Enter" && !popupOpen) {
                e.preventDefault();
                const row = $(this).closest("tr");
                if (!$(this).val().trim()) {
                    //toastr.warning("Batch is required");
                    return;
                }
                row.find(".qty").focus().select();
            }
        });

        $(document).on("keydown", ".qty", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const row = $(this).closest("tr");
                if (!isValidQty($(this).val())) {
                    toastr.warning("Quantity must be greater than 0");
                    $(this).focus().select();
                    return;
                }
               // row.find(".freeqty").focus().select();
                 row.find(".rate").focus().select();
            }
        });

        $(document).on("keydown", ".freeqty", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                $(this).closest("tr").find(".rate").focus().select();
            }
        });

        $(document).on("keydown", ".rate", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const row = $(this).closest("tr");
                if (!isValidRate($(this).val())) {
                    toastr.warning("Rate must be greater than 0");
                    $(this).focus().select();
                    return;
                }
                row.find(".discount").focus().select();
            }
        });

        $(document).on("keydown", ".discount", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const row = $(this).closest("tr");

                if (!validateRow(row)) return;

                const isItemDetailValid = row.attr("data-itemdetail-valid") === "true";

                if (ENABLE_ITEM_DETAIL_VALIDATION && !isItemDetailValid) {
                    currentRow = row;
                    selectedRow = row;
                    popupOpen = true;
                    $("#itemDetailModal").modal("show");
                    return;
                }

                const isLastRow = row.is("#PurchaseItemBody tr:last");

                if (isLastRow) {
                    addNewRow();
                    setTimeout(() => $("#PurchaseItemBody tr:last .item-input").focus(), 150);
                } else {
                    const nextRow = row.next("tr");
                    if (nextRow.length) nextRow.find(".item-input").focus();
                }
            }
        });
    </script>

    <!-- ================================================================
         🔹 ARROW KEY NAVIGATION
         ================================================================ -->
    <script>
        $(document).on("keydown", ".batch, .qty, .freeqty, .rate, .discount", function(e) {
            const row = $(this).closest("tr");
            const current = $(this);

            if (e.key === "ArrowRight") {
                e.preventDefault();
                if (current.hasClass("batch")) row.find(".qty").focus().select();
                else if (current.hasClass("qty")) row.find(".freeqty").focus().select();
                else if (current.hasClass("freeqty")) row.find(".rate").focus().select();
                else if (current.hasClass("rate")) row.find(".discount").focus().select();
            }

            if (e.key === "ArrowLeft") {
                e.preventDefault();
                if (current.hasClass("discount")) row.find(".rate").focus().select();
                else if (current.hasClass("rate")) row.find(".freeqty").focus().select();
                else if (current.hasClass("freeqty")) row.find(".qty").focus().select();
                else if (current.hasClass("qty")) row.find(".batch").focus().select();
                else if (current.hasClass("batch")) row.find(".item-input").focus();
            }

            if (e.key === "ArrowDown") {
                e.preventDefault();
                const nextRow = row.next("tr");
                if (!nextRow.length) return;

                if (current.hasClass("batch")) nextRow.find(".batch").focus().select();
                else if (current.hasClass("qty")) nextRow.find(".qty").focus().select();
                else if (current.hasClass("freeqty")) nextRow.find(".freeqty").focus().select();
                else if (current.hasClass("rate")) nextRow.find(".rate").focus().select();
                else if (current.hasClass("discount")) nextRow.find(".discount").focus().select();
            }

            if (e.key === "ArrowUp") {
                e.preventDefault();
                const prevRow = row.prev("tr");

                if (!prevRow.length) {
                    $("#PartyBillDate").focus();
                    return;
                }

                if (current.hasClass("batch")) prevRow.find(".batch").focus().select();
                else if (current.hasClass("qty")) prevRow.find(".qty").focus().select();
                else if (current.hasClass("freeqty")) prevRow.find(".freeqty").focus().select();
                else if (current.hasClass("rate")) prevRow.find(".rate").focus().select();
                else if (current.hasClass("discount")) prevRow.find(".discount").focus().select();
            }
        });
    </script>

    <!-- ================================================================
         🔹 ADD ROW & REMOVE ROW
         ================================================================ -->
    <script>
        $(document).ready(function() {
            $("#addRow").click(function() {
                if (!validateHeaderFields()) return;

                if ($("#PurchaseItemBody tr").length > 0) {
                    if (!validateAllRows()) return;
                }

                let invalidRow = null;
                $("#PurchaseItemBody tr").each(function () {
                    if ($(this).attr("data-itemdetail-valid") !== "true") {
                        invalidRow = $(this);
                        return false;
                    }
                });

                if (ENABLE_ITEM_DETAIL_VALIDATION && invalidRow) {
                    currentRow = invalidRow;
                    selectedRow = invalidRow;
                    popupOpen = true;
                    $("#itemDetailModal").modal("show");
                    return;
                }

                addNewRow();
                setTimeout(() => $("#PurchaseItemBody tr:last .item-input").focus(), 150);
            });
        });

        function addNewRow() {
            let purchasetype = $("#purchasetype").val();
            let newRow = `
                <tr data-itemdetail-valid="false">
                    <td style="min-width:250px;">
                       <input type="hidden" name="PurchaseOrderItemVMs[${rowIndex}].ItemId" class="item-id" />
                       <input type="text" name="PurchaseOrderItemVMs[${rowIndex}].ItemName" class="form-control form-control-sm item-input" placeholder="Press Enter to select item" />
                    </td>
                    <td hidden>
                      <input name="PurchaseOrderItemVMs[${rowIndex}].Batch" class="form-control form-control-sm batch" />
                    </td>
                    <td hidden>
                      <input type="text" name="PurchaseOrderItemVMs[${rowIndex}].ExpiryDate" class="form-control form-control-sm expirydate" placeholder="MM/YYYY" maxlength="7" />
                    </td>
                    <td hidden><input name="PurchaseOrderItemVMs[${rowIndex}].Mrp" class="form-control form-control-sm mrp" /></td>
                    <td><input name="PurchaseOrderItemVMs[${rowIndex}].Qty" class="form-control form-control-sm qty" value="1" /></td>
                    <td hidden><input name="PurchaseOrderItemVMs[${rowIndex}].FreeQty" class="form-control form-control-sm freeqty" value="0" /></td>
                    <td><input name="PurchaseOrderItemVMs[${rowIndex}].Rate" class="form-control form-control-sm rate" /></td>
                    <td hidden><input name="PurchaseOrderItemVMs[${rowIndex}].salserateA" class="form-control form-control-sm salserateA" /></td>
                    <td hidden><input name="PurchaseOrderItemVMs[${rowIndex}].salserateB" class="form-control form-control-sm salserateB" /></td>
                    <td hidden style="min-width:100px;">
                        <select name="PurchaseOrderItemVMs[${rowIndex}].HsnId" class="form-control form-control-sm hsn-dropdown">
                            <option value="">-- Select Item --</option>
        @foreach (var item in ViewBag.Hsn)
        {
                                                                           <option value="@item.Value">@item.Text</option>
        }
                        </select>
                    </td>
                    <td><input name="PurchaseOrderItemVMs[${rowIndex}].Discount" class="form-control form-control-sm discount" value="0" min="0" max="100" step="0.01" /></td>
                    <td hidden><input name="PurchaseOrderItemVMs[${rowIndex}].DiscountAmt" class="form-control form-control-sm discount-amt" readonly /></td>
                    <td class="gst-col"><input name="PurchaseOrderItemVMs[${rowIndex}].Gst" class="form-control form-control-sm gst" readonly /></td>
                    <td hidden><input name="PurchaseOrderItemVMs[${rowIndex}].GstAmount" class="form-control form-control-sm gstamt" readonly /></td>
                    <td hidden><input name="PurchaseOrderItemVMs[${rowIndex}].CGst" class="form-control form-control-sm cgst" readonly /></td>
                    <td hidden><input name="PurchaseOrderItemVMs[${rowIndex}].CGstAmount" class="form-control form-control-sm cgstamt" readonly /></td>
                    <td hidden><input name="PurchaseOrderItemVMs[${rowIndex}].SGst" class="form-control form-control-sm sgst" readonly /></td>
                    <td hidden><input name="PurchaseOrderItemVMs[${rowIndex}].SGstAmount" class="form-control form-control-sm sgstamt" readonly /></td>
                    <td class="scgst-col"><input name="PurchaseOrderItemVMs[${rowIndex}].SCGst" class="form-control form-control-sm scgst" readonly /></td>
                    <td><input name="PurchaseOrderItemVMs[${rowIndex}].TotalAmt" class="form-control form-control-sm total" readonly /></td>
                    <td hidden><input name="PurchaseOrderItemVMs[${rowIndex}].BatchWiseCose" class="form-control form-control-sm batch-wise" readonly /></td>
                    <td hidden><input name="PurchaseOrderItemVMs[${rowIndex}].Barcode" class="form-control form-control-sm barcode" readonly /></td>
                    <td><u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u></td>
                </tr>`;

            $("#PurchaseItemBody").append(newRow);

            let newTr = $("#PurchaseItemBody tr:last");

            if (purchasetype === "Local") {

                newTr.find(".gst-col").hide();
                newTr.find(".scgst-col").show();

            } else {

                newTr.find(".gst-col").show();
                newTr.find(".scgst-col").hide();

            }

            rowIndex++;
        }

        $(document).on("click", ".remove-row-btn", function() {
            $(this).closest("tr").remove();
            calculateTotalSummary();
        });
    </script>

    <script>
        $(document).on("keydown", ".item-input, .batch, .qty, .freeqty, .rate, .discount", function (e) {
            if (e.key !== "Tab") return;

            const row = $(this).closest("tr");

            const itemId = row.find(".item-id").val();
            const batch = row.find(".batch").val()?.trim();
            const qty = row.find(".qty").val();
            const rate = row.find(".rate").val();

            const isBlankRow =
                (!itemId || itemId === "") &&
                (!batch || batch === "") &&
                (!rate || rate === "0" || rate === "");

            if (!isBlankRow) return;

            const totalRows = $("#PurchaseItemBody tr").length;

            if (totalRows <= 1) {
                e.preventDefault();
                toastr.error("At least one item row is required", "Validation Error");
                return;
            }

            e.preventDefault();
            row.remove();

            setTimeout(() => {
                $("#discountPercent").focus().select();
            }, 50);
        });
    </script>

