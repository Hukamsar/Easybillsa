@using EasyBill.Models.ViewModels
@model POWithAIVM
<form asp-action="GenerateReorder" method="post" id="reorderForm">
    <div class="row">

        <!-- Supplier Type -->
        <div class="col-md-3">
            <label>Supplier Type</label>
            <select class="form-control" name="SupplierType">
                <option value="Last">Last Supplier</option>
                <option value="Best">Best Supplier</option>
            </select>
        </div>

        <!-- Company -->
        <div class="col-md-3">
            <label>Company</label>
            <select class="form-control" name="CompanyId">
                <option value="">All Companies</option>
                @* @foreach (var item in ViewBag.Companies)
                {
                    <option value="@item.Id">@item.Name</option>
                } *@
            </select>
        </div>

        <!-- Based On -->
        <div class="col-md-3">
            <label>Based On</label>
            <select class="form-control" name="BasedOn" id="basedOn">
                <option value="Sales">Sales</option>
                <option value="SalesOrder">Sales Order</option>
                <option value="MinQty">Minimum Qty</option>
                <option value="ZeroStock">Zero / Negative Stock</option>
            </select>
        </div>

        <!-- Calculate Days -->
        <div class="col-md-3">
            <label>Calculate Based On Days</label>
            <input type="number" class="form-control" name="CalculateDays" value="7" />
        </div>

    </div>

    <div class="row mt-3">

        <!-- Reorder Formula -->
        <div class="col-md-6">
            <label>Reorder Formula</label>
            <div class="d-flex gap-2">
                <input type="number" class="form-control" name="Days" placeholder="Days (e.g. 7)" />
                <span class="align-self-center">X</span>
                <input type="number" step="0.1" class="form-control" name="Multiplier" placeholder="Multiplier (e.g. 1.5)" />
            </div>
        </div>

        <!-- Less Purchase Orders -->
        <div class="col-md-3">
            <label>Less Purchase Orders</label>
            <select class="form-control" name="LessPurchaseOrders">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>

        <!-- Round Off MOQ -->
        <div class="col-md-3">
            <label>Round Off MOQ</label>
            <select class="form-control" name="RoundOffMOQ">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </select>
        </div>

    </div>

    <!-- Generate Button -->
    <div class="mt-4 text-end">
        <button type="submit" class="btn btn-primary">
            🔍 Generate Reorder
        </button>
    </div>
</form>