           // ItemMaster F2/F3 shortcut: direct ItemMaster form dropdowns can open New/Modify with existing popup forms.
           var itemMasterShortcutSettings = {
               company: { popup: "#companypopup", select: "#companyid", newTitle: "Add Company", editTitle: "Modify Company", saveFunction: "savecompany", closeFunction: "closecompany", updateUrl: "/ItemMaster/UpdateCompany", label: "Company" },
               division: { popup: "#divisionpopup", select: "#divisionId", newTitle: "Add Division", editTitle: "Modify Division", saveFunction: "savedivision", closeFunction: "closedivision", updateUrl: "/ItemMaster/UpdateDivision", label: "Division" },
               category: { popup: "#popupForm", select: "#CategoryId", newTitle: "Add New Category", editTitle: "Modify Category", saveFunction: "saveCategory", closeFunction: "closePopup", updateUrl: "/ItemMaster/UpdateCategory", label: "Category" },
               subcategory: { popup: "#SubCategoryPopup", select: "#subcategoryId", newTitle: "Add New SubCategory", editTitle: "Modify SubCategory", saveFunction: "saveSubCategory", closeFunction: "closesubcategory", updateUrl: "/ItemMaster/UpdateSubCategory", label: "SubCategory" },
               hsn: { popup: "#hsnpopup", select: "#hsnId", newTitle: "Add HSN/SAC", editTitle: "Modify HSN/SAC", saveFunction: "savehsn", closeFunction: "closehsnpopup", updateUrl: "/ItemMaster/UpdateHsn", label: "HSN" }
           };
           var itemMasterSelectShortcutMap = {
               companyid: "company",
               divisionId: "division",
               CategoryId: "category",
               subcategoryId: "subcategory",
               hsnId: "hsn"
           };

           function itemMasterSetPopupMode(type, mode, id) {
               var setting = itemMasterShortcutSettings[type];
               if (!setting) return;

               var popup = $(setting.popup);
               popup.data("itemmaster-edit-id", mode === "edit" ? id : 0);
               popup.find("h2,h4").first().text(mode === "edit" ? setting.editTitle : setting.newTitle);
               popup.find("button.btn-success").first()
                   .text(mode === "edit" ? "Update" : "Save")
                   .attr("onclick", mode === "edit" ? "itemMasterSaveModify('" + type + "')" : setting.saveFunction + "()");
           }

           function itemMasterPopupEditId(type) {
               return parseInt($(itemMasterShortcutSettings[type].popup).data("itemmaster-edit-id"), 10) || 0;
           }

           function itemMasterSelectedId(selector) {
               return parseInt($(selector).val(), 10) || 0;
           }

           function itemMasterSelectedText(selector) {
               return ($(selector).find("option:selected").text() || "").trim();
           }

           function itemMasterOpenShortcut(type, mode, event) {
               event?.preventDefault();
               if (mode === "new") {
                   itemMasterSetPopupMode(type, "new", 0);
                   if (type === "company") opencompanyPopup(event);
                   if (type === "division") opendivisionpopup(event);
                   if (type === "category") openPopup(event);
                   if (type === "subcategory") openSubCategoryPopup(event);
                   if (type === "hsn") openhsnpopup(event);
                   return;
               }

               itemMasterOpenModifyPopup(type);
           }

           function opencompanyModifyPopup(event) { itemMasterOpenShortcut("company", "edit", event); }
           function opendivisionModifyPopup(event) { itemMasterOpenShortcut("division", "edit", event); }
           function openCategoryModifyPopup(event) { itemMasterOpenShortcut("category", "edit", event); }
           function openSubCategoryModifyPopup(event) { itemMasterOpenShortcut("subcategory", "edit", event); }
           function openhsnModifyPopup(event) { itemMasterOpenShortcut("hsn", "edit", event); }

           function itemMasterOpenModifyPopup(type) {
               var setting = itemMasterShortcutSettings[type];
               var selectedId = itemMasterSelectedId(setting.select);
               var selectedText = itemMasterSelectedText(setting.select);

               if (selectedId <= 0) {
                   toastr.warning("Please select " + setting.label + " first.");
                   return;
               }

               itemMasterSetPopupMode(type, "edit", selectedId);

               if (type === "company") {
                   $("#companyName").val(selectedText);
                   $("#companypopup").show();
               } else if (type === "division") {
                   var companyId = itemMasterSelectedId("#companyid");
                   if (companyId <= 0) {
                       toastr.warning("Please select Company first.");
                       return;
                   }
                   $("#divisionname").val(selectedText);
                   $("#divisionpopup").show();
                   if (typeof loadDivisionCompanies === "function") loadDivisionCompanies();
                   else if (typeof loadCompanies === "function") loadCompanies();
                   setTimeout(function () { $("#companyDropdown").val(companyId); }, 500);
               } else if (type === "category") {
                   $("#CategoryName").val(selectedText);
                   $("#popupForm").show();
               } else if (type === "subcategory") {
                   var categoryId = itemMasterSelectedId("#CategoryId");
                   if (categoryId <= 0) {
                       toastr.warning("Please select Category first.");
                       return;
                   }
                   $("#subcategory").val(selectedText);
                   $("#SubCategoryPopup").show();
                   updateCategoryDropdown();
                   setTimeout(function () { $("#categoryDropdown").val(categoryId); }, 500);
               } else if (type === "hsn") {
                   $("#hsnpopup").show();
                   $("#hsnform [name='HsnCode']").val(selectedText);
                   $("#hsnform [name='HsnType']").val($("#hsnform [name='HsnType']").val() || "1");
                   fetch(`/HSN/GetDetails?Id=${selectedId}`)
                       .then(response => response.json())
                       .then(data => {
                           $("#hsnform [name='SGST']").val(data.sgst || 0);
                           $("#hsnform [name='CGST']").val(data.cgst || 0);
                           $("#hsnform [name='IGST']").val(data.igst || 0);
                           $("#hsnform [name='Cess']").val(data.cess || 0);
                       })
                       .catch(() => toastr.warning("HSN details not found."));
               }
           }

           function itemMasterSaveModify(type) {
               var setting = itemMasterShortcutSettings[type];
               var editId = itemMasterPopupEditId(type);
               var data = {};
               var refreshParentId = 0;

               if (editId <= 0) {
                   toastr.warning("Please select " + setting.label + " first.");
                   return;
               }

               if (type === "company") {
                   data = { Id: editId, Name: ($("#companyName").val() || "").trim() };
                   if (data.Name === "") { toastr.warning("Company name is required."); return; }
               } else if (type === "division") {
                   refreshParentId = itemMasterSelectedId("#companyDropdown");
                   data = { Id: editId, Name: ($("#divisionname").val() || "").trim(), CompanyId: refreshParentId };
                   if (data.Name === "") { toastr.warning("Division name is required."); return; }
                   if (data.CompanyId <= 0) { toastr.warning("Company is required."); return; }
               } else if (type === "category") {
                   data = { Id: editId, CategoryName: ($("#CategoryName").val() || "").trim() };
                   if (data.CategoryName === "") { toastr.warning("Category name is required."); return; }
               } else if (type === "subcategory") {
                   refreshParentId = itemMasterSelectedId("#categoryDropdown");
                   data = { Id: editId, Name: ($("#subcategory").val() || "").trim(), CategoryId: refreshParentId };
                   if (data.Name === "") { toastr.warning("Subcategory name is required."); return; }
                   if (data.CategoryId <= 0) { toastr.warning("Category is required."); return; }
               } else if (type === "hsn") {
                   var formData = $("#hsnform").serializeArray();
                   formData.push({ name: "Id", value: editId });
                   data = $.param(formData);
               }

               $.ajax({
                   url: setting.updateUrl,
                   type: "POST",
                   data: data,
                   success: function (response) {
                       if (response.success) {
                           toastr.success(response.message);
                           itemMasterCloseModifyPopup(type);
                           itemMasterRefreshModifiedDropdown(type, editId, refreshParentId);
                       } else {
                           toastr.warning(response.message);
                       }
                   },
                   error: function () {
                       toastr.error("Something went wrong. Please try again.");
                   }
               });
           }

           function itemMasterCloseModifyPopup(type) {
               var setting = itemMasterShortcutSettings[type];
               if (typeof window[setting.closeFunction] === "function") {
                   window[setting.closeFunction]();
               } else {
                   $(setting.popup).hide();
               }
               itemMasterSetPopupMode(type, "new", 0);
           }

           function itemMasterRefreshModifiedDropdown(type, editId, parentId) {
               if (type === "company") {
                   updatecompanyDropdown(editId);
                   setTimeout(function () { $("#companyid").val(editId); }, 600);
               } else if (type === "division") {
                   updatedivisiondrop(parentId, editId);
                   setTimeout(function () { $("#divisionId").val(editId); }, 600);
               } else if (type === "category") {
                   updateCategoryDropdown(editId);
                   setTimeout(function () { $("#CategoryId").val(editId); }, 600);
               } else if (type === "subcategory") {
                   updatesubcategorydropdown(editId);
                   setTimeout(function () { $("#subcategoryId").val(editId); }, 600);
               } else if (type === "hsn") {
                   updatehsndropdown(editId);
                   setTimeout(function () { $("#hsnId").val(editId).trigger("change"); }, 600);
               }
           }

           // ItemMaster F2/F3 shortcut: keyboard support when cursor is on the master dropdown itself.
           $(document).off("keydown.itemMasterDirectShortcuts", "#companyid,#divisionId,#CategoryId,#subcategoryId,#hsnId,.itemmaster-master-shortcut")
               .on("keydown.itemMasterDirectShortcuts", "#companyid,#divisionId,#CategoryId,#subcategoryId,#hsnId,.itemmaster-master-shortcut", function (event) {
                   var keyCode = event.which || event.keyCode;
                   if (keyCode !== 113 && keyCode !== 114) return;

                   var type = $(this).data("master-type") || itemMasterSelectShortcutMap[this.id];
                   if (!type) return;

                   itemMasterOpenShortcut(type, keyCode === 114 ? "edit" : "new", event);
               });
    </script>
