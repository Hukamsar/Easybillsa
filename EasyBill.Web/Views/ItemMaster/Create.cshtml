            }

            // Page load par bhi check kare
            updateDecimalStatus();

            // Checkbox change hone par
            $("#DecemalAllowed").on("change", function () {
                updateDecimalStatus();
            });
        });
    </script>


    <script>
        function openItemImagePopup() {
            $("#itemImagePopup").modal("show");
        }

        function closeItemImagePopup() {
            $("#itemImagePopup").modal("hide");
        }
    </script>
    <script>
        let selectedImages = [];

        $("#itemImages").on("change", function () {
            const files = Array.from(this.files);

            files.forEach(file => {
                // prevent duplicate selection (same name + size)
                if (selectedImages.some(x => x.file.name === file.name && x.file.size === file.size)) {
                    return;
                }

                selectedImages.push({
                    file: file,
                    isPrimary: selectedImages.length === 0 // first image auto primary
                });

                const reader = new FileReader();
                reader.onload = function (e) {
                    const index = selectedImages.length - 1;

                    $("#imagePreview").append(`
                        <div class="position-relative me-2 mb-2 image-box"
                             data-index="${index}">
                    
                            <img src="${e.target.result}"
                                 class="img-thumbnail"
                                 style="width:120px;height:120px;object-fit:cover" />
                    
                            <!-- ❌ Remove -->
                            <span onclick="removeImage(${index})"
                                  class="position-absolute top-0 end-0 bg-danger text-white rounded-circle"
                                  style="width:20px;height:20px;
                                         display:flex;align-items:center;
                                         justify-content:center;
                                         cursor:pointer;">×</span>
                    
                            <!-- ⭐ Primary -->
                            <div class="text-center mt-1">
                                <input type="radio"
                                       name="primaryImage"
                                       onclick="setPrimary(${index})"
                                       ${index === 0 ? "checked" : ""} />
                                <small>Primary</small>
                            </div>
                        </div>
                    `);
                };
                reader.readAsDataURL(file);
            });

            // ❌ DO NOT reset input here
            this.value = "";
        });
        function setPrimary(index) {
            selectedImages.forEach((img, i) => {
                img.isPrimary = (i === index);
            });

            $("#PrimaryIndex").val(index);
        }

        function removeImage(index) {
            const wasPrimary = selectedImages[index].isPrimary;

            selectedImages.splice(index, 1);
            $("#imagePreview").find(`[data-index='${index}']`).remove();

            // re-index preview
            $("#imagePreview .image-box").each(function (i) {
                $(this).attr("data-index", i);
            });

            // agar primary delete hua, to first ko primary banao
            if (wasPrimary && selectedImages.length > 0) {
                selectedImages[0].isPrimary = true;
                $("#PrimaryIndex").val(0);
                $("input[name='primaryImage']").first().prop("checked", true);
            }
        }

        function saveSelectedImages() {

            if (selectedImages.length === 0) {
                toastr.warning("Please select at least one image");
                return;
            }

            const dataTransfer = new DataTransfer();

            let primaryIndex = 0;
            
            selectedImages.forEach((obj, i) => {
                dataTransfer.items.add(obj.file);
                if (obj.isPrimary) primaryIndex = i;
            });
            
            document.getElementById("PrimaryIndex").value = primaryIndex;

            // 🔑 bind files to actual form input
            document.getElementById("Images").files = dataTransfer.files;

            toastr.success(selectedImages.length + " images attached");
            closeItemImagePopup();
        }
    </script>
}

<script>
    $(document).ready(function () {
        function toggleConversionFields() {
            var itemType = $("#ddlItemType").val();
            if (itemType === "Repacked") {
                $("#divParentItem").show();
                $("#divConversionFactor").show();
            } else {
                $("#divParentItem").hide();
                $("#divConversionFactor").hide();
                $("#ddlParentItem").val("");
                $("#txtConversionFactor").val("");
            }
        }

        $("#ddlItemType").on("change", toggleConversionFields);
        toggleConversionFields();

        $("#ItemmasterFrom").on("submit", function (e) {

            e.preventDefault(); // normal submit stop

            let form = this; // current form reference

            Swal.fire({
                title: 'Confirm Save?',
                text: 'Do you want to save this item?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '✅ Yes, Save',
                cancelButtonText: '❌ Cancel',
                confirmButtonColor: '#198754',
                cancelButtonColor: '#dc3545',
                reverseButtons: true
            }).then((result) => {

                if (result.isConfirmed) {
                    form.submit(); // actual submit
                }

            });

        });

    });
</script>
