@using EasyBill.Models.ViewModels
@model ItemMasterVM
@{
    ViewData["Title"] = "Create Item";
}

<style>
    .drug-check {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 10px;
        border: 1px solid #ddd;
        border-radius: 6px;
        margin-bottom: 6px;
        background: #f9f9f9;
    }

        .drug-check input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .drug-check label {
            font-weight: 500;
            cursor: pointer;
        }

</style>
<style>
    .eb-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        margin-bottom: 18px;
        /* Real card feel */
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 6px 16px rgba(0, 0, 0, 0.06);
        transition: box-shadow 0.2s ease, transform 0.2s ease;
        opacity: 0;
        transform: scale(0.96) translateY(12px);
        animation: cardEnter 0.45s ease-out forwards;
    }

        .eb-card:hover {
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.06), 0 12px 24px rgba(0, 0, 0, 0.08);
        }

    .eb-card-header {
        padding: 9px 16px;
        font-weight: 600;
        font-size: 14px;
        color: #1f2937;
        background: linear-gradient( to bottom, #f9fafb, #f3f4f6 );
        border-bottom: 1px solid #e5e7eb;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }

    .eb-card-body {
        padding: 14px 16px;
    }

    @@keyframes cardEnter {
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const cards = document.querySelectorAll(".eb-card");
        cards.forEach((card, index) => {
            card.style.animationDelay = `${index * 120}ms`;
        });
    });
</script>

<form method="post" id="ItemmasterFrom" enctype="multipart/form-data">
    <div class="container">
        <div class="row">
            <!-- Left Section -->
            <div class="col-md-6">

                <div class="eb-card">
                    <div class="eb-card-header">Basic Item Details</div>
                    <div class="eb-card-body">

                        <div class="row mb-2">
                            <label asp-for="Code" class="col-md-3 col-form-label text-start small">Code *</label>
                            <div class="col-md-6">
                                <input asp-for="Code" type="text" class="form-control form-control-sm" readonly />
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="Name" class="col-md-3 col-form-label text-start small">Name *</label>
                            <div class="col-md-6">
                                <input asp-for="Name" type="text" class="form-control form-control-sm" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="Barcode" class="col-md-3 col-form-label text-start small">Barcode</label>
                            <div class="col-md-6">
                                <input asp-for="Barcode" type="text" class="form-control form-control-sm" />
                            </div>
                            @* <img style="height:50px; width:70px" src="/Barcode/Generate?code=1234567890" /> *@

                        </div>
                        <div class="row mb-2">
                            <label class="col-md-3 col-form-label text-start">Unit</label>
                            <div class="col-md-6">
                                <input asp-for="Unit" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="Packing" class="col-md-3 col-form-label text-start small">Packing</label>
                            <div class="col-md-6">
                                <input asp-for="Packing" type="text" class="form-control form-control-sm" />
                            </div>
                        </div>

                    </div>
                </div>

                <div class="eb-card">
                    <div class="eb-card-header">Company & Category</div>
                    <div class="eb-card-body">
                        <div class="row mb-2">
                            <label asp-for="Companyname" class="col-md-3 col-form-label text-start">Company *</label>
                            <div class="col-md-6">
                                <select asp-for="CompanyId" id="companyid" asp-items="@ViewBag.company" class="form-control form-control-sm"></select>
                                <span asp-validation-for="CompanyId" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 d-flex align-content-end">
                                @* ItemMaster F2/F3 shortcut: F3-Mod added beside existing F2-New without changing popup layout. *@
                                <div>
                                    <a class="btnsecondary itemmaster-master-shortcut" id="companybutton" data-master-type="company" data-master-mode="new" style="cursor: pointer;" onclick="(function(event){opencompanyPopup(event);})(event)">F2-New</a><br />
                                    <a class="btnsecondary text-danger itemmaster-master-shortcut" data-master-type="company" data-master-mode="edit" style="cursor: pointer;" onclick="opencompanyModifyPopup(event)">F3-Mod</a>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="DivisionName" class="col-md-3 col-form-label text-start">Division Name</label>
                            <div class="col-md-6">
                                <select asp-for="DivisionId" id="divisionId" asp-items="@ViewBag.division" class="form-control form-control-sm"></select>
                                <span asp-validation-for="DivisionId" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 d-flex align-content-end">
                                @* ItemMaster F2/F3 shortcut: F3-Mod added beside existing F2-New without changing popup layout. *@
                                <div>
                                    <a class="btnsecondary itemmaster-master-shortcut" data-master-type="division" data-master-mode="new" style="cursor: pointer;" onclick="(function(event){opendivisionpopup(event);})(event)">F2-New</a><br />
                                    <a class="btnsecondary text-danger itemmaster-master-shortcut" data-master-type="division" data-master-mode="edit" style="cursor: pointer;" onclick="opendivisionModifyPopup(event)">F3-Mod</a>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="CategoryName" class="col-md-3 col-form-label text-start">Category *</label>
                            <div class="col-md-6">
                                <select asp-for="CategoryId" id="CategoryId" asp-items="@ViewBag.Categories" class="form-control form-control-sm"></select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>

                            </div>
                            <div class="col-md-3 d-flex align-content-end">
                                @* ItemMaster F2/F3 shortcut: F3-Mod added beside existing F2-New without changing popup layout. *@
                                <div>
                                    <a class="btnsecondary itemmaster-master-shortcut" id="categorybutton" data-master-type="category" data-master-mode="new" style="cursor: pointer;" onclick="(function(event){ openPopup(event); })(event)">F2-New</a><br />
                                    <a class="btnsecondary text-danger itemmaster-master-shortcut" data-master-type="category" data-master-mode="edit" style="cursor: pointer;" onclick="openCategoryModifyPopup(event)">F3-Mod</a>
                                </div>
                            </div>

                        </div>
                        <div class="row mb-2">
                            <label asp-for="SubCategoryname" class="col-md-3 col-form-label text-start">Sub Category *</label>
                            <div class="col-md-6">
                                <select asp-for="SubCategoryId" id="subcategoryId" asp-items="@ViewBag.SubCategories" class="form-control form-control-sm"></select>
                                <span asp-validation-for="SubCategoryId" class="text-danger"></span>

                            </div>
                            <div class="col-md-3 d-flex align-content-end">
                                @* ItemMaster F2/F3 shortcut: F3-Mod added beside existing F2-New without changing popup layout. *@
                                <div>
                                    <a class="btnsecondary itemmaster-master-shortcut" id="subcategorybutton" data-master-type="subcategory" data-master-mode="new" style="cursor: pointer;" onclick="(function(event){openSubCategoryPopup(event);})(event)">F2-New</a><br />
                                    <a class="btnsecondary text-danger itemmaster-master-shortcut" data-master-type="subcategory" data-master-mode="edit" style="cursor: pointer;" onclick="openSubCategoryModifyPopup(event)">F3-Mod</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="eb-card">
                    <div class="eb-card-header">HSN And GST Details</div>
                    <div class="eb-card-body">

                        <div class="row mb-2">
                            <label asp-for="HsnCode" class="col-md-3 col-form-label text-start">HSN/SAC *</label>
                            <div class="col-md-6">
                                <select asp-for="HsnId" id="hsnId" asp-items="@ViewBag.Hsn" class="form-control form-control-sm"></select>
                                <span asp-validation-for="HsnId" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 d-flex align-content-end">
                                @* ItemMaster F2/F3 shortcut: F3-Mod added beside existing F2-New without changing popup layout. *@
                                <div>
                                    <a class="btnsecondary itemmaster-master-shortcut" data-master-type="hsn" data-master-mode="new" style="cursor: pointer;" onclick="(function(event){openhsnpopup(event);})(event)">F2-New</a><br />
                                    <a class="btnsecondary text-danger itemmaster-master-shortcut" data-master-type="hsn" data-master-mode="edit" style="cursor: pointer;" onclick="openhsnModifyPopup(event)">F3-Mod</a>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="Local" class="col-md-3 col-form-label text-start">Local</label>
                            <div class="col-md-6">
                                <select asp-for="Local" id="local" asp-items="@ViewBag.Local" class="form-control form-control-sm">
                                </select>
                                <span asp-validation-for="Local" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="Central" class="col-md-3 col-form-label text-start">Central</label>
                            <div class="col-md-6">
                                <select asp-for="Central" id="Central" asp-items="@ViewBag.Central" class="form-control form-control-sm">
                                </select>
                                <span asp-validation-for="Central" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <!-- First section -->
                            <div class="col-md-4">
                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-4 text-start">SGST</label>
                                    <div class="col-md-8">
                                        <input type="number" id="sgst" class="form-control form-control-sm" readonly />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-4 text-start">CGST</label>
                                    <div class="col-md-8">
                                        <input type="number" id="cgst" class="form-control form-control-sm" readonly />
                                    </div>
                                </div>
                            </div>

                            <!-- Second section -->
                            <div class="col-md-4">
                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-4 text-start">IGST</label>
                                    <div class="col-md-8">
                                        <input type="number" id="igst" class="form-control form-control-sm" readonly />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-4 text-start">Cess</label>
                                    <div class="col-md-8">
                                        <input type="number" id="cess" class="form-control form-control-sm" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <!-- Right Section -->
            <div class="col-md-6">
                <div class="eb-card">
                    <div class="eb-card-header">Pricing & Stock</div>
                    <div class="eb-card-body">

                        <div class="row mb-2">
                            <label asp-for="Mrp" class="col-md-4 col-form-label text-start ">M.R.P</label>
                            <div class="col-md-6">
                                <input asp-for="Mrp" type="number" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="SalesRate1" class="col-md-4 col-form-label text-start ">Sales Rate 1</label>
                            <div class="col-md-6">
                                <input asp-for="SalesRate1" type="number" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="SalesRate2" class="col-md-4 col-form-label text-start">Sales Rate 2</label>
                            <div class="col-md-6">
                                <input asp-for="SalesRate2" type="number" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="MinimumQty" class="col-md-4 col-form-label text-start">Minimum Qty</label>
                            <div class="col-md-6">
                                <input asp-for="MinimumQty" type="number" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="MaximumQty" class="col-md-4 col-form-label text-start">Maximum Qty</label>
                            <div class="col-md-6">
                                <input asp-for="MaximumQty" type="number" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="eb-card">
                    <div class="eb-card-header">Item Configuration</div>
                    <div class="eb-card-body">
                        <div class="row mb-2">
                            <label class="col-md-4 col-form-label text-start">Shelf Life</label>

                            <div class="col-md-3">
                                <input asp-for="ShelfLife"
                                       type="number"
                                       min="0"
                                       class="form-control form-control-sm"
                                       placeholder="Value" />
                            </div>

                            <div class="col-md-3">
                                <select asp-for="ShelfLifeUnit" class="form-control form-control-sm">
                                    <option value="Days">Days</option>
                                    <option value="Months">Months</option>
                                    <option value="Years">Years</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <label asp-for="MaximumDiscount" class="col-md-4 col-form-label text-start">Maximum Discount</label>
                            <div class="col-md-6">
                                <input asp-for="MaximumDiscount" type="number" class="form-control form-control-sm" />
                                <span asp-validation-for="MaximumDiscount" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <label class="col-md-4 col-form-label text-start">Decemal Allowed</label>
                            <div class="col-md-6">
                                <div class="drug-check">
                                    <input asp-for="DecemalAllowed" type="checkbox" id="DecemalAllowed">
                                    <label id="decimalStatus" for="DecemalAllowed">Inactive</label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <label asp-for="Conversion" class="col-md-4 col-form-label text-start">Conversion</label>
                            <div class="col-md-6">
                                <input asp-for="Conversion" type="number" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="row mb-2">
                            <label class="col-md-4 col-form-label text-start">Item Type</label>
                            <div class="col-md-6">
                                <select asp-for="ItemType" id="ddlItemType" class="form-control form-control-sm">
                                    <option value="Standard">Standard</option>
                                    <option value="Bulk">Bulk</option>
                                    <option value="Repacked">Repacked/Retail Item</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-2" id="divParentItem" style="display:none;">
                            <label class="col-md-4 col-form-label text-start">Parent Bulk Item</label>
                            <div class="col-md-6">
                                <select asp-for="ParentItemId" asp-items="ViewBag.ParentItems" id="ddlParentItem" class="form-control form-control-sm">
                                </select>
                                <span asp-validation-for="ParentItemId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-2" id="divConversionFactor" style="display:none;">
                            <label class="col-md-4 col-form-label text-start">Conversion Factor</label>
                            <div class="col-md-6">
                                <input asp-for="ConversionFactor" type="number" step="0.0001" id="txtConversionFactor" class="form-control form-control-sm" placeholder="e.g. 50" />
                                <span asp-validation-for="ConversionFactor" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <label asp-for="IsActive" class="col-md-4 col-form-label text-start">
                                Item Status
                            </label>
                            <div class="col-md-6">
                                <select asp-for="IsActive" class="form-control form-control-sm">
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                        </div>

                        @if (ViewBag.BusinessType == 2)
                        {
                            <div class="row mb-2">
                                <label class="col-md-4 col-form-label text-start">Drug Category</label>
                                <div class="col-md-8">

                                    <div class="form-check form-switch mb-1">
                                        <input asp-for="Narcotics" class="form-check-input" type="checkbox" id="narcoticsChk">
                                        <label class="form-check-label" for="narcoticsChk">Narcotics</label>
                                    </div>

                                    <div class="form-check form-switch mb-1">
                                        <input asp-for="ScheduleH" class="form-check-input" type="checkbox" id="scheduleHChk">
                                        <label class="form-check-label" for="scheduleHChk">Schedule H</label>
                                    </div>

                                    <div class="form-check form-switch">
                                        <input asp-for="ScheduleH1" class="form-check-input" type="checkbox" id="scheduleH1Chk">
                                        <label class="form-check-label" for="scheduleH1Chk">Schedule H1</label>
                                    </div>

                                </div>
                            </div>
                        }


                        <div class="row mb-2">
                            <label class="col-md-4 col-form-label text-start">Images</label>
                            <div class="col-md-6">
                                <input type="file" asp-for="Images" id="Images" name="Images" multiple hidden />
                                <input type="hidden" id="PrimaryIndex" name="PrimaryIndex" value="0" />

                                <button type="button"
                                        class="btn btn-outline-primary btn-sm"
                                        onclick="openItemImagePopup()">
                                    Upload Images
                                </button>
                                <small class="text-muted d-block mt-1">
                                    You can upload multiple images
                                </small>
                            </div>
                        </div>

                        <div class="row mb-2">
                            <label asp-for="Salt" class="col-md-4 col-form-label text-start small"></label>
                            <div class="col-md-6">
                                <input asp-for="Salt" type="text" class="form-control form-control-sm" />
                                <span asp-validation-for="Salt" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Buttons Section -->
        <div class="mt-3 text-end">
            <button type="submit" class="btn btn-primary px-4">Save</button>
            <a asp-controller="ItemMaster" asp-action="Index" class="btn btn-secondary px-4">Cancel</a>

        </div>
    </div>
    <div id="categoryPopupContainer">
        @await Component.InvokeAsync("CategoryForm")
    </div>
    <div id="subcategorypopupcontainer">
        @await Component.InvokeAsync("SubCategoryComponent")
    </div>
    <div id="companypopupcontainer">
        @await Component.InvokeAsync("Company")
    </div>
    <div id="divisionpopupcontainer">
        @await Component.InvokeAsync("Division")
    </div>
    <div id="hsnpopupcontainer">
        @await Component.InvokeAsync("HSN")
    </div>
</form>


<div id="itemImagePopup" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Upload Item Images</h5>
                <button type="button" class="btn-close" onclick="closeItemImagePopup()"></button>
            </div>

            <div class="modal-body">
                <input type="file"
                       id="itemImages"
                       class="form-control"
                       multiple
                       accept="image/*" />

                <div id="imagePreview"
                     class="d-flex flex-wrap gap-2 mt-3">
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        onclick="closeItemImagePopup()">
                    Close
                </button>

                <button type="button"
                        class="btn btn-primary"
                        onclick="saveSelectedImages()">
                    Done
                </button>
            </div>

        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        let hoveredButton = null; // Store currently hovered button

            if ($("#categoryDropdown").parent(".itemmaster-category-dropdown-wrap").length === 0) {
                $("#categoryDropdown").wrap('<div class="itemmaster-category-dropdown-wrap" style="display:flex;align-items:center;"></div>');
                $("#categoryDropdown").css({ "flex": "1", "width": "auto" }).after('<div style="width:58px;text-align:left;line-height:13px;margin-left:6px;"><a class="btnsecondary" data-master-type="category" data-master-mode="new" style="cursor:pointer;" onclick="openSubCategoryCategoryPopup(event)">F2-New</a><br /><a class="btnsecondary text-danger" data-master-type="category" data-master-mode="edit" style="cursor:pointer;" onclick="openSubCategoryCategoryModifyPopup(event)">F3-Mod</a></div>');
            }
            if ($("#companyDropdown").parent(".itemmaster-company-dropdown-wrap").length === 0) {
                $("#companyDropdown").wrap('<div class="itemmaster-company-dropdown-wrap" style="display:flex;align-items:center;"></div>');
                $("#companyDropdown").css({ "flex": "1", "width": "auto" }).after('<div style="width:58px;text-align:left;line-height:13px;margin-left:6px;"><a class="btnsecondary" data-master-type="company" data-master-mode="new" style="cursor:pointer;" onclick="openDivisionCompanyPopup(event)">F2-New</a><br /><a class="btnsecondary text-danger" data-master-type="company" data-master-mode="edit" style="cursor:pointer;" onclick="openDivisionCompanyModifyPopup(event)">F3-Mod</a></div>');
            }

            // Select all buttons that open popups
         const buttons = document.querySelectorAll(".btnsecondary");

            // Add hover event to each button
            buttons.forEach((button) => {
                button.addEventListener("mouseenter", function () {

                    hoveredButton = button; // Set the hovered button
                });

                button.addEventListener("mouseleave", function () {
                    hoveredButton = null; // Reset when mouse leaves
                });
            });
                // ItemMaster F2/F3 shortcut: hovered shortcut links open New/Modify popup with same existing UI.
            document.addEventListener("keydown", function (event) {

                if ((event.keyCode === 113 || event.keyCode === 114) && hoveredButton) {
                    event.preventDefault();
                    if (typeof itemMasterOpenShortcut === "function" && hoveredButton.dataset.masterType) {
                        itemMasterOpenShortcut(hoveredButton.dataset.masterType, event.keyCode === 114 ? "edit" : "new", event);
                    } else {
                        openPopupForButton(hoveredButton);
                    }
                }
            });
           function openPopupForButton(button) {

                if (button.id === "categorybutton") {
                    openPopup();
                } else if (button.id === "subcategorybutton") {
                    openSubCategoryPopup();
                } else if(button.id ==="companybutton"){
                    opencompanyPopup();
                } else if (button.getAttribute("onclick").includes("opendivisionpopup")) {
                    opendivisionpopup();
                } else if (button.getAttribute("onclick").includes("openhsnpopup")) {
                    openhsnpopup();
                }
            }

           function openPopup(event) {
                event?.preventDefault(); // ✅ Prevent unintended form submission
                // ItemMaster F2/F3 shortcut: reset popup to F2-New save mode.
                if (typeof itemMasterSetPopupMode === "function") itemMasterSetPopupMode("category", "new", 0);
