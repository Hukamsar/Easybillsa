@using AOne.Models.Entity
@model IEnumerable<ItemMaster>

<style>
    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>
<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2" style="background:#2b6ac9">
        Item Master
    </div>
</div>
<table id="itemTable" class=" table table-bordered table-striped">
    <thead class="table-primary">
        <tr>
            <th>Item Code</th>
            <th>Item Name</th>
            <th>Bar Code</th>
            <th>Category Name</th>
            <th>Hsn</th>
            <th>Gst</th>
            <th>Unit</th>
            <th>Packing</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td>@item.Barcode</td>
                <td>@item.Category?.CategoryName</td>
                <td>@item.Hsn?.HsnCode</td>
                <td>@item.Hsn?.IGST</td>
                <td>@item.Unit1</td>
                <td>@item.Packing</td>
                <td>
                    <div class="btn-group" role="group" style="float:right">

                        <button class="btn btn-success" onclick="restoreItem(@item.Id)">  Restore  </button>
                    </div>
                </td>
            </tr>
        }

    </tbody>
</table>

<script>
    function restoreItem(id)
    {
        if (!confirm('Restore this item?'))
            return;

        $.ajax({
            url: '/ItemMaster/Restore',
            type: 'POST',
            data: { id: id },
            success: function (res) {
                if (res.success) {
                    location.reload();
                }
            }
        });
    }
</script>