@using EasyBill.Models.ViewModels
@model TenantRegistrationVM
@{
    ViewData["Title"] = "Company Profile";
}
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    .profile-page-wrapper {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        background-color: #f8fafc;
        border-radius: 16px;
    }

    .profile-page-wrapper * {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
    }

    table.dataTable thead th {
        background-color: #1565c0 !important;
        color: white !important;
    }

    .shortcut-badge {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 5px 10px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: 1px solid transparent;
        margin-right: 4px;
    }

    .shortcut-new {
        background: #eff6ff;
        color: #1e6091;
        border-color: #bfdbfe;
    }

    .shortcut-new:hover {
        background: #1e6091;
        color: #ffffff;
    }

    .shortcut-mod {
        background: #fff5f5;
        color: #c53030;
        border-color: #fee2e2;
    }

    .shortcut-mod:hover {
        background: #c53030;
        color: #ffffff;
    }

    .shortcut-box {
        margin-top: 5px;
        display: flex;
        gap: 6px;
    }

    .custom-modal {
        max-width: 400px;
    }

    .modal-input {
        max-width: 100%;
    }

    .modal-error {
        display: block;
    }

    /* Legend and fieldset aesthetics */
    .profile-edit-fieldset {
        border: 1px solid #e2e8f0 !important;
        padding: 1.5rem !important;
        margin-bottom: 1.5rem !important;
        background-color: #fff;
        border-radius: 12px !important;
        box-shadow: 0 4px 10px rgba(0,0,0,0.01);
    }

    .profile-edit-legend {
        font-size: 0.82rem !important;
        font-weight: 700 !important;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #1565c0 !important;
        background-color: #fff;
        padding: 0 0.75rem !important;
        width: auto !important;
        float: none;
        margin-bottom: 0;
    }

    /* View / Edit Mode Toggle Styles */
    .mode-view .edit-only {
        display: none !important;
    }
    .mode-edit .view-only {
        display: none !important;
    }

    /* Premium View Mode Dashboard Styles */
    .detail-card {
        border-radius: 16px !important;
        border: none !important;
        background: #fff;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        padding: 1.75rem !important;
        margin-bottom: 20px;
    }

    .profile-section-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1e293b;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 0.75rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .profile-section-title i {
        color: #1565c0;
    }

    /* Profile Detail Item Layout */
    .profile-detail-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 1.25rem;
    }

    .profile-icon-box {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: #1565c0;
        font-size: 0.95rem;
        flex-shrink: 0;
        border: 1px solid #dbeafe;
    }

    /* Color variations for icon boxes */
    .icon-success { background: #f0fdf4; color: #16a34a; border-color: #dcfce7; }
    .icon-warning { background: #fffbeb; color: #d97706; border-color: #fef3c7; }
    .icon-danger { background: #fef2f2; color: #dc2626; border-color: #fee2e2; }
    .icon-purple { background: #faf5ff; color: #7c3aed; border-color: #f3e8ff; }
    .icon-info { background: #ecfeff; color: #0891b2; border-color: #cffafe; }

    .profile-detail-content {
        flex-grow: 1;
    }

    .profile-detail-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #64748b;
        font-weight: 700;
        margin-bottom: 2px;
        display: block;
    }

    .profile-detail-value {
        font-size: 0.88rem;
        color: #1e293b;
        font-weight: 600;
        display: block;
    }

    .monogram-logo {
        background: linear-gradient(135deg, #1565c0 0%, #1e88e5 100%);
        box-shadow: 0 4px 15px rgba(21, 101, 192, 0.25);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        text-transform: uppercase;
        border-radius: 50%;
        border: 4px solid #ffffff;
    }

    /* Form Styles for Edit Mode */
    .profile-form-control {
        border-radius: 8px !important;
        border: 1.5px solid #e2e8f0 !important;
        font-size: 0.85rem !important;
        transition: all 0.2s ease !important;
        padding: 0.4rem 0.75rem;
    }

    .profile-form-control:focus {
        border-color: #1565c0 !important;
        box-shadow: 0 0 0 3px rgba(21, 101, 192, 0.1) !important;
        outline: none;
    }

    .profile-form-control[readonly] {
        background-color: #f8fafc !important;
        border-color: #e2e8f0 !important;
        color: #64748b !important;
    }

    /* Premium card header and main container */
    .profile-card-header {
        background: linear-gradient(120deg, #1565c0 0%, #1976d2 35%, #0d47a1 65%, #1a237e 100%) !important;
        color: white !important;
        font-weight: 700;
        border: none !important;
        border-radius: 16px 16px 0 0 !important;
        padding: 16px 24px !important;
        box-shadow: 0 4px 15px rgba(21, 101, 192, 0.2);
        letter-spacing: 0.5px;
    }

    /* Buttons */
    .btn-profile-primary {
        background: linear-gradient(135deg, #1565c0 0%, #1e88e5 100%) !important;
        border: none !important;
        border-radius: 8px !important;
        font-weight: 600 !important;
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(21, 101, 192, 0.2) !important;
        transition: all 0.2s ease !important;
    }

    .btn-profile-primary:hover {
        transform: translateY(-1.5px) !important;
        box-shadow: 0 6px 16px rgba(21, 101, 192, 0.3) !important;
        color: white !important;
    }

    .btn-profile-secondary {
        background: #f1f5f9 !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 8px !important;
        font-weight: 600 !important;
        color: #475569 !important;
        transition: all 0.2s ease !important;
    }

    .btn-profile-secondary:hover {
        background: #e2e8f0 !important;
        color: #1e293b !important;
    }

    .btn-profile-success {
        background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%) !important;
        border: none !important;
        border-radius: 8px !important;
        font-weight: 600 !important;
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(22, 163, 74, 0.2) !important;
        transition: all 0.2s ease !important;
    }

    .btn-profile-success:hover {
        transform: translateY(-1.5px) !important;
        box-shadow: 0 6px 16px rgba(22, 163, 74, 0.3) !important;
        color: white !important;
    }

    /* Tab navigation custom styling */
    .profile-tabs .nav-link {
        color: #64748b;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 10px 20px;
        border: none;
        border-bottom: 2px solid transparent;
        transition: all 0.2s ease;
        background: transparent;
    }

    .profile-tabs .nav-link:hover {
        color: #1565c0;
        border-bottom-color: #e2e8f0;
    }

    .profile-tabs .nav-link.active {
        color: #1565c0 !important;
        border-bottom: 2px solid #1565c0 !important;
        background: transparent !important;
    }

    .profile-tab-content {
        background: #ffffff;
        border-radius: 0 0 12px 12px;
        border: 1px solid #e2e8f0;
        border-top: none;
        padding: 20px;
    }

    .premium-badge {
        font-size: 0.72rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.3px;
        padding: 6px 14px !important;
        border-radius: 30px !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    /* Small stat card helper */
    .stat-mini-card {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 12px;
        padding: 12px;
        margin-top: 10px;
        text-align: left;
    }
</style>


<div class="profile-page-wrapper">
    <div class="card border-0 mb-3 shadow-sm">
        <div class="card-header profile-card-header py-3">
            <i class="fas fa-building me-2"></i> Company Profile
        </div>
    </div>
    <form asp-action="EditProfile" id="CompanyForm" asp-controller="Tenant" enctype="multipart/form-data" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="container-fluid px-0" id="profileContainer">
            
            <!-- ==========================================
                 VIEW-ONLY PROFILE DASHBOARD (VIEW MODE)
                 ========================================== -->
            <div class="view-only">
                <div class="row">
                    <!-- Sidebar Profile Summary -->
                    <div class="col-md-4 mb-4">
                        <div class="card border-0 text-center detail-card">
                            <div class="d-flex justify-content-center mb-3">
                                @if (!string.IsNullOrEmpty(Model.Logo))
                                {
                                    <img src="~/@Model.Logo" alt="Logo" class="img-thumbnail rounded-circle shadow-sm" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid #f1f5f9;" />
                                }
                                else
                                {
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white monogram-logo" style="width: 120px; height: 120px; font-size: 2.5rem; font-weight: 700;">
                                        @(string.IsNullOrEmpty(Model.Name) ? "C" : Model.Name.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </div>
                            <h4 class="fw-bold mb-1 text-dark">@Model.Name</h4>
                            <p class="text-muted small mb-3">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
                            
                            <div class="d-flex justify-content-center gap-2 flex-wrap mb-2">
                                <span class="badge bg-primary text-white premium-badge px-3 py-2" style="background: linear-gradient(135deg, #1565c0 0%, #1e88e5 100%) !important;">
                                    <i class="fas fa-certificate me-1"></i> @ViewBag.SubscriptionPlanName
                                </span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle premium-badge px-3 py-2">
                                    Active
                                </span>
                            </div>
                            
                            <hr class="my-4 text-muted opacity-25" />
                            
                            <div class="stat-mini-card">
                                <div class="row g-0 align-items-center">
                                    <div class="col-2 text-center text-primary">
                                        <i class="fas fa-code-branch fa-lg"></i>
                                    </div>
                                    <div class="col-10 ps-2">
                                        <span class="profile-detail-label">Branch Code</span>
                                        <span class="fw-bold text-dark" style="font-size: 0.85rem;">@(string.IsNullOrEmpty(Model.BranchCode) ? "N/A" : Model.BranchCode)</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="stat-mini-card">
                                <div class="row g-0 align-items-center">
                                    <div class="col-2 text-center text-primary">
                                        <i class="fas fa-calendar-alt fa-lg"></i>
                                    </div>
                                    <div class="col-10 ps-2">
                                        <span class="profile-detail-label">Financial Year</span>
                                        <span class="fw-bold text-dark" style="font-size: 0.85rem;">@(Model.YearFrom.HasValue ? Model.YearFrom.Value.ToString("yyyy") : "N/A") - @(Model.YearTo.HasValue ? Model.YearTo.Value.ToString("yy") : "N/A")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Main Details Card -->
                    <div class="col-md-8">
                        <div class="card border-0 detail-card">
                            <h5 class="profile-section-title">
                                <i class="fas fa-map-marker-alt"></i> Basic & Location Details
                            </h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box">
                                            <i class="fas fa-map-marked-alt"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">Address Line 1</span>
                                            <span class="profile-detail-value">@(string.IsNullOrEmpty(Model.Address1) ? "-" : Model.Address1)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box text-secondary">
                                            <i class="fas fa-map-marked-alt"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">Address Line 2</span>
                                            <span class="profile-detail-value">@(string.IsNullOrEmpty(Model.Address2) ? "-" : Model.Address2)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box icon-info">
                                            <i class="fas fa-location-arrow"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">Location / Area</span>
                                            <span class="profile-detail-value">@(string.IsNullOrEmpty(Model.Location) ? "-" : Model.Location)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box icon-purple">
                                            <i class="fas fa-globe"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">Country / State / City</span>
                                            <span class="profile-detail-value">@ViewBag.CountryName / @ViewBag.StateName / @ViewBag.CityName</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box icon-success">
                                            <i class="fas fa-mail-bulk"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">Pin Code</span>
                                            <span class="profile-detail-value">@(string.IsNullOrEmpty(Model.PinCode) ? "-" : Model.PinCode)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 detail-card">
                            <h5 class="profile-section-title">
                                <i class="fas fa-address-book"></i> Contact Details
                            </h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box">
                                            <i class="fas fa-user-tie"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">Contact Person</span>
                                            <span class="profile-detail-value">@(string.IsNullOrEmpty(Model.ContactPerson) ? "-" : Model.ContactPerson)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box icon-danger">
                                            <i class="fas fa-envelope"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">Email Address</span>
                                            <span class="profile-detail-value">@Model.Email</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box icon-warning">
                                            <i class="fas fa-phone-alt"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">Phone No</span>
                                            <span class="profile-detail-value">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box icon-success">
                                            <i class="fas fa-mobile-alt"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">Mobile No</span>
                                            <span class="profile-detail-value">@(string.IsNullOrEmpty(Model.MobileNo) ? "-" : Model.MobileNo)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 detail-card">
                            <h5 class="profile-section-title">
                                <i class="fas fa-file-invoice-dollar"></i> Registration & Licensing
                            </h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box icon-purple">
                                            <i class="fas fa-percent"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">GST Number</span>
                                            <span class="profile-detail-value">@(string.IsNullOrEmpty(Model.GstNo) ? "-" : Model.GstNo) (State Code: @(Model.StateCode.HasValue ? ((int)Model.StateCode.Value).ToString("D2") : "-"))</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box icon-info">
                                            <i class="fas fa-store"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">Business & Company Type</span>
                                            <span class="profile-detail-value">Type: @(Model.CompanyType.HasValue ? Model.CompanyType.ToString() : "-") | Business: @(Model.BusinessType.HasValue ? Model.BusinessType.ToString() : "-")</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box icon-warning">
                                            <i class="fas fa-calculator"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">Tax & Calendar Type</span>
                                            <span class="profile-detail-value">Tax: @(Model.TaxType.HasValue ? Model.TaxType.ToString() : "-") | Calendar: @(Model.CalenderType.HasValue ? Model.CalenderType.ToString() : "-")</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box icon-success">
                                            <i class="fas fa-clipboard-check"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">FSSAI & Drug License</span>
                                            <span class="profile-detail-value">FSSAI: @(string.IsNullOrEmpty(Model.IFSSAINo) ? "-" : Model.IFSSAINo) | Drug Lic: @(string.IsNullOrEmpty(Model.DrugLicNo) ? "-" : Model.DrugLicNo)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box icon-danger">
                                            <i class="fas fa-calendar-times"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">License Expiry Date</span>
                                            <span class="profile-detail-value">@(Model.LicenceExpiryDate.HasValue ? Model.LicenceExpiryDate.Value.ToString("dd-MM-yyyy") : "-")</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="profile-detail-item">
                                        <div class="profile-icon-box">
                                            <i class="fas fa-gavel"></i>
                                        </div>
                                        <div class="profile-detail-content">
                                            <span class="profile-detail-label">Jurisdiction</span>
                                            <span class="profile-detail-value">@(string.IsNullOrEmpty(Model.Jurisdiction) ? "-" : Model.Jurisdiction)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==========================================
                 EDITABLE PROFILE FORM (EDIT MODE ONLY)
                 ========================================== -->
            <div class="edit-only">
                <div class="row">
                    <div class="col-md-8">
                        <fieldset class="profile-edit-fieldset">
                            <legend class="profile-edit-legend">Basic Info</legend>
                            <div class="row mb-3">
                                <label asp-for="Name" class="col-md-3 col-form-label text-start small fw-bold text-secondary">Company Name</label>
                                <div class="col-md-9">
                                    <input asp-for="Name" id="Name" type="text" class="form-control form-control-sm profile-form-control bg-light text-muted font-weight-bold" readonly />
                                    <span class="text-muted small d-block mt-1">
                                        <i class="fas fa-info-circle text-primary"></i> To change the company name, please submit a request to the Super Admin.
                                    </span>
                                </div>
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="row mb-3">
                                <label asp-for="Address1" class="col-md-3 col-form-label text-start small fw-bold text-secondary">Address Line 1 <i class="text-danger">*</i></label>
                                <div class="col-md-9">
                                    <input asp-for="Address1" id="Address1" type="text" class="form-control form-control-sm profile-form-control" required />
                                </div>
                                <span asp-validation-for="Address1" class="text-danger"></span>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="row">
                                        <label asp-for="Address2" class="col-md-4 col-form-label text-start small fw-bold text-secondary">Address Line 2</label>
                                        <div class="col-md-8">
                                            <input asp-for="Address2" id="Address2" type="text" class="form-control form-control-sm profile-form-control" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row">
                                        <label asp-for="Location" class="col-md-4 col-form-label text-start small fw-bold text-secondary">Location / Area</label>
                                        <div class="col-md-8">
                                            <input asp-for="Location" id="Location" type="text" class="form-control form-control-sm profile-form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- COUNTRY / STATE / CITY -->
                            <div class="row mb-3">

                                <!-- COUNTRY -->
                                <div class="col-md-6">
                                    <div class="row">
                                        <label asp-for="CountryId" class="col-md-4 col-form-label text-start small fw-bold text-secondary">
                                            Country
                                        </label>

                                        <div class="col-md-8">
                                            <select asp-for="CountryId"
                                                    id="countryId"
