@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        const gstStateEnumMap = {
            1: "JammuAndKashmir",
            2: "HimachalPradesh",
            3: "Punjab",
            4: "Chandigarh",
            5: "Uttarakhand",
            6: "Haryana",
            7: "Delhi",
            8: "Rajasthan",
            9: "UttarPradesh",
            10: "Bihar",
            11: "Sikkim",
            12: "ArunachalPradesh",
            13: "Nagaland",
            14: "Manipur",
            15: "Mizoram",
            16: "Tripura",
            17: "Meghalaya",
            18: "Assam",
            19: "WestBengal",
            20: "Jharkhand",
            21: "Odisha",
            22: "Chhattisgarh",
            23: "MadhyaPradesh",
            24: "Gujarat",
            26: "DadraNagarHaveliAndDamanDiu",
            27: "Maharashtra",
            28: "AndhraPradeshOld",
            29: "Karnataka",
            30: "Goa",
            31: "Lakshadweep",
            32: "Kerala",
            33: "TamilNadu",
            34: "Puducherry",
            35: "AndamanNicobar",
            36: "Telangana",
            37: "AndhraPradesh",
            38: "Ladakh"
        };

        $(document).ready(function () {

            /* =====================================================
               VIEW/EDIT MODE TOGGLE
            ======================================================*/
            function setViewMode() {
                $("#profileContainer").addClass("mode-view").removeClass("mode-edit");
                // Reset card header text
                $(".card-header").html('<i class="fas fa-building me-1.5"></i> Company Profile');
            }

            function setEditMode() {
                $("#profileContainer").removeClass("mode-view").addClass("mode-edit");
                // Reset card header text to edit mode
                $(".card-header").html('<i class="fas fa-edit me-1.5"></i> Edit Company Profile');
            }

            // Initialize View Mode on Load
            setViewMode();

            $("#btnEditProfile").on("click", function (e) {
                e.preventDefault();
                setEditMode();
            });

            $("#btnCancelEdit").on("click", function (e) {
                e.preventDefault();
                window.location.reload(); // Reload to discard changes and go back to View Mode
            });


            /* =====================================================
               GST STATE CODE
            ======================================================*/

            function initializeStateCode() {

                const stateCodeValue = $("#StateCodeHidden").val();

                if (stateCodeValue && stateCodeValue !== "") {

                    const code = parseInt(stateCodeValue, 10);

                    if (gstStateEnumMap[code]) {

                        const displayValue =
                            code.toString().padStart(2, '0') +
                            " - " +
                            gstStateEnumMap[code];

                        $("#StateCodeDisplay").val(displayValue);
                    }
                }
            }

            initializeStateCode();

            $("#GSTNo").on("input paste", function () {

                setTimeout(() => {

                    const gst = $(this).val().toUpperCase();

                    const $stateDisplay = $("#StateCodeDisplay");
                    const $stateHidden = $("#StateCodeHidden");

                    if (gst.length >= 2) {

                        const code = parseInt(gst.substring(0, 2), 10);

                        if (gstStateEnumMap[code]) {

                            const displayValue =
                                gst.substring(0, 2).padStart(2, '0') +
                                " - " +
                                gstStateEnumMap[code];

                            $stateDisplay.val(displayValue);
                            $stateHidden.val(code);

                        } else {

                            $stateDisplay.val("");
                            $stateHidden.val("");
                        }

                    } else {

                        $stateDisplay.val("");
                        $stateHidden.val("");
                    }

                }, 0);
            });


            /* =====================================================
               FORM SUBMIT DUPLICATE CHECK
            ======================================================*/

            let isSubmitting = false;

            $("#CompanyForm").on("submit", function (e) {

                if (isSubmitting)
                    return false;

                e.preventDefault();

                var form = this;

                var name = $("#Name").val()?.trim();
                var gstNo = $("#GSTNo").val()?.trim();
                var mobileNo = $("#MobileNo").val()?.trim();
                var id = $("#Id").val();

                if (!name) {

                    Swal.fire(
                        "Error",
                        "Please enter Company Name!",
                        "error"
                    );

                    return;
                }

                $.ajax({

                    url: "/Tenant/CheckDuplicate",
                    type: "GET",

                    data: {
                        Name: name,
                        GSTNo: gstNo,
                        MobileNo: mobileNo,
                        id: id
                    },

                    success: function (response) {

                        if (response.exists) {

                            Swal.fire(
                                "Duplicate record already exists!"
                            );

                        } else {

                            isSubmitting = true;
                            form.submit();
                        }
                    },

                    error: function () {

                        Swal.fire(
                            "Error checking duplicate"
                        );
                    }
                });
            });


            /* =====================================================
               COUNTRY
            ======================================================*/

            let countryDdlSelector = "#countryId";
            let returnModalSelector = "";

            $("#countryModal,#stateModal").on("hidden.bs.modal", function () {
                if (returnModalSelector && returnModalSelector !== "#" + this.id) {
                    let modalSelector = returnModalSelector;
                    returnModalSelector = "";
                    setTimeout(function () {
                        $(modalSelector).modal("show");
                    }, 200);
                }
            });

            $("#btnF2Country").click(function () {
                countryDdlSelector = "#countryId";
                openModal("country", "new", "#countryId");
            });

            $("#btnF3Country").click(function () {
                countryDdlSelector = "#countryId";
                openModal("country", "edit", "#countryId");
            });

            $("#btnSaveCountry").click(function () {

                saveData(
                    "country",
                    "/Tenant/QuickSaveCountry",
                    countryDdlSelector,
                    null,
                    "/Tenant/GetCountries"
                );
            });

            $("#btnF2StateCountry").click(function () {
                countryDdlSelector = "#modalStateCountryId";
                $("#stateModal").modal("hide");
                setTimeout(function () {
                    returnModalSelector = "#stateModal";
                    openModal("country", "new", "#modalStateCountryId");
                }, 350);
            });

            $("#btnF3StateCountry").click(function () {
                if (!$("#modalStateCountryId").val()) {
                    Swal.fire("Error", "Select Country First!", "error");
                    return;
                }

                countryDdlSelector = "#modalStateCountryId";
                $("#stateModal").modal("hide");
                setTimeout(function () {
                    returnModalSelector = "#stateModal";
                    openModal("country", "edit", "#modalStateCountryId");
                }, 350);
            });

            $("#btnF2CityCountry").click(function () {
                countryDdlSelector = "#modalCityCountryId";
                $("#cityModal").modal("hide");
                setTimeout(function () {
                    returnModalSelector = "#cityModal";
                    openModal("country", "new", "#modalCityCountryId");
                }, 350);
            });

            $("#btnF3CityCountry").click(function () {
                if (!$("#modalCityCountryId").val()) {
                    Swal.fire("Error", "Select Country First!", "error");
                    return;
                }

                countryDdlSelector = "#modalCityCountryId";
                $("#cityModal").modal("hide");
                setTimeout(function () {
                    returnModalSelector = "#cityModal";
                    openModal("country", "edit", "#modalCityCountryId");
                }, 350);
            });


            /* =====================================================
               STATE
            ======================================================*/

            $("#btnF2State").click(function () {

                openModal("state", "new", "#stateId");
            });

            $("#btnF3State").click(function () {

                if (!$("#stateId").val()) {

                    Swal.fire(
                        "Error",
                        "Select State First!",
                        "error"
                    );

                    return;
                }

                openModal("state", "edit", "#stateId");
            });

            $("#btnSaveState").click(function () {

                let id = $("#modalStateId").val();
                let name = $("#modalStateName").val().trim();
                let countryId = $("#modalStateCountryId").val();

                if (!countryId) {
                    $("#stateError").text("Select Country First!");
                    return;
                }

                if (!name) {
                    $("#stateError").text("Name required!");
                    return;
                }

                $.ajax({
                    url: "/Tenant/QuickSaveState",
                    type: "POST",
                    data: { id: id, name: name, countryId: countryId },
                    success: function (res) {
                        if (res.success) {
                            $("#stateModal").modal("hide");
                            $("#countryId").val(countryId);
                            $.get("/Tenant/GetStatesByCountry?countryId=" + countryId, function (data) {
                                let ddl = $("#stateId");
                                let modalDdl = $("#modalCityStateId");
                                ddl.empty().append('<option value="">select</option>');
                                modalDdl.empty().append('<option value="">select</option>');
                                $.each(data, function (i, item) {
                                    let opt = $("<option>", { value: item.id, text: item.name });
                                    let modalOpt = $("<option>", { value: item.id, text: item.name });
                                    if (item.id == res.newId) {
                                        opt.attr("selected", "selected");
                                        modalOpt.attr("selected", "selected");
                                    }
                                    ddl.append(opt);
                                    modalDdl.append(modalOpt);
                                });
                                $("#cityId").empty().append('<option value="">select</option>');
                            });
                            Swal.fire("Success", res.message || "Saved Successfully!", "success");
                        } else {
                            $("#stateError").text(res.message);
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Something went wrong!", "error");
                    }
                });
            });


            /* =====================================================
               CITY
            ======================================================*/

            $("#btnF2City").click(function () {

                openModal("city", "new", "#cityId");
            });

            $("#btnF3City").click(function () {

                if (!$("#cityId").val()) {

                    Swal.fire(
                        "Error",
                        "Select City First!",
                        "error"
                    );

                    return;
                }

                openModal("city", "edit", "#cityId");
            });

            $("#btnSaveCity").click(function () {

                let id = $("#modalCityId").val();
                let name = $("#modalCityName").val().trim();
                let countryId = $("#modalCityCountryId").val();
                let stateId = $("#modalCityStateId").val();

                if (!countryId) {
                    $("#cityError").text("Select Country First!");
                    return;
                }

                if (!stateId) {
                    $("#cityError").text("Select State First!");
                    return;
                }

                if (!name) {
                    $("#cityError").text("Name required!");
                    return;
                }

                $.ajax({
                    url: "/Tenant/QuickSaveCity",
                    type: "POST",
                    data: { id: id, name: name, stateId: stateId, countryId: countryId },
                    success: function (res) {
                        if (res.success) {
                            $("#cityModal").modal("hide");
                            $("#countryId").val(countryId);
                            $.get("/Tenant/GetStatesByCountry?countryId=" + countryId, function (states) {
                                let ddl = $("#stateId");
                                ddl.empty().append('<option value="">select</option>');
                                $.each(states, function (i, item) {
                                    let opt = $("<option>", { value: item.id, text: item.name });
                                    if (item.id == stateId) opt.attr("selected", "selected");
                                    ddl.append(opt);
                                });
                            });
                            $.get("/Tenant/GetCitiesByState?stateId=" + stateId, function (data) {
                                let ddl = $("#cityId");
                                ddl.empty().append('<option value="">select</option>');
                                $.each(data, function (i, item) {
                                    let opt = $("<option>", { value: item.id, text: item.name });
                                    if (item.id == res.newId) opt.attr("selected", "selected");
                                    ddl.append(opt);
                                });
                            });
                            Swal.fire("Success", res.message || "Saved Successfully!", "success");
                        } else {
                            $("#cityError").text(res.message);
                        }
                    },
                    error: function () {
                        Swal.fire("Error", "Something went wrong!", "error");
                    }
                });
            });

            $("#btnF2CityState").click(function () {
                $("#cityModal").modal("hide");
                setTimeout(function () {
                    returnModalSelector = "#cityModal";
                    openModal("state", "new", "#modalCityStateId");
                    $("#modalStateCountryId").val($("#modalCityCountryId").val());
                }, 350);
            });

            $("#btnF3CityState").click(function () {
                if (!$("#modalCityStateId").val()) {
                    Swal.fire("Error", "Select State First!", "error");
                    return;
                }

                $("#cityModal").modal("hide");
                setTimeout(function () {
                    returnModalSelector = "#cityModal";
                    openModal("state", "edit", "#modalCityStateId");
                    $("#modalStateCountryId").val($("#modalCityCountryId").val());
                }, 350);
            });

            $("#modalCityCountryId").change(function () {
                let countryId = $(this).val();
                $("#modalCityStateId").empty().append('<option value="">select</option>');
                if (countryId) {
                    $.getJSON("/Tenant/GetStatesByCountry", { countryId: countryId }, function (data) {
                        $.each(data, function (i, item) {
                            $("#modalCityStateId").append($("<option>", { value: item.id, text: item.name }));
                        });
                    });
                }
            });


            /* =====================================================
               OPEN MODAL
            ======================================================*/

            function openModal(type, mode, ddlSelector) {

                $("#" + type + "Error").text("");

                let modalId =
                    "#modal" + capitalize(type) + "Id";

                let modalName =
                    "#modal" + capitalize(type) + "Name";

                if (mode === "new") {

                    $(modalId).val(0);
                    $(modalName).val("");

                    $("#" + type + "ModalTitle")
                        .text("Add " + capitalize(type));

                } else {

                    let id = $(ddlSelector).val();

                    let text =
                        $(ddlSelector + " option:selected").text();

                    if (!id) {

                        Swal.fire(
                            "Error",
                            "Please select item first!",
                            "error"
                        );

                        return;
                    }

                    $(modalId).val(id);
                    $(modalName).val(text);

                    $("#" + type + "ModalTitle")
                        .text("Modify " + capitalize(type));
                }

                if (type === "state") {
                    $("#modalStateCountryId").val($("#countryId").val());
                }

                if (type === "city") {
                    let countryId = $("#countryId").val();
                    let stateId = $("#stateId").val();
                    $("#modalCityCountryId").val(countryId);
                    $("#modalCityStateId").empty().append('<option value="">select</option>');
                    if (countryId) {
                        $.getJSON("/Tenant/GetStatesByCountry", { countryId: countryId }, function (data) {
                            $.each(data, function (i, item) {
                                let opt = $("<option>", { value: item.id, text: item.name });
                                if (item.id == stateId) opt.attr("selected", "selected");
                                $("#modalCityStateId").append(opt);
                            });
                        });
                    }
                }

                $("#" + type + "Modal").modal("show");

                setTimeout(function () {
                    $(modalName).focus();
                }, 300);
            }


            /* =====================================================
               SAVE DATA
            ======================================================*/

            function saveData(
                type,
                url,
                ddlSelector,
                extraData,
                reloadUrl,
                isCustomFormat = false
            ) {

                let id =
                    $("#modal" + capitalize(type) + "Id").val();

                let name =
                    $("#modal" + capitalize(type) + "Name")
                        .val()
                        .trim();

                if (!name) {

                    $("#" + type + "Error")
                        .text("Name required!");

                    return;
                }

                let postData = {
                    id: id,
                    name: name
                };

                if (extraData) {
                    Object.assign(postData, extraData);
                }

                $.ajax({

                    url: url,
                    type: "POST",
                    data: postData,

                    success: function (res) {

                        if (res.success) {

                            $("#" + type + "Modal").modal("hide");

                            reloadDropdown(
                                ddlSelector,
                                reloadUrl,
                                res.newId,
                                isCustomFormat
                            );

                            Swal.fire(
                                "Success",
                                res.message || "Saved Successfully!",
                                "success"
                            );

                        } else {

                            $("#" + type + "Error")
                                .text(res.message);
                        }
                    },

                    error: function () {

                        Swal.fire(
                            "Error",
                            "Something went wrong!",
                            "error"
                        );
                    }
                });
            }


            /* =====================================================
               RELOAD DROPDOWN
            ======================================================*/

            function reloadDropdown(
                ddlSelector,
                reloadUrl,
                selectedValue,
                isCustomFormat
            ) {

                $.get(reloadUrl, function (data) {

                    let ddl = $(ddlSelector);

                    ddl.empty();

                    ddl.append(
                        '<option value="">select</option>'
                    );

                    $.each(data, function (i, item) {

                        ddl.append(
                            $("<option>", {
                                value: isCustomFormat
                                    ? item.id
                                    : item.value,

                                text: isCustomFormat
                                    ? item.name
                                    : item.text
                            })
                        );
                    });

                    ddl.val(selectedValue);

                    if (ddlSelector === "#countryId" || ddlSelector === "#modalStateCountryId" || ddlSelector === "#modalCityCountryId") {
                        $("#countryId,#modalStateCountryId,#modalCityCountryId").empty().append('<option value="">select</option>');
                        $.each(data, function (i, item) {
                            let opt1 = $("<option>", { value: item.value, text: item.text });
                            let opt2 = $("<option>", { value: item.value, text: item.text });
                            let opt3 = $("<option>", { value: item.value, text: item.text });
                            if (item.value == selectedValue) {
                                opt1.attr("selected", "selected");
                                opt2.attr("selected", "selected");
                                opt3.attr("selected", "selected");
                            }
                            $("#countryId").append(opt1);
                            $("#modalStateCountryId").append(opt2);
                            $("#modalCityCountryId").append(opt3);
                        });
                        $("#stateId").empty().append('<option value="">select</option>');
                        $("#cityId").empty().append('<option value="">select</option>');
                        $("#modalCityStateId").empty().append('<option value="">select</option>');
                    }
                });
            }


            /* =====================================================
               ENTER KEY SAVE
            ======================================================*/

            $(".modal-input").keypress(function (e) {

                if (e.which == 13) {

                    e.preventDefault();

                    $(this)
                        .closest(".modal")
                        .find(".btn-success")
                        .click();
                }
            });


            /* =====================================================
               CAPITALIZE
            ======================================================*/

            function capitalize(text) {
                return text.charAt(0).toUpperCase() + text.slice(1);
            }

        });

    </script>
}

@if (!ViewData.ModelState.IsValid)
{
    <script>
        $(document).ready(function () {
            // Auto trigger Edit Mode if validation fails on postback
            $("#profileContainer").removeClass("mode-view").addClass("mode-edit");
            $(".card-header").html('<i class="fas fa-edit me-1.5"></i> Edit Company Profile');
        });
    </script>
}
