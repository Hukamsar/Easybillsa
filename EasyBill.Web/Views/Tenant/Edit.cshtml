@using EasyBill.Models.ViewModels
@using AOne.Utility.Enums
@model TenantRegistrationVM
@{
    ViewData["Title"] = "Create Company";
}
<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    .shortcut-link {
        cursor: pointer;
        font-size: 9px;
        text-decoration: underline;
        color: #0066cc;
        line-height: 11px;
        white-space: nowrap;
        margin: 0;
        padding: 0;
    }

        .shortcut-link:hover {
            color: #004499;
        }

    .shortcut-box {
        margin-top: 3px;
    }

    .custom-modal {
        max-width: 400px;
    }

    .modal-input {
        max-width: 100%;
    }

    .modal-error {
        display: block;
    }

    fieldset {
        border-radius: 5px;
    }

    legend {
        font-size: 14px;
        font-weight: 600;
        color: #2b6ac9;
        float: none;
        width: auto;
        padding: 0 10px;
    }
</style>


<div class="card mb-3">
    <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
        Edit Company Registration
    </div>
</div>
<form asp-action="Edit" id="CompanyForm" asp-controller="Tenant" enctype="multipart/form-data" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="container">
        <div class="row">
            <div class="col-md-8">
                <fieldset style="border:1px solid gray;" class="p-2">
                    <legend>Basic Info</legend>
                    <div class="row mb-2">
                        <label asp-for="Name" class="col-md-2 col-form-label text-start small">Company Name<i class="text-danger">*</i> </label>
                        <div class="col-md-10">
                            <input asp-for="Name" type="text" class="form-control form-control-sm" required />
                        </div>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="row mb-2">
                        <label asp-for="Address1" class="col-md-2 col-form-label text-start small">Address1 <i class="text-danger">*</i></label>
                        <div class="col-md-10">
                            <input asp-for="Address1" id="Address1" type="text" class="form-control form-control-sm" required placeholder="Type to search address..." />
                        </div>
                        <span asp-validation-for="Address1" class="text-danger"></span>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label asp-for="Address2" class="col-md-4 col-form-label text-start small"> </label>
                                <div class="col-md-8">
                                    <input asp-for="Address2" type="text" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label asp-for="Location" class="col-md-4 col-form-label text-start small"> </label>
                                <div class="col-md-8">
                                    <input asp-for="Location" type="text" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label class="col-md-4 col-form-label text-start small">Lat / Lng</label>
                                <div class="col-md-4">
                                    <input asp-for="Latitude" id="Latitude" type="text" class="form-control form-control-sm" readonly placeholder="Latitude" />
                                </div>
                                <div class="col-md-4">
                                    <input asp-for="Longitude" id="Longitude" type="text" class="form-control form-control-sm" readonly placeholder="Longitude" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- COUNTRY / STATE / CITY -->
                    <div class="row mb-2">

                        <!-- COUNTRY -->
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label asp-for="CountryId" class="col-md-4 col-form-label text-start">
                                    Country
                                </label>

                                <div class="col-md-8 d-flex align-items-center">

                                    <select asp-for="CountryId"
                                            id="countryId"
                                            asp-items="@ViewBag.CountryList"
                                            class="form-select form-select-sm me-2">
                                        <option value="">select</option>
                                    </select>

                                    <div class="shortcut-box">
                                        <span id="btnF2Country" class="shortcut-link">
                                            F2 - New
                                        </span>

                                        <span id="btnF3Country" class="shortcut-link text-danger">
                                            F3 - Mod
                                        </span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- STATE -->
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label asp-for="StateId"
                                       class="col-md-4 col-form-label text-start">
                                    State
                                </label>

                                <div class="col-md-8 d-flex align-items-center">

                                    <select asp-for="StateId"
                                            id="stateId"
                                            asp-items="@ViewBag.StateList"
                                            class="form-select form-select-sm me-2">
                                        <option value="">select</option>
                                    </select>

                                    <div class="shortcut-box">
                                        <span id="btnF2State" class="shortcut-link">
                                            F2 - New
                                        </span>

                                        <span id="btnF3State" class="shortcut-link text-danger">
                                            F3 - Mod
                                        </span>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- CITY / PINCODE -->
                    <div class="row mb-2">

                        <!-- CITY -->
                        <div class="col-md-6">
                            <div class="row mb-2">

                                <label asp-for="CityId"
                                       class="col-md-4 col-form-label text-start">
                                    City
                                </label>

                                <div class="col-md-8 d-flex align-items-center">

                                    <select asp-for="CityId"
                                            id="cityId"
                                            asp-items="@ViewBag.CityList"
                                            class="form-select form-select-sm me-2">
                                        <option value="">select</option>
                                    </select>

                                    <div class="shortcut-box">
                                        <span id="btnF2City" class="shortcut-link">
                                            F2 - New
                                        </span>

                                        <span id="btnF3City" class="shortcut-link text-danger">
                                            F3 - Mod
                                        </span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- PINCODE -->
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label asp-for="PinCode"
                                       class="col-md-4 col-form-label text-start small">
                                    PinCode
                                </label>

                                <div class="col-md-8">
                                    <input asp-for="PinCode"
                                           type="text"
                                           class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="row mb-2">
                        <label asp-for="Description" class="col-md-2 col-form-label text-start small"> </label>
                        <div class="col-md-10">
                            <input asp-for="Description" type="text" row="2" class="form-control form-control-sm" />
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <fieldset style="border:1px solid gray;" class="p-2">
                    <legend>Company Details</legend>
                    <div class="row mb-2">
                        <label asp-for="GstNo" class="col-md-4 col-form-label text-start small"> </label>
                        <div class="col-md-8">
                            <input asp-for="GstNo" id="GSTNo" type="text" class="form-control form-control-sm" />
                        </div>
                    </div>

                    <!-- State Code Section -->
                    <div class="row mb-2">
                        <label class="col-md-4 col-form-label small">
                            State Code
                        </label>
                        <div class="col-md-8">
                            <!-- Display field (readonly) -->
                            <input type="text"
                                   id="StateCodeDisplay"
                                   class="form-control form-control-sm"
                                   placeholder="e.g. 09 - UttarPradesh"
                                   readonly />

                            <input type="hidden"
                                   asp-for="StateCode"
                                   id="StateCodeHidden"
                                   value="@((int?)Model.StateCode ?? 0)" />
                        </div>
                    </div>

                    <div class="row mb-2">
                        <label asp-for="CompanyType" class="col-md-4 col-form-label text-start">Comp Type</label>
                        <div class="col-md-8">
                            <select asp-for="CompanyType" id="CompanyTypeSelect" asp-items="Html.GetEnumSelectList<CompanyType>()" class="form-select form-select-sm"></select>
                        </div>
                    </div>
                    <div class="row mb-2" id="parentTenantContainer" style="display: none;">
                        <label asp-for="ParentTenantId" class="col-md-4 col-form-label text-start">Parent Head Office</label>
                        <div class="col-md-8">
                            <select asp-for="ParentTenantId" id="ParentTenantSelect" asp-items="@ViewBag.ParentTenantList" class="form-select form-select-sm">
                                <option value="">select Head Office</option>
                            </select>
                            <span asp-validation-for="ParentTenantId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label asp-for="BranchCode" class="col-md-4 col-form-label text-start"></label>
                        <div class="col-md-8">
                            <input asp-for="BranchCode" type="text" class="form-control form-control-sm" />
                        </div>
                    </div>

                    <div class="row mb-2">
                        <label asp-for="BusinessType" class="col-md-4 col-form-label text-start"></label>
                        <div class="col-md-8">
                            <select asp-for="BusinessType" asp-items="Html.GetEnumSelectList<BusinessType>()" class="form-select form-select-sm"></select>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label asp-for="CalenderType" class="col-md-4 col-form-label text-start"></label>
                        <div class="col-md-8">
                            <select asp-for="CalenderType" asp-items="Html.GetEnumSelectList<CalenderType>()" class="form-select form-select-sm"></select>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label asp-for="YearFrom" class="col-md-4 col-form-label text-start">Financial Year</label>
                        <div class="col-md-8">
                            <input asp-for="YearFrom" type="date" class="form-control form-control-sm" />
                            <input asp-for="YearTo" type="date" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label asp-for="TaxType" class="col-md-4 col-form-label text-start"></label>
                        <div class="col-md-8">
                            <select asp-for="TaxType" asp-items="Html.GetEnumSelectList<TaxType>()" class="form-select form-select-sm"></select>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label asp-for="SubscriptionPlanId" class="col-md-4 col-form-label text-start small">Subscription Plan</label>
                        <div class="col-md-8">
                            <select asp-for="SubscriptionPlanId" id="subscriptionPlanId" asp-items="@ViewBag.SubscriptionPlanList" class="form-select form-select-sm">
                                <option value="">select plan</option>
                            </select>
                        </div>
                    </div>
                </fieldset>


            </div>
        </div>
        <div class="row">
            <div class="col-md-8">
                <fieldset style="border:1px solid gray;" class="p-2 mt-1">
                    <legend>Contact Details</legend>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label asp-for="ContactPerson" class="col-md-4 col-form-label text-start small"> </label>
                                <div class="col-md-8">
                                    <input asp-for="ContactPerson" type="text" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label asp-for="Email" class="col-md-4 col-form-label text-start small">Email <i class="text-danger">*</i> </label>
                                <div class="col-md-8">
                                    <input asp-for="Email" type="text" class="form-control form-control-sm" required />
                                </div>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label asp-for="Phone" class="col-md-4 col-form-label text-start small"> </label>
                                <div class="col-md-8">
                                    <input asp-for="Phone" type="text" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <div class="row mb-2">
                                <label asp-for="MobileNo" class="col-md-4 col-form-label text-start small"> Mobile No <i class="text-danger">*</i></label>
                                <div class="col-md-8">
                                    <input asp-for="MobileNo" type="text" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="col-md-4">
                <div class="row mt-3">
                    <label asp-for="Logo" class="col-md-4 col-form-label text-start small"> </label>
                    <div class="col-md-8">
                        <input asp-for="UploadAttachement" type="file" class="form-control form-control-sm" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Logo))
                {
                    <div class="col-md-4 mt-3">
                        <a href="~/@Model.Logo" target="_blank">Download Attachment</a>
                    </div>
                }
                <span></span>
            </div>

        </div>
        <div class="row mt-2">
            <ul class="nav nav-tabs flex-nowrap" id="companyInfoTabs">
                <li>
                    <a class="nav-link active" href="#licenceInfo" data-bs-toggle="tab">Licence Info</a>
                </li>
                <li>
                    <a class="nav-link" href="#otherInfo" data-bs-toggle="tab">Other Info</a>
                </li>
                <li>
                    <a class="nav-link" href="#moduleAccess" data-bs-toggle="tab">Module Access</a>
                </li>
            </ul>
            <div class="tab-content p-3 border border-top-0" id="companyInfoTabsContent">
                <div class="tab-pane fade show active" id="licenceInfo">
                    <div class="row ">
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label asp-for="IFSSAINo" class="col-md-3 col-form-label text-start small"></label>
                                <div class="col-md-9">
                                    <input asp-for="IFSSAINo" type="text" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label asp-for="DrugLicNo" class="col-md-3 col-form-label text-start small"></label>
                                <div class="col-md-9">
                                    <input asp-for="DrugLicNo" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label asp-for="LicenceExpiryDate" class="col-md-3 col-form-label text-start small"> </label>
                                <div class="col-md-9">
                                    <input asp-for="LicenceExpiryDate" type="date" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="otherInfo">
                    <div class="row ">
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label asp-for="Jurisdiction" class="col-md-3 col-form-label text-start small"></label>
                                <div class="col-md-9">
                                    <input asp-for="Jurisdiction" type="text" class="form-control form-control-sm" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row mb-2">
                                <label asp-for="WorkingStyle" class="col-md-3 col-form-label text-start small"> </label>
                                <div class="col-md-9">
                                    <select asp-for="WorkingStyle" id="CategoryId" asp-items="@Html.GetEnumSelectList<WorkingStyle>()" class="form-select form-select-sm"></select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="moduleAccess">
                    <p class="text-muted small">Customize company-level module and sub-module overrides. Leaving a module unchecked will disable it for this company. Checked modules will be allowed.</p>
                    <div class="row">
                        @if (ViewBag.Features != null)
                        {
                            var features = (List<Feature>)ViewBag.Features;
                            var parents = features.Where(f => f.ParentFeatureId == null).ToList();
                            foreach (var parent in parents)
                            {
                                var children = features.Where(f => f.ParentFeatureId == parent.Id).ToList();
                                <div class="col-md-4 mb-3">
                                    <div class="card border">
                                        <div class="card-header bg-light py-1 px-2 d-flex align-items-center">
                                            <input type="checkbox" name="SelectedFeatures" value="@parent.FeatureKey" 
                                                   id="feat-@parent.Id" class="form-check-input me-2 tenant-parent-chk" 
                                                   @(Model.SelectedFeatures != null && Model.SelectedFeatures.Contains(parent.FeatureKey) ? "checked" : "") />
                                            <label for="feat-@parent.Id" class="form-check-label mb-0 small font-weight-bold">@parent.DisplayName</label>
                                        </div>
                                        <div class="card-body p-2">
                                            @if (children.Any())
                                            {
                                                <div class="ms-3">
                                                    @foreach (var child in children)
                                                    {
                                                        <div class="form-check mb-1">
                                                            <input type="checkbox" name="SelectedFeatures" value="@child.FeatureKey" 
                                                                   id="feat-@child.Id" data-parent-id="feat-@parent.Id" 
                                                                   class="form-check-input tenant-child-chk" 
                                                                   @(Model.SelectedFeatures != null && Model.SelectedFeatures.Contains(child.FeatureKey) ? "checked" : "") />
                                                            <label for="feat-@child.Id" class="form-check-label small">@child.DisplayName</label>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small italic">No sub-modules</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <!-- MODALS -->
        <div class="modal fade" id="countryModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content custom-modal">
                    <div class="modal-header">
                        <h4 class="modal-title" id="countryModalTitle">Add Country</h4>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="modalCountryId" value="0" />
                        <label>Name</label>
                        <input type="text" id="modalCountryName" class="form-control modal-input" />
                        <span id="countryError" class="text-danger small modal-error"></span>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success btn-sm px-4" id="btnSaveCountry">Save</button>
                        <button type="button" class="btn btn-danger btn-sm px-4" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="stateModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content custom-modal">
                    <div class="modal-header">
                        <h4 class="modal-title" id="stateModalTitle">Add State</h4>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="modalStateId" value="0" />
                        <label>Country</label>
                        <div class="d-flex align-items-center mb-2">
                            <select id="modalStateCountryId" asp-items="@ViewBag.CountryList" class="form-select form-select-sm modal-input me-2">
                                <option value="">select</option>
                            </select>
                            <div class="shortcut-box">
                                <span id="btnF2StateCountry" class="shortcut-link">F2 - New</span>
                                <span id="btnF3StateCountry" class="shortcut-link text-danger">F3 - Mod</span>
                            </div>
                        </div>
                        <label>Name</label>
                        <input type="text" id="modalStateName" class="form-control modal-input" />
                        <span id="stateError" class="text-danger small modal-error"></span>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success btn-sm px-4" id="btnSaveState">Save</button>
                        <button type="button" class="btn btn-danger btn-sm px-4" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="cityModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content custom-modal">
                    <div class="modal-header">
                        <h4 class="modal-title" id="cityModalTitle">Add City</h4>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="modalCityId" value="0" />
                        <label>Country</label>
                        <div class="d-flex align-items-center mb-2">
                            <select id="modalCityCountryId" asp-items="@ViewBag.CountryList" class="form-select form-select-sm modal-input me-2">
                                <option value="">select</option>
                            </select>
                            <div class="shortcut-box">
                                <span id="btnF2CityCountry" class="shortcut-link">F2 - New</span>
                                <span id="btnF3CityCountry" class="shortcut-link text-danger">F3 - Mod</span>
                            </div>
                        </div>
                        <label>State</label>
                        <div class="d-flex align-items-center mb-2">
                            <select id="modalCityStateId" class="form-select form-select-sm modal-input me-2">
                                <option value="">select</option>
                            </select>
                            <div class="shortcut-box">
                                <span id="btnF2CityState" class="shortcut-link">F2 - New</span>
                                <span id="btnF3CityState" class="shortcut-link text-danger">F3 - Mod</span>
                            </div>
                        </div>
                        <label>Name</label>
                        <input type="text" id="modalCityName" class="form-control modal-input" />
                        <span id="cityError" class="text-danger small modal-error"></span>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success btn-sm px-4" id="btnSaveCity">Save</button>
                        <button type="button" class="btn btn-danger btn-sm px-4" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-3 text-end">
            <button type="submit" class="btn btn-primary px-4">Save</button>
            <a asp-controller="Tenant" asp-action="Index" class="btn btn-secondary px-4">Cancel</a>

        </div>
    </div>
</form>
<link href="~/css/page.css" rel="stylesheet" />


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        const gstStateEnumMap = {
