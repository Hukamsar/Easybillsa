@model EasyBill.Models.Entity.SubscriptionPlan
@using EasyBill.Models.Entity

@{
    ViewData["Title"] = "Edit Subscription Plan";
    var features = (List<Feature>)ViewBag.Features;
    var parents = features.Where(f => f.ParentFeatureId == null).ToList();
    var selectedFeatureIds = (List<int>)ViewBag.SelectedFeatureIds ?? new List<int>();

    // Categorization Groups
    var masterKeys = new List<string> { "Master", "GlobalSettings" };
    var transactionKeys = new List<string> { "Sales", "Purchase" };
    var voucherKeys = new List<string> { "PurchaseOrder", "PaymentVoucher", "ReceiveVoucher", "Wallet" };
    var reportKeys = new List<string> { "Reports", "Inventory", "GSTR" };

    var masterGroup = parents.Where(p => masterKeys.Contains(p.FeatureKey)).ToList();
    var transactionGroup = parents.Where(p => transactionKeys.Contains(p.FeatureKey)).ToList();
    var voucherGroup = parents.Where(p => voucherKeys.Contains(p.FeatureKey)).ToList();
    var reportGroup = parents.Where(p => reportKeys.Contains(p.FeatureKey)).ToList();

    var otherGroup = parents.Where(p => !masterKeys.Contains(p.FeatureKey)
                                      && !transactionKeys.Contains(p.FeatureKey)
                                      && !voucherKeys.Contains(p.FeatureKey)
                                      && !reportKeys.Contains(p.FeatureKey)).ToList();
}

<style>
    /* Premium Styling System */
    .premium-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        background: #ffffff;
        margin-bottom: 24px;
    }

    .premium-card-header {
        background-color: #2b6ac9 !important;
        color: #ffffff;
        font-weight: 600;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        padding: 14px 20px;
    }

    .form-control-premium {
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        font-weight: 500;
        color: #1e293b;
        transition: all 0.2s ease;
    }

    .form-control-premium:focus {
        border-color: #2b6ac9;
        box-shadow: 0 0 0 3px rgba(43, 106, 201, 0.15);
        outline: none;
    }

    .form-label-premium {
        font-size: 13px;
        font-weight: 700;
        color: #475569;
        margin-bottom: 6px;
    }

    /* Category Cards */
    .perm-category-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        background: #ffffff;
        margin-bottom: 24px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .perm-category-card:hover {
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
    }

    .perm-category-header {
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 14px 20px;
        border-bottom: 1px solid rgba(0,0,0,0.06);
        display: flex;
        align-items: center;
    }

    .perm-category-header i {
        font-size: 1.15rem;
    }

    .perm-category-body {
        padding: 20px;
    }

    /* Parent Checkbox Container */
    .parent-feature-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 16px;
        transition: all 0.2s ease;
    }

    .parent-feature-box:last-child {
        margin-bottom: 0;
    }

    .parent-feature-box:hover {
        border-color: #cbd5e1;
        background: #f1f5f9;
    }

    .parent-feature-box.active {
        background: rgba(43, 106, 201, 0.02);
        border-color: rgba(43, 106, 201, 0.35);
    }

    .parent-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 10px;
        border-bottom: 1px dashed #e2e8f0;
    }

    .parent-header.no-children {
        border-bottom: none;
        padding-bottom: 0;
    }

    .parent-chk-wrapper .form-check-input {
        cursor: pointer;
        width: 19px;
        height: 19px;
        border-radius: 4px;
        border: 2px solid #cbd5e1;
        margin-top: 1px;
    }

    .parent-chk-wrapper .form-check-input:checked {
        background-color: #2b6ac9;
        border-color: #2b6ac9;
    }

    .parent-label {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1e293b;
        margin-left: 10px;
        cursor: pointer;
        user-select: none;
    }

    /* Children Checkboxes Grid */
    .children-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 10px;
        margin-top: 14px;
    }

    .child-chk-item {
        display: flex;
        align-items: center;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 8px 12px;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .child-chk-item:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
    }

    .child-chk-item.checked {
        border-color: rgba(43, 106, 201, 0.35);
        background: rgba(43, 106, 201, 0.05);
    }

    .child-chk-item .form-check-input {
        cursor: pointer;
        width: 16px;
        height: 16px;
        border: 2px solid #cbd5e1;
        border-radius: 3px;
        margin-top: 0;
    }

    .child-chk-item .form-check-input:checked {
        background-color: #2b6ac9;
        border-color: #2b6ac9;
    }

    .child-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #475569;
        margin-left: 8px;
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Edit Subscription Plan</h3>
        <p class="text-muted mb-0 small">Update plan pricing, login limits, and default feature access permissions.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 rounded-2 fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<form asp-action="Edit" method="post" id="PlanForm">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row">
        <!-- Left Column: Plan Details -->
        <div class="col-lg-4 col-md-5">
            <div class="card premium-card border border-light">
                <div class="card-header bg-white border-bottom border-light pt-3 pb-2">
                    <div class="d-flex align-items-center">
                        <div class="pe-2" style="border-right: 3px solid #2b6ac9;">
                            <h5 class="mb-0 text-dark fw-bold" style="font-size: 16px;">Plan Details</h5>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="PlanName" class="form-label-premium">Plan Name <span class="text-danger">*</span></label>
                        <input asp-for="PlanName" class="form-control form-control-premium" placeholder="e.g. Smart Plan" required />
                        <span asp-validation-for="PlanName" class="text-danger small"></span>
                    </div>
                    
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="MonthlyPrice" class="form-label-premium">Monthly Price</label>
                            <input asp-for="MonthlyPrice" type="number" step="0.01" class="form-control form-control-premium" placeholder="0.00" />
                            <span asp-validation-for="MonthlyPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="YearlyPrice" class="form-label-premium">Yearly Price</label>
                            <input asp-for="YearlyPrice" type="number" step="0.01" class="form-control form-control-premium" placeholder="0.00" />
                            <span asp-validation-for="YearlyPrice" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DailyCustomerLimit" class="form-label-premium">Daily Customer Limit</label>
                        <input asp-for="DailyCustomerLimit" type="number" class="form-control form-control-premium" placeholder="e.g. 100" />
                        <span asp-validation-for="DailyCustomerLimit" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="MaxDesktopLogins" class="form-label-premium">Max Desktop</label>
                            <input asp-for="MaxDesktopLogins" type="number" class="form-control form-control-premium" placeholder="0" />
                            <span asp-validation-for="MaxDesktopLogins" class="text-danger small"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="MaxMobileLogins" class="form-label-premium">Max Mobile</label>
                            <input asp-for="MaxMobileLogins" type="number" class="form-control form-control-premium" placeholder="0" />
                            <span asp-validation-for="MaxMobileLogins" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3 mt-2">
                        <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                        <label class="form-check-label ms-2 text-secondary fw-semibold small" asp-for="IsActive">Set Active Status</label>
                    </div>
                </div>
            </div>
            
            <div class="d-grid gap-2 mb-4">
                <button type="submit" class="btn btn-primary py-2 fw-semibold rounded-2 shadow-sm" style="background-color: #2b6ac9; border-color:#2b6ac9;">
                    <i class="bi bi-save me-1"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-light py-2 text-secondary fw-semibold border rounded-2">
                    Cancel
                </a>
            </div>
        </div>

        <!-- Right Column: Features Panel -->
        <div class="col-lg-8 col-md-7">
            <div class="d-flex flex-sm-row flex-column justify-content-between align-items-sm-center align-items-start gap-2 mb-3">
                <div>
                    <h5 class="mb-0 text-dark fw-bold" style="font-size:16px;">Default Features Configuration Console</h5>
                    <span class="text-muted small">Select the modules and sub-modules active by default for this plan.</span>
                </div>
                <div class="btn-group shadow-sm">
                    <button type="button" id="btnSelectAll" class="btn btn-light btn-sm text-primary fw-bold border">
                        <i class="bi bi-check-all me-1"></i> Select All
                    </button>
                    <button type="button" id="btnDeselectAll" class="btn btn-light btn-sm text-secondary fw-semibold border">
                        <i class="bi bi-x me-1"></i> Clear
                    </button>
                </div>
            </div>

            <div class="row">
                <!-- Group 1: Operations & Masters -->
                @if (masterGroup.Any())
                {
                    <div class="col-12 col-xl-6">
                        <div class="perm-category-card">
                            <div class="perm-category-header text-white" style="background-color: #2b6ac9 !important;">
                                <i class="bi bi-cpu me-2"></i> Operations & Masters
                            </div>
                            <div class="perm-category-body">
                                @foreach (var parent in masterGroup)
                                {
                                    var children = features.Where(f => f.ParentFeatureId == parent.Id).ToList();
                                    bool hasChildren = children.Any();
                                    bool parentChecked = selectedFeatureIds.Contains(parent.Id);
                                    <div class="parent-feature-box">
                                        <div class="parent-header @(hasChildren ? "" : "no-children")">
                                            <div class="parent-title-group">
                                                <div class="form-check parent-chk-wrapper mb-0">
                                                    <input type="checkbox" name="selectedFeatures" value="@parent.Id" 
                                                           id="feat-@parent.Id" class="form-check-input parent-chk" 
                                                           @(parentChecked ? "checked" : "") />
                                                    <label for="feat-@parent.Id" class="form-check-label parent-label mb-0">@parent.DisplayName</label>
                                                </div>
                                            </div>
                                            @if (hasChildren)
                                            {
                                                <span class="badge rounded-pill bg-light text-dark border small fw-normal">@children.Count Sub-modules</span>
                                            }
                                        </div>
                                        
                                        @if (hasChildren)
                                        {
                                            <div class="children-grid">
                                                @foreach (var child in children)
                                                {
                                                    bool childChecked = selectedFeatureIds.Contains(child.Id);
                                                    <div class="child-chk-item">
                                                        <input type="checkbox" name="selectedFeatures" value="@child.Id" 
                                                               id="feat-@child.Id" data-parent-id="feat-@parent.Id" 
                                                               class="form-check-input child-chk" 
                                                               @(childChecked ? "checked" : "") />
                                                        <label for="feat-@child.Id" class="form-check-label child-label mb-0" title="@child.DisplayName">@child.DisplayName</label>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Group 2: Core Transactions -->
                @if (transactionGroup.Any())
                {
                    <div class="col-12 col-xl-6">
                        <div class="perm-category-card">
                            <div class="perm-category-header text-white" style="background-color: #2ecc71 !important;">
                                <i class="bi bi-shop-window me-2"></i> Sales & Purchases
                            </div>
                            <div class="perm-category-body">
                                @foreach (var parent in transactionGroup)
                                {
                                    var children = features.Where(f => f.ParentFeatureId == parent.Id).ToList();
                                    bool hasChildren = children.Any();
                                    bool parentChecked = selectedFeatureIds.Contains(parent.Id);
                                    <div class="parent-feature-box">
                                        <div class="parent-header @(hasChildren ? "" : "no-children")">
                                            <div class="parent-title-group">
                                                <div class="form-check parent-chk-wrapper mb-0">
                                                    <input type="checkbox" name="selectedFeatures" value="@parent.Id" 
                                                           id="feat-@parent.Id" class="form-check-input parent-chk" 
                                                           @(parentChecked ? "checked" : "") />
                                                    <label for="feat-@parent.Id" class="form-check-label parent-label mb-0">@parent.DisplayName</label>
                                                </div>
                                            </div>
                                            @if (hasChildren)
                                            {
                                                <span class="badge rounded-pill bg-light text-dark border small fw-normal">@children.Count Sub-modules</span>
                                            }
                                        </div>
                                        
                                        @if (hasChildren)
                                        {
                                            <div class="children-grid">
                                                @foreach (var child in children)
                                                {
                                                    bool childChecked = selectedFeatureIds.Contains(child.Id);
                                                    <div class="child-chk-item">
                                                        <input type="checkbox" name="selectedFeatures" value="@child.Id" 
                                                               id="feat-@child.Id" data-parent-id="feat-@parent.Id" 
                                                               class="form-check-input child-chk" 
                                                               @(childChecked ? "checked" : "") />
                                                        <label for="feat-@child.Id" class="form-check-label child-label mb-0" title="@child.DisplayName">@child.DisplayName</label>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Group 3: Orders & Vouchers -->
                @if (voucherGroup.Any())
                {
                    <div class="col-12 col-xl-6">
                        <div class="perm-category-card">
                            <div class="perm-category-header text-white" style="background-color: #e67e22 !important;">
                                <i class="bi bi-receipt-cutoff me-2"></i> Orders, Vouchers & Wallets
                            </div>
                            <div class="perm-category-body">
                                @foreach (var parent in voucherGroup)
                                {
                                    var children = features.Where(f => f.ParentFeatureId == parent.Id).ToList();
                                    bool hasChildren = children.Any();
                                    bool parentChecked = selectedFeatureIds.Contains(parent.Id);
                                    <div class="parent-feature-box">
                                        <div class="parent-header @(hasChildren ? "" : "no-children")">
                                            <div class="parent-title-group">
                                                <div class="form-check parent-chk-wrapper mb-0">
                                                    <input type="checkbox" name="selectedFeatures" value="@parent.Id" 
                                                           id="feat-@parent.Id" class="form-check-input parent-chk" 
                                                           @(parentChecked ? "checked" : "") />
                                                    <label for="feat-@parent.Id" class="form-check-label parent-label mb-0">@parent.DisplayName</label>
                                                </div>
                                            </div>
                                            @if (hasChildren)
                                            {
                                                <span class="badge rounded-pill bg-light text-dark border small fw-normal">@children.Count Sub-modules</span>
                                            }
                                        </div>
                                        
                                        @if (hasChildren)
                                        {
                                            <div class="children-grid">
                                                @foreach (var child in children)
                                                {
                                                    bool childChecked = selectedFeatureIds.Contains(child.Id);
                                                    <div class="child-chk-item">
                                                        <input type="checkbox" name="selectedFeatures" value="@child.Id" 
                                                               id="feat-@child.Id" data-parent-id="feat-@parent.Id" 
                                                               class="form-check-input child-chk" 
                                                               @(childChecked ? "checked" : "") />
                                                        <label for="feat-@child.Id" class="form-check-label child-label mb-0" title="@child.DisplayName">@child.DisplayName</label>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Group 4: Analytics & Reports -->
                @if (reportGroup.Any())
                {
                    <div class="col-12 col-xl-6">
                        <div class="perm-category-card">
                            <div class="perm-category-header text-white" style="background-color: #9b59b6 !important;">
                                <i class="bi bi-bar-chart-line-fill me-2"></i> Analytics, Reports & GST
                            </div>
                            <div class="perm-category-body">
                                @foreach (var parent in reportGroup)
                                {
                                    var children = features.Where(f => f.ParentFeatureId == parent.Id).ToList();
                                    bool hasChildren = children.Any();
                                    bool parentChecked = selectedFeatureIds.Contains(parent.Id);
                                    <div class="parent-feature-box">
                                        <div class="parent-header @(hasChildren ? "" : "no-children")">
                                            <div class="parent-title-group">
                                                <div class="form-check parent-chk-wrapper mb-0">
                                                    <input type="checkbox" name="selectedFeatures" value="@parent.Id" 
                                                           id="feat-@parent.Id" class="form-check-input parent-chk" 
                                                           @(parentChecked ? "checked" : "") />
                                                    <label for="feat-@parent.Id" class="form-check-label parent-label mb-0">@parent.DisplayName</label>
                                                </div>
                                            </div>
                                            @if (hasChildren)
                                            {
                                                <span class="badge rounded-pill bg-light text-dark border small fw-normal">@children.Count Sub-modules</span>
                                            }
                                        </div>
                                        
                                        @if (hasChildren)
                                        {
                                            <div class="children-grid">
                                                @foreach (var child in children)
                                                {
                                                    bool childChecked = selectedFeatureIds.Contains(child.Id);
                                                    <div class="child-chk-item">
                                                        <input type="checkbox" name="selectedFeatures" value="@child.Id" 
                                                               id="feat-@child.Id" data-parent-id="feat-@parent.Id" 
                                                               class="form-check-input child-chk" 
                                                               @(childChecked ? "checked" : "") />
                                                        <label for="feat-@child.Id" class="form-check-label child-label mb-0" title="@child.DisplayName">@child.DisplayName</label>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Fallback Group: Other Modules -->
                @if (otherGroup.Any())
                {
                    <div class="col-12">
                        <div class="perm-category-card">
                            <div class="perm-category-header text-white" style="background-color: #7f8c8d !important;">
                                <i class="bi bi-grid-3x3-gap-fill me-2"></i> Other Modules
                            </div>
                            <div class="perm-category-body">
                                <div class="row">
                                    @foreach (var parent in otherGroup)
                                    {
                                        var children = features.Where(f => f.ParentFeatureId == parent.Id).ToList();
                                        bool hasChildren = children.Any();
                                        bool parentChecked = selectedFeatureIds.Contains(parent.Id);
                                        <div class="col-md-6 mb-3">
                                            <div class="parent-feature-box">
                                                <div class="parent-header @(hasChildren ? "" : "no-children")">
                                                    <div class="parent-title-group">
                                                        <div class="form-check parent-chk-wrapper mb-0">
                                                            <input type="checkbox" name="selectedFeatures" value="@parent.Id" 
                                                                   id="feat-@parent.Id" class="form-check-input parent-chk" 
                                                                   @(parentChecked ? "checked" : "") />
                                                            <label for="feat-@parent.Id" class="form-check-label parent-label mb-0">@parent.DisplayName</label>
                                                        </div>
                                                    </div>
                                                    @if (hasChildren)
                                                    {
                                                        <span class="badge rounded-pill bg-light text-dark border small fw-normal">@children.Count Sub-modules</span>
                                                    }
                                                </div>
                                                
                                                @if (hasChildren)
                                                {
                                                    <div class="children-grid">
                                                        @foreach (var child in children)
                                                        {
                                                            bool childChecked = selectedFeatureIds.Contains(child.Id);
                                                            <div class="child-chk-item">
                                                                <input type="checkbox" name="selectedFeatures" value="@child.Id" 
                                                                       id="feat-@child.Id" data-parent-id="feat-@parent.Id" 
                                                                       class="form-check-input child-chk" 
                                                                       @(childChecked ? "checked" : "") />
                                                                <label for="feat-@child.Id" class="form-check-label child-label mb-0" title="@child.DisplayName">@child.DisplayName</label>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Function to update visual states of parents and children based on checked values
            function updateVisualStates() {
                // Update parent boxes
                $(".parent-chk").each(function () {
                    var isChecked = $(this).is(":checked");
                    var box = $(this).closest(".parent-feature-box");
                    if (isChecked) {
                        box.addClass("active");
                    } else {
                        box.removeClass("active");
                    }
                });

                // Update child boxes
                $(".child-chk").each(function () {
                    var isChecked = $(this).is(":checked");
                    var item = $(this).closest(".child-chk-item");
                    if (isChecked) {
                        item.addClass("checked");
                    } else {
                        item.removeClass("checked");
                    }
                });
            }

            // 1. Check/Uncheck all children when parent is toggled
            $(".parent-chk").on("change", function () {
                var isChecked = $(this).is(":checked");
                var parentId = $(this).attr("id");
                
                $("[data-parent-id='" + parentId + "']").each(function () {
                    $(this).prop("checked", isChecked);
                });
                updateVisualStates();
            });

            // 2. Child changes: check parent if any child is checked, uncheck if all children unchecked
            $(".child-chk").on("change", function () {
                var parentSelector = "#" + $(this).data("parent-id");
                var siblingGroupName = "[data-parent-id='" + $(this).data("parent-id") + "']";
                
                var anyChecked = false;
                $(siblingGroupName).each(function () {
                    if ($(this).is(":checked")) {
                        anyChecked = true;
                    }
                });
                
                $(parentSelector).prop("checked", anyChecked);
                updateVisualStates();
            });

            // 3. Make child card wrapper clickable
            $(document).on("click", ".child-chk-item", function (e) {
                if ($(e.target).is("input")) return;
                var chk = $(this).find("input[type='checkbox']");
                chk.prop("checked", !chk.prop("checked")).trigger("change");
            });

            // 4. Quick Actions
            $("#btnSelectAll").on("click", function () {
                $(".parent-chk, .child-chk").prop("checked", true);
                updateVisualStates();
            });

            $("#btnDeselectAll").on("click", function () {
                $(".parent-chk, .child-chk").prop("checked", false);
                updateVisualStates();
            });

            // Initial visual update
            updateVisualStates();
        });
    </script>
}
