@model IEnumerable<EasyBill.Models.Entity.SubscriptionPlan>

@{
    ViewData["Title"] = "Subscription Plans";
}

<style>
    .plans-header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        background: #ffffff;
        padding: 20px 24px;
        border-radius: 16px;
        box-shadow: 0 4px 18px -4px rgba(43, 106, 201, 0.05);
        border: 1px solid #e2e8f0;
    }

    .plans-title-area h2 {
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        font-size: 24px;
        letter-spacing: -0.02em;
    }

    .plans-title-area p {
        color: #64748b;
        margin: 4px 0 0 0;
        font-size: 14px;
    }

    .btn-add-plan {
        background-color: #2b6ac9;
        color: white !important;
        font-weight: 700;
        padding: 10px 20px;
        border-radius: 12px;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(43, 106, 201, 0.2);
        text-decoration: none !important;
        font-size: 14px;
    }

    .btn-add-plan:hover {
        background-color: #1e4ea1;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(43, 106, 201, 0.3);
    }

    /* Cards Grid */
    .plan-grid {
        margin-bottom: 3rem;
    }

    .plan-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        box-shadow: 0 10px 30px -5px rgba(43, 106, 201, 0.05), 0 1px 3px rgba(0, 0, 0, 0.02);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .plan-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -10px rgba(43, 106, 201, 0.15), 0 2px 10px rgba(43, 106, 201, 0.05);
        border-color: var(--accent-color, #2b6ac9);
    }

    .plan-badge {
        position: absolute;
        top: 18px;
        right: 18px;
        padding: 5px 12px;
        font-size: 11px;
        font-weight: 700;
        border-radius: 50px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .plan-badge-active {
        background-color: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    .plan-badge-inactive {
        background-color: #f3f4f6;
        color: #4b5563;
        border: 1px solid #e5e7eb;
    }

    .plan-header {
        padding: 32px 28px 24px;
        border-bottom: 1px solid #f1f5f9;
        text-align: center;
    }

    .plan-icon-wrapper {
        width: 64px;
        height: 64px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        font-size: 26px;
        background: var(--light-accent-bg, #eff6ff);
        color: var(--accent-color, #2b6ac9);
        box-shadow: inset 0 2px 4px rgba(255,255,255,0.8), 0 4px 12px -2px rgba(43,106,201,0.08);
    }

    .plan-title {
        font-size: 22px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 8px;
        letter-spacing: -0.01em;
    }

    .plan-price-monthly {
        font-size: 32px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.03em;
    }

    .plan-price-monthly span.period {
        font-size: 14px;
        font-weight: 600;
        color: #64748b;
        letter-spacing: 0;
    }

    .plan-price-yearly {
        font-size: 13px;
        font-weight: 600;
        color: #64748b;
        margin-top: 4px;
    }

    .plan-body {
        padding: 28px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .plan-limits-container {
        background-color: #f8fafc;
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 24px;
        border: 1px solid #f1f5f9;
    }

    .plan-limit-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        color: #475569;
        margin-bottom: 8px;
    }

    .plan-limit-row:last-child {
        margin-bottom: 0;
    }

    .plan-limit-label {
        font-weight: 500;
    }

    .plan-limit-value {
        font-weight: 700;
        color: #0f172a;
    }

    .plan-feature-list-title {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #94a3b8;
        margin-bottom: 12px;
    }

    .plan-feature-list {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 13px;
        color: #334155;
    }

    .plan-feature-list li {
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .plan-feature-list li i {
        font-size: 16px;
        color: var(--accent-color, #2b6ac9);
    }

    .plan-feature-list li.no-features {
        color: #94a3b8;
        font-style: italic;
    }

    .plan-footer {
        padding: 0 28px 28px;
        margin-top: auto;
    }

    .action-btn-group {
        display: flex;
        gap: 10px;
    }

    .btn-edit-plan {
        flex-grow: 1;
        border-radius: 14px;
        font-weight: 700;
        padding: 10px 16px;
        font-size: 13px;
        background-color: var(--accent-color, #2b6ac9);
        border: 1px solid var(--accent-color, #2b6ac9);
        color: white !important;
        text-align: center;
        transition: all 0.2s;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-edit-plan:hover {
        filter: brightness(0.9);
        transform: translateY(-1px);
    }

    .btn-delete-plan-card {
        border-radius: 14px;
        font-weight: 700;
        padding: 10px;
        font-size: 14px;
        background-color: #fff1f2;
        border: 1px solid #ffe4e6;
        color: #e11d48 !important;
        text-align: center;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none !important;
    }

    .btn-delete-plan-card:hover {
        background-color: #e11d48;
        border-color: #e11d48;
        color: white !important;
        transform: translateY(-1px);
    }
</style>

<div class="plans-header-container">
    <div class="plans-title-area">
        <h2>Subscription Plans</h2>
        <p>Define dynamic subscription tiers, pricing, and system defaults for companies.</p>
    </div>
    <div>
        <a asp-controller="CompanyPlan" asp-action="Create" class="btn-add-plan">
            <i class="bi bi-plus-lg"></i> Add Plan
        </a>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 plan-grid" id="cardsContainer">
    @foreach (var item in Model)
    {
        string accentColor = "#2b6ac9";
        string lightAccentBg = "#eff6ff";
        string iconClass = "bi-box-seam";
        
        if (item.PlanName.Contains("Mobile Only", StringComparison.OrdinalIgnoreCase))
        {
            accentColor = "#4b5563";
            lightAccentBg = "#f3f4f6";
            iconClass = "bi-phone-fill";
        }
        else if (item.PlanName.Contains("Smart", StringComparison.OrdinalIgnoreCase) || item.PlanName.Contains("Samrt", StringComparison.OrdinalIgnoreCase))
        {
            accentColor = "#0d9488";
            lightAccentBg = "#f0fdfa";
            iconClass = "bi-cpu-fill";
        }
        else if (item.PlanName.Contains("Prime", StringComparison.OrdinalIgnoreCase))
        {
            accentColor = "#2563eb";
            lightAccentBg = "#eff6ff";
            iconClass = "bi-lightning-charge-fill";
        }
        else if (item.PlanName.Contains("Suprime", StringComparison.OrdinalIgnoreCase) || item.PlanName.Contains("Supreme", StringComparison.OrdinalIgnoreCase))
        {
            accentColor = "#d97706";
            lightAccentBg = "#fffbeb";
            iconClass = "bi-award-fill";
        }
        else if (item.PlanName.Contains("Growth", StringComparison.OrdinalIgnoreCase))
        {
            accentColor = "#7c3aed";
            lightAccentBg = "#f5f3ff";
            iconClass = "bi-graph-up-arrow";
        }

        <div class="col card-col">
            <div class="plan-card" style="--accent-color: @accentColor; --light-accent-bg: @lightAccentBg;">
                @if (item.IsActive)
                {
                    <span class="plan-badge plan-badge-active">Active</span>
                }
                else
                {
                    <span class="plan-badge plan-badge-inactive">Inactive</span>
                }

                <div class="plan-header">
                    <div class="plan-icon-wrapper">
                        <i class="bi @iconClass"></i>
                    </div>
                    <h3 class="plan-title">@item.PlanName</h3>
                    <div class="plan-price-monthly">
                        ₹@item.MonthlyPrice.ToString("N0")<span class="period">/mo</span>
                    </div>
                    <div class="plan-price-yearly">
                        ₹@item.YearlyPrice.ToString("N0") / year
                    </div>
                </div>

                <div class="plan-body">
                    <div class="plan-limits-container">
                        <div class="plan-limit-row">
                            <span class="plan-limit-label"><i class="bi bi-display me-1"></i> Desktop Logins</span>
                            <span class="plan-limit-value">@item.MaxDesktopLogins</span>
                        </div>
                        <div class="plan-limit-row">
                            <span class="plan-limit-label"><i class="bi bi-phone me-1"></i> Mobile Logins</span>
                            <span class="plan-limit-value">@item.MaxMobileLogins</span>
                        </div>
                        <div class="plan-limit-row">
                            <span class="plan-limit-label"><i class="bi bi-people me-1"></i> Daily Customers</span>
                            <span class="plan-limit-value">@item.DailyCustomerLimit.ToString("N0")</span>
                        </div>
                    </div>

                    <div class="plan-feature-list-title">Included Modules</div>
                    <ul class="plan-feature-list">
                        @if (item.PlanFeatures != null && item.PlanFeatures.Any())
                        {
                            var parentFeatures = item.PlanFeatures
                                .Where(pf => pf.Feature != null && pf.Feature.ParentFeatureId == null)
                                .Select(pf => pf.Feature.DisplayName)
                                .OrderBy(name => name)
                                .ToList();

                            if (parentFeatures.Any())
                            {
                                foreach (var featureName in parentFeatures.Take(5))
                                {
                                    <li><i class="bi bi-check-circle-fill"></i> @featureName</li>
                                }

                                if (parentFeatures.Count > 5)
                                {
                                    <li class="p-0 border-0 bg-transparent" style="display: block; width: 100%;">
                                        <ul class="plan-feature-list collapse p-0 m-0 border-0" id="more-features-@item.Id" style="list-style: none;">
                                            @foreach (var featureName in parentFeatures.Skip(5))
                                            {
                                                <li class="mt-2"><i class="bi bi-check-circle-fill"></i> @featureName</li>
                                            }
                                        </ul>
                                    </li>

                                    <li class="mt-2">
                                        <a href="#more-features-@item.Id" 
                                           data-bs-toggle="collapse" 
                                           class="more-features-link text-decoration-none small" 
                                           data-count="@(parentFeatures.Count - 5)"
                                           style="color: var(--accent-color); font-weight: 700; cursor: pointer;"
                                           aria-expanded="false" 
                                           aria-controls="more-features-@item.Id">
                                            <i class="bi bi-plus-lg me-1"></i>@(parentFeatures.Count - 5) more modules
                                        </a>
                                    </li>
                                }
                            }
                            else
                            {
                                var childFeatures = item.PlanFeatures
                                    .Where(pf => pf.Feature != null)
                                    .Select(pf => pf.Feature.DisplayName)
                                    .OrderBy(name => name)
                                    .ToList();

                                foreach (var featureName in childFeatures.Take(5))
                                {
                                    <li><i class="bi bi-check-circle-fill"></i> @featureName</li>
                                }

                                if (childFeatures.Count > 5)
                                {
                                    <li class="p-0 border-0 bg-transparent" style="display: block; width: 100%;">
                                        <ul class="plan-feature-list collapse p-0 m-0 border-0" id="more-features-@item.Id" style="list-style: none;">
                                            @foreach (var featureName in childFeatures.Skip(5))
                                            {
                                                <li class="mt-2"><i class="bi bi-check-circle-fill"></i> @featureName</li>
                                            }
                                        </ul>
                                    </li>

                                    <li class="mt-2">
                                        <a href="#more-features-@item.Id" 
                                           data-bs-toggle="collapse" 
                                           class="more-features-link text-decoration-none small" 
                                           data-count="@(childFeatures.Count - 5)"
                                           style="color: var(--accent-color); font-weight: 700; cursor: pointer;"
                                           aria-expanded="false" 
                                           aria-controls="more-features-@item.Id">
                                            <i class="bi bi-plus-lg me-1"></i>@(childFeatures.Count - 5) more modules
                                        </a>
                                    </li>
                                }
                            }
                        }
                        else
                        {
                            <li class="no-features">No default features assigned</li>
                        }
                    </ul>
                </div>

                <div class="plan-footer">
                    <div class="action-btn-group">
                        <a asp-controller="CompanyPlan" asp-action="Edit" asp-route-id="@item.Id" class="btn-edit-plan">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                        <a href="#" class="btn-delete-plan-card" 
                           data-id="@item.Id" 
                           data-controller="CompanyPlan"
                           title="Delete Plan">
                            <i class="bi bi-trash3-fill"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Listen to Bootstrap collapse events to toggle the text/icon
            $('.plan-grid').on('show.bs.collapse', '.collapse', function () {
                var toggleLink = $(this).closest('.plan-body').find('.more-features-link');
                var count = toggleLink.data('count');
                toggleLink.html('<i class="bi bi-dash-lg me-1"></i>Show less');
            });

            $('.plan-grid').on('hide.bs.collapse', '.collapse', function () {
                var toggleLink = $(this).closest('.plan-body').find('.more-features-link');
                var count = toggleLink.data('count');
                toggleLink.html('<i class="bi bi-plus-lg me-1"></i>' + count + ' more modules');
            });

            $(document).on("click", ".btn-delete-plan-card", function (e) {
                e.preventDefault();
                var id = $(this).data("id");
                var controller = $(this).data("controller");
                var cardCol = $(this).closest(".card-col");

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this plan deletion!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/${controller}/Delete`,
                            type: 'POST',
                            data: { id: id },
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire(
                                        'Deleted!',
                                        response.message || 'Plan deleted successfully.',
                                        'success'
                                    );
                                    cardCol.fadeOut(300, function() {
                                        $(this).remove();
                                        if ($(".card-col").length === 0) {
                                            $("#cardsContainer").html('<div class="col-12 text-center py-5 text-muted">No subscription plans available.</div>');
                                        }
                                    });
                                } else {
                                    Swal.fire(
                                        'Error!',
                                        response.message || 'Can not delete. This plan might be assigned to active companies.',
                                        'error'
                                    );
                                }
                            },
                            error: function () {
                                Swal.fire(
                                    'Error!',
                                    'An error occurred while deleting the plan.',
                                    'error'
                                );
                            }
                        });
                    }
                });
            });
        });
    </script>
}
