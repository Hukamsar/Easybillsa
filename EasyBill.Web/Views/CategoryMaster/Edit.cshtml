@model EasyBill.Models.ViewModels.CategoryMasterVM

@{
    ViewData["Title"] = "Edit";
}

<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    /* Button Hover Effect */
    .btn-primary:hover {
        background-color: #1f5bb5 !important;
        transform: scale(1.05);
        transition: 0.2s ease-in-out;
    }

    .btn-primary:focus {
        box-shadow: 0 0 5px rgba(13,110,253,0.7);
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
            Edit Category
        </div>

        <div class="card-body">
            <form id="editCategoryForm" asp-action="Edit">
                <input type="hidden" asp-for="Id" class="form-control" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-2 d-flex align-items-center mb-1">
                        <label asp-for="CategoryName" class="me-2 mb-0" style="width: 100px;">
                            Category Name <span class="text-danger">*</span>
                        </label>
                    </div>

                    <div class="col-md-4 d-flex align-items-center mb-1">
                        <input asp-for="CategoryName" class="form-control" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-primary">Submit</button>
                    <a asp-controller="CategoryMaster" asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SweetAlert CDN -->
@* <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> *@

<script>
    $(document).ready(function () {

        // Auto focus on input
        $("#CategoryName").focus();

        // Confirm Before Update
        $("#editCategoryForm").on("submit", function (e) {
            e.preventDefault();
            let form = this;

            Swal.fire({
                title: 'Confirm Update?',
                text: 'Do you want to update this category?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '✅ Yes, Update',
                cancelButtonText: '❌ Cancel',
                confirmButtonColor: '#198754',
                cancelButtonColor: '#dc3545',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });

    });
</script>

@if (TempData["success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Updated Successfully',
            text: '@TempData["success"]',
            confirmButtonColor: '#198754'
        });
    </script>
}