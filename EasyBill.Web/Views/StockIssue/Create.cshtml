@using EasyBill.Models.ViewModels
@using Microsoft.AspNetCore.Mvc.Rendering
@model StockIssueVM
@{
    var isEdit = Model.Id > 0;
    var title = isEdit ? "Edit Stock Issue" : "Create Stock Issue";
    var paymentModes = ViewBag.PaymentMode as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var businessType = (int?)ViewBag.BusinessType ?? 0;
    ViewData["Title"] = title;
}
<link href="~/css/page.css" rel="stylesheet" />

<style>
    #globalLoader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,.7);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loader-content {
        text-align: center;
        color: #fff;
    }

    .spinner {
        border: 4px solid rgba(255,255,255,.3);
        border-top: 4px solid #fff;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
        margin: 0 auto 15px;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .batch-row.selected td, .item-row.selected td, .customer-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    /* StockIssue F2/F3 item links mirror css/page.css shortcut style without changing existing modal CSS. */
    #itemModal .shortcut-link {
        font-size: 10px;
        cursor: pointer;
        color: #2b6ac9;
        font-weight: 500;
        transition: 0.2s;
        white-space: nowrap;
        text-decoration: none;
    }

        #itemModal .shortcut-link:hover {
            text-decoration: underline;
        }

        #itemModal .shortcut-link.text-danger {
            color: #dc3545 !important;
        }

    #batchModal .modal-header, #itemModal .modal-header, #itemMasterModal .modal-header, #customerListModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

    .btn-close {
        filter: invert(1);
    }

    .item-table-wrapper, .batch-table-wrapper, .customer-table-wrapper {
        max-height: 350px;
        overflow-y: auto;
    }

    #itemTable thead th, #batchTable thead th, #customerTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        z-index: 2;
    }

    #customerListModal.keyboard-nav .customer-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #customerListModal.mouse-nav .customer-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .customer-row {
        scroll-margin-top: 50px;
    }

        .customer-row:focus {
            outline: none;
        }

    .custom-header th {
        background: linear-gradient(180deg,#eef3f8,#d8e3ef);
        color: #16202b;
        font-weight: 700;
        text-align: center;
    }

    .return-amount {
        font-size: 2rem;
        font-weight: 700;
        color: #8B0000;
    }
</style>

<div id="globalLoader">
    <div class="loader-content">
        <div class="spinner"></div>
        <div class="loader-text">Loading...</div>
    </div>
</div>

<form asp-controller="StockIssue" asp-action="@(isEdit ? "Edit" : "Create")" method="post" id="stockIssueForm">
    <div class="card mb-3 shadow-sm">
        <div class="card-header text-white d-flex align-items-center flex-wrap gap-2" style="background:#2b6ac9">
            <h6 class="mb-0">@title</h6>
            <button type="button" id="btnShowPendingRequests" class="btn btn-sm btn-success branch-section ms-auto" style="display:none;">
                <i class="bi bi-list-check"></i> Pending Requests
            </button>
        </div>
    </div>

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="StockRequestId" />
    <input type="hidden" asp-for="CustomerId" id="CustomerId" />
    <input type="hidden" asp-for="PharmacyDoctorId" id="DoctorId" />
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="container">
        <!-- Professional Document Type Selector -->
        <div class="row mb-3 pb-2 border-bottom align-items-center bg-light rounded p-2">
            <label class="col-md-2 col-form-label text-start small fw-bold text-primary text-uppercase">Document Type:</label>
            <div class="col-md-10 d-flex align-items-center">
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="radio" name="IssueToType" id="issueCustomer" value="Customer" @(Model.IssueToType == "Customer" ? "checked" : "")>
                    <label class="form-check-label fw-bold" style="cursor: pointer;" for="issueCustomer"><i class="bi bi-person-fill"></i> Standard Issue (Customer)</label>
                </div>
                <div class="form-check form-check-inline mb-0 ms-4">
                    <input class="form-check-input" type="radio" name="IssueToType" id="issueBranch" value="Branch" @(Model.IssueToType == "Branch" ? "checked" : "")>
                    <label class="form-check-label fw-bold" style="cursor: pointer;" for="issueBranch"><i class="bi bi-shop"></i> In-Transit Transfer (Branch)</label>
                </div>
            </div>
        </div>

        <div class="row mb-2">
            <label for="BillNo" class="col-md-2 col-form-label text-start small">Bill No <i class="text-danger">*</i></label>
            <div class="col-md-2">
                <input asp-for="ChallanNo" id="BillNo" type="text" class="form-control form-control-sm" />
                <span asp-validation-for="ChallanNo" class="text-danger"></span>
            </div>
            <label for="BillDate" class="col-md-2 col-form-label text-start small">Bill Date <i class="text-danger">*</i></label>
            <div class="col-md-2">
                <input type="date" asp-for="ChallanDate" id="BillDate" class="form-control form-control-sm" required />
                <span asp-validation-for="ChallanDate" class="text-danger"></span>
            </div>
            
            <label class="col-md-2 col-form-label text-start small customer-section">Billing Type</label>
            <div class="col-md-2 customer-section">
                <select asp-for="billingType" id="billingType" class="form-control form-control-sm">
                    <option value="walkin">Cash</option>
                    <option value="registered">Customer</option>
                </select>
            </div>
            
            <!-- Branch Selection (Hidden by default) -->
            <label class="col-md-2 col-form-label text-start small branch-section" style="display:none;">Select Branch <i class="text-danger">*</i></label>
            <div class="col-md-2 branch-section" style="display:none;">
                <select asp-for="TransferToTenantId" id="TransferToTenantId" class="form-control form-control-sm" asp-items="ViewBag.Branches">
                    <option value="">-- Select Branch --</option>
                </select>
            </div>
        </div>

        <div class="row mb-2 customer-section">
            <label class="col-md-2 col-form-label text-start small">Mobile No</label>
            <div class="col-md-2 d-flex align-items-center">
                <div class="w-100">
                    <input asp-for="MobileNo" type="text" class="form-control form-control-sm" id="mobilenumber" maxlength="10" />
                    <small id="mobileError" class="text-danger"></small>
                </div>
                <div class="shortcut-box">
                    <span id="btnF1CustomerList" class="shortcut-link">F1 - List</span>
                </div>
            </div>
            <label class="col-md-2 col-form-label text-start small">Customer</label>
            <div class="col-md-2"><input asp-for="CustomerName" class="form-control form-control-sm" id="customer" /></div>
            <label class="col-md-2 col-form-label text-start small">Address</label>
            <div class="col-md-2"><input asp-for="Address" id="customeraddress" class="form-control form-control-sm" /></div>
        </div>

        @if (Model.DoctorRequired)
        {
            <div class="row mb-2 doctor-section">
                <label class="col-md-2 col-form-label small">Doctor Mobile No</label>
                <div class="col-md-2"><input type="text" asp-for="DoctorMobileNumber" class="form-control form-control-sm" id="doctorMobile" maxlength="10" /></div>
                <label class="col-md-2 col-form-label small">Doctor</label>
                <div class="col-md-2"><input type="text" asp-for="DoctorName" class="form-control form-control-sm" id="doctorname" /></div>
                <label class="col-md-2 col-form-label small">Registration Number</label>
                <div class="col-md-2"><input type="text" asp-for="DoctorRegNumber" class="form-control form-control-sm" id="doctorregno" /></div>
            </div>
        }

        <div class="row mb-2">
            <label class="col-md-2 col-form-label text-start small">Payment Type</label>
            <div class="col-md-2 d-flex align-items-center">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="paymentToggle">
                    <label class="form-check-label fw-bold" id="paymentToggleLabel" style="color: green;">Cash</label>
                </div>
                <input type="hidden" asp-for="PaymentType" id="paymentTypeHidden" />
            </div>
            <label class="col-md-2 col-form-label text-start small">Tax Calculation</label>
            <div class="col-md-2">
                <select asp-for="TaxCalculation" id="taxCalculation" class="form-control form-control-sm">
                    <option value="Yes">Yes</option>
                    <option value="No">No</option>
                </select>
            </div>
            <label class="col-md-2 col-form-label text-start small d-none" id="balanceLabel">Previous Balance</label>
            <div class="col-md-2 d-none" id="balanceField"><input type="text" id="previousBalance" class="form-control text-danger" readonly /></div>
        </div>

        <div class="table-responsive" style="overflow-x:auto;">
            <table class="table table-bordered table-striped">
                <thead class="table custom-header">
                    <tr>
                        <th style="min-width:20%">Item</th>
                        <th style="min-width:20%">Batch</th>
                        <th class="text-center">Expiry</th>
                        <th class="text-center">Mrp</th>
                        <th class="text-center" id="qtyView">Qty</th>
                        @if (businessType == 2)
                        {
                            <th class="text-center" id="qtyTabsView">Tabs</th>
                        }
                        <th class="text-center">Rate</th>
                        <th class="text-center">GST %</th>
                        <th class="text-center">Cess</th>
                        <th class="text-center">Disc %</th>
                        <th class="text-center">Amount</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="StockIssueItemBody">
                    @{
                        var rowIndex = 0;
                        foreach (var item in Model.StockIssuesItemVMs)
                        {
                            <tr data-conversion="1">
                                <td hidden><input name="StockIssuesItemVMs[@rowIndex].Id" value="@item.Id" class="row-id" /></td>
                                <td hidden><input name="StockIssuesItemVMs[@rowIndex].ItemMasterId" value="@item.ItemMasterId" class="item-id" /></td>
                                <td hidden><input name="StockIssuesItemVMs[@rowIndex].PurchaseItemId" value="@item.PurchaseItemId" class="purchase-id" /></td>
                                <td hidden><input name="StockIssuesItemVMs[@rowIndex].HsnId" value="@item.HsnId" class="hsn-id" /></td>
                                <td hidden><input name="StockIssuesItemVMs[@rowIndex].HsnCode" value="@item.HsnCode" class="hsn-code" /></td>
                                <td hidden><input name="StockIssuesItemVMs[@rowIndex].Rate" value="@item.Rate" class="form-control form-control-sm rate" /></td>
                                <td style="min-width:250px;"><input type="text" name="StockIssuesItemVMs[@rowIndex].ItemBarcodeNumber" value="@(item.ItemBarcodeNumber ?? item.ItemName)" class="form-control form-control-sm item-input" /></td>
                                <td><input name="StockIssuesItemVMs[@rowIndex].Batch" value="@item.Batch" class="form-control form-control-sm batch" readonly /></td>
                                <td><input name="StockIssuesItemVMs[@rowIndex].Expirydate" value="@item.Expirydate?.ToString("MM/yyyy")" class="form-control form-control-sm expirydate" readonly /></td>
                                <td><input name="StockIssuesItemVMs[@rowIndex].Mrp" value="@item.Mrp" class="form-control form-control-sm mrp" /></td>
                                <td><input name="StockIssuesItemVMs[@rowIndex].Qty" value="@item.Qty" class="form-control form-control-sm qty" /></td>
                                @if (businessType == 2)
                                {
                                    <td><input name="StockIssuesItemVMs[@rowIndex].TabletQty" value="@item.TabletQty" class="form-control form-control-sm tablet-qty" /></td>
                                }
                                <td><input name="StockIssuesItemVMs[@rowIndex].StripRate" value="@item.StripRate" class="form-control form-control-sm stripe-rate" /></td>
                                <td><input name="StockIssuesItemVMs[@rowIndex].Gst" value="@item.Gst" class="form-control form-control-sm gst" readonly /></td>
                                <td><input name="StockIssuesItemVMs[@rowIndex].Cess" value="@item.Cess" class="form-control form-control-sm cess" readonly /></td>
                                <td><input name="StockIssuesItemVMs[@rowIndex].Discount" value="@item.Discount" class="form-control form-control-sm discount" /></td>
                                <td><input name="StockIssuesItemVMs[@rowIndex].Amount" value="@item.Amount" class="form-control form-control-sm Amount" readonly /></td>
                                <td><u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u></td>
                            </tr>
                            rowIndex++;
                        }
                    }
                </tbody>
                <tfoot><tr><th colspan="12"><u id="addRow" style="color:green; cursor:pointer;">Add Row</u></th></tr></tfoot>
            </table>
        </div>

        <div class="row mt-3">
            <div class="col-md-7">
                <strong>Payment Details</strong>
                <table class="table table-bordered table-striped">
                    <thead class="table custom-header">
                        <tr><th style="min-width:30%">Payment Mode</th><th class="text-center">Amount</th><th class="text-center">Reference No</th><th class="text-center">Description</th><th></th></tr>
                    </thead>
                    <tbody id="PaymentDetailsBody">
                        @for (int i = 0; i < (Model.SalsePaymentDetails?.Count ?? 0); i++)
                        {
                            <tr>
                                <td hidden><input type="hidden" asp-for="@Model.SalsePaymentDetails[i].Id" /></td>
                                <td style="min-width:185px;">
                                    <select name="SalsePaymentDetails[@i].PaymentModeId" class="form-control form-control-sm paymentMode-dropdown">
                                        <option value="">Select</option>
                                        @foreach (var mode in paymentModes)
                                        {
                                            if (mode.Value == Model.SalsePaymentDetails[i].PaymentModeId.ToString())
                                            {
                                                <option value="@mode.Value" selected>@mode.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@mode.Value">@mode.Text</option>
                                            }
                                        }
                                    </select>
                                </td>
                                <td><input name="SalsePaymentDetails[@i].Amount" value="@Model.SalsePaymentDetails[i].Amount" class="form-control form-control-sm paymentAmount" /></td>
                                <td><input name="SalsePaymentDetails[@i].ReferenceNo" value="@Model.SalsePaymentDetails[i].ReferenceNo" class="form-control form-control-sm paymentReferenceNO" /></td>
                                <td><input name="SalsePaymentDetails[@i].Description" value="@Model.SalsePaymentDetails[i].Description" class="form-control form-control-sm paymentDescription" /></td>
                                <td><u class="remove-paymentrow-btn text-danger" style="cursor:pointer;">Remove</u></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th><u id="addPaymentRow" style="color:green; cursor:pointer;">Add Row</u></th></tr></tfoot>
                </table>

                <div class="row mt-2">
                    <div class="col-md-12">
                        <span class="fw-bold text-danger" style="font-size: xx-large;">Return Amount :</span>
                        <span id="returnAmountDisplay" class="return-amount">@(Model.ReturnAmount?.ToString("0.00") ?? "0.00")</span>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="row mb-2"><label asp-for="Total" class="col-md-3 col-form-label text-start small">Total</label><div class="col-md-4"></div><div class="col-md-4"><input asp-for="Total" class="form-control form-control-sm" readonly /></div></div>
                <div class="row mb-2"><label class="col-md-3 col-form-label text-start small">Bill Discount</label><div class="col-md-4"></div><div class="col-md-2"><input asp-for="discountPercent" id="discountPercent" class="form-control form-control-sm" /></div><div class="col-md-2"><input asp-for="discountAmount" id="discountamount" class="form-control form-control-sm" placeholder="amount" /></div></div>
                <div class="row mb-2"><label asp-for="Totaldiscount" class="col-md-3 col-form-label text-start small">Total Discount</label><div class="col-md-4"></div><div class="col-md-4"><input asp-for="Totaldiscount" id="Totaldiscount" class="form-control form-control-sm" readonly /></div></div>
                <div class="row mb-2"><label asp-for="TotalGstAmt" class="col-md-3 col-form-label text-start small">GST</label><div class="col-md-4"></div><div class="col-md-4"><input asp-for="TotalGstAmt" class="form-control form-control-sm" readonly /></div></div>
                <div class="row mb-2"><label asp-for="TotalCessAmount" class="col-md-3 col-form-label text-start small">Total Cess</label><div class="col-md-4"></div><div class="col-md-4"><input asp-for="TotalCessAmount" class="form-control form-control-sm" readonly /></div></div>
                <div class="row mb-2"><label asp-for="RoundOffAmount" class="col-md-3 col-form-label text-start small">Round Off</label><div class="col-md-4"></div><div class="col-md-4"><input asp-for="RoundOffAmount" id="roundOffAmount" class="form-control form-control-sm" readonly /></div></div>
                <div class="row mb-2"><label asp-for="TotalPayable" class="col-md-3 col-form-label text-start small">Total Amount</label><div class="col-md-4"></div><div class="col-md-4"><input asp-for="TotalPayable" id="totalPayable" class="form-control form-control-sm" readonly /></div></div>
                <div class="row mb-2"><label asp-for="PaidAmount" class="col-md-3 col-form-label text-start small">Paid Amount</label><div class="col-md-4"></div><div class="col-md-4"><input asp-for="PaidAmount" id="paidAmout" class="form-control form-control-sm" readonly /></div></div>
                <div class="row mb-2"><label asp-for="Balance" class="col-md-3 col-form-label text-start small">Balance</label><div class="col-md-4"></div><div class="col-md-4"><input asp-for="Balance" id="balance" class="form-control form-control-sm" readonly /></div></div>
           @*      <div class="row mb-2"><label asp-for="ReturnAmount" class="col-md-3 col-form-label text-start small">Return Amount</label><div class="col-md-4"></div><div class="col-md-4"><input asp-for="ReturnAmount" id="returnAmount" class="form-control form-control-sm" readonly /></div></div> *@
            </div>
        </div>

        <div class="mt-3 text-end">
            <button type="button" id="saveBtn" class="btn btn-sm btn-success">@(isEdit ? "End | Update" : "End | Save")</button>
            <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index"))" class="btn btn-sm btn-secondary">Cancel</a>
        </div>
    </div>
</form>

<!-- StockIssue Item Master F2/F3 popup host uses Sales embedded Item Master partial. -->
<div class="modal fade" id="itemMasterModal" tabindex="-1" data-bs-focus="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Item Master</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="itemMasterContainer">
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- StockIssue Item dropdown F2/F3 links use the same shortcut-link style as Sales/page.css. -->
                <div class="row align-items-center g-2 mb-2">
                    <div class="col-md-10">
                        <input type="text" id="itemSearch" class="form-control" placeholder="Search by item name..." />
                    </div>
                    <div class="col-md-2 ps-0">
                        <a href="javascript:void(0)" class="shortcut-link d-block small" id="btnNewItem">F2 - New</a>
                        <a href="javascript:void(0)" class="shortcut-link text-danger d-block small" id="btnModifyItem">F3 - Mod</a>
                    </div>
                </div>
                <div class="item-table-wrapper">
                    <table id="itemTable" class="table mb-0">
                        <thead>
                            <tr>
                                <th>Item Name</th>
                                @if (businessType == 2)
                                {
                                    <th style="display:none;">Qty</th>
                                    <th>Strip:Tabs</th>
                                }
                                else
                                {
                                    <th>Qty</th>
                                }
                            </tr>
                        </thead>
                        <tbody id="itemTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="batchModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Batch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="batch-table-wrapper">
                    <table id="batchTable" class="table mb-0">
                        <thead>
                            <tr>
                                <th>Batch</th>
                                <th>Expiry</th>
                                <th>Rate</th>
                                <th>MRP</th>
                                @if (businessType == 2)
                                {
                                    <th style="display:none;">Qty</th>
                                    <th>Strip:Tabs</th>
                                }
                                else
                                {
                                    <th>Qty</th>
                                }
                            </tr>
                        </thead>
                        <tbody id="batchTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="customerListModal" tabindex="-1" aria-labelledby="customerListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customerListModalLabel">Select Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <input type="text"
                           id="customerSearch"
                           class="form-control form-control-sm"
                           placeholder="Search by customer name or mobile no..." />
                </div>
                <div class="customer-table-wrapper">
                    <table id="customerTable" class="table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Customer Name</th>
                                <th>Mobile No</th>
                            </tr>
                        </thead>
                        <tbody id="customerTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createCustomerModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="newCustomerForm">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Create New Customer</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-2"><label class="form-label">Name *</label><input type="text" name="Name" class="form-control form-control-sm" required /></div>
                    <div class="mb-2"><label class="form-label">Mobile No *</label><input type="text" name="CustomerMobileNo" id="newCustomerMobile" class="form-control form-control-sm" readonly /></div>
                    <div class="mb-2"><label class="form-label">Address</label><input type="text" name="Address" class="form-control form-control-sm" /></div>
                </div>
                <div class="modal-footer"><button type="submit" class="btn btn-sm btn-success">Save Customer</button><button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button></div>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="createDoctorModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="newDoctorForm">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Create New Doctor</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-2"><label class="form-label small">Mobile No</label><input type="text" name="PhoneNo" id="newDoctorPhone" class="form-control form-control-sm" readonly /></div>
                    <div class="mb-2"><label class="form-label small">Doctor Name</label><input type="text" name="Name" class="form-control form-control-sm" placeholder="Doctor Name" required /></div>
                    <div class="mb-2"><label class="form-label small">Address</label><input type="text" name="Address" class="form-control form-control-sm" placeholder="Address" /></div>
                    <div class="mb-2"><label class="form-label small">Registration No</label><input type="text" name="RegistrationNo" class="form-control form-control-sm" placeholder="Registration No" /></div>
                    <div class="mb-2"><label class="form-label small">Specialization</label><input type="text" name="Specialized" class="form-control form-control-sm" placeholder="Specialization" /></div>
                    <div class="mb-2"><label class="form-label small">Commission %</label><input type="number" name="Commission" class="form-control form-control-sm" placeholder="0" /></div>
                </div>
                <div class="modal-footer"><button type="submit" class="btn btn-sm btn-success">Save</button><button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button></div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/payment-mode-popup.js"></script>
    
<!-- Pending Requests Modal -->
<div class="modal fade" id="pendingRequestsModal" tabindex="-1" aria-labelledby="pendingRequestsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pendingRequestsModalLabel">Pending Stock Requests</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-bordered table-hover mb-0" id="pendingRequestsTable">
                        <thead style="position: sticky; top: 0; background: #2465c7f7; color: white; z-index: 2;">
                            <tr>
                                <th>Req. No</th>
                                <th>Date</th>
                                <th>Requesting Branch</th>
                                <th>Total Qty</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Rows loaded via AJAX -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
        const isEditMode = @Html.Raw((isEdit ? "true" : "false"));
        const stockIssueId = @Model.Id;
        const businessType = @businessType;
        const paymentModeOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(paymentModes.Select(x => new { value = x.Value, text = x.Text })));
        let rowIndex = $("#StockIssueItemBody tr").length;
        let paymentRowIndex = $("#PaymentDetailsBody tr").length;
        let currentRow = null;
        let currentItemIndex = -1;
        let currentBatchIndex = -1;
        let isTabletWiseMode = false;
        let availableItemsCache = [];
        let isSubmittingStockIssue = false;
        let customerLookupTimer = null;
        let isCustomerLookupInProgress = false;
        let lastLookedUpCustomerMobile = "";
        let lastResolvedCustomerMobile = "";
        let lastCustomerNotFoundPromptMobile = "";
        let currentCustomerIndex = -1;
        let customerNavMode = "keyboard";
        let isKeyboardScrollingCustomerModal = false;
        const itemConversionMap = {};
        window.stopAutoItemOpen = false;
        window.suppressNextBatchNotFound = false;

        function showLoader(message = "Loading...") {
            $("#globalLoader .loader-text").text(message);
            $("#globalLoader").css("display", "flex");
        }

        function hideLoader() {
            $("#globalLoader").hide();
        }

        function isValidIndianMobile(mobile) {
            return /^[6-9][0-9]{9}$/.test(mobile || "");
        }

        function normalizeDateDisplay(dateValue) {
            if (!dateValue) return "";
            const date = new Date(dateValue);
            if (Number.isNaN(date.getTime())) return "";
            return ("0" + (date.getMonth() + 1)).slice(-2) + "/" + date.getFullYear();
        }

        function renderPaymentOptions(selectedValue = "") {
            let html = '<option value="">-- Select --</option>';
            paymentModeOptions.forEach(option => {
                const selected = String(selectedValue) === String(option.value) ? "selected" : "";
                html += `<option value="${option.value}" ${selected}>${option.text}</option>`;
            });
            return html;
        }

        function getItemsEndpoint() {
            return isEditMode ? `/StockIssue/GetAllItemsForEdit?stockIssueId=${stockIssueId}` : '/StockIssue/GetAllItems';
        }

        function getBatchesEndpoint(itemId) {
            return isEditMode
                ? `/StockIssue/GetBatchesByItemIdForEdit?id=${itemId}&stockIssueId=${stockIssueId}`
                : `/StockIssue/GetBatchesByItemId?id=${itemId}`;
        }

        function updatePaymentTypeUi(type) {
            const isCredit = (type || "").toLowerCase() === "credit";
            $("#paymentToggle").prop("checked", isCredit);
            $("#paymentToggleLabel").text(isCredit ? "Credit" : "Cash");
            $("#paymentToggleLabel").css("color", isCredit ? "#b8860b" : "green");
            $("#paymentTypeHidden").val(isCredit ? "credit" : "cash");
        }

        function showBillingTypePicker() {
            const select = document.getElementById("billingType");
            if (!select) {
                return;
            }

            setTimeout(() => {
                if ("showPicker" in HTMLSelectElement.prototype) {
                    select.showPicker();
                } else {
                    $(select).trigger("click");
                }
            }, 50);
        }

        function showSelectPicker(selector) {
            const select = $(selector).get(0);
            if (!select) {
                return;
            }

            setTimeout(() => {
                if ("showPicker" in HTMLSelectElement.prototype) {
                    select.showPicker();
                } else {
                    $(select).trigger("click");
                }
            }, 50);
        }

        function isValidCustomerName(name) {
            if (!name) return false;
            const trimmedName = name.trim();
            if (trimmedName.length < 3 || trimmedName.length > 150) {
                return false;
            }

            return /^(?!\s)(?!.*\s$).+$/.test(trimmedName);
        }

        // Mirror Sales-style focus recovery while keeping StockIssue-specific bindings unchanged.
        function focusElement(selector, shouldSelect = true, delay = 120) {
            setTimeout(() => {
                const $element = $(selector).filter(":visible:not([disabled])").first();
                if (!$element.length) {
                    return;
                }

                $element.trigger("focus");
                if (shouldSelect && typeof $element[0]?.select === "function") {
                    $element[0].select();
                }
            }, delay);
        }

        function focusFirstFieldInModal(modalSelector) {
            setTimeout(() => {
                const $modal = $(modalSelector);
                if (!$modal.hasClass("show")) {
                    return;
                }

                const $firstEditable = $modal
                    .find("input:visible:not([type='hidden']):not([readonly]):not([disabled]), select:visible:not([disabled]), textarea:visible:not([disabled])")
                    .first();

                if ($firstEditable.length) {
                    $firstEditable.trigger("focus");
                    if (typeof $firstEditable[0]?.select === "function") {
                        $firstEditable[0].select();
                    }
                    return;
                }

                const $firstTabStop = $modal.find("[tabindex]:visible:not([disabled])").first();
                if ($firstTabStop.length) {
                    $firstTabStop.trigger("focus");
                }
            }, 150);
        }

        function focusNextItemRowOrAdd(fromRow) {
            const $currentRow = fromRow instanceof jQuery ? fromRow : $(fromRow);
            const $nextRow = $currentRow.next("tr");

            if ($nextRow.length) {
                focusElement($nextRow.find(".item-input"), true, 50);
                return;
            }

            addNewRow();
            focusElement("#StockIssueItemBody tr:last .item-input", true, 120);
        }

        function focusItemGrid() {
            setTimeout(() => {
                let firstItem = $("#StockIssueItemBody tr:first .item-input");
                if (!firstItem.length) {
                    addNewRow();
                    firstItem = $("#StockIssueItemBody tr:first .item-input");
                }

                firstItem.focus().select();
            }, 150);
        }

        function getItemRowState(row) {
            return {
                itemName: (row.find(".item-input").val() || "").trim(),
                batch: (row.find(".batch").val() || "").trim(),
                qty: parseFloat(row.find(".qty").val()) || 0,
                tabletQty: parseFloat(row.find(".tablet-qty").val()) || 0,
                stripRate: parseFloat(row.find(".stripe-rate").val()) || 0,
                discount: parseFloat(row.find(".discount").val()) || 0,
                amount: parseFloat(row.find(".Amount").val()) || 0
            };
        }

        function isBlankItemRowState(state) {
            return !state.itemName &&
                !state.batch &&
                state.qty === 0 &&
                state.tabletQty === 0 &&
                state.stripRate === 0 &&
                state.discount === 0 &&
                state.amount === 0;
        }

        function isRowQuantityValid(state) {
            if (businessType === 2 && isTabletWiseMode) {
                return state.qty > 0 || state.tabletQty > 0;
            }

            return state.qty >= 1;
        }

        function findAnotherCompletedRow(currentRow) {
            let hasCompletedRow = false;

            $("#StockIssueItemBody tr").each(function () {
                const $row = $(this);
                if ($row.is(currentRow)) {
                    return;
                }

                const state = getItemRowState($row);
                if (state.itemName && state.batch) {
                    hasCompletedRow = true;
                    return false;
                }
            });

            return hasCompletedRow;
        }

        function focusDiscountSummary() {
            setTimeout(() => {
                $("#discountPercent").focus().select();
            }, 50);
        }

        function focusRowTarget(target) {
            if (!target || !target.length) {
                return;
            }

            target.focus();
            if (typeof target[0]?.select === "function") {
                target[0].select();
            }
        }

        function removeBlankItemRow(row) {
            row.remove();
            reindexItemRows();
            calculateTotal();
        }

        function validateItemRowForAdvance(row) {
            const state = getItemRowState(row);

            if (isBlankItemRowState(state)) {
                return { status: "blank" };
            }

            if (!state.itemName || !state.batch) {
                return {
                    status: "incomplete",
                    message: "Please select item and batch before moving forward.",
                    focusTarget: row.find(".item-input")
                };
            }

            if (businessType === 2 && isTabletWiseMode) {
                if (state.qty === 0 && state.tabletQty === 0) {
                    return {
                        status: "invalidQty",
                        message: "Please enter quantity or tablet quantity.",
                        focusTarget: row.find(".tablet-qty")
                    };
                }

                if (state.qty < 0 || state.tabletQty < 0) {
                    return {
                        status: "invalidQty",
                        message: "Quantity cannot be negative.",
                        focusTarget: state.qty < 0 ? row.find(".qty") : row.find(".tablet-qty")
                    };
                }
            } else if (state.qty < 1) {
                return {
                    status: "invalidQty",
                    message: "Quantity cannot be less than 1.",
                    focusTarget: row.find(".qty")
                };
            }

            return { status: "valid" };
        }

        function handleItemRowTab(row) {
            const validation = validateItemRowForAdvance(row);

            if (validation.status === "blank") {
                if (!findAnotherCompletedRow(row)) {
                    toastr.error("At least one item row is required. Please add item before moving forward.", "Validation Error");
                    row.find(".item-input").focus().select();
                    return;
                }

                removeBlankItemRow(row);
                focusDiscountSummary();
                return;
            }

            if (validation.status !== "valid") {
                toastr.warning(validation.message, validation.status === "incomplete" ? "Incomplete Row" : "Invalid Quantity");
                focusRowTarget(validation.focusTarget);
                return;
            }

            focusDiscountSummary();
        }

        function advanceAfterDiscount(row) {
            const validation = validateItemRowForAdvance(row);

            if (validation.status !== "valid") {
                const title = validation.status === "incomplete" ? "Incomplete Row" : "Invalid Quantity";
                const message = validation.status === "blank"
                    ? "Please add item details before moving forward."
                    : validation.message;

                toastr.warning(message, title);
                const focusTarget = validation.status === "blank" ? row.find(".item-input") : validation.focusTarget;
                focusRowTarget(focusTarget);
                return;
            }

            const isLastRow = row.is("#StockIssueItemBody tr:last");

            if (isLastRow) {
                addNewRow();
                focusElement("#StockIssueItemBody tr:last .item-input", true, 150);
                return;
            }

            focusElement(row.next("tr").find(".item-input"), true, 50);
        }

        function pruneBlankItemRows() {
            $("#StockIssueItemBody tr").each(function () {
                const $row = $(this);
                if (!isBlankItemRowState(getItemRowState($row))) {
                    return;
                }

                removeBlankItemRow($row);
            });
        }

        function pruneBlankPaymentRows() {
            $("#PaymentDetailsBody tr").each(function () {
                const $row = $(this);
                const paymentMode = ($row.find(".paymentMode-dropdown").val() || "").toString().trim();
                const amount = parseFloat($row.find(".paymentAmount").val()) || 0;
                const referenceNo = ($row.find(".paymentReferenceNO").val() || "").trim();
                const description = ($row.find(".paymentDescription").val() || "").trim();

                if (paymentMode || amount > 0 || referenceNo || description) {
                    return;
                }

                $row.remove();
            });

            reindexPaymentRows();
        }

        function normalizeNumericInputsForSubmit() {
            const selectors = [
                "#discountPercent",
                "#discountamount",
                "#Total",
                "#Totaldiscount",
                "#totalPayable",
                "#paidAmout",
                "#balance",
                "#roundOffAmount",
                "[name='Total']",
                "[name='TotalGstAmt']",
                "[name='TotalCessAmount']",
                "[name='TotalPayable']",
                "[name='Totaldiscount']",
                "[name='PaidAmount']",
                "[name='Balance']",
                "[name='RoundOffAmount']",
                ".qty",
                ".tablet-qty",
                ".rate",
                ".stripe-rate",
                ".gst",
                ".cess",
                ".discount",
                ".Amount",
                ".mrp",
                ".paymentAmount"
            ];

            $(selectors.join(", ")).each(function () {
                const $input = $(this);
                if (!$input.length || $input.is(":disabled")) {
                    return;
                }

                const value = ($input.val() || "").toString().trim();
                if (!value) {
                    $input.val("0");
                }
            });
        }

        function clearCustomerSelection(preserveMobile = true) {
            const currentMobile = $("#mobilenumber").val();
            $("#CustomerId").val("");
            $("#customer, #customeraddress").val("");
            $("#balanceLabel, #balanceField").addClass("d-none");
            $("#previousBalance").val("");
            lastResolvedCustomerMobile = "";

            if (preserveMobile) {
                $("#mobilenumber").val(currentMobile);
            }
        }

        function updateItemModeUi() {
            if (businessType !== 2) {
                $("#qtyView").text("Qty");
                return;
            }

            $("#qtyView").text(isTabletWiseMode ? "Strip" : "Qty");
            $("#qtyTabsView").text("Tabs");
        }

        function applyTabletWiseMode(row) {
            if (businessType !== 2) {
                return;
            }

            const qtyInput = row.find(".qty");
            const tabletQtyInput = row.find(".tablet-qty");

            if (!tabletQtyInput.length) {
                return;
            }

            if (isTabletWiseMode) {
                qtyInput.prop("readonly", true).css("background-color", "#e9ecef");
                tabletQtyInput.prop("readonly", false).css("background-color", "#fff");
            } else {
                qtyInput.prop("readonly", false).css("background-color", "#fff");
                tabletQtyInput.prop("readonly", true).val("0").css("background-color", "#e9ecef");
            }
        }

        function syncRateFromStripRate(row) {
            const stripRate = parseFloat(row.find(".stripe-rate").val()) || 0;
            const itemId = row.find(".item-id").val();
            let conversion = parseFloat(row.attr("data-conversion")) || 0;

            if (!conversion || conversion <= 0) {
                conversion = parseFloat(itemConversionMap[itemId]) || 1;
            }

            const actualRate = (businessType === 2 && isTabletWiseMode)
                ? stripRate / conversion
                : stripRate;

            row.find(".rate").val(actualRate.toFixed(4));
        }

        function lookupCustomerByMobile(mobile, options = {}) {
            const settings = {
                focusAfterSuccess: false,
                showSuccessToast: true,
                promptOnMissing: true,
                force: false,
                ...options
            };

            const trimmedMobile = (mobile || "").trim();

            if ($("#billingType").val() !== "registered") {
                return;
            }

            if (!isValidIndianMobile(trimmedMobile)) {
                if (settings.force) {
                    toastr.error("Enter valid 10 digit mobile number.");
                    $("#mobilenumber").focus().select();
                }
                return;
            }

            if (isCustomerLookupInProgress && !settings.force) {
                return;
            }

            if (!settings.force && trimmedMobile === lastResolvedCustomerMobile && $("#CustomerId").val()) {
                return;
            }

            if (!settings.force && trimmedMobile === lastLookedUpCustomerMobile && !$("#CustomerId").val()) {
                return;
            }

            isCustomerLookupInProgress = true;
            lastLookedUpCustomerMobile = trimmedMobile;
            showLoader("Checking customer...");

            $.get('/StockIssue/GetByMobile', { mobile: trimmedMobile }, function (res) {
                hideLoader();

                if (res.success) {
                    $("#CustomerId").val(res.customerId);
                    $("#customer").val(res.name);
                    $("#customeraddress").val(res.address);
                    loadPreviousBalance(res.customerId);
                    lastResolvedCustomerMobile = trimmedMobile;
                    lastCustomerNotFoundPromptMobile = "";

                    if (settings.showSuccessToast) {
                        toastr.success("Customer found and auto-filled.");
                    }

                    if (settings.focusAfterSuccess) {
                        focusElement("#customer");
                    }
                    return;
                }

                clearCustomerSelection();

                if (!settings.promptOnMissing || lastCustomerNotFoundPromptMobile === trimmedMobile) {
                    return;
                }

                lastCustomerNotFoundPromptMobile = trimmedMobile;
                Swal.fire({
                    title: 'Customer not found',
                    text: 'Do you want to create a new customer?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#createCustomerModal').modal('show');
                        $('#newCustomerMobile').val(trimmedMobile);
                    }
                });
            }).fail(function () {
                hideLoader();
                toastr.error("Unable to find customer.");
            }).always(function () {
                isCustomerLookupInProgress = false;
            });
        }

        function applyBillingType(type) {
            if (type === "registered") {
                $("#mobilenumber, #customer, #customeraddress").prop("disabled", false).removeClass("bg-light");
                updatePaymentTypeUi("credit");
                if ($("#CustomerId").val()) {
                    loadPreviousBalance($("#CustomerId").val());
                }
            } else {
                $("#mobilenumber, #customer, #customeraddress").prop("disabled", true).addClass("bg-light");
                $("#mobilenumber, #customer, #customeraddress").val("");
                $("#CustomerId").val("");
                $("#balanceLabel, #balanceField").addClass("d-none");
                $("#previousBalance").val("");
                clearTimeout(customerLookupTimer);
                lastLookedUpCustomerMobile = "";
                lastResolvedCustomerMobile = "";
                lastCustomerNotFoundPromptMobile = "";
                updatePaymentTypeUi("cash");
            }
        }

        function loadPreviousBalance(customerId) {
            if (!customerId) {
                $("#balanceLabel, #balanceField").addClass("d-none");
                $("#previousBalance").val("");
                return;
            }

            $.get('/StockIssue/GetCustomerBalance', { customerId: customerId }, function (res) {
                if (res.success && res.balance > 0) {
                    $("#previousBalance").val(Number(res.balance).toFixed(2));
                    $("#balanceLabel, #balanceField").removeClass("d-none");
                } else {
                    $("#balanceLabel, #balanceField").addClass("d-none");
                    $("#previousBalance").val("");
                }
            });
        }

        $(document).on("click", "#btnF1CustomerList", function (e) {
            e.preventDefault();

            showLoader("Loading customers...");

            $.get('/Sales/GetCustomer', function (res) {
                hideLoader();

                if (!res.found || !res.data || res.data.length === 0) {
                    toastr.info("No customer found.");
                    return;
                }

                let rows = "";

                res.data.forEach(customer => {
                    const customerId = customer.id || customer.Id || "";
                    const customerName = customer.name || customer.Name || "";
                    const mobileNo = customer.phoneNo || customer.PhoneNo || "";
                    const address = customer.address || customer.Address || "";

                    rows += `<tr class="customer-row" tabindex="0"
                        data-customerid="${customerId}"
                        data-name="${customerName}"
                        data-phone="${mobileNo}"
                        data-address="${address}">
                        <td>${customerName}</td>
                        <td>${mobileNo}</td>
                    </tr>`;
                });

                $("#customerTableBody").html(rows);
                $("#customerSearch").val("");
                currentCustomerIndex = -1;
                $("#customerListModal").modal("show");
            }).fail(function () {
                hideLoader();
                toastr.error("Error loading customers");
            });
        });

        $(document).on("keydown", "#mobilenumber", function (e) {
            if (e.key !== "F1") return;

            e.preventDefault();
            e.stopImmediatePropagation();

            $("#btnF1CustomerList").trigger("click");
        });

        $(document).on("input", "#customerSearch", function () {
            const searchText = $(this).val().toLowerCase().trim();

            $("#customerTableBody tr").each(function () {
                const customerName = ($(this).data("name") || "").toString().toLowerCase();
                const mobileNo = ($(this).data("phone") || "").toString().toLowerCase();

                $(this).toggle(customerName.includes(searchText) || mobileNo.includes(searchText));
            });

            currentCustomerIndex = -1;
            $("#customerTableBody .customer-row").removeClass("selected");
        });

        $(document).on("keydown", function (e) {
            if (!$("#customerListModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                customerNavMode = "keyboard";
                isKeyboardScrollingCustomerModal = true;
                $("#customerListModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".customer-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentCustomerIndex === -1) {
                    currentCustomerIndex = 0;
                }
                else if (currentCustomerIndex < $rows.length - 1) {
                    currentCustomerIndex++;
                }

                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();

                if (currentCustomerIndex <= 0) return;

                currentCustomerIndex--;

                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
            else if (e.key === "Enter") {
                e.preventDefault();

                if (currentCustomerIndex === -1) {
                    currentCustomerIndex = 0;
                }

                $rows.eq(currentCustomerIndex).trigger("click");
            }
        });

        $(document).on("click", ".customer-row", function (e) {
            e.preventDefault();

            const customerId = $(this).data("customerid");
            const customerName = $(this).data("name") || "";
            const mobileNo = $(this).data("phone") || "";
            const address = $(this).data("address") || "";

            $("#billingType").val("registered");
            $("#mobilenumber, #customer, #customeraddress").prop("disabled", false).removeClass("bg-light");
            $("#CustomerId").val(customerId);
            $("#mobilenumber").val(mobileNo);
            $("#customer").val(customerName);
            $("#customeraddress").val(address);

            lastLookedUpCustomerMobile = mobileNo;
            lastResolvedCustomerMobile = mobileNo;
            lastCustomerNotFoundPromptMobile = "";

            loadPreviousBalance(customerId);
            $("#mobileError").text("");
            $("#customerListModal").modal("hide");

            setTimeout(() => {
                $("#customer").focus().select();
            }, 150);
        });

        $(document).on("mouseenter", ".customer-row", function () {
            if (!$("#customerListModal").is(":visible")) return;
            if (isKeyboardScrollingCustomerModal) return;

            customerNavMode = "mouse";

            $("#customerListModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".customer-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

