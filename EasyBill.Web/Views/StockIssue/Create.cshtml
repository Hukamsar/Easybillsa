        $(document).on("keydown",
            ".paymentMode-dropdown, .paymentAmount, .paymentReferenceNO, .paymentDescription",
            function (e) {
                const row = $(this).closest("tr");
                const input = $(this);

                const isMode = input.hasClass("paymentMode-dropdown");
                const isAmount = input.hasClass("paymentAmount");
                const isRef = input.hasClass("paymentReferenceNO");
                const isDesc = input.hasClass("paymentDescription");

                if (e.key === "Enter") {
                    e.preventDefault();
                    e.stopImmediatePropagation();

                    const paymentMode = row.find(".paymentMode-dropdown").val();
                    if (!paymentMode) {
                        row.find(".paymentMode-dropdown").focus();
                        return;
                    }

                    if (isMode) {
                        row.find(".paymentAmount").focus().select();
                        return;
                    }

                    if (isAmount) {
                        if (!(input.val() || "").toString().trim()) {
                            input.val("0");
                        }

                        row.find(".paymentReferenceNO").focus();
                        return;
                    }

                    if (isRef) {
                        row.find(".paymentDescription").focus();
                        return;
                    }

                    if (isDesc) {
                        const isLastRow = row.is("#PaymentDetailsBody tr:last");
                        if (!isLastRow) {
                            return;
                        }

                        const amountInput = row.find(".paymentAmount");
                        const amountVal = parseFloat(amountInput.val()) || 0;
                        if (amountVal <= 0) {
                            amountInput.focus().select();
                            return;
                        }

                        addPaymentRow("", "0");
                        setTimeout(() => {
                            $("#PaymentDetailsBody tr:last .paymentMode-dropdown").focus();
                        }, 150);
                    }
                }

                if (e.key === "ArrowRight") {
                    e.preventDefault();
                    if (isMode) row.find(".paymentAmount").focus();
                    else if (isAmount) row.find(".paymentReferenceNO").focus();
                    else if (isRef) row.find(".paymentDescription").focus();
                }

                if (e.key === "ArrowLeft") {
                    e.preventDefault();
                    if (isDesc) row.find(".paymentReferenceNO").focus();
                    else if (isRef) row.find(".paymentAmount").focus();
                    else if (isAmount) row.find(".paymentMode-dropdown").focus();
                }

                if (e.key === "ArrowDown") {
                    e.preventDefault();
                    const next = row.next("tr");
                    if (!next.length) return;

                    if (isMode) next.find(".paymentMode-dropdown").focus();
                    else if (isAmount) next.find(".paymentAmount").focus();
                    else if (isRef) next.find(".paymentReferenceNO").focus();
                    else if (isDesc) next.find(".paymentDescription").focus();
                }

                if (e.key === "ArrowUp") {
                    e.preventDefault();
                    const prev = row.prev("tr");
                    if (!prev.length) return;

                    if (isMode) prev.find(".paymentMode-dropdown").focus();
                    else if (isAmount) prev.find(".paymentAmount").focus();
                    else if (isRef) prev.find(".paymentReferenceNO").focus();
                    else if (isDesc) prev.find(".paymentDescription").focus();
                }
            }
        );
