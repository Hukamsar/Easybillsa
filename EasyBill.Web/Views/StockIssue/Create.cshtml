                }
            }

            $('input[name="IssueToType"]').on('change', toggleIssueType);
            toggleIssueType(); // Initialize
        });
    </script>
}

    <script>
        $(document).ready(function() {
            $('#btnShowPendingRequests').click(function() {
                showLoader();
                $.ajax({
                    url: '/StockIssue/GetPendingIncomingRequests',
                    type: 'GET',
                    success: function(res) {
                        hideLoader();
                        if (res.success && res.data.length > 0) {
                            let rows = '';
                            res.data.forEach(function(req) {
                                let date = new Date(req.billDate).toLocaleDateString();
                                rows += `<tr>
                                    <td>${req.billNo}</td>
                                    <td>${date}</td>
                                    <td>${req.requesterName}</td>
                                    <td>${req.totalQty}</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-success btn-select-request" 
                                            data-id="${req.id}" 
                                            data-tenantid="${req.requesterTenantId}">
                                            Select
                                        </button>
                                    </td>
                                </tr>`;
                            });
                            $('#pendingRequestsTable tbody').html(rows);
                            $('#pendingRequestsModal').modal('show');
                        } else {
                            toastr.info('No pending requests found.');
                        }
                    },
                    error: function(err) {
                          hideLoader();
                          toastr.error('Failed to load pending requests. Status: ' + err.status);
                          console.error(err);
                      }
                });
            });

            $(document).on('click', '.btn-select-request', function() {
                let reqId = $(this).data('id');
                let targetTenantId = $(this).data('tenantid');
                
                $('#StockRequestId').val(reqId);
                $('#TransferToTenantId').val(targetTenantId);
                $('#pendingRequestsModal').modal('hide');
                
                showLoader();
                $.ajax({
                    url: '/StockIssue/GetRequestDetails/' + reqId,
                    type: 'GET',
                    success: function(res) {
                        hideLoader();
                        if (res.success) {
                            // Clear existing rows
                            $('#StockIssueItemBody tr').remove();
                            rowIndex = 0; // Reset index to ensure sequential binding
                            
                            // Populate grid
                            res.data.forEach(function(item) {
                                if(typeof addNewRow === 'function') {
                                    addNewRow();
                                    let lastRow = $('#StockIssueItemBody tr:last');
                                    lastRow.find('.item-input').val(item.itemName || item.ItemName || "");
                                    lastRow.find('.item-id').val(item.itemId || item.ItemId || 0);
                                    lastRow.find('.qty').val(item.qty || item.Qty || 0).trigger('change');
                                    // Also set MRP and Rate if needed
                                    lastRow.find('.mrp').val(item.mrp || item.Mrp || 0);
                                    lastRow.find('.rate').val(item.purchaseRate || item.PurchaseRate || 0);
                                }
                            });
                            toastr.success('Stock Request items loaded successfully.');
                        }
                    },
                    error: function(err) {
                          hideLoader();
                          toastr.error('Failed to load request details. Status: ' + err.status);
                          console.error(err);
                      }
                });
            });
        });
    </script>
