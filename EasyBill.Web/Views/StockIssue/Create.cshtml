        $(document).on("input", ".qty, .discount, .mrp", function () {
            calculateRow($(this).closest("tr"));
        });

        $(document).on("input", ".stripe-rate", function () {
            const row = $(this).closest("tr");
            syncRateFromStripRate(row);
            calculateRow(row);
        });

        $(document).on("input", ".tablet-qty", function () {
            const row = $(this).closest("tr");

            if (!isTabletWiseMode) {
                calculateRow(row);
                return;
            }

            const itemId = row.find(".item-id").val();
            let conversion = parseFloat(row.attr("data-conversion"));

            if (!conversion || conversion <= 0) {
                conversion = parseFloat(itemConversionMap[itemId]) || 1;
            }

            const tabletQty = parseFloat($(this).val()) || 0;
            row.find(".qty").val(Math.floor(tabletQty / conversion));
            calculateRow(row);
        });

        $(document).on("blur", ".tablet-qty", function () {
            if (!isTabletWiseMode) {
                return;
            }

            const row = $(this).closest("tr");
            const itemId = row.find(".item-id").val();
            let conversion = parseFloat(row.attr("data-conversion"));

            if (!conversion || conversion <= 0) {
                conversion = parseFloat(itemConversionMap[itemId]) || 1;
            }

            const tabletQty = parseFloat($(this).val()) || 0;
            $(this).val(tabletQty % conversion);
