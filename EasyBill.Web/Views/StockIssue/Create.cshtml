        function getRowCalculationData(row) {
            const qty = parseFloat(row.find(".qty").val()) || 0;
            const tabletQty = parseFloat(row.find(".tablet-qty").val()) || 0;
            const stripRate = parseFloat(row.find(".stripe-rate").val()) || 0;
            const gst = parseFloat(row.find(".gst").val()) || 0;
            const cess = parseFloat(row.find(".cess").val()) || 0;
            const discount = parseFloat(row.find(".discount").val()) || 0;
            const conversion = parseFloat(row.attr("data-conversion")) || 1;
            const taxCalculation = $("#taxCalculation").val();

            let grossAmount = qty * stripRate;
            if (businessType === 2 && isTabletWiseMode === true) {
                const totalTablets = (qty * conversion) + tabletQty;
                grossAmount = (totalTablets / conversion) * stripRate;
            }

            const discountAmt = (grossAmount * discount) / 100;
            const amountAfterDiscount = grossAmount - discountAmt;
            const gstAmt = taxCalculation === "No" ? 0 : (amountAfterDiscount * gst) / 100;
            const cessAmt = taxCalculation === "No" ? 0 : (amountAfterDiscount * cess) / 100;

            return { gst, cess, discountAmt, amountAfterDiscount, gstAmt, cessAmt, total: amountAfterDiscount + gstAmt + cessAmt };
        }

        function calculateRow(row) {
            const data = getRowCalculationData(row);
            row.find(".Amount").val(data.total.toFixed(2));
            calculateTotal();
        }

        function calculateTotal() {
            let total = 0, totalGst = 0, totalCess = 0, totalDiscount = 0;
            const gstRows = [];

            $("#StockIssueItemBody tr").each(function () {
                const row = $(this);
                const data = getRowCalculationData(row);
                total += data.amountAfterDiscount;
                totalGst += data.gstAmt;
                totalCess += data.cessAmt;
                totalDiscount += data.discountAmt;
                gstRows.push({ rate: data.amountAfterDiscount, gst: data.gst, cess: data.cess });
            });

            let percentInput = parseFloat($("#discountPercent").val()) || 0;
            let amountInput = parseFloat($("#discountamount").val()) || 0;
            let globalDiscountPercent = 0;
            let globalDiscountAmt = 0;

            if ($("#discountPercent").is(":focus") || (percentInput > 0 && amountInput === 0)) {
                globalDiscountPercent = percentInput;
                globalDiscountAmt = (total * globalDiscountPercent) / 100;
                $("#discountamount").val(globalDiscountAmt.toFixed(2));
            } else if ($("#discountamount").is(":focus") || (amountInput > 0 && percentInput === 0)) {
                globalDiscountAmt = amountInput;
                globalDiscountPercent = total > 0 ? (globalDiscountAmt / total) * 100 : 0;
                $("#discountPercent").val(globalDiscountPercent.toFixed(2));
            } else if (percentInput > 0 && amountInput > 0) {
                globalDiscountPercent = percentInput;
                globalDiscountAmt = amountInput;
            }

            let totalAfterGlobalDiscount = total - globalDiscountAmt;
            if (globalDiscountAmt > 0) {
                totalDiscount += globalDiscountAmt;
                totalGst = 0;
                totalCess = 0;
                gstRows.forEach(row => {
                    const rowDiscountAmt = (row.rate * globalDiscountPercent) / 100;
                    const rowAfterGlobalDiscount = row.rate - rowDiscountAmt;
                    const gstAmt = $("#taxCalculation").val() === "No" ? 0 : (rowAfterGlobalDiscount * row.gst) / 100;
                    const cessAmt = $("#taxCalculation").val() === "No" ? 0 : (rowAfterGlobalDiscount * row.cess) / 100;
                    totalGst += gstAmt;
                    totalCess += cessAmt;
                });
            }

            totalAfterGlobalDiscount = Math.max(0, totalAfterGlobalDiscount);
            const totalPayable = totalAfterGlobalDiscount + totalGst + totalCess;
            const roundedPayable = Math.round(totalPayable);
            const roundOffAmount = Number((roundedPayable - totalPayable).toFixed(2));
            let paidAmount = 0;
            $(".paymentAmount").each(function () { paidAmount += parseFloat($(this).val()) || 0; });
            let balance = 0, returnAmount = 0;
            if (paidAmount > roundedPayable) { returnAmount = paidAmount - roundedPayable; } else { balance = roundedPayable - paidAmount; }

            $("[name='Total']").val(totalAfterGlobalDiscount.toFixed(2));
            $("[name='TotalGstAmt']").val(totalGst.toFixed(2));
            $("[name='TotalCessAmount']").val(totalCess.toFixed(2));
            $("[name='Totaldiscount']").val(totalDiscount.toFixed(2));
            $("[name='TotalPayable']").val(roundedPayable.toFixed(2));
            $("[name='RoundOffAmount']").val(roundOffAmount.toFixed(2));
            $("#paidAmout").val(paidAmount.toFixed(2));
            $("#balance").val(balance.toFixed(2));
            $("#returnAmount").val(returnAmount.toFixed(2));
            $("#returnAmountDisplay").text(returnAmount.toFixed(2));
        }

        function validateForm() {
            pruneBlankItemRows();
            pruneBlankPaymentRows();

            const billingType = $("#billingType").val();
            const mobile = ($("#mobilenumber").val() || "").trim();

            const issueToType = $('input[name="IssueToType"]:checked').val();

            if (billingType === "registered" && issueToType !== "Branch") {
                if (!mobile) {
                    toastr.error("Mobile number is required.");
                    $("#mobilenumber").focus().select();
                    return false;
                }

                if (!isValidIndianMobile(mobile)) {
                    toastr.error("Please enter a valid 10-digit mobile number.");
                    $("#mobilenumber").focus().select();
                    return false;
                }

                if (!$("#CustomerId").val()) {
                    toastr.error("Please select a valid customer.");
                    $("#customer").focus().select();
                    return false;
                }
            }

            if (issueToType === "Branch") {
                if (!$("#TransferToTenantId").val()) {
                    toastr.error("Please select a branch to transfer stock.");
                    $("#TransferToTenantId").focus();
                    return false;
                }
            }

            let hasValidItemRow = false;
            let firstInvalidQtyRow = null;
            let firstIncompleteRow = null;

            $("#StockIssueItemBody tr").each(function () {
                const row = $(this);
                const validation = validateItemRowForAdvance(row);

                if (validation.status === "blank") {
                    return;
                }

                if (validation.status === "incomplete" && !firstIncompleteRow) {
                    firstIncompleteRow = row;
                    return;
                }

                if (validation.status === "invalidQty" && !firstInvalidQtyRow) {
                    firstInvalidQtyRow = row;
                    return;
                }

                hasValidItemRow = true;
            });

            if (firstIncompleteRow) {
                toastr.error("Please select batch for all items or remove incomplete rows.", "Incomplete Item Row");
                firstIncompleteRow.find(".item-input").focus().select();
                return false;
            }

            if (firstInvalidQtyRow) {
                const validation = validateItemRowForAdvance(firstInvalidQtyRow);
                toastr.error(validation.message, "Invalid Quantity");
                focusRowTarget(validation.focusTarget);
                return false;
            }

            if (!hasValidItemRow) {
                toastr.error("Please add at least one item with quantity before saving.", "Item Required");
                focusItemGrid();
                return false;
            }

            let paymentValid = true;
            $("#PaymentDetailsBody tr").each(function () {
                const amount = parseFloat($(this).find(".paymentAmount").val()) || 0;
                const paymentMode = $(this).find(".paymentMode-dropdown").val();
                if (amount > 0 && !paymentMode) {
                    paymentValid = false;
                    $(this).find(".paymentMode-dropdown").focus();
                    return false;
                }
            });

            if (!paymentValid) {
                toastr.error("Please select payment mode for entered payment amount.");
                return false;
            }

            return true;
        }

