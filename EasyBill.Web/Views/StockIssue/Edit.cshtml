            }, 200);
        });

        $(document).on("input", "#itemSearch", function () { const sw = $(this).val().toLowerCase(); $("#itemTableBody tr").each(function () { $(this).toggle($(this).text().toLowerCase().indexOf(sw) > -1); }); currentItemIndex = -1; });

        // Item Modal Navigation
        $(document).on("keydown", function (e) {
            if (!$("#itemModal").is(":visible") || $("#itemMasterModal").is(":visible")) return;
            if (e.key === "F2") {
                e.preventDefault();
                e.stopPropagation();
                $("#btnNewItem").trigger("click");
                return;
            }
            if (e.key === "F3") {
                e.preventDefault();
                e.stopPropagation();
                $("#btnModifyItem").trigger("click");
                return;
            }
            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                e.preventDefault(); const $rows = $(".item-row:visible"); if (!$rows.length) return;
                if (e.key === "ArrowDown") currentItemIndex = (currentItemIndex + 1) % $rows.length; else currentItemIndex = (currentItemIndex - 1 + $rows.length) % $rows.length;
                $rows.removeClass("selected").eq(currentItemIndex).addClass("selected")[0]?.scrollIntoView({ block: "nearest" });
            } else if (e.key === "Enter") { e.preventDefault(); var $r = $(".item-row:visible"); if ($r.length === 1) $r.first().trigger("click"); else if (currentItemIndex >= 0) $r.eq(currentItemIndex).trigger("click"); }
        });

        $(document).on("click", ".item-row", function (e) {
            e.preventDefault();
            const itemId = $(this).data("itemid");
            const itemName = $(this).data("name");
            const gst = $(this).data("gst");
            const cess = $(this).data("cess") || 0;
            currentRow.find(".item-input").val(itemName);
            currentRow.find(".item-id").val(itemId);
            currentRow.find(".gst").val(gst).data("cess", cess);
            calculateRow(currentRow); $("#itemModal").modal("hide"); loadBatches(itemId);
        });

        // Batch Logic
        function loadBatches(itemId) {
            showLoader("Loading...");
            $.get('/Sales/GetBatchesByItemId', { id: itemId }, function (data) {
                hideLoader();
                if (!data.groupedResult || data.groupedResult.length === 0) { toastr.warning("No batch available."); return; }
                let batchRows = '';
                data.groupedResult.forEach(batch => {
                    const exp = new Date(batch.expiry);
                    const fExp = ("0" + (exp.getMonth() + 1)).slice(-2) + "/" + exp.getFullYear();
                    const encoded = encodeURIComponent(JSON.stringify(batch));
                    batchRows += `<tr class="batch-row" tabindex="0" data-batch="${encoded}"><td>${batch.batch}</td><td>${fExp}</td><td>${batch.rate.toFixed(2)}</td><td>${batch.mrp.toFixed(2)}</td><td>${batch.qty}</td></tr>`;
                });
                $("#batchTableBody").html(batchRows); currentBatchIndex = -1; $("#batchModal").modal("show");
            });
        }
        $(document).on("keydown", function (e) {
            if (!$("#batchModal").is(":visible")) return;
            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                e.preventDefault(); const $rows = $(".batch-row:visible"); if (!$rows.length) return;
                if (e.key === "ArrowDown") currentBatchIndex = (currentBatchIndex + 1) % $rows.length; else currentBatchIndex = (currentBatchIndex - 1 + $rows.length) % $rows.length;
                $rows.removeClass("selected").eq(currentBatchIndex).addClass("selected")[0]?.scrollIntoView({ block: "nearest" });
            }
            else if (e.key === "Enter" && currentBatchIndex >= 0) { e.preventDefault(); $(".batch-row:visible").eq(currentBatchIndex).trigger("click"); }
        });
        $(document).on("click", ".batch-row", function () {
            const batch = JSON.parse(decodeURIComponent($(this).attr("data-batch")));
            currentRow.find(".batch").val(batch.batch);
            currentRow.find(".rate").val(batch.rate.toFixed(2));
            currentRow.find(".mrp").val(batch.mrp.toFixed(2));
            currentRow.find(".qty").val(batch.qty || 0);
            currentRow.find(".purchase-id").val(batch.purchaseItemId || 0);
            if (batch.expiry) { let date = new Date(batch.expiry); currentRow.find(".expirydate").val(("0" + (date.getMonth() + 1)).slice(-2) + "/" + date.getFullYear()); }
            calculateRow(currentRow); $("#batchModal").modal("hide");
            setTimeout(() => { currentRow.find(".qty").focus().select(); }, 200);
        });

        // ================================================================
        // 🔹 CALCULATIONS (WITH CESS)
        // ================================================================
        $(document).on("input", ".qty, .discount, .rate", function () { calculateRow($(this).closest("tr")); });
        $("#discountPercent, #discountamount").on("input", function () { calculateTotal(); });

        function calculateRow(row) {
            let qty = parseFloat(row.find(".qty").val()) || 0;
            let rate = parseFloat(row.find(".rate").val()) || 0;
            let gst = parseFloat(row.find(".gst").val()) || 0;
            let cess = parseFloat(row.find(".gst").data("cess")) || 0;
            let disc = parseFloat(row.find(".discount").val()) || 0;
            let gross = qty * rate;
            let discAmt = (gross * disc) / 100;
            let after = gross - discAmt;
            let gstAmt = (after * gst) / 100;
            let cessAmt = (after * cess) / 100;
            row.find(".Amount").val((after + gstAmt + cessAmt).toFixed(2));
            calculateTotal();
        }

        function calculateTotal() {
            let total = 0, totalGst = 0, totalDiscount = 0, totalamt = 0;
            $("#StockIssueItemBody tr").each(function () {
                let row = $(this); let qty = parseFloat(row.find(".qty").val()) || 0; let rate = parseFloat(row.find(".rate").val()) || 0;
                let gst = parseFloat(row.find(".gst").val()) || 0;
                let cess = parseFloat(row.find(".gst").data("cess")) || 0;
                let disc = parseFloat(row.find(".discount").val()) || 0;
                let gross = qty * rate; let discAmt = (gross * disc) / 100; let after = gross - discAmt;
                let gstAmt = (after * gst) / 100;
                let cessAmt = (after * cess) / 100;
                total += after; totalamt += after;
                totalGst += gstAmt + cessAmt;
                totalDiscount += discAmt;
            });

            let percentInput = parseFloat($("#discountPercent").val()) || 0; let amountInput = parseFloat($("#discountamount").val()) || 0;
            let globalDiscountAmt = 0;

            if ($("#discountPercent").is(":focus") || (percentInput > 0 && amountInput === 0)) { globalDiscountAmt = (total * percentInput) / 100; $("#discountamount").val(globalDiscountAmt.toFixed(2)); }
            else if ($("#discountamount").is(":focus") || (amountInput > 0 && percentInput === 0)) { globalDiscountAmt = amountInput; }

            if (globalDiscountAmt > 0) { totalDiscount += globalDiscountAmt; totalamt = total - globalDiscountAmt; }
            let totalPayable = totalamt + totalGst;
            $("[name='Total']").val(total.toFixed(2));
            $("[name='Totaldiscount']").val(totalDiscount.toFixed(2));
            $("[name='TotalGstAmt']").val(totalGst.toFixed(2));
            $("[name='TotalPayable']").val(totalPayable.toFixed(2));
            calculateTotalPaid();
        }
    </script>
}
