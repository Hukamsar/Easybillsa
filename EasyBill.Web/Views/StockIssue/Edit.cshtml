                customerNavMode = "keyboard";
                isKeyboardScrollingCustomerModal = true;
                $("#customerListModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".customer-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentCustomerIndex === -1) {
                    currentCustomerIndex = 0;
                }
                else if (currentCustomerIndex < $rows.length - 1) {
                    currentCustomerIndex++;
                }

                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();

                if (currentCustomerIndex <= 0) return;

                currentCustomerIndex--;

                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
            else if (e.key === "Enter") {
                e.preventDefault();

                if (currentCustomerIndex === -1) {
                    currentCustomerIndex = 0;
