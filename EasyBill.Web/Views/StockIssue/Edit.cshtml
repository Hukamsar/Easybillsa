@using EasyBill.Models.ViewModels
@model StockIssueVM
@{
    ViewData["Title"] = "Edit Stock Issue";
    var paymentModes = ViewBag.PaymentMode as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<link href="~/css/page.css" rel="stylesheet" />
<!-- ================================================================
     🔹 STYLES
     ================================================================ -->
<style>
    /* Loader */
    #globalLoader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .loader-content {
        text-align: center;
        color: #fff;
    }

    .spinner {
        border: 4px solid rgba(255, 255, 255, 0.3);
        border-top: 4px solid #fff;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
        margin: 0 auto 15px;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* Modal Styles */
    #batchModal .modal-header, #itemModal .modal-header, #itemMasterModal .modal-header, #customerListModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

    .btn-close {
        filter: invert(1);
    }

    .batch-row.selected td, .item-row.selected td, .customer-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    .item-table-wrapper, .customer-table-wrapper {
        max-height: 350px;
        overflow-y: auto;
    }

    #itemTable thead th, #customerTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        z-index: 2;
    }

    #customerListModal.keyboard-nav .customer-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #customerListModal.mouse-nav .customer-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .customer-row {
        scroll-margin-top: 50px;
    }

        .customer-row:focus {
            outline: none;
        }

    .custom-header th {
        background: linear-gradient(180deg, #eef3f8, #d8e3ef);
        color: #16202b;
        font-weight: 700;
        text-align: center;
    }

    #itemModal .shortcut-link {
        color: #0d6efd;
        cursor: pointer;
        font-weight: 600;
        text-decoration: none;
        line-height: 1.2;
    }

        #itemModal .shortcut-link:hover {
            text-decoration: underline;
        }

        #itemModal .shortcut-link.text-danger {
            color: #dc3545 !important;
        }
</style>

<!-- ================================================================
     🔹 GLOBAL LOADER
     ================================================================ -->
<div id="globalLoader">
    <div class="loader-content"><div class="spinner"></div><div class="loader-text">Loading...</div></div>
</div>

<!-- ================================================================
     🔹 MAIN FORM
     ================================================================ -->
<div class="card mb-3 shadow-sm">
    <div class="card-header text-white d-flex align-items-center justify-content-between" style="background:#2b6ac9">
        <h6 class="mb-0">Edit Stock Issue</h6>
    </div>
</div>

<form asp-controller="StockIssue" asp-action="Edit" method="post" id="stockIssueForm">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CustomerId" id="CustomerId" />
    <input type="hidden" asp-for="PharmacyDoctorId" id="DoctorId" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="container-fluid px-3">
        <!-- Professional Document Type Selector -->
        <div class="row mb-3 pb-2 border-bottom align-items-center bg-light rounded p-2">
            <label class="col-md-2 col-form-label text-start small fw-bold text-primary text-uppercase">Document Type:</label>
            <div class="col-md-10 d-flex align-items-center">
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="radio" name="IssueToType" id="issueCustomer" value="Customer" @(Model.IssueToType == "Customer" ? "checked" : "")>
                    <label class="form-check-label fw-bold" style="cursor: pointer;" for="issueCustomer"><i class="bi bi-person-fill"></i> Standard Issue (Customer)</label>
                </div>
                <div class="form-check form-check-inline mb-0 ms-4">
                    <input class="form-check-input" type="radio" name="IssueToType" id="issueBranch" value="Branch" @(Model.IssueToType == "Branch" ? "checked" : "")>
                    <label class="form-check-label fw-bold" style="cursor: pointer;" for="issueBranch"><i class="bi bi-shop"></i> In-Transit Transfer (Branch)</label>
                </div>
            </div>
        </div>

        <div class="row mb-2">
            <label asp-for="ChallanNo" class="col-md-2 col-form-label text-start small">Challan No <i class="text-danger">*</i></label>
            <div class="col-md-2">
                <input asp-for="ChallanNo" type="text" class="form-control form-control-sm" required />
            </div>

            <label asp-for="ChallanDate" class="col-md-2 col-form-label text-start small">Challan Date <i class="text-danger">*</i></label>
            <div class="col-md-2">
                <input type="date" asp-for="ChallanDate" id="ChallanDate" class="form-control form-control-sm" required />
            </div>

            <label class="col-md-2 col-form-label text-start small customer-section">Billing Type</label>
            <div class="col-md-2 customer-section">
                <select asp-for="billingType" id="billingType" class="form-control form-control-sm">
                    <option value="walkin">Cash</option>
                    <option value="registered">Customer</option>
                </select>
            </div>
            
            <!-- Branch Selection (Hidden by default) -->
            <label class="col-md-2 col-form-label text-start small branch-section" style="display:none;">Select Branch <i class="text-danger">*</i></label>
            <div class="col-md-2 branch-section" style="display:none;">
                <select asp-for="TransferToTenantId" class="form-control form-control-sm" asp-items="ViewBag.Branches">
                    <option value="">-- Select Branch --</option>
                </select>
            </div>
        </div>

        <div class="row mb-2 customer-section">
            <label class="col-md-2 col-form-label text-start small">Mobile No <i class="text-danger">*</i></label>
            <div class="col-md-2 d-flex align-items-center">
                <div class="w-100">
                    <input asp-for="MobileNo" type="text" class="form-control form-control-sm" id="mobilenumber" maxlength="10" />
                    <small id="mobileError" class="text-danger"></small>
                </div>
                <div class="shortcut-box">
                    <span id="btnF1CustomerList" class="shortcut-link">F1 - List</span>
                </div>
            </div>

            <label class="col-md-2 col-form-label text-start small">Customer <i class="text-danger">*</i></label>
            <div class="col-md-2">
                <input asp-for="CustomerName" class="form-control form-control-sm" id="customer" required />
            </div>

            <label class="col-md-2 col-form-label text-start small">Address <i class="text-danger">*</i></label>
            <div class="col-md-2">
                <input asp-for="Address" id="customeraddress" class="form-control form-control-sm" />
            </div>
        </div>

        <div class="row mb-2">
            <label class="col-md-2 col-form-label small">Doctor Mobile No</label>
            <div class="col-md-2">
                <input type="text" asp-for="DoctorMobileNumber" class="form-control form-control-sm" id="doctorMobile" maxlength="10" />
            </div>

            <label class="col-md-2 col-form-label small">Doctor</label>
            <div class="col-md-2">
                <input type="text" asp-for="DoctorName" class="form-control form-control-sm" id="doctorname" />
            </div>

            <label class="col-md-2 col-form-label small">Registration Number</label>
            <div class="col-md-2">
                <input type="text" asp-for="DoctorRegNumber" class="form-control form-control-sm" id="doctorregno" />
            </div>
        </div>

        <!-- Items Table -->
        <div style="overflow-x: auto; width: 100%;">
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table custom-header">
                        <tr>
                            <th style="min-width:30%">Item</th>
                            <th style="min-width:20%">Batch</th>
                            <th class="text-center">Expiry</th>
                            <th class="text-center">Mrp</th>
                            <th class="text-center">Qty</th>
                            <th class="text-center">Rate</th>
                            <th class="text-center">Gst %</th>
                            <th class="text-center">Disc %</th>
                            <th class="text-center">Amount</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="StockIssueItemBody">
                        @{
                            int i = 0;
                            foreach (var item in Model.StockIssuesItemVMs)
                            {
                                var itemName = "";
                                var listItem = ((IEnumerable<SelectListItem>)ViewBag.Items)?.FirstOrDefault(x => x.Value == item.ItemMasterId.ToString());
                                if (listItem != null) { itemName = listItem.Text; }

                                <tr>
                                    <!-- ✅ IDs Safe (Hidden) -->
                                    <td hidden><input name="StockIssuesItemVMs[@i].Id" value="@item.Id" class="row-id" /></td>
                                    <td hidden><input name="StockIssuesItemVMs[@i].ItemMasterId" value="@item.ItemMasterId" class="item-id" /></td>
                                    <td hidden><input name="StockIssuesItemVMs[@i].PurchaseItemId" value="@item.PurchaseItemId" class="purchase-id" /></td>

                                    <td style="min-width:250px;">
                                        <input type="text" class="form-control form-control-sm item-input" placeholder="Search item..." value="@itemName" readonly />
                                    </td>

                                    <td><input name="StockIssuesItemVMs[@i].Batch" class="form-control form-control-sm batch" value="@item.Batch" readonly /></td>
                                    <td><input name="StockIssuesItemVMs[@i].Expirydate" value="@(item.Expirydate?.ToString("MM/yyyy"))" class="form-control form-control-sm expirydate" readonly /></td>
                                    <td><input name="StockIssuesItemVMs[@i].Mrp" value="@item.Mrp" class="form-control form-control-sm mrp" readonly /></td>
                                    <td><input name="StockIssuesItemVMs[@i].Qty" class="form-control form-control-sm qty" value="@item.Qty" /></td>
                                    <td><input name="StockIssuesItemVMs[@i].Rate" class="form-control form-control-sm rate" value="@item.Rate" readonly /></td>
                                    <td><input name="StockIssuesItemVMs[@i].Gst" class="form-control form-control-sm gst" value="@item.Gst" readonly /></td>
                                    <td><input name="StockIssuesItemVMs[@i].Discount" class="form-control form-control-sm discount" value="@item.Discount" /></td>
                                    <td><input name="StockIssuesItemVMs[@i].Amount" class="form-control form-control-sm Amount" value="@item.Amount" readonly /></td>
                                    <td><u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u></td>
                                </tr>
                                i++;
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr><th colspan="8"><u id="addRow" style="color:green; cursor:pointer;">Add Row</u></th></tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Totals -->
        <div class="row mt-3">
            <div class="col-md-7">
                <strong>Payment Details</strong>
                <table class="table table-bordered table-striped">
                    <thead class="table custom-header">
                        <tr><th style="min-width:30%">Payment Mode</th><th class="text-center">Amount</th><th class="text-center">Reference No</th><th class="text-center">Description</th><th></th></tr>
                    </thead>
                    <tbody id="PaymentDetailsBody">
                        @for (int p = 0; p < (Model.SalsePaymentDetails?.Count ?? 0); p++)
                        {
                            <tr>
                                <td hidden><input type="hidden" asp-for="@Model.SalsePaymentDetails[p].Id" /></td>
                                <td style="min-width:185px;">
                                    <select name="SalsePaymentDetails[@p].PaymentModeId" class="form-control form-control-sm paymentMode-dropdown">
                                        <option value="">Select</option>
                                        @foreach (var mode in paymentModes)
                                        {
                                            if (mode.Value == Model.SalsePaymentDetails[p].PaymentModeId.ToString())
                                            {
                                                <option value="@mode.Value" selected>@mode.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@mode.Value">@mode.Text</option>
                                            }
                                        }
                                    </select>
                                </td>
                                <td><input name="SalsePaymentDetails[@p].Amount" value="@Model.SalsePaymentDetails[p].Amount" class="form-control form-control-sm paymentAmount" /></td>
                                <td><input name="SalsePaymentDetails[@p].ReferenceNo" value="@Model.SalsePaymentDetails[p].ReferenceNo" class="form-control form-control-sm paymentReferenceNO" /></td>
                                <td><input name="SalsePaymentDetails[@p].Description" value="@Model.SalsePaymentDetails[p].Description" class="form-control form-control-sm paymentDescription" /></td>
                                <td><u class="remove-paymentrow-btn text-danger" style="cursor:pointer;">Remove</u></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th><u id="addPaymentRow" style="color:green; cursor:pointer;">Add Row</u></th></tr></tfoot>
                </table>
                <div class="row mt-2">
                    <div class="col-md-12">
                        <span class="fw-bold text-danger" style="font-size: xx-large;">Return Amount :</span>
                        <span id="returnAmountDisplay" class="fw-bold" style="font-size: xxx-large;color:#8B0000;">@(Model.ReturnAmount?.ToString("0.00") ?? "0.00")</span>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="row mb-2">
                    <label asp-for="Total" class="col-md-3 col-form-label text-start small">Total</label>
                    <div class="col-md-4"></div>
                    <div class="col-md-4"><input asp-for="Total" class="form-control form-control-sm" readonly /></div>
                </div>
                <div class="row mb-2">
                    <label class="col-md-3 col-form-label text-start small">Bill Discount</label>
                    <div class="col-md-4"></div>
                    <div class="col-md-2"><input asp-for="discountPercent" id="discountPercent" class="form-control form-control-sm" /></div>
                    <div class="col-md-2"><input asp-for="discountAmount" id="discountamount" class="form-control form-control-sm" placeholder="amount" /></div>
                </div>
                <div class="row mb-2">
                    <label asp-for="Totaldiscount" class="col-md-3 col-form-label text-start small">Total Discount</label>
                    <div class="col-md-4"></div>
                    <div class="col-md-4"><input asp-for="Totaldiscount" id="Totaldiscount" class="form-control form-control-sm" readonly /></div>
                </div>
                <div class="row mb-2">
                    <label asp-for="TotalGstAmt" class="col-md-3 col-form-label text-start small">Gst</label>
                    <div class="col-md-4"></div>
                    <div class="col-md-4"><input asp-for="TotalGstAmt" class="form-control form-control-sm" readonly /></div>
                </div>
                <div class="row mb-2">
                    <label asp-for="TotalPayable" class="col-md-3 col-form-label text-start small">Total Amount</label>
                    <div class="col-md-4"></div>
                    <div class="col-md-4"><input asp-for="TotalPayable" id="totalPayable" class="form-control form-control-sm" readonly /></div>
                </div>
                <div class="row mb-2">
                    <label asp-for="PaidAmount" class="col-md-3 col-form-label text-start small">Paid Amount</label>
                    <div class="col-md-4"></div>
                    <div class="col-md-4"><input asp-for="PaidAmount" id="paidAmout" class="form-control form-control-sm" readonly /></div>
                </div>
                <div class="row mb-2">
                    <label asp-for="Balance" class="col-md-3 col-form-label text-start small">Balance</label>
                    <div class="col-md-4"></div>
                    <div class="col-md-4"><input asp-for="Balance" id="balance" class="form-control form-control-sm" readonly /></div>
                </div>
            </div>
        </div>

        <div class="mt-3 text-end">
            <button type="button" id="saveBtn" class="btn btn-sm btn-primary">Save</button>
            <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index"))"
               class="btn btn-secondary">
                Cancel
            </a>
        </div>
    </div>
</form>

<!-- MODALS (Item, Batch, Customer) -->
<!-- StockIssue Edit Item Master F2/F3 popup host uses Sales embedded Item Master partial. -->
<div class="modal fade" id="itemMasterModal" tabindex="-1" data-bs-focus="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Item Master</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="itemMasterContainer">
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- StockIssue Edit item search row keeps F2-New and F3-Mod beside the dropdown search. -->
                <div class="row align-items-center g-2 mb-2">
                    <div class="col-md-10">
                        <input type="text" id="itemSearch" class="form-control" placeholder="Search by item name..." />
                    </div>
                    <div class="col-md-2 ps-0">
                        <a href="javascript:void(0)" class="shortcut-link d-block small" id="btnNewItem">F2 - New</a>
                        <a href="javascript:void(0)" class="shortcut-link text-danger d-block small" id="btnModifyItem">F3 - Mod</a>
                    </div>
                </div>
                <div class="item-table-wrapper">
                    <table id="itemTable" class="table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Item Name</th>
                                <th>Qty</th>
                            </tr>
                        </thead>
                        <tbody id="itemTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="batchModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Select Batch</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body p-0"><table id="batchTable" class="table mb-0"><thead class="table-light"><tr><th>Batch</th><th>Expiry</th><th>Rate</th><th>Mrp</th><th>Qty</th></tr></thead><tbody id="batchTableBody"></tbody></table></div></div></div></div>

<!-- Customer Modal -->
<div class="modal fade" id="customerListModal" tabindex="-1" aria-labelledby="customerListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customerListModalLabel">Select Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <input type="text"
                           id="customerSearch"
                           class="form-control form-control-sm"
                           placeholder="Search by customer name or mobile no..." />
                </div>
                <div class="customer-table-wrapper">
                    <table id="customerTable" class="table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Customer Name</th>
                                <th>Mobile No</th>
                            </tr>
                        </thead>
                        <tbody id="customerTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createCustomerModal" tabindex="-1"><div class="modal-dialog"><form id="newCustomerForm"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Create Customer</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="mb-2"><label class="form-label">Name</label><input type="text" name="Name" class="form-control form-control-sm" required /></div><div class="mb-2"><label class="form-label">Mobile</label><input type="text" name="CustomerMobileNo" id="newCustomerMobile" class="form-control form-control-sm" readonly /></div><div class="mb-2"><label class="form-label">Address</label><input type="text" name="Address" class="form-control form-control-sm" /></div></div><div class="modal-footer"><button type="submit" class="btn btn-sm btn-success">Save</button><button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button></div></div></form></div></div>

<!-- ================================================================
     ✅ UPDATED DOCTOR MODAL (Matching Image)
     ================================================================ -->
<div class="modal fade" id="createDoctorModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="newDoctorForm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Doctor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Mobile No (Readonly) -->
                    <div class="mb-2">
                        <label class="form-label">Mobile No</label>
                        <input type="text" name="PhoneNo" id="newDoctorPhone" class="form-control form-control-sm" readonly />
                    </div>
                    <!-- Doctor Name -->
                    <div class="mb-2">
                        <label class="form-label">Doctor Name</label>
                        <input type="text" name="Name" class="form-control form-control-sm" placeholder="Doctor Name" required />
                    </div>
                    <!-- Address -->
                    <div class="mb-2">
                        <label class="form-label">Address</label>
                        <input type="text" name="Address" class="form-control form-control-sm" placeholder="Address" />
                    </div>
                    <!-- Registration No -->
                    <div class="mb-2">
                        <label class="form-label">Registration No</label>
                        <input type="text" name="RegistrationNo" class="form-control form-control-sm" placeholder="Registration No" />
                    </div>
                    <!-- ✅ NEW: Specialization -->
                    <div class="mb-2">
                        <label class="form-label">Specialization</label>
                        <input type="text" name="Specialization" class="form-control form-control-sm" placeholder="Specialization" />
                    </div>
                    <!-- ✅ NEW: Commission % -->
                    <div class="mb-2">
                        <label class="form-label">Commission %</label>
                        <input type="number" name="Commission" class="form-control form-control-sm" placeholder="Commission %" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-sm btn-success">Save</button>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Action Modal -->
<div class="modal fade" id="stockIssueActionModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-body text-center py-5"><i class="bi bi-check-circle-fill" style="font-size: 4rem; color: #198754;"></i><h4 class="mt-3 text-success">Updated Successfully!</h4></div></div></div></div>

@section Scripts {
    <script src="~/js/payment-mode-popup.js"></script>
    <script>
        // ================================================================
        // 🔹 GLOBAL VARIABLES
        // ================================================================
        let rowIndex = $("#StockIssueItemBody tr").length;
        let currentRow = null;
        let currentItemIndex = -1;
        let currentBatchIndex = -1;
        let savedStockIssueId = 0;
        let paymentRowIndex = $("#PaymentDetailsBody tr").length;
        let currentCustomerIndex = -1;
        let customerNavMode = "keyboard";
        let isKeyboardScrollingCustomerModal = false;

        // ================================================================
        // 🔹 HELPERS
        // ================================================================
        function showLoader(msg = "Loading...") { $("#globalLoader .loader-text").text(msg); $("#globalLoader").css("display", "flex"); }
        function hideLoader() { $("#globalLoader").hide(); }

        function reindexGrid() {
            $("#StockIssueItemBody tr").each(function (index) {
                $(this).find("input").each(function () {
                    let name = $(this).attr("name");
                    if (name) {
                        let newName = name.replace(/\[\d+\]/, `[${index}]`);
                        $(this).attr("name", newName);
                    }
                });
            });
