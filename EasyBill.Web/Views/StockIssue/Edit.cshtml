        function reindexPaymentRows() {
            $("#PaymentDetailsBody tr").each(function (index) {
                $(this).find("input, select").each(function () {
                    let name = $(this).attr("name");
                    if (name) {
                        let newName = name.replace(/SalsePaymentDetails\[\d+\]/, `SalsePaymentDetails[${index}]`);
                        $(this).attr("name", newName);
                    }
                });
            });
            paymentRowIndex = $("#PaymentDetailsBody tr").length;
        }
        function getPaymentOptions() {
            return `@foreach (var item in paymentModes)
            {
                <option value="@item.Value">@item.Text</option>
            }`;
        }
        function addPaymentRow(paymentModeId = "", amount = "0", referenceNo = "", description = "") {
            let row = `<tr>
                <td hidden><input type="hidden" name="SalsePaymentDetails[${paymentRowIndex}].Id" value="0" /></td>
                <td style="min-width:185px;">
                    <select name="SalsePaymentDetails[${paymentRowIndex}].PaymentModeId" class="form-control form-control-sm paymentMode-dropdown">
                        <option value="">Select</option>
                        ${getPaymentOptions()}
                    </select>
                </td>
                <td><input name="SalsePaymentDetails[${paymentRowIndex}].Amount" class="form-control form-control-sm paymentAmount" value="${amount}" /></td>
                <td><input name="SalsePaymentDetails[${paymentRowIndex}].ReferenceNo" class="form-control form-control-sm paymentReferenceNO" value="${referenceNo}" /></td>
                <td><input name="SalsePaymentDetails[${paymentRowIndex}].Description" class="form-control form-control-sm paymentDescription" value="${description}" /></td>
                <td><u class="remove-paymentrow-btn text-danger" style="cursor:pointer;">Remove</u></td>
            </tr>`;
            $("#PaymentDetailsBody").append(row);
            $("#PaymentDetailsBody tr:last .paymentMode-dropdown").val(paymentModeId);
            paymentRowIndex++;
            calculateTotalPaid();
        }
        function calculateTotalPaid() {
            let paid = 0;
            $(".paymentAmount").each(function () {
                paid += parseFloat($(this).val()) || 0;
            });
            let totalPayable = parseFloat($("#totalPayable").val()) || 0;
            let returnAmount = paid > totalPayable ? paid - totalPayable : 0;
            let balance = paid > totalPayable ? 0 : totalPayable - paid;
            $("#paidAmout").val(paid.toFixed(2));
            $("#balance").val(balance.toFixed(2));
            $("#returnAmountDisplay").text(returnAmount.toFixed(2));
        }

