            e.preventDefault(); e.stopImmediatePropagation();

            const row = $(this).closest("tr");
            const input = $(this);

            if (e.key === "Tab") {
                if (input.hasClass("item-input")) { row.find(".qty").focus().select(); }
                else if (input.hasClass("qty")) { row.find(".discount").focus().select(); }
                else if (input.hasClass("discount")) { const nextRow = row.next("tr"); if (nextRow.length > 0) { nextRow.find(".item-input").focus(); } else { $("#discountPercent").focus().select(); } }
            }
            else if (e.key === "Enter") {
                if (input.hasClass("item-input")) { currentRow = row; openItemSearchModal(input.val()); }
                else if (input.hasClass("qty")) { row.find(".discount").focus().select(); }
                else if (input.hasClass("discount")) { const nextRow = row.next("tr"); if (nextRow.length > 0) { nextRow.find(".item-input").focus(); } else { addNewRow(); setTimeout(() => { $("#StockIssueItemBody tr:last .item-input").focus(); }, 100); } }
            }
