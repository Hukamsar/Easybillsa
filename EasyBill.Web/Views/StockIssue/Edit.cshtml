        function renderStockIssueEditItemRows(items) {
            let rows = "";

            items.forEach(item => {
                rows += `<tr class="item-row" tabindex="0"
                    data-itemid="${item.id}"
                    data-name="${item.name}"
                    data-gst="${item.gst}"
                    data-cess="${item.cess || 0}"
                    data-qty="${item.qty}">
                    <td>${item.name}</td>
                    <td>${item.qty}</td>
                </tr>`;
            });

            return rows;
        }

