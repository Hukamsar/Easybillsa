@model IEnumerable<StockIssue>

@{
    ViewData["Title"] = "Index";
}
<style>
    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>
<div class="card mb-3 shadow-sm">
    <div class="card-header text-white d-flex align-items-center justify-content-between" style="background:#2b6ac9">
        <h6 class="mb-0">
            Stock Issue
        </h6>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn mb-1 text-light float-end" style="background:#2b6ac9"> <i class="bi bi-plus-circle"></i> Add </a>
</p>
<table class="table" id="stockIssueTbl">
    <thead class="table-primary">
        <tr>
          
            <th>
                @Html.DisplayNameFor(model => model.ChallanNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChallanDate)
            </th>
            <th>
                Customer
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MobileNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                Status
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
           
            <td>
                @Html.DisplayFor(modelItem => item.ChallanNo)
            </td>
            <td>
              @item.ChallanDate?.ToString("dd/MM/yyyy")
            </td>
            <td>
                @if (!string.IsNullOrEmpty(item.TransferToTenantId) && ViewBag.Tenants != null)
                {
                    var tenants = (Dictionary<string, AOne.Models.Entity.Tenant>)ViewBag.Tenants;
                    if (tenants.TryGetValue(item.TransferToTenantId, out var targetBranch))
                    {
                        <span class="badge bg-info">Branch Transfer</span><br/>
                        <strong>@targetBranch.Name</strong>
                    }
                    else
                    {
                        @Html.DisplayFor(modelItem => item.TransferToTenantId)
                    }
                }
                else
                {
                    @Html.DisplayFor(modelItem => item.Customers.Name)
                }
            </td>
            <td>
                @if (!string.IsNullOrEmpty(item.TransferToTenantId) && ViewBag.Tenants != null)
                {
                    var tenants = (Dictionary<string, AOne.Models.Entity.Tenant>)ViewBag.Tenants;
                    if (tenants.TryGetValue(item.TransferToTenantId, out var targetBranch))
                    {
                        @(targetBranch.Phone ?? targetBranch.MobileNo)
                    }
                }
                else
                {
                    @Html.DisplayFor(modelItem => item.MobileNo)
                }
            </td>
            <td>
                @if (!string.IsNullOrEmpty(item.TransferToTenantId) && ViewBag.Tenants != null)
                {
                    var tenants = (Dictionary<string, AOne.Models.Entity.Tenant>)ViewBag.Tenants;
                    if (tenants.TryGetValue(item.TransferToTenantId, out var targetBranch))
                    {
                        <small>@targetBranch.Address1</small>
                    }
                }
                else
                {
                    @Html.DisplayFor(modelItem => item.Address)
                }
            </td>
            <td>
                @if (!string.IsNullOrEmpty(item.TransferToTenantId))
                {
                    if (item.TransferStatus == "Pending")
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (item.TransferStatus == "Accepted")
                    {
                        <span class="badge bg-success">Accepted</span>
                    }
                    else if (item.TransferStatus == "Rejected")
                    {
                        <span class="badge bg-danger">Rejected</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.TransferStatus</span>
                    }
                }
                else
                {
                    <span class="badge bg-success">Completed</span>
                }
            </td>
            <td>
                @if (!item.IsReceived && (string.IsNullOrEmpty(item.TransferToTenantId) || item.TransferStatus == "Pending"))
                {
                    <div class="btn-group" role="group" style="float:right">
                        <a asp-controller="StockIssue" asp-action="Edit" asp-route-id="@item.Id" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-controller="StockIssue" asp-action="Delete"
                           class="btn-delete"
                           title="Delete"
                           asp-route-id="@item.Id"
                           data-id="@item.Id"
                           data-controller="@ViewContext.RouteData.Values["controller"]">
                            <i class="bi bi-trash-fill text-danger p-1"></i>
                        </a>
                    </div>
                }
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#stockIssueTbl").DataTable({
                "order": [[2, "asc"]]
            });
        });
    </script>
}
