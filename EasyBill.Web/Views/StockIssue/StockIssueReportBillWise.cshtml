@using EasyBill.Models.ViewModels
@model IEnumerable<StockIssueVM>
<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

</style>

@* 
<div class="card mb-3">
    <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
        Stock Issue Report - Bill Wise
    </div>
</div> *@
<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2 d-flex align-items-center" style="background: #2b6ac9;">
        Stock Issue Report - Bill Wise
        <span class="ms-auto">
            Total GstAmt: <span class="fw-bold">@ViewBag.TotalGst</span> |
            Total Amt: <span class="fw-bold">@ViewBag.TotalAmount</span>
        </span>
    </div>
</div>

<form method="get" class="card p-3 mb-3">
    <div class="row align-items-end">

        <div class="col-md-2">
            <label for="fromDate">Date From</label>
            <input type="date"
                   id="fromDate"
                   name="fromDate"
                   class="form-control"
                   value="@ViewBag.FromDate" />
        </div>

        <div class="col-md-2">
            <label for="toDate">Date To</label>
            <input type="date"
                   id="toDate"
                   name="toDate"
                   class="form-control"
                   value="@ViewBag.ToDate" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn w-100 text-light" style="background: #2b6ac9;">
                <i class="bi bi-search"></i> Search
            </button>
        </div>

    </div>
</form>

<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="ExportStockIssueBillWiseExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>
        <a asp-action="ExportStockIssueBillWisePdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>

<table id="stockIssueTbl" class="table table-bordered table-sm">
    <thead class="table-light">
        <tr>
            <th>S.No</th>
            <th>Bill No</th>
            <th>Bill Date</th>
            <th>Customer</th> 
            <th class="text-end">Gst Amount</th>
            <th class="text-end">Total Amount</th>
        </tr>
    </thead>
    <tbody>
        @{
            int sr = 1;
        }
        @foreach (var bill in Model)
        {
            <tr>
                <td>@sr</td>
                <td>@bill.ChallanNo</td>
                <td>@bill.ChallanDate?.ToString("dd-MM-yyyy")</td>
                <td>@bill.CustomerName</td> 
                <td class="text-end">@bill.TotalGstAmt</td>
                <td class="text-end">@bill.TotalPayable</td>
            </tr>
            sr++;
        }
    </tbody>
    <tfoot class="table-secondary fw-bold">
        <tr>
            <td></td>
            <td></td>
            <td></td>
            <td class="text-end">Total</td>
            <td class="text-end">@ViewBag.TotalGst</td>
            <td class="text-end">@ViewBag.TotalAmount</td>
        </tr>
    </tfoot>
</table>
@section Scripts {
    <script>
        $(document).ready(function () {
            var t = $("#stockIssueTbl").DataTable({
                "order": [[2, "desc"]],
                "columnDefs": [
                    { "orderable": false, "targets": "_all" }
                ]
            });

            t.on('order.dt search.dt', function () {
                t.column(0, { search: 'applied', order: 'applied' }).nodes()
                    .each(function (cell, i) {
                        cell.innerHTML = i + 1;
                    });
            }).draw();
        });

    </script>
}
