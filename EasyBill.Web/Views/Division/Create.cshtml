@* @model EasyBill.Models.ViewModels.DivisionVM
@{
    ViewData["Title"] = "Create Division";
}

<style>

    /* PAGE BG */
    body {
        background: #f4f7fb;
    }

    /* HEADER */
    .card-header {
        background: linear-gradient(135deg, #2b6ac9, #4a8df0);
        color: white;
        border-radius: 8px 8px 0 0;
        font-weight: 600;
        padding: 12px 18px;
        font-size: 16px;
    }

    /* CARD */
    .card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }

    .card-body {
        padding: 15px;
    }

    /* FORM */
    .form-row-custom {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .form-label {
        font-size: 13px;
        margin-bottom: 0;
        min-width: 90px;
        color: #444;
    }

    /* INPUT */
    .form-control-sm {
        height: 32px;
        font-size: 13px;
        border-radius: 6px;
        border: 1px solid #ccc;
        transition: 0.2s;
    }

        .form-control-sm:focus {
            border-color: #2b6ac9;
            box-shadow: 0 0 0 2px rgba(43,106,201,0.15);
        }

    /* SHORTCUT */
    .shortcut-box {
        display: flex;
        flex-direction: column;
        line-height: 14px;
        margin-left: 6px;
    }

    .shortcut-link {
        font-size: 11px;
        cursor: pointer;
        color: #2b6ac9;
        font-weight: 500;
    }

        .shortcut-link:hover {
            text-decoration: underline;
        }

        .shortcut-link.text-danger {
            color: #e53935;
        }

    /* BUTTON */
    .btn-sm {
        padding: 4px 16px;
        font-size: 13px;
        border-radius: 6px;
        transition: 0.25s;
    }

    .btn-primary {
        background: #2b6ac9;
        border: none;
    }

        .btn-primary:hover {
            background: #1f54a5;
            transform: translateY(-1px);
        }

    .btn-outline-secondary:hover {
        transform: translateY(-1px);
    }

    /* ================= MODAL ================= */

    /* BACKDROP (light blur feel) */
    .modal-backdrop.show {
        opacity: 0.2;
    }

    /* MODAL BOX */
    .custom-modal {
        background: #ececec; /* exact light grey */
        border-radius: 6px;
        border: 1px solid #cfcfcf;
        box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        padding: 20px 25px;
    }

    /* HEADER */
    .modal-header {
        border: none;
        justify-content: center;
        padding: 0;
        margin-bottom: 10px;
    }

    .modal-title {
        font-size: 28px;
        font-weight: 600;
        color: #333;
    }

    /* BODY */
    .modal-body {
        text-align: center;
        padding: 5px 10px;
    }

        /* LABEL */
        .modal-body label {
            font-size: 13px;
            color: #444;
            margin-bottom: 6px;
        }

    /* INPUT (flat like your image) */
    .modal-input {
        height: 36px;
        border-radius: 5px;
        border: 1px solid #cfcfcf;
        background: #f5f5f5;
        text-align: center;
        font-size: 14px;
    }

        /* remove blue glow */
        .modal-input:focus {
            outline: none;
            border-color: #999;
            box-shadow: none;
        }

    /* ERROR */
    #modalCompError {
        margin-top: 5px;
    }

    /* FOOTER */
    .modal-footer {
        border: none;
        justify-content: center;
        gap: 10px;
        padding-top: 10px;
    }

        /* BUTTONS */
        .modal-footer .btn-success {
            background: #1f8f4d;
            border: none;
            border-radius: 5px;
            padding: 6px 18px;
        }

        .modal-footer .btn-danger {
            background: #d63c3c;
            border: none;
            border-radius: 5px;
            padding: 6px 18px;
        }

        /* hover slight */
        .modal-footer .btn:hover {
            opacity: 0.9;
        }
</style>


<div class="card-header">Create Division</div>

<div class="container mt-2">
    <div class="card">
        <div class="card-body">

            <form asp-action="Create" id="DivisionForm">

                <div class="form-row-custom">

                    <!-- COMPANY -->
                    <label class="form-label">Company *</label>

                    <div class="d-flex align-items-center">

                        <select asp-for="CompanyId"
                                asp-items="@ViewBag.companydata"
                                id="companyId"
                                class="form-control form-control-sm"
                                style="width:200px;">
                            <option value="">-- Select --</option>
                        </select>

                        <div class="shortcut-box">
                            <span id="btnF2" class="shortcut-link">F2 - New</span>
                            <span id="btnF3" class="shortcut-link text-danger">F3 - Mod</span>
                        </div>

                    </div>

                    <!-- NAME -->
                    <label class="form-label ms-2">Name *</label>

                    <input type="text"
                           asp-for="Name"
                           id="divisionName"
                           class="form-control form-control-sm"
                           style="width:220px;" />

                    <!-- BUTTON -->
                    <div class="ms-auto">
                        <button class="btn btn-primary btn-sm">Submit</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
                    </div>

                </div>

            </form>

        </div>
    </div>
</div>

<!-- ================= MODAL ================= -->

<div class="modal fade" id="compModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal">

            <div class="modal-header">
                <h4 class="modal-title" id="compModalTitle">Add Company</h4>
            </div>

            <div class="modal-body">

                <input type="hidden" id="modalCompId" value="0" />

                <label>Name</label>

                <input type="text"
                       id="modalCompName"
                       class="form-control modal-input" />

                <span id="modalCompError" class="text-danger small"></span>

            </div>

            <div class="modal-footer">

                <button class="btn btn-success btn-sm px-4" id="btnSaveCompModal">
                    Save
                </button>

                <button class="btn btn-danger btn-sm px-4" data-bs-dismiss="modal">
                    Close
                </button>

            </div>

        </div>
    </div>
</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            $("#companyId").focus();

            // BUTTON CLICK
            $("#btnF2").click(() => openModal("new"));
            $("#btnF3").click(() => openModal("edit"));

            // KEYBOARD SHORTCUT
            $(document).keydown(function (e) {
                if (e.key === "F2") {
                    e.preventDefault();
                    openModal("new");
                }
                if (e.key === "F3") {
                    e.preventDefault();
                    openModal("edit");
                }
            });

            function openModal(mode) {

                $("#modalCompError").text("");

                if (mode === "new") {
                    $("#modalCompId").val(0);
                    $("#modalCompName").val("");
                    $("#compModalTitle").text("Add Company");
                } else {

                    let id = $("#companyId").val();
                    let text = $("#companyId option:selected").text();

                    if (!id) {
                        alert("Select company first!");
                        return;
                    }

                    $("#modalCompId").val(id);
                    $("#modalCompName").val(text);
                    $("#compModalTitle").text("Modify Company");
                }

                $("#compModal").modal("show");

                setTimeout(() => {
                    $("#modalCompName").focus();
                }, 200);
            }

            // SAVE
            $("#btnSaveCompModal").click(function () {

                let id = $("#modalCompId").val();
                let name = $("#modalCompName").val().trim();

                if (name === "") {
                    $("#modalCompError").text("Name required!");
                    return;
                }

                $.ajax({
                    url: '/Division/QuickSaveCompany',
                    type: 'POST',
                    data: { id: id, name: name },

                    success: function (res) {

                        if (res.success) {
                            $("#compModal").modal('hide');
                            refreshDropdown(res.newId);
                        } else {
                            $("#modalCompError").text(res.message);
                        }
                    }
                });
            });

                   // REFRESH DROPDOWN
        function refreshDropdown(selectedId) {

            $.get('/Division/GetCompanies', function (data) {

                let ddl = $("#companyId");
                ddl.empty();
                ddl.append('<option value="">-- Select --</option>');

                $.each(data, function (i, item) {

                    let opt = $('<option>', {
                        value: item.value,
                        text: item.text
                    });

                    if (item.value == selectedId) {
                        opt.attr('selected', 'selected');
                    }

                    ddl.append(opt);
                });

                // ✅ SHOW CONFIRM AFTER DROPDOWN LOAD (FIXED POSITION)
                Swal.fire({
                    title: 'Confirm Save?',
                    text: 'Do you want to save this company?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Save',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#dc3545',
                    reverseButtons: true,
                    focusConfirm: true,
                    buttonsStyling: true
                });

            });
        }

            // ENTER KEY SAVE
            $("#modalCompName").keypress(function (e) {
                if (e.which === 13) {
                    $("#btnSaveCompModal").click();
                }
            });
        $("#DivisionForm").on("submit", function (e) {

            e.preventDefault();
            let form = this;

            Swal.fire({
                title: 'Confirm Save?',
                text: 'Do you want to save this division?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Save',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#198754',
                cancelButtonColor: '#dc3545',
                reverseButtons: true,
                focusConfirm: true,
                buttonsStyling: true
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });

        });

        });
    </script>

} *@