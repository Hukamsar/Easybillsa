@model IEnumerable<Division>

@{
    ViewData["Title"] = "Division";
}

<link href="~/css/page.css" rel="stylesheet" />

<style>

    body {
        background: #f4f7fb;
    }

    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    .card-header {
        background: linear-gradient(135deg, #2b6ac9, #4a8df0);
        color: white;
        border-radius: 8px 8px 0 0;
        font-weight: 600;
        padding: 12px 18px;
        font-size: 16px;
    }

    .card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }

    .card-body {
        padding: 15px;
    }

    .form-row-custom {
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .form-label {
        font-size: 13px;
        margin-bottom: 0;
        min-width: 90px;
        color: #444;
    }

    .form-control-sm {
        height: 32px;
        font-size: 13px;
        border-radius: 6px;
    }

    .btn-primary {
        background: #2b6ac9;
        border: none;
    }

        .btn-primary:hover {
            background: #1f54a5;
        }

    .shortcut-box {
        display: flex;
        flex-direction: column;
        line-height: 13px;
        gap: 0px;
        margin-left: 6px;
        flex-shrink: 0;
    }

    .shortcut-link {
        font-size: 10px;
        cursor: pointer;
        color: #2b6ac9;
        font-weight: 500;
        transition: 0.2s;
        white-space: nowrap;
    }

        .shortcut-link:hover {
            text-decoration: underline;
        }

        .shortcut-link.text-danger {
            color: #dc3545;
        }

    .modal-backdrop.show {
        opacity: 0.2;
    }

    .custom-modal {
        background: #ececec;
        border-radius: 6px;
        border: 1px solid #cfcfcf;
        box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        padding: 20px 25px;
    }

    .modal-header {
        border: none;
        justify-content: center;
        padding: 0;
        margin-bottom: 10px;
    }

    .modal-title {
        font-size: 28px;
        font-weight: 600;
        color: #333;
    }

    .modal-body {
        text-align: center;
        padding: 5px 10px;
    }

        .modal-body label {
            font-size: 13px;
            color: #444;
            margin-bottom: 6px;
        }

    .modal-input {
        height: 36px;
        border-radius: 5px;
        border: 1px solid #cfcfcf;
        background: #f5f5f5;
        text-align: center;
        font-size: 14px;
    }

        .modal-input:focus {
            outline: none;
            border-color: #999;
            box-shadow: none;
        }

    .modal-footer {
        border: none;
        justify-content: center;
        gap: 10px;
        padding-top: 10px;
    }

        .modal-footer .btn-success {
            background: #1f8f4d;
            border: none;
            border-radius: 5px;
            padding: 6px 18px;
        }

        .modal-footer .btn-danger {
            background: #d63c3c;
            border: none;
            border-radius: 5px;
            padding: 6px 18px;
        }

</style>

<!-- HEADER -->
<div class="row mb-2">
    <div class="card-header">
        Division
    </div>
</div>

<!-- SUCCESS MESSAGE -->
@if (TempData["success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success',
            text: '@TempData["success"]',
            confirmButtonColor: '#198754'
        });
    </script>
}

<!-- CREATE FORM -->
<div class="card mb-3">

    <div class="card-body">

        <form asp-action="Create"
              method="post"
              id="DivisionForm">

            <div class="form-row-custom">

                <!-- COMPANY -->
                <label class="form-label">
                    Company *
                </label>

                <div class="d-flex align-items-center">

                    <select name="CompanyId"
                            id="companyId"
                            class="form-control form-control-sm"
                            style="width:220px;">

                        <option value="">
                            -- Select --
                        </option>

                        @foreach (var item in ViewBag.companydata)
                        {
                            <option value="@item.Value">
                                @item.Text
                            </option>
                        }

                    </select>

                    <!-- F2 F3 -->
                    <div class="shortcut-box">

                        <span id="btnF2"
                              class="shortcut-link">
                            F2 - New
                        </span>

                        <span id="btnF3"
                              class="shortcut-link text-danger">
                            F3 - Mod
                        </span>

                    </div>

                </div>

                <!-- NAME -->
                <label class="form-label">
                    Division *
                </label>

                <input type="text"
                       name="Name"
                       id="divisionName"
                       class="form-control form-control-sm"
                       style="width:250px;" />

                <!-- SAVE -->
                <button type="submit"
                        class="btn btn-primary btn-sm">
                    Save
                </button>

            </div>

        </form>

    </div>

</div>

<!-- TABLE -->
<div class="card">

    <div class="card-body">

        <table id="divisiontable"
               class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>Division</th>
                    <th>Company Name</th>
                    <th width="100"></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.Name</td>

                        <td>@item.Company.Name</td>

                        <td>

                            <div class="btn-group float-end">

                                <!-- EDIT -->
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   title="Edit">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                <!-- DELETE -->
                                <a href="javascript:void(0)"
                                   class="btn-delete"
                                   data-id="@item.Id"
                                   title="Delete">

                                    <i class="bi bi-trash-fill text-danger p-1"></i>

                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<!-- COMPANY MODAL -->
<div class="modal fade"
     id="compModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content custom-modal">

            <div class="modal-header">

                <h4 class="modal-title"
                    id="compModalTitle">
                    Add Company
                </h4>

            </div>

            <div class="modal-body">

                <input type="hidden"
                       id="modalCompId"
                       value="0" />

                <label>Name</label>

                <input type="text"
                       id="modalCompName"
                       class="form-control modal-input" />

                <span id="modalCompError"
                      class="text-danger small">
                </span>

            </div>

            <div class="modal-footer">

                <button class="btn btn-success"
                        id="btnSaveCompModal">
                    Save
                </button>

                <button class="btn btn-danger"
                        data-bs-dismiss="modal">
                    Close
                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            // DATATABLE
            $("#divisiontable").DataTable();

            // FOCUS
            $("#companyId").focus();

            // ======================
            // F2 NEW
            // ======================

            $("#btnF2").click(function () {
                openModal("new");
            });

            // ======================
            // F3 EDIT
            // ======================

            $("#btnF3").click(function () {
                openModal("edit");
            });

            // ======================
            // SHORTCUT KEYS
            // ======================

            $(document).keydown(function (e) {

                if (e.key === "F2") {

                    e.preventDefault();
                    openModal("new");

                }

                if (e.key === "F3") {

                    e.preventDefault();
                    openModal("edit");

                }

            });

            // ======================
            // OPEN MODAL
            // ======================

            function openModal(mode) {

                $("#modalCompError").text("");

                if (mode === "new") {

                    $("#modalCompId").val(0);
                    $("#modalCompName").val("");
                    $("#compModalTitle").text("Add Company");

                }
                else {

                    let id = $("#companyId").val();
                    let text = $("#companyId option:selected").text();

                    if (!id) {

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Please select company first!'
                        });

                        return;
                    }

                    $("#modalCompId").val(id);
                    $("#modalCompName").val(text);
                    $("#compModalTitle").text("Modify Company");

                }

                $("#compModal").modal("show");

                setTimeout(() => {

                    $("#modalCompName").focus();

                }, 200);

            }

            // ======================
            // SAVE COMPANY
            // ======================

            $("#btnSaveCompModal").click(function () {

                let id = $("#modalCompId").val();
                let name = $("#modalCompName").val().trim();

                if (name === "") {

                    $("#modalCompError").text("Name required!");
                    return;

                }

                $.ajax({

                    url: '/Division/QuickSaveCompany',
                    type: 'POST',

                    data: {
                        id: id,
                        name: name
                    },

                    success: function (res) {

                        if (res.success) {

                            $("#compModal").modal('hide');

                            refreshDropdown(res.newId);

                        }
                        else {

                            $("#modalCompError").text(res.message);

                        }

                    }

                });

            });

            // ======================
            // REFRESH DROPDOWN
            // ======================

            function refreshDropdown(selectedId) {

                $.get('/Division/GetCompanies', function (data) {

                    let ddl = $("#companyId");

                    ddl.empty();

                    ddl.append('<option value="">-- Select --</option>');

                    $.each(data, function (i, item) {

                        let opt = $('<option>', {
                            value: item.value,
                            text: item.text
                        });

                        if (item.value == selectedId) {

                            opt.attr('selected', 'selected');

                        }

                        ddl.append(opt);

                    });

                });

            }

            // ======================
            // ENTER KEY SAVE
            // ======================

            $("#modalCompName").keypress(function (e) {

                if (e.which === 13) {

                    $("#btnSaveCompModal").click();

                }

            });

            // ======================
            // SAVE DIVISION
            // ======================

            $("#DivisionForm").on("submit", function (e) {

                e.preventDefault();

                let company = $("#companyId").val();
                let division = $("#divisionName").val().trim();

                // COMPANY VALIDATION
                if (company === "" || company === null) {

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Please select company!'
                    });

                    $("#companyId").focus();

                    return;

                }

                // DIVISION VALIDATION
                if (division === "") {

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Please enter division name!'
                    });

                    $("#divisionName").focus();

                    return;

                }

                let form = this;

                // CONFIRM SAVE
                Swal.fire({

                    title: 'Confirm Save?',
                    text: 'Do you want to save this division?',
                    icon: 'question',

                    showCancelButton: true,

                    confirmButtonText: 'Yes, Save',
                    cancelButtonText: 'Cancel',

                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#dc3545',

                    reverseButtons: true

                }).then((result) => {

                    if (result.isConfirmed) {

                        form.submit();

                    }

                });

            });

            // ======================
            // DELETE
            // ======================

            $(document).on("click", ".btn-delete", function () {

                let id = $(this).data("id");

                Swal.fire({

                    title: 'Confirm Delete?',
                    text: 'Do you want to delete this division?',
                    icon: 'warning',

                    showCancelButton: true,

                    confirmButtonText: 'Yes, Delete',
                    cancelButtonText: 'Cancel',

                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d'

                }).then((result) => {

                    if (result.isConfirmed) {

                        $.ajax({

                            url: '/Division/Delete',
                            type: 'POST',

                            data: {
                                id: id
                            },

                            success: function (res) {

                                if (res.success) {

                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Deleted!',
                                        text: res.message,
                                        timer: 1500,
                                        showConfirmButton: false
                                    });

                                    setTimeout(function () {

                                        location.reload();

                                    }, 1500);

                                }
                                else {

                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Error',
                                        text: res.message
                                    });

                                }

                            },

                            error: function () {

                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: 'Delete failed!'
                                });

                            }

                        });

                    }

                });

            });

        });

    </script>

}