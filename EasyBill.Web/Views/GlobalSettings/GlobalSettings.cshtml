        <div class="settings-panel" id="panel-general">
            <div class="gs-page-title"><i class="bi bi-sliders"></i> General Settings</div>
            <div class="settings-card" style="margin-top:16px"><div class="setting-row"><div class="setting-name" style="color:var(--text-muted)">Coming soon...</div></div></div>
        </div>

        <div class="settings-panel" id="panel-inventory">
            <div class="gs-page-title"><i class="bi bi-box-seam"></i> Inventory Settings</div>
            <div class="settings-card" style="margin-top:16px"><div class="setting-row"><div class="setting-name" style="color:var(--text-muted)">Coming soon...</div></div></div>
        </div>

        <div class="settings-panel" id="panel-loyalty">
            <div class="gs-breadcrumb"><i class="bi bi-house"></i> <span>Settings</span> <i class="bi bi-chevron-right"></i> <span>Loyalty Program</span></div>
            <div class="gs-page-header">
                <div>
                    <div class="gs-page-title"><i class="bi bi-gift"></i> Loyalty Program Settings</div>
                    <div class="gs-page-desc">Configure customer loyalty points earning, redemption thresholds, and campaigns.</div>
                </div>
            </div>
            
            <input type="hidden" id="loyaltySettingId" value="0">

            <div class="settings-card">
                <div class="card-header-strip"><i class="bi bi-toggle-on"></i><span>Loyalty Status</span></div>
                <div class="setting-row">
                    <div class="setting-info">
                        <div class="setting-name">Enable Loyalty Program</div>
                        <div class="setting-hint">Activate customer loyalty points collection and usage</div>
                    </div>
                    <div class="setting-control">
                        <label class="toggle">
                            <input type="checkbox" id="loyaltyIsActive">
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="settings-card">
                <div class="card-header-strip"><i class="bi bi-plus-circle"></i><span>Earning Rules</span></div>
                <div class="setting-row">
                    <div class="setting-info">
                        <div class="setting-name">Points Earning Interval (₹ Amount)</div>
                        <div class="setting-hint">Configure spent money equivalent to 1 point (e.g. ₹100 spend = 1 point)</div>
                    </div>
                    <div class="setting-control">
                        <input type="number" class="num-input" style="width: 120px;" placeholder="e.g. 100" min="1" id="loyaltyEarnPerAmount">
