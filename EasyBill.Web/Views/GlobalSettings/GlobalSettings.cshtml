                <div class="setting-row">
                    <div class="setting-info">
                        <div class="setting-name">Point Cash Value (₹)</div>
                        <div class="setting-hint">Cash value of a single point in rupees (e.g., 1 point = ₹1)</div>
                    </div>
                    <div class="setting-control">
                        <input type="number" class="num-input" style="width: 120px;" placeholder="e.g. 1.0" min="0.01" step="0.01" id="loyaltyPointValueInRs">
                    </div>
                </div>
                <div class="setting-row">
                    <div class="setting-info">
                        <div class="setting-name">Minimum Points to Redeem</div>
                        <div class="setting-hint">Minimum points accumulated before customer is eligible to redeem (e.g. 50 points)</div>
                    </div>
                    <div class="setting-control">
                        <input type="number" class="num-input" style="width: 120px;" placeholder="e.g. 50" min="0" id="loyaltyMinPointsToRedeem">
                    </div>
                </div>
            </div>

            <div class="settings-card">
                <div class="card-header-strip"><i class="bi bi-lightning-charge"></i><span>Campaign & Multipliers</span></div>
                <div class="setting-row">
                    <div class="setting-info">
                        <div class="setting-name">Points Earning Multiplier</div>
                        <div class="setting-hint">Boost points earned (e.g. 2.0 for Double Points festivals). Set 1.0 for standard.</div>
                    </div>
                    <div class="setting-control">
                        <input type="number" class="num-input" style="width: 120px;" placeholder="e.g. 1.0" min="1.0" step="0.1" id="loyaltyEarningMultiplier">
                    </div>
                </div>
                <div class="setting-row">
                    <div class="setting-info">
                        <div class="setting-name">Campaign Duration</div>
                        <div class="setting-hint">Start and end dates for the active loyalty settings campaign</div>
                    </div>
                    <div class="setting-control d-flex gap-2">
                        <input type="date" class="form-control form-control-sm" id="loyaltyStartDate" style="width: 140px;">
                        <span class="align-self-center text-muted">to</span>
                        <input type="date" class="form-control form-control-sm" id="loyaltyEndDate" style="width: 140px;">
