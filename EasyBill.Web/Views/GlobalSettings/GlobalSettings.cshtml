    </main>
</div>

<div class="gs-toast" id="gsToast">
    <i class="bi bi-check-circle-fill"></i> Settings saved successfully!
</div>

@section Scripts {
    <script>
        const userId = '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';

        const PREVIEW_ITEMS = [
            { name: 'Paracetamol 500mg Strip', hsn: '3004', qty: 2, rate: 50, discount: 5, gstPercent: 12 },
            { name: 'Vitamin C Complete', hsn: '2936', qty: 1, rate: 150, discount: 0, gstPercent: 18 },
            { name: 'Cough Syrup 100ml', hsn: '3003', qty: 1, rate: 95, discount: 5, gstPercent: 12 }
        ];

        const PAPER_RULES = {
            A4: {
                logo: { min: 70, max: 220, def: 140 },
                watermark: { min: 180, max: 520, def: 320 },
                watermarkOpacity: { min: 5, max: 35, def: 10 },
                font: { min: 9, max: 16, def: 12 },
                portrait: { w: 794, h: 1123 },
                landscape: { w: 1123, h: 794 },
                margin: { Narrow: 26, Normal: 40, Wide: 56 }
            },
            A5: {
                logo: { min: 60, max: 180, def: 115 },
                watermark: { min: 150, max: 420, def: 250 },
                watermarkOpacity: { min: 5, max: 35, def: 10 },
                font: { min: 9, max: 15, def: 11 },
                portrait: { w: 559, h: 794 },
                landscape: { w: 794, h: 559 },
                margin: { Narrow: 18, Normal: 30, Wide: 42 }
            },
            Thermal: {
                logo: { min: 40, max: 120, def: 70 },
                watermark: { min: 70, max: 220, def: 120 },
                watermarkOpacity: { min: 5, max: 30, def: 8 },
                font: { min: 9, max: 14, def: 10 },
                w58: { w: 219, h: 720 },
                w80: { w: 302, h: 720 },
                margin: { Narrow: 10, Normal: 14, Wide: 18 }
            }
        };

        const FILE_RULES = {
            logo: { maxMb: 2 },
            watermark: { maxMb: 3 },
            signature: { maxMb: 2 }
        };

        function setRadio(name, value) {
            document.querySelectorAll(`input[name="${name}"]`).forEach(r => r.checked = (r.value === value));
        }

        function getRadio(name) {
            const checked = document.querySelector(`input[name="${name}"]:checked`);
            return checked ? checked.value : null;
        }

        function boolVal(v) {
            return v === true || v === "true" || v === 1 || v === "1";
        }

        function showToast(message, isError = false) {
            const toast = document.getElementById('gsToast');
            toast.style.background = isError ? '#ef4444' : '#10b981';
            toast.innerHTML = `<i class="bi bi-${isError ? 'x-circle' : 'check-circle'}-fill"></i> ${message}`;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 2600);
        }

        function clamp(value, min, max, fallback) {
            let n = Number(value);
            if (!Number.isFinite(n)) n = fallback;
            if (n < min) n = min;
            if (n > max) n = max;
            return Math.round(n);
        }

        function fmt(num) {
            const n = Number(num || 0);
            return `Rs ${n.toFixed(2)}`;
        }

        function switchTab(tab, el) {
            document.querySelectorAll('.settings-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.gs-nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById('panel-' + tab).classList.add('active');
            el.classList.add('active');

            const sidebar = document.getElementById('gsSidebar');
            const backBtn = document.getElementById('btnRestoreSidebar');

            if (tab === 'invoicethemes') {
                sidebar.classList.add('collapsed');
                backBtn.classList.add('show');
                setTimeout(updatePreviewSize, 350);
            } else {
                sidebar.classList.remove('collapsed');
                backBtn.classList.remove('show');
            }

            document.querySelectorAll('#panel-' + tab + ' .settings-card').forEach((c, i) => {
                c.style.animation = 'none';
                c.offsetHeight;
                c.style.animation = '';
                c.style.animationDelay = (i * 0.07) + 's';
            });
        }

        function restoreSidebar() {
            document.getElementById('gsSidebar').classList.remove('collapsed');
            document.getElementById('btnRestoreSidebar').classList.remove('show');
            setTimeout(updatePreviewSize, 350);
        }

        function loadSalesSettings() {
            fetch('/SalseSetting/GetSidebarSettings')
                .then(res => res.json())
                .then(data => {
                    document.getElementById('showDoctorInfo').checked = !!data.doctorRequired;
                    document.getElementById('qtyRoundUp').checked = !!data.rateRoundUp;
                    setRadio('barcode', data.itemBarCodeBase ? 'yes' : 'no');
                    setRadio('rateType', data.itemConversion === 'TabletWise' ? 'tablet' : 'strip');
                    setRadio('allowNeg', data.allowNegative ? 'yes' : 'no');
                    document.getElementById('salesExpiryDays').value = data.expiryAllowedDays || '';
                    setRadio('printType', data.printType || 'normal');
                    if (data.printType === 'thermal') setRadio('thermalSize', (data.thermalPaperSize || 80).toString());
                    document.getElementById('salesTax').value = data.salesTax || 1;
                      document.getElementById('showDiscount').checked =
                !!data.showdiscount;
                    toggleThermalOptions();
                })
                .catch(() => showToast('Sales settings load error', true));
        }

        function loadPurchaseSettings() {
            fetch('/PurchaseSetting/GetSidebarSettings')
                .then(res => res.json())
                .then(data => document.getElementById('purchaseExpiryDays').value = data.minPurchaseExpiryDays || '')
                .catch(() => showToast('Purchase settings load error', true));
        }

        function saveCurrentTab() {
            const activePanel = document.querySelector('.settings-panel.active')?.id;
            if (activePanel === 'panel-sales') saveSalesSettings();
            else if (activePanel === 'panel-purchase') savePurchaseSettings();
            else if (activePanel === 'panel-invoicethemes') saveInvoiceTheme();
            else if (activePanel === 'panel-loyalty') saveLoyaltySettings();
            else showToast('Nothing to save here.');
        }

        function saveSalesSettings() {
            const payload = {
                applicationUserId: userId,
                doctorRequired: document.getElementById('showDoctorInfo').checked,
                rateRoundUp: document.getElementById('qtyRoundUp').checked,
                itemBarCodeBase: getRadio('barcode') === 'yes',
                itemConversion: getRadio('rateType') === 'tablet' ? 'TabletWise' : 'StripWise',
                allowNegative: getRadio('allowNeg') === 'yes',
                expiryAllowedDays: parseInt(document.getElementById('salesExpiryDays').value) || 0,
                printType: getRadio('printType'),
                thermalPaperSize: getRadio('printType') === 'thermal' ? parseInt(getRadio('thermalSize') || '80') : null,
                salesTax: parseInt(document.getElementById('salesTax').value), 
                showdiscount: document.getElementById('showDiscount').checked
            };

            fetch('/SalseSetting/SaveSidebarSettings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.ok ? showToast('Sales settings saved!') : showToast('Error saving sales settings!', true))
            .catch(() => showToast('Something went wrong!', true));
        }

        function savePurchaseSettings() {
            const payload = {
                applicationUserId: userId,
                minPurchaseExpiryDays: parseInt(document.getElementById('purchaseExpiryDays').value) || 0
            };

            fetch('/PurchaseSetting/SaveSidebarSettings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.ok ? showToast('Purchase settings saved!') : showToast('Error saving purchase settings!', true))
            .catch(() => showToast('Something went wrong!', true));
        }

        function loadLoyaltySettings() {
            fetch('/LoyaltySetting/GetSettings')
                .then(res => res.json())
                .then(data => {
                    document.getElementById('loyaltySettingId').value = data.id || 0;
                    document.getElementById('loyaltyIsActive').checked = !!data.isActive;
                    document.getElementById('loyaltyEarnPerAmount').value = data.earnPerAmount || '';
                    document.getElementById('loyaltyMinAmountToEarn').value = data.minAmountToEarn || '';
                    document.getElementById('loyaltyAllowRedemption').checked = !!data.allowRedemption;
                    document.getElementById('loyaltyPointValueInRs').value = data.pointValueInRs || '';
                    document.getElementById('loyaltyMinPointsToRedeem').value = data.minPointsToRedeem || '';
                    document.getElementById('loyaltyEarningMultiplier').value = data.earningMultiplier || '1.0';
                    
                    if (data.startDate) {
                        document.getElementById('loyaltyStartDate').value = data.startDate.split('T')[0];
                    }
                    if (data.endDate) {
                        document.getElementById('loyaltyEndDate').value = data.endDate.split('T')[0];
                    }
                })
                .catch(() => showToast('Loyalty settings load error', true));
        }

        function saveLoyaltySettings() {
            const payload = {
                id: parseInt(document.getElementById('loyaltySettingId').value) || 0,
                isActive: document.getElementById('loyaltyIsActive').checked,
                earnPerAmount: parseFloat(document.getElementById('loyaltyEarnPerAmount').value) || 100,
                minAmountToEarn: parseFloat(document.getElementById('loyaltyMinAmountToEarn').value) || 0,
                allowRedemption: document.getElementById('loyaltyAllowRedemption').checked,
                pointValueInRs: parseFloat(document.getElementById('loyaltyPointValueInRs').value) || 1.0,
                minPointsToRedeem: parseInt(document.getElementById('loyaltyMinPointsToRedeem').value) || 0,
                earningMultiplier: parseFloat(document.getElementById('loyaltyEarningMultiplier').value) || 1.0,
                startDate: document.getElementById('loyaltyStartDate').value ? new Date(document.getElementById('loyaltyStartDate').value) : new Date(),
                endDate: document.getElementById('loyaltyEndDate').value ? new Date(document.getElementById('loyaltyEndDate').value) : new Date(new Date().setFullYear(new Date().getFullYear() + 1))
            };

            fetch('/LoyaltySetting/SaveSettings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.ok ? showToast('Loyalty settings saved!') : showToast('Error saving loyalty settings!', true))
            .catch(() => showToast('Something went wrong!', true));
        }

        function getCurrentPaperSize() {
            return document.getElementById('themePaperSize').value || 'A4';
        }

        function getCurrentRules() {
            const size = getCurrentPaperSize();
            return PAPER_RULES[size] || PAPER_RULES.A4;
        }

        function getAssetUrl(path) {
            if (!path) return '';
            if (path.startsWith('http')) return path;
            return '/' + path.replace(/^\/+/, '');
        }

        function withVersion(path) {
            if (!path) return '';
            const sep = path.includes('?') ? '&' : '?';
            return `${path}${sep}v=${Date.now()}`;
        }

        function updateRangeHints() {
            const size = getCurrentPaperSize();
            const rules = getCurrentRules();

            document.getElementById('themeLogoRangeHint').innerText =
                `Safe logo size (${size}): ${rules.logo.min}px - ${rules.logo.max}px`;

            document.getElementById('themeWatermarkRangeHint').innerText =
                `Safe watermark size (${size}): ${rules.watermark.min}px - ${rules.watermark.max}px | Opacity ${rules.watermarkOpacity.min}% - ${rules.watermarkOpacity.max}%`;
        }

        function applyPaperDefaults(force = false) {
            const size = getCurrentPaperSize();
            const rules = getCurrentRules();

            const logoInput = document.getElementById('themeLogoSize');
            const wmInput = document.getElementById('themeWatermarkSize');
            const wmOpInput = document.getElementById('themeWatermarkOpacity');
            const fontInput = document.getElementById('themeBaseFontSize');
            const orientation = document.getElementById('themeOrientation');
            const margin = document.getElementById('themeMargins');
            const fontFamily = document.getElementById('themeFontFamily');
            const thermalRow = document.getElementById('themeThermalPaperSizeRow');

            thermalRow.style.display = size === 'Thermal' ? 'flex' : 'none';

            orientation.disabled = (size === 'Thermal' || size === 'A5');
            if (size === 'Thermal') {
                orientation.value = 'Portrait';
                if (force || !fontFamily.value) fontFamily.value = "'Courier New', monospace";
            } else if (size === 'A5') {
                orientation.value = 'Landscape';
            }

            if (!margin.value) margin.value = 'Normal';

            logoInput.min = rules.logo.min;
            logoInput.max = rules.logo.max;
            wmInput.min = rules.watermark.min;
            wmInput.max = rules.watermark.max;
            wmOpInput.min = rules.watermarkOpacity.min;
            wmOpInput.max = rules.watermarkOpacity.max;
            fontInput.min = rules.font.min;
            fontInput.max = rules.font.max;

            if (force || !logoInput.value) logoInput.value = rules.logo.def;
            if (force || !wmInput.value) wmInput.value = rules.watermark.def;
            if (force || !wmOpInput.value) wmOpInput.value = rules.watermarkOpacity.def;
            if (force || !fontInput.value) fontInput.value = rules.font.def;

            updateRangeHints();
        }

        function normalizeThemeInputs(showMessage = false) {
            const rules = getCurrentRules();

            const logoSize = clamp(document.getElementById('themeLogoSize').value, rules.logo.min, rules.logo.max, rules.logo.def);
            const wmSize = clamp(document.getElementById('themeWatermarkSize').value, rules.watermark.min, rules.watermark.max, rules.watermark.def);
            const wmOpacity = clamp(document.getElementById('themeWatermarkOpacity').value, rules.watermarkOpacity.min, rules.watermarkOpacity.max, rules.watermarkOpacity.def);
            const fontSize = clamp(document.getElementById('themeBaseFontSize').value, rules.font.min, rules.font.max, rules.font.def);

            document.getElementById('themeLogoSize').value = logoSize;
            document.getElementById('themeWatermarkSize').value = wmSize;
            document.getElementById('themeWatermarkOpacity').value = wmOpacity;
            document.getElementById('themeBaseFontSize').value = fontSize;

            const title = document.getElementById('themeTitle');
            const signLabel = document.getElementById('themeSignatoryLabel');

            if (title.value.length > 40) title.value = title.value.slice(0, 40);
            if (signLabel.value.length > 30) signLabel.value = signLabel.value.slice(0, 30);

            if (showMessage) {
                showToast('Theme values normalized to safe range.');
            }
        }

        function validateImageFile(file, key) {
            if (!file) return true;
            const allowed = ['image/png', 'image/jpeg', 'image/webp'];
            if (!allowed.includes(file.type)) {
                showToast('Only PNG/JPEG/WEBP images allowed.', true);
                return false;
            }

            const maxBytes = (FILE_RULES[key]?.maxMb || 2) * 1024 * 1024;
            if (file.size > maxBytes) {
                showToast(`Selected ${key} image is too large.`, true);
                return false;
            }
            return true;
        }

        function setPreviewImage(id, src, displayStyle = 'inline-block') {
            const el = document.getElementById(id);
            if (!el) return;
            if (src) {
                el.src = src;
                el.style.display = displayStyle;
            } else {
                el.src = '';
                el.style.display = 'none';
            }
        }

        function setupImagePreview(inputId, targetIds, key, displayStyle = 'inline-block') {
            const input = document.getElementById(inputId);
            input.addEventListener('change', function (e) {
                const file = e.target.files && e.target.files[0] ? e.target.files[0] : null;
                if (!file) {
                    targetIds.forEach(id => setPreviewImage(id, '', displayStyle));
                    return;
                }

                if (!validateImageFile(file, key)) {
                    input.value = '';
                    targetIds.forEach(id => setPreviewImage(id, '', displayStyle));
                    return;
                }

                const objectUrl = URL.createObjectURL(file);
                targetIds.forEach(id => setPreviewImage(id, objectUrl, displayStyle));
            });
        }

        function switchPaperSize(size, el) {
            document.querySelectorAll('.theme-sub-tab').forEach(t => t.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('themePaperSize').value = size;
            applyPaperDefaults();
            normalizeThemeInputs();
            syncLivePreview();
        }

        function loadInvoiceTheme(size = 'A4') {
            fetch(`/InvoiceTheme/GetTheme?paperSize=${size}`)
                .then(res => res.json())
                .then(result => {
                    const data = result?.data || null;
                    const form = document.getElementById('frmInvoiceTheme');
                    form.reset();

                    const savedPaperSize = data?.paperSize || size;
                    document.querySelectorAll('.theme-sub-tab')
                        .forEach(tab => {
                            tab.classList.remove('active');
                            if (tab.innerText.toLowerCase().includes(savedPaperSize.toLowerCase())) {
                                tab.classList.add('active');
                            }
                        });

                    document.getElementById('themePaperSize').value = savedPaperSize;
                    document.getElementById('themeId').value = data?.id || 0;

                    // Clear stale previews when switching paper or loading a fresh theme.
                    setPreviewImage('prevLogo', '', 'inline-block');
                    setPreviewImage('prevThermalLogo', '', 'block');
                    setPreviewImage('prevWatermark', '', 'block');
                    setPreviewImage('prevSign', '', 'block');
                    setPreviewImage('prevThermalSign', '', 'block');

                    if (data) {
                        document.getElementById('themeIsDefault').value = boolVal(data.isDefault);
                        document.getElementById('themeTemplateName').value = data.templateName || 'Classic';
                        document.getElementById('themeTitle').value = data.title || 'TAX INVOICE';
                        document.getElementById('themeOrientation').value = data.orientation || 'Portrait';
                        document.getElementById('themeMargins').value = data.margins || 'Normal';
                        document.getElementById('themeFontFamily').value = data.fontFamily || 'Arial, sans-serif';
                        document.getElementById('themeBaseFontSize').value = data.baseFontSize || '';
                        document.getElementById('themePrimaryColor').value = data.primaryColor || '#2b6ac9';
                        document.getElementById('themeTextColor').value = data.textColor || '#1e293b';

                        document.getElementById('themeLogoSize').value = data.logoSize || '';
                        document.getElementById('themeLogoPosition').value = data.logoPosition || 'Left';
                        document.getElementById('themeWatermarkSize').value = data.watermarkSize || '';
                        document.getElementById('themeWatermarkOpacity').value = data.watermarkOpacity || '';
                        document.getElementById('themeSignatoryLabel').value = data.signatoryLabel || 'Auth. Signatory';
                        document.getElementById('themeThermalPaperSize').value = (data.thermalPaperSize || 80).toString();

                        document.getElementById('themeShowHSN').checked = boolVal(data.showHSN);
                        document.getElementById('themeShowGSTPercent').checked = boolVal(data.showGSTPercent);
                        document.getElementById('themeShowGSTAmount').checked = boolVal(data.showGSTAmount);
                        document.getElementById('themeShowTaxTable').checked = boolVal(data.showTaxSummaryTable);
                        document.getElementById('themeShowBusinessGSTIN').checked = boolVal(data.showBusinessGSTIN);
                        document.getElementById('themeShowItemDiscount').checked = boolVal(data.showItemDiscount);
                        document.getElementById('themeIsZebraStriped').checked = boolVal(data.isZebraStriped);
                        document.getElementById('themeShowAmountInWords').checked = boolVal(data.showAmountInWords);
                        document.getElementById('themeShowPaymentQR').checked = boolVal(data.showPaymentQR);

                        document.getElementById('themeTNC').value = data.termsAndConditions || '';
                        document.getElementById('themeBank').value = data.bankDetails || '';
                        document.getElementById('themeUPI').value = data.upiDetails || '';

                        const logo = withVersion(getAssetUrl(data.logoPath));
                        const wm = withVersion(getAssetUrl(data.watermarkPath));
                        const sign = withVersion(getAssetUrl(data.signaturePath));

                        setPreviewImage('prevLogo', logo, 'inline-block');
                        setPreviewImage('prevThermalLogo', logo, 'block');
                        setPreviewImage('prevWatermark', wm, 'block');
                        setPreviewImage('prevSign', sign, 'block');
                        setPreviewImage('prevThermalSign', sign, 'block');

                        updateDefaultButtonState(boolVal(data.isDefault), savedPaperSize);
                    } else {
                        document.getElementById('themeIsDefault').value = false;
                        document.getElementById('themeTitle').value = 'TAX INVOICE';
                        document.getElementById('themeSignatoryLabel').value = 'Auth. Signatory';
                        document.getElementById('themeThermalPaperSize').value = '80';

                        document.getElementById('themeShowHSN').checked = false;
                        document.getElementById('themeShowGSTPercent').checked = true;
                        document.getElementById('themeShowGSTAmount').checked = true;
                        document.getElementById('themeShowTaxTable').checked = true;
                        document.getElementById('themeShowBusinessGSTIN').checked = true;
                        document.getElementById('themeShowItemDiscount').checked = true;
                        document.getElementById('themeIsZebraStriped').checked = true;
                        document.getElementById('themeShowAmountInWords').checked = true;
                        document.getElementById('themeShowPaymentQR').checked = false;

                        updateDefaultButtonState(false, savedPaperSize);
                    }

                    applyPaperDefaults(!data);
                    normalizeThemeInputs();
                    syncLivePreview();
                    switchPreviewContainer();
                })
                .catch(() => showToast('Theme load error!', true));
        }

        function saveInvoiceTheme() {
            normalizeThemeInputs(true);

            const form = document.getElementById('frmInvoiceTheme');
            const formData = new FormData(form);
            const paperSize = getCurrentPaperSize();

            formData.set('ShowHSN', document.getElementById('themeShowHSN').checked);
            formData.set('ShowGSTPercent', document.getElementById('themeShowGSTPercent').checked);
            formData.set('ShowGSTAmount', document.getElementById('themeShowGSTAmount').checked);
            formData.set('ShowTaxSummaryTable', document.getElementById('themeShowTaxTable').checked);
            formData.set('ShowBusinessGSTIN', document.getElementById('themeShowBusinessGSTIN').checked);
            formData.set('ShowItemDiscount', document.getElementById('themeShowItemDiscount').checked);
            formData.set('IsZebraStriped', document.getElementById('themeIsZebraStriped').checked);
            formData.set('ShowAmountInWords', document.getElementById('themeShowAmountInWords').checked);
            formData.set('ShowPaymentQR', document.getElementById('themeShowPaymentQR').checked);
            formData.set('PaperSize', paperSize);
            formData.set('Orientation', document.getElementById('themeOrientation').value);

            if (paperSize === 'Thermal') {
                formData.set('ThermalPaperSize', document.getElementById('themeThermalPaperSize').value || '80');
            } else {
                formData.set('ThermalPaperSize', '');
            }

            return fetch('/InvoiceTheme/SaveTheme', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message || 'Theme saved');
                        loadInvoiceTheme(getCurrentPaperSize());
                        return true;
                    } else {
                        showToast(data.message || 'Failed to save theme', true);
                        return false;
                    }
                })
                .catch(() => {
                    showToast('Failed to save theme!', true);
                    return false;
                });
        }

        function makeCurrentThemeDefault() {
            const size = getCurrentPaperSize();
            const currentId = parseInt(document.getElementById('themeId').value || '0');

            const setDefault = () => {
                fetch(`/InvoiceTheme/SetDefaultTheme?paperSize=${size}`, { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast(data.message || 'Default changed');
                            updateDefaultButtonState(true, size);
                        } else {
                            showToast(data.message || 'Default change failed', true);
                        }
                    });
            };

            // If this paper has not been saved yet, save once before setting default.
            if (currentId === 0) {
                saveInvoiceTheme().then(saved => {
                    if (saved) setDefault();
                });
                return;
            }

            setDefault();
        }

        function updateDefaultButtonState(isDefault, size) {
            const btn = document.getElementById('btnMakeDefault');
            if (isDefault) {
                btn.innerHTML = `<i class="bi bi-star-fill"></i> ${size} is your Default Print`;
                btn.classList.add('is-active');
            } else {
                btn.innerHTML = `<i class="bi bi-star"></i> Set as Default Print Size`;
                btn.classList.remove('is-active');
            }
        }

        function setDisplay(selector, show, displayValue = '') {
            document.querySelectorAll(selector).forEach(el => {
                el.style.display = show ? displayValue : 'none';
            });
        }

        function amountToWords(num) {
            const a = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
            const b = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

            function inWords(n) {
                if (n < 20) return a[n];
                if (n < 100) return b[Math.floor(n / 10)] + (n % 10 ? ' ' + a[n % 10] : '');
                if (n < 1000) return a[Math.floor(n / 100)] + ' Hundred' + (n % 100 ? ' ' + inWords(n % 100) : '');
                if (n < 100000) return inWords(Math.floor(n / 1000)) + ' Thousand' + (n % 1000 ? ' ' + inWords(n % 1000) : '');
                if (n < 10000000) return inWords(Math.floor(n / 100000)) + ' Lakh' + (n % 100000 ? ' ' + inWords(n % 100000) : '');
                return inWords(Math.floor(n / 10000000)) + ' Crore' + (n % 10000000 ? ' ' + inWords(n % 10000000) : '');
            }

            const rupees = Math.floor(num);
            const paise = Math.round((num - rupees) * 100);

            const rupeeWords = rupees ? inWords(rupees) + ' Rupees' : 'Zero Rupees';
            const paiseWords = paise ? ' and ' + inWords(paise) + ' Paise' : '';
            return rupeeWords + paiseWords + ' Only';
        }

        function renderPreviewRowsAndTotals() {
            const showHSN = document.getElementById('themeShowHSN').checked;
            const showDisc = document.getElementById('themeShowItemDiscount').checked;
            const showGSTP = document.getElementById('themeShowGSTPercent').checked;
            const showGSTA = document.getElementById('themeShowGSTAmount').checked;

            let subTotal = 0;
            let totalDiscount = 0;
            let taxable = 0;
            let totalGST = 0;

            const a4Body = document.getElementById('prevItemsBody');
            const thermalBody = document.getElementById('prevThermalItemsBody');
            a4Body.innerHTML = '';
            thermalBody.innerHTML = '';

            PREVIEW_ITEMS.forEach((item, idx) => {
                const gross = item.qty * item.rate;
                const disc = item.discount;
                const netTaxable = gross - disc;
                const gst = netTaxable * item.gstPercent / 100;
                const finalAmt = netTaxable + gst;

                subTotal += gross;
                totalDiscount += disc;
                taxable += netTaxable;
                totalGST += gst;

                const row = document.createElement('tr');
                row.innerHTML = `
                    <td class="t-center">${idx + 1}</td>
                    <td>${item.name}</td>
                    <td class="col-hsn">${item.hsn}</td>
                    <td class="t-right">${item.qty}</td>
                    <td class="t-right">${fmt(item.rate)}</td>
                    <td class="col-disc t-right">${fmt(disc)}</td>
                    <td class="col-gstp t-right">${item.gstPercent}%</td>
                    <td class="col-gsta t-right">${fmt(gst)}</td>
                    <td class="t-right">${fmt(finalAmt)}</td>
                `;
                a4Body.appendChild(row);

                const thermalRateLine = `${item.qty} x ${fmt(item.rate)}`;
                const thermalSubParts = [];
                if (showHSN) thermalSubParts.push(`HSN:${item.hsn}`);
                if (showGSTP) thermalSubParts.push(`GST:${item.gstPercent}%`);
                if (showGSTA) thermalSubParts.push(`GSTAmt:${fmt(gst)}`);
                if (showDisc && disc > 0) thermalSubParts.push(`Disc:${fmt(disc)}`);
                const thermalSubText = thermalSubParts.join(' | ');

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="thermal-item-name">
                        <span class="thermal-item-main">${item.name}</span>
                        <span class="thermal-item-sub">${thermalRateLine}</span>
                        ${thermalSubText ? `<span class="thermal-item-sub thermal-item-sub-2">${thermalSubText}</span>` : ''}
                    </td>
                    <td class="thermal-col-qty">${item.qty}</td>
                    <td class="thermal-col-amt">${fmt(finalAmt)}</td>
                `;
                thermalBody.appendChild(tr);
            });

            const totalPayable = taxable + totalGST;

            document.getElementById('prevSubTotal').innerText = fmt(subTotal);
            document.getElementById('prevDiscountTotal').innerText = fmt(totalDiscount);
            document.getElementById('prevTaxableTotal').innerText = fmt(taxable);
            document.getElementById('prevGstTotal').innerText = fmt(totalGST);
            document.getElementById('prevGrandTotal').innerText = fmt(totalPayable);

            document.getElementById('prevThermalSubTotal').innerText = fmt(subTotal);
            document.getElementById('prevThermalDiscountTotal').innerText = fmt(totalDiscount);
            document.getElementById('prevThermalGstTotal').innerText = fmt(totalGST);
            document.getElementById('prevThermalGrandTotal').innerText = fmt(totalPayable);

            document.getElementById('prevCGST').innerText = fmt(totalGST / 2);
            document.getElementById('prevSGST').innerText = fmt(totalGST / 2);
            document.getElementById('prevIGST').innerText = fmt(0);
            document.getElementById('prevTaxableForCGST').innerText = fmt(taxable);
            document.getElementById('prevTaxableForSGST').innerText = fmt(taxable);
            document.getElementById('prevTaxableForIGST').innerText = fmt(taxable);

            document.getElementById('prevThermalCGST').innerText = fmt(totalGST / 2);
            document.getElementById('prevThermalSGST').innerText = fmt(totalGST / 2);
            document.getElementById('prevThermalIGST').innerText = fmt(0);

            document.getElementById('prevAmountWords').innerText = amountToWords(totalPayable);

            setDisplay('.col-hsn', showHSN, 'table-cell');
            setDisplay('.col-disc', showDisc, 'table-cell');
            setDisplay('.col-gstp', showGSTP, 'table-cell');
            setDisplay('.col-gsta', showGSTA, 'table-cell');

            document.getElementById('prevDiscountRow').style.display = showDisc ? '' : 'none';
            document.getElementById('prevThermalDiscountRow').style.display = showDisc ? '' : 'none';

            const showGstSummary = showGSTA || document.getElementById('themeShowTaxTable').checked;
            document.getElementById('prevGstRow').style.display = showGstSummary ? '' : 'none';
            document.getElementById('prevThermalGstRow').style.display = showGstSummary ? '' : 'none';
        }

        function switchPreviewContainer() {
            const size = getCurrentPaperSize();
            const a4 = document.getElementById('prevA4Container');
            const thermal = document.getElementById('prevThermalContainer');

            if (size === 'Thermal') {
                a4.style.display = 'none';
                thermal.style.display = 'block';
            } else {
                a4.style.display = 'block';
                thermal.style.display = 'none';
            }

            updatePreviewSize();
        }

        function getActivePaperElement() {
            return getCurrentPaperSize() === 'Thermal'
                ? document.getElementById('prevThermalContainer')
                : document.getElementById('prevA4Container');
        }

        function updatePreviewSize() {
            const size = getCurrentPaperSize();
            const orientation = document.getElementById('themeOrientation').value;
            const thermalWidth = document.getElementById('themeThermalPaperSize').value || '80';

            const paper = getActivePaperElement();
            const desk = document.getElementById('paperDesk');

            paper.style.transform = 'none';

            let realWidth = 794;
            let realHeight = 1123;

            if (size === 'A4') {
                realWidth = PAPER_RULES.A4[orientation.toLowerCase()]?.w || PAPER_RULES.A4.portrait.w;
                realHeight = PAPER_RULES.A4[orientation.toLowerCase()]?.h || PAPER_RULES.A4.portrait.h;
            } else if (size === 'A5') {
                realWidth = PAPER_RULES.A5[orientation.toLowerCase()]?.w || PAPER_RULES.A5.portrait.w;
                realHeight = PAPER_RULES.A5[orientation.toLowerCase()]?.h || PAPER_RULES.A5.portrait.h;
            } else {
                const rule = thermalWidth === '58' ? PAPER_RULES.Thermal.w58 : PAPER_RULES.Thermal.w80;
                realWidth = rule.w;
                realHeight = rule.h;
            }

            paper.style.width = realWidth + 'px';
            paper.style.minHeight = realHeight + 'px';

            const availableWidth = desk.clientWidth - 40;
            let scale = availableWidth / realWidth;
            if (scale > 1) scale = 1;

            paper.style.transform = `scale(${scale})`;
            desk.style.height = (realHeight * scale + 40) + 'px';
        }

        function syncLivePreview() {
            applyPaperDefaults();
            normalizeThemeInputs();

            const paperSize = getCurrentPaperSize();
            const rules = getCurrentRules();

            const title = document.getElementById('themeTitle').value || 'TAX INVOICE';
            const font = document.getElementById('themeFontFamily').value || 'Arial, sans-serif';
            const baseSize = clamp(document.getElementById('themeBaseFontSize').value, rules.font.min, rules.font.max, rules.font.def);
            const primaryColor = document.getElementById('themePrimaryColor').value || '#2b6ac9';
            const textColor = document.getElementById('themeTextColor').value || '#1e293b';
            const logoSize = clamp(document.getElementById('themeLogoSize').value, rules.logo.min, rules.logo.max, rules.logo.def);
            const wmSize = clamp(document.getElementById('themeWatermarkSize').value, rules.watermark.min, rules.watermark.max, rules.watermark.def);
            const wmOpacity = clamp(document.getElementById('themeWatermarkOpacity').value, rules.watermarkOpacity.min, rules.watermarkOpacity.max, rules.watermarkOpacity.def);
            const signLabel = document.getElementById('themeSignatoryLabel').value || 'Auth. Signatory';
            const tnc = document.getElementById('themeTNC').value || '1. Goods once sold will not be taken back.';
            const bank = document.getElementById('themeBank').value || 'Bank: SBI | A/C: XXXXX | IFSC: SBINXXXX';
            const upi = document.getElementById('themeUPI').value || '';
            const marginValue = document.getElementById('themeMargins').value || 'Normal';
            const thermalWidth = document.getElementById('themeThermalPaperSize').value || '80';

            document.getElementById('prevTitle').innerText = title;
            document.getElementById('prevThermalTitle').innerText = title;

            document.getElementById('prevA4Container').style.fontFamily = font;
            document.getElementById('prevA4Container').style.fontSize = baseSize + 'px';
            document.getElementById('prevA4Container').style.color = textColor;

            const thermalPreview = document.getElementById('prevThermalContainer');
            thermalPreview.classList.toggle('is-58', thermalWidth === '58');
            thermalPreview.classList.toggle('is-80', thermalWidth !== '58');
            thermalPreview.style.fontFamily = paperSize === 'Thermal' ? font : "'Courier New', monospace";
            thermalPreview.style.fontSize = (thermalWidth === '58' ? Math.max(baseSize - 2, 8) : Math.max(baseSize - 1, 9)) + 'px';

            document.getElementById('prevHeaderBorder').style.borderColor = primaryColor;
            document.getElementById('prevTitle').style.color = primaryColor;
            document.getElementById('prevGrandTotal').style.color = primaryColor;

            document.getElementById('prevTableHeader').style.backgroundColor = primaryColor + '1F';

            const marginPx = (paperSize === 'Thermal')
                ? PAPER_RULES.Thermal.margin[marginValue] || PAPER_RULES.Thermal.margin.Normal
                : (rules.margin[marginValue] || rules.margin.Normal);

            document.getElementById('prevA4Container').style.padding = `${marginPx}px`;

            document.getElementById('prevSignLabel').innerText = signLabel;
            document.getElementById('prevThermalSignLabel').innerText = signLabel;
            document.getElementById('prevTNC').innerText = tnc;
            document.getElementById('prevThermalTNC').innerText = tnc;
            document.getElementById('prevBank').innerText = bank;

            document.getElementById('prevUpiText').innerText = upi || 'upi@bank';
            document.getElementById('prevQrWrap').style.display =
                (document.getElementById('themeShowPaymentQR').checked && upi) ? 'flex' : 'none';

            const logoAlign = (document.getElementById('themeLogoPosition').value || 'Left').toLowerCase();
            document.getElementById('prevLogoContainer').style.textAlign = logoAlign;
            document.getElementById('prevLogo').style.width = logoSize + 'px';
            const thermalLogoSize = thermalWidth === '58'
                ? Math.min(Math.max(Math.floor(logoSize * 0.48), 34), 56)
                : Math.min(Math.max(Math.floor(logoSize * 0.65), 45), 96);
            document.getElementById('prevThermalLogo').style.width = thermalLogoSize + 'px';

            document.getElementById('prevWatermark').style.width = wmSize + 'px';
            document.getElementById('prevWatermark').style.opacity = (wmOpacity / 100).toString();

            document.getElementById('prevBusinessGSTIN').style.display =
                document.getElementById('themeShowBusinessGSTIN').checked ? 'inline' : 'none';
            document.getElementById('prevThermalGstin').style.display =
                document.getElementById('themeShowBusinessGSTIN').checked ? 'inline' : 'none';

            document.getElementById('prevTaxTable').style.display =
                document.getElementById('themeShowTaxTable').checked ? 'block' : 'none';

            document.getElementById('prevThermalTaxTable').style.display =
                document.getElementById('themeShowTaxTable').checked ? 'block' : 'none';

            document.getElementById('prevAmountWordsWrap').style.display =
                document.getElementById('themeShowAmountInWords').checked ? 'block' : 'none';

            document.getElementById('prevTable').classList.toggle('table-zebra-off', !document.getElementById('themeIsZebraStriped').checked);

            renderPreviewRowsAndTotals();
            switchPreviewContainer();
            setTimeout(updatePreviewSize, 50);
        }

        function initLivePreview() {
            const ids = [
                'themeTitle', 'themeTemplateName', 'themeOrientation', 'themeMargins',
                'themeFontFamily', 'themeBaseFontSize', 'themePrimaryColor', 'themeTextColor',
                'themeLogoSize', 'themeLogoPosition', 'themeWatermarkSize', 'themeWatermarkOpacity',
                'themeSignatoryLabel', 'themeTNC', 'themeBank', 'themeUPI',
                'themeShowHSN', 'themeShowGSTPercent', 'themeShowGSTAmount', 'themeShowTaxTable',
                'themeShowBusinessGSTIN', 'themeShowItemDiscount', 'themeIsZebraStriped',
                'themeShowAmountInWords', 'themeShowPaymentQR', 'themeThermalPaperSize'
            ];

            ids.forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                el.addEventListener('input', syncLivePreview);
                el.addEventListener('change', syncLivePreview);
            });

            setupImagePreview('themeLogo', ['prevLogo', 'prevThermalLogo'], 'logo', 'inline-block');
            setupImagePreview('themeWatermark', ['prevWatermark'], 'watermark', 'block');
            setupImagePreview('themeSignature', ['prevSign', 'prevThermalSign'], 'signature', 'block');

            window.addEventListener('resize', updatePreviewSize);
            syncLivePreview();
        }

        document.addEventListener("DOMContentLoaded", function () {
            loadSalesSettings();
            loadPurchaseSettings();
            loadInvoiceTheme('A4');
            loadLoyaltySettings();

            initLivePreview();
            toggleThermalOptions();
        });

        document.querySelectorAll('input[name="printType"]').forEach(r => {
            r.addEventListener('change', toggleThermalOptions);
        });

        document.querySelectorAll('input[name="thermalSize"]').forEach(r => {
            r.addEventListener('change', updatePreviewSize);
        });

        function toggleThermalOptions() {
            const isThermal = getRadio('printType') === 'thermal';
            document.getElementById('thermalOptions').style.display = isThermal ? 'flex' : 'none';
        }
    </script>
}
