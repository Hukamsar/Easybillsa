                <div class="setting-row">
                    <div class="setting-info">
                        <div class="setting-name">Minimum Amount to Earn</div>
                        <div class="setting-hint">Minimum bill value required to start earning points</div>
                    </div>
                    <div class="setting-control">
                        <input type="number" class="num-input" style="width: 120px;" placeholder="e.g. 100" min="0" id="loyaltyMinAmountToEarn">
