                        <div class="setting-name">Allow Point Redemption</div>
                        <div class="setting-hint">Allow customers to pay using their accumulated loyalty points</div>
                    </div>
                    <div class="setting-control">
                        <label class="toggle">
                            <input type="checkbox" id="loyaltyAllowRedemption">
                            <span class="toggle-slider"></span>
