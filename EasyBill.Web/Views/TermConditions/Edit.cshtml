@using EasyBill.Models.ViewModels
@model TermConditionsVM

@{
    ViewData["Title"] = "Index";
}
<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }
</style>

<div class="card mb-3">
    <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
        Edit Term & Conditions
    </div>
    <div class="card-body">
        <form method="post" asp-controller="TermConditions" asp-action="Edit" id="TremForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="row">

                <div class="col-md-4 d-flex align-items-center mb-2">
                    <label asp-for="Name" class="me-2 mb-0" style="width: 100px;">Name</label>
                    <input type="text" asp-for="Name" class="form-control form-control-sm" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-sm btn-primary btnBright-Sky-Blue mt-3">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            let isSubmitting = false;

            $("#TremForm").on("submit", function (e) {

                if (isSubmitting) return false;

                e.preventDefault();

                var form = this;
                var Name = $("#Name").val()?.trim();
                var id = $("#Id").val();

                if (!Name) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Please enter Name!',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#3085d6'
                    });
                    return;
                }

                $.ajax({
                    url: "/TermConditions/CheckDuplicate",
                    type: "GET",
                    data: {
                        Name: Name,
                        id: id
                    },
                    success: function (response) {

                        if (response.exists) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Warning',
                                text: 'Already Exists',
                                confirmButtonText: 'OK',
                                confirmButtonColor: '#3085d6'
                            });
                        } else {
                            Swal.fire({
                                title: 'Are you sure?',
                                text: "Do you want to update this record?",
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonText: 'Yes, update it!',
                                cancelButtonText: 'Cancel',
                                confirmButtonColor: '#3085d6',
                                cancelButtonColor: '#d33'
                            }).then((result) => {

                                if (result.isConfirmed) {
                                    isSubmitting = true;
                                    form.submit();
                                }

                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Error checking duplicate',
                            confirmButtonText: 'OK',
                            confirmButtonColor: '#3085d6'
                        });
                    }
                });
            });
        });
    </script>
}

@if (TempData["success"] != null)
{
    <script>
        Swal.fire({
            title: 'Success!',
            text: '@TempData["success"]',
            icon: 'success',
            confirmButtonText: 'OK',
            confirmButtonColor: '#3085d6'
        });
    </script>
}