<div class="modal fade" id="receivablesModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="border-radius:16px; border:none;">

            <!-- Header -->
            <div class="modal-header border-0 pb-0"
                 style="background:linear-gradient(135deg,#2ecc71,#27ae60); border-radius:16px 16px 0 0;">
                <div>
                    <h5 class="modal-title text-white fw-bold">
                        <i class="bi bi-arrow-down-circle-fill me-2"></i>Receivables
                    </h5>
                    <div class="text-white opacity-75" style="font-size:0.78rem;">
                        Pending payment customers
                    </div>
                </div>
                <div class="ms-auto text-end me-3">
                    <div class="text-white opacity-75" style="font-size:0.72rem;">Total Pending</div>
                    <div class="text-white fw-bold fs-5">₹ @Model.TotalReceiveable.ToString("N0")</div>
                </div>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="font-size:0.82rem;">
                        <thead style="background:#f8fafc; position:sticky; top:0; z-index:1;">
                            <tr>
                                <th class="px-3 py-2 text-muted fw-semibold">#</th>
                                <th class="px-3 py-2 text-muted fw-semibold">Customer</th>
                                <th class="px-3 py-2 text-muted fw-semibold">Bill No</th>
                                <th class="px-3 py-2 text-muted fw-semibold">Bill Date</th>
                                <th class="px-3 py-2 text-muted fw-semibold text-end">Total</th>
                                <th class="px-3 py-2 text-muted fw-semibold text-end">Paid</th>
                                <th class="px-3 py-2 text-muted fw-semibold text-end">Balance</th>
                                <th class="px-3 py-2 text-muted fw-semibold text-center">Pending Days</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ReceivableDetails != null && Model.ReceivableDetails.Any())
                            {
                                int sr = 1;
                                foreach (var item in Model.ReceivableDetails)
                                {
                                    var badgeColor = item.DaysPending <= 7 ? "#2ecc71"
                                    : item.DaysPending <= 30 ? "#f39c12"
                                    : "#e74c3c";
                                    <tr>
                                        <td class="px-3">@sr</td>
                                        <td class="px-3">
                                            <div class="fw-semibold">@item.Name</div>
                                            <div class="text-muted" style="font-size:0.72rem;">
                                                <i class="bi bi-phone me-1"></i>@item.PhoneNo
                                            </div>
                                        </td>
                                        <td class="px-3">@item.BillNo</td>
                                        <td class="px-3">@item.BillDate.ToString("dd MMM yyyy")</td>
                                        <td class="px-3 text-end">₹ @item.TotalPayable.ToString("N0")</td>
                                        <td class="px-3 text-end text-success">₹ @item.PaidAmount.ToString("N0")</td>
                                        <td class="px-3 text-end fw-bold text-danger">₹ @item.Balance.ToString("N0")</td>
                                        <td class="px-3 text-center">
                                            <span class="badge rounded-pill px-2"
                                                  style="background:@badgeColor; font-size:0.72rem;">
                                                @item.DaysPending days
                                            </span>
                                        </td>
                                    </tr>
                                    sr++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <i class="bi bi-check-circle-fill text-success fs-4 d-block mb-2"></i>
                                        Koi pending receivable nahi hai! 🎉
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 justify-content-between"
                 style="background:#f8fafc; border-radius:0 0 16px 16px;">
                <div class="text-muted" style="font-size:0.78rem;">
                    🟢 0-7 days &nbsp;
                    🟡 8-30 days &nbsp;
                    🔴 30+ days
                </div>
                <button type="button" class="btn btn-sm btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

