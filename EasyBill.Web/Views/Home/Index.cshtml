@using EasyBill.Models.ViewModels
@using Newtonsoft.Json
@model DashboardVM

<style>
    /* ── FONTS ─────────────────────────────────────────────── */
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    body, .card, .card-body, .card-title, label, span, div {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
    }

    /* ── PAGE BACKGROUND ───────────────────────────────────── */
    .app-content, .container-fluid {
        background: #f1f5f9 !important;
    }

    /* ══════════════════════════════════════════════════════════
                               ANIMATIONS
                            ══════════════════════════════════════════════════════════ */
    @@keyframes fadeSlideUp {
        from {
            opacity: 0;
            transform: translateY(22px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeSlideDown {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes countUp {
        from {
            opacity: 0;
            transform: scale(.85);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes shimmer {
        0% {
            background-position: -400px 0;
        }

        100% {
            background-position: 400px 0;
        }
    }

    @@keyframes pulse-ring {
        0% {
            box-shadow: 0 0 0 0 rgba(255,255,255,.35);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(255,255,255,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(255,255,255,0);
        }
    }

    /* ── FILTER BAR ─────────────────────────────────────────── */
    form.row {
        background: #fff;
        border-radius: 14px;
        padding: 14px 20px !important;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        animation: fadeSlideDown .45s ease both;
    }

    form .form-control-sm {
        border-radius: 8px !important;
        border: 1.5px solid #e2e8f0 !important;
        font-size: .82rem !important;
        transition: border-color .2s, box-shadow .2s !important;
    }

        form .form-control-sm:focus {
            border-color: #1d4ed8 !important;
            box-shadow: 0 0 0 3px rgba(29,78,216,.1) !important;
        }

    form .btn-primary {
        background: linear-gradient(135deg, #1d4ed8, #6d28d9) !important;
        border: none !important;
        border-radius: 8px !important;
        font-weight: 600 !important;
        padding: 6px 18px !important;
        transition: opacity .2s, transform .15s !important;
    }

        form .btn-primary:hover {
            opacity: .88 !important;
            transform: translateY(-1px) !important;
        }

    form .btn-outline-secondary {
        border-radius: 8px !important;
        font-weight: 500 !important;
        transition: all .2s !important;
    }

        form .btn-outline-secondary:hover {
            border-color: #ef4444 !important;
            color: #ef4444 !important;
            background: transparent !important;
        }

    /* ══════════════════════════════════════════════════════════
                               MAIN TOP CARDS (Sales, Purchase, Profit, Discount)
                            ══════════════════════════════════════════════════════════ */
    .dashboard-card {
        border-radius: 16px !important;
        border: none !important;
        box-shadow: 0 4px 20px rgba(0,0,0,.12) !important;
        transition: transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .25s ease !important;
        animation: fadeSlideUp .5s ease both;
        overflow: hidden;
        position: relative;
    }

    /* Staggered animation delay for 4 cards */
    .row.g-4.mb-4 > .col-md-3:nth-child(1) .dashboard-card {
        animation-delay: .05s;
    }

    .row.g-4.mb-4 > .col-md-3:nth-child(2) .dashboard-card {
        animation-delay: .12s;
    }

    .row.g-4.mb-4 > .col-md-3:nth-child(3) .dashboard-card {
        animation-delay: .19s;
    }

    .row.g-4.mb-4 > .col-md-3:nth-child(4) .dashboard-card {
        animation-delay: .26s;
    }

    .dashboard-card:hover {
        transform: translateY(-6px) scale(1.01) !important;
        box-shadow: 0 16px 40px rgba(0,0,0,.18) !important;
    }

    /* Decorative blur orb on each card */
    .dashboard-card::before {
        content: '';
        position: absolute;
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: rgba(255,255,255,.08);
        bottom: -35px;
        right: -35px;
        pointer-events: none;
    }

    .dashboard-card::after {
        content: '';
        position: absolute;
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(255,255,255,.06);
        top: -20px;
        left: 120px;
        pointer-events: none;
    }

    /* Icon circle pulse on hover */
    .dashboard-card:hover .rounded-circle {
        animation: pulse-ring 1s ease-out;
    }

    /* Number count-up reveal */
    .dashboard-card .fw-bold {
        animation: countUp .4s ease both;
    }

    /* Month boxes */
    .dashboard-card .flex-fill {
        border-radius: 10px !important;
        transition: background .2s !important;
    }

    .dashboard-card:hover .flex-fill[style*="0.15"] {
        background: rgba(255,255,255,.22) !important;
    }

    .dashboard-card:hover .flex-fill[style*="0.10"] {
        background: rgba(255,255,255,.16) !important;
    }

    /* Badge pill */
    .dashboard-card .badge {
        font-size: .7rem !important;
        font-weight: 700 !important;
        letter-spacing: .2px;
        transition: transform .2s;
    }

    .dashboard-card:hover .badge {
        transform: scale(1.08);
    }

    /* ══════════════════════════════════════════════════════════
                               RIGHT SIDE INFO CARDS (Qty, Avg, Return)
                            ══════════════════════════════════════════════════════════ */
    .col-lg-3 .card {
        border-radius: 12px !important;
        border-left-width: 4px !important;
        border-top: none !important;
        border-right: none !important;
        border-bottom: none !important;
        transition: transform .22s ease, box-shadow .22s ease !important;
        animation: fadeSlideUp .5s ease both;
    }

        .col-lg-3 .card:nth-child(1) {
            animation-delay: .1s;
        }

        .col-lg-3 .card:nth-child(2) {
            animation-delay: .17s;
        }

        .col-lg-3 .card:nth-child(3) {
            animation-delay: .24s;
        }

        .col-lg-3 .card:nth-child(4) {
            animation-delay: .31s;
        }

        .col-lg-3 .card:hover {
            transform: translateX(4px) !important;
            box-shadow: 0 6px 24px rgba(0,0,0,.1) !important;
        }

        .col-lg-3 .card .rounded-2 {
            transition: background .2s !important;
        }

        .col-lg-3 .card:hover .rounded-2 {
            background: #eef2ff !important;
        }

        .col-lg-3 .card .fw-bold {
            animation: countUp .45s ease both;
        }

    /* ══════════════════════════════════════════════════════════
                               CHART CARDS
                            ══════════════════════════════════════════════════════════ */
    .col-lg-9 .card,
    .col-lg-6 .card {
        border-radius: 16px !important;
        border: none !important;
        box-shadow: 0 2px 16px rgba(0,0,0,.07) !important;
        animation: fadeSlideUp .5s .2s ease both;
        transition: box-shadow .25s !important;
    }

        .col-lg-9 .card:hover,
        .col-lg-6 .card:hover {
            box-shadow: 0 8px 32px rgba(0,0,0,.11) !important;
        }

    .card-header {
        background: transparent !important;
        border-bottom: 1px solid #f1f5f9 !important;
        padding: 16px 20px 12px !important;
    }

    .card-title {
        font-size: .95rem !important;
        font-weight: 700 !important;
        color: #1e293b !important;
    }

    /* ══════════════════════════════════════════════════════════
                               STOCK OVERVIEW CARDS
                            ══════════════════════════════════════════════════════════ */
    .row.g-3.mb-4 .card {
        border-radius: 14px !important;
        border-top: none !important;
        border-right: none !important;
        border-bottom: none !important;
        border-left-width: 4px !important;
        transition: transform .22s cubic-bezier(.34,1.56,.64,1), box-shadow .22s ease !important;
        animation: fadeSlideUp .5s ease both;
        cursor: default;
    }

    .row.g-3.mb-4 .col-md-2:nth-child(1) .card {
        animation-delay: .05s;
    }

    .row.g-3.mb-4 .col-md-2:nth-child(2) .card {
        animation-delay: .1s;
    }

    .row.g-3.mb-4 .col-md-2:nth-child(3) .card {
        animation-delay: .15s;
    }

    .row.g-3.mb-4 .col-md-3:nth-child(4) .card {
        animation-delay: .2s;
    }

    .row.g-3.mb-4 .col-md-3:nth-child(5) .card {
        animation-delay: .25s;
    }

    .row.g-3.mb-4 .card:hover {
        transform: translateY(-5px) scale(1.02) !important;
        box-shadow: 0 12px 28px rgba(0,0,0,.12) !important;
    }

    .row.g-3.mb-4 .card i {
        transition: transform .3s ease !important;
    }

    .row.g-3.mb-4 .card:hover i {
        transform: scale(1.25) rotate(-5deg) !important;
    }

    .row.g-3.mb-4 .card .fw-bold {
        animation: countUp .4s ease both;
    }

    /* Stock section heading */
    h5.fw-semibold.text-muted {
        font-size: 1rem !important;
        font-weight: 700 !important;
        color: #475569 !important;
        letter-spacing: .3px;
        animation: fadeSlideDown .4s ease both;
    }

</style>
<style>
    /* ── Intro.js Custom Styling ── */
    .introjs-tooltip {
        border-radius: 14px !important;
        box-shadow: 0 20px 60px rgba(0,0,0,0.25) !important;
        border: none !important;
        min-width: 280px !important;
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        padding: 0 !important;
        overflow: hidden !important;
    }

    .introjs-tooltip-header {
        background: linear-gradient(135deg, #1565c0, #1e88e5) !important;
        padding: 14px 18px !important;
        border-radius: 14px 14px 0 0 !important;
    }

    .introjs-tooltiptext {
        padding: 16px 18px !important;
        font-size: 0.85rem !important;
        color: #334155 !important;
        line-height: 1.6 !important;
    }

    .introjs-tooltipbuttons {
        padding: 10px 16px 14px !important;
        border-top: 1px solid #f1f5f9 !important;
        display: flex !important;
        gap: 8px !important;
        justify-content: flex-end !important;
    }

    .introjs-button {
        border-radius: 8px !important;
        font-size: 0.8rem !important;
        font-weight: 600 !important;
        padding: 7px 16px !important;
        border: none !important;
        cursor: pointer !important;
        text-shadow: none !important;
    }

    .introjs-nextbutton {
        background: linear-gradient(135deg, #1565c0, #1e88e5) !important;
        color: #fff !important;
    }

        .introjs-nextbutton:hover {
            background: linear-gradient(135deg, #0d47a1, #1565c0) !important;
            color: #fff !important;
        }

    .introjs-prevbutton {
        background: #f1f5f9 !important;
        color: #475569 !important;
    }

    .introjs-skipbutton {
        color: rgba(255,255,255,0.8) !important;
        font-size: 1rem !important;
        top: 10px !important;
        right: 12px !important;
    }

        .introjs-skipbutton:hover {
            color: #fff !important;
        }

    .introjs-title {
        color: #fff !important;
        font-size: 0.95rem !important;
        font-weight: 700 !important;
    }

    .introjs-progressbar {
        background: linear-gradient(90deg, #1e88e5, #42a5f5) !important;
        height: 4px !important;
        border-radius: 2px !important;
    }

    .introjs-progress {
        background: #e2e8f0 !important;
        height: 4px !important;
        border-radius: 2px !important;
        margin: 0 18px 12px !important;
    }

    .introjs-helperLayer {
        border-radius: 12px !important;
        box-shadow: rgba(33,33,33,0.5) 0 0 1px 2px, rgba(33,33,33,0.5) 0 0 0 5000px !important;
    }

    .introjs-arrow {
        display: none !important;
    }

    /* ── PREMIUM DASHBOARD CARDS CSS ── */
    .mnc-dash-card {
        border: none !important;
        border-radius: 12px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
    }

    .mnc-dash-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.25);
    }

    /* Glassmorphism for Inner Boxes */
    .glass-box {
    /*     background: rgba(255, 255, 255, 0.12); */
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid #f5f1f1;
    }

    .glass-icon {
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.25);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
</style>

<div class="app-content">
    <div class="container-fluid">

        <!--Filter-->
        <div class="row g-4 mb-3">

            @*             <div class="col-md-12">
                <form method="get" asp-action="Index" class="row g-2 mb-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small">From Date</label>
                        <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">To Date</label>
                        <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-sm btn-primary">Apply Filter</button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-1">Reset</a>
                    </div>
                </form>
            </div> *@

            <div class="col-md-12">

                <div class="filter-animated-wrapper" style="position:relative; border-radius:16px; overflow:hidden; box-shadow: 0 4px 24px rgba(30,86,189,0.18);">

                    <!-- Animated Background -->
                    <div style="
            position:absolute; inset:0; z-index:0;
            background: linear-gradient(120deg, #1565c0 0%, #1976d2 35%, #0d47a1 65%, #1a237e 100%);
            border-radius:16px; overflow:hidden;">

                        <!-- Floating SVG pharmacy/billing icons -->
                        <svg width="100%" height="100%" viewBox="0 0 1100 90" preserveAspectRatio="xMidYMid slice"
                             xmlns="http://www.w3.org/2000/svg" style="position:absolute;inset:0;opacity:0.15;">
                            <defs>
                                <style>
                                    .fl {
                                        animation: floatX 18s ease-in-out infinite;
                                    }

                                    .fl2 {
                                        animation: floatX 24s ease-in-out infinite;
                                    }

                                    .fl3 {
                                        animation: floatX 14s ease-in-out infinite;
                                    }

                                    @@keyframes floatX {
                                        0% {
                                            transform: translateY(0px);
                                        }

                                        25% {
                                            transform: translateY(-8px);
                                        }

                                        50% {
                                            transform: translateY(-14px);
                                        }

                                        75% {
                                            transform: translateY(-6px);
                                        }

                                        100% {
                                            transform: translateY(0px);
                                        }
                                    }
                                </style>
                            </defs>

                            <!-- Rupee symbols -->
                            <text x="40" y="55" font-size="28" fill="#ffffff" class="fl" style="animation-delay:0s">₹</text>
                            <text x="160" y="30" font-size="18" fill="#90caf9" class="fl2" style="animation-delay:2s">₹</text>
                            <text x="320" y="70" font-size="22" fill="#ffffff" class="fl" style="animation-delay:4s">₹</text>
                            <text x="560" y="25" font-size="16" fill="#bbdefb" class="fl3" style="animation-delay:1s">₹</text>
                            <text x="780" y="65" font-size="26" fill="#90caf9" class="fl2" style="animation-delay:3s">₹</text>
                            <text x="980" y="40" font-size="20" fill="#ffffff" class="fl" style="animation-delay:5s">₹</text>

                            <!-- Pill shapes -->
                            <rect x="90" y="20" width="34" height="14" rx="7" fill="#90caf9" class="fl" style="animation-delay:1.5s" />
                            <rect x="240" y="55" width="28" height="12" rx="6" fill="#ffffff" class="fl2" style="animation-delay:3s" />
                            <rect x="430" y="18" width="36" height="14" rx="7" fill="#bbdefb" class="fl" style="animation-delay:2.5s" />
                            <rect x="640" y="58" width="30" height="12" rx="6" fill="#90caf9" class="fl3" style="animation-delay:0.5s" />
                            <rect x="860" y="22" width="32" height="13" rx="6" fill="#ffffff" class="fl2" style="animation-delay:4s" />
                            <rect x="1050" y="50" width="26" height="11" rx="5" fill="#bbdefb" class="fl" style="animation-delay:2s" />

                            <!-- Small circles -->
                            <circle cx="200" cy="50" r="8" fill="#90caf9" class="fl2" style="animation-delay:1s" />
                            <circle cx="500" cy="45" r="6" fill="#ffffff" class="fl" style="animation-delay:3.5s" />
                            <circle cx="700" cy="30" r="9" fill="#bbdefb" class="fl3" style="animation-delay:0s" />
                            <circle cx="910" cy="60" r="7" fill="#90caf9" class="fl2" style="animation-delay:2.5s" />

                            <!-- Bill receipt icons -->
                            <g class="fl" style="animation-delay:1s" transform="translate(370, 15)">
                                <rect width="24" height="30" rx="3" fill="none" stroke="#ffffff" stroke-width="1.5" />
                                <line x1="5" y1="10" x2="19" y2="10" stroke="#ffffff" stroke-width="1.2" />
                                <line x1="5" y1="15" x2="19" y2="15" stroke="#ffffff" stroke-width="1.2" />
                                <line x1="5" y1="20" x2="14" y2="20" stroke="#ffffff" stroke-width="1.2" />
                            </g>
                            <g class="fl2" style="animation-delay:3s" transform="translate(730, 10)">
                                <rect width="24" height="30" rx="3" fill="none" stroke="#90caf9" stroke-width="1.5" />
                                <line x1="5" y1="10" x2="19" y2="10" stroke="#90caf9" stroke-width="1.2" />
                                <line x1="5" y1="15" x2="19" y2="15" stroke="#90caf9" stroke-width="1.2" />
                                <line x1="5" y1="20" x2="14" y2="20" stroke="#90caf9" stroke-width="1.2" />
                            </g>

                            <!-- Medicine cross -->
                            <g class="fl" style="animation-delay:2s" transform="translate(130, 38)">
                                <rect x="7" y="0" width="6" height="20" rx="2" fill="#bbdefb" />
                                <rect x="0" y="7" width="20" height="6" rx="2" fill="#bbdefb" />
                            </g>
                            <g class="fl2" style="animation-delay:4.5s" transform="translate(820, 15)">
                                <rect x="5" y="0" width="5" height="16" rx="2" fill="#90caf9" />
                                <rect x="0" y="5" width="16" height="5" rx="2" fill="#90caf9" />
                            </g>

                            <!-- Barcode -->
                            <g class="fl3" style="animation-delay:1.8s" transform="translate(470, 30)" opacity="0.5">
                                <rect x="0" y="0" width="2" height="22" fill="#ffffff" />
                                <rect x="4" y="0" width="1" height="22" fill="#ffffff" />
                                <rect x="7" y="0" width="3" height="22" fill="#ffffff" />
                                <rect x="12" y="0" width="1" height="22" fill="#ffffff" />
                                <rect x="15" y="0" width="2" height="22" fill="#ffffff" />
                                <rect x="19" y="0" width="1" height="22" fill="#ffffff" />
                            </g>

                        </svg>

                        <!-- Shimmer sweep -->
                        <div style="
                position:absolute; inset:0; pointer-events:none;
                background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,0.05) 50%, transparent 65%);
                background-size:200% 100%;
                animation: shimmerSweep 5s ease-in-out infinite;
                border-radius:16px;">
                        </div>

                        <!-- Soft glow blobs (blue tones) -->
                        <div style="position:absolute; width:220px; height:220px; border-radius:50%;
                background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
                top:-80px; left:5%; animation: blobFloat 9s ease-in-out infinite; pointer-events:none;">
                        </div>
                        <div style="position:absolute; width:180px; height:180px; border-radius:50%;
                background: radial-gradient(circle, rgba(144,202,249,0.1) 0%, transparent 70%);
                bottom:-60px; right:15%; animation: blobFloat 11s ease-in-out infinite reverse; pointer-events:none;">
                        </div>
                    </div>

                    <!-- Form -->
                    <form method="get" asp-action="Index"
                          class="row g-2 mb-0 align-items-end"
                          style="position:relative; z-index:1; padding:18px 24px; margin:0 !important;
                     background:transparent !important; border-radius:16px; box-shadow:none !important;">

                        <div class="col-md-3">
                            <label class="form-label small" style="color:rgba(255,255,255,0.8) !important; font-weight:600; font-size:0.72rem; letter-spacing:.5px; text-transform:uppercase;">
                                From Date
                            </label>
                            <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm filter-date-input" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small" style="color:rgba(255,255,255,0.8) !important; font-weight:600; font-size:0.72rem; letter-spacing:.5px; text-transform:uppercase;">
                                To Date
                            </label>
                            <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm filter-date-input" />
                        </div>

                        <div class="col-md-3 d-flex align-items-end gap-2">
                            <button type="submit" class="btn btn-sm filter-apply-btn">
                                <i class="bi bi-funnel-fill me-1"></i> Apply Filter
                            </button>
                            <a asp-action="Index" class="btn btn-sm filter-reset-btn">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                            </a>
                        </div>

                        <!-- Live Clock -->
                        <div class="col-md-3 d-flex align-items-end justify-content-end">
                            <div style="text-align:right;">
                                <div style="font-size:0.65rem; color:rgba(255,255,255,0.6); letter-spacing:.6px; text-transform:uppercase;">Current Time</div>
