                       placeholder="🔍 Item name ya category se search karo..."
                       style="border-radius:8px; border:1.5px solid #e2e8f0; font-size:0.82rem;" />
            </div>

            <!-- Body -->
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0"
                           id="stockValueTable"
                           style="font-size:0.82rem;">
                        <thead style="background:#f8fafc; position:sticky; top:0; z-index:1;">
                            <tr>
                                <th class="px-3 py-2 text-muted fw-semibold">#</th>
                                <th class="px-3 py-2 text-muted fw-semibold">Item Name</th>
                                <th class="px-3 py-2 text-muted fw-semibold">Category</th>
                                <th class="px-3 py-2 text-muted fw-semibold">Company</th>
                                <th class="px-3 py-2 text-muted fw-semibold text-end">Stock Qty</th>
                                <th class="px-3 py-2 text-muted fw-semibold text-end">Cost Rate</th>
                                <th class="px-3 py-2 text-muted fw-semibold text-end"
                                    style="color:#1abc9c;">Stock Value</th>
                                <th class="px-3 py-2 text-muted fw-semibold text-center">Share %</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.StockValueDetails != null && Model.StockValueDetails.Any())
                            {
                                int sr = 1;
                                var grandTotal = Model.StockValueDetails.Sum(x => x.StockValue);
                                foreach (var item in Model.StockValueDetails)
                                {
                                    var sharePct = grandTotal > 0
                                    ? Math.Round((item.StockValue / grandTotal) * 100, 1) : 0;
                                    var barWidth = Math.Min((double)sharePct * 5, 100);
                                    <tr>
                                        <td class="px-3 text-muted">@sr</td>
                                        <td class="px-3">
                                            <div class="fw-semibold">@item.ItemName</div>
                                        </td>
                                        <td class="px-3">
                                            <span class="badge"
                                                  style="background:#e0f2fe; color:#0369a1;
                                                                 font-size:0.7rem; border-radius:6px;">
                                                @item.Category
                                            </span>
                                        </td>
                                        <td class="px-3 text-muted" style="font-size:0.78rem;">
                                            @item.Company
                                        </td>
                                        <td class="px-3 text-end fw-bold">
                                            @item.CurrentStock.ToString("N0")
                                        </td>
                                        <td class="px-3 text-end text-muted">
                                            ₹ @item.CostRate.ToString("N2")
                                        </td>
                                        <td class="px-3 text-end fw-bold" style="color:#1abc9c;">
                                            ₹ @item.StockValue.ToString("N0")
                                        </td>
                                        <td class="px-3 text-center" style="min-width:100px;">
                                            <div style="font-size:0.72rem; color:#64748b; margin-bottom:2px;">
                                                @sharePct%
                                            </div>
                                            <div style="background:#e2e8f0; border-radius:4px; height:5px;">
                                                <div style="width:@barWidth%; background:#1abc9c;
                                                                    height:5px; border-radius:4px;">
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    sr++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                        Koi stock data nahi mila
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 justify-content-between"
                 style="background:#f8fafc; border-radius:0 0 16px 16px;">
                <div class="text-muted" style="font-size:0.78rem;">
                    Total <strong>@(Model.StockValueDetails?.Count ?? 0) items</strong>
                    with stock value
                    <strong style="color:#1abc9c;">₹ @Model.TotalStockValue.ToString("N0")</strong>
                </div>
                <button type="button" class="btn btn-sm btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Cash in Hand Modal -->
<div class="modal fade" id="cashInHandModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" style="border-radius:16px; border:none;">

            <!-- Header -->
            <div class="modal-header border-0 pb-0"
                 style="background:linear-gradient(135deg,#1abc9c,#16a085); border-radius:16px 16px 0 0;">
                <div>
                    <h5 class="modal-title text-white fw-bold">
                        <i class="bi bi-cash-stack me-2"></i>Cash in Hand — Ledger
                    </h5>
                    <div class="text-white opacity-75" style="font-size:0.78rem;">
                        Sales cash receipts aur payments ka full record
                    </div>
                </div>
                <!-- Summary Boxes -->
                <div class="ms-auto d-flex gap-3 me-3">
                    <div class="text-end">
                        <div class="text-white opacity-75" style="font-size:0.68rem;">Cash In ↓</div>
                        <div class="text-white fw-bold" style="font-size:0.95rem;">
                            ₹ @Model.TotalCashIn.ToString("N0")
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="text-white opacity-75" style="font-size:0.68rem;">Cash Out ↑</div>
                        <div class="fw-bold" style="font-size:0.95rem; color:#fca5a5;">
                            ₹ @Model.TotalCashOut.ToString("N0")
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="text-white opacity-75" style="font-size:0.68rem;">Balance</div>
                        <div class="fw-bold" style="font-size:0.95rem; color:#a7f3d0;">
                            ₹ @Model.TotalCash.ToString("N0")
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white ms-3"
                        data-bs-dismiss="modal"></button>
            </div>

            <!-- Search + Filter Bar -->
            <div class="px-3 pt-3 pb-2 d-flex gap-2" style="background:#f8fafc;">
                <input type="text"
                       id="cashSearchInput"
                       class="form-control form-control-sm"
                       placeholder="🔍 Description se search karo..."
                       style="border-radius:8px; border:1.5px solid #e2e8f0; font-size:0.82rem;" />

                <select id="cashTypeFilter"
                        class="form-select form-select-sm"
                        style="border-radius:8px; border:1.5px solid #e2e8f0;
                               font-size:0.82rem; max-width:180px;">
                    <option value="">All Transactions</option>
                    <option value="Sales Receipt">Cash In (Sales)</option>
                    <option value="Payment">Cash Out (Payments)</option>
                </select>
            </div>

            <!-- Body -->
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0"
                           id="cashLedgerTable"
                           style="font-size:0.82rem;">
                        <thead style="background:#f8fafc; position:sticky; top:0; z-index:1;">
                            <tr>
                                <th class="px-3 py-2 text-muted fw-semibold">#</th>
                                <th class="px-3 py-2 text-muted fw-semibold">Date</th>
                                <th class="px-3 py-2 text-muted fw-semibold">Type</th>
                                <th class="px-3 py-2 text-muted fw-semibold">Description</th>
                                <th class="px-3 py-2 text-muted fw-semibold text-end"
                                    style="color:#16a34a;">Cash In ↓</th>
                                <th class="px-3 py-2 text-muted fw-semibold text-end"
                                    style="color:#dc2626;">Cash Out ↑</th>
                                <th class="px-3 py-2 text-muted fw-semibold text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CashInHandDetails != null && Model.CashInHandDetails.Any())
                            {
                                int sr = 1;
                                foreach (var entry in Model.CashInHandDetails)
                                {
                                    var isCashIn = entry.CashIn > 0;
                                    <tr data-type="@entry.Type">
                                        <td class="px-3 text-muted">@sr</td>
                                        <td class="px-3" style="white-space:nowrap;">
                                            @entry.Date.ToString("dd MMM yyyy")
                                        </td>
                                        <td class="px-3">
                                            <span class="badge rounded-pill"
                                                  style="font-size:0.7rem;
                                                                 background:@(isCashIn ? "#dcfce7" : "#fee2e2");
                                                                 color:@(isCashIn ? "#16a34a" : "#dc2626");">
                                                @(isCashIn ? "↓ Cash In" : "↑ Cash Out")
                                            </span>
                                        </td>
                                        <td class="px-3">@entry.Description</td>
                                        <td class="px-3 text-end fw-semibold" style="color:#16a34a;">
                                            @(entry.CashIn > 0 ? "₹ " + entry.CashIn.ToString("N0") : "—")
                                        </td>
                                        <td class="px-3 text-end fw-semibold" style="color:#dc2626;">
                                            @(entry.CashOut > 0 ? "₹ " + entry.CashOut.ToString("N0") : "—")
                                        </td>
                                        <td class="px-3 text-end fw-bold"
                                            style="color:@(entry.RunningBalance >= 0 ? "#1abc9c" : "#e74c3c");">
                                            ₹ @entry.RunningBalance.ToString("N0")
                                        </td>
                                    </tr>
                                    sr++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                        Koi cash transaction nahi mili
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 justify-content-between"
                 style="background:#f8fafc; border-radius:0 0 16px 16px;">
                <div class="d-flex gap-3" style="font-size:0.78rem;">
                    <span>
                        <span style="color:#16a34a;">↓ Total Cash In:</span>
                        <strong>₹ @Model.TotalCashIn.ToString("N0")</strong>
                    </span>
                    <span>
                        <span style="color:#dc2626;">↑ Total Cash Out:</span>
                        <strong>₹ @Model.TotalCashOut.ToString("N0")</strong>
                    </span>
                    <span>
                        <span style="color:#1abc9c;">Balance:</span>
                        <strong>₹ @Model.TotalCash.ToString("N0")</strong>
                    </span>
                </div>
                <button type="button" class="btn btn-sm btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

