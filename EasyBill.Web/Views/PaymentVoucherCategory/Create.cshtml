@using EasyBill.Models.ViewModels
@model PaymentVoucherCategoryVM

@{
    ViewData["Title"] = "Add Expense Category";
}
<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }
</style>

<div class="card mb-3">
    <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
        <h5 class="mb-0"> Add Payment Voucher Category</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-controller="PaymentVoucherCategory" asp-action="Create">
            <div class="row g-1"> 
                <div class="col-md-6 d-flex align-items-center">
                    <label asp-for="Name" class="col-3">Name <i class="text-danger">*</i></label>
                    <input asp-for="Name" required class="col-6" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6 d-flex align-items-center">
                    <label asp-for="Description" class="col-3">Description</label>
                    <input asp-for="Description" class="col-6" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-primary btnBright-Sky-Blue">Update</button>
                    <a asp-controller="PaymentVoucherCategory" asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
                </div>
            </div>
        </form>

    </div>
</div>