@model IEnumerable<EasyBill.Models.Entity.Supplier>

@{
    ViewData["Title"] = "Supplier List";
}
<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }
</style>
<div class="row mb-3">
    <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
        Supplier List
    </div>
</div>
@* <p>
    <a asp-controller="Supplier" asp-action="Create" class="btn btn-primary mb-1 float-end"> <i class="bi bi-plus-circle"></i> Add </a>
</p> *@
<p class="d-flex justify-content-end gap-2 mb-2">
    <a asp-controller="Supplier" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add
    </a>
  @*   <a asp-action="ExportToExcel" asp-controller="ItemMaster" class="btn btn-info">
        Export to Excel
    </a> *@
   @*  <a asp-action="Import" asp-controller="Supplier" class="btn btn-success">
        Import from Excel
    </a> *@
</p>
<table id="suppliertable" class=" table table-bordered table-striped">
    <thead class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Area)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PinCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoneNO)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GstNO)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.City)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Area)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PinCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNO)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GstNO)
                </td>
                <td>
                    <div class="btn-group" role="group" style="float:right">
                        <a asp-controller="Supplier" asp-action="Edit" asp-route-id="@item.Id" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-controller="Supplier" asp-action="Delete"
                           class="btn-delete"
                           title="Delete"
                           asp-route-id="@item.Id"
                           data-id="@item.Id"
                           data-controller="@ViewContext.RouteData.Values["controller"]">
                            <i class="bi bi-trash-fill text-danger p-1"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    $(document).ready(function(){
        $("#suppliertable").DataTable();
    });
</script>