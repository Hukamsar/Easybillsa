				@* 	<img src="~/assets/img/user2-160x160.jpg" alt=""> *@
				</div>
				<h3 class="mb-2 text-color">Welcome To Easy Bill Pvt. Ltd.</h3>
				@* <p class="mb-4 text-color-blue">User Experience & Interface Design <br>Strategy SaaS Solutions</p> *@
			</div>
			<div class="aside-image position-relative" style="background-image:url(assets/img/latesteasybilllogo.jpg)">
 
			</div>
		</div>
		<div class="container flex-row-fluid d-flex flex-column justify-content-center position-relative overflow-hidden p-7 mx-auto">
			<div class="d-flex justify-content-center h-100 align-items-center">
				<div class="authincation-content style-2">
					<div class="row no-gutters">
						<div class="col-xl-12 tab-content">
							<div id="sign-up" class="auth-form tab-pane fade show active  form-validation">
								<section>
									@if (!string.IsNullOrWhiteSpace(registerSuccess))
									{
										<div class="alert alert-success" role="alert">
											@registerSuccess
										</div>
									}
									@if (!string.IsNullOrWhiteSpace(registerError))
									{
										<div class="alert alert-danger" role="alert">
											@registerError
										</div>
									}
