										<form id="account" method="post">
											<h2 class="text-center mb-3">Login</h2>
											<hr />
											@Html.AntiForgeryToken()
											<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

											<div class="form-floating mb-3">
												<input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
												<label asp-for="Email" class="form-label">Email</label>
												<span asp-validation-for="Email" class="text-danger"></span>
											</div>

											<div class="form-floating mb-3">
												<input asp-for="Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
												<label asp-for="Password" class="form-label">Password</label>
												<span asp-validation-for="Password" class="text-danger"></span>
											</div>

											<div class="form-check mb-3">
												<input class="form-check-input" asp-for="RememberMe" />
												<label class="form-check-label" asp-for="RememberMe">@Html.DisplayNameFor(m => m.RememberMe)</label>
											</div>

											<div>
												<input id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary" value="Log in" />
											</div>

											<p class="text-end mt-3 mb-0">
												<a asp-controller="Account" asp-action="VerifyEmail" class="text-dark">Forgot Password?</a>
											</p>
										</form>
									</div> *@
									<div style="border: 1px solid #ccc; padding: 2rem; background-color: #2465c7f7; max-width: 450px; margin: 2rem auto; border-radius: 8px;">
                                        @if (ViewBag.RequiresBranchSelection == true)
                                        {
                                            <form asp-action="SelectBranch" asp-controller="Account" method="post">
                                                <h2 class="text-center mb-3 text-color">Select Branch</h2>
                                                <hr />
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@ViewBag.PendingUserId" />
                                                <input type="hidden" name="rememberMe" value="@(ViewBag.RememberMe == true ? "true" : "false")" />
                                                
                                                <div class="form-group mb-3">
                                                    <select name="tenantId" class="form-control" asp-items="ViewBag.Branches" required>
                                                        <option value="">-- Select Branch --</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <input type="submit" class="w-100 btn btn-lg btn-dark-blue" value="Proceed" />
                                                </div>
                                            </form>
                                        }
                                        else
                                        {
										<form id="account" method="post">
											<h2 class="text-center mb-3 text-color">Login</h2>
											<hr />
											@Html.AntiForgeryToken()
										@* 	<input type="hidden" asp-for="LoginType" id="LoginType" /> *@
											<input type="hidden" asp-for="LoginType" id="LoginType" value="MobileOtp" />
											<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
										@* 	<div class="d-flex justify-content-between mb-3 gap-2">
												<button type="button" class="btn login-mode-btn active flex-fill" data-mode="EmailPassword">Email</button>
												<button type="button" class="btn login-mode-btn flex-fill" data-mode="MobilePin">Mobile PIN</button>
												<button type="button" class="btn login-mode-btn flex-fill" data-mode="MobileOtp">Mobile OTP</button>
											</div>
 *@
											<div class="d-flex justify-content-between mb-3 gap-2">
												<button type="button" class="btn login-mode-btn active flex-fill" data-mode="MobileOtp">Mobile OTP</button>

												<button type="button" class="btn login-mode-btn flex-fill" data-mode="EmailPassword">Email</button>

												<button type="button" class="btn login-mode-btn flex-fill" data-mode="MobilePin">Mobile PIN</button>
											</div>
											<div id="emailPasswordSection">
												<div class="form-floating mb-3">
													<input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
													<label asp-for="Email" class="form-label" style="color:#114070;"><b>User Name</b></label>
													<span asp-validation-for="Email" class="text-danger"></span>
												</div>

												<div class="form-floating mb-3">
													<input asp-for="Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" style="padding-right: 45px;" />
													<label asp-for="Password" class="form-label" style="color:#114070;"><b>Password</b></label>
													<span asp-validation-for="Password" class="text-danger"></span>
													<i class="material-icons position-absolute" id="togglePasswordIcon" style="right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #114070; z-index: 10;">visibility</i>
												</div>
											</div>

											<div id="mobileSection" style="display:none;">
												<div class="form-floating mb-3">
													<input asp-for="MobileNumber" id="MobileNumberInput" class="form-control" maxlength="10" placeholder="9876543210" />
													<label asp-for="MobileNumber" class="form-label" style="color:#114070;"><b>Mobile Number</b></label>
													<span asp-validation-for="MobileNumber" class="text-danger"></span>
												</div>
											</div>

											<div id="mobilePinSection" style="display:none;">
												<div class="form-floating mb-3">
													<input asp-for="Pin" class="form-control" autocomplete="off" placeholder="PIN" />
													<label asp-for="Pin" class="form-label" style="color:#114070;"><b>PIN</b></label>
													<span asp-validation-for="Pin" class="text-danger"></span>
												</div>
											</div>

											<div id="mobileOtpSection" style="display:none;">
												<div class="d-flex gap-2 mb-3">
													<input asp-for="Otp" class="form-control" maxlength="6" placeholder="Enter OTP" />
													<button type="button" class="btn btn-dark-blue" id="sendOtpBtn">Send OTP</button>
												</div>
												<span asp-validation-for="Otp" class="text-danger d-block mb-2"></span>
												<small id="otpMessage" class="text-color d-block"></small>
											</div>

											<div class="form-check mb-3">
												<input class="form-check-input" asp-for="RememberMe" />
												<label class="form-check-label text-color" asp-for="RememberMe">@Html.DisplayNameFor(m => m.RememberMe)</label>
											</div>

											<div>
												<input id="login-submit" type="submit" class="w-100 btn btn-lg btn-dark-blue" value="Log in" />
