											<div class="d-flex justify-content-between align-items-center mt-3 mb-0">
												<button type="button" class="btn btn-sm btn-light" id="toggleRegisterBtn">Register</button>
												<a asp-controller="Account" asp-action="VerifyEmail" class="text-color">Update Password?</a>
											</div>
										</form>
                                        }
									</div>

									<div id="registerFormContainer" style="display:@(showRegisterForm ? "block" : "none"); border: 1px solid #ccc; padding: 2rem; background-color: #ffffff; max-width: 650px; margin: 2rem auto; border-radius: 8px;">
										<h4 class="text-center mb-3 text-color-blue">New Company Registration</h4>
										<form asp-action="RegisterCompanyFromLogin" asp-controller="Account" method="post">
											@Html.AntiForgeryToken()
											<div class="row">
												<div class="col-md-6 mb-3">
													<label class="form-label"><b>Company Name</b></label>
													<input type="text" name="CompanyName" class="form-control" required />
												</div>
												<div class="col-md-6 mb-3">
													<label class="form-label"><b>Contact Person</b></label>
													<input type="text" name="ContactPerson" class="form-control" required />
												</div>
											</div>
											<div class="row">
												<div class="col-md-6 mb-3">
													<label class="form-label"><b>Address1</b></label>
													<input type="text" name="Address1" class="form-control" required />
												</div>
												<div class="col-md-6 mb-3">
													<label class="form-label"><b>Address2</b></label>
