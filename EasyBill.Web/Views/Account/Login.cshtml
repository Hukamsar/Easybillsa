	<!--**********************************
		Scripts
	***********************************-->
    <!-- Required vendors -->
    <script src="~/js/global.min.js"></script> 
    <script src="~/js/custom.min.js"></script>  
    <script src="~/js/dlabnav-init.js"></script>
	<script>
		(function () {
			const modeButtons = document.querySelectorAll(".login-mode-btn");
			const loginTypeInput = document.getElementById("LoginType");
			const emailPasswordSection = document.getElementById("emailPasswordSection");
			const mobileSection = document.getElementById("mobileSection");
			const mobilePinSection = document.getElementById("mobilePinSection");
			const mobileOtpSection = document.getElementById("mobileOtpSection");
			const otpMessage = document.getElementById("otpMessage");
			const toggleRegisterBtn = document.getElementById("toggleRegisterBtn");
			const registerFormContainer = document.getElementById("registerFormContainer");

			function setMode(mode) {
				loginTypeInput.value = mode;
				modeButtons.forEach(btn => btn.classList.toggle("active", btn.dataset.mode === mode));
				emailPasswordSection.style.display = mode === "EmailPassword" ? "block" : "none";
				mobileSection.style.display = mode === "EmailPassword" ? "none" : "block";
				mobilePinSection.style.display = mode === "MobilePin" ? "block" : "none";
				mobileOtpSection.style.display = mode === "MobileOtp" ? "block" : "none";
				if (otpMessage) {
					otpMessage.textContent = "";
				}
			}

			modeButtons.forEach(btn => {
				btn.addEventListener("click", function () {
					setMode(this.dataset.mode);
				});
			});

			//setMode(loginTypeInput.value || "EmailPassword");
			setMode(loginTypeInput.value || "MobileOtp");

			if (toggleRegisterBtn && registerFormContainer) {
				toggleRegisterBtn.addEventListener("click", function () {
					const isHidden = registerFormContainer.style.display === "none" || registerFormContainer.style.display === "";
					registerFormContainer.style.display = isHidden ? "block" : "none";
				});
			}

			const sendOtpBtn = document.getElementById("sendOtpBtn");
			if (sendOtpBtn) {
				sendOtpBtn.addEventListener("click", function () {
					const mobileNumber = document.getElementById("MobileNumberInput")?.value || "";
					const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

					if (!mobileNumber) {
						otpMessage.textContent = "Please enter mobile number.";
						return;
					}

					const formData = new URLSearchParams();
					formData.append("mobileNumber", mobileNumber);
					formData.append("__RequestVerificationToken", token || "");

					fetch("@Url.Action("SendLoginOtp", "Account")", {
						method: "POST",
						headers: { "Content-Type": "application/x-www-form-urlencoded" },
						body: formData.toString()
					})
					.then(response => response.json())
					.then(data => {
						if (data.success) {
							otpMessage.textContent = `${data.message} OTP: ${data.otp}`;
						} else {
							otpMessage.textContent = data.message || "OTP send failed.";
						}
					})
					.catch(() => {
						otpMessage.textContent = "OTP send failed.";
					});
				});
			}

			const togglePasswordIcon = document.getElementById("togglePasswordIcon");
			const passwordInput = document.getElementById("Password");
			if (togglePasswordIcon && passwordInput) {
				togglePasswordIcon.addEventListener("click", function () {
					if (passwordInput.type === "password") {
						passwordInput.type = "text";
						togglePasswordIcon.textContent = "visibility_off";
					} else {
						passwordInput.type = "password";
						togglePasswordIcon.textContent = "visibility";
					}
				});
			}
		})();
	</script>
</body>
</html>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}








