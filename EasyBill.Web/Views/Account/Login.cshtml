@model AOne.Models.ViewModels.LoginViewModels
@using AOne.Utility.Enums
@{
	Layout = null;
	var registerSuccess = TempData["RegisterSuccess"] as string;
	var registerError = TempData["RegisterError"] as string;
	var showRegisterForm = !string.IsNullOrWhiteSpace(registerError);
}
<!DOCTYPE Html>
<html lang="en">
<head>

	<title>@ViewData["Title"] - EasyBill</title>


	<!-- Page Title Here -->
	<!-- FAVICONS ICON -->
    <link rel="shortcut icon" type="image/png" href="~/assets/">
    <link href="~/lib/bootstrap/dist/css/lightgallery.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/chartist.min.css" rel="stylesheet" /> 
    <link href="~/lib/bootstrap/dist/css/animate.css" rel="stylesheet" />
    <link href="~/bootstrap-select/css/bootstrap-select.min.css" rel="stylesheet" />  
    <link href="~/lib/bootstrap/dist/css/nice-select.css" rel="stylesheet" />
	<!-- Style css -->
	<link href="https://fonts.googleapis.com/css2?family=Material+Icons" rel="stylesheet">
    @*     <link href="~/css/style.css" rel="stylesheet" /> *@  
    <link href="~/assets1/css/style.css" rel="stylesheet" />
	<style>
		.authincation .login-aside {
			background: #ff6600;
			padding-top: 5rem;
			max-width: 35rem;
			width: 100%;
			z-index: 1;
			position: relative;
		}

		.authincation .login-aside:after {
			content: "";
			clip-path: polygon(0% 100%, 100% 0%, 0% 0%);
			width: 8.75rem;
			height: 100%;
			position: absolute;
			right: -8.75rem;
			z-index: -1;
			top: 0;
				background-color: #ff6600;
			box-shadow: 0.125rem 0rem 1.875rem rgba(0, 0, 0, 0.15);
		}

		.text-color-blue{
			color: #4845b1 !important;
		}
		.text-color{
			color: white;
		}

		.btn-dark-blue {
			background-color: #ff6600;
			color: white;
			border: none;
		}

			.btn-dark-blue:hover {
				background-color: #ff6600;
			}

		.login-mode-btn {
			border: 1px solid #fff;
			background: transparent;
			color: #fff;
		}

		.login-mode-btn.active {
			background: #ff6600;
		    color: #fff;
			border-color: #ff6600;
		}

	</style>

</head>
<body class="body  h-100">
