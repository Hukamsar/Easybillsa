												</div>
												<div class="col-md-6 mb-3">
													<label class="form-label"><b>Email</b></label>
													<input type="email" name="Email" class="form-control" />
												</div>
											</div>
											<button type="submit" class="btn btn-dark-blue w-100">Register Company</button>
										</form>
									</div>

								</section>
							</div>
						</div>
					</div>
