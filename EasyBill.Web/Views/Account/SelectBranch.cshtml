@using AOne.Models.Entity
@{
    ViewData["Title"] = "Select Branch";
    Layout = null;
    var branches = ViewBag.Branches as List<Tenant>;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyBill</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background-color: #f4f7f6; }
    </style>
</head>
<body>
    <div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
        <div class="card shadow-lg p-4" style="max-width: 400px; width: 100%; border-radius: 12px; border: none;">
            <div class="text-center mb-4">
                <h4 class="fw-bold text-primary" style="color: #ff6600 !important;">Select Branch</h4>
                <p class="text-muted small">Your account has access to multiple branches. Please select which branch you want to log into for this session.</p>
            </div>

            <form asp-action="SelectBranch" asp-controller="Account" method="post">
                <input type="hidden" name="userId" value="@ViewBag.UserId" />
                <input type="hidden" name="rememberMe" value="@ViewBag.RememberMe" />
                
                <div class="mb-4">
                    <label class="form-label fw-bold" style="color: #114070;">Branch</label>
                    <select name="tenantId" class="form-select form-select-lg" required style="border: 1px solid #ced4da; padding: 0.5rem; border-radius: 6px; width: 100%;">
                        <option value="" selected disabled>-- Select a Branch --</option>
                        @if(branches != null)
                        {
                            foreach(var branch in branches)
                            {
                                <option value="@branch.Id">@branch.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-lg fw-bold w-100" style="background-color: #ff6600; color: white; border: none; padding: 10px; border-radius: 6px;">Continue to Dashboard</button>
                    <a asp-action="Login" asp-controller="Account" class="btn btn-outline-secondary w-100 mt-2" style="padding: 10px; border-radius: 6px; display: block; text-align: center; text-decoration: none;">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
