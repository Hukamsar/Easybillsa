@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - EasyBill</title>
    <!-- CSS libraries -->
    <link href="~/assets1/css/style.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
            font-family: 'Poppins', sans-serif;
            height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .access-denied-container {
            background-color: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            padding: 3rem;
            text-align: center;
            max-width: 500px;
            width: 90%;
            border: 1px solid rgba(0, 0, 0, 0.05);
            animation: fadeInUp 0.6s ease-out;
        }

        .icon-wrapper {
            background-color: #ffe5e5;
            color: #d9534f;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            font-size: 40px;
            box-shadow: 0 4px 10px rgba(217, 83, 79, 0.2);
        }

        h1 {
            color: #333333;
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 0.75rem;
        }

        p {
            color: #666666;
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .btn-home {
            background-color: #2465c7f7;
            color: #ffffff;
            font-weight: 600;
            padding: 10px 24px;
            border-radius: 8px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            border: none;
            box-shadow: 0 4px 12px rgba(36, 101, 199, 0.3);
        }

        .btn-home:hover {
            background-color: #1a4ea3;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(36, 101, 199, 0.4);
        }

        .btn-home:active {
            transform: translateY(0);
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <div class="access-denied-container">
        <div class="icon-wrapper">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h1>Access Restricted</h1>
        <p>
            This page or feature is not included in your company's current subscription plan.
            To access this feature, please contact your System Administrator to upgrade your plan.
        </p>
        <a href="/Home/Index" class="btn-home">
            <i class="bi bi-house-door-fill"></i>
            Go back to Home
        </a>
    </div>
</body>
</html>
