@model AOne.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create User Account";
}
<hr />
<div class="row">
    <div class="col-4"></div>
    <div class="col-4">
        <form id="registerForm" asp-action="Register" method="post">
            <h2>Create a new account.</h2>
            <hr />
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
          @*   <div class="form-floating mb-2">
                <select asp-for="EmployeeId" asp-items="Model.EmployeeList" id="employeeId" class="form-control" autocomplete="employee" aria-required="true">
                    <option value="">Select Employee </option>
                </select>
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div> *@
            <div class="form-floating mb-2">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" asp-items class="form-control" id="email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-2">
                <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Password">Password</label>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-floating mb-2">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="form-floating mb-2">
                <select asp-for="RoleId" asp-items="Model.RoleList" class="form-control" aria-required="true">
                    <option value="">Select Role </option>
                </select>
                <span asp-validation-for="RoleId" class="text-danger"></span>
            </div>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
        </form>
    </div>
    <div class="col-4"></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
        document.getElementById('employeeId').addEventListener('change', function () {
            
        const employeeId = this.value;
        if (employeeId) {
            fetch(`/Account/GetEmployeeDetails?EmployeeId=${employeeId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`Error fetching project details: ${response.statusText}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data) {
                        document.getElementById('email').value = data.email || '';

                    } else {
                        console.warn('No project details returned.');
                    }
                })
                .catch(error => console.error('Error fetching project details:', error));
        }
    });

</script>