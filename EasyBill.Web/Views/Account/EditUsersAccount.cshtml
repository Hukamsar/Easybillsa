@using EasyBill.Models.ViewModels
@model ApplicationUserVM
@{
    ViewData["Title"] = "Update Users Account";
}
<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }
</style>
<div class="card mb-3">
        <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
            Update
    </div>
    <div class="card-body">
        <form asp-action="EditUsersAccount">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="row mb-2">
                    <label asp-for="TenantName" class="col-md-4 col-form-label text-start small">Company Name <i class="text-danger">*</i></label>
                    <div class="col-md-8">
                        <input asp-for="TenantName" type="text" class="form-control form-control-sm " required />
                    </div>
                    <span asp-validation-for="TenantName" class="text-danger"></span>
                </div>
                <div class="row mb-2">
                    <label asp-for="Email" class="col-md-4 col-form-label text-start small">Email <i class="text-danger">*</i></label>
                    <div class="col-md-8">
                        <input asp-for="Email" type="email" class="form-control form-control-sm" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="row mb-2">
                    <label asp-for="MobileNo" class="col-md-4 col-form-label text-start small">Phone <i class="text-danger">*</i></label>
                    <div class="col-md-8">
                        <input asp-for="MobileNo" class="form-control form-control-sm" required />
                    </div>
                    <span asp-validation-for="MobileNo" class="text-danger"></span>
                </div>

                <div class="row mb-2">
                    <label asp-for="Role" class="col-md-4 col-form-label text-start small">Role <i class="text-danger">*</i></label>
                    <div class="col-md-8">
                        <select asp-for="Role" asp-items="@ViewBag.roleList" class="form-control form-control-sm" required>
                            <option selected disabled>select</option>
                        </select>
                    </div>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="submit" class="btn btn-sm btn-primary btnBright-Sky-Blue">Submit</button>
                <a asp-controller="Account" asp-action="UsersAccount" class="btn btn-sm btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}