                            const otherMrp = parseFloat($otherRow.find(".mrp").val()) || 0;
                            const otherRate = parseFloat($otherRow.find(".rate").val()) || 0;

                            if (otherItemId == itemId &&
                                compareBatch(otherBatch, batch) &&
                                otherExpiry === formattedExpiry &&
                                compareFloats(otherMrp, mrp) &&
                                compareFloats(otherRate, rate)) {
                                autoCalculateFreeQty($otherRow);
                            }
                        });
                    }
                }

                // Then validate (keep existing validation)
                validateQuantityInput($qtyInput);
            });

        // ✅ ADD NEW: FOCUS VALIDATION
            $(document).on("focus", ".qty", function () {
                const $qtyInput = $(this);
                const $row = $qtyInput.closest("tr");

                // ✅ FIRST: Ensure original purchase data is set
                ensureOriginalPurchaseData($row);

                // ✅ AUTO-CALCULATE FREE QTY ON FOCUS
                autoCalculateFreeQty($row);

                validateQuantityInput($qtyInput);
            });

                function validateQuantityInput($qtyInput) {
            const $row = $qtyInput.closest("tr");

            // Clear previous validation state
            $qtyInput.removeClass('is-invalid');

            // Get row data
            const itemId = $row.find(".item-id").val();
            const batch = $row.find(".batch").val()?.trim();
            const expiry = $row.find(".expirydate").val()?.trim();
            const mrp = parseFloat($row.find(".mrp").val()) || 0;
            const rate = parseFloat($row.find(".rate").val()) || 0;
            const inputQty = parseFloat($qtyInput.val()) || 0;

            // ✅ STEP 1: Basic validation
            if (!itemId || !batch || !expiry || !mrp || !rate) {
                calculateRow($row);
                return;
            }

            // ✅ STEP 2: Normalize expiry format
            const formattedExpiry = normalizeExpiryDate(expiry);
            if (!formattedExpiry) {
                calculateRow($row);
                return;
            }

            // ✅ STEP 3: Check if groupedPurchaseData has data
            if (!Array.isArray(groupedPurchaseData) || groupedPurchaseData.length === 0) {
                calculateRow($row);
                return;
            }

            // ✅ STEP 4: Find matching purchase record
            const matched = groupedPurchaseData.find(g => {
                const backendExpiry = normalizeBackendExpiry(g.expiry);
                if (!backendExpiry) return false;

                return (
                    g.itemId == itemId &&
                    compareBatch(g.batch, batch) &&
                    backendExpiry === formattedExpiry &&
                    compareFloats(parseFloat(g.mrp), mrp) &&
                    compareFloats(parseFloat(g.rate), rate)
                );
            });

            if (!matched) {
                toastr.error("No purchase record found for this item group.");
                $qtyInput.val('').addClass('is-invalid');
                calculateRow($row);
                return;
            }

            // ✅✅ STEP 5: Get ORIGINAL PURCHASED QTY (not current stock)
            const originalPurchasedQty = matched.purchasedQty || matched.qty || 0;
            const originalPurchasedFree = matched.purchasedFreeQty || matched.freeQty || 0;

            console.log(`📦 Original Purchase: ${originalPurchasedQty} Qty + ${originalPurchasedFree} Free`);

            // ✅ STEP 6: Calculate total entered qty EXCLUDING current row
            const totalEnteredExcludingCurrent = calculateTotalEnteredQtyExcludingRow(
                itemId, batch, formattedExpiry, mrp, rate, $row
            );

            // ✅ STEP 7: Get already returned qty from database (excluding current bill)
            const alreadyReturned = getAlreadyReturnedQty(itemId, batch, formattedExpiry, mrp, rate);

            // ✅ Get original qty from THIS bill (before edit)
            const { totalOriginalQty } = calculateTotalEnteredQty(itemId, batch, formattedExpiry, mrp, rate, true);

            // ✅ Calculate returned in OTHER bills
            const returnedInOtherBills = Math.max(0, alreadyReturned - totalOriginalQty);

            console.log(`📊 Already Returned in DB: ${alreadyReturned}`);
            console.log(`📊 Original Qty (this bill): ${totalOriginalQty}`);
            console.log(`📊 Returned in OTHER bills: ${returnedInOtherBills}`);

            // ✅ STEP 8: Calculate available qty for return
            const availableForReturn = originalPurchasedQty - returnedInOtherBills;

            console.log(`✅ Available for return: ${availableForReturn}`);

            // ✅ STEP 9: Calculate total that would be returned (including current input)
            const totalThatWouldBeReturned = totalEnteredExcludingCurrent + inputQty;

            console.log(`📝 Total that would be returned: ${totalThatWouldBeReturned} (Other rows: ${totalEnteredExcludingCurrent} + Current: ${inputQty})`);

            // ✅ STEP 10: Validate
            if (totalThatWouldBeReturned > availableForReturn) {
                const maxAllowedForThisRow = Math.max(0, availableForReturn - totalEnteredExcludingCurrent);

                toastr.error(
                    `Only ${availableForReturn} qty available for return (Purchased: ${originalPurchasedQty}, Returned elsewhere: ${returnedInOtherBills}). ` +
                    `Max for this row: ${maxAllowedForThisRow}`
                );

                $qtyInput.val(maxAllowedForThisRow).addClass('is-invalid');

                // Recalculate free qty after correction
                setTimeout(() => {
                    autoCalculateFreeQty($row);
                }, 50);
            }

            calculateRow($row);
        }
    </script>

