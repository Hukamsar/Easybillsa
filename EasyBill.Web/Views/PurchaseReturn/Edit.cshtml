    <script>
        function openSupplierModal(searchText = "") {
            showLoader("Loading suppliers...");

            $.get('/Purchase/GetAllSuppliers', function (suppliers) {
                hideLoader();

                let rows = "";
                suppliers.forEach(sup => {
                    rows += `
                        <tr class="supplier-row" tabindex="0"
                            data-supplierid="${sup.id}"
                            data-name="${sup.firstName}">
                            <td>${sup.firstName}</td>
                            <td>${sup.area || '--'}</td>
                        </tr>`;
                });

                $("#supplierTableBody").html(rows);
                $("#supplierSearch").val(searchText);
                $("#supplierSearch").trigger("input");

                $("#supplierModal").modal("show");

            }).fail(function() {
                hideLoader();
                toastr.error("Error loading suppliers");
            });
        }

        $(document).on("input", "#supplierSearch", function () {
            const searchWords = $(this).val()
                .toLowerCase()
                .trim()
                .split(/\s+/);

            $("#supplierTableBody tr").each(function () {
                const supplierText = $(this).find("td:first").text().toLowerCase();
                const supplierWords = supplierText.split(/\s+/);

                let match = true;

                for (let i = 0; i < searchWords.length; i++) {
                    if (!supplierWords[i] || !supplierWords[i].startsWith(searchWords[i])) {
                        match = false;
                        break;
                    }
                }

                $(this).toggle(match);
            });

            currentSupplierIndex = -1;
            $("#supplierTableBody .supplier-row").removeClass("selected");
        });

        $(document).on("keydown", function (e) {
            if (!$("#supplierModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                supplierNavMode = "keyboard";
                isKeyboardScrollingSupplierModal = true;
                $("#supplierModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");

                setTimeout(() => {
                    isKeyboardScrollingSupplierModal = false;
                }, 300);
            }

            const $rows = $(".supplier-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentSupplierIndex === -1) {
                    currentSupplierIndex = 0;
                } else if (currentSupplierIndex < $rows.length - 1) {
                    currentSupplierIndex++;
                }

                highlightSupplierRow($rows, currentSupplierIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();
                if (currentSupplierIndex <= 0) return;
                currentSupplierIndex--;
                highlightSupplierRow($rows, currentSupplierIndex);
            }
            else if (e.key === "Enter" && currentSupplierIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentSupplierIndex).trigger("click");
            }
        });

        function highlightSupplierRow($rows, index) {
            $rows.removeClass("selected");
            const $row = $rows.eq(index);
            $row.addClass("selected");
            $row[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
        }

        $(document).on("mouseenter", ".supplier-row", function () {
            if (!$("#supplierModal").is(":visible")) return;
            if (isKeyboardScrollingSupplierModal) return;

            supplierNavMode = "mouse";

            $("#supplierModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".supplier-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentSupplierIndex = $rows.index(this);
        });

        $(document).on("click", ".supplier-row", function () {
            const supplierId = $(this).data("supplierid");
            const supplierName = $(this).data("name");

            if (!supplierId) return;

            const previousSupplierId = selectedSupplierId;
            const hasItemsInGrid = $("#PurchaseReturnItemBody tr").length > 0;

            // ✅ CHECK: If supplier is being CHANGED and items exist
            if (previousSupplierId && previousSupplierId !== supplierId && hasItemsInGrid) {
                // ✅ Close supplier modal FIRST
                $("#supplierModal").modal("hide");

                // ✅ Wait for supplier modal to fully close
                setTimeout(() => {
                    confirmAction(
                        "Changing supplier will clear all items and calculations. Continue?",
                        function(confirmed) {
                            if (confirmed) {
                                clearItemGridAndCalculations();
                                completeSupplierSelection(supplierId, supplierName);
                            } else {
                                // ✅ Reopen supplier modal
                                setTimeout(() => {
                                    $("#supplierModal").modal("show");
                                }, 300);
                            }
                        }
                    );
                }, 500); // ✅ Increased delay to ensure modal fully closed

                return;
            }

            completeSupplierSelection(supplierId, supplierName);
        });

        // Helper function to complete supplier selection
        function completeSupplierSelection(supplierId, supplierName) {
            $(".supplier-id").val(supplierId);
            $(".supplier-input").val(supplierName);

            selectedSupplierId = supplierId;
            supplierWasSelected = true;

            loadSupplierItems(supplierId);
            loadReturnedQtyData(supplierId);

            $("#supplierModal").modal("hide");
        }

        function clearItemGridAndCalculations() {
            // ✅ 1. Clear all item rows
            $("#PurchaseReturnItemBody").empty();

            // ✅ 2. Reset row index
            rowIndex = 0;

            // ✅ 3. Reset all calculation fields
            $("[name='Total']").val("0.00");
            $("[name='Totaldiscount']").val("0.00");
            $("[name='TotalGstAmt']").val("0.00");
            $("[name='TotalPayable']").val("0.00");
            $("#discountPercent").val("0");
            $("#discountamount").val("0");

            // ✅ 4. Clear grouped purchase data
            groupedPurchaseData = [];
            returnedQtyData = [];

            // ✅ 5. HIDE AND CLEAR ITEM RETURN HISTORY
            $("#itemReturnInfoWrapper").hide();
            $("#itemReturnInfoBody").empty();

            // ✅ 6. Show notification
            toastr.info("Item grid cleared due to supplier change", "Supplier Changed");

            // ✅ 7. Add first row and focus
            setTimeout(() => {
                addNewRow();
                setTimeout(() => {
                    $("#PurchaseReturnItemBody tr:first .item-input").focus();
                }, 100);
            }, 150);
        }

                function confirmAction(message, callback) {
            if (typeof Swal !== 'undefined') {
                // ✅ DISABLE background inputs before showing modal
                const supplierInput = document.querySelector('.supplier-input');
                const previousTabIndex = supplierInput?.tabIndex;
                if (supplierInput) {
                    supplierInput.setAttribute('disabled', 'true');
                    supplierInput.blur(); // Remove focus
                }

                Swal.fire({
                    title: 'Are you sure?',
                    text: message,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, proceed!',
                    cancelButtonText: 'No, cancel',
                    reverseButtons: true,
                    allowEnterKey: true,
                    allowEscapeKey: true,
                    allowOutsideClick: false,
                    backdrop: true,
                    focusConfirm: false,
                    focusCancel: false,

                    didOpen: () => {
                        const confirmBtn = document.querySelector('.swal2-confirm');

                        const focusBtn = () => {
                            if (confirmBtn) {
                                confirmBtn.focus();
                            }
                        };

                        focusBtn();
                        setTimeout(focusBtn, 50);
                        setTimeout(focusBtn, 100);
                    },

                    // ✅ RE-ENABLE inputs after modal closes
                    didClose: () => {
                        if (supplierInput) {
                            supplierInput.removeAttribute('disabled');
                        }
                    }
                }).then((result) => {
                    // ✅ Re-enable before callback
                    if (supplierInput) {
                        supplierInput.removeAttribute('disabled');
                    }

                    callback(result.isConfirmed);
                });
            } else {
                // Fallback to native confirm
                if (confirm(message)) {
                    callback(true);
                } else {
                    callback(false);
                }
            }
        }

        // ✅ Block all keyboard events when SweetAlert is visible
        document.addEventListener('keydown', function (e) {
            // Check if SweetAlert is open
            if (typeof Swal !== 'undefined' && Swal.isVisible()) {
                // Get the target element
                const target = e.target;

                // If event is NOT from SweetAlert buttons, block it
                if (!target.classList.contains('swal2-confirm') &&
                    !target.classList.contains('swal2-cancel') &&
                    !target.closest('.swal2-container')) {

                    // Allow only specific keys
                    const allowedKeys = ['Enter', 'Escape', 'Tab', 'ArrowLeft', 'ArrowRight', 'Space'];

                    if (!allowedKeys.includes(e.key)) {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                    }
                }
            }
        }, true); // Use capture phase

        $('#supplierModal').on('shown.bs.modal', function () {
            supplierWasSelected = false;
            supplierNavMode = "keyboard";

            $("#supplierModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".supplier-row:visible");
            currentSupplierIndex = -1;

            if ($rows.length) {
                currentSupplierIndex = 0;
                highlightSupplierRow($rows, currentSupplierIndex);
            }

            setTimeout(() => {
                $("#supplierSearch").focus().select();
            }, 200);
        });

        $('#supplierModal').on('hidden.bs.modal', function () {
            setTimeout(() => {
                if (supplierWasSelected) {
                    $("#PartyBillNo").focus().select();
                    supplierWasSelected = false;
                } else {
                    $(".supplier-input").focus();
                }
            }, 150);
        });

        function loadSupplierItems(supplierId) {
            showLoader("Loading items...");

            $.get('/PurchaseReturn/GetItemsBySupplierIdForEditOnly', { supplierId: supplierId }, function (res) {
                hideLoader();

                if (res.success && res.items.length > 0) {
                    supplierItemList = res.items;
                    toastr.success("Items loaded for selected supplier.");
                } else {
                    supplierItemList = [];
                    toastr.warning("No items found for selected supplier.");
                }
            }).fail(function() {
                hideLoader();
                toastr.error("Failed to load items for selected supplier.");
            });
        }

        function loadReturnedQtyData(supplierId) {
            $.get(`/PurchaseReturn/GetReturnedQtyData?supplierId=${supplierId}`, function (data) {
                returnedQtyData = data;
            });
        }
    </script>

