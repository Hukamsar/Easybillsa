@model EasyBill.Models.ViewModels.PurchaseReturnVM
@{
    ViewData["Title"] = "Edit Purchase Return";
}

<style>
    /* ===============================
               BATCH MODAL STYLING
               =============================== */
    .batch-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    #batchModal.keyboard-nav .batch-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #batchModal.mouse-nav .batch-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    #batchModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #batchModal .modal-header .btn-close {
            filter: invert(1);
        }

    .batch-table-wrapper {
        max-height: 350px;
        overflow-y: auto;
        position: relative;
    }

    #batchTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7;
        color: #fff;
        font-weight: 700;
        z-index: 2;
    }
</style>

<style>
    /* ===============================
               ITEM MODAL STYLING
               =============================== */
    .item-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    #itemModal.keyboard-nav .item-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #itemModal.mouse-nav .item-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .item-row:focus {
        outline: none;
    }

    .item-row {
        scroll-margin-top: 50px;
    }

    #itemModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #itemModal .modal-header .btn-close {
            filter: invert(1);
        }

    #itemTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    }
</style>

<style>
    /* ===============================
               SUPPLIER MODAL STYLING
               =============================== */
    #supplierModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #supplierModal .modal-header .btn-close {
            filter: invert(1);
        }

    #supplierTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .supplier-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    #supplierModal.keyboard-nav .supplier-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #supplierModal.mouse-nav .supplier-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .supplier-row {
        scroll-margin-top: 50px;
    }

        .supplier-row:focus {
            outline: none;
        }
</style>

<style>
    /* ====================================
           RETURN HISTORY TABLE STYLING (COMPACT)
           ==================================== */

    #itemReturnInfoWrapper {
        background: linear-gradient(to bottom, #fffbf5, #ffffff);
        border: 1.5px solid #ffd9a3 !important; /* ✅ Orange tone */
        box-shadow: 0 1px 4px rgba(255, 152, 0, 0.08);
        max-height: 250px;
        overflow-y: auto;
    }

    .return-history-table {
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        border-radius: 6px;
        font-size: 11px;
    }

        .return-history-table thead tr {
            background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%); /* ✅ Orange gradient */
            color: #ffffff;
            font-weight: 600;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .return-history-table thead th {
            border: none !important;
            padding: 6px 5px;
            vertical-align: middle;
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 10;
        }

            .return-history-table thead th:first-child {
                border-top-left-radius: 6px;
            }

            .return-history-table thead th:last-child {
                border-top-right-radius: 6px;
            }

        .return-history-table tbody tr {
            border-bottom: 1px solid #ffe4c4; /* ✅ Light orange border */
            transition: all 0.15s ease;
        }

            .return-history-table tbody tr:hover {
                background-color: #fff3e0; /* ✅ Orange hover */
                transform: scale(1.005);
            }

        .return-history-table tbody td {
            padding: 5px 5px;
            font-size: 11px;
            border-left: 1px solid #ffe4c4;
            border-right: 1px solid #ffe4c4;
            vertical-align: middle;
            line-height: 1.3;
        }

            .return-history-table tbody td:first-child {
                border-left: none;
            }

            .return-history-table tbody td:last-child {
                border-right: none;
            }

        .return-history-table tbody tr:last-child td {
            border-bottom: none;
        }

        /* Alternating row colors */
        .return-history-table tbody tr:nth-child(even) {
            background-color: #fffaf0; /* ✅ Very light orange */
        }

        .return-history-table tbody tr:nth-child(odd) {
            background-color: #ffffff;
        }

    /* Responsive scrolling */
    .table-responsive {
        border-radius: 6px;
        overflow-x: auto;
    }

    /* Custom scrollbar - Orange theme */
    #itemReturnInfoWrapper::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    #itemReturnInfoWrapper::-webkit-scrollbar-track {
        background: #fff8f0;
        border-radius: 3px;
    }

    #itemReturnInfoWrapper::-webkit-scrollbar-thumb {
        background: #ffd9a3; /* ✅ Orange scrollbar */
        border-radius: 3px;
    }

        #itemReturnInfoWrapper::-webkit-scrollbar-thumb:hover {
            background: #ff9800;
        }

    /* Empty state */
    #itemReturnInfoBody:empty::after {
        content: "No return history available";
        display: block;
        text-align: center;
        padding: 20px;
        color: #6c757d;
        font-style: italic;
        font-size: 11px;
    }
</style>

<style>
    #refreshBtn:hover {
        opacity: 0.85;
        transform: rotate(90deg);
        transition: all 0.2s ease;
    }
</style>

<style>
    .custom-header th {
        background: linear-gradient(180deg, #eef3f8, #d8e3ef);
        color: #16202b;
        font-weight: 700;
        text-align: center;
        border-bottom: 0px solid #b6c6d6;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,0.05);
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">

        <div class="card mb-2 shadow-sm" style="border-radius: 6px; overflow: hidden;">
            <div class="card-header text-white d-flex align-items-center py-1 px-3"
                 style="background:#2b6ac9">

                <h6 class="mb-0 me-auto" style="font-size: 0.85rem;">
                    Edit Purchase Return
                </h6>

                <button type="button"
                        id="refreshBtn"
                        class="btn btn-sm p-1 me-2 border-0 bg-transparent text-white"
                        title="Refresh">
                    <span class="fs-5">🔄</span>
                </button>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="Edit" id="purchaseReturnForm">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <!-- Bill No -->
                    <div class="col-md-6 d-flex align-items-center mb-1">
                        <div class="col-md-5">
                            <label asp-for="BillNo"></label>
                        </div>
                        <div class="col-md-5">
                            <input asp-for="BillNo" id="BillNo" class="form-control form-control-sm" readonly />
                            <span asp-validation-for="BillNo" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Bill Date -->
                    <div class="col-md-6 d-flex align-items-center mb-1">
                        <div class="col-md-5">
                            <label asp-for="BillDate"></label>
                        </div>
                        <div class="col-md-5">
                            <input type="date" asp-for="BillDate" id="BillDate" class="form-control form-control-sm" />
                            <span asp-validation-for="BillDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- ✅ SUPPLIER - TEXT INPUT + MODAL -->
                    <div class="col-md-6 d-flex align-items-center mb-1">
                        <div class="col-md-5">
                            <label asp-for="SupplierName"></label>
                        </div>
                        <div class="col-md-5">
                            <input type="hidden" asp-for="SupplierId" class="supplier-id" />
                            <input type="text"
                                   class="form-control form-control-sm supplier-input"
                                   placeholder="Press Enter to select supplier"
                                   autocomplete="off"
                                   value="@Model.SupplierName" />
                            <span asp-validation-for="SupplierId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Party Bill No -->
                    <div class="col-md-6 d-flex align-items-center mb-1">
                        <div class="col-md-5">
                            <label asp-for="PartyBillNo"></label>
                        </div>
                        <div class="col-md-5">
                            <input asp-for="PartyBillNo" id="PartyBillNo" class="form-control form-control-sm" />
                            <span asp-validation-for="PartyBillNo" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Party Bill Date -->
                    <div class="col-md-6 d-flex align-items-center mb-1">
                        <div class="col-md-5">
                            <label asp-for="PartyBillDate"></label>
                        </div>
                        <div class="col-md-5">
                            <input type="date" asp-for="PartyBillDate" id="PartyBillDate" class="form-control form-control-sm" />
                            <span asp-validation-for="PartyBillDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- ✅ NEW: Reason Field -->
                    <div class="col-md-6 d-flex align-items-center mb-1">
                        <div class="col-md-5">
                            <label asp-for="Reason">Reason</label>
                        </div>
                        <div class="col-md-5">
                            <select asp-for="Reason" id="Reason" class="form-control form-control-sm reason-dropdown-header">
                                <option value="">-- Select Reason --</option>
                                @foreach (var item in ViewBag.PurchaseReturnReasons)
                                {
                                    <option value="@item.Value" selected="@(item.Value == ((int)Model.Reason).ToString())">@item.Text</option>
                                }
                            </select>
                            <span asp-validation-for="Reason" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div style="overflow-x: auto; width: 100%;">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead class="table custom-header">
                                <tr>
                                    <th style="min-width:30%">Item</th>
                                    <th style="min-width:30%">Batch</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-center">Free</th>
                                    <th class="text-center">Rate</th>
                                    <th class="text-center">Disc %</th>
                                    <th class="text-center">Gst %</th>
                                    <th class="text-center">Cess</th>
                                    <th class="text-center">Amount</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="PurchaseReturnItemBody">
                                @for (int i = 0; i < Model.PurchaseReturnItemVMs.Count; i++)
                                {
                                    var item = Model.PurchaseReturnItemVMs[i];

                                    <tr>
                                        <td hidden>
                                            <input name="PurchaseReturnItemVMs[@i].Id" value="@item.Id" class="row-id" />
                                            <input type="hidden" class="original-qty" value="@item.Qty" />

                                            <!-- ✅ ADD THESE TWO NEW FIELDS -->
                                            <input type="hidden" class="original-purchase-qty" value="@item.Qty" />
                                            <input type="hidden" class="original-purchase-free" value="@item.FreeQty" />
                                        </td>

                                        <td style="min-width:250px;">
                                            <input type="hidden" name="PurchaseReturnItemVMs[@i].ItemId" class="item-id" value="@item.ItemId" />
                                            <input type="text"
                                                   name="PurchaseReturnItemVMs[@i].ItemName"
                                                   class="form-control form-control-sm item-input"
                                                   placeholder="Press Enter to select item"
                                                   value="@item.ItemName" />
                                        </td>

                                        <td><input name="PurchaseReturnItemVMs[@i].Batch" value="@item.Batch" class="form-control form-control-sm batch" readonly /></td>
                                        <td hidden><input type="text" name="PurchaseReturnItemVMs[@i].ExpiryDate" value="@item.ExpiryDate?.ToString("MM/yyyy")" class="form-control form-control-sm expirydate" placeholder="MM/YYYY" maxlength="7" /></td>
                                        <td hidden><input name="PurchaseReturnItemVMs[@i].Mrp" value="@item.Mrp" class="form-control form-control-sm mrp" /></td>
                                        <td><input name="PurchaseReturnItemVMs[@i].Qty" value="@item.Qty" class="form-control form-control-sm qty" /></td>
                                        <td><input name="PurchaseReturnItemVMs[@i].FreeQty" value="@item.FreeQty" class="form-control form-control-sm freeqty" /></td>
                                        <td><input name="PurchaseReturnItemVMs[@i].Rate" value="@item.Rate" class="form-control form-control-sm rate" /></td>
                                        <td hidden><input name="PurchaseReturnItemVMs[@i].salserateA" value="@item.salserateA" class="form-control form-control-sm salserateA" /></td>
                                        <td hidden><input name="PurchaseReturnItemVMs[@i].salserateB" value="@item.salserateB" class="form-control form-control-sm salserateB" /></td>
                                        <td hidden>
                                            <select name="PurchaseReturnItemVMs[@i].HsnId" class="form-control form-control-sm hsn-dropdown">
                                                <option value="">-- Select HSN --</option>
                                                @foreach (var hsn in ViewBag.Hsn)
                                                {
                                                    <option value="@hsn.Value" selected="@(hsn.Value == item.HsnId.ToString())">@hsn.Text</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input name="PurchaseReturnItemVMs[@i].Discount" value="@item.Discount" class="form-control form-control-sm discount" /></td>
                                        <td hidden><input name="PurchaseReturnItemVMs[@i].DiscountAmt" value="@item.DiscountAmt" class="form-control form-control-sm discount-amt" readonly /></td>
                                        <td><input name="PurchaseReturnItemVMs[@i].Gst" value="@item.Gst" class="form-control form-control-sm gst" readonly /></td>
                                        <td><input name="PurchaseReturnItemVMs[@i].Cess" value="@item.Cess" class="form-control form-control-sm cess" readonly /></td>
                                        <td><input name="PurchaseReturnItemVMs[@i].TotalAmt" value="@item.TotalAmt" class="form-control form-control-sm total" readonly /></td>
                                        <td hidden><input name="PurchaseReturnItemVMs[@i].BatchWiseCose" value="@item.BatchWiseCose" class="form-control form-control-sm batch-wise" readonly /></td>
                                        <td><u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="float-start">
                                        <u id="addRow" style="color:green; cursor:pointer;">Add Row</u>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="row mt-3">
                            <!-- 🔥 LEFT : ITEM PURCHASE HISTORY -->
                            <div class="col-md-9">
                                <div id="itemReturnInfoWrapper" class="border rounded p-3 h-90" style="display:none;">
                                    <div class="table-responsive">
                                        <table class="table table-sm mb-0 text-center return-history-table">
                                            <thead>
                                                <tr>
                                                    <th>Supplier</th>
                                                    <th>Bill No</th>
                                                    <th>Bill Date</th>
                                                    <th>Qty</th>
                                                    <th>FreeQty</th>
                                                    <th>Batch</th>
                                                    <th>MRP</th>
                                                    <th>Rate</th>
                                                    <th>Expiry</th>
                                                    <th>Total Discount</th>
                                                    <th>Cost</th>
                                                </tr>
                                            </thead>
                                            <tbody id="itemReturnInfoBody">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- 🔹 RIGHT : TOTALS -->
                            <div class="col-md-3">
                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Total</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="Total" class="form-control form-control-sm total-input text-end" readonly />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Bill Discount</label>
                                    <div class="col-md-3 text-end">
                                        <input asp-for="discountPercent" id="discountPercent" class="form-control form-control-sm discount-input text-end" />
                                    </div>
                                    <div class="col-md-3 text-end">
                                        <input asp-for="discountAmount" id="discountamount" class="form-control form-control-sm total-input text-end" />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Total Discount</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="Totaldiscount" class="form-control form-control-sm total-input text-end" readonly />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Gst</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalGstAmt" class="form-control form-control-sm total-input text-end" readonly />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Total Cess Amt</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalCessAmt" class="form-control form-control-sm total-input text-end" readonly />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center">
                                    <label asp-for="RoundOffAmount" class="col-md-6 col-form-label small"></label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="RoundOffAmount" id="roundOffAmount" class="form-control form-control-sm text-end" readonly />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small fw-bold">Total Payable</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalPayable" class="form-control form-control-sm total-input text-end fw-bold" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-primary">End | Update 💾</button>
                    <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index"))" id="btnCancel" class="btn btn-sm btn-outline-secondary">F11 | Cancel ❌</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ✅ BATCH MODAL -->
<div class="modal fade" id="batchModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Batch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="batch-table-wrapper">
                    <table id="batchTable" class="table mb-0">
                        <thead class="table-light">
                            <tr><th>Batch No</th><th>Expiry</th><th>Rate</th><th>Mrp</th><th>Qty</th></tr>
                        </thead>
                        <tbody id="batchTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ✅ ITEM SELECTION MODAL -->
<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <input type="text" id="itemSearch" class="form-control form-control-sm" placeholder="Search by item name..." />
                </div>
                <div class="item-table-wrapper" style="max-height: 350px; overflow-y: auto;">
                    <table id="itemTable" class="table table-sm table-bordered mb-0">
                        <thead class="table-light" style="position: sticky; top: 0; z-index: 2;">
                            <tr>
                                <th>Item Name</th>
                                <th>Qty</th>
                                <th>Unit</th>
                            </tr>
                        </thead>
                        <tbody id="itemTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ✅ SUPPLIER SELECTION MODAL -->
<div class="modal fade" id="supplierModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Supplier</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <input type="text" id="supplierSearch" class="form-control form-control-sm" placeholder="Search by supplier name..." />
                </div>
                <div class="supplier-table-wrapper" style="max-height: 350px; overflow-y: auto;">
                    <table id="supplierTable" class="table table-sm table-bordered mb-0">
                        <thead class="table-light" style="position: sticky; top: 0; z-index: 2;">
                            <tr>
                                <th>Name</th>
                                <th>Area</th>
                            </tr>
                        </thead>
                        <tbody id="supplierTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- ================================================================
         🔹 GLOBAL VARIABLES & STATE
         ================================================================ -->
    <script>
        let selectedRow = null;
        let popupOpen = false;
        let currentRow = null;
        let currentBatchIndex = -1;
        let rowIndex = @Model.PurchaseReturnItemVMs.Count;
        let lastFocusSource = null;
        let currentItemIndex = -1;
        let currentRowForItemModal = null;
        let focusBatchAfterItemSelect = false;

        let groupedPurchaseData = [];
        let returnedQtyData = [];
        let supplierItemList = [];
        let selectedSupplierId = @Model.SupplierId;
        let deletedOriginalQtyRecords = [];
        let tempRowIdCounter = -1;

        // ITEM MODAL VARIABLES
        let itemNavMode = "keyboard";
        let isKeyboardScrollingItemModal = false;

        // BATCH MODAL VARIABLES
        let batchNavMode = "keyboard";
        let isKeyboardScrollingBatchModal = false;

        // SUPPLIER MODAL VARIABLES
        let supplierNavMode = "keyboard";
        let isKeyboardScrollingSupplierModal = false;
        let currentSupplierIndex = -1;
        let supplierWasSelected = false;
    </script>

    <!-- ================================================================
         🔹 VALIDATION HELPERS
         ================================================================ -->
    <script>
        function isValidSupplier() {
            const supplierId = $(".supplier-id").val();
            return supplierId && supplierId !== "0";
        }

        function isValidPartyBillNo() {
            return $("#PartyBillNo").val().trim().length > 0;
        }

        function isValidPartyBillDate() {
            const date = $("#PartyBillDate").val();
            return date && date.length > 0;
        }

        function isValidQty(value) {
            const qty = parseFloat(value);
            return !isNaN(qty) && qty > 0;
        }

        function isValidRate(value) {
            const rate = parseFloat(value);
            return !isNaN(rate) && rate > 0;
        }

        function validateHeaderFields() {
            if (!isValidSupplier()) {
                toastr.error("Please select a supplier", "Validation Error");
                $(".supplier-input").focus();
                return false;
            }

            if (!isValidPartyBillNo()) {
                toastr.error("Party Bill No is required", "Validation Error");
                $("#PartyBillNo").focus().select();
                return false;
            }

            if (!isValidPartyBillDate()) {
                toastr.error("Party Bill Date is required", "Validation Error");
                $("#PartyBillDate").focus();
                return false;
            }

            if (!$(".reason-dropdown-header").val()) {
                toastr.error("Reason is required", "Validation Error");
                $(".reason-dropdown-header").focus();
                return false;
            }

            return true;
        }

        function validateRow(row) {
            const itemId = row.find(".item-id").val();
            const batch = row.find(".batch").val().trim();
            const qty = row.find(".qty").val();
            const rate = row.find(".rate").val();

            if (!itemId || itemId === "") {
                toastr.error("Please select an item", "Validation Error");
                row.find(".item-input").focus();
                return false;
            }

            if (!batch) {
                toastr.error("Batch is required", "Validation Error");
                row.find(".batch").focus().select();
                return false;
            }

            if (!isValidQty(qty)) {
                toastr.error("Quantity must be greater than 0", "Validation Error");
                row.find(".qty").focus().select();
                return false;
            }

            if (!isValidRate(rate)) {
                toastr.error("Rate must be greater than 0", "Validation Error");
                row.find(".rate").focus().select();
                return false;
            }

            return true;
        }

        function validateAllRows() {
            let isValid = true;

            $("#PurchaseReturnItemBody tr").each(function() {
                const row = $(this);
                const itemId = row.find(".item-id").val();
                const batch = row.find(".batch").val().trim();
                const qty = row.find(".qty").val();
                const rate = row.find(".rate").val();

                if (itemId || batch || qty || rate) {
                    if (!validateRow(row)) {
                        isValid = false;
                        return false;
                    }
                }
            });

            return isValid;
        }
    </script>

