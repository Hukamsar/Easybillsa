    <!-- ================================================================
       🔹 HELPER FUNCTIONS FOR VALIDATION
       ================================================================ -->
    <script>
        function normalizeExpiryDate(expiryStr) {
            if (!expiryStr) return null;

            expiryStr = expiryStr.trim();

            if (!expiryStr.includes('/')) return null;

            const parts = expiryStr.split('/');
            if (parts.length !== 2) return null;

            const [mm, yy] = parts;

            if (!mm || !yy) return null;

            const month = mm.trim().padStart(2, '0');
            const yearStr = yy.trim();

            let year;
            if (yearStr.length === 2) {
                year = "20" + yearStr;
            } else if (yearStr.length === 4) {
                year = yearStr;
            } else {
                return null;
            }

            const monthNum = parseInt(month);
            if (isNaN(monthNum) || monthNum < 1 || monthNum > 12) return null;

            return `${year}-${month}-01`;
        }

        function normalizeBackendExpiry(expiry) {
            if (!expiry) return null;

            try {
                let dateStr;

                if (typeof expiry === 'string') {
                    if (expiry.includes('T')) {
                        dateStr = expiry.split("T")[0];
                    } else if (expiry.includes('/')) {
                        const [mm, yy] = expiry.split('/');
                        const month = mm.padStart(2, '0');

                        let year;
                        if (yy.length === 2) {
                            year = "20" + yy;
                        } else if (yy.length === 4) {
                            year = yy;
                        } else {
                            return null;
                        }

                        dateStr = `${year}-${month}-01`;
                    } else if (expiry.includes('-')) {
                        dateStr = expiry;
                    } else {
                        return null;
                    }
                } else if (expiry instanceof Date) {
                    const d = new Date(expiry);
                    const year = d.getFullYear();
                    const month = String(d.getMonth() + 1).padStart(2, '0');
                    dateStr = `${year}-${month}-01`;
                }

                return dateStr;
            } catch (e) {
                console.error("Error normalizing expiry:", e);
                return null;
            }
        }

        function compareFloats(a, b, tolerance = 0.01) {
            return Math.abs(a - b) < tolerance;
        }

        function compareBatch(batch1, batch2) {
            if (!batch1 || !batch2) return false;
            return batch1.trim().toLowerCase() === batch2.trim().toLowerCase();
        }

        function calculateTotalEnteredQty(itemId, batch, expiry, mrp, rate, excludeOriginalQty = false) {
            let total = 0;
            let totalOriginalQty = 0;

            $("#PurchaseReturnItemBody tr").each(function () {
                const row = $(this);
                const rowItemId = row.find(".item-id").val();
                const rowBatch = row.find(".batch").val()?.trim();
                const rowExpiry = normalizeExpiryDate(row.find(".expirydate").val()?.trim());
                const rowMrp = parseFloat(row.find(".mrp").val()) || 0;
                const rowRate = parseFloat(row.find(".rate").val()) || 0;
                const rowQty = parseFloat(row.find(".qty").val()) || 0;
                const rowOriginalQty = parseFloat(row.find(".original-qty").val()) || 0;

                if (!rowExpiry) return;

                if (
                    rowItemId == itemId &&
                    compareBatch(rowBatch, batch) &&
                    rowExpiry === expiry &&
                    compareFloats(rowMrp, mrp) &&
                    compareFloats(rowRate, rate)
                ) {
                    total += rowQty;
                    totalOriginalQty += rowOriginalQty;
                }
            });

            // ✅ Add originalQty from deleted rows
            deletedOriginalQtyRecords.forEach(d => {
                if (
                    d.itemId == itemId &&
                    compareBatch(d.batch, batch) &&
                    d.expiry === expiry &&
                    compareFloats(d.mrp, mrp) &&
                    compareFloats(d.rate, rate)
                ) {
                    totalOriginalQty += d.originalQty;
                }
            });

            if (excludeOriginalQty) {
                return { totalEntered: total, totalOriginalQty: totalOriginalQty };
            }

            return total;
        }

        function getAlreadyReturnedQty(itemId, batch, expiry, mrp, rate) {
            if (!Array.isArray(returnedQtyData)) return 0;

            const found = returnedQtyData.find(r => {
                const rExpiry = normalizeBackendExpiry(r.expiry);
                if (!rExpiry) return false;

                return (
                    r.itemId == itemId &&
                    compareBatch(r.batch, batch) &&
                    rExpiry === expiry &&
                    compareFloats(parseFloat(r.mrp), mrp) &&
                    compareFloats(parseFloat(r.rate), rate)
                );
            });

            return found?.returnedQty || 0;
        }
    </script>

    <!-- ================================================================
         🔹 QUANTITY VALIDATION WITH RETURNED QTY CHECK (EDIT MODE)
         ================================================================ -->
    <script>
        // ✅ EXISTING INPUT VALIDATION
            $(document).on("input", ".qty", function () {
                const $qtyInput = $(this);
