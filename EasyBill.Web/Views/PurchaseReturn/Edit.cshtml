    <script>
        function loadItemPurchaseHistory(itemId) {
            const supplierId = $(".supplier-id").val();

            if (!itemId || !supplierId) return;

            // Show panel
            $("#itemReturnInfoWrapper").show();

            $.get('/PurchaseReturn/GetItemPurchaseHistory',
                { itemId: itemId, supplierId: supplierId },
                function (res) {

                    if (!res.success || !res.data || res.data.length === 0) {
                        $("#itemReturnInfoBody").html(`
                            <tr>
                                <td colspan="10" class="text-warning text-center">
                                    No purchase history found
                                </td>
                            </tr>
                        `);
                        return;
                    }

                    let rows = "";
                    res.data.forEach(x => {
                        rows += `
                            <tr>
                                <td>${x.supplier}</td>
                                <td>${x.billNo}</td>
                                <td>${formatDate(x.billDate)}</td>
                                <td>${x.qty}</td>
                                <td>${x.freeQty}</td>
                                <td>${x.batch}</td>
                                <td>${x.mrp}</td>
                                <td>${x.rate}</td>
                                <td>${x.expiryDate ? formatDate(x.expiryDate) : '--'}</td>
                                <td>${x.totalDiscount}</td>
                                <td>${x.batchWiseCost}</td>
                            </tr>
                        `;
                    });

                    $("#itemReturnInfoBody").html(rows);
                }
            );
        }
        function formatDate(dateStr) {
            if (!dateStr) return "--";
            const d = new Date(dateStr);
            if (isNaN(d)) return "--";
            return ("0" + d.getDate()).slice(-2) + "/" +
                   ("0" + (d.getMonth() + 1)).slice(-2) + "/" +
                   d.getFullYear();
        }

    </script>

    <script>
            // ✅ 2. NEW FUNCTION: Ensure original purchase data is set
        function ensureOriginalPurchaseData($row) {
            const itemId = $row.find(".item-id").val();
            const batchValue = $row.find(".batch").val()?.trim();

            // Skip if no item/batch or data already set
            if (!itemId || !batchValue) return;

            const existingOriginalQty = $row.find(".original-purchase-qty").val();
            if (existingOriginalQty && existingOriginalQty !== "0") return; // Already set

            // Try to find and set from groupedPurchaseData
            if (!Array.isArray(groupedPurchaseData) || groupedPurchaseData.length === 0) {
                return;
            }

            const matchedBatch = groupedPurchaseData.find(b =>
                b.itemId == itemId &&
                compareBatch(b.batch, batchValue)
            );

            if (matchedBatch) {
                $row.find(".original-purchase-qty").val(matchedBatch.qty || 0);
                $row.find(".original-purchase-free").val(matchedBatch.freeQty || 0);

                console.log(`✅ Ensured original data: Qty=${matchedBatch.qty}, Free=${matchedBatch.freeQty}`);
            }
        }

        // ✅ 3. NEW FUNCTION: Auto-calculate free qty based on cumulative logic
               function autoCalculateFreeQty($row) {
            const originalQty = parseFloat($row.find(".original-purchase-qty").val()) || 0;
            const originalFree = parseFloat($row.find(".original-purchase-free").val()) || 0;
            const returnQty = parseFloat($row.find(".qty").val()) || 0;

            console.log(`🔍 autoCalculateFreeQty: OrigQty=${originalQty}, OrigFree=${originalFree}, ReturnQty=${returnQty}`);

            // ✅ SAFETY CHECK: If original data not loaded, skip calculation
            if (originalQty === 0 && originalFree === 0) {
                console.log("⚠️ Original purchase data not loaded yet, skipping free qty calculation");
                return;
            }

            if (originalQty === 0) {
                console.log("⚠️ No original qty, skipping");
                return;
            }

            if (originalFree === 0) {
                $row.find(".freeqty").val(0);
                console.log("✅ Original free is 0, set return free to 0");
                return;
            }

            // ✅ Get item details for cumulative calculation
            const itemId = $row.find(".item-id").val();
            const batch = $row.find(".batch").val()?.trim();
            const expiry = $row.find(".expirydate").val()?.trim();
            const mrp = parseFloat($row.find(".mrp").val()) || 0;
            const rate = parseFloat($row.find(".rate").val()) || 0;

            if (!itemId || !batch || !expiry) {
                console.log("⚠️ Missing item/batch/expiry, using simple ratio");
                // Fallback to simple ratio
                const freeRatio = originalFree / originalQty;
                const calculatedFree = returnQty * freeRatio;
                const roundedFree = Math.round(calculatedFree);
                $row.find(".freeqty").val(roundedFree);
                return;
            }

            const formattedExpiry = normalizeExpiryDate(expiry);
            if (!formattedExpiry) {
                console.log("⚠️ Invalid expiry format");
                return;
            }

            // ✅ CUMULATIVE LOGIC: Calculate total returned qty (EXCLUDING current row)
            const totalReturnedExcludingCurrent = calculateTotalEnteredQtyExcludingRow(
                itemId, batch, formattedExpiry, mrp, rate, $row
            );

            // ✅ Calculate total returned INCLUDING current row
            const totalReturnedIncludingCurrent = totalReturnedExcludingCurrent + returnQty;

            // ✅✅ SAFETY CHECK: Don't exceed original qty
            if (totalReturnedIncludingCurrent > originalQty) {
                console.log(`⚠️ Total returned (${totalReturnedIncludingCurrent}) exceeds original (${originalQty})`);
                // Cap at original qty
                const cappedTotal = originalQty;
                const returnPercentage = cappedTotal / originalQty;
                const cumulativeFreeQty = Math.floor(returnPercentage * originalFree);

                const freeQtyAlreadyGiven = calculateTotalEnteredFreeQtyExcludingRow(
                    itemId, batch, formattedExpiry, mrp, rate, $row
                );

                const freeQtyForCurrentRow = cumulativeFreeQty - freeQtyAlreadyGiven;
                const finalFreeQty = Math.max(0, freeQtyForCurrentRow);

                $row.find(".freeqty").val(finalFreeQty);
                return;
            }

            // ✅ Calculate how many free qty should be given based on cumulative percentage
            const returnPercentage = totalReturnedIncludingCurrent / originalQty;
            const cumulativeFreeQty = Math.floor(returnPercentage * originalFree);

            // ✅ Calculate already distributed free qty (from other rows)
            const freeQtyAlreadyGiven = calculateTotalEnteredFreeQtyExcludingRow(
                itemId, batch, formattedExpiry, mrp, rate, $row
            );

            // ✅ Calculate free qty for current row
            const freeQtyForCurrentRow = cumulativeFreeQty - freeQtyAlreadyGiven;

            // ✅ Make sure it's not negative
            const finalFreeQty = Math.max(0, freeQtyForCurrentRow);

            $row.find(".freeqty").val(finalFreeQty);

            console.log(`✅ Cumulative Calculation:
                - Total Returned (excl current): ${totalReturnedExcludingCurrent}
                - Total Returned (incl current): ${totalReturnedIncludingCurrent}
                - Return %: ${(returnPercentage * 100).toFixed(1)}%
                - Cumulative Free Should Be: ${cumulativeFreeQty}
                - Free Already Given: ${freeQtyAlreadyGiven}
                - Free For Current Row: ${finalFreeQty}`);
        }

        // ✅ 4. NEW HELPER: Calculate total entered qty EXCLUDING current row
        function calculateTotalEnteredQtyExcludingRow(itemId, batch, expiry, mrp, rate, $currentRow) {
            let total = 0;
            $("#PurchaseReturnItemBody tr").each(function () {
                const $row = $(this);

                // ✅ Skip current row
                if ($row.is($currentRow)) {
                    return; // continue to next iteration
                }

                const rowItemId = $row.find(".item-id").val();
                const rowBatch = $row.find(".batch").val()?.trim();
                const rowExpiry = normalizeExpiryDate($row.find(".expirydate").val()?.trim());
                const rowMrp = parseFloat($row.find(".mrp").val()) || 0;
                const rowRate = parseFloat($row.find(".rate").val()) || 0;
                const rowQty = parseFloat($row.find(".qty").val()) || 0;

                if (!rowExpiry) return;

                if (
                    rowItemId == itemId &&
                    compareBatch(rowBatch, batch) &&
                    rowExpiry === expiry &&
                    compareFloats(rowMrp, mrp) &&
                    compareFloats(rowRate, rate)
                ) {
                    total += rowQty;
                }
            });
            return total;
        }

        // ✅ 5. NEW HELPER: Calculate total entered free qty EXCLUDING current row
        function calculateTotalEnteredFreeQtyExcludingRow(itemId, batch, expiry, mrp, rate, $currentRow) {
            let total = 0;
            $("#PurchaseReturnItemBody tr").each(function () {
                const $row = $(this);

                // ✅ Skip current row
                if ($row.is($currentRow)) {
                    return; // continue to next iteration
                }

                const rowItemId = $row.find(".item-id").val();
                const rowBatch = $row.find(".batch").val()?.trim();
                const rowExpiry = normalizeExpiryDate($row.find(".expirydate").val()?.trim());
                const rowMrp = parseFloat($row.find(".mrp").val()) || 0;
                const rowRate = parseFloat($row.find(".rate").val()) || 0;
                const rowFreeQty = parseFloat($row.find(".freeqty").val()) || 0;

                if (!rowExpiry) return;

                if (
                    rowItemId == itemId &&
                    compareBatch(rowBatch, batch) &&
                    rowExpiry === expiry &&
                    compareFloats(rowMrp, mrp) &&
                    compareFloats(rowRate, rate)
                ) {
                    total += rowFreeQty;
                }
            });
            return total;
        }

        // ✅ 6. NEW FUNCTION: Recalculate free qty for all rows with same item-batch
        function recalculateFreeQtyForBatch(itemId, batch, expiry, mrp, rate) {
            console.log(`🔄 Recalculating free qty for: ItemId=${itemId}, Batch=${batch}`);

            // ✅ Find all rows with matching item-batch-expiry-mrp-rate
            const $matchingRows = [];

            $("#PurchaseReturnItemBody tr").each(function() {
                const $row = $(this);
                const rowItemId = $row.find(".item-id").val();
                const rowBatch = $row.find(".batch").val()?.trim();
                const rowExpiry = normalizeExpiryDate($row.find(".expirydate").val()?.trim());
                const rowMrp = parseFloat($row.find(".mrp").val()) || 0;
                const rowRate = parseFloat($row.find(".rate").val()) || 0;

                if (rowItemId == itemId &&
                    compareBatch(rowBatch, batch) &&
                    rowExpiry === expiry &&
                    compareFloats(rowMrp, mrp) &&
                    compareFloats(rowRate, rate)) {
                    $matchingRows.push($row);
                }
            });

            console.log(`📊 Found ${$matchingRows.length} matching rows to recalculate`);

            // ✅ Recalculate free qty for each matching row
            $matchingRows.forEach($row => {
                autoCalculateFreeQty($row);
            });
        }
    </script>

    <!-- ================================================================
     🔹 AUTO-POPULATE ORIGINAL PURCHASE DATA ON BATCH CHANGE
     ================================================================ -->
    <script>
        // ✅ When user types/changes batch manually
        $(document).on("input blur", ".batch", function() {
            const $row = $(this).closest("tr");
            const itemId = $row.find(".item-id").val();
            const batchValue = $(this).val()?.trim();

            // Skip if no item selected or batch is empty
            if (!itemId || !batchValue) {
                return;
            }

            // Try to find matching batch in groupedPurchaseData
            if (!Array.isArray(groupedPurchaseData) || groupedPurchaseData.length === 0) {
                return;
            }

            const matchedBatch = groupedPurchaseData.find(b =>
                b.itemId == itemId &&
                compareBatch(b.batch, batchValue)
            );

            if (matchedBatch) {
                // ✅ Auto-populate original purchase data
                $row.find(".original-purchase-qty").val(matchedBatch.qty || 0);
                $row.find(".original-purchase-free").val(matchedBatch.freeQty || 0);

                // Also populate other fields if empty
                if (!$row.find(".rate").val() || parseFloat($row.find(".rate").val()) === 0) {
                    $row.find(".rate").val(matchedBatch.rate || 0);
                }

                if (!$row.find(".mrp").val() || parseFloat($row.find(".mrp").val()) === 0) {
                    $row.find(".mrp").val(matchedBatch.mrp || 0);
                }

                if (!$row.find(".expirydate").val()) {
                    const d = new Date(matchedBatch.expiry);
                    const formatted = ("0" + (d.getMonth() + 1)).slice(-2) + "/" + d.getFullYear();
                    $row.find(".expirydate").val(formatted);
                }

                console.log(`✅ Auto-populated original data for batch ${batchValue}: Qty=${matchedBatch.qty}, Free=${matchedBatch.freeQty}`);

                // ✅ IMMEDIATELY CALCULATE FREE QTY AFTER SETTING ORIGINAL DATA
                const currentQty = parseFloat($row.find(".qty").val()) || 0;
                if (currentQty > 0) {
                    autoCalculateFreeQty($row);
                }
            }
        });
