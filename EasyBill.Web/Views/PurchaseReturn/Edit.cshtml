    <script>
        $(document).ready(function () {
            if (selectedSupplierId && selectedSupplierId !== 0) {
                loadSupplierItems(selectedSupplierId);
                loadReturnedQtyData(selectedSupplierId);

                // ✅ NEW: Load grouped purchase data for all existing items
                initializeGroupedPurchaseDataForEdit();
            }

            setTimeout(() => $("#BillDate").focus(), 100);

            calculateTotalSummary();
        });

        // ✅ UPDATED: Load batch data for ALL items on page load
        function initializeGroupedPurchaseDataForEdit() {
            const itemIds = new Set();

            // ✅ Collect all unique item IDs from the grid
            $("#PurchaseReturnItemBody tr").each(function () {
                const row = $(this);
                const itemId = row.find(".item-id").val();
                if (itemId) itemIds.add(itemId);
            });

            const supplierId = $(".supplier-id").val();

            let loadedItems = 0;
            const totalItems = itemIds.size;

            if (totalItems === 0) {
                return;
            }

            showLoader(`Loading batch data for ${totalItems} items...`);

            itemIds.forEach(itemId => {
                if (itemId && supplierId) {
                    $.get('/PurchaseReturn/GetBatchesByItemIdForEditOnly', { id: itemId, supplierId: supplierId }, function (data) {
                        if (data.groupedResult?.length > 0) {
                            data.groupedResult.forEach(batch => {
                                const exists = groupedPurchaseData.some(existing =>
                                    existing.itemId == batch.itemId &&
                                    existing.batch.toLowerCase() === batch.batch.toLowerCase() &&
                                    existing.expiry === batch.expiry &&
                                    parseFloat(existing.mrp) === parseFloat(batch.mrp) &&
                                    parseFloat(existing.rate) === parseFloat(batch.rate)
                                );

                                if (!exists) {
                                    groupedPurchaseData.push(batch);
                                }
                            });

                            // ✅✅ NEW: POPULATE ORIGINAL PURCHASE DATA FOR EXISTING ROWS
                            populateOriginalPurchaseDataForExistingRows(itemId, data.groupedResult);
                        }

                        loadedItems++;

                        if (loadedItems === totalItems) {
                            hideLoader();

                            // ✅ Validate all quantities after data is loaded
                            setTimeout(() => {
                                validateAllQuantitiesOnLoad();
                            }, 100);
                        }
                    }).fail(function() {
                        loadedItems++;

                        if (loadedItems === totalItems) {
                            hideLoader();
                            toastr.warning("Some batch data could not be loaded");
                        }
                    });
                }
            });
        }

               // ✅✅ NEW FUNCTION: Populate original purchase data for existing rows
        function populateOriginalPurchaseDataForExistingRows(itemId, batchData) {
            $("#PurchaseReturnItemBody tr").each(function() {
                const $row = $(this);
                const rowItemId = $row.find(".item-id").val();

                if (rowItemId != itemId) return;

                const rowBatch = $row.find(".batch").val()?.trim();
                const rowExpiry = $row.find(".expirydate").val()?.trim();
                const rowMrp = parseFloat($row.find(".mrp").val()) || 0;
                const rowRate = parseFloat($row.find(".rate").val()) || 0;

                if (!rowBatch || !rowExpiry) return;

                const formattedRowExpiry = normalizeExpiryDate(rowExpiry);
                if (!formattedRowExpiry) return;

                // Find matching batch
                const matchedBatch = batchData.find(b => {
                    const backendExpiry = normalizeBackendExpiry(b.expiry);
                    if (!backendExpiry) return false;

                    return (
                        compareBatch(b.batch, rowBatch) &&
                        backendExpiry === formattedRowExpiry &&
                        compareFloats(parseFloat(b.mrp), rowMrp) &&
                        compareFloats(parseFloat(b.rate), rowRate)
                    );
                });

                if (matchedBatch) {
                    // ✅ Set original purchase data
                    $row.find(".original-purchase-qty").val(matchedBatch.purchasedQty || matchedBatch.qty || 0);
                    $row.find(".original-purchase-free").val(matchedBatch.purchasedFreeQty || matchedBatch.freeQty || 0);

                    console.log(`✅ Populated original data for row: ItemId=${itemId}, Batch=${rowBatch}, Qty=${matchedBatch.purchasedQty || matchedBatch.qty}, Free=${matchedBatch.purchasedFreeQty || matchedBatch.freeQty}`);
                }
            });
        }

        // ✅ NEW: Validate all quantities on page load
        function validateAllQuantitiesOnLoad() {
            $("#PurchaseReturnItemBody tr").each(function () {
                const $row = $(this);
                const $qtyInput = $row.find(".qty");

                if ($qtyInput.length) {
                    validateQuantityInput($qtyInput);
                }
            });
        }
    </script>


