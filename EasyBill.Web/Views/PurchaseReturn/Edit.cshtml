                const expiry = $row.find(".expirydate").val()?.trim();
                const mrp = parseFloat($row.find(".mrp").val()) || 0;
                const rate = parseFloat($row.find(".rate").val()) || 0;

                if (itemId && batch && expiry) {
                    const formattedExpiry = normalizeExpiryDate(expiry);
                    if (formattedExpiry) {
                        // Recalculate other rows (excluding current)
                        $("#PurchaseReturnItemBody tr").each(function() {
