@using EasyBill.Models.ViewModels
@model IEnumerable<PurchaseReturnVM>
<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>


<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2 d-flex align-items-center" style="background: #2b6ac9;">
        Purchase Return Report - Supplier Wise
        <span class="ms-auto">
            Total GstAmt:
            <span class="fw-bold">@ViewBag.TotalGst?.ToString("0.00")</span> |
            Total Amt:
            <span class="fw-bold">@ViewBag.TotalPayable?.ToString("0.00")</span>
        </span>
    </div>
</div>
@{
    var suppliers = ViewBag.Supplier as List<Supplier>;
    int? selectedSupplierId = ViewBag.SelectedSupplierId as int?;
}

<form method="get"
      asp-action="PurchaseReturnReportSupplierWise"
      asp-controller="PurchaseReturn"
      class="card p-3 mb-3">

    <div class="row align-items-end">

     

        <!-- From Date -->
        <div class="col-md-2">
            <label class="form-label">Date From</label>
            <input type="date"
                   name="fromDate"
                   class="form-control"
                   value="@ViewBag.FromDate" />
        </div>

        <!-- To Date -->
        <div class="col-md-2">
            <label class="form-label">Date To</label>
            <input type="date"
                   name="toDate"
                   class="form-control"
                   value="@ViewBag.ToDate" />
        </div>
        <!-- Supplier -->
        <div class="col-md-3">
            <label class="form-label">Supplier</label>
            <select name="SupplierId" class="form-select">
                <option value="">-- All Suppliers --</option>
                @foreach (var supplier in suppliers)
                {
                    <option value="@supplier.Id"
                            selected="@(selectedSupplierId == supplier.Id)">
                        @supplier.FirstName
                    </option>
                }
            </select>
        </div>
        <!-- Submit -->
        <div class="col-md-2">
            <button type="submit"
                    class="btn w-100 text-light"
                    style="background:#2b6ac9;">
                <i class="bi bi-search"></i> Search
            </button>
        </div>

    </div>
</form>

<div class="row mb-2">
    <div class="col text-end">

        <!-- Excel -->
        <a asp-action="PurchaseReturnSupplierWiseExcel"
           asp-controller="PurchaseReturn"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           asp-route-SupplierId="@ViewBag.SelectedSupplierId">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>

        <!-- PDF -->
        <a asp-action="PurchaseReturnSupplierWisePdf"
           asp-controller="PurchaseReturn"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           asp-route-SupplierId="@ViewBag.SelectedSupplierId">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>

    </div>
</div>


<table id="purchaseReturnTbl" class="table table-bordered table-sm">
    <thead class="table-primary">
        <tr>
            <th>S.No</th>
            <th>Debit Note No</th>
            <th>Date</th>
            <th>Supplier</th>
            <th class="text-end">Gst Amount</th>
            <th class="text-end">Total Amount</th>
        </tr>
    </thead>
    <tbody>
        @{
            int sr = 1;
        }
        @foreach (var purchase in Model)
        {
            <tr>
                <td>@sr</td>
                <td>@purchase.BillNo</td>
                <td>@purchase.BillDate?.ToString("dd-MM-yyyy")</td>
                <td>@purchase.SupplierName</td>
                <td class="text-end">@purchase.TotalGstAmt</td>
                <td class="text-end">@purchase.TotalPayable</td>
            </tr>
            sr++;
        }
    </tbody>
    <tfoot class="table-secondary fw-bold">
        <tr>
            <td></td>
            <td></td>
            <td></td>
            <td class="text-end">TOTAL</td>
            <td class="text-end">@ViewBag.TotalGst</td>
            <td class="text-end">@ViewBag.TotalPayable</td>
        </tr>
    </tfoot>
</table>
@section Scripts {
    <script>
        $(document).ready(function () {
            var t = $("#purchaseReturnTbl").DataTable({
                "order": [[2, "desc"]],
                "columnDefs": [
                    { "orderable": false, "targets": "_all" }
                ]
                  });

            t.on('order.dt search.dt', function () {
                t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                    cell.innerHTML = i + 1;
                });
            }).draw();
        });

    </script>
}
