    <!-- ================================================================
     QUANTITY VALIDATION WITH RETURNED QTY CHECK
     ================================================================ -->
    <script>
        // ✅ EXISTING INPUT VALIDATION (update this)
        $(document).on("input", ".qty", function () {
            const $qtyInput = $(this);
            const $row = $qtyInput.closest("tr");

            // ✅ FIRST: Ensure original purchase data is set
            ensureOriginalPurchaseData($row);

            // ✅ AUTO-CALCULATE FREE QTY for current row
            autoCalculateFreeQty($row);

            // ✅ NEW: Recalculate ALL other rows with same item-batch
            const itemId = $row.find(".item-id").val();
            const batch = $row.find(".batch").val()?.trim();
            const expiry = $row.find(".expirydate").val()?.trim();
            const mrp = parseFloat($row.find(".mrp").val()) || 0;
            const rate = parseFloat($row.find(".rate").val()) || 0;

            if (itemId && batch && expiry) {
                const formattedExpiry = normalizeExpiryDate(expiry);
                if (formattedExpiry) {
                    // Recalculate other rows (excluding current)
                    $("#PurchaseReturnItemBody tr").each(function() {
                        const $otherRow = $(this);

                        // Skip current row (already calculated above)
                        if ($otherRow.is($row)) return;

                        const otherItemId = $otherRow.find(".item-id").val();
                        const otherBatch = $otherRow.find(".batch").val()?.trim();
                        const otherExpiry = normalizeExpiryDate($otherRow.find(".expirydate").val()?.trim());
                        const otherMrp = parseFloat($otherRow.find(".mrp").val()) || 0;
                        const otherRate = parseFloat($otherRow.find(".rate").val()) || 0;

                        if (otherItemId == itemId &&
                            compareBatch(otherBatch, batch) &&
                            otherExpiry === formattedExpiry &&
                            compareFloats(otherMrp, mrp) &&
                            compareFloats(otherRate, rate)) {
                            autoCalculateFreeQty($otherRow);
                        }
                    });
                }
            }

            // Then validate
            validateQuantityInput($qtyInput);
        });

        // ✅ NEW: FOCUS VALIDATION (update this)
        $(document).on("focus", ".qty", function () {
            const $qtyInput = $(this);
            const $row = $qtyInput.closest("tr");

            // ✅ FIRST: Ensure original purchase data is set
            ensureOriginalPurchaseData($row);

            // ✅ AUTO-CALCULATE FREE QTY ON FOCUS
            autoCalculateFreeQty($row);

            validateQuantityInput($qtyInput);
        });

        // ✅ NEW HELPER FUNCTION
        function ensureOriginalPurchaseData($row) {
            const itemId = $row.find(".item-id").val();
            const batchValue = $row.find(".batch").val()?.trim();

            // Skip if no item/batch or data already set
            if (!itemId || !batchValue) return;

            const existingOriginalQty = $row.find(".original-purchase-qty").val();
            if (existingOriginalQty) return; // Already set

            // Try to find and set from groupedPurchaseData
            if (!Array.isArray(groupedPurchaseData) || groupedPurchaseData.length === 0) {
                return;
            }

            const matchedBatch = groupedPurchaseData.find(b =>
                b.itemId == itemId &&
                compareBatch(b.batch, batchValue)
            );

            if (matchedBatch) {
                $row.find(".original-purchase-qty").val(matchedBatch.qty || 0);
                $row.find(".original-purchase-free").val(matchedBatch.freeQty || 0);

                console.log(`✅ Ensured original data: Qty=${matchedBatch.qty}, Free=${matchedBatch.freeQty}`);
            }
        }
        // NEW FUNCTION: Auto-calculate free qty based on purchase ratio
        // ✅ NEW FUNCTION: Auto-calculate free qty based on CUMULATIVE logic
        function autoCalculateFreeQty($row) {
            const originalQty = parseFloat($row.find(".original-purchase-qty").val()) || 0;
            const originalFree = parseFloat($row.find(".original-purchase-free").val()) || 0;
            const returnQty = parseFloat($row.find(".qty").val()) || 0;

            console.log(`🔍 autoCalculateFreeQty: OrigQty=${originalQty}, OrigFree=${originalFree}, ReturnQty=${returnQty}`);

            if (originalQty === 0) {
                console.log("⚠️ No original qty, skipping");
                return;
            }

            if (originalFree === 0) {
                $row.find(".freeqty").val(0);
                console.log("✅ Original free is 0, set return free to 0");
                return;
            }

            // ✅ Get item details for cumulative calculation
            const itemId = $row.find(".item-id").val();
            const batch = $row.find(".batch").val()?.trim();
            const expiry = $row.find(".expirydate").val()?.trim();
            const mrp = parseFloat($row.find(".mrp").val()) || 0;
            const rate = parseFloat($row.find(".rate").val()) || 0;

            if (!itemId || !batch || !expiry) {
                console.log("⚠️ Missing item/batch/expiry, using simple ratio");
                // Fallback to simple ratio
                const freeRatio = originalFree / originalQty;
                const calculatedFree = returnQty * freeRatio;
                const roundedFree = Math.round(calculatedFree);
                $row.find(".freeqty").val(roundedFree);
                return;
            }

            const formattedExpiry = normalizeExpiryDate(expiry);
            if (!formattedExpiry) {
                console.log("⚠️ Invalid expiry format");
                return;
            }

            // ✅ CUMULATIVE LOGIC: Calculate total returned qty (EXCLUDING current row)
            const totalReturnedExcludingCurrent = calculateTotalEnteredQtyExcludingRow(
                itemId, batch, formattedExpiry, mrp, rate, $row
            );

            // ✅ Calculate total returned INCLUDING current row
            const totalReturnedIncludingCurrent = totalReturnedExcludingCurrent + returnQty;

            // ✅ Calculate how many free qty should be given based on cumulative percentage
            let cumulativeFreeQty = 0;

            // Simple proportion: If 60% qty returned, give 60% of free qty
            const returnPercentage = totalReturnedIncludingCurrent / originalQty;
            cumulativeFreeQty = Math.floor(returnPercentage * originalFree);

            // ✅ Calculate already distributed free qty (from other rows)
            const freeQtyAlreadyGiven = calculateTotalEnteredFreeQtyExcludingRow(
                itemId, batch, formattedExpiry, mrp, rate, $row
            );

            // ✅ Calculate free qty for current row
            const freeQtyForCurrentRow = cumulativeFreeQty - freeQtyAlreadyGiven;

            // ✅ Make sure it's not negative
            const finalFreeQty = Math.max(0, freeQtyForCurrentRow);

            $row.find(".freeqty").val(finalFreeQty);

            console.log(`✅ Cumulative Calculation:
                - Total Returned (excl current): ${totalReturnedExcludingCurrent}
                - Total Returned (incl current): ${totalReturnedIncludingCurrent}
                - Return %: ${(returnPercentage * 100).toFixed(1)}%
                - Cumulative Free Should Be: ${cumulativeFreeQty}
                - Free Already Given: ${freeQtyAlreadyGiven}
                - Free For Current Row: ${finalFreeQty}`);
        }

        // MODIFIED VALIDATION LOGIC
        function validateQuantityInput($qtyInput) {
            const $row = $qtyInput.closest("tr");

            // Clear previous validation state
            $qtyInput.removeClass('is-invalid');
            $row.find(".freeqty").removeClass('is-invalid');

            // Get row data
            const itemId = $row.find(".item-id").val();
            const batch = $row.find(".batch").val()?.trim();
            const expiry = $row.find(".expirydate").val()?.trim();
            const mrp = parseFloat($row.find(".mrp").val()) || 0;
            const rate = parseFloat($row.find(".rate").val()) || 0;
            const inputQty = parseFloat($qtyInput.val()) || 0;
            const inputFreeQty = parseFloat($row.find(".freeqty").val()) || 0;

            // ✅ STEP 1-4: Basic validation
            if (!itemId || !batch || !expiry || !mrp || !rate) {
                calculateRow($row);
                return;
            }

            const formattedExpiry = normalizeExpiryDate(expiry);
            if (!formattedExpiry) {
                calculateRow($row);
                return;
            }

            if (!Array.isArray(groupedPurchaseData) || groupedPurchaseData.length === 0) {
                calculateRow($row);
                return;
            }

            const matched = groupedPurchaseData.find(g => {
                const backendExpiry = normalizeBackendExpiry(g.expiry);
                if (!backendExpiry) return false;

                return (
                    g.itemId == itemId &&
                    compareBatch(g.batch, batch) &&
                    backendExpiry === formattedExpiry &&
                    compareFloats(parseFloat(g.mrp), mrp) &&
                    compareFloats(parseFloat(g.rate), rate)
                );
            });

            if (!matched) {
                toastr.error("No purchase record found for this item group.");
                $qtyInput.val('').addClass('is-invalid');
                $row.find(".freeqty").val('0');
                calculateRow($row);
                return;
            }

            // ✅ STEP 5: Calculate OTHER ROWS' total
            const totalEnteredExcludingCurrent = calculateTotalEnteredQtyExcludingRow(
                itemId, batch, formattedExpiry, mrp, rate, $row
            );
            const totalEnteredFreeExcludingCurrent = calculateTotalEnteredFreeQtyExcludingRow(
                itemId, batch, formattedExpiry, mrp, rate, $row
            );

            // ✅ STEP 6: Get already returned from database
            const alreadyReturned = getAlreadyReturnedQty(itemId, batch, formattedExpiry, mrp, rate);
            const alreadyReturnedFree = getAlreadyReturnedFreeQty(itemId, batch, formattedExpiry, mrp, rate);

            // 🔍🔍🔍 DEBUG CONSOLE LOGS
            console.log("=== VALIDATION DEBUG ===");
            console.log("ItemId:", itemId);
            console.log("Batch:", batch);
            console.log("Expiry (formatted):", formattedExpiry);
            console.log("MRP:", mrp);
            console.log("Rate:", rate);
            console.log("---");
            console.log("Matched Purchase Record:", matched);
            console.log("Purchased Qty:", matched.qty);
            console.log("Purchased Free Qty:", matched.freeQty);
            console.log("---");
            console.log("Already Returned (DB):", alreadyReturned);
            console.log("Already Returned Free (DB):", alreadyReturnedFree);
            console.log("---");
            console.log("Entered in OTHER rows:", totalEnteredExcludingCurrent);
            console.log("Entered Free in OTHER rows:", totalEnteredFreeExcludingCurrent);
            console.log("---");
            console.log("Input Qty (current row):", inputQty);
            console.log("Input Free Qty (current row):", inputFreeQty);
            console.log("---");

            // ✅ STEP 7: Calculate available
            const totalAvailableQty = matched.qty - alreadyReturned;
            const totalAvailableFreeQty = matched.freeQty - alreadyReturnedFree;

            console.log("Total Available Qty:", totalAvailableQty);
            console.log("Total Available Free Qty:", totalAvailableFreeQty);
            console.log("---");

            // ✅ STEP 8: Calculate remaining after other rows
