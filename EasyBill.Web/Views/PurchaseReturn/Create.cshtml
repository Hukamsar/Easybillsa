    <!-- ================================================================
         🔹 ARROW KEY NAVIGATION
         ================================================================ -->
    <script>
        // CLEANED VERSION - Remove .reason-dropdown references
        $(document).on("keydown", ".batch, .qty, .freeqty, .rate, .discount", function(e) {
            const row = $(this).closest("tr");
            const current = $(this);

            // ✅ ARROW RIGHT
            if (e.key === "ArrowRight") {
                e.preventDefault();
                if (current.hasClass("batch")) row.find(".qty").focus().select();
                else if (current.hasClass("qty")) row.find(".freeqty").focus().select();
                else if (current.hasClass("freeqty")) row.find(".rate").focus().select();
                else if (current.hasClass("rate")) row.find(".discount").focus().select();
                // ✅ Discount is now the last field in row
            }

            // ✅ ARROW LEFT
            if (e.key === "ArrowLeft") {
                e.preventDefault();
                if (current.hasClass("discount")) row.find(".rate").focus().select();
                else if (current.hasClass("rate")) row.find(".freeqty").focus().select();
                else if (current.hasClass("freeqty")) row.find(".qty").focus().select();
                else if (current.hasClass("qty")) row.find(".batch").focus().select();
                else if (current.hasClass("batch")) row.find(".item-input").focus();
            }

            // ✅ ARROW DOWN - Navigate to next row
            if (e.key === "ArrowDown") {
                e.preventDefault();
                const nextRow = row.next("tr");
                if (!nextRow.length) return;

                if (current.hasClass("batch")) nextRow.find(".batch").focus().select();
                else if (current.hasClass("qty")) nextRow.find(".qty").focus().select();
                else if (current.hasClass("freeqty")) nextRow.find(".freeqty").focus().select();
                else if (current.hasClass("rate")) nextRow.find(".rate").focus().select();
                else if (current.hasClass("discount")) nextRow.find(".discount").focus().select();
            }

            // ✅ ARROW UP - Navigate to previous row
            if (e.key === "ArrowUp") {
                e.preventDefault();
                const prevRow = row.prev("tr");

                if (!prevRow.length) {
                    // ✅ If first row, go back to Reason dropdown in header
                    $(".reason-dropdown-header").focus();
                    return;
                }

                if (current.hasClass("batch")) prevRow.find(".batch").focus().select();
                else if (current.hasClass("qty")) prevRow.find(".qty").focus().select();
                else if (current.hasClass("freeqty")) prevRow.find(".freeqty").focus().select();
                else if (current.hasClass("rate")) prevRow.find(".rate").focus().select();
                else if (current.hasClass("discount")) prevRow.find(".discount").focus().select();
            }
        });

    </script>

    <!-- ================================================================
         🔹 BATCH MODAL NAVIGATION
         ================================================================ -->
    <script>
        $('#batchModal').on('shown.bs.modal', function () {
            batchNavMode = "keyboard";
            isKeyboardScrollingBatchModal = false;

            $("#batchModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".batch-row:visible");

            if (currentBatchIndex >= 0 && currentBatchIndex < $rows.length) {
                highlightBatchRow($rows, currentBatchIndex);
            } else {
                currentBatchIndex = 0;
                if ($rows.length) {
                    highlightBatchRow($rows, currentBatchIndex);
                }
            }
        });

        function highlightBatchRow($rows, index) {
            $rows.removeClass("selected");

            const $row = $rows.eq(index);
            if (!$row.length) return;

            $row.addClass("selected");

            const container = document.querySelector("#batchModal .batch-table-wrapper");
            if (!container) return;

            const rowRect = $row[0].getBoundingClientRect();
            const containerRect = container.getBoundingClientRect();
            const headerHeight = document.querySelector("#batchTable thead")?.offsetHeight || 50;

            if (rowRect.top < containerRect.top + headerHeight) {
                container.scrollTop -= (containerRect.top + headerHeight - rowRect.top);
            }
            else if (rowRect.bottom > containerRect.bottom) {
                container.scrollTop += (rowRect.bottom - containerRect.bottom);
            }
        }

        $(document).on("click", ".batch-row", function () {
            $(".batch-row").removeClass("selected");
            $(this).addClass("selected");

            const encoded = $(this).attr("data-batch");
            try {
                const batch = JSON.parse(decodeURIComponent(encoded));
                if (currentRow) {
                    currentRow.find(".batch").val(batch.batch);
                    currentRow.find(".rate").val(batch.rate || 0);
                    currentRow.find(".mrp").val(batch.mrp || 0);

                    // ✅ Store original purchase qty and free qty for ratio calculation
                    currentRow.find(".original-purchase-qty").val(batch.qty || 0);
                    currentRow.find(".original-purchase-free").val(batch.freeQty || 0);

                    if (batch.expiry) {
                        let date = new Date(batch.expiry);
                        let formatted = ("0" + (date.getMonth() + 1)).slice(-2) + "/" + date.getFullYear();
                        currentRow.find(".expirydate").val(formatted);
                    }

                    calculateRow(currentRow);
                }
                $("#batchModal").modal("hide");

                setTimeout(() => {
                    if (currentRow) currentRow.find(".qty").focus().select();
                }, 150);

            } catch (err) {
                alert("Invalid batch data.");
                console.error(err);
            }
        });

        $(document).on("keydown", function (e) {
            if (!$("#batchModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                batchNavMode = "keyboard";
                isKeyboardScrollingBatchModal = true;

                $("#batchModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");

                setTimeout(() => {
                    isKeyboardScrollingBatchModal = false;
                }, 300);
            }

            const $rows = $(".batch-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentBatchIndex === -1) {
                    currentBatchIndex = 0;
                } else if (currentBatchIndex < $rows.length - 1) {
                    currentBatchIndex++;
                }

                highlightBatchRow($rows, currentBatchIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();
                if (currentBatchIndex <= 0) return;

                currentBatchIndex--;
                highlightBatchRow($rows, currentBatchIndex);
            }
            else if (e.key === "Enter" && currentBatchIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentBatchIndex).trigger("click");
            }
        });

        $(document).on("mouseenter", ".batch-row", function () {
            if (!$("#batchModal").is(":visible")) return;

            if (isKeyboardScrollingBatchModal) return;

            batchNavMode = "mouse";

            $("#batchModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".batch-row:visible");
            $rows.removeClass("selected");

            $(this).addClass("selected");
            currentBatchIndex = $rows.index(this);
        });
    </script>

