    <script>
        function loadItemPurchaseHistory(itemId) {
            const supplierId = $(".supplier-id").val();

            // SHOW wrapper when function is called
            $("#itemReturnInfoWrapper").show();

            $.get(`/PurchaseReturn/GetItemPurchaseHistory`,
                { itemId, supplierId },
                function (res) {

                if (!res.success || !res.data.length) {
                    $("#itemReturnInfoBody").html(`
                        <tr>
                            <td colspan="9" class="text-warning text-center">
                                No purchase history found
                            </td>
                        </tr>
                    `);
                    return;
                }

                let rows = "";
                res.data.forEach(x => {
                    rows += `
                        <tr>
                            <td>${x.supplier}</td>
                            <td>${x.billNo}</td>
                            <td>${formatDate(x.billDate)}</td>
                            <td>${x.qty}</td>
                            <td>${x.freeQty}</td>
                            <td>${x.batch}</td>
                            <td>${x.mrp}</td>
                            <td>${x.rate}</td>
                            <td>${x.expiryDate ? formatDate(x.expiryDate) : "--"}</td>
                            <td>${x.totalDiscount}</td>
                            <td>${x.batchWiseCost}</td>
                        </tr>`;
                });

                $("#itemReturnInfoBody").html(rows);
            });
        }

        function formatDate(dateStr) {
            const d = new Date(dateStr);
            if (isNaN(d)) return "--";

            return (
                ("0" + d.getDate()).slice(-2) + "/" +
                ("0" + (d.getMonth() + 1)).slice(-2) + "/" +
                d.getFullYear()
            );
        }

