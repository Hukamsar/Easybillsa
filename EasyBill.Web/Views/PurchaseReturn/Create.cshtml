        function processItemSelection(itemId, row) {
            currentRow = row;
            showLoader("Checking batches...");

            const supplierId = $(".supplier-id").val();
            const businessType = parseInt('@ViewBag.BusinessType') || 0;

            $.get('/PurchaseReturn/GetBatchesByItemId', { id: itemId, supplierId: supplierId }, function (data) {
                hideLoader();

                if (data.error) {
                    toastr.error(data.error);
                    return;
                }

                // ✅ Set GST + HSN
                row.find(".gst").val(data.gst || 0);
                row.find(".cess").val(data.cess || 0);
                row.find(".hsn-dropdown").val(data.hsn || "");

                if (!data.groupedResult || data.groupedResult.length === 0) {
                    toastr.warning("No batches available for this item");
                    focusBatchAfterItemSelect = true;
                    return;
                }

                // ✅ Store full batch data (SAFE)
                groupedPurchaseData = data.groupedResult.map(batch => ({
                    itemId: batch.itemId,
                    batch: batch.batch,
                    expiry: batch.expiry,
                    rate: batch.rate,
                    mrp: batch.mrp,
                    qty: batch.purchasedQty ?? batch.qty ?? 0,
                    freeQty: batch.purchasedFreeQty ?? batch.freeQty ?? 0,
                    currentStock: batch.currentStock ?? batch.qty ?? 0,
                    availableQty: batch.availableQty ?? null,
                    purchaseItemId: batch.purchaseItemId
                }));

                loadItemPurchaseHistory(itemId);

                // ===================== BUILD TABLE =====================
                let batchRows = '';

                data.groupedResult.forEach(batch => {

                    // ✅ Date format safe
                    const d = batch.expiry ? new Date(batch.expiry) : null;
                    const formattedExpiry = d
                        ? ("0" + (d.getMonth() + 1)).slice(-2) + "/" + d.getFullYear()
                        : "";

                    // ✅ Safe values
                    const currentStock = batch.currentStock ?? batch.qty ?? 0;

                    // ✅ Final display qty (conversion handled from backend)
                    const displayQty = batch.availableQty || currentStock;

                    // ✅ Encode full batch object
                    const batchData = {
                        itemId: batch.itemId,
                        batch: batch.batch,
                        expiry: batch.expiry,
                        rate: batch.rate,
                        mrp: batch.mrp,
                        qty: batch.purchasedQty ?? batch.qty ?? 0,
                        freeQty: batch.purchasedFreeQty ?? batch.freeQty ?? 0,
                        currentStock: currentStock
                    };

                    const encoded = encodeURIComponent(JSON.stringify(batchData));

                    // ===================== ROW =====================
                    batchRows += `
                    <tr class="batch-row"
                        data-qty="${currentStock}"
                        data-batch="${encoded}">

                        <td>${batch.batch || ''}</td>
                        <td>${formattedExpiry}</td>
                        <td>${batch.rate ?? 0}</td>
