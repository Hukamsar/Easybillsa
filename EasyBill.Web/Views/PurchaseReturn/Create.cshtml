        // ================================================================
        // 🔹 HELPER FUNCTIONS FOR VALIDATION
        // ================================================================
        function normalizeExpiryDate(expiryStr) {
            if (!expiryStr) return null;

            // Trim whitespace
            expiryStr = expiryStr.trim();

            if (!expiryStr.includes('/')) return null;

            const parts = expiryStr.split('/');
            if (parts.length !== 2) return null;

            const [mm, yy] = parts;

            // Validate inputs exist
            if (!mm || !yy) return null;

            const month = mm.trim().padStart(2, '0');
            const yearStr = yy.trim();

            // Handle both 2-digit and 4-digit year
            let year;
            if (yearStr.length === 2) {
                // Convert 2-digit year to 4-digit (26 → 2026)
                year = "20" + yearStr;
            } else if (yearStr.length === 4) {
                // Already 4-digit
                year = yearStr;
            } else {
                return null; // Invalid year format
            }

            // Validate month
            const monthNum = parseInt(month);
            if (isNaN(monthNum) || monthNum < 1 || monthNum > 12) return null;

            return `${year}-${month}-01`;
        }

        function normalizeBackendExpiry(expiry) {
            if (!expiry) return null;

            try {
                let dateStr;

                if (typeof expiry === 'string') {
                    if (expiry.includes('T')) {
                        // ISO format: "2026-06-01T00:00:00"
                        dateStr = expiry.split("T")[0];
                    } else if (expiry.includes('/')) {
                        // MM/YYYY or MM/YY format
                        const [mm, yy] = expiry.split('/');
                        const month = mm.padStart(2, '0');

                        // ✅ Handle both 2-digit and 4-digit year
                        let year;
                        if (yy.length === 2) {
                            year = "20" + yy;
                        } else if (yy.length === 4) {
                            year = yy;
                        } else {
                            return null;
                        }

                        dateStr = `${year}-${month}-01`;
                    } else if (expiry.includes('-')) {
                        // Already in YYYY-MM-DD format
                        dateStr = expiry;
                    } else {
                        return null;
                    }
                } else if (expiry instanceof Date) {
                    const d = new Date(expiry);
                    const year = d.getFullYear();
                    const month = String(d.getMonth() + 1).padStart(2, '0');
                    dateStr = `${year}-${month}-01`;
                }

                return dateStr;
            } catch (e) {
                console.error("Error normalizing expiry:", e);
                return null;
            }
        }

        function compareFloats(a, b, tolerance = 0.01) {
            return Math.abs(a - b) < tolerance;
        }

        function compareBatch(batch1, batch2) {
            if (!batch1 || !batch2) return false;
            return batch1.trim().toLowerCase() === batch2.trim().toLowerCase();
        }

