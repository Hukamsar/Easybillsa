@using EasyBill.Models.ViewModels
@model ModeOfPaymentVM

@{
    ViewData["Title"] = "Mode of Payment";
}

<style>
    .card-header {
        background-color: #2b6ac9 !important;
        color: white !important;
        font-weight: 500;
        font-size: 16px;
    }

    .custom-header th {
        background-color: #2b6ac9 !important;
        color: white !important;
        border-color: #2b6ac9 !important;
        text-align: center;
        vertical-align: middle;
    }

    .form-label {
        min-width: 120px;
    }

    .form-control-sm {
        height: calc(1.5em + .5rem + 2px);
    }

    .swal2-confirm,
    .swal2-cancel {
        border-radius: 8px !important;
        padding: 8px 20px !important;
        font-weight: 500 !important;
        transition: all 0.25s ease-in-out !important;
        margin: 0 8px !important;
    }

        .swal2-confirm:hover {
            background-color: #157347 !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(25, 135, 84, 0.4);
        }

        .swal2-cancel:hover {
            background-color: #bb2d3b !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(220, 53, 69, 0.4);
        }

        .swal2-confirm:focus,
        .swal2-cancel:focus {
            outline: none !important;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.4) !important;
        }
</style>

<div class="card mb-3 shadow-sm">
    <div class="card-header py-2">Add Payment Mode</div>
    <div class="card-body">
        <form method="post" asp-action="Create" asp-controller="PaymentMode" id="ModeOfPaymentForm">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="row g-3">

                <div class="col-md-4 d-flex align-items-center">
                    <label asp-for="Name" class="form-label mb-0">
                        Name <span class="text-danger">*</span>
                    </label>
                    <input type="text" asp-for="Name" class="form-control form-control-sm ms-2" required />
                    <span asp-validation-for="Name" class="text-danger ms-2"></span>
                </div>

                <div class="col-md-4 d-flex align-items-center">
                    <label asp-for="PaymentType" class="form-label mb-0">
                        Payment Type <span class="text-danger">*</span>
                    </label>
                    <select asp-for="PaymentType" class="form-control form-control-sm ms-2"
                            asp-items="Html.GetEnumSelectList<modeofpayment>()" required>
                        <option value="">Select Payment Type</option>
                    </select>
                    <span asp-validation-for="PaymentType" class="text-danger ms-2"></span>
                </div>

                <div class="col-md-4" id="bankDropdownDiv" style="display:none;">
                    <div class="d-flex align-items-center">
                        <label asp-for="BankId" class="form-label mb-0">
                            Bank <span class="text-danger">*</span>
                        </label>
                        <select asp-for="BankId" class="form-control form-control-sm ms-2"
                                asp-items="ViewBag.BankList">
                            <option value="">Select Bank</option>
                        </select>
                        <span asp-validation-for="BankId" class="text-danger ms-2"></span>
                    </div>
                </div>

                <div class="col-md-4 d-flex align-items-center">
                    <label asp-for="Description" class="form-label mb-0">Description</label>
                    <textarea asp-for="Description" class="form-control form-control-sm ms-2"></textarea>
                </div>

            </div>

            <div class="mt-3 text-end">
                <button type="submit" class="btn btn-sm btn-primary btnBright-Sky-Blue mt-3">Save</button>
            </div>
        </form>
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead class="custom-header">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.PaymentType)</th>
            <th>Bank Name</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ModeOfPayments)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.PaymentType)</td>
                <td>@(item.Bank?.BankName ?? "-")</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>
                    <div class="btn-group" role="group" style="float:right">
                        <a asp-controller="PaymentMode" asp-action="Edit" asp-route-id="@item.Id" title="Edit">
                            <i class="bi bi-pencil-square p-1"></i>
                        </a>

                        <a asp-controller="PaymentMode"
                           asp-action="Delete"
                           class="btn-delete"
                           title="Delete"
                           asp-route-id="@item.Id"
                           data-id="@item.Id"
                           data-controller="@ViewContext.RouteData.Values["controller"]">
                            <i class="bi bi-trash-fill text-danger p-1"></i>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            let isSubmitting = false;

            function toggleBankDropdown() {
                var paymentType = $("select[name='PaymentType']").val();
                if (paymentType == "2") { // 2 = Bank
                    $("#bankDropdownDiv").show();
                    $("select[name='BankId']").prop("required", true);
                } else {
                    $("#bankDropdownDiv").hide();
                    $("select[name='BankId']").prop("required", false).val("");
                }
            }

            $("select[name='PaymentType']").on("change", toggleBankDropdown);
            toggleBankDropdown(); // Run on page load

            var paymentMap = {
                "credit card": "Bank",
                "upi": "Bank",
                "cash": "Cash"
            };

            $("input[name='Name']").on("blur", function () {
                var name = $(this).val().trim().toLowerCase();
                if (paymentMap[name]) {
                    // Find paymentType enum corresponding value
                    var select = $("select[name='PaymentType']");
                    var optVal = "";
                    select.find("option").each(function() {
                        if ($(this).text().trim() === paymentMap[name]) {
                            optVal = $(this).val();
                        }
                    });
                    if (optVal) {
                        select.val(optVal).trigger("change");
                    }
                }
            });

            $("#ModeOfPaymentForm").on("submit", function (e) {
                e.preventDefault();

                if (isSubmitting) return false;

                let form = this;

                if ($(this).valid && !$(this).valid()) {
                    return;
                }

                var name = $("input[name='Name']").val()?.trim();
                var paymentType = $("select[name='PaymentType']").val();
                var bankId = $("select[name='BankId']").val();
                var id = 0;

                if (!name) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Please enter Name!',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#2b6ac9'
                    });
                    return;
                }

                if (!paymentType) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Please select Payment Type!',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#2b6ac9'
                    });
                    return;
                }

                if (paymentType == "2" && !bankId) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Please select Bank!',
                        confirmButtonText: 'OK',
                        confirmButtonColor: '#2b6ac9'
                    });
                    return;
                }

                Swal.fire({
                    title: 'Confirm Save?',
                    text: 'Do you want to save this Payment Mode?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Save',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#dc3545',
                    reverseButtons: true,
                    focusConfirm: true,
                    buttonsStyling: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "/PaymentMode/CheckDuplicate",
                            type: "GET",
                            data: { name: name, id: id },
                            success: function (response) {
                                if (response.exists) {
                                    Swal.fire({
                                        icon: 'warning',
                                        title: 'Warning',
                                        text: 'Mode Of Payment already exists!',
                                        confirmButtonText: 'OK',
                                        confirmButtonColor: '#2b6ac9'
                                    });
                                } else {
                                    isSubmitting = true;
                                    form.submit();
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: 'Error checking duplicate!',
                                    confirmButtonText: 'OK',
                                    confirmButtonColor: '#2b6ac9'
                                });
                            }
                        });
                    }
                });
            });
        });
    </script>
}

@if (TempData["success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: '@TempData["success"]',
            confirmButtonText: 'OK',
            confirmButtonColor: '#2b6ac9'
        });
    </script>
}