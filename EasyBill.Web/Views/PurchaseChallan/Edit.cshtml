@model EasyBill.Models.ViewModels.PurchaseVM
@{
    ViewData["Title"] = "Edit Purchase Challan";
    var entryTitle = "Edit Purchase Challan";
    var entryController = "PurchaseChallan";
    var entryListAction = "Index";
    var entrySaveButtonText = "End | Update Challan";
    var entrySaveLoaderText = "Updating purchase challan...";
    var billNoLabel = "Challan No";
    var billDateLabel = "Challan Date";
    var supplierLabel = "Supplier";
    var partyBillNoLabel = "Supplier Bill No";
    var partyBillDateLabel = "Supplier Bill Date";
    var showPaymentDetails = false;
    var showPaymentTypeToggle = false;
    var isPurchaseChallanEntry = true;
}

<style>
    /* ===============================
                   BATCH MODAL STYLING
                   =============================== */
    .batch-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    #batchModal.keyboard-nav .batch-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #batchModal.mouse-nav .batch-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    #batchModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #batchModal .modal-header .btn-close {
            filter: invert(1);
        }

    .batch-table-wrapper {
        max-height: 350px;
        overflow-y: auto;
        position: relative;
    }

    #batchTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7;
        color: #fff;
        font-weight: 700;
        z-index: 2;
    }
</style>

<style>
    /* ===============================
                   ITEM MODAL STYLING
                   =============================== */
    .item-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    #itemModal.keyboard-nav .item-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #itemModal.mouse-nav .item-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .item-row:focus {
        outline: none;
    }

    .item-row {
        scroll-margin-top: 50px;
    }

    #itemModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #itemModal .modal-header .btn-close {
            filter: invert(1);
        }

    #itemTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    }
</style>

<style>
    /* ===============================
                   ITEM DETAILS MODAL
                   =============================== */
    #itemDetailModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #itemDetailModal .modal-header .btn-close {
            filter: invert(1);
        }
</style>

<style>
    /* ===============================
                   SUPPLIER MODAL STYLING
                   =============================== */
    #supplierModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #supplierModal .modal-header .btn-close {
            filter: invert(1);
        }

    #supplierTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .supplier-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    #supplierModal.keyboard-nav .supplier-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #supplierModal.mouse-nav .supplier-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .supplier-row {
        scroll-margin-top: 50px;
    }

        .supplier-row:focus {
            outline: none;
        }
</style>

<style>
    /* ===============================
                   ADD SUPPLIER MODAL
                   =============================== */
    #addSupplierModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }
</style>

<style>
    /* ====================================
                   PURCHASE HISTORY TABLE STYLING
                   ==================================== */
    #itemExtraInfoWrapper {
        background: linear-gradient(to bottom, #f8fbff, #ffffff);
        border: 1.5px solid #b3d9ff !important;
        box-shadow: 0 1px 4px rgba(0, 123, 255, 0.08);
        max-height: 250px; /* ✅ Height limit */
        overflow-y: auto; /* ✅ Scroll if needed */
    }

    .purchase-history-table {
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        border-radius: 6px;
        font-size: 11px; /* ✅ Small text */
    }

        .purchase-history-table thead tr {
            background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
            color: #ffffff;
            font-weight: 600;
            font-size: 10px; /* ✅ Compact header */
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .purchase-history-table thead th {
            border: none !important;
            padding: 6px 5px; /* ✅ Reduced from 12px */
            vertical-align: middle;
            white-space: nowrap;
            position: sticky; /* ✅ Sticky header */
            top: 0;
            z-index: 10;
        }

            .purchase-history-table thead th:first-child {
                border-top-left-radius: 6px;
            }

            .purchase-history-table thead th:last-child {
                border-top-right-radius: 6px;
            }

        .purchase-history-table tbody tr {
            border-bottom: 1px solid #d6ebff;
            transition: all 0.15s ease;
        }

            .purchase-history-table tbody tr:hover {
                background-color: #e3f2fd;
                transform: scale(1.005); /* ✅ Subtle hover */
            }

        .purchase-history-table tbody td {
            padding: 5px 5px; /* ✅ Reduced from 10px */
            font-size: 11px;
            border-left: 1px solid #d6ebff;
            border-right: 1px solid #d6ebff;
            vertical-align: middle;
            line-height: 1.3; /* ✅ Compact line height */
        }

            .purchase-history-table tbody td:first-child {
                border-left: none;
            }

            .purchase-history-table tbody td:last-child {
                border-right: none;
            }

        .purchase-history-table tbody tr:last-child td {
            border-bottom: none;
        }

        /* Alternating row colors */
        .purchase-history-table tbody tr:nth-child(even) {
            background-color: #f5f9ff;
        }

        .purchase-history-table tbody tr:nth-child(odd) {
            background-color: #ffffff;
        }

    /* Responsive scrolling */
    .table-responsive {
        border-radius: 6px;
        overflow-x: auto;
    }

    /* Custom scrollbar */
    #itemExtraInfoWrapper::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    #itemExtraInfoWrapper::-webkit-scrollbar-track {
        background: #f0f7ff;
        border-radius: 3px;
    }

    #itemExtraInfoWrapper::-webkit-scrollbar-thumb {
        background: #b3d9ff;
        border-radius: 3px;
    }

        #itemExtraInfoWrapper::-webkit-scrollbar-thumb:hover {
            background: #4a90e2;
        }

    /* Empty state */
    #itemExtraInfoBody:empty::after {
        content: "No purchase history available";
        display: block;
        text-align: center;
        padding: 20px;
        color: #6c757d;
        font-style: italic;
        font-size: 11px;
    }
</style>

<style>
    #refreshBtn:hover {
        opacity: 0.85;
        transform: rotate(90deg);
        transition: all 0.2s ease;
    }
</style>

<style>
    .custom-header th {
        background: linear-gradient(180deg, #eef3f8, #d8e3ef);
        color: #16202b;
        font-weight: 700;
        text-align: center;
        border-bottom: 0px solid #b6c6d6;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,0.05);
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">

        <div class="card mb-2 shadow-sm" style="border-radius: 6px; overflow: hidden;">
            <div class="card-header text-white d-flex align-items-center py-1 px-3"
                 style="background:#2b6ac9">

                <h6 class="mb-0 me-auto" style="font-size: 0.85rem;">
                    @entryTitle
                </h6>

                <button type="button"
                        id="refreshBtn"
                        class="btn btn-sm p-1 me-2 border-0 bg-transparent text-white"
                        title="Refresh">
                    <span class="fs-5">🔄</span>
                </button>
            </div>
        </div>

        <div class="card-body">
            <form asp-action="Edit" id="purchaseForm">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <!-- Bill No -->
                    <div class="col-md-4 d-flex align-items-center mb-1">
                        <div class="col-md-5">
                            <label>@billNoLabel</label>
                        </div>
                        <div class="col-md-5">
                            <input asp-for="BillNo" id="BillNo" class="form-control form-control-sm" readonly />
                            <span asp-validation-for="BillNo" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Bill Date -->
                    <div class="col-md-4 d-flex align-items-center mb-1">
                        <div class="col-md-5">
                            <label>@billDateLabel</label>
                        </div>
                        <div class="col-md-5">
                            <input type="date" asp-for="BillDate" class="form-control form-control-sm" />
                            <span asp-validation-for="BillDate" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious">
                        <div class="col-md-5 ">
                            <label>Billing Type</label>
                        </div>
                        <div class="col-md-5 ">
                            <select asp-for="billingType" id="billingType" class="form-control form-control-sm">
                                <option value="walkin">Cash</option>
                                <option value="registered">Supplier</option>
                            </select>
                        </div>
                    </div>

                    <!-- ✅ SUPPLIER - TEXT INPUT + MODAL -->
                    <div class="col-md-4 d-flex align-items-center mb-1">
                        <div class="col-md-5">
                            <label>@supplierLabel</label>
                        </div>
                        <div class="col-md-4">
                            <input type="hidden" asp-for="SupplierId" class="supplier-id" />
                            <input type="text" class="form-control form-control-sm supplier-input" id="supplier-input" placeholder="Press Enter to select supplier" autocomplete="off"  value="@Model.SupplierName" />
                            <span asp-validation-for="SupplierId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-1">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-bs-toggle="modal" data-bs-target="#addSupplierModal">
                                new
                            </button>
                        </div>
                    </div>

                    <!-- Party Bill No -->
                    <div class="col-md-4 d-flex align-items-center mb-1">
                        <div class="col-md-5">
                            <label>@partyBillNoLabel</label>
                        </div>
                        <div class="col-md-5">
                            <input asp-for="PartyBillNo" class="form-control form-control-sm" />
                            <span asp-validation-for="PartyBillNo" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Party Bill Date -->
                    <div class="col-md-4 d-flex align-items-center mb-1">
                        <div class="col-md-5">
                            <label>@partyBillDateLabel</label>
                        </div>
                        <div class="col-md-5">
                            <input type="date" asp-for="PartyBillDate" class="form-control form-control-sm" />
                            <span asp-validation-for="PartyBillDate" class="text-danger small"></span>
                        </div>
                    </div>
                    @if (showPaymentTypeToggle)
                    {
                        <div class="col-md-4 d-flex align-items-center mb-1 border-radious ">
                            <div class="col-md-5 ">
                                <label>Type</label>
                            </div>
                            <div class="col-md-5">
                                <div class="form-check form-switch">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="paymentToggle">
                                    <label class="form-check-label fw-bold" id="paymentToggleLabel" style="color: green;">
                                        Cash
                                    </label>
                                </div>

                                <input type="hidden" asp-for="PaymentType" id="paymentTypeHidden" value="cash" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="PaymentType" id="paymentTypeHidden" value="cash" />
                    }
                    <div class="col-md-4 d-flex align-items-center mb-1 border-radious">
                        <div class="col-md-5 ">
                            <label>Purchase Type</label>
                        </div>
                        <div class="col-md-5 ">
                            <select asp-for="PurchaseType" id="purchasetype" class="form-control form-control-sm" disabled>
                                <option value="Local">Local</option>
                                <option value="Central">Central</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div style="overflow-x: auto; width: 100%;">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead class="table custom-header">
                                <tr>
                                    <th style="min-width:30%">Item</th>
                                    <th style="min-width:30%">Batch</th>
                                    <th hidden class="text-center">Expiry</th>
                                    <th hidden class="text-center">Mrp</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-center">Free</th>
                                    <th class="text-center">Rate</th>
                                    <th hidden class="text-center">RateA</th>
                                    <th hidden class="text-center">RateB</th>
                                    <th class="text-center">Disc %</th>
                                    <th class="text-center gst-col">Gst %</th>
                                    <th hidden class="text-center">Gst Amt</th>
                                    <th hidden class="text-center">CGst %</th>
                                    <th hidden class="text-center">CGst Amt</th>
                                    <th hidden class="text-center">SGst %</th>
                                    <th hidden class="text-center">SGst Amt</th>
                                    <th class="text-center scgst-col">Gst %</th>
                                    <th class="text-center">Amount</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="PurchaseItemBody">
                                @for (int i = 0; i < Model.PurchaseItemVms.Count; i++)
                                {
                                    var item = Model.PurchaseItemVms[i];

                                    <tr data-itemdetail-valid="true">
                                        <!-- ✅ ITEM - TEXT INPUT + HIDDEN ID -->
                                        <td style="min-width:250px;">
                                            <input type="hidden" name="PurchaseItemVms[@i].ItemId" class="item-id" value="@item.ItemId" />
                                            <input type="text"
                                                   name="PurchaseItemVms[@i].ItemName"
                                                   class="form-control form-control-sm item-input"
                                                   placeholder="Press Enter to select item"
                                                   value="@item.ItemName" />  <!-- ✅ Seedha use karo -->
                                        </td>

                                        <td><input name="PurchaseItemVms[@i].Batch" value="@item.Batch" class="form-control form-control-sm batch" /></td>
                                        <td hidden><input name="PurchaseItemVms[@i].ExpiryDate" value="@item.ExpiryDate?.ToString("MM/yyyy")" class="form-control form-control-sm expirydate" placeholder="MM/YYYY" maxlength="7" /></td>
                                        <td hidden><input name="PurchaseItemVms[@i].Mrp" value="@item.Mrp" class="form-control form-control-sm mrp" /></td>
                                        <td><input name="PurchaseItemVms[@i].Qty" value="@item.Qty" class="form-control form-control-sm qty" /></td>
                                        <td><input name="PurchaseItemVms[@i].FreeQty" value="@item.FreeQty" class="form-control form-control-sm freeqty" /></td>
                                        <td><input name="PurchaseItemVms[@i].Rate" value="@item.Rate" class="form-control form-control-sm rate" /></td>
                                        <td hidden><input name="PurchaseItemVms[@i].salserateA" value="@item.salserateA" class="form-control form-control-sm salserateA" /></td>
                                        <td hidden><input name="PurchaseItemVms[@i].salserateB" value="@item.salserateB" class="form-control form-control-sm salserateB" /></td>
                                        <td hidden>
                                            <select name="PurchaseItemVms[@i].HsnId" class="form-control form-control-sm hsn-dropdown">
                                                <option value="">-- Select HSN --</option>
                                                @foreach (var hsn in ViewBag.Hsn)
                                                {
                                                    <option value="@hsn.Value" selected="@(hsn.Value == item.HsnId.ToString())">@hsn.Text</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input name="PurchaseItemVms[@i].Discount" value="@item.Discount" class="form-control form-control-sm discount" min="0" max="100" step="0.01" /></td>
                                        <td hidden><input name="PurchaseItemVms[@i].DiscountAmt" value="@item.DiscountAmt" class="form-control form-control-sm discount-amt" readonly /></td>
                                        <td class="gst-col"><input name="PurchaseItemVms[@i].Gst" value="@item.Gst" class="form-control form-control-sm gst" readonly /></td>
                                        <td hidden><input name="PurchaseItemVms[@i].GstAmount" value="@item.GstAmount" class="form-control form-control-sm gstamt" readonly /></td>
                                        <td hidden><input name="PurchaseItemVms[@i].CGst" value="@item.CGst" class="form-control form-control-sm cgst" readonly /></td>
                                        <td hidden><input name="PurchaseItemVms[@i].CGstAmount" value="@item.CGstAmount" class="form-control form-control-sm cgstamt" readonly /></td>
                                        <td hidden><input name="PurchaseItemVms[@i].SGst" value="@item.SGst" class="form-control form-control-sm sgst" readonly /></td>
                                        <td hidden><input name="PurchaseItemVms[@i].SGstAmount" value="@item.SGstAmount" class="form-control form-control-sm sgstamt" readonly /></td>
                                        <td class="scgst-col"><input name="PurchaseItemVms[@i].SCGst" value="@item.SCGst" class="form-control form-control-sm scgst" /></td>
                                        <td><input name="PurchaseItemVms[@i].TotalAmt" value="@item.TotalAmt" class="form-control form-control-sm total" readonly /></td>
                                        <td hidden><input name="PurchaseItemVms[@i].BatchWiseCose" value="@item.BatchWiseCose" class="form-control form-control-sm batch-wise" readonly /></td>

                                        <td hidden><input name="PurchaseItemVms[@i].Barcode" value="@item.Barcode" class="form-control form-control-sm barcode" readonly /></td>
                                        <td><u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="float-start">
                                        <u id="addRow" style="color:green; cursor:pointer;">Add Row</u>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ✅ ITEM PURCHASE HISTORY + TOTALS SECTION -->
                        <div class="row mt-3"> 
                            <div class="col-md-9">
                                @if (showPaymentDetails)
                                {
                                    <strong>Payment Details</strong>
                                    <table class="table table-bordered table-striped">
                                        <thead class="table custom-header">
                                            <tr>
                                                <th style="min-width:30%">Payment Mode</th>
                                                <th class="text-center">Amount</th>
                                                <th class="text-center">Reference NO</th>
                                                <th class="text-center">Description</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody id="PaymentDetailsBody">
                                            @for (int i = 0; i < Model.PaymentDetails?.Count; i++)
                                            {
                                                <tr>
                                                    <td hidden><input type="hidden" asp-for="@Model.PaymentDetails[@i].Id" /></td>
                                                    <td style="min-width:185px;">
                                                        <select asp-for="PaymentDetails[@i].PaymentModeId" asp-items="@ViewBag.PaymentMode" class="form-control form-control-sm paymentMode-dropdown" required>
                                                            <option value="">Select</option>
                                                        </select>
                                                    </td>
                                                    <td><input name="PaymentDetails[@i].Amount" class="form-control form-control-sm paymentAmount" value="@Model.PaymentDetails[i].Amount" /></td>
                                                    <td><input name="PaymentDetails[@i].ReferenceNo" class="form-control form-control-sm paymentReferenceNO" value="@Model.PaymentDetails[i].ReferenceNo" /></td>
                                                    <td><input name="PaymentDetails[@i].Description" class="form-control form-control-sm paymentDescription" value="@Model.PaymentDetails[i].Description" /></td>
                                                    <td><u class="remove-paymentrow-btn text-danger" style="cursor:pointer;">Remove</u></td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <th class="float-start">
                                                    <u id="addPaymentRow" style="color:green; text-align:right; cursor:pointer;">Add Row</u>
                                                </th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                }

                                <div id="itemExtraInfoWrapper" class="border rounded p-3 h-90" style="display:none;">
                                    <div class="table-responsive">
                                        <table class="table table-sm mb-0 text-center purchase-history-table">
                                            <thead>
                                                <tr>
                                                    <th>Supplier</th>
                                                    <th>Bill No</th>
                                                    <th>Bill Date</th>
                                                    <th>Qty</th>
                                                    <th>Batch</th>
                                                    <th>MRP</th>
                                                    <th>Rate</th>
                                                    <th>Expiry</th>
                                                   @*  <th>Total Discount</th> *@
                                                    <th>Cost</th>
                                                </tr>
                                            </thead>
                                            <tbody id="itemExtraInfoBody"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- RIGHT: TOTALS (COMPACT) -->
                            <div class="col-md-3">
                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Total</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="Total" class="form-control form-control-sm total-input text-end" readonly />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Bill Discount</label>
                                    <div class="col-md-3 text-end">
                                        <input asp-for="discountPercent" id="discountPercent" class="form-control form-control-sm discount-input text-end" 
                                               min="0"
                                               max="100"
                                               step="0.01" />
                                    </div>
                                    <div class="col-md-3 text-end">
                                        <input asp-for="discountAmount" id="discountamount" class="form-control form-control-sm total-input text-end" />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center">
                                    <label class="col-md-6 col-form-label small">Total Discount</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="Totaldiscount" class="form-control form-control-sm total-input text-end" readonly />
                                    </div>
                                </div>

                                <div class="row mb-2 align-items-center  gst-row">
                                    <label class="col-md-6 col-form-label small">Gst</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalGstAmt" class="form-control form-control-sm total-input text-end" readonly />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center sgst-row">
                                    <label class="col-md-6 col-form-label small">SGst</label>
                                    <div class="col-md-6 text-end">
                                        <input asp-for="TotalSGstAmt" class="form-control form-control-sm text-end"
                                               readonly />
                                    </div>
                                </div>
                                <div class="row mb-2 align-items-center cgst-row">
                                    <label class="col-md-6 col-form-label small">CGst</label>
                                    <div class="col-md-6 text-end">
