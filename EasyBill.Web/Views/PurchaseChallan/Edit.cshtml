    <script>
        function parseExpiryInput(rawValue) {
            const value = (rawValue || "").trim();

            if (!value) {
                return { isValid: false, message: "Expiry Date is required" };
            }

            const cleanedValue = value.replace(/\./g, "/").replace(/-/g, "/").replace(/\s+/g, "");
            const parts = cleanedValue.split("/");
            const pad = (number) => String(number).padStart(2, "0");

            const buildDate = (year, month, day) => {
                const date = new Date(year, month - 1, day);
                if (
                    date.getFullYear() !== year ||
                    date.getMonth() !== month - 1 ||
                    date.getDate() !== day
                ) {
                    return null;
                }

                return date;
            };

            const buildMonthYearResult = (monthValue, yearValue) => {
                if (monthValue < 1 || monthValue > 12) {
                    return { isValid: false, message: "Month should be between 01 and 12" };
                }

                if (yearValue < 2000 || yearValue > 2100) {
                    return { isValid: false, message: "Year should be between 2000 and 2100" };
                }

                return {
                    isValid: true,
                    normalizedValue: `${pad(monthValue)}/${yearValue}`,
                    effectiveDate: new Date(yearValue, monthValue, 0)
                };
            };

            if (parts.length === 2) {
                const monthValue = parseInt(parts[0], 10);
                let yearValue = parseInt(parts[1], 10);

                if (Number.isNaN(monthValue) || Number.isNaN(yearValue)) {
                    return { isValid: false, message: "Enter a valid expiry date" };
                }

                if (parts[1].length === 2) {
                    yearValue += 2000;
                }

                if (parts[1].length !== 2 && parts[1].length !== 4) {
                    return { isValid: false, message: "Use MM/YYYY, MM/YY, DD/MM/YYYY or YYYY-MM-DD" };
                }

                return buildMonthYearResult(monthValue, yearValue);
            }

            if (parts.length === 3) {
                let dayValue;
                let monthValue;
                let yearValue;

                if (parts[0].length === 4) {
                    yearValue = parseInt(parts[0], 10);
                    monthValue = parseInt(parts[1], 10);
                    dayValue = parseInt(parts[2], 10);
                } else {
                    dayValue = parseInt(parts[0], 10);
                    monthValue = parseInt(parts[1], 10);
                    yearValue = parseInt(parts[2], 10);

                    if (parts[2].length === 2) {
                        yearValue += 2000;
                    }
                }

                if (
                    Number.isNaN(dayValue) ||
                    Number.isNaN(monthValue) ||
                    Number.isNaN(yearValue)
                ) {
                    return { isValid: false, message: "Enter a valid expiry date" };
                }

                if (monthValue < 1 || monthValue > 12) {
                    return { isValid: false, message: "Month should be between 01 and 12" };
                }

                if (yearValue < 2000 || yearValue > 2100) {
                    return { isValid: false, message: "Year should be between 2000 and 2100" };
                }

                const exactDate = buildDate(yearValue, monthValue, dayValue);
                if (!exactDate) {
                    return { isValid: false, message: "Enter a valid calendar date" };
                }

                return {
                    isValid: true,
                    normalizedValue: `${pad(monthValue)}/${yearValue}`,
                    effectiveDate: exactDate
                };
            }

            return { isValid: false, message: "Use MM/YYYY, MM/YY, DD/MM/YYYY or YYYY-MM-DD" };
        }

        function validateExpiry(showError = true) {
            const errorSpan = $("[data-field='popupExpiry']");
            errorSpan.text("");

            const parsedExpiry = parseExpiryInput($("#popupExpiry").val());
            if (!parsedExpiry.isValid) {
                if (showError) {
                    errorSpan.text(parsedExpiry.message);
                }
                return false;
            }

            $("#popupExpiry").val(parsedExpiry.normalizedValue);

            const currentDate = new Date();
            currentDate.setHours(0, 0, 0, 0);

            if (parsedExpiry.effectiveDate < currentDate) {
                if (showError) errorSpan.text("Expiry date cannot be in the past");
                return false;
            }

            if (minPurchaseExpiryDays > 0) {
                const minExpiryDate = new Date();
                minExpiryDate.setDate(minExpiryDate.getDate() + minPurchaseExpiryDays);
                minExpiryDate.setHours(0, 0, 0, 0);

                if (parsedExpiry.effectiveDate < minExpiryDate) {
                    if (showError) {
                        errorSpan.text(`Expiry must be at least ${minPurchaseExpiryDays} days from today`);
                    }
                    return false;
                }
            }

            return true;
        }
    </script>
