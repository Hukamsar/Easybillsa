        function processItemSelection(itemId, row) {
            currentRow = row;

            showLoader("Checking batches...");

            $.get(`/Purchase/GetBatchesByItemId?id=${itemId}`, function (response) {
                hideLoader();

                if (response.groupedResult && response.groupedResult.length > 0) {
                    // ✅ GET EXISTING VALUES FROM ROW (all identifying fields)
                    const existingBatch = row.find(".batch").val()?.trim().toLowerCase() || "";
                    const existingExpiry = row.find(".expirydate").val()?.trim() || "";
                    const existingMrp = parseFloat(row.find(".mrp").val()) || 0;
                    const existingRate = parseFloat(row.find(".rate").val()) || 0;

                    let batchRows = '';
                    response.groupedResult.forEach(batch => {
                        const d = new Date(batch.expiry);
                        const formattedExpiry = ("0" + (d.getMonth() + 1)).slice(-2) + "/" + d.getFullYear();
                        const encoded = encodeURIComponent(JSON.stringify(batch));

                        batchRows += `
                            <tr class="batch-row" data-batch="${encoded}">
                                <td>${batch.batch}</td>
                                <td>${formattedExpiry}</td>
                                <td>${batch.rate}</td>
                                <td>${batch.mrp}</td>
                                <td>${batch.qty}</td>
                                <td hidden>${batch.salserateA}</td>
                                <td hidden>${batch.salserateB}</td>
                                <td>${batch.barcode}</td>
                            </tr>`;
                    });

                    $("#batchTableBody").html(batchRows);

                    // FIND EXACT MATCH (Batch + Expiry + MRP + Rate)
                    currentBatchIndex = -1;

                    if (existingBatch) {
                        currentBatchIndex = response.groupedResult.findIndex(b => {
                            // Match batch name
                            const batchMatch = b.batch.toLowerCase() === existingBatch;

                            // Match expiry (MM/YYYY format)
                            let expiryMatch = true;
                            if (existingExpiry && b.expiry) {
                                const batchDate = new Date(b.expiry);
                                const batchExpiry = ("0" + (batchDate.getMonth() + 1)).slice(-2) + "/" + batchDate.getFullYear();
                                expiryMatch = batchExpiry === existingExpiry;
                            }

                            // Match MRP (with tolerance for decimal precision)
                            const mrpMatch = Math.abs((b.mrp || 0) - existingMrp) < 0.01;

                            // ✅ Match Rate (with tolerance for decimal precision)
                            const rateMatch = Math.abs((b.rate || 0) - existingRate) < 0.01;

                            // ALL must match
                            return batchMatch && expiryMatch && mrpMatch && rateMatch;
                        });
                    }

                    // If no exact match found, default to first (0)
                    if (currentBatchIndex === -1) {
                        currentBatchIndex = 0;
                    }

                    $("#batchModal").modal("show");
                } else {
                    focusBatchAfterItemSelect = true;
                }

            }).fail(function() {
                hideLoader();
                toastr.error("Error loading batches");
                setTimeout(() => row.find(".batch").focus().select(), 150);
            });
        }
    </script>

    <!-- ================================================================
         🔹 BATCH MODAL NAVIGATION
         ================================================================ -->
    <script>
        $('#batchModal').on('shown.bs.modal', function () {
            batchNavMode = "keyboard";
            isKeyboardScrollingBatchModal = false;

            $("#batchModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".batch-row:visible");

            if (currentBatchIndex >= 0 && currentBatchIndex < $rows.length) {
                highlightBatchRow($rows, currentBatchIndex);
            } else {
                currentBatchIndex = 0;
                if ($rows.length) {
                    highlightBatchRow($rows, currentBatchIndex);
                }
            }
        });

        function highlightBatchRow($rows, index) {
            $rows.removeClass("selected");

            const $row = $rows.eq(index);
            if (!$row.length) return;

            $row.addClass("selected");

            const container = document.querySelector("#batchModal .batch-table-wrapper");
            if (!container) return;

            const rowRect = $row[0].getBoundingClientRect();
            const containerRect = container.getBoundingClientRect();
            const headerHeight = document.querySelector("#batchTable thead")?.offsetHeight || 50;

            if (rowRect.top < containerRect.top + headerHeight) {
                container.scrollTop -= (containerRect.top + headerHeight - rowRect.top);
            }
            else if (rowRect.bottom > containerRect.bottom) {
                container.scrollTop += (rowRect.bottom - containerRect.bottom);
            }
        }

        $(document).on("click", ".batch-row", function () {
            $(".batch-row").removeClass("selected");
            $(this).addClass("selected");

            const encoded = $(this).attr("data-batch");
            try {
                const batch = JSON.parse(decodeURIComponent(encoded));
                if (currentRow) {
                    let formatted = "";

                    // GET CURRENT ROW VALUES FIRST (ye line missing thi)
                    const currentBatchValue = currentRow.find(".batch").val().trim();
                    const currentQtyValue = currentRow.find(".qty").val();

                    currentRow.find(".batch").val(batch.batch);
                    currentRow.find(".rate").val(batch.rate || 0);
                    currentRow.find(".mrp").val(batch.mrp || 0);

                    // QTY LOGIC FOR EDIT PAGE
                    // If same batch as before → keep existing qty
                    // If different batch → set 1 (if stock available)
                    if (currentBatchValue.toLowerCase() === batch.batch.toLowerCase()) {
                        // Same batch → retain current qty
                        currentRow.find(".qty").val(currentQtyValue);
                    } else {
                        // Different batch → set 1 if stock available
                        if (batch.qty && parseFloat(batch.qty) > 0) {
                            currentRow.find(".qty").val(1);
                        } else {
                            currentRow.find(".qty").val(0);
                        }
                    }

                    //currentRow.find(".qty").val(batch.qty || 0);

                    currentRow.find(".salserateA").val(batch.salserateA || 0);
                    currentRow.find(".salserateB").val(batch.salserateB || 0);
                    currentRow.find(".barcode").val(batch.barcode);

                    if (batch.expiry) {
                        let date = new Date(batch.expiry);
                        formatted = ("0" + (date.getMonth() + 1)).slice(-2) + "/" + date.getFullYear();
                        currentRow.find(".expirydate").val(formatted);
                    }

                    if (formatted) {
                        $("#popupExpiry").val(formatted);
                    }

                    if (batch.mrp !== undefined && batch.mrp !== null) {
                        $("#popupMrp").val(batch.mrp);
                    }

                    if (batch.salserateA !== undefined && batch.salserateA !== null) {
                        $("#popupSalseRateA").val(batch.salserateA);
                    }

                    if (batch.salserateB !== undefined && batch.salserateB !== null) {
                        $("#popupSalseRateB").val(batch.salserateB);
                    }

                    if (batch.barcode) {
                        $("#popupBarcode").val(batch.barcode);
                    }

                    currentRow.attr("data-itemdetail-valid", "true");
                    calculateRow(currentRow);
                }
                $("#batchModal").modal("hide");

                popupOpen = true;
                selectedRow = currentRow;

                setTimeout(() => {
                    $("#itemDetailModal").modal("show");
                }, 150);

            } catch (err) {
                alert("Invalid batch data.");
                console.error(err);
            }
        });

        $(document).on("mousemove", "#batchModal", function (e) {
            if (e.originalEvent && e.originalEvent.movementX !== undefined) {
                const movement = Math.abs(e.originalEvent.movementX) + Math.abs(e.originalEvent.movementY);
                if (movement > 3) {
                    isKeyboardScrollingBatchModal = false;
                    batchNavMode = "mouse";
                }
            } else {
                isKeyboardScrollingBatchModal = false;
            }
        });

        $(document).on("keydown", function (e) {
            if (!$("#batchModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                batchNavMode = "keyboard";
                isKeyboardScrollingBatchModal = true;

                $("#batchModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");

                setTimeout(() => {
                    isKeyboardScrollingBatchModal = false;
                }, 300);
            }

            const $rows = $(".batch-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentBatchIndex === -1) {
                    currentBatchIndex = 0;
                } else if (currentBatchIndex < $rows.length - 1) {
                    currentBatchIndex++;
                }

                highlightBatchRow($rows, currentBatchIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();
                if (currentBatchIndex <= 0) return;

                currentBatchIndex--;
                highlightBatchRow($rows, currentBatchIndex);
            }
            else if (e.key === "Enter" && currentBatchIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentBatchIndex).trigger("click");
            }
        });

        $(document).on("mouseenter", ".batch-row", function () {
            if (!$("#batchModal").is(":visible")) return;

