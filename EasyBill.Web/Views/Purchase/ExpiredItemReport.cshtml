@using EasyBill.Models.ViewModels
@model List<NearExpiryVM>

@{
    ViewData["Title"] = "Expired Report";
}

<!-- Header -->
<div class="row mb-3">
    <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
        Expired Report
    </div>
</div>

<!-- Filter Section -->
<div class="card shadow-sm p-3 mb-4">
    <form method="get" asp-action="ExpiredItemReport">
        <div class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="form-label fw-bold">From Date</label>
                <input type="text"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="form-control form-control-sm datepicker"
                       placeholder="dd-MM-yyyy" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">To Date</label>
                <input type="text"
                       name="toDate"
                       value="@ViewBag.ToDate"
                       class="form-control form-control-sm datepicker"
                       placeholder="dd-MM-yyyy" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm w-100 text-white"
                        style="background-color: #2b6ac9 !important;">
                    Apply Filter
                </button>
            </div>

        </div>
    </form>
</div>
<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="ExpiredItemReportExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>
        <a asp-action="ExpiredItemReportPdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>
<!-- Data Table -->
<div class="card shadow-sm p-3">
    <div class="table-responsive">
        <table id="expiredTable" class="table table-bordered table-striped table-sm">
            <thead>
                <tr>
                    <th>S.No</th>
                    <th>Item Name</th>
                    <th>Category</th>
                    <th>Batch No</th>
                    <th>Expiry Date</th>
                    <th>Days Left</th>
                    <th>Stock</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int sno = 1;
                }

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="@(item.DaysToExpire <= 0 ? "table-danger" : "")">
                            <td>@sno</td>
                            <td>@item.ItemName</td>
                            <td>@item.CategoryName</td>
                            <td>@item.BatchNo</td>
                            <td>@item.ExpiryDate?.ToString("dd-MM-yyyy")</td>
                            <td>@item.DaysToExpire</td>
                            <td>@item.Stocks</td>
                        </tr>
                        sno++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>


    <script>
        $(document).ready(function () {
            // Initialize DataTable
            $("#expiredTable").DataTable({
                            ordering: false
            });

            // Initialize Datepicker
            $(".datepicker").datepicker({
                dateFormat: "dd-mm-yy",
                changeMonth: true,
                changeYear: true
            });
        });
    </script>


<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

        Remove sorting arrows
        table.dataTable thead th.sorting,
        table.dataTable thead th.sorting_asc,
        table.dataTable thead th.sorting_desc {
            background-image: none !important;
            cursor: default !important;
        }
</style>
