@using EasyBill.Models.ViewModels
@model List<StockVM>

@{
    ViewData["Title"] = "Current Stock Report";
    var totalStock = Model != null && Model.Any()
        ? Model.Sum(x => x.Stocks)
        : 0;
}

<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2 d-flex align-items-center"
         style="background-color: #2b6ac9 !important;">

        <!-- Left Side Title -->
        <span class="fw-bold">
            Current Stock Report
        </span>

        <!-- Right Side Total -->
        <span class="ms-auto">
            Total Stock :
            <span class="fw-bold">@totalStock</span>
        </span>

    </div>
</div>

<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="CurrentStockExcel">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>
        <a asp-action="CurrentStockPdf">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>
<table id="currentStockTable"
       class="table table-bordered table-striped table-sm">
    <thead>
        <tr>
            <th>Item Name</th>
            <th>Category</th>
            <th>Unit</th>
            <th>Stock</th>
            <th style="width: 220px;">Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr class="stock-row"
                    data-register-url="@Url.Action("CurrentStockRegister", "Purchase", new { itemId = item.ItemMasterId })">
                    <td>
                        <a asp-action="CurrentStockRegister"
                           asp-controller="Purchase"
                           asp-route-itemId="@item.ItemMasterId"
                           class="fw-semibold text-decoration-none">
                            @item.ItemName
                        </a>
                    </td>
                    <td>@item.CategoryName</td>
                    <td>@item.Unit1</td>
                    <td>
                        <span class="fw-bold">
                            @{
                                var isTabletWise = ViewBag.IsTabletWise ?? false;

                                int conversion = item.Conversion;

                                if (isTabletWise && conversion > 0)
                                {
                                    int totalTablets = (int)Math.Round(
                                    item.Stocks * conversion,
                                    MidpointRounding.AwayFromZero
                                    );

                                    int strips = totalTablets / conversion;
                                    int tablets = totalTablets % conversion;

                                    @($"{strips}:{tablets}")
                                }
                                else
                                {
                                    @item.Stocks.ToString("0.##")
                                }
                            }
                        </span>
                    </td>
                    <td class="text-nowrap">
                        <!-- Keep both shortcuts visible so the user can directly open register or batch drill-down. -->
                        <a asp-action="CurrentStockRegister"
                           asp-controller="Purchase"
                           asp-route-itemId="@item.ItemMasterId"
                           class="btn btn-sm text-white me-1"
                           style="background:#2b6ac9;">
                            Register
                        </a>
                        <a asp-action="CurrentStockBatchDetails"
                           asp-controller="Purchase"
                           asp-route-itemId="@item.ItemMasterId"
                           class="btn btn-sm btn-outline-primary">
                            Batch Details
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {

        $("#currentStockTable").DataTable({
            ordering: false,
            pageLength: 25
        });

        // Row click keeps the old table simple while opening the new item register quickly.
        $("#currentStockTable tbody").on("click", "tr.stock-row", function (e) {
            if ($(e.target).closest("a, button").length > 0) {
                return;
            }

            var registerUrl = $(this).data("register-url");
            if (registerUrl) {
                window.location.href = registerUrl;
            }
        });

    });
</script>

<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    #currentStockTable tbody tr.stock-row:hover {
        background: #e6f2f2;
        cursor: pointer;
        transition: 0.2s;
    }
</style>
