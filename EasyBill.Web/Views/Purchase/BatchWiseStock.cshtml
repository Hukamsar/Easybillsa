@model IEnumerable<EasyBill.Models.ViewModels.PurchaseItemVM>

@{
    ViewData["Title"] = "Batch Wise Stock Report";
    decimal totalQty = Model?.Sum(x => x.Qty) ?? 0;
}

<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }
</style>

<!-- HEADER CARD -->
<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2 d-flex align-items-center"
         style="background:#2b6ac9">

        <!-- Left Title -->
        <span class="fw-bold">
            Batch Wise Stock Report
        </span>

        <!-- Right Total -->
        <!-- Right Total -->
        <span class="ms-auto">
            @if (!(bool)ViewBag.IsTabletWise)
            {
                <text>Total Qty: <span class="fw-bold">@totalQty</span></text>
            }
        </span>

    </div>
</div>
<div class="card shadow-sm p-3 mb-4">
    <form method="get" asp-action="BatchWiseStock">
        <div class="card shadow-sm p-3 mb-4">
            <form method="get" asp-action="BatchWiseStock">
                <div class="row g-2 align-items-end">

                    <div class="col-md-3">
                        <label class="form-label fw-bold">As on Date</label>
                        <input type="text"
                               name="toDate"
                               value="@(ViewBag.AsOnDate ?? DateTime.Today.ToString("dd-MM-yyyy"))"
                               class="form-control form-control-sm datepicker"
                               placeholder="dd-MM-yyyy" />

                    </div>
                    <!-- Company -->
                    <div class="col-md-2">
                        <label class="fw-bold">Company</label>
                        <select name="companyId" class="form-control form-control-sm">
                            <option value="">All Company</option>
                            @if (ViewBag.companydata != null)
                            {
                                foreach (var c in (IEnumerable<Company>)ViewBag.companydata)
                                {
                                    <option value="@c.Id"
                                            selected="@(ViewBag.SelectedCompanyId != null && ViewBag.SelectedCompanyId == c.Id ? "selected" : null)">
                                        @c.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Supplier -->
                    <div class="col-md-2">
                        <label class="fw-bold">Supplier</label>
                        @Html.DropDownList("supplierId", ViewBag.SupplierList as List<SelectListItem>, "All", new { @class = "form-control form-control-sm" })
                    </div>

                    <!-- Item -->
                    <div class="col-md-2">
                        <label class="fw-bold">Item</label>
                        @Html.DropDownList("itemId", ViewBag.ItemList as List<SelectListItem>, "All", new { @class = "form-control form-control-sm" })
                    </div>

                    <!-- Stock Type -->
                    <div class="col-md-2">
                        <label class="fw-bold">Stock Type</label>
                        <select name="stockType" class="form-control form-control-sm">
                            <option value="Whole" selected="@(ViewBag.StockType == "Whole" ? "selected" : null)">Whole</option>
                            <option value="Available" selected="@(ViewBag.StockType == "Available" ? "selected" : null)">Available</option>
                        </select>
                    </div>

                    <!-- Search Button -->
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-sm w-100 text-white mt-1" style="background:#2b6ac9">Search</button>
                    </div>

                </div>
            </form>
        </div>
    </form>
</div>
<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="BatchWiseStockExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>
        <a asp-action="BatchWiseStockPdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>
<div class="card shadow-sm p-3">
    <div class="table-responsive">
        <table id="batchStockTable" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Sr</th>
                    <th>Item Name</th>
                    <th>Packing</th>
                    <th>Batch</th>
                    <th>Expiry Date</th>
                    <th>MRP</th>
                    <th>Stock</th>
                    <th>Unit</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td></td>
                            <td>@item.ItemName</td>
                            <td>@item.Packing</td>
                            <td>@item.Batch</td>
                            <td>@item.ExpiryDate?.ToString("dd-MM-yyyy")</td>
                            <td>@item.Mrp.ToString("0.00")</td>
                           <!-- <td>@item.Qty</td> -->
                            <td>@item.CurrentQtyDisplay</td>
                            <td>@item.Unit</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var t = $("#batchStockTable").DataTable({
               ordering: false
            });

            t.on('order.dt search.dt', function () {
                t.column(0, { search: 'applied', order: 'applied' }).nodes()
                    .each(function (cell, i) {
                        cell.innerHTML = i + 1;
                    });
            }).draw();
        });
         $(".datepicker").datepicker({
                dateFormat: "dd-mm-yy",
                changeMonth: true,
                changeYear: true
            });
    </script>
}
