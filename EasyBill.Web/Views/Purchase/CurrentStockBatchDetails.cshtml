@model EasyBill.Models.ViewModels.CurrentStockBatchDetailsVM

@{
    ViewData["Title"] = "Current Stock Batch Details";
}

<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2 d-flex align-items-center"
         style="background:#2b6ac9;">
        <span class="fw-bold">
            Batch Details
        </span>
        <span class="ms-auto">
            Item :
            <span class="fw-bold">@Model.ItemName</span>
        </span>
    </div>
</div>

<div class="card shadow-sm p-3 mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="fw-bold">Item Name</label>
            <div>@Model.ItemName</div>
        </div>
        <div class="col-md-3">
            <label class="fw-bold">Unit</label>
            <div>@Model.Unit</div>
        </div>
        <div class="col-md-3">
            <label class="fw-bold">Available Batches</label>
            <div>@(Model.Rows?.Count ?? 0)</div>
        </div>
    </div>
</div>

<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="CurrentStock"
           asp-controller="Purchase"
           class="btn btn-sm btn-outline-secondary me-1">
            Back
        </a>
        <a asp-action="CurrentStockRegister"
           asp-controller="Purchase"
           asp-route-itemId="@Model.ItemId"
           class="btn btn-sm text-white"
           style="background:#2b6ac9;">
            Register
        </a>
    </div>
</div>

<table id="currentStockBatchTable"
       class="table table-bordered table-striped table-sm">
    <thead>
        <tr>
            <th>Batch</th>
            <th class="text-end">Stock</th>
            <th>Unit</th>
            <th class="text-end">RateA</th>
            <th class="text-end">P Rate</th>
            <th class="text-end">MRP</th>
            <th>Exp</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Rows != null && Model.Rows.Any())
        {
            foreach (var row in Model.Rows)
            {
                <tr class="batch-row" data-href="@row.NavigateUrl">
                    <td>@row.Batch</td>
                    <td class="text-end fw-bold">@row.StockDisplay</td>
                    <td>@row.Unit</td>
                    <td class="text-end">@row.SalesRateA.ToString("0.00")</td>
                    <td class="text-end">@row.PurchaseRate.ToString("0.00")</td>
                    <td class="text-end">@row.Mrp.ToString("0.00")</td>
                    <td>@row.ExpiryDate?.ToString("dd-MM-yyyy")</td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        $("#currentStockBatchTable").DataTable({
            ordering: false,
            pageLength: 50
        });

        // Batch row opens the filtered register for that exact available stock layer.
        $("#currentStockBatchTable tbody").on("click", "tr.batch-row", function () {
            var navigateUrl = $(this).data("href");
            if (navigateUrl) {
                window.location.href = navigateUrl;
            }
        });
    });
</script>

<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    #currentStockBatchTable tbody tr.batch-row:hover {
        background: #e6f2f2;
        cursor: pointer;
        transition: 0.2s;
    }
</style>
