@model IEnumerable<EasyBill.Models.ViewModels.PurchaseItemVM>

@{
    ViewData["Title"] = "OverStock Report";
    int sno = 1;
}

<!-- Page Heading -->
<div class="row mb-3">
    <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
        OverStock Report
    </div>
</div>

<!-- Date Filter -->
<div class="card shadow-sm p-3 mb-4">
    <form method="get" asp-action="OverStockReport">
        <div class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="form-label fw-bold">As on Date</label>
                <input type="text"
                       name="toDate"
                       value="@(ViewBag.AsOnDate ?? DateTime.Today.ToString("dd-MM-yyyy"))"
                       class="form-control form-control-sm datepicker"
                       placeholder="dd-MM-yyyy" />

            </div>

            <div class="col-md-2">
                <button type="submit"
                        class="btn btn-sm w-100 text-white"
                        style="background-color: #2b6ac9 !important;">
                    Apply
                </button>
            </div>

        </div>
    </form>
</div>
<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="ExportOverStockReportExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>
        <a asp-action="ExportOverStockReportPdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>
<!-- Data Table -->
<div class="card shadow-sm p-3">
    <div class="table-responsive">
        <table id="itemPurchaseTable" class="table table-bordered table-striped table-sm">
            <thead>
                <tr>
                    <th>S.No</th>
                    <th>Item Name</th>
                    <th>Maximum Qty</th>
                    <th>Available Qty</th>
                    <th>Avg Rate</th>
                    <th>Access Stock</th>

                    <th>Extra Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@sno</td>
                            <td>@item.ItemName</td>
                            <td>@item.MaximumQty</td>
                         @*    <td class="@(item.AvgAmount > 0 ? "text-danger fw-bold" : "text-warning fw-bold")">
                                @item.Qty
                            </td> *@

                            <td class="@(item.AvgAmount > 0 ? "text-danger fw-bold" : "text-warning fw-bold")">
                                @item.CurrentQtyDisplay
                            </td>
                            <td>@item.AvgRate.ToString("0.00")</td>
                           @*  <td>@item.AvgSales.ToString("0.00")</td> *@
                            <td>@item.ExcessQtyDisplay</td>

                            <td class="fw-bold">@item.AvgAmount.ToString("0.00")</td>
                        </tr>
                        sno++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            $("#itemPurchaseTable").DataTable({
                       ordering: false ,

                ordering: false,
                searching: true,
                paging: true,
                info: true,
                autoWidth: false
            });

            $(".datepicker").datepicker({
                dateFormat: "dd-mm-yy",
                changeMonth: true,
                changeYear: true
            });

        });
    </script>
}

<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

</style>
