@model IEnumerable<EasyBill.Models.ViewModels.StockVM>

@{
    ViewData["Title"] = "Minimum Stock Report";
    int sno = 1;
}

<style>
    .custom-orange {
        color: red !important;
        font-weight: bold;
    }

    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

        /* Remove sorting arrows */
        table.dataTable thead th.sorting,
        table.dataTable thead th.sorting_asc,
        table.dataTable thead th.sorting_desc {
            background-image: none !important;
            cursor: default !important;
        }
</style>

<div class="row mb-3">
    <div class="card-header text-white py-2 d-flex align-items-center" style="background-color: #2b6ac9;">
        Minimum Stock Report
        <span class="ms-auto">
            Total Min Qty:
            <span class="fw-bold">@ViewBag.MinQty.ToString("0.00")</span> |

            Total Max Qty:
            <span class="fw-bold">@ViewBag.MaxQty.ToString("0.00")</span> |

            Total Current Stock:
            <span class="fw-bold">@ViewBag.CurrentStock</span>
        </span>
    </div>
</div>

