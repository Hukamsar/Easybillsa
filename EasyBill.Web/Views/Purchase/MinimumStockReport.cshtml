<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="MinimumStockReportExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>
        <a asp-action="MinimumStockReportPdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>

<div class="card shadow-sm p-3">
    <div class="table-responsive">
        <table id="minimumStockTable" class="table table-bordered table-striped table-sm">
            <thead>
                <tr>
                    <th>S.No</th>
                    <th>Item Name</th>
                    <th>Unit</th>
                    <th>Min Qty</th>
                    <th>Max Qty</th>
                    <th>Current Stock</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        string cssClass = "";

                        if (item.Stocks > item.MaxQty && item.MaxQty > 0)
                        {
                            cssClass = "text-danger";
                        }
                        else if (item.Stocks <= item.MinQty && item.MinQty > 0)
                        {
                            cssClass = "custom-orange";
                        }
                        else
                        {
                            cssClass = "text-success";
                        }

                        <tr>
                            <td>@sno</td>
                            <td>@item.ItemName</td>
                            <td >@item.Unit1</td>
                            <td class="text-end">@item.MinQty</td>
                            <td class="text-end">@item.MaxQty</td>
                            <td class="fw-bold text-end @cssClass" >@item.Stocks</td>
                        </tr>

                        sno++;
                    }
                }
            </tbody>
            <tfoot class="table-secondary fw-bold">
                <tr>
                    <td></td>
                    <td></td>
                    <td class="text-end">TOTAL</td>
                    <td class="text-end">@ViewBag.MinQty.ToString("0.00")</td>
                    <td class="text-end">@ViewBag.MaxQty.ToString("0.00")</td>
                    <td class="text-end">@ViewBag.CurrentStock</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            $("#minimumStockTable").DataTable({
                ordering: false,
                paging: true,
                searching: true,
                info: true
            });

            $(".datepicker").datepicker({
                dateFormat: "dd-mm-yy",
                changeMonth: true,
                changeYear: true
            });

        });
    </script>
}
