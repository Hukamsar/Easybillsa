    <script>

        function validateExpiry(showError = true) {
            const expiry = $("#popupExpiry").val().trim();
            const errorSpan = $("[data-field='popupExpiry']");
            errorSpan.text("");

            if (!expiry) {
                if (showError) errorSpan.text("Expiry Date is required");
                return false;
            }

            // ✅ Only MM/YY allowed
            const regex = /^(0[1-9]|1[0-2])\/\d{2}$/;

            if (!regex.test(expiry)) {
                if (showError) errorSpan.text("Format should be MM/YY");
                return false;
            }

            // Convert YY -> 20YY
            const [month, yy] = expiry.split("/");
            const year = "20" + yy;

            const expiryDate = new Date(parseInt(year), parseInt(month) - 1, 1);
            const currentDate = new Date();
            currentDate.setHours(0, 0, 0, 0);

            if (expiryDate < currentDate) {
                if (showError) errorSpan.text("Expiry date cannot be in the past");
                return false;
            }

            if (minPurchaseExpiryDays > 0) {
                const minExpiryDate = new Date();
                minExpiryDate.setDate(minExpiryDate.getDate() + minPurchaseExpiryDays);
                minExpiryDate.setHours(0, 0, 0, 0);

                if (expiryDate < minExpiryDate) {
                    if (showError) {
                        errorSpan.text(`Expiry must be at least ${minPurchaseExpiryDays} days from today`);
                    }
                    return false;
                }
            }

            return true;
        }

        // Auto-format expiry date on blur
        $(document).on("blur", "#popupExpiry", function() {
            validateExpiry(false); // Auto-format without showing error
        });
    </script>

    <!-- ================================================================
         🔹 SETTINGS SIDEBAR - UPDATE TO LOAD minPurchaseExpiryDays
         ================================================================ -->
    <script>
        $(document).ready(function () {

            // ✅ Load settings on page load to get minPurchaseExpiryDays
            function loadMinExpiryDays() {
                $.ajax({
                    url: '@Url.Action("GetSidebarSettings", "PurchaseSetting")',
                    type: 'GET',
                    success: function (data) {
                        minPurchaseExpiryDays = data.minPurchaseExpiryDays || 0;
                        console.log("Min Purchase Expiry Days:", minPurchaseExpiryDays);
                    },
                    error: function (xhr) {
                        console.error("Error loading expiry settings:", xhr.status);
                    }
                });
            }

            // ✅ Load on page ready
            loadMinExpiryDays();

            $('#settingsBtn').on('click', function (e) {
                e.preventDefault();

                $('#settingsSidebar').show();
                showLoader("Loading settings...");

                $.ajax({
                    url: '@Url.Action("GetSidebarSettings", "PurchaseSetting")',
                    type: 'GET',
                    success: function (data) {
                        hideLoader();
                        $('#userId').val(data.applicationUserId);
                        $('#minPurchaseExpiryDays').val(
                            data.minPurchaseExpiryDays > 0
                                ? data.minPurchaseExpiryDays
                                : ''
                        );

                        // ✅ Update global variable
                        minPurchaseExpiryDays = data.minPurchaseExpiryDays || 0;
                    },
                    error: function (xhr) {
                        hideLoader();
                        alert("Error loading settings. Status: " + xhr.status);
                    }
                });
            });

            $('#saveSidebarSettings').on('click', function () {
                const userId = $('#userId').val();
                const minPurchaseExpiryDaysInput =
                    parseInt($("#minPurchaseExpiryDays").val()) || 0;

                if (minPurchaseExpiryDaysInput < 0 || minPurchaseExpiryDaysInput > 365) {
                    alert("Expiry Allowed Days should be between 0 and 365");
                    return;
                }

                showLoader("Saving settings...");

                $.ajax({
                    url: '@Url.Action("SaveSidebarSettings", "PurchaseSetting")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        applicationUserId: userId,
                        MinPurchaseExpiryDays: minPurchaseExpiryDaysInput
                    }),
                    success: function () {
                        hideLoader();

                        // ✅ Update global variable after save
                        minPurchaseExpiryDays = minPurchaseExpiryDaysInput;

                        alert("Settings saved successfully");
                    },
                    error: function () {
                        hideLoader();
                        alert("Failed to save settings");
                    }
                });
            });

            $('#closeSidebar').on('click', function () {
                $('#settingsSidebar').hide();
            });
        });
    </script>
    <script>
        $(document).on("keydown", function (e) {
            // F10 pressed
            if (e.key === "F10") {

                // ❌ Browser refresh band
                e.preventDefault();
                e.stopImmediatePropagation();

                // ❌ Agar koi modal open hai to kuch mat karo
                if ($(".modal.show").length > 0) return;

                $("#refreshBtn").trigger("click");
            }

            // F11 pressed
            if (e.key === "F11") {

                // ❌ Browser refresh band
                e.preventDefault();
                e.stopImmediatePropagation();

                // ❌ Agar koi modal open hai to kuch mat karo
                if ($(".modal.show").length > 0) return;

                $("#btnCancel").trigger("click");
            }
        });

        function confirmCancel(callback) {
            Swal.fire({
                title: 'Confirm Cancel?',
                text: 'Changes will be lost. Do you want to cancel?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: '❌ Yes, Cancel',
                cancelButtonText: '↩ No, Stay',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                reverseButtons: true
            }).then((result) => {
                callback(result.isConfirmed);
            });
        }

        $("#btnCancel").on("click", function (e) {
            e.preventDefault();

            confirmCancel(function (isConfirmed) {
                if (isConfirmed) {
                    window.location.href = $("#btnCancel").attr("href");
                }
            });
        });

        $(document).on("click", "#refreshBtn", function () {
            Swal.fire({
                title: 'Refresh Page?',
                html: `
                    <p class="text-danger mb-2">⚠️ Any unsaved changes will be lost!</p>
                    <p class="mb-0">All items, payments, and customer details will be cleared.</p>
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '🔄 Yes, Refresh',
                cancelButtonText: '❌ No, Stay',
                reverseButtons: true,
                customClass: {
                    confirmButton: 'btn btn-primary',
                    cancelButton: 'btn btn-secondary'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // Show loader while refreshing
                    showLoader("Refreshing page...");
                    location.reload();
                }
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $("#addPaymentRow").click(function () {
                addPaymentRow();
            });
        
            $(document).on("click", ".remove-paymentrow-btn", function () {
                $(this).closest("tr").remove();
                updatePaymentRowIndices();
                calculateTotalPaid();
                togglePaymentAddButton();
            });
        
            $(document).on("keyup", ".paymentAmount", function () {
                calculateTotalPaid();
            });
        
            togglePaymentAddButton();
        });
        
        function addPaymentRow() {
            if (window.purchasePaymentRowAdding) return;
            window.purchasePaymentRowAdding = true;
            setTimeout(function () { window.purchasePaymentRowAdding = false; }, 0);
            let newRow = `
                <tr>
                    <td style="min-width:185px;">
                        <select name="PaymentDetails[${subrowIndex}].PaymentModeId"
                                class="form-control form-control-sm paymentMode-dropdown" required>
                            <option value="">-- Select --</option>
                            ${getPaymentOptions()}
                        </select>
                    </td>
                    <td>
                        <input name="PaymentDetails[${subrowIndex}].Amount"
                               class="form-control form-control-sm paymentAmount" value="0" />
                    </td>
                    <td>
                        <input name="PaymentDetails[${subrowIndex}].ReferenceNo"
                               class="form-control form-control-sm paymentReferenceNO" />
                    </td>
                    <td>
                        <input name="PaymentDetails[${subrowIndex}].Description"
                               class="form-control form-control-sm rate paymentDescription" />
                    </td>
                    <td>
                        <u class="remove-paymentrow-btn text-danger" style="cursor:pointer;">Remove</u>
                    </td>
                </tr>`;
        
            $("#PaymentDetailsBody").append(newRow);
        
            // AUTO FILL PAYMENT AMOUNT
            let rowCount = $("#PaymentDetailsBody tr").length;
        
            if (rowCount === 1) {
                let totalPayable = parseFloat($("#totalPayable").val()) || 0;
                if (totalPayable > 0) {
                    $("#PaymentDetailsBody tr:last .paymentAmount")
                        .val(totalPayable.toFixed(2));
                }
            } else {
                let balance = parseFloat($("#balance").val()) || 0;
                if (balance > 0) {
                    $("#PaymentDetailsBody tr:last .paymentAmount")
                        .val(balance.toFixed(2));
                } else {
                    $("#PaymentDetailsBody tr:last .paymentAmount").val("0");
                }
            }
        
            subrowIndex++;
            calculateTotalPaid();
            togglePaymentAddButton();
        }

        function getPaymentOptions() {
            return `@foreach (var item in ViewBag.PaymentMode)
            {
                 <option value="@item.Value">@item.Text</option>
            }
            `;
        }
        function validatePayments() {
            let isValid = true;

            $(".paymentMode-dropdown").each(function () {
                if (!$(this).val()) {
                    $(this).addClass("is-invalid");
                    isValid = false;
                } else {
                    $(this).removeClass("is-invalid");
                }
            });

            return isValid;
        }
        function calculateTotalPaid() {
            let totalPaid = 0;
            $(".paymentAmount").each(function () {
                let val = parseFloat($(this).val()) || 0;
                totalPaid += val;
            });
        
            $("#paidAmout").val(totalPaid.toFixed(2));
            calculateTotalPaymentSummary();
        }
        
        function calculateTotalPaymentSummary() {
            let returnAmt = 0;
            let balance = 0;
            var totalPayable = parseFloat($("#totalPayable").val()) || 0;
            var paidAmt = parseFloat($("#paidAmout").val()) || 0;
        
            if (paidAmt > totalPayable && paidAmt > 0) {
                returnAmt = paidAmt - totalPayable;
                balance = 0;
            } else {
                balance = totalPayable - paidAmt;
            }
            $("#returnAmount").val(returnAmt.toFixed(2));
            $("#ReturnAmount").val(returnAmt.toFixed(2));
            $("#balance").val(balance.toFixed(2));
            $("#returnAmountDisplay").text(returnAmt.toFixed(2));
        }

        function updatePaymentRowIndices() {
            const rows = document.querySelectorAll('#PaymentDetailsBody tr');
            subrowIndex = 0;
            rows.forEach(row => {
                row.querySelectorAll('input, select').forEach(input => {
                    const name = input.name;
                    if (name) {
                        input.name = name.replace(/\[\d+\]/, `[${subrowIndex}]`);
                    }
                });
                subrowIndex++;
            });
        }
        
        function togglePaymentAddButton() {
            if ($("#PaymentDetailsBody tr").length > 0) {
                $("#addPaymentRow").hide();
            } else {
                $("#addPaymentRow").show();
            }
        }


        $(document).on("keydown", "#PartyBillDate", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();

                console.log("🚀 Skipping existing items & creating a new row...");
                $("#addRow").click();
                setTimeout(() => {
                    let lastRowInput = $("#PurchaseItemBody tr:last .item-input");

                    if (lastRowInput.length > 0) {
                        lastRowInput.focus();
                    } else {
                        $("#PurchaseItemBody tr:last input:first").focus();
                    }
                }, 200);
            }
        });



    </script>
}
