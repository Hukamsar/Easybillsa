        });
        $('#poModal').on('shown.bs.modal', function () {

            const $rows = $(".po-row:visible");

            currentPOIndex = -1;

            if ($rows.length) {
                currentPOIndex = 0;
                highlightPORow($rows, currentPOIndex);
            }
        });
        $(document).on("mouseenter", ".challan-row", function () {
            const $rows = $(".challan-row:visible");

            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentChallanIndex = $rows.index(this);
        });
        $(document).on("mouseenter", ".po-row", function () {

            const $rows = $(".po-row:visible");

            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentPOIndex = $rows.index(this);
        });
        $(document).on("click", ".challan-row", function () {
            const $rows = $(".challan-row:visible");
            currentChallanIndex = $rows.index(this);
            highlightChallanRow($rows, currentChallanIndex);

            // Old behavior: clicking a challan row immediately loaded one challan into the grid.
            // New behavior: click/Space only marks rows; Enter applies all marked challans together.
            toggleChallanSelection($(this));
        });
        $(document).on("dblclick", ".challan-row", function () {
            const $rows = $(".challan-row:visible");
