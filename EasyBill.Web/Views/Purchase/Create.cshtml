        $("#loadPurchaseImportBtn").on("click", async function () {
            const fileInput = document.getElementById("purchaseImportFile");
            const button = $(this);

            clearPurchaseImportFeedback();

            if (!fileInput.files || fileInput.files.length === 0) {
                renderPurchaseImportFeedback("danger", "Please select a file to import.");
                return;
            }

            const formData = new FormData();
            formData.append("file", fileInput.files[0]);

            button.prop("disabled", true);
            showLoader("Reading import file...");

            try {
                const response = await $.ajax({
                    url: purchaseImportPreviewUrl,
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false
                });

                const preview = response.data || {};
                const warnings = Array.isArray(preview.warnings) ? [...preview.warnings] : [];

                pendingPurchaseImportContext = {
                    preview: preview,
                    warnings: warnings,
                    mode: $("#purchaseImportMode").val(),
                    applyHeader: $("#applyImportHeader").is(":checked"),
                    selectedSupplierId: preview.header?.supplierId || 0,
                    invoiceNumber: normalizeImportHeaderText(preview.header?.partyBillNo)
                        || normalizeImportHeaderText(preview.header?.billNo),
                    invoiceDate: formatImportPromptDateValue(preview.header?.billDate)
                        || formatImportPromptDateValue(preview.header?.partyBillDate)
                };

                await openPurchaseImportHeaderPrompt(pendingPurchaseImportContext);

                fileInput.value = "";
            } catch (xhr) {
                const response = xhr.responseJSON || {};
                renderPurchaseImportFeedback(
                    "danger",
                    response.message || "Import failed.",
                    response.errors || []);
                toastr.error(response.message || "Import failed.");
            } finally {
                hideLoader();
                button.prop("disabled", false);
            }
        });

