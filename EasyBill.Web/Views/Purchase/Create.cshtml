        // Old button-based skip kept for reference. Skip is now handled only by Esc key.
        // $("#skipChallanBtn").on("click", function () {
        //     $("#challanModal").modal("hide");
        // });
        // $("#skipPoBtn").on("click", function () {
        //     $("#poModal").modal("hide");
        // });
        $('#challanModal').on('hidden.bs.modal', function () {
            selectedChallanIds = [];
            $("#challanTableBody .challan-row").removeClass("marked");
            if (continueToPurchaseOrderAfterChallan && activeSupplierSourceId) {
                continueToPurchaseOrderAfterChallan = false;
                checkSupplierPendingPO(activeSupplierSourceId);
            }
        });
        $('#poModal').on('hidden.bs.modal', function () {
            if (focusManualEntryAfterPO) {
                focusManualEntryAfterPO = false;
                focusPartyBillEntry();
            }
        });
        $('#supplierModal').on('shown.bs.modal', function () {
            supplierWasSelected = false;
            supplierNavMode = "keyboard";

            $("#supplierModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".supplier-row:visible");
            currentSupplierIndex = -1;

            if ($rows.length) {
                currentSupplierIndex = 0;
                highlightSupplierRow($rows, currentSupplierIndex);
            }

            setTimeout(() => {
                $("#supplierSearch").focus().select();
            }, 200);
        });

        $('#supplierModal').on('hidden.bs.modal', function () {
            setTimeout(() => {
                if (skipSupplierRefocus) {
                    skipSupplierRefocus = false;
                    return;
                }

                if (supplierWasSelected) {
                    focusPartyBillEntry();
                    supplierWasSelected = false;
                } else {
                    $(".supplier-input").focus();
                }
            }, 150);
        });

       

        function checkSupplierTax(supplierId) {

            $.get('/Purchase/GetSupplierGst', { supplierId: supplierId }, function (data) {

                var companyGst = $("#companygst").val();

                // GST null ya empty check
                if (!data || !data.gst || data.gst.length < 2 || !companyGst || companyGst.length < 2) {
                   $("#purchasetype").val("Local");
                   $("#purchasetypeHidden").val("Local");
                    return;
                }

                var supplierState = data.gst.substring(0, 2);
                var companyState = companyGst.substring(0, 2);

                if (supplierState === companyState) {
                    $("#purchasetype").val("Local");
                    $("#purchasetypeHidden").val("Local");
                } else {
                    $("#purchasetype").val("Central");
                    $("#purchasetypeHidden").val("Central");
                }

                 $("#purchasetype").trigger("change");

            });
        }

    </script>

    <!-- ================================================================
         🔹 KEYBOARD NAVIGATION - ITEM GRID
         ================================================================ -->
    <script>
        $(document).on("keydown", ".item-input", function (e) {
            const row = $(this).closest("tr");
            const sourcePurchaseChallanId = row.find(".source-purchase-challan-id").val();
            const sourceItemName = (row.attr("data-source-item-name") || "").trim();

            if (e.key === "ArrowRight") {
                e.preventDefault();
                row.find(".batch").focus().select();
                return;
            }

            if (e.key === "ArrowDown") {
                e.preventDefault();
                const nextRow = row.next("tr");
                if (nextRow.length) nextRow.find(".item-input").focus();
                return;
            }

            if (e.key === "ArrowUp") {
                e.preventDefault();
                const prevRow = row.prev("tr");
                if (prevRow.length) {
                    prevRow.find(".item-input").focus();
                } else {
                    $("#PartyBillDate").focus();
                }
                return;
            }

            if (e.key === "Enter") {
                e.preventDefault();

                if (sourcePurchaseChallanId && sourceItemName && $(this).val().trim() === sourceItemName) {
                    row.find(".batch").focus().select();
                    return;
                }

                currentRow = row;
                currentRowForItemModal = row;

                const typedText = $(this).val().trim();
                openItemModal(typedText);
            }
        });

        
        function openItemModal(searchText = "") {

            if (window.stopAutoItemOpen === true || $("#itemMasterModal").is(":visible"))
                return;

            var purchaseType = $("#purchasetype").val();

            showLoader("Loading items...");

            $.get('/Purchase/GetAllItems', { purchaseType: purchaseType }, function (items) {

                hideLoader();

                const businessType = @ViewBag.BusinessType;

                let rows = renderItemRows(items, businessType);

                $("#itemTableBody").html(rows);

                $("#itemSearch").val(searchText);

                $("#itemSearch").trigger("input");

                $("#itemModal").modal("show");

            }).fail(function () {

                hideLoader();

                toastr.error("Error loading items");
            });
        }

        function renderItemRows(items, businessType) {

            let rows = "";

            items.forEach(item => {

                rows += `
                    <tr class="item-row" tabindex="0"
                        data-itemid="${item.id}"
                        data-name="${item.name}"
                        data-gst="${item.gst}"
                        data-cgst="${item.cgst}"
                        data-sgst="${item.sgst}"
                        data-qty="${item.qty}"
                        data-cess="${item.cess}"
                        data-hsn="${item.hsn || ''}">

                        <td>${item.name}</td>

                        ${
                            businessType === 2
                            ? `
                                <td style="display:none;">${item.qty}</td>
                                <td>${item.availableQty}</td>
                              `
                            : `
                                <td>${item.qty}</td>
                              `
                        }

                        <td>${item.unit || ''}</td>
                    </tr>`;
            });

            return rows;
        }


        // Purchase F2-New loads the Sales Item Master partial without leaving Purchase.
        $(document).on('click', '#btnNewItem', function (e) {
            e.preventDefault();
            e.stopPropagation();
            window.stopAutoItemOpen = true;
            showLoader("Loading Item Master...");

            $.get('/ItemMaster/LoadItemMasterPartial', function (data) {
                hideLoader();
                $('#itemMasterContainer').html(data);

                var showPurchaseItemMaster = function () {
                    window.stopAutoItemOpen = true;
                    $('#itemMasterModal').modal("show");

                    setTimeout(function () {
                        $("#ItemMasterForm input[name='Name']").focus();
                    }, 300);
                };

                if ($("#itemModal").hasClass("show")) {
                    $("#itemModal").one("hidden.bs.modal.purchaseItemMaster", showPurchaseItemMaster);
                    $("#itemModal").modal("hide");
                } else {
                    showPurchaseItemMaster();
                }
            }).fail(function (xhr) {
                window.stopAutoItemOpen = false;
                hideLoader();
                console.log(xhr.responseText);
                toastr.error("Error loading Item Master form");
            });
        });

        // Purchase F3-Mod opens selected/current item in the same embedded Item Master partial.
        $(document).on('click', '#btnModifyItem', function (e) {
            e.preventDefault();
            e.stopPropagation();
            window.stopAutoItemOpen = true;

            const $selectedRow = $(".item-row.selected");
            let selectedItemId = null;

            if ($selectedRow.length) {
                selectedItemId = $selectedRow.data("itemid");
            }

            if (!selectedItemId && currentRowForItemModal && currentRowForItemModal.length) {
                selectedItemId = currentRowForItemModal.find(".item-id").val();
            }

            if (!selectedItemId || selectedItemId == "0") {
                window.stopAutoItemOpen = false;
                toastr.warning("Please select an item first", "No Item Selected");
                return;
            }

            showLoader("Loading Item Master...");

            $.get('/ItemMaster/LoadItemMasterEditPartial?id=' + selectedItemId + '&_=' + new Date().getTime(), function (data) {
                hideLoader();
                $('#itemMasterContainer').html(data);

                var showPurchaseItemMasterEdit = function () {
                    window.stopAutoItemOpen = true;
                    $('#itemMasterModal').modal("show");

                    setTimeout(function () {
                        $("#ItemMasterForm input[name='Name']").focus();
                    }, 300);
                };

                if ($("#itemModal").hasClass("show")) {
                    $("#itemModal").one("hidden.bs.modal.purchaseItemMasterEdit", showPurchaseItemMasterEdit);
                    $("#itemModal").modal("hide");
                } else {
                    showPurchaseItemMasterEdit();
                }
            }).fail(function (xhr) {
                window.stopAutoItemOpen = false;
                hideLoader();
                console.log(xhr.responseText);
                toastr.error("Error loading Item Master edit form");
            });
        });
        function refreshItemSearchAfterCreate(response) {

            var purchaseType = $("#purchasetype").val();

            showLoader("Refreshing items...");

            $.get('/Purchase/GetAllItems', { purchaseType: purchaseType }, function (items) {

                hideLoader();

                const businessType = @ViewBag.BusinessType;

                let rows = renderItemRows(items, businessType);

                $("#itemTableBody").html(rows);

                $("#itemSearch").val(response.itemName);

                if (currentRowForItemModal && currentRowForItemModal.length) {

                    const cgst = parseFloat(response.cgst) || 0;
                    const sgst = parseFloat(response.sgst) || 0;
                    const gst = parseFloat(response.gst) || 0;
                    const cess = parseFloat(response.cess) || 0;

                    if (purchaseType === "Local") {

                        currentRowForItemModal.find(".cgst").val(cgst);
                        currentRowForItemModal.find(".sgst").val(sgst);
                        currentRowForItemModal.find(".scgst").val(cgst + sgst);
                        currentRowForItemModal.find(".gst").val(0);

                    } else {

                        currentRowForItemModal.find(".gst").val(gst);
                        currentRowForItemModal.find(".cgst").val(0);
                        currentRowForItemModal.find(".sgst").val(0);
                        currentRowForItemModal.find(".scgst").val(0);
                    }

                    currentRowForItemModal.find(".cess").val(cess);

                    currentRowForItemModal.find(".item-id").val(response.itemId);

                    currentRowForItemModal.find(".item-input").val(response.itemName);

                    currentRowForItemModal.find(".hsn-dropdown")
                        .val(response.hsnId || response.hsn || 0);

                    currentRowForItemModal.attr("data-itemdetail-valid", "true");

                    currentRowForItemModal.attr("data-import-unresolved", "false");

                    currentRowForItemModal.removeAttr("title");

                    currentRowForItemModal.find(".item-input")
                        .removeClass("border-warning")
                        .attr("title", "");

                    processItemSelection(response.itemId, currentRowForItemModal);

                    loadItemSupplierPurchaseInfo(response.itemId);

                    refreshImportResolutionState();
                }

            }).fail(function () {

                hideLoader();

                toastr.error("Error refreshing items");
            });
        }
        $(document).on("input", "#itemSearch", function () {
            const searchWords = $(this).val()
                .toLowerCase()
                .trim()
                .split(/\s+/);

            $("#itemTableBody tr").each(function () {
                const itemText = $(this).find("td:first").text().toLowerCase();
                const itemWords = itemText.split(/\s+/);

                let match = true;

                for (let i = 0; i < searchWords.length; i++) {
                    if (!itemWords[i] || !itemWords[i].startsWith(searchWords[i])) {
                        match = false;
                        break;
                    }
                }

                $(this).toggle(match);
            });

            currentItemIndex = -1;
            $("#itemTableBody .item-row").removeClass("selected");
        });

        $(document).on("keydown", function (e) {
            if (!$("#itemModal").is(":visible") || $("#itemMasterModal").is(":visible")) return;

            if (e.key === "F2") {
                e.preventDefault();
                e.stopPropagation();
                $("#btnNewItem").trigger("click");
                return;
            }

            if (e.key === "F3") {
                e.preventDefault();
                e.stopPropagation();
                $("#btnModifyItem").trigger("click");
                return;
            }

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                itemNavMode = "keyboard";
                isKeyboardScrollingItemModal = true;
                $("#itemModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".item-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentItemIndex === -1) {
                    currentItemIndex = 0;
                }
                else if (currentItemIndex < $rows.length - 1) {
                    currentItemIndex++;
                }

                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();
                if (currentItemIndex <= 0) return;
                currentItemIndex = (currentItemIndex - 1 + $rows.length) % $rows.length;
                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "Enter" && currentItemIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentItemIndex).trigger("click");
            }
        });

        function highlightItemRow($rows, index) {
            $rows.removeClass("selected");
            const $row = $rows.eq(index);
            $row.addClass("selected");
            $row[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
        }

        $(document).on("click", ".item-row", function () {
            const itemId = $(this).data("itemid");
            const itemName = $(this).data("name");
            const gst = $(this).data("gst");
            const hsn = $(this).data("hsn");


           const purchaseType = $("#purchasetype").val();

           const cgst = $(this).data("cgst");
           const sgst = $(this).data("sgst");
           const cess = $(this).data("cess");
           var scgst = cgst+sgst;
                
            if (!itemId || !currentRowForItemModal) return;

            // If an imported challan row is manually re-picked, it should behave like a manual purchase row.
            currentRowForItemModal.find(".source-purchase-challan-id").val("");
            currentRowForItemModal.removeAttr("data-source-item-name");

             if (purchaseType === "Local") {
                   currentRowForItemModal.find(".cgst").val(cgst);
                   currentRowForItemModal.find(".sgst").val(sgst);
                   currentRowForItemModal.find(".scgst").val(scgst);
                   currentRowForItemModal.find(".gst").val(0);
                   currentRowForItemModal.find(".cess").val(cess);
             } else {
                 currentRowForItemModal.find(".gst").val(gst);
                 currentRowForItemModal.find(".cgst").val(0);
                 currentRowForItemModal.find(".sgst").val(0);
                 currentRowForItemModal.find(".scgst").val(0);
                 currentRowForItemModal.find(".cess").val(cess);
             }

            currentRowForItemModal.find(".item-id").val(itemId);
            currentRowForItemModal.find(".item-input").val(itemName);
           // currentRowForItemModal.find(".gst").val(gst);
            currentRowForItemModal.find(".hsn-dropdown").val(hsn);
            currentRowForItemModal.attr("data-itemdetail-valid", "true");
            currentRowForItemModal.attr("data-import-unresolved", "false");
            currentRowForItemModal.removeAttr("title");
            currentRowForItemModal.find(".item-input")
                .removeClass("border-warning")
                .attr("title", "");

            $("#itemModal").modal("hide");

            processItemSelection(itemId, currentRowForItemModal);
            loadItemSupplierPurchaseInfo(itemId);
            refreshImportResolutionState();
        });

        $(document).on("mouseenter", ".item-row", function () {
            if (!$("#itemModal").is(":visible")) return;
            if (isKeyboardScrollingItemModal) return;

            itemNavMode = "mouse";

            $("#itemModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".item-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentItemIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#itemModal", function () {
            isKeyboardScrollingItemModal = false;
        });

        $('#itemModal').on('shown.bs.modal', function () {
            itemNavMode = "keyboard";

            $("#itemModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".item-row:visible");

            currentItemIndex = -1;

            if ($rows.length) {
                currentItemIndex = 0;
                highlightItemRow($rows, currentItemIndex);
            }

            setTimeout(() => {
                $("#itemSearch").focus().select();
            }, 200);
        });

        $('#itemModal').on('hidden.bs.modal', function () {
            if (window.stopAutoItemOpen === true) {
                return;
            }

            setTimeout(() => {
                if (focusBatchAfterItemSelect && currentRowForItemModal) {
                    currentRowForItemModal.find(".batch").focus().select();
                    focusBatchAfterItemSelect = false;
                    return;
                }

                if (currentRowForItemModal && currentRowForItemModal.length) {
                    currentRowForItemModal.find(".item-input").focus();
                }
            }, 150);
        });

        // Purchase Item Master close resets F2/F3 guard after embedded modal closes.
        $('#itemMasterModal').on('hidden.bs.modal', function () {
            if (window.stopAutoItemOpen === true) {
                setTimeout(function () {
                    window.stopAutoItemOpen = false;
                }, 800);
            }
        });

        $(document).on("keydown", ".batch", function(e) {
            if (e.key === "Enter" && !popupOpen) {
                e.preventDefault();
                const row = $(this).closest("tr");
                if (!$(this).val().trim()) {
                    //toastr.warning("Batch is required");
                    return;
                }
                row.find(".qty").focus().select();
            }
        });

        $(document).on("keydown", ".qty", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const row = $(this).closest("tr");
                if (!isValidQty($(this).val())) {
                    toastr.warning("Quantity must be greater than 0");
                    $(this).focus().select();
                    return;
                }
                row.find(".freeqty").focus().select();
            }
        });





        $(document).on("keydown", ".freeqty", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                $(this).closest("tr").find(".rate").focus().select();
            }
        });

        $(document).on("keydown", ".rate", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const row = $(this).closest("tr");
                if (!isValidRate($(this).val())) {
                    toastr.warning("Rate must be greater than 0");
                    $(this).focus().select();
                    return;
                }
                row.find(".discount").focus().select();
            }
        });

        $(document).on("keydown", ".discount", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const row = $(this).closest("tr");

                if (!validateRow(row)) return;

                const isItemDetailValid = row.attr("data-itemdetail-valid") === "true";

                if (ENABLE_ITEM_DETAIL_VALIDATION && !isItemDetailValid) {
                    currentRow = row;
                    selectedRow = row;
                    popupOpen = true;
                    $("#itemDetailModal").modal("show");
                    return;
                }

                const isLastRow = row.is("#PurchaseItemBody tr:last");

                if (isLastRow) {
                    addNewRow();
                    setTimeout(() => $("#PurchaseItemBody tr:last .item-input").focus(), 150);
                } else {
                    const nextRow = row.next("tr");
                    if (nextRow.length) nextRow.find(".item-input").focus();
                }
            }
        });
    </script>

    <!-- ================================================================
         🔹 ARROW KEY NAVIGATION
         ================================================================ -->
    <script>
        $(document).on("keydown", ".batch, .qty, .freeqty, .rate, .discount", function(e) {
            const row = $(this).closest("tr");
            const current = $(this);

            if (e.key === "ArrowRight") {
                e.preventDefault();
                if (current.hasClass("batch")) row.find(".qty").focus().select();
                else if (current.hasClass("qty")) row.find(".freeqty").focus().select();
                else if (current.hasClass("freeqty")) row.find(".rate").focus().select();
                else if (current.hasClass("rate")) row.find(".discount").focus().select();
            }

            if (e.key === "ArrowLeft") {
                e.preventDefault();
                if (current.hasClass("discount")) row.find(".rate").focus().select();
                else if (current.hasClass("rate")) row.find(".freeqty").focus().select();
                else if (current.hasClass("freeqty")) row.find(".qty").focus().select();
                else if (current.hasClass("qty")) row.find(".batch").focus().select();
                else if (current.hasClass("batch")) row.find(".item-input").focus();
            }

            if (e.key === "ArrowDown") {
                e.preventDefault();
                const nextRow = row.next("tr");
                if (!nextRow.length) return;

                if (current.hasClass("batch")) nextRow.find(".batch").focus().select();
                else if (current.hasClass("qty")) nextRow.find(".qty").focus().select();
                else if (current.hasClass("freeqty")) nextRow.find(".freeqty").focus().select();
                else if (current.hasClass("rate")) nextRow.find(".rate").focus().select();
                else if (current.hasClass("discount")) nextRow.find(".discount").focus().select();
            }

            if (e.key === "ArrowUp") {
                e.preventDefault();
                const prevRow = row.prev("tr");

                if (!prevRow.length) {
                    $("#PartyBillDate").focus();
                    return;
                }

                if (current.hasClass("batch")) prevRow.find(".batch").focus().select();
                else if (current.hasClass("qty")) prevRow.find(".qty").focus().select();
                else if (current.hasClass("freeqty")) prevRow.find(".freeqty").focus().select();
                else if (current.hasClass("rate")) prevRow.find(".rate").focus().select();
                else if (current.hasClass("discount")) prevRow.find(".discount").focus().select();
            }
        });
    </script>

    <!-- ================================================================
         🔹 ADD ROW & REMOVE ROW
         ================================================================ -->
    <script>
        $(document).ready(function() {
            $("#addRow").click(function() {
                if (!validateHeaderFields()) return;

                if ($("#PurchaseItemBody tr").length > 0) {
                    if (!validateAllRows()) return;
                }

                let invalidRow = null;
                $("#PurchaseItemBody tr").each(function () {
                    if ($(this).attr("data-itemdetail-valid") !== "true") {
                        invalidRow = $(this);
                        return false;
                    }
                });

                if (ENABLE_ITEM_DETAIL_VALIDATION && invalidRow) {
                    currentRow = invalidRow;
                    selectedRow = invalidRow;
                    popupOpen = true;
                    $("#itemDetailModal").modal("show");
                    return;
                }

                addNewRow();
                setTimeout(() => $("#PurchaseItemBody tr:last .item-input").focus(), 150);
            });
        });

        function addNewRow(item = null) {
            let purchasetype = $("#purchasetype").val();
            let newRow = `
                <tr data-itemdetail-valid="false">
                    <td style="min-width:250px;">
                       <input type="hidden" name="PurchaseItemVms[${rowIndex}].ItemId" class="item-id" />
                       <input type="hidden" name="PurchaseItemVms[${rowIndex}].SourcePurchaseChallanId" class="source-purchase-challan-id" />
                       <input type="text" name="PurchaseItemVms[${rowIndex}].ItemName" class="form-control form-control-sm item-input" placeholder="Press Enter to select item" />
                    </td>
                    <td>
                      <input name="PurchaseItemVms[${rowIndex}].Batch" class="form-control form-control-sm batch" />
                    </td>
                    <td hidden>
                      <input type="text" name="PurchaseItemVms[${rowIndex}].ExpiryDate" class="form-control form-control-sm expirydate" placeholder="MM/YYYY" maxlength="7" />
                    </td>
                    <td hidden><input name="PurchaseItemVms[${rowIndex}].Mrp" class="form-control form-control-sm mrp" /></td>
                    <td><input name="PurchaseItemVms[${rowIndex}].Qty" class="form-control form-control-sm qty" value="1" /></td>
                    <td><input name="PurchaseItemVms[${rowIndex}].FreeQty" class="form-control form-control-sm freeqty" value="0" /></td>
                    <td><input name="PurchaseItemVms[${rowIndex}].Rate" class="form-control form-control-sm rate" /></td>
                    <td hidden><input name="PurchaseItemVms[${rowIndex}].salserateA" class="form-control form-control-sm salserateA" /></td>
                    <td hidden><input name="PurchaseItemVms[${rowIndex}].salserateB" class="form-control form-control-sm salserateB" /></td>
                    <td hidden style="min-width:100px;">
                        <select name="PurchaseItemVms[${rowIndex}].HsnId" class="form-control form-control-sm hsn-dropdown">
                            <option value="">-- Select Item --</option>
            @foreach (var item in ViewBag.Hsn)
            {
                                                                       <option value="@item.Value">@item.Text</option>
            }
                        </select>
                    </td>
                    <td><input name="PurchaseItemVms[${rowIndex}].Discount" class="form-control form-control-sm discount" value="0" min="0" max="100" step="0.01" /></td>
                    <td hidden><input name="PurchaseItemVms[${rowIndex}].DiscountAmt" class="form-control form-control-sm discount-amt" readonly /></td>
                    <td class="gst-col"><input name="PurchaseItemVms[${rowIndex}].Gst" class="form-control form-control-sm gst" readonly /></td>
                    <td hidden><input name="PurchaseItemVms[${rowIndex}].GstAmount" class="form-control form-control-sm gstamt" readonly /></td>
                    <td hidden><input name="PurchaseItemVms[${rowIndex}].CGst" class="form-control form-control-sm cgst" readonly /></td>
                    <td hidden><input name="PurchaseItemVms[${rowIndex}].CGstAmount" class="form-control form-control-sm cgstamt" readonly /></td>
                    <td hidden><input name="PurchaseItemVms[${rowIndex}].SGst" class="form-control form-control-sm sgst" readonly /></td>
                    <td hidden><input name="PurchaseItemVms[${rowIndex}].SGstAmount" class="form-control form-control-sm sgstamt" readonly /></td>
                    <td class="scgst-col"><input name="PurchaseItemVms[${rowIndex}].SCGst" class="form-control form-control-sm scgst" readonly /></td>
                    <td><input name="PurchaseItemVms[${rowIndex}].Cess" class="form-control form-control-sm cess" readonly /></td>
                    <td><input name="PurchaseItemVms[${rowIndex}].TotalAmt" class="form-control form-control-sm total" readonly /></td>
                    <td hidden><input name="PurchaseItemVms[${rowIndex}].BatchWiseCose" class="form-control form-control-sm batch-wise" readonly /></td>
                    <td hidden><input name="PurchaseItemVms[${rowIndex}].Barcode" class="form-control form-control-sm barcode" readonly /></td>
                    <td><u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u></td>
                </tr>`;

            $("#PurchaseItemBody").append(newRow);

            let $newTr = $("#PurchaseItemBody tr:last");

            if (item) {
                const resolvedItemId = parseInt(item.itemId, 10) || 0;
                const importRowKey = `import-row-${Date.now()}-${rowIndex}`;

                $newTr.find(".item-id").val(resolvedItemId > 0 ? resolvedItemId : "");
                $newTr.find(".item-input").val(item.itemName);
                $newTr.find(".source-purchase-challan-id").val(item.sourcePurchaseChallanId || "");

                $newTr.find(".qty").val(item.qty || 0);
                $newTr.find(".freeqty").val(item.freeQty || 0);

                $newTr.find(".rate").val(item.rate || 0);
                $newTr.find(".mrp").val(item.mrp || 0);
                $newTr.find(".batch").val(item.batch || "");
                $newTr.find(".expirydate").val(item.expiryDate || "");
                $newTr.find(".unit").val(item.unit || "");
                $newTr.find(".salserateA").val(item.salserateA || 0);
                $newTr.find(".salserateB").val(item.salserateB || 0);
                $newTr.find(".batch-wise").val(item.batchWiseCose || 0);
                $newTr.find(".barcode").val(item.barcode || "");

                $newTr.find(".discount").val(item.discount || 0);

                // GST fields
                $newTr.find(".gst").val(item.gst || 0);
                $newTr.find(".cgst").val(item.cgst || 0);
                $newTr.find(".sgst").val(item.sgst || 0);
                $newTr.find(".scgst").val(item.scgst || 0);
                $newTr.find(".cess").val(item.cess || 0);
                // HSN dropdown
                $newTr.find(".hsn-dropdown").val(item.hsnId || "");

                if (item.sourcePurchaseChallanId) {
                    $newTr.attr("data-source-item-name", item.itemName || "");
                }

                const resolutionMessage = item.resolutionMessage || "";
                $newTr.attr("data-import-source", "true");
                $newTr.attr("data-import-row-key", importRowKey);
                $newTr.attr("data-import-item-name", item.itemName || "");
                $newTr.attr("data-import-batch", item.batch || "");
                $newTr.attr("data-import-qty", item.qty || 0);
                $newTr.attr("data-import-freeqty", item.freeQty || 0);
                $newTr.attr("data-import-rate", item.rate || 0);
                $newTr.attr("data-import-mrp", item.mrp || 0);
                $newTr.attr("data-import-barcode", item.barcode || "");
                $newTr.attr("data-import-gst", item.gst || 0);
                $newTr.attr("data-import-cgst", item.cgst || 0);
                $newTr.attr("data-import-sgst", item.sgst || 0);
                $newTr.attr("data-import-cess", item.cess || 0);
                $newTr.find(".item-input")
                    .toggleClass("border-warning", resolvedItemId <= 0)
                    .attr("title", resolutionMessage);

                if (resolvedItemId > 0) {
                    $newTr.attr("data-itemdetail-valid", "true");
                    $newTr.attr("data-import-unresolved", "false");
                } else {
                    $newTr.attr("data-itemdetail-valid", "false");
                    $newTr.attr("title", resolutionMessage);
                    $newTr.attr("data-import-unresolved", "true");
                }
            }
                 
            if (purchasetype === "Local") {
            
                $newTr.find(".gst-col").hide();
                $newTr.find(".scgst-col").show();
            
            } else {
            
                $newTr.find(".gst-col").show();
                $newTr.find(".scgst-col").hide();
            
            }
             calculateRow($newTr);
            refreshImportResolutionState();
            rowIndex++;
        }

        $(document).on("click", ".remove-row-btn", function() {
            $(this).closest("tr").remove();
            calculateTotalSummary();
            refreshImportResolutionState();
        });
    </script>

    <script>
        const purchaseImportPreviewUrl = '@Url.Action("PreviewImportItems", "Purchase")';
        const importQuickCreateItemUrl = '@Url.Action("QuickCreateFromImport", "ItemMaster")';
        const importQuickCreateDivisionUrl = '@Url.Action("GetDivisionByCompany", "ItemMaster")';
        const importQuickCreateSubCategoryUrl = '@Url.Action("GetSubCategoryByCategory", "ItemMaster")';

        function escapeImportHtml(value) {
            return (value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function formatImportNumber(value, digits = 2) {
            const parsed = parseFloat(value);
            if (!Number.isFinite(parsed)) return "0";
            return parsed.toFixed(digits).replace(/\.00$/, "");
        }

        function renderPurchaseImportFeedback(level, message, details = []) {
            const alertClass = level === "success"
                ? "alert-success"
                : level === "warning"
                    ? "alert-warning"
                    : "alert-danger";

            const detailHtml = details.length
                ? `<ul class="mb-0 mt-2 ps-3">${details.slice(0, 8).map(x => `<li>${escapeImportHtml(x)}</li>`).join("")}</ul>
                   ${details.length > 8 ? `<div class="small mt-2">+ ${details.length - 8} more row note(s)</div>` : ""}`
                : "";

            $("#purchaseImportFeedback")
                .removeClass("d-none")
                .html(`<div class="alert ${alertClass} py-2 mb-0" style="font-size:0.82rem;">
                           <div class="fw-semibold">${escapeImportHtml(message)}</div>
                           ${detailHtml}
                       </div>`);
        }

        function clearPurchaseImportFeedback() {
            $("#purchaseImportFeedback").addClass("d-none").empty();
        }

        function normalizeImportHeaderText(value) {
            return String(value || "").replace(/\s+/g, " ").trim();
        }

        function formatImportPromptDateValue(value) {
            const normalizedValue = normalizeImportHeaderText(value);
            if (!normalizedValue) {
                return "";
            }

            return normalizedValue.length >= 10 ? normalizedValue.substring(0, 10) : normalizedValue;
        }

        function findMatchingImportSupplierByName(suppliers, supplierName) {
            const normalizedSupplierName = normalizeImportHeaderText(supplierName).toLowerCase();
            if (!normalizedSupplierName || !Array.isArray(suppliers)) {
                return null;
            }

            const matches = suppliers.filter(supplier =>
                normalizeImportHeaderText(supplier.firstName).toLowerCase() === normalizedSupplierName);

            return matches.length === 1 ? matches[0] : null;
        }

        async function getImportSuppliers(forceRefresh = false) {
            if (!forceRefresh && Array.isArray(cachedImportSuppliers)) {
                return cachedImportSuppliers;
            }

            if (!forceRefresh && importPromptSupplierLoadPromise) {
                return await importPromptSupplierLoadPromise;
            }

            importPromptSupplierLoadPromise = $.get('/Purchase/GetAllSuppliers');

            try {
                const data = await importPromptSupplierLoadPromise;

                if (data?.success === false) {
                    throw new Error(data.message || "Supplier list load nahi hui.");
                }

                if (!Array.isArray(data)) {
                    throw new Error("Supplier list load nahi hui.");
                }

                cachedImportSuppliers = data;
                return cachedImportSuppliers;
            } finally {
                importPromptSupplierLoadPromise = null;
            }
        }

        function getSelectedImportPromptSupplier() {
            const supplierId = parseInt($("#importSupplierPromptSelect").val(), 10) || 0;
            if (supplierId <= 0 || !Array.isArray(cachedImportSuppliers)) {
                return null;
            }

            return cachedImportSuppliers.find(x => (parseInt(x.id, 10) || 0) === supplierId) || null;
        }

        function updateImportSupplierPromptStatus() {
            const $status = $("#importSupplierPromptMatchStatus");
            const detectedSupplierName = normalizeImportHeaderText(pendingPurchaseImportContext?.preview?.header?.supplierName);
            const selectedSupplier = getSelectedImportPromptSupplier();

            $status.removeClass("text-success text-danger text-warning").addClass("text-muted");

            if (selectedSupplier && detectedSupplierName) {
                const isDetectedSupplierSame =
                    normalizeImportHeaderText(selectedSupplier.firstName).toLowerCase() === detectedSupplierName.toLowerCase();

                $status
                    .removeClass("text-muted")
                    .addClass(isDetectedSupplierSame ? "text-success" : "text-warning")
                    .text(
                        isDetectedSupplierSame
                            ? `Detected supplier matched: ${selectedSupplier.firstName}`
                            : `File supplier '${detectedSupplierName}' se different supplier select hua hai: ${selectedSupplier.firstName}`);
                return;
            }

            if (selectedSupplier) {
                $status
                    .removeClass("text-muted")
                    .addClass("text-success")
                    .text(`Selected supplier: ${selectedSupplier.firstName}`);
                return;
            }

            if (detectedSupplierName) {
                $status
                    .removeClass("text-muted")
                    .addClass("text-warning")
                    .text(`File me detected supplier: ${detectedSupplierName}. Supplier list me se select karein ya new supplier banayen.`);
                return;
            }

            $status.text("Supplier list me se existing supplier select karein.");
        }

        async function populateImportSupplierPromptSelect(selectedSupplierId = null) {
            const suppliers = await getImportSuppliers();
            const fallbackSupplierId = pendingPurchaseImportContext?.selectedSupplierId
                ?? pendingPurchaseImportContext?.createdSupplierId
                ?? pendingPurchaseImportContext?.preview?.header?.supplierId
                ?? (parseInt($(".supplier-id").val(), 10) || 0);
            const matchedSupplier = fallbackSupplierId > 0
                ? null
                : findMatchingImportSupplierByName(suppliers, pendingPurchaseImportContext?.preview?.header?.supplierName);
            const resolvedSupplierId = selectedSupplierId
                ?? fallbackSupplierId
                ?? (parseInt(matchedSupplier?.id, 10) || 0);

            const options = ['<option value="">Select Supplier</option>'];

            suppliers.forEach(supplier => {
                const supplierId = parseInt(supplier.id, 10) || 0;
                const supplierName = normalizeImportHeaderText(supplier.firstName);
                const supplierArea = normalizeImportHeaderText(supplier.area);
                const selected = supplierId > 0 && supplierId === resolvedSupplierId ? "selected" : "";
                const displayText = supplierArea ? `${supplierName} (${supplierArea})` : supplierName;

                options.push(`<option value="${supplierId}" ${selected}>${escapeImportHtml(displayText)}</option>`);
            });

            $("#importSupplierPromptSelect").html(options.join(""));

            if (pendingPurchaseImportContext) {
                pendingPurchaseImportContext.selectedSupplierId = parseInt($("#importSupplierPromptSelect").val(), 10) || 0;
            }

            updateImportSupplierPromptStatus();
        }

        function setPurchaseSupplierSelection(supplierId, supplierName) {
            const resolvedSupplierId = parseInt(supplierId, 10) || 0;
            const resolvedSupplierName = normalizeImportHeaderText(supplierName);

            $("#billingType").val("registered");
            applyBillingType("registered");
            $(".supplier-id").val(resolvedSupplierId > 0 ? resolvedSupplierId : "");
            $(".supplier-input").val(resolvedSupplierName);
            $("#purchaseOrderId").val("");
            activeSupplierSourceId = resolvedSupplierId > 0 ? resolvedSupplierId : null;

            if (resolvedSupplierId > 0) {
                checkSupplierTax(resolvedSupplierId);
            }
        }

        async function openPurchaseImportHeaderPrompt(context, selectedSupplierId = null) {
            pendingPurchaseImportContext = context;

            const detectedSupplierName = normalizeImportHeaderText(context?.preview?.header?.supplierName);
            const detectedInvoiceNumber = normalizeImportHeaderText(context?.preview?.header?.partyBillNo)
                || normalizeImportHeaderText(context?.preview?.header?.billNo);
            const detectedInvoiceDate = formatImportPromptDateValue(context?.preview?.header?.billDate)
                || formatImportPromptDateValue(context?.preview?.header?.partyBillDate);
            const fallbackInvoiceNumber = normalizeImportHeaderText(context?.invoiceNumber) || normalizeImportHeaderText($("#PartyBillNo").val());
            const fallbackInvoiceDate = formatImportPromptDateValue(context?.invoiceDate) || formatImportPromptDateValue($("#BillDate").val());
            const promptInvoiceNumber = fallbackInvoiceNumber || detectedInvoiceNumber;
            const promptInvoiceDate = fallbackInvoiceDate || detectedInvoiceDate;
            const detectedDetails = [];

            if (detectedSupplierName) {
                detectedDetails.push(`File Supplier: ${escapeImportHtml(detectedSupplierName)}`);
            }

            if (detectedInvoiceNumber) {
                detectedDetails.push(`File Invoice: ${escapeImportHtml(detectedInvoiceNumber)}`);
            }

            if (detectedInvoiceDate) {
                detectedDetails.push(`File Invoice Date: ${escapeImportHtml(detectedInvoiceDate)}`);
            }

            $("#importInvoiceNumberPromptInput").val(promptInvoiceNumber);
            $("#importInvoiceDatePromptInput").val(promptInvoiceDate);
            $("#purchaseImportHeaderPromptDetected").html(
                detectedDetails.length > 0
                    ? detectedDetails.join("<br />")
                    : "File header me supplier, invoice number, ya invoice date detect nahi hua. Supplier select karke invoice details enter karein.");

            try {
                await populateImportSupplierPromptSelect(selectedSupplierId);
            } catch (error) {
                $("#importSupplierPromptSelect").html('<option value="">Unable to load suppliers</option>');
                $("#importSupplierPromptMatchStatus")
                    .removeClass("text-success text-warning text-muted")
                    .addClass("text-danger")
                    .text(error?.message || "Supplier list load nahi hui. Please try again.");
            }

            const showPrompt = () => {
                $("#purchaseImportHeaderPromptModal").modal("show");
                setTimeout(() => {
                    const selectedSupplierIdValue = $("#importSupplierPromptSelect").val();
                    if (!selectedSupplierIdValue) {
                        $("#importSupplierPromptSelect").focus();
                    } else if (!$("#importInvoiceNumberPromptInput").val()) {
                        $("#importInvoiceNumberPromptInput").focus().select();
                    } else {
                        $("#importInvoiceDatePromptInput").focus();
                    }
                }, 180);
            };

            if ($("#purchaseImportModal").hasClass("show")) {
                preservePurchaseImportFileSelection = true;
                $("#purchaseImportModal").one("hidden.bs.modal", showPrompt);
                $("#purchaseImportModal").modal("hide");
                return;
            }

            showPrompt();
        }

        function resetPendingPurchaseImport(showImportModal = false) {
            pendingPurchaseImportContext = null;
            reopeningImportPromptAfterSupplierCreate = false;

            $("#purchaseImportHeaderPromptModal").one("hidden.bs.modal", function () {
                if (showImportModal) {
                    $("#purchaseImportModal").modal("show");
                }
            });

            $("#purchaseImportHeaderPromptModal").modal("hide");
        }

        function completePendingPurchaseImport() {
            if (!pendingPurchaseImportContext) {
                toastr.error("No pending import preview found.");
                return;
            }

            const selectedSupplier = getSelectedImportPromptSupplier();
            const invoiceNumber = normalizeImportHeaderText($("#importInvoiceNumberPromptInput").val());
            const invoiceDate = formatImportPromptDateValue($("#importInvoiceDatePromptInput").val());

            if (!selectedSupplier) {
                toastr.error("Please select a supplier.");
                $("#importSupplierPromptSelect").focus();
                return;
            }

            if (!invoiceNumber) {
                toastr.error("Please enter invoice number.");
                $("#importInvoiceNumberPromptInput").focus().select();
                return;
            }

            if (!invoiceDate) {
                toastr.error("Please select invoice date.");
                $("#importInvoiceDatePromptInput").focus();
                return;
            }

            pendingPurchaseImportContext.selectedSupplierId = parseInt(selectedSupplier.id, 10) || 0;
            pendingPurchaseImportContext.invoiceNumber = invoiceNumber;
            pendingPurchaseImportContext.invoiceDate = invoiceDate;

            const preview = pendingPurchaseImportContext.preview || {};
            const items = preview.items || [];
            const warnings = Array.isArray(pendingPurchaseImportContext.warnings)
                ? [...pendingPurchaseImportContext.warnings]
                : [];
            const mergedHeader = {
                ...(preview.header || {}),
                supplierId: pendingPurchaseImportContext.selectedSupplierId,
                supplierName: selectedSupplier.firstName || "",
                partyBillNo: invoiceNumber,
                billDate: invoiceDate
            };

            loadImportedPurchaseRows(items, pendingPurchaseImportContext.mode);

            if (pendingPurchaseImportContext.applyHeader) {
                applyImportedHeaderDetails(mergedHeader);
            } else {
                setPurchaseSupplierSelection(mergedHeader.supplierId, mergedHeader.supplierName);
                $("#PartyBillNo").val(invoiceNumber);
                $("#BillDate").val(invoiceDate);
            }

            const unresolved = getUnresolvedImportedRows();

            $("#purchaseImportHeaderPromptModal").one("hidden.bs.modal", function () {
                if (warnings.length > 0) {
                    renderPurchaseImportFeedback(
                        "warning",
                        `${items.length} item(s) loaded with ${warnings.length} note(s).`,
                        warnings);

                    toastr.warning(`${items.length} item(s) loaded. ${warnings.length} row note(s) found.`);

                    if (unresolved.length > 0) {
                        openImportResolutionModal();
                    }
                } else {
                    renderPurchaseImportFeedback("success", `${items.length} item(s) loaded successfully.`);
                    toastr.success(`${items.length} item(s) loaded successfully.`);

                    if (unresolved.length > 0) {
                        openImportResolutionModal();
                    }
                }
            });

            pendingPurchaseImportContext = null;
            const purchaseImportFile = document.getElementById("purchaseImportFile");
            if (purchaseImportFile) {
                purchaseImportFile.value = "";
            }
            $("#purchaseImportHeaderPromptModal").modal("hide");
        }

        function setPurchaseTypeValue(value) {
            if (!value) return;

            $("#purchasetype").val(value);
            $("#purchasetypeHidden").val(value);
            $("#purchasetype").trigger("change");
        }

        function applyImportedHeaderDetails(header) {
            if (!header) return;

            if (header.billNo) {
                $("#BillNo").val(header.billNo);
            }

            if (header.billDate) {
                $("#BillDate").val(String(header.billDate).substring(0, 10));
            }

            if (header.partyBillNo) {
                $("#PartyBillNo").val(header.partyBillNo);
            }

            if (header.partyBillDate) {
                $("#PartyBillDate").val(String(header.partyBillDate).substring(0, 10));
            }

            if (header.supplierId) {
                setPurchaseSupplierSelection(header.supplierId, header.supplierName || "");
            }

            if (header.purchaseType) {
                setPurchaseTypeValue(header.purchaseType);
            }
        }

        function getImportedRowData($row) {
            return {
                key: $row.attr("data-import-row-key") || "",
                row: $row,
                rowLabel: $row.index() + 1,
                itemId: parseInt($row.find(".item-id").val(), 10) || 0,
                importedName: $row.attr("data-import-item-name") || $row.find(".item-input").val().trim(),
                batch: $row.find(".batch").val().trim() || $row.attr("data-import-batch") || "",
                qty: parseInt($row.find(".qty").val(), 10) || parseInt($row.attr("data-import-qty"), 10) || 0,
                freeQty: parseInt($row.find(".freeqty").val(), 10) || parseInt($row.attr("data-import-freeqty"), 10) || 0,
                rate: parseFloat($row.find(".rate").val()) || parseFloat($row.attr("data-import-rate")) || 0,
                mrp: parseFloat($row.find(".mrp").val()) || parseFloat($row.attr("data-import-mrp")) || 0,
                barcode: $row.find(".barcode").val() || $row.attr("data-import-barcode") || "",
                gst: parseFloat($row.find(".gst").val()) || parseFloat($row.attr("data-import-gst")) || 0,
                cgst: parseFloat($row.find(".cgst").val()) || parseFloat($row.attr("data-import-cgst")) || 0,
                sgst: parseFloat($row.find(".sgst").val()) || parseFloat($row.attr("data-import-sgst")) || 0,
                cess: parseFloat($row.find(".cess").val()) || parseFloat($row.attr("data-import-cess")) || 0,
                reason: $row.attr("title") || $row.find(".item-input").attr("title") || "Item could not be matched automatically."
            };
        }

        function findImportedRowByKey(rowKey) {
            return $("#PurchaseItemBody tr[data-import-row-key]").filter(function () {
                return $(this).attr("data-import-row-key") === rowKey;
            }).first();
        }

        function getUnresolvedImportedRows() {
            const unresolved = [];

            $("#PurchaseItemBody tr[data-import-source='true']").each(function () {
                const rowData = getImportedRowData($(this));
                if (rowData.itemId <= 0 && rowData.importedName) {
                    unresolved.push(rowData);
                }
            });

            return unresolved;
        }

        function renderImportResolutionTable() {
            const unresolved = getUnresolvedImportedRows();
            const $summary = $("#importMissingItemsSummary");
            const $tbody = $("#importMissingItemsTableBody");

            if (!unresolved.length) {
                $summary
                    .removeClass("alert-warning")
                    .addClass("alert-success")
                    .html("<div class='fw-semibold'>All imported items are resolved.</div>");

                $tbody.html(`<tr><td colspan="7" class="text-center text-muted py-4">No unresolved imported items.</td></tr>`);
                return;
            }

            $summary
                .removeClass("alert-success")
                .addClass("alert-warning")
                .html(`
                    <div class="fw-semibold">${unresolved.length} imported item(s) still need item-master resolution.</div>
                    <div class="small mt-1">Create the missing item here, or jump to the row and match it manually.</div>
                `);

            $tbody.html(unresolved.map(item => `
                <tr>
                    <td>${item.rowLabel}</td>
                    <td>${escapeImportHtml(item.importedName)}</td>
                    <td>${escapeImportHtml(item.batch || "-")}</td>
                    <td>${escapeImportHtml(String(item.qty || 0))}</td>
                    <td>${escapeImportHtml(formatImportNumber(item.rate))}</td>
                    <td>${escapeImportHtml(item.reason)}</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-primary me-1 open-import-quick-create" data-row-key="${escapeImportHtml(item.key)}">Create Item</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary focus-import-row" data-row-key="${escapeImportHtml(item.key)}">Go To Row</button>
                    </td>
                </tr>
            `).join(""));
        }

        function refreshImportResolutionState() {
            const unresolved = getUnresolvedImportedRows();
            const $button = $("#resolveImportedItemsBtn");

            $button.toggleClass("d-none", unresolved.length === 0);
            $button.find(".resolve-count").text(unresolved.length);

            if ($("#importMissingItemsModal").hasClass("show")) {
                renderImportResolutionTable();

                if (!unresolved.length) {
                    setTimeout(() => $("#importMissingItemsModal").modal("hide"), 300);
                }
            }
        }

        function openImportResolutionModal() {
            renderImportResolutionTable();

            if ($("#purchaseImportModal").hasClass("show")) {
                $("#purchaseImportModal").one("hidden.bs.modal", function () {
                    $("#importMissingItemsModal").modal("show");
                });

                $("#purchaseImportModal").modal("hide");
                return;
            }

            $("#importMissingItemsModal").modal("show");
        }

        function clearImportQuickCreateValidation() {
            $("#importQuickCreateItemForm .is-invalid").removeClass("is-invalid");
            $("#importQuickCreateItemForm [data-valmsg-for]").text("");
        }

        function injectImportQuickCreatePartial(html) {
            const $wrapper = $("<div>").html(html);
            const scripts = $wrapper.find("script").map(function () {
                return this.text || this.textContent || this.innerHTML || "";
            }).get();

            $wrapper.find("script").remove();
            $("#importQuickCreateItemModalBody").html($wrapper.html());

            scripts.forEach(scriptContent => {
                if (scriptContent && scriptContent.trim()) {
                    $.globalEval(scriptContent);
                }
            });
        }

        function applyImportQuickCreateValidation(errors) {
            clearImportQuickCreateValidation();

            Object.keys(errors || {}).forEach(key => {
                const messages = errors[key] || [];
                const $field = $(`#importQuickCreateItemForm [name='${key}']`);
                const $message = $(`#importQuickCreateItemForm [data-valmsg-for='${key}']`);

                $field.addClass("is-invalid");
                $message.text(messages[0] || "Invalid value.");
            });
        }

        function populateQuickCreateSelect($select, items, placeholderText) {
            const currentValue = $select.val() || "0";
            const options = [`<option value="0">${escapeImportHtml(placeholderText)}</option>`];

            (items || []).forEach(item => {
                const value = item.value ?? item.id ?? 0;
                if (String(value) === "0") {
                    return;
                }

                const text = item.text ?? item.name ?? "";
                const selected = String(value) === String(currentValue) ? "selected" : "";
                options.push(`<option value="${escapeImportHtml(String(value))}" ${selected}>${escapeImportHtml(String(text))}</option>`);
            });

            $select.html(options.join(""));
        }

        function applyImportQuickCreateTaxValues(taxProfile) {
            const igst = parseFloat(taxProfile?.igst) || 0;
            const cgst = parseFloat(taxProfile?.cgst) || 0;
            const sgst = parseFloat(taxProfile?.sgst) || 0;
            const cess = parseFloat(taxProfile?.cess) || 0;

            $("#importQuickCreateIgst").val(formatImportNumber(igst));
            $("#importQuickCreateCgst").val(formatImportNumber(cgst));
            $("#importQuickCreateSgst").val(formatImportNumber(sgst));
            $("#importQuickCreateCess").val(formatImportNumber(cess));

            const hasTax = igst > 0 || cgst > 0 || sgst > 0 || cess > 0;
            $("#importQuickCreateTaxPreview").text(
                hasTax
                    ? `IGST ${formatImportNumber(igst)}% | CGST ${formatImportNumber(cgst)}% | SGST ${formatImportNumber(sgst)}% | Cess ${formatImportNumber(cess)}%`
                    : "");
        }

        async function updateImportQuickCreateTaxPreview() {
            const $select = $("#importQuickCreateHsnId");
            const $selected = $select.find("option:selected");
            const value = parseInt($selected.val(), 10) || 0;

            if (value <= 0) {
                applyImportQuickCreateTaxValues({
                    igst: $select.data("sourceIgst"),
                    cgst: $select.data("sourceCgst"),
                    sgst: $select.data("sourceSgst"),
                    cess: $select.data("sourceCess")
                });
                return;
            }

            let taxProfile = {
                igst: $selected.data("igst"),
                cgst: $selected.data("cgst"),
                sgst: $selected.data("sgst"),
                cess: $selected.data("cess")
            };

            const hasInlineTaxData =
                taxProfile.igst !== undefined ||
                taxProfile.cgst !== undefined ||
                taxProfile.sgst !== undefined ||
                taxProfile.cess !== undefined;

            if (!hasInlineTaxData) {
                try {
                    taxProfile = await $.get(`/HSN/GetDetails?Id=${value}`);
                } catch {
                    taxProfile = { igst: 0, cgst: 0, sgst: 0, cess: 0 };
                }
            }

            applyImportQuickCreateTaxValues(taxProfile);
        }

        async function openImportQuickCreateModal(rowKey) {
            const $row = findImportedRowByKey(rowKey);

            if (!$row.length) {
                toastr.error("The selected import row could not be found.");
                return;
            }

            const rowData = getImportedRowData($row);
            showLoader("Loading item form...");

            try {
                const html = await $.get(importQuickCreateItemUrl, {
                    rowKey: rowData.key,
                    itemName: rowData.importedName,
                    barcode: rowData.barcode,
                    batch: rowData.batch,
                    qty: rowData.qty,
                    freeQty: rowData.freeQty,
                    mrp: rowData.mrp,
                    rate: rowData.rate,
                    gst: rowData.gst,
                    cgst: rowData.cgst,
                    sgst: rowData.sgst,
                    cess: rowData.cess
                });

                injectImportQuickCreatePartial(html);
                clearImportQuickCreateValidation();
                updateImportQuickCreateTaxPreview();
                $("#importQuickCreateItemModal").modal("show");

                setTimeout(() => {
                    $("#importQuickCreateName").focus().select();
                }, 150);
            } catch {
                toastr.error("Unable to load the item creation form.");
            } finally {
                hideLoader();
            }
        }

        function applyResolvedImportItemToRow(rowKey, item) {
            const $row = findImportedRowByKey(rowKey);

            if (!$row.length || !item) {
                return;
            }

            const itemId = parseInt(item.id, 10) || 0;
            if (itemId <= 0) {
                return;
            }

            const purchaseType = $("#purchasetype").val();
            const cgst = parseFloat(item.cgst) || 0;
            const sgst = parseFloat(item.sgst) || 0;
            const scgst = cgst + sgst;
            const gst = parseFloat(item.gst) || 0;
            const cess = parseFloat(item.cess) || 0;

            $row.find(".item-id").val(itemId);
            $row.find(".item-input").val(item.name || $row.attr("data-import-item-name") || "");
            $row.find(".barcode").val(item.barcode || $row.find(".barcode").val() || "");

            if ((!$row.find(".mrp").val() || parseFloat($row.find(".mrp").val()) === 0) && item.mrp !== undefined) {
                $row.find(".mrp").val(item.mrp);
            }

            if ((!$row.find(".salserateA").val() || parseFloat($row.find(".salserateA").val()) === 0) && item.salesRate1 !== undefined) {
                $row.find(".salserateA").val(item.salesRate1);
            }

            if ((!$row.find(".salserateB").val() || parseFloat($row.find(".salserateB").val()) === 0) && item.salesRate2 !== undefined) {
                $row.find(".salserateB").val(item.salesRate2);
            }

            $row.find(".hsn-dropdown").val(item.hsnId || "");

            if (purchaseType === "Local") {
                $row.find(".gst").val(0);
                $row.find(".cgst").val(cgst);
                $row.find(".sgst").val(sgst);
                $row.find(".scgst").val(scgst);
                $row.find(".cess").val(cess);
            } else {
                $row.find(".gst").val(gst);
                $row.find(".cgst").val(0);
                $row.find(".sgst").val(0);
                $row.find(".scgst").val(0);
                $row.find(".cess").val(cess);
            }

            $row.attr("data-itemdetail-valid", "true");
            $row.attr("data-import-unresolved", "false");
            $row.removeAttr("title");
            $row.find(".item-input")
                .removeClass("border-warning")
                .attr("title", "");

            calculateRow($row);
            refreshImportResolutionState();
        }

        function loadImportedPurchaseRows(items, mode) {
            if (mode === "replace") {
                $("#PurchaseItemBody").html("");
                rowIndex = 0;
            }

            items.forEach(item => addNewRow(item));
            calculateTotalSummary();
            refreshImportResolutionState();
        }

