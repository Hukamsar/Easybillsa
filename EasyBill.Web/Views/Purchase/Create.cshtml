            applySelectedPurchaseChallans($(this));
        });
        $(document).on("click", ".po-row", function () {

            const poId = $(this).data("poid");

            if (!poId) return;

            showLoader("Loading PO details...");

            $.get('/Purchase/GetPurchaseOrderDetails', { poId: poId }, function (data) {

                hideLoader();

                if (!data) return;
                focusManualEntryAfterPO = false;
                $("#purchaseOrderId").val(poId);
                $("#sourcePurchaseChallanId").val("");
                $("#PurchaseItemBody").html("");
                rowIndex = 0;
                 
                if (data.items && data.items.length > 0) {
                    data.items.forEach(item => {
                        addNewRow(item);  
                    });
                } else {
                    addNewRow();  
                }

                $("#poModal").modal("hide");
                focusPartyBillEntry();
            })
            .fail(function () {
                hideLoader();
                toastr.error("Error loading PO details");
