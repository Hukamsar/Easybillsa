                       url: form.action,
                       type: "POST",
                       data: $(form).serialize()
                   });
           
                   toastr.success("Purchase saved successfully!");
                   window.location.href = "/Purchase/Index";
           
               } catch (xhr) {
           
                   if (xhr.status === 400 && xhr.responseJSON) {
                       toastr.error(xhr.responseJSON.message || "Validation failed");
                   } else {
                       toastr.error("Something went wrong!");
                   }
           
               } finally {
                   hideLoader(); // ✅ ALWAYS RUN
               }
           });
                
            return true;
        }
        function fixDecimalFields() {
            $("#PurchaseItemBody tr").each(function () {
                const row = $(this);
                const decimalFields = ['.mrp', '.salserateA', '.salserateB', '.discount', '.rate', '.freeqty'];

                decimalFields.forEach(field => {
                    const $input = row.find(field);
                    const val = $input.val();

                    if (!val || val.trim() === '' || val === 'NaN' || isNaN(parseFloat(val))) {
                        $input.val('0');
                    }
                });
            });

            ['#discountPercent', '#discountamount'].forEach(field => {
                const $input = $(field);
                const val = $input.val();

                if (!val || val.trim() === '' || val === 'NaN' || isNaN(parseFloat(val))) {
                    $input.val('0');
                }
            });
        }
       
        async function isDuplicateBillNumber() {
            const billNo = $("#BillNo").val()?.trim();
           

            if (!billNo) return false;

            try {
               const response = await $.ajax({
                   url: '/Purchase/IsBillNumberDuplicate',
                   type: 'GET',
                   data: { billNumber: billNo }
               });

                return response.isDuplicate; // true / false
            } catch (err) {
                console.error(err);
                return false;
            }
        }
    </script>

