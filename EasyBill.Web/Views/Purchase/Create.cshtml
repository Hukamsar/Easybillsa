        function calculateRow(row) {

            let purchaseType = $("#purchasetype").val();

            let qty = parseFloat(row.find(".qty").val()) || 0;
            let freeQty = parseFloat(row.find(".freeqty").val()) || 0;
            let rate = parseFloat(row.find(".rate").val()) || 0;

            let igst = parseFloat(row.find(".gst").val()) || 0;
            let sgst = parseFloat(row.find(".sgst").val()) || 0;
            let cgst = parseFloat(row.find(".cgst").val()) || 0;
            let cess = parseFloat(row.find(".cess").val()) || 0;
            let discount = parseFloat(row.find(".discount").val()) || 0;

            // ROW-LEVEL CALCULATION
            let grossAmount = qty * rate;

            let discountAmt = (grossAmount * discount) / 100;
            let amountAfterDiscount = grossAmount - discountAmt;

            let igstAmt = 0;
            let sgstAmt = 0;
            let cgstAmt = 0;

            if (purchaseType === "Local") {

                sgstAmt = (amountAfterDiscount * sgst) / 100;
                cgstAmt = (amountAfterDiscount * cgst) / 100;

            } else {

                igstAmt = (amountAfterDiscount * igst) / 100;

            }
            let cessAmt = (amountAfterDiscount * cess) / 100;
            let gstAmt = igstAmt + sgstAmt + cgstAmt;

            let total = amountAfterDiscount + gstAmt + cessAmt;

            // BILL DISCOUNT
            let billDiscountPercent = parseFloat($("#discountPercent").val()) || 0;
            let billDiscountAmt = (amountAfterDiscount * billDiscountPercent) / 100;

            let finalAmount = amountAfterDiscount - billDiscountAmt;

            // GST AFTER BILL DISCOUNT
            let finalGstAmt = 0;

            if (purchaseType === "Local") {

                finalGstAmt =
                    (finalAmount * sgst / 100) +
                    (finalAmount * cgst / 100);

            } else {

                finalGstAmt = (finalAmount * igst) / 100;

            }

            let totalWithBillDiscount = finalAmount + finalGstAmt + cessAmt;

            // BATCH-WISE COST
            let totalQty = qty + freeQty;
            let netCost = totalQty > 0 ? totalWithBillDiscount / totalQty : 0;

            // UPDATE ROW
            row.find(".discount-amt").val(discountAmt.toFixed(2));

            row.find(".gstamt").val(igstAmt.toFixed(2));
            row.find(".cgstamt").val(cgstAmt.toFixed(2));
            row.find(".sgstamt").val(sgstAmt.toFixed(2)); 
            row.find(".total").val(total.toFixed(2));
            row.find(".batch-wise").val(netCost.toFixed(4));

            calculateTotalSummary();
        }
        function calculateTotalSummary() {

            let total = 0, totalGst = 0, totalDiscount = 0, totalamt = 0;
            let totalCgst = 0, totalSgst = 0, totalcess =0;

            let gstRows = [];
            let purchaseType = $("#purchasetype").val();

            $("#PurchaseItemBody tr").each(function () {

                let row = $(this);

                let qty = parseFloat(row.find(".qty").val()) || 0;
                let rate = parseFloat(row.find(".rate").val()) || 0;
                let gst = parseFloat(row.find(".gst").val()) || 0;
                let discount = parseFloat(row.find(".discount").val()) || 0;

                let igst = parseFloat(row.find(".gst").val()) || 0;
                let cgst = parseFloat(row.find(".cgst").val()) || 0;
                let sgst = parseFloat(row.find(".sgst").val()) || 0;
                let cess = parseFloat(row.find(".cess").val()) || 0;
                let grossAmount = qty * rate;

                let discountAmt = (grossAmount * discount) / 100;

                let amountAfterDiscount = grossAmount - discountAmt;

                let igstAmt = 0;
                let cgstAmt = 0;
                let sgstAmt = 0;

                if (purchaseType === "Local") {

                    cgstAmt = (amountAfterDiscount * cgst) / 100;
                    sgstAmt = (amountAfterDiscount * sgst) / 100;

                    totalCgst += cgstAmt;
                    totalSgst += sgstAmt;

                }
                else {

                    igstAmt = (amountAfterDiscount * igst) / 100;

                    totalGst += igstAmt;

                }
                let cessAmt = (amountAfterDiscount * cess) / 100;
                total += amountAfterDiscount;
                totalamt += amountAfterDiscount;
                totalDiscount += discountAmt;
                totalcess += cessAmt;

                gstRows.push({
                    rate: amountAfterDiscount,
                    gst: gst,
                    cgst: cgst,
                    sgst: sgst,
                    cess:cess
                });

            });


            let percentInput = parseFloat($("#discountPercent").val()) || 0;
            let amountInput = parseFloat($("#discountamount").val()) || 0;

            let globalDiscountPercent = 0;
            let globalDiscountAmt = 0;

            if ($("#discountPercent").is(":focus") || (percentInput > 0 && amountInput === 0)) {

                globalDiscountPercent = percentInput;

                globalDiscountAmt = (total * globalDiscountPercent) / 100;

                $("#discountamount").val(globalDiscountAmt.toFixed(2));

            }
            else if ($("#discountamount").is(":focus") || (amountInput > 0 && percentInput === 0)) {

                globalDiscountAmt = amountInput;

                globalDiscountPercent = total > 0 ? (globalDiscountAmt / total) * 100 : 0;

                $("#discountPercent").val(globalDiscountPercent.toFixed(2));

            }
            else if (percentInput > 0 && amountInput > 0) {

                globalDiscountPercent = percentInput;

                globalDiscountAmt = (total * globalDiscountPercent) / 100;

                $("#discountamount").val(globalDiscountAmt.toFixed(2));

            }


            if (globalDiscountAmt > 0) {

                totalDiscount += globalDiscountAmt;

                totalamt = total - globalDiscountAmt;

                totalGst = 0;
                totalCgst = 0;
                totalSgst = 0;
                totalcess = 0;
                gstRows.forEach(row => {

                    let rowDiscountAmt = (row.rate * globalDiscountPercent) / 100;

                    let rowAfterGlobalDiscount = row.rate - rowDiscountAmt;
                    let cessAmt = (rowAfterGlobalDiscount * row.cess) / 100;
                    if (purchaseType === "Local") {

                        let cgstAmt = (rowAfterGlobalDiscount * row.cgst) / 100;
                        let sgstAmt = (rowAfterGlobalDiscount * row.sgst) / 100;

                        totalCgst += cgstAmt;
                        totalSgst += sgstAmt;

                    }
                    else {

                        let gstAmt = (rowAfterGlobalDiscount * row.gst) / 100;

                        totalGst += gstAmt;

                    }
                    totalcess += cessAmt;
                });

            }


            let totalTax = purchaseType === "Local"
                ? totalCgst + totalSgst
                : totalGst;
            let totalscgst = purchaseType === "Local"
                ? totalCgst + totalSgst
                : 0;

            let totalPayable = totalamt + totalTax + totalcess;

            let roundedPayable = Math.round(totalPayable);

            let roundOffAmount = Number((roundedPayable - totalPayable).toFixed(2));


            $("[name='Total']").val(total.toFixed(2));

            $("[name='Totaldiscount']").val(totalDiscount.toFixed(2));


            if (purchaseType === "Local") {

                $("[name='TotalCGstAmt']").val(totalCgst.toFixed(2));

                $("[name='TotalSGstAmt']").val(totalSgst.toFixed(2));
                $("[name='TotalSCGstAmt']").val(totalscgst.toFixed(2));

                $("[name='TotalGstAmt']").val(0);

            }
            else {

                $("[name='TotalGstAmt']").val(totalGst.toFixed(2));

                $("[name='TotalCGstAmt']").val(0);

                $("[name='TotalSGstAmt']").val(0);
                $("[name='TotalSCGstAmt']").val(0);

            }


            $("[name='TotalPayable']").val(roundedPayable);
            $("[name='TotalCessAmt']").val(totalcess);
            $("[name='RoundOffAmount']").val(roundOffAmount);

        }
