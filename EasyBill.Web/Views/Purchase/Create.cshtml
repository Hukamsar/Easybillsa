        $(document).on("submit", "#importQuickCreateItemForm", async function (e) {
            e.preventDefault();

            const $form = $(this);
            const $button = $("#saveImportQuickCreateItemBtn");
            const formData = new FormData($form[0]);
            clearImportQuickCreateValidation();

            $button.prop("disabled", true);
            showLoader("Saving item...");

            try {
                const response = await $.ajax({
                    url: importQuickCreateItemUrl,
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false
                });

                applyResolvedImportItemToRow(response.rowKey, response.item);
                $("#importQuickCreateItemModal").modal("hide");

                if (response.item?.id) {
                    loadItemSupplierPurchaseInfo(response.item.id);
                }

                toastr.success(response.message || "Item created successfully.");
            } catch (xhr) {
                const response = xhr.responseJSON || {};
                applyImportQuickCreateValidation(response.errors || {});
                toastr.error(response.message || "Unable to save item.");
            } finally {
                hideLoader();
                $button.prop("disabled", false);
            }
        });

