         🔹 BATCH MODAL & ITEM DETAILS
         ================================================================ -->
    <script>
        $(document).on("keydown", ".batch", function (e) {
            if (e.key !== "Enter" || popupOpen) return;

            e.preventDefault();

            let row = $(this).closest("tr");
            let itemId = parseInt(row.find(".item-id").val(), 10) || 0;
            let enteredBatch = $(this).val()?.trim();

            // ✅ VALIDATION: Item aur batch dono required
            if (itemId <= 0) {
                toastr.warning("Please select an item first");
                row.find(".item-input").focus();
                return;
            }

            if (!enteredBatch) {
                toastr.warning("Batch is required");
                return;
            }

            currentRow = row;
            showLoader("Checking batch...");

            $.get(`/Purchase/GetBatchesByItemId?id=${itemId}`, function (response) {
                hideLoader();

                // ✅ CHECK: Entered batch exist karta hai ya nahi
                let existingBatch = response.groupedResult?.find(
                    b => b.batch.toLowerCase() === enteredBatch.toLowerCase()
                );

                if (existingBatch) {
                    // ✅ CASE 1: Batch exist karta hai → Batch Modal open karo
                    let batchRows = '';
                    response.groupedResult.forEach(batch => {
                        const d = new Date(batch.expiry);
                        const formattedExpiry = ("0" + (d.getMonth() + 1)).slice(-2) + "/" + d.getFullYear();
                        const encoded = encodeURIComponent(JSON.stringify(batch));

                        batchRows += `
                            <tr class="batch-row" data-batch="${encoded}">
                                <td>${batch.batch}</td>
                                <td>${formattedExpiry}</td>
                                <td>${batch.rate}</td>
                                <td>${batch.mrp}</td>
                                <td>${batch.qty}</td>
                                <td hidden>${batch.salserateA}</td>
                                <td hidden>${batch.salserateB}</td>
                                <td>${batch.barcode}</td>
                            </tr>`;
                    });

                    $("#batchTableBody").html(batchRows);

                    // ✅ Pre-select the matching batch in modal
                    currentBatchIndex = response.groupedResult.findIndex(
                        b => b.batch.toLowerCase() === enteredBatch.toLowerCase()
                    );

                    $("#batchModal").modal("show");
                } else {
                    // ✅ CASE 2: Batch exist nahi karta → Clear fields + Open Item Details Modal

                    // Clear row values (except Item, Batch, Barcode)
                  //  row.find(".qty").val("1");
                    row.find(".freeqty").val("0");
                    row.find(".rate").val("");
                    row.find(".discount").val("0");
                    row.find(".mrp").val("");
                    row.find(".expirydate").val("");
                    row.find(".salserateA").val("");
                    row.find(".salserateB").val("");
                    row.find(".discount-amt").val("");
                    row.find(".total").val("");
                    row.find(".batch-wise").val("");

                    // Mark as invalid
                    row.attr("data-itemdetail-valid", "false");

                    // Clear Item Details Modal fields (except barcode)
                    $("#popupExpiry").val("");
                    $("#popupMrp").val("");
                    $("#popupSalseRateA").val("");
                    $("#popupSalseRateB").val("");

                    // Keep barcode from previous data or response
                    let existingBarcode = row.find(".barcode").val() || response.barcode || "";
                    $("#popupBarcode").val(existingBarcode);

                    // Open Item Details Modal
                    selectedRow = row;
                    popupOpen = true;
                    $("#itemDetailModal").modal("show");
                }

            }).fail(function() {
                hideLoader();
                toastr.error("Error loading batches");
            });
        });

        function openBatchModalWithData(itemId, currentRow) {
            selectedRow = currentRow;
            popupOpen = true;

            let rowExpiry = currentRow.find(".expirydate").val();
            let rowMrp = currentRow.find(".mrp").val();
            let rowRateA = currentRow.find(".salserateA").val();
            let rowRateB = currentRow.find(".salserateB").val();
            let rowBarcode = currentRow.find(".barcode").val();

            $.get(`/Purchase/GetBatchesByItemId?id=${itemId}`, function (response) {
                $("#popupExpiry").val(rowExpiry || "");
                $("#popupMrp").val(rowMrp || "");
                $("#popupSalseRateA").val(rowRateA || "");
                $("#popupSalseRateB").val(rowRateB || "");
                $("#popupBarcode").val(rowBarcode || response.barcode || "");

                $("#itemDetailModal").modal("show");
            });
        }

        $("#saveItemPopup").click(function () {
            if (!validateExpiry(true)) {
                $("#popupExpiry").focus();
                return;
            }

            if (!validateMrp(true)) {
                $("#popupMrp").focus();
                return;
            }

            itemDetailSaved = true;

            if (selectedRow) {
                selectedRow.find(".expirydate").val($("#popupExpiry").val());
                selectedRow.find(".mrp").val(parseFloat($("#popupMrp").val()).toFixed(2));
                selectedRow.find(".salserateA").val($("#popupSalseRateA").val());
                selectedRow.find(".salserateB").val($("#popupSalseRateB").val());
                selectedRow.find(".barcode").val($("#popupBarcode").val());
                selectedRow.attr("data-itemdetail-valid", "true");
            }

            $("#itemDetailModal").modal("hide");
            popupOpen = false;

            setTimeout(() => {
                if (selectedRow) selectedRow.find(".qty").focus().select();
            }, 150);
        });

        $('#itemDetailModal').on('shown.bs.modal', function () {
            $("#popupExpiry").focus().select();
        });

        $('#itemDetailModal').on('hidden.bs.modal', function () {
            popupOpen = false;
            if (!itemDetailSaved && currentRow) {
                currentRow.attr("data-itemdetail-valid", "false");
            }
            itemDetailSaved = false;
        });

        $(document).on("keydown", "#itemDetailModal input", function (e) {
            if (e.key !== "Enter") return;
            e.preventDefault();

            const id = this.id;

            if (id === "popupExpiry") {
                if (!validateExpiry(true)) return;
                $("#popupMrp").focus().select();
                return;
            }

            if (id === "popupMrp") {
                if (!validateMrp(true)) return;
                $("#popupSalseRateA").focus().select();
                return;
            }

            const inputs = $("#itemDetailModal input:visible");
            const index = inputs.index(this);

            if (index > -1 && index < inputs.length - 1) {
                inputs.eq(index + 1).focus().select();
            } else {
                $("#saveItemPopup").focus();
            }
        });

        function processItemSelection(itemId, row) {
            currentRow = row;

            showLoader("Checking batches...");

            $.get(`/Purchase/GetBatchesByItemId?id=${itemId}`, function (response) {
                hideLoader();

                if (response.groupedResult && response.groupedResult.length > 0) {
                    let batchRows = '';
                    response.groupedResult.forEach(batch => {
                        const d = new Date(batch.expiry);
                        const formattedExpiry = ("0" + (d.getMonth() + 1)).slice(-2) + "/" + d.getFullYear();
                        const encoded = encodeURIComponent(JSON.stringify(batch));

                        batchRows += `
                            <tr class="batch-row" data-batch="${encoded}">
                                <td>${batch.batch}</td>
                                <td>${formattedExpiry}</td>
                                <td>${batch.rate}</td>
                                <td>${batch.mrp}</td>
                                <td>${batch.availableQty || batch.qty}</td>
                                <td hidden>${batch.salserateA}</td>
                                <td hidden>${batch.salserateB}</td>
                                <td>${batch.barcode}</td>
                            </tr>`;
                    });

                    $("#batchTableBody").html(batchRows);
                    currentBatchIndex = -1;
                    $("#batchModal").modal("show");
                } else {
                    focusBatchAfterItemSelect = true;
                }

            }).fail(function() {
                hideLoader();
                toastr.error("Error loading batches");
                setTimeout(() => row.find(".batch").focus().select(), 150);
            });
        }
    </script>

