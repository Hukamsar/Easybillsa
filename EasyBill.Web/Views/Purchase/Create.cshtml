         ================================================================ -->
    <script>
        $(document).ready(function() {
            $("#supplierForm").submit(function (e) {
                e.preventDefault();

                let isFormValid = true;

                $("#addSupplierModal input").each(function () {
                    if (!validateSupplierField(this, true)) {
                        $(this).focus().select();
                        isFormValid = false;
                        return false;
                    }
                });

                if (!isFormValid) return;

                showLoader("Creating supplier...");

                $.post('/Supplier/CreateSupplier', $(this).serialize(), function (res) {
                    hideLoader();

                    if (res.success) {
                        const createdSupplierId = parseInt(res.id, 10) || 0;
                        const shouldReturnToImportPrompt = reopeningImportPromptAfterSupplierCreate && !!pendingPurchaseImportContext;

                        if (!reopeningImportPromptAfterSupplierCreate) {
                            $(".supplier-id").val(createdSupplierId);
                            $(".supplier-input").val(res.firstName);
                        }

                        if (pendingPurchaseImportContext) {
                            pendingPurchaseImportContext.createdSupplierId = createdSupplierId;
                            pendingPurchaseImportContext.selectedSupplierId = createdSupplierId;
                        }

                        cachedImportSuppliers = null;

                        $("#supplierForm")[0].reset();

                        $('#addSupplierModal').one('hidden.bs.modal', function () {
                            document.activeElement.blur();

                            requestAnimationFrame(() => {
                                if (shouldReturnToImportPrompt) {
                                    return;
                                }

                                $(".supplier-input").trigger('focus'); // ✅ FIXED
                            });

                        }).modal('hide');

                        toastr.success("Supplier created successfully");
                    }
                    else {
                        toastr.error(res.message || "Supplier already exists");
                        $("input[name='PhoneNO']").focus().select();
                    }
                }).fail(function () {
                    hideLoader();
                    toastr.error("Server error while creating supplier");
                });
            });

            $('#addSupplierModal').on('shown.bs.modal', function () {
                $('#firstname').trigger('focus');
            });

            $("#countryId").change(function () {
                var countryId = $(this).val();
                $("#stateId").empty().append('<option value="">State</option>');
                $("#cityId").empty().append('<option value="">City</option>');
                if (countryId) {
                    $.getJSON('/Supplier/GetStatesByCountry', { countryId: countryId }, function (data) {
                        $.each(data, function (i, item) {
                            $("#stateId").append($('<option>', { value: item.id, text: item.name }));
                        });
                    });
                }
            });

            $("#stateId").change(function () {
                var stateId = $(this).val();
                $("#cityId").empty().append('<option value="">City</option>');
                if (stateId) {
                    $.getJSON('/Supplier/GetCitiesByState', { stateId: stateId }, function (data) {
                        $.each(data, function (i, item) {
                            $("#cityId").append($('<option>', { value: item.id, text: item.name }));
                        });
                    });
                }
            });

            $("#btnF2AccGrp").click(() => openSupplierQuickModal("accGrp", "new", "#AccountGroupId"));
            $("#btnF3AccGrp").click(() => openSupplierQuickModal("accGrp", "edit", "#AccountGroupId"));
            $("#btnSaveAccGrp").click(() => saveSupplierQuickData("accGrp", '/Supplier/QuickSaveAccountGroup', '#AccountGroupId', null, '/Supplier/GetAccountGroups'));
            let countryDdlSelector = "#countryId";
            let returnModalSelector = "";

            $("#countryModal,#stateModal").on('hidden.bs.modal', function () {
                if (returnModalSelector && returnModalSelector !== "#" + this.id) {
                    let modalSelector = returnModalSelector;
                    returnModalSelector = "";
                    setTimeout(() => { $(modalSelector).modal('show'); }, 200);
                }
            });

            $("#btnF2Country").click(() => { countryDdlSelector = "#countryId"; openSupplierQuickModal("country", "new", "#countryId"); });
            $("#btnF3Country").click(() => { countryDdlSelector = "#countryId"; openSupplierQuickModal("country", "edit", "#countryId"); });
            $("#btnSaveCountry").click(() => saveSupplierQuickData("country", '/Supplier/QuickSaveCountry', countryDdlSelector, null, '/Supplier/GetCountries'));
            $("#btnF2StateCountry").click(() => { countryDdlSelector = "#modalStateCountryId"; $("#stateModal").modal('hide'); setTimeout(() => { returnModalSelector = "#stateModal"; openSupplierQuickModal("country", "new", "#modalStateCountryId"); }, 350); });
            $("#btnF3StateCountry").click(() => { if(!$("#modalStateCountryId").val()){Swal.fire("Error","Select Country first!","error");return;} countryDdlSelector = "#modalStateCountryId"; $("#stateModal").modal('hide'); setTimeout(() => { returnModalSelector = "#stateModal"; openSupplierQuickModal("country", "edit", "#modalStateCountryId"); }, 350); });
            $("#btnF2CityCountry").click(() => { countryDdlSelector = "#modalCityCountryId"; $("#cityModal").modal('hide'); setTimeout(() => { returnModalSelector = "#cityModal"; openSupplierQuickModal("country", "new", "#modalCityCountryId"); }, 350); });
            $("#btnF3CityCountry").click(() => { if(!$("#modalCityCountryId").val()){Swal.fire("Error","Select Country first!","error");return;} countryDdlSelector = "#modalCityCountryId"; $("#cityModal").modal('hide'); setTimeout(() => { returnModalSelector = "#cityModal"; openSupplierQuickModal("country", "edit", "#modalCityCountryId"); }, 350); });
            $("#btnF2State").click(() => openSupplierQuickModal("state", "new", "#stateId"));
            $("#btnF3State").click(() => openSupplierQuickModal("state", "edit", "#stateId"));
            $("#btnSaveState").click(function () {
                let id = $("#modalStateId").val();
                let name = $("#modalStateName").val().trim();
                let countryId = $("#modalStateCountryId").val();
                if (!countryId) { $("#stateError").text("Select country first!"); return; }
                if (!name) { $("#stateError").text("Name required!"); return; }
                $.post('/Supplier/QuickSaveState', { id: id, name: name, countryId: countryId }, function (res) {
                    if (res.success) {
                        $("#stateModal").modal('hide');
                        $("#countryId").val(countryId);
                        $.get('/Supplier/GetStatesByCountry?countryId=' + countryId, function (data) {
                            let ddl = $("#stateId"); ddl.empty().append('<option value="">State</option>');
                            let modalDdl = $("#modalCityStateId"); modalDdl.empty().append('<option value="">select</option>');
                            $.each(data, function (i, item) {
                                let opt = $('<option>', { value: item.id, text: item.name });
                                let modalOpt = $('<option>', { value: item.id, text: item.name });
                                if (item.id == res.newId) { opt.attr('selected', 'selected'); modalOpt.attr('selected', 'selected'); }
                                ddl.append(opt);
                                modalDdl.append(modalOpt);
                            });
                            $("#cityId").empty().append('<option value="">City</option>');
                        });
                    } else { $("#stateError").text(res.message); }
                });
            });

            $("#btnF2City").click(() => openSupplierQuickModal("city", "new", "#cityId"));
            $("#btnF3City").click(() => openSupplierQuickModal("city", "edit", "#cityId"));
            $("#btnF2CityState").click(() => { $("#cityModal").modal('hide'); setTimeout(() => { returnModalSelector = "#cityModal"; openSupplierQuickModal("state", "new", "#modalCityStateId"); $("#modalStateCountryId").val($("#modalCityCountryId").val()); }, 350); });
            $("#btnF3CityState").click(() => { if(!$("#modalCityStateId").val()){Swal.fire("Error","Select State first!","error");return;} $("#cityModal").modal('hide'); setTimeout(() => { returnModalSelector = "#cityModal"; openSupplierQuickModal("state", "edit", "#modalCityStateId"); $("#modalStateCountryId").val($("#modalCityCountryId").val()); }, 350); });
            $("#btnSaveCity").click(function () {
                let id = $("#modalCityId").val();
                let name = $("#modalCityName").val().trim();
                let countryId = $("#modalCityCountryId").val();
                let stateId = $("#modalCityStateId").val();
                if (!countryId) { $("#cityError").text("Select country first!"); return; }
                if (!stateId) { $("#cityError").text("Select state first!"); return; }
                if (!name) { $("#cityError").text("Name required!"); return; }
                $.post('/Supplier/QuickSaveCity', { id: id, name: name, stateId: stateId, countryId: countryId }, function (res) {
                    if (res.success) {
                        $("#cityModal").modal('hide');
                        $("#countryId").val(countryId);
                        $.get('/Supplier/GetStatesByCountry?countryId=' + countryId, function (states) {
                            let stateDdl = $("#stateId"); stateDdl.empty().append('<option value="">State</option>');
                            $.each(states, function (i, item) {
                                let opt = $('<option>', { value: item.id, text: item.name });
                                if (item.id == stateId) opt.attr('selected', 'selected');
                                stateDdl.append(opt);
                            });
                        });
                        $.get('/Supplier/GetCitiesByState?stateId=' + stateId, function (data) {
                            let ddl = $("#cityId"); ddl.empty().append('<option value="">City</option>');
                            $.each(data, function (i, item) {
                                let opt = $('<option>', { value: item.id, text: item.name });
                                if (item.id == res.newId) opt.attr('selected', 'selected');
                                ddl.append(opt);
                            });
                        });
                    } else { $("#cityError").text(res.message); }
                });
            });

            $("#modalCityCountryId").change(function () {
                var countryId = $(this).val();
                $("#modalCityStateId").empty().append('<option value="">select</option>');
                if (countryId) {
                    $.getJSON('/Supplier/GetStatesByCountry', { countryId: countryId }, function (data) {
                        $.each(data, function (i, item) {
                            $("#modalCityStateId").append($('<option>', { value: item.id, text: item.name }));
                        });
                    });
                }
            });

            function openSupplierQuickModal(type, mode, ddlSelector) {
                $("#" + type + "Error").text("");
                if (mode === "new") {
                    $("#modal" + type.charAt(0).toUpperCase() + type.slice(1) + "Id").val(0);
                    $("#modal" + type.charAt(0).toUpperCase() + type.slice(1) + "Name").val("");
                    if (type === "accGrp") {
                        $("#modalAccGrpParentId").val("");
                        $("#modalAccGrpActive").prop("checked", true);
                    }
                    $("#" + type + "ModalTitle").text("Add " + type.charAt(0).toUpperCase() + type.slice(1));
                } else {
                    let id = $(ddlSelector).val(); let text = $(ddlSelector + " option:selected").text();
                    if (!id) { Swal.fire("Error", "Select item first!", "error"); return; }
                    $("#modal" + type.charAt(0).toUpperCase() + type.slice(1) + "Id").val(id);
                    $("#modal" + type.charAt(0).toUpperCase() + type.slice(1) + "Name").val(text);
                    if (type === "accGrp") {
                        $.get('/Supplier/GetAccountGroups', function (data) {
                            let item = data.find(x => x.value == id);
                            if (item) {
                                $("#modalAccGrpParentId").val(item.parentId || "");
                                $("#modalAccGrpActive").prop("checked", item.isActive === true);
                            }
                        });
                    }
                    $("#" + type + "ModalTitle").text("Modify " + type.charAt(0).toUpperCase() + type.slice(1));
                }
                if (type === "state") {
                    $("#modalStateCountryId").val($("#countryId").val());
                }
                if (type === "city") {
                    let countryId = $("#countryId").val();
                    let stateId = $("#stateId").val();
                    $("#modalCityCountryId").val(countryId);
                    $("#modalCityStateId").empty().append('<option value="">select</option>');
                    if (countryId) {
                        $.getJSON('/Supplier/GetStatesByCountry', { countryId: countryId }, function (data) {
                            $.each(data, function (i, item) {
                                let opt = $('<option>', { value: item.id, text: item.name });
                                if (item.id == stateId) opt.attr('selected', 'selected');
                                $("#modalCityStateId").append(opt);
                            });
                        });
                    }
                }
                $("#" + type + "Modal").modal("show");
                setTimeout(() => { $("#modal" + type.charAt(0).toUpperCase() + type.slice(1) + "Name").focus(); }, 200);
            }

            function saveSupplierQuickData(type, url, ddlSelector, extraData, reloadUrl, isCustomFormat = false) {
                let id = $("#modal" + type.charAt(0).toUpperCase() + type.slice(1) + "Id").val();
                let name = $("#modal" + type.charAt(0).toUpperCase() + type.slice(1) + "Name").val().trim();
                if (!name) { $("#" + type + "Error").text("Name required!"); return; }
                let postData = { id: id, name: name };
                if (type === "accGrp") {
                    postData.parentId = $("#modalAccGrpParentId").val();
                    postData.isActive = $("#modalAccGrpActive").is(":checked");
                }
                if (extraData) Object.assign(postData, extraData);
                $.post(url, postData, function (res) {
                    if (res.success) {
                        $("#" + type + "Modal").modal('hide');
                        $.get(reloadUrl, function (data) {
                            let ddl = $(ddlSelector); ddl.empty();
                            ddl.append('<option value="">' + (type==='accGrp'?'-- Select Group --': type.charAt(0).toUpperCase() + type.slice(1)) + '</option>');
                            $.each(data, function (i, item) {
                                let val = isCustomFormat ? item.id : item.value;
                                let txt = isCustomFormat ? item.name : item.text;
                                let opt = $('<option>', { value: val, text: txt });
                                if (type === "accGrp") {
                                    opt.attr('data-parentid', item.parentId || '');
                                    opt.attr('data-isactive', item.isActive);
                                }
                                if (val == res.newId) opt.attr('selected', 'selected');
                                ddl.append(opt);
                            });
                            if(type==='state') { $("#cityId").empty().append('<option value="">City</option>'); }
                            if(type==='country') {
                                $("#countryId,#modalStateCountryId,#modalCityCountryId").empty().append('<option value="">Country</option>');
                                $.each(data, function (i, item) {
                                    let opt1 = $('<option>', { value: item.value, text: item.text });
                                    let opt2 = $('<option>', { value: item.value, text: item.text });
                                    let opt3 = $('<option>', { value: item.value, text: item.text });
                                    if (item.value == res.newId) { opt1.attr('selected', 'selected'); opt2.attr('selected', 'selected'); opt3.attr('selected', 'selected'); }
                                    $("#countryId").append(opt1);
                                    $("#modalStateCountryId").append(opt2);
                                    $("#modalCityCountryId").append(opt3);
                                });
                                $("#stateId").empty().append('<option value="">State</option>');
                                $("#cityId").empty().append('<option value="">City</option>');
                                $("#modalCityStateId").empty().append('<option value="">select</option>');
                            }
                        });
                    } else { $("#" + type + "Error").text(res.message); }
                });
            }

            $(".modal-input").keypress(function (e) { if (e.which === 13) { e.preventDefault(); $(this).closest('.modal').find('.btn-success').click(); } });

            $('#addSupplierModal').on('hidden.bs.modal', async function () {
                if (reopeningImportPromptAfterSupplierCreate && pendingPurchaseImportContext) {
                    reopeningImportPromptAfterSupplierCreate = false;
                    const selectedSupplierId = pendingPurchaseImportContext.selectedSupplierId || pendingPurchaseImportContext.createdSupplierId || 0;
                    await openPurchaseImportHeaderPrompt(pendingPurchaseImportContext, selectedSupplierId);
                }
            });
        });

        $(document).on("keydown", "#addSupplierModal input", function (e) {
            if (e.key !== "Enter") return;

            e.preventDefault();

            if (!validateSupplierField(this, true)) {
                $(this).focus().select();
                return;
            }

            const inputs = $("#addSupplierModal input:visible");
            const index = inputs.index(this);

            if (index < inputs.length - 1) {
                inputs.eq(index + 1).focus().select();
            } else {
                $("#supplierForm button[type='submit']").focus();
            }
        });
    </script>

    <!-- ================================================================
         🔹 ITEM PURCHASE HISTORY
         ================================================================ -->
    <script>
        function loadItemSupplierPurchaseInfo(itemId) {
            $("#itemExtraInfoWrapper").show();

            $.get(`/Purchase/GetItemPurchaseHistory?id=${itemId}`, function (res) {
                if (!res || !res.success || !res.data || res.data.length === 0) {
                    $("#itemExtraInfoBody").html(`
                        <tr>
                            <td colspan="9" class="text-warning fw-semibold text-center">
                                This item has not been purchased yet
                            </td>
                        </tr>
                    `);
                    return;
                }

                let rows = "";

                res.data.forEach(x => {
                    rows += `
                        <tr>
                            <td>${x.supplier}</td>
                            <td>${x.billNo}</td>
                            <td>${x.billDate ? formatDate(x.billDate) : "--"}</td>
                            <td>${x.qty}</td>
                            <td>${x.batch ?? "--"}</td>
                            <td>${x.mrp}</td>
                            <td>${x.rate}</td>
                            <td>${x.expiryDate ? formatDate(x.expiryDate) : "--"}</td>
                            <td>${x.batchWiseCost}</td>
                        </tr>`;
                });

                $("#itemExtraInfoBody").html(rows);
            });
        }

        function formatDate(dateStr) {
            const d = new Date(dateStr);
            if (isNaN(d)) return "--";

            return (
                ("0" + d.getDate()).slice(-2) + "/" +
                ("0" + (d.getMonth() + 1)).slice(-2) + "/" +
                d.getFullYear()
            );
        }
    </script>
