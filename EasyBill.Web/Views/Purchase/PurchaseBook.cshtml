@model List<EasyBill.Models.ViewModels.PurchaseBookVM>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewBag.Title = "Purchase Book ";
    int sno = 1;
}
<style>
    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
    .custom-header th {
        background-color: #2b6ac9 !important;
        color: white !important;
        border-color: #2b6ac9 !important;
    }
</style>

<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2 d-flex align-items-center"
         style="background:#2b6ac9">

        <span class="fw-bold">
            Purchase Book 
        </span>

        <span class="fw-bold ms-auto">
            Taxable Value: ₹ @ViewBag.TotalTaxableValue.ToString("0.00") | Tax Value: ₹ @ViewBag.TotalTaxValue.ToString("0.00") | Tax Free Value: ₹ @ViewBag.TotalTaxFreeValue.ToString("0.00") | Bill Value: ₹ @ViewBag.TotalBillValue.ToString("0.00")
        </span>

    </div>
</div>

<!-- Filter Form -->
<form method="get" class="mb-3">
    <div class="row">
        <div class="col-md-3">
            <label>From Date</label>
            <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
        </div>
        <div class="col-md-3">
            <label>To Date</label>
            <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
        </div>
        <div class="col-md-3">
            <label>Supplier</label>
            <select name="supplierId" class="form-control" asp-items="@(ViewBag.SupplierList as SelectList)">
                <option value="">All</option>
            </select>
        </div>
        <div class="col-md-3 align-self-end">
            <button type="submit" class="btn text-light" style="background:#2b6ac9">Filter</button>
        </div>
    </div>
</form>

<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="ExportPurchaseBookExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           asp-route-supplierId="@ViewContext.HttpContext.Request.Query["supplierId"]">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>
        <a asp-action="ExportPurchaseBookPdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           asp-route-supplierId="@ViewContext.HttpContext.Request.Query["supplierId"]">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>

<!-- Report Table -->
<table id="purchaseBooktbl" class="table table-bordered table-striped">
    <thead class="custom-header">
        <tr>
            <th>S.No</th>
            <th>Date</th>
            <th>Inv No</th>
            <th>Party (Supplier) Name</th>
            <th class="text-end">Bill Value</th>
            <th class="text-end">Taxable Value</th>
            <th class="text-end">Tax Value</th>
            <th class="text-end">Tax Free Value</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@sno</td>
                    <td data-order='@(item.Date?.ToString("yyyyMMdd") ?? "")'>@item.Date?.ToString("dd-MM-yyyy")</td>
                    <td>@item.InvNo</td>
                    <td>@item.SupplierName</td>
                    <td class="text-end">@item.BillValue.ToString("0.00")</td>
                    <td class="text-end">@item.TaxableValue.ToString("0.00")</td>
                    <td class="text-end">@item.TaxValue.ToString("0.00")</td>
                    <td class="text-end">@item.TaxFreeValue.ToString("0.00")</td>
                </tr>
                sno++;
            }
        }
    </tbody>
    <tfoot class="table-secondary fw-bold">
        <tr>
            <td></td>
            <td></td>
            <td></td>
            <td class="text-end">TOTAL</td>
            <td class="text-end">@ViewBag.TotalBillValue.ToString("0.00")</td>
            <td class="text-end">@ViewBag.TotalTaxableValue.ToString("0.00")</td>
            <td class="text-end">@ViewBag.TotalTaxValue.ToString("0.00")</td>
            <td class="text-end">@ViewBag.TotalTaxFreeValue.ToString("0.00")</td>
        </tr>
    </tfoot>
</table>

@section Scripts {
<script>
        $(document).ready(function () {
            $("#purchaseBooktbl").DataTable({
                "order": [[1, "asc"]]
            });
        });
</script>
}
