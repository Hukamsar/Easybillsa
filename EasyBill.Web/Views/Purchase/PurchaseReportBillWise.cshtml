@using EasyBill.Models.ViewModels
@model IEnumerable<PurchaseVM>

@{
    ViewData["Title"] = "Purchase Report Bill Wise";
}

<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>

<!-- ================= REPORT HEADER ================= -->
<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2 d-flex align-items-center"
         style="background: #2b6ac9;">
        Purchase Report (Bill Wise)

        <span class="ms-auto">
            GST Amount:
            <span class="fw-bold">
                @(((decimal)(ViewBag.TotalGstAmount ?? 0m)).ToString("N2"))
            </span>
            |
            Total Amount:
            <span class="fw-bold">
                @(((decimal)(ViewBag.TotalAmount ?? 0m)).ToString("N2"))
            </span>
        </span>
    </div>
</div>

<!-- ================= FILTER FORM ================= -->
<form method="get" class="card p-3 mb-3 shadow-sm">
    <div class="row align-items-end">

        <div class="col-md-3">
            <label>Date From</label>
            <input type="date"
                   name="fromDate"
                   class="form-control"
                   value="@ViewBag.FromDate" />
        </div>

        <div class="col-md-3">
            <label>Date To</label>
            <input type="date"
                   name="toDate"
                   class="form-control"
                   value="@ViewBag.ToDate" />
        </div>

        <div class="col-md-2">
            <button type="submit"
                    class="btn w-100 text-white"
                    style="background:#2b6ac9;">
                <i class="bi bi-search"></i> Search
            </button>
        </div>

    </div>
</form>

<!-- ================= EXPORT BUTTONS ================= -->
<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="ExportPurchaseBillWiseExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           class="me-2">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>

        <a asp-action="ExportPurchaseBillWisePdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>

<!-- ================= TABLE ================= -->
<div class="card shadow-sm">
    <div class="card-body p-2">

        <table id="purchaseRptTbl"
               class="table table-bordered table-striped table-sm">

            <thead class="table-primary text-center">
                <tr>
                    <th>S.No</th>
                    <th>Bill No</th>
                    <th>Bill Date</th>
                    <th>Supplier</th>
                    <th class="text-end">Taxable Amount</th>
                    <th class="text-end">GST Amount</th>
                    <th class="text-end">Total Amount</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    int sr = 1;
                    foreach (var bill in Model)
                    {
                        <tr>
                            <td>@sr</td>
                            <td>@bill.BillNo</td>
                            <td>@bill.BillDate?.ToString("dd-MM-yyyy")</td>
                            <td>@bill.SupplierName</td>
                            <td class="text-end">
                                @bill.TaxableAmount
                            </td>
                            <td class="text-end">
                                @bill.TotalGstAmt.ToString("N2")
                            </td>
                            <td class="text-end">
                                @bill.TotalPayable.ToString("N2")
                            </td>
                        </tr>
                        sr++;
                    }
                }
             

            </tbody>

            <!-- ================= FOOTER TOTAL ================= -->
            <tfoot class="table-secondary fw-bold">
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td class="text-end">Total</td>

                    <td class="text-end">
                        @(((decimal)(ViewBag.TotalTaxableAmount ?? 0m)).ToString("N2"))
                    </td>

                    <td class="text-end">
                        @{
                            var totalGst = (decimal)(ViewBag.TotalGstAmount ?? 0m);
                        }
                        @(totalGst == 0 ? "" : totalGst.ToString("N2"))
                    </td>

                    <td class="text-end">
                        @(((decimal)(ViewBag.TotalAmount ?? 0m)).ToString("N2"))
                    </td>
                </tr>
            </tfoot>

        </table>

    </div>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {

            var t = $("#purchaseRptTbl").DataTable({
                "order": [[2, "desc"]],
                "pageLength": 10,
                "columnDefs": [
                    { "orderable": false, "targets": "_all" }
                ]
            });

            t.on('order.dt search.dt', function () {
                t.column(0, { search: 'applied', order: 'applied' }).nodes().each(function (cell, i) {
                    cell.innerHTML = i + 1;
                });
            }).draw();

        });
    </script>

}
