@using EasyBill.Models.ViewModels
@model IEnumerable<StockVM>

@{
    var companies = ViewBag.companydata as List<Company>;
    int? selectedCompanyId = ViewBag.SelectedCompanyId != null ? (int?)Convert.ToInt32(ViewBag.SelectedCompanyId) : null;

    IEnumerable<dynamic> suppliers = ViewBag.Suppliers as IEnumerable<dynamic>;
    int? selectedSupplierId = ViewBag.SelectedSupplierId != null ? (int?)Convert.ToInt32(ViewBag.SelectedSupplierId) : null;
}

<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    .table-primary {
        --bs-table-color: #ffffff;
        --bs-table-bg: #2b6ac9;
    }
</style>

<div class="card mb-3 shadow-sm">
    <div class="card-header text-white py-2 d-flex align-items-center" style="background: #2b6ac9;">
        Company wise Item wise Report
        <span class="ms-auto">
            Total Qty : <span class="fw-bold">@ViewBag.TotalQty</span> |
@*             Total Rate : <span class="fw-bold">@Convert.ToDecimal(ViewBag.TotalRate).ToString("0.00")</span> |
 *@            Total Amount : <span class="fw-bold">@Convert.ToDecimal(ViewBag.TotalAmount).ToString("0.00")</span>
        </span>
    </div>
</div>

<form method="get" asp-action="PurchaseReportCompanyWise" asp-controller="Purchase" class="card p-3 mb-3">
    <div class="row align-items-end g-2">

        <div class="col-md-2">
            <label>From Date</label>
            <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
        </div>

        <div class="col-md-2">
            <label>To Date</label>
            <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
        </div>

        <div class="col-md-3">
            <label>Company</label>
            <select name="companyId" class="form-select">
                <option value="">-- All Companies --</option>
                @if (companies != null)
                {
                    foreach (var company in companies)
                    {
                        <option value="@company.Id" selected="@(selectedCompanyId == company.Id)">
                            @company.Name
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3">
            <label>Supplier</label>
            <select name="supplierId" class="form-select">
                <option value="">-- All Suppliers --</option>
                @if (suppliers != null)
                {
                    foreach (var s in suppliers)
                    {
                        int sid = Convert.ToInt32(s.Id);
                        <option value="@sid" selected="@(selectedSupplierId == sid)">@s.Text</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn w-100 text-light" style="background:#2b6ac9;">
                <i class="bi bi-search"></i> Search
            </button>
        </div>

    </div>
</form>
<!-- ================= EXPORT BUTTONS ================= -->
<div class="row mb-2">
    <div class="col text-end">

        <a asp-action="ExportPurchaseCompanyWiseExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           asp-route-companyId="@ViewBag.SelectedCompanyId"
           asp-route-supplierId="@ViewBag.SelectedSupplierId"
           class="me-2">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>

        <a asp-action="ExportPurchaseCompanyWisePdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate"
           asp-route-companyId="@ViewBag.SelectedCompanyId"
           asp-route-supplierId="@ViewBag.SelectedSupplierId">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>

    </div>
</div>
<table id="purchaseRptTbl" class="table table-bordered table-sm">
    <thead class="table-primary">
        <tr>
            <th>Item Code</th>
            <th>Item Name</th>
            <th>Category</th>
            <th>Supplier</th>
            <th class="text-end">Total Qty</th>
            <th class="text-end">Rate</th>
            <th class="text-end">Total Amount</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.ItemCode</td>
                    <td>@item.ItemName</td>
                    <td>@item.CategoryName</td>
                    <td>@(string.IsNullOrWhiteSpace(item.SupplierName) ? "-" : item.SupplierName)</td>
                    <td class="text-end">@item.Stocks</td>
                    <td class="text-end">@item.Rate.ToString("0.00")</td>
                    <td class="text-end">@item.Amount.GetValueOrDefault().ToString("0.00")</td>
                </tr>
            }
        }
    </tbody>

    <tfoot class="table-secondary fw-bold">
        <tr>
            <td></td>
            <td></td>
            <td></td>
            <td class="text-end">TOTAL</td>
            <td class="text-end">@ViewBag.TotalQty</td>
            <td></td>
@*             <td class="text-end">@Convert.ToDecimal(ViewBag.TotalRate).ToString("0.00")</td>
 *@            <td class="text-end">@Convert.ToDecimal(ViewBag.TotalAmount).ToString("0.00")</td>
        </tr>
    </tfoot>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#purchaseRptTbl").DataTable({ ordering: false });
        });
    </script>
}
