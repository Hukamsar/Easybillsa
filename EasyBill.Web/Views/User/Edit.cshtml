@model EasyBill.Models.ViewModels.RoleListVM

@{
    ViewData["Title"] = "Edit Role";
}
<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }
</style>

<div class="card mb-3">
    <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
        Update Role
    </div>
    <div class="card-body">
        <form method="post" asp-controller="User" asp-action="Edit" asp-route-roleId="@ViewBag.RoleId">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row mb-2 ms-3">
                <label asp-for="RoleName" class="col-md-2 col-form-label text-start small">
                    Role Name <i class="redColor">*</i>
                </label>
                <div class="col-md-4">
                    <input asp-for="RoleName" type="text" class="form-control form-control-sm" required />
                    <span asp-validation-for="RoleName" class="text-danger"></span>
                </div>
                <div class="col-md-5"></div>
            </div>
            <button type="submit" class="btn btn-sm btn-primary btnBright-Sky-Blue mt-3 float-end">Update</button>
            <a asp-controller="User" asp-action="RoleList" class="btn btn-sm btn-secondary  mt-3 me-2 float-end">Cancel</a>
        </form>
    </div>
</div>