@using EasyBill.Models.ViewModels
@model RoleListVM

@{
    ViewData["Title"] = "Role List";
}
<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }
</style>

<div class="card mb-3">
    <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
        Add Role
    </div>
    <div class="card-body">
        <form method="post" asp-controller="User" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row mb-2 ms-3">
                <label asp-for="RoleName" class="col-md-2 col-form-label text-start small">
                    Role Name <i class="redColor">*</i>
                </label>
                <div class="col-md-4">
                    <input asp-for="RoleName" type="text" class="form-control form-control-sm" required />
                    <span asp-validation-for="RoleName" class="text-danger"></span>
                </div>
                <div class="col-md-5"></div>
            </div>
            <button type="submit" class="btn btn-sm btn-primary btnBright-Sky-Blue mt-3 float-end">Save</button>
        </form>
    </div>
</div>

<table id="RoleTbl" class="table table-bordered table-striped">
    <thead class="table custom-header">
        <tr>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ExistingRoles)
        {
            var isGlobalRole = item.Name == "Admin" || item.Name == "User" || item.Name == "SuperAdmin";
            <tr>
                <td>@item.Name</td>
                <td>
                    @if (!isGlobalRole || User.IsInRole("SuperAdmin"))
                    {
                        <a asp-controller="User" asp-action="Edit" asp-route-roleId="@item.Id" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    }

                    <a asp-controller="Permission" asp-action="AssignPermissions" asp-route-roleId="@item.Id" title="Permissions">
                        <span id="boot-icon" class="bi bi-plus-circle-fill p-2" style="font-size: 1rem; color: rgb(0, 0, 255); -webkit-text-stroke-width: 0px;"></span>
                    </a>

                    @if (!isGlobalRole || User.IsInRole("SuperAdmin"))
                    {
                        <a asp-controller="User" asp-action="Delete"
                           class="btn-delete"
                           title="Delete"
                           asp-route-id="@item.Id"
                           data-id="@item.Id"
                           data-controller="@ViewContext.RouteData.Values["controller"]">
                            <i class="bi bi-trash-fill text-danger p-1"></i>
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    $(document).ready(function () {
        $("#RoleTbl").DataTable();
    });
</script>
