@model EasyBill.Models.ViewModels.DayBookVM

@{
    ViewBag.Title = "Day Book Report";
    int sno = 1;
    decimal totalDebit = Model.Details.Sum(x => x.Debit);
    decimal totalCredit = Model.Details.Sum(x => x.Credit);
}

<style>
    .report-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 10px;
    }
    .report-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1) !important;
    }
    .table-primary {
        background-color: #2b6ac9 !important;
        color: white !important;
    }
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
        font-weight: 600;
    }
    .custom-header th {
        background-color: #2b6ac9 !important;
        color: white !important;
        border-color: #2b6ac9 !important;
    }
    .badge-inflow {
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
    }
    .badge-outflow {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
    }
    .clickable-row {
        cursor: pointer;
    }
    .clickable-row:hover {
        background-color: rgba(43, 106, 201, 0.05) !important;
    }
</style>

<!-- Title & Header -->
<div class="card mb-4 shadow-sm border-0 report-card">
    <div class="row card-header text-white py-3 d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #2b6ac9, #1a4fa0); border-radius: 10px 10px 0 0;">
        <div class="col-sm-2">
            <span class="fw-bold fs-5 ps-3">
                <i class="bi bi-calendar-check me-2"></i> Day Book 
            </span>
        </div>
        <div class="col-sm-6"></div>
        <div class="col-sm-4 text-end">
            <span class="fw-bold">
                Op Bal: ₹ @Model.OpeningBalance.ToString("N2") &nbsp;&nbsp;&nbsp; | &nbsp;&nbsp;&nbsp; Cl Bal: ₹ @Model.ClosingBalance.ToString("N2")
            </span>
        </div>
    </div>
</div>

<!-- Filters -->
<form method="get" class="card shadow-sm p-4 mb-4 border-0 report-card">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label fw-semibold">From Date</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">To Date</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
            </div>
        </div>
        <div class="col-md-4 d-grid">
            <button type="submit" class="btn text-light fw-bold py-2" style="background:#2b6ac9">
                <i class="bi bi-search me-1"></i> Filter Report
            </button>
        </div>
    </div>
</form>

<div class="row mb-2">
    <div class="col text-end">
        <a asp-action="ExportDayBookExcel"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-excel text-success fs-5"></i>
        </a>
        <a asp-action="ExportDayBookPdf"
           asp-route-fromDate="@ViewBag.FromDate"
           asp-route-toDate="@ViewBag.ToDate">
            <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
        </a>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm border-0 report-card p-3">
    <div class="table-responsive">
        <table id="dayBookTbl" class="table table-hover table-bordered table-striped align-middle">
            <thead class="custom-header">
                <tr>
                    <th class="text-center" style="width: 5%">S.No</th>
                    <th style="width: 12%">Date</th>
                    <th style="width: 15%">Voucher No</th>
                    <th>Particulars</th>
                    <th style="width: 15%">Type</th>
                    <th class="text-end" style="width: 12%">Debit (Dr)</th>
                    <th class="text-end" style="width: 12%">Credit (Cr)</th>
                    <th class="text-end" style="width: 15%">Balance</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Details != null && Model.Details.Count > 0)
                {
                    foreach (var item in Model.Details)
                    {
                        <tr class="clickable-row" data-href="@item.ActionUrl?returnUrl=@Context.Request.Path@Context.Request.QueryString">
                            <td class="text-center font-monospace">@sno</td>
                            <td data-order='@item.Date.ToString("yyyyMMdd")'>@item.Date.ToString("dd-MMM-yyyy")</td>
                            <td class="fw-semibold">@item.VoucherNo</td>
                            <td>@item.Particular</td>
                            <td>
                                @if (item.Debit > 0)
                                {
                                    <span class="badge badge-inflow py-1 px-2 rounded-pill"><i class="bi bi-caret-down-fill me-1"></i>@item.Type</span>
                                }
                                else
                                {
                                    <span class="badge badge-outflow py-1 px-2 rounded-pill"><i class="bi bi-caret-up-fill me-1"></i>@item.Type</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.PaymentModeRef))
                                {
                                    <br />
                                    <small class="text-muted fw-bold">@item.PaymentModeRef</small>
                                }
                            </td>
                            <td class="text-end text-success font-monospace">
                                @(item.Debit > 0 ? "₹ " + item.Debit.ToString("N2") : "-")
                            </td>
                            <td class="text-end text-danger font-monospace">
                                @(item.Credit > 0 ? "₹ " + item.Credit.ToString("N2") : "-")
                            </td>
                            <td class="text-end fw-bold font-monospace">
                                ₹ @item.Balance.ToString("N2")
                            </td>
                        </tr>
                        sno++;
                    }
                }
               
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="5" class="text-end">Total for Selected Period:</td>
                    <td class="text-end text-success font-monospace">₹ @totalDebit.ToString("N2")</td>
                    <td class="text-end text-danger font-monospace">₹ @totalCredit.ToString("N2")</td>
                    <td class="text-end text-dark font-monospace">₹ @Model.ClosingBalance.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Scripts {
    <script>
     
        $(document).ready(function () {
            $("#dayBookTbl").DataTable({
                "order": [[1, "asc"]],
                pageLength: 25,
                lengthMenu: [10, 25, 50, 100],
                responsive: true,
                language: {
                    searchPlaceholder: "Search ledger..."
                }
            });

            // Handle row click to open bill
            $(document).on('click', '.clickable-row', function() {
                var url = $(this).data('href');
                if (url) {
                    window.location = url;
                }
            });
        });
    </script>
}
