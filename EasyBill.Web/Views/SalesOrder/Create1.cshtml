                       function openOpticalPopup(currentRow, onComplete) {
            let tbody = $("#OpticalDetailsBody").empty();

            const itemId = currentRow.find(".item-id").val();
            const form = $("#salesOrderForm");

            // Always show OD & OS rows
            const eyes = ["OD", "OS"];
            eyes.forEach(eye => {
                tbody.append(`
                    <tr data-eye="${eye}">
                        <td><strong class="eye-label">${eye}</strong></td>
                        <td><input type="number" step="0.25" class="form-control sphere"></td>
                        <td><input type="number" step="0.25" class="form-control cylinder"></td>
                        <td><input type="number" step="1" class="form-control axis"></td>
                        <td><input type="number" step="0.25" class="form-control prism"></td>
                        <td><input type="number" step="0.25" class="form-control add"></td>
                    </tr>
                `);
            });

            $("#opticalPopup").modal("show");

            $("#saveOpticalBtn").off("click").on("click", function () {
                // Remove old optical inputs for this item
                form.find(`input[data-item='${itemId}']`).remove();

                // Find the next free index for OpticalVMs
                let startIndex = form.find("input[name^='OpticalVMs']").length / 7;
                // (7 fields per OpticalVM: ItemMasterId, Rx, Sphere, Cylinder, Axis, Prism, Add)

                let html = "";
                $("#OpticalDetailsBody tr").each(function (i) {
                    const index = startIndex + i;
                    const eyeSide = $(this).data("eye");
                    const sphere = $(this).find(".sphere").val();
                    const cylinder = $(this).find(".cylinder").val();
                    const axis = $(this).find(".axis").val();
                    const prism = $(this).find(".prism").val();
                    const addVal = $(this).find(".add").val();

                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].ItemMasterId" value="${itemId}" />`;
                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].Rx" value="${eyeSide}" />`;
                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].Sphere" value="${sphere}" />`;
                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].Cylinder" value="${cylinder}" />`;
                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].Axis" value="${axis}" />`;
                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].Prism" value="${prism}" />`;
                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].Add" value="${addVal}" />`;
                });

                form.append(html);
                $("#opticalPopup").modal("hide");

                if (typeof onComplete === "function") {
                    onComplete();
                }
            });
        }


         
