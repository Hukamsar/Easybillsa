              function formatExpiryDate(input) {
                  debugger
                  let value = $(input).val().replace(/[^\d]/g, '');

                  if (value.length >= 3) {
                      value = value.slice(0, 2) + '/' + value.slice(2, 6);
                  }
                  $(input).val(value.slice(0, 7)); // limit to MM/YYYY
              }

              $(document).on('input', '.expirydate', function () {
                  formatExpiryDate(this);
              });

              $(document).on("input", ".qty, .rate, .discount", function () {
                  let row = $(this).closest("tr");
                  calculateRow(row);
              });

              function calculateRow(row) {
                  let qty = parseFloat(row.find(".qty").val()) || 0;
                  let rate = parseFloat(row.find(".rate").val()) || 0;
                  let gst = parseFloat(row.find(".gst").val()) || 0;
                  let discount = parseFloat(row.find(".discount").val()) || 0;

                  let grossAmount = qty * rate;
                  let discountAmt = (grossAmount * discount) / 100;
                  let amountAfterDiscount = grossAmount - discountAmt;
                  let gstAmt = (amountAfterDiscount * gst) / 100;
                  let total = amountAfterDiscount + gstAmt;

                  row.find(".discount-amt").val(discountAmt.toFixed(2));
                  row.find(".Amount").val(total.toFixed(2));

                  calculateTotalSummary();
              }

              function calculateTotalSummary() {
                  debugger;
                  let total = 0;
                  let totalGst = 0;
                  let totalDiscount = 0, totalamt = 0;
                  let gstRows = [];
                  $("#SalesOrderItemBody tr").each(function () {
                      let row = $(this);
                      let qty = parseFloat(row.find(".qty").val()) || 0;
                      let rate = parseFloat(row.find(".rate").val()) || 0;
                      let gst = parseFloat(row.find(".gst").val()) || 0;
                      let discount = parseFloat(row.find(".discount").val()) || 0;

                      let grossAmount = qty * rate;
                      let discountAmt = (grossAmount * discount) / 100;
                      let amountAfterDiscount = grossAmount - discountAmt;
                      let gstAmt = (amountAfterDiscount * gst) / 100;

                      total += amountAfterDiscount;
                      totalamt += amountAfterDiscount;
                      totalGst += gstAmt;
                      totalDiscount += discountAmt;

                       gstRows.push({ rate: amountAfterDiscount, gst: gst });
                  });
                   let percentInput = parseFloat($("#discountPercent").val()) || 0;
                   let amountInput = parseFloat($("#discountamount").val()) || 0;

                   let globalDiscountPercent = 0;
                   let globalDiscountAmt = 0;
                   if ($("#discountPercent").is(":focus") || (percentInput > 0 && amountInput === 0)) {
                      // Use percent input
                      globalDiscountPercent = percentInput;
                      globalDiscountAmt = (total * globalDiscountPercent) / 100;
                      $("#discountamount").val(globalDiscountAmt.toFixed(2));
                   }
                   else if ($("#discountamount").is(":focus") || (amountInput > 0 && percentInput === 0)) {
                          // Use amount input
                          globalDiscountAmt = amountInput;
                          globalDiscountPercent = (globalDiscountAmt / total) * 100;
                          $("#discountPercent").val(globalDiscountPercent.toFixed(2));
                   }
                   if (globalDiscountAmt > 0) {
                      totalDiscount += globalDiscountAmt;
                      totalamt = total - globalDiscountAmt;

                      // Recalculate GST based on amount after global discount
                      totalGst = 0;
                      gstRows.forEach(row => {
                          let rowDiscountAmt = (row.rate * globalDiscountPercent) / 100;
                          let rowAfterGlobalDiscount = row.rate - rowDiscountAmt;
                          let gstAmt = (rowAfterGlobalDiscount * row.gst) / 100;
                          totalGst += gstAmt;
                      });
                   }
                  let totalPayable = totalamt + totalGst;

                  $("[name='Total']").val(total.toFixed(2));
                  $("[name='Totaldiscount']").val(totalDiscount.toFixed(2));
                  $("[name='TotalGstAmt']").val(totalGst.toFixed(2));
                  $("[name='TotalPayable']").val(totalPayable.toFixed(2));
              }

               $("#discountPercent, #discountamount").on("input", function () {
                   calculateTotalSummary();
               });

              $(document).on("click", ".remove-row-btn", function () {
                  $(this).closest("tr").remove();
                  calculateTotalSummary();
              });

               var percentInput = $("#discountPercent");
              if (parseFloat(percentInput.val()) === "")
              {
                  percentInput.val(0);
              }
              $("form").submit(function () {
                  $("#employeeId").prop("disabled", false); // Enable Address field before submit
              });
          });
    </script>
    <script>
        let subrowIndex = 0;

        $(document).ready(function () {
            $("#addPaymentRow").click(function () {
                addPaymentRow();
            });

             $(document).on("click", ".remove-paymentrow-btn", function () {
                $(this).closest("tr").remove();
                updatePaymentRowIndices();
                calculateTotalPaid();
            });

            $(document).on("keyup", ".paymentAmount", function () {
                calculateTotalPaid();
            });
        });

        function addPaymentRow() {
            let newRow = `
                <tr>
                    <td style="min-width:185px;">
                        <select name="SalsePaymentDetails[${subrowIndex}].PaymentModeId" class="form-control form-control-sm paymentMode-dropdown" required>
                            <option value="">-- Select --</option>
                            ${getPaymentOptions()}
                        </select>
                    </td>
                    <td><input name="SalsePaymentDetails[${subrowIndex}].Amount" class="form-control form-control-sm paymentAmount" value="0" /></td>
                    <td><input name="SalsePaymentDetails[${subrowIndex}].ReferenceNo" class="form-control form-control-sm paymentReferenceNO" /></td>
                    <td><input name="SalsePaymentDetails[${subrowIndex}].Description" class="form-control form-control-sm rate paymentDescription"  /></td>
                    <td><u class="remove-paymentrow-btn text-danger" style="cursor:pointer;">Remove</u></td>
                </tr>`;

            $("#PaymentDetailsBody").append(newRow);
            subrowIndex++;
            calculateTotalPaid();
        }

        function getPaymentOptions() {
            return `@foreach (var item in ViewBag.PaymentMode)
        {
                               <option value="@item.Value">@item.Text</option>
        }`;
        }

         function calculateTotalPaid() {
            let totalPaid = 0;
            $(".paymentAmount").each(function () {
                let val = parseFloat($(this).val()) || 0;
                totalPaid += val;
            });

            $("#paidAmout").val(totalPaid.toFixed(2));
          calculateTotalPaymentSummary();
        }
         function calculateTotalPaymentSummary() {
            let returnAmt = 0;
            let balance = 0;
            var totalPayable = $("#totalPayable").val();
            var paidAmt = $("#paidAmout").val();

            // Convert and validate
            var payable = parseFloat(totalPayable) || 0;
            var paid = parseFloat(paidAmt) || 0;

            if (paid > payable && paid > 0) {
                returnAmt = paid - payable;
                balance = 0;
            }else {
                balance = totalPayable - paidAmt;
            }
            $("#returnAmount").val(returnAmt.toFixed(2));
            $("#balance").val(balance.toFixed(2));
        }
        function updatePaymentRowIndices() {
            const rows = document.querySelectorAll('#PaymentDetailsBody tr');
            subrowIndex = 0;
            rows.forEach(row => {
                row.querySelectorAll('input, select').forEach(input => {
                    const name = input.name;
                    if (name) {
                        input.name = name.replace(/\[\d+\]/, `[${subrowIndex}]`);
                    }
                });
                subrowIndex++;
            });
        }


    </script>



    <script>

        // ==========================================================
        // 🔹 HEADER SECTION : ENTER KEY BASED NAVIGATION
        // Purpose:
        // - Mouse-free fast billing flow
        // - Enter press par logical next field focus
        // - POS / Billing software jaisa behavior
        // ==========================================================
        $(document).on("keydown",
            "#BillNo, #BillDate, #mobilenumber, #customer, #customeraddress, #doctorMobile, #doctorname, #doctorregno",
            function (e) {

                // Sirf Enter key handle karni hai
                if (e.key !== "Enter") return;

                // Default browser behavior roko
                e.preventDefault();

                const id = this.id;

                switch (id) {

                    // Bill No → Bill Date
                    case "BillNo":
                            $("#BillDate").focus();
                        break;

                    // Mobile number validation + next focus
                    case "mobilenumber":
                        if (!this.value.trim()) {
                            toastr.warning("Please enter customer mobile number");
                            $(this).focus();
                            return;
                        }
                        $("#customer").focus();
                        break;

                    // Customer Name → Address
                    case "customer":
                        $("#customeraddress").focus();
                        break;

                    // Address ke baad:
                    // - Doctor required ho to Doctor Mobile
                    // - warna direct Item Grid
                    case "customeraddress":
                        if ($("#doctorMobile").length) {
                            $("#doctorMobile").focus();
                        } else {
                            focusItemGrid();
                        }
                        break;

                    // Doctor Mobile → Doctor Name
                    case "doctorMobile":
                        $("#doctorname").focus();
                        break;

                    // Doctor Name → Registration No
                    case "doctorname":
                        $("#doctorregno").focus();
                        break;

                    // Doctor Registration ke baad → Item Grid
                    case "doctorregno":
                        focusItemGrid();
                        break;
                }
            }
        );

        // ==========================================================
        // 🔹 ITEM GRID FOCUS HANDLER
        // Purpose:
        // - Item grid ko safe tarike se focus dena
        // - Agar row exist na kare to auto create karna
        // ==========================================================
        function focusItemGrid() {
            debugger;
            setTimeout(() => {
                const item = $("#SalesItemBody tr:first .item-barcode");

                if (item.length) {
                    // Existing row → focus
                    item.focus().select();
                } else {
                    // No row → create first row
                    addNewRow();
                    setTimeout(() => {
                        $("#SalesItemBody tr:first .item-barcode").focus().select();
                    }, 150);
                }
            }, 150);
        }

        // ==========================================================
        // 🔹 SALES ORDER MODAL CLOSE HANDLING
        // Purpose:
        // - Agar order select hua → Qty focus
        // - Agar cancel hua → Item focus
        // ==========================================================
        $('#salesOrderModal').on('hidden.bs.modal', function () {

            setTimeout(() => {

                // If order selected → focus Qty
                if (salesOrderSelected) {
                    // Order selected → Qty
                    const qtyInput = $("#SalesItemBody tr:first .qty");
                    if (qtyInput.length) {
                        qtyInput.focus().select();
                    }
                }
                // If modal closed without selection → focus Item
                else {
                    // Order not selected → Item
                    const firstItem = $("#SalesItemBody tr:first .item-barcode");
                    if (firstItem.length) {
                        firstItem.focus().select();
                    }
                }

                // Reset flag for next use
                salesOrderSelected = false;

            }, 200);
        });



        // ==========================================================
        // 🔹 ITEM MODAL CLOSE HANDLING (CROSS / ESC / BACKDROP)
        // Purpose:
        // - Item modal close hone par
        // - Usi row ke Item column (.item-barcode) par focus wapas lana
        // ==========================================================
        $('#itemModal').on('hidden.bs.modal', function () {

            // Modal fully close hone ke baad focus restore
            setTimeout(() => {

                if (currentRowForCrossItemModal && currentRowForCrossItemModal.length) {
                    const itemInput = currentRowForCrossItemModal.find(".item-barcode");

                    if (itemInput.length) {
                        itemInput.focus().select();
                    }
                }

            }, 150);
        });



        // ==========================================================
        // 🔹 INITIAL PAGE LOAD FOCUS
        // Purpose:
        // - Page load par Bill Date se flow start ho
        // ==========================================================
        $(document).ready(function () {
            setTimeout(() => {
                $("#BillDate").focus();
            }, 300);
        });


        // ==========================================================
        // 🔹 AUTO ADD FIRST ITEM ROW
        // Purpose:
        // - Blank screen avoid karna
        // - Grid ready rakhna for keyboard usage
        // ==========================================================
        setTimeout(function () {
            if ($("#SalesItemBody tr").length === 0) {
                addNewRow();
            }

            toggleAddRowButton();
        }, 300);

        // ==========================================================
        // ⌨️ ITEM GRID KEYBOARD NAVIGATION
        // Purpose:
        // - Qty → Rate → Discount → New Row
        // - Arrow keys se Excel jaisa movement
        // ==========================================================
        $(document).on("keydown", ".qty, .rate, .discount", function (e) {
            const row = $(this).closest("tr");
            const input = $(this);

            const isQty = input.hasClass("qty");
            const isRate = input.hasClass("rate");
            const isDiscount = input.hasClass("discount");

            // ================= ENTER =================
            if (e.key === "Enter") {
                e.preventDefault();

                if (isQty) {
                    row.find(".rate").focus().select();
                }
                else if (isRate) {
                    row.find(".discount").focus().select();
                }
                else if (isDiscount) {
                    addNewRow();
                    setTimeout(() => {
                        $("#SalesItemBody tr:last .item-barcode").focus();
                    }, 150);
                }
                return;
            }

            // ================= RIGHT ARROW =================
            if (e.key === "ArrowRight") {
                e.preventDefault();
                if (isQty) row.find(".rate").focus();
                else if (isRate) row.find(".discount").focus();
                return;
            }

            // ================= LEFT ARROW =================
            if (e.key === "ArrowLeft") {
                e.preventDefault();
                if (isDiscount) row.find(".rate").focus();
                else if (isRate) row.find(".qty").focus();
                return;
            }

            // ================= DOWN ARROW =================
            if (e.key === "ArrowDown") {
                e.preventDefault();
                const nextRow = row.next("tr");
                if (!nextRow.length) return;

                if (isQty) nextRow.find(".qty").focus();
                else if (isRate) nextRow.find(".rate").focus();
                else if (isDiscount) nextRow.find(".discount").focus();
                return;
            }

            // ================= UP ARROW =================
            if (e.key === "ArrowUp") {
                e.preventDefault();
                const prevRow = row.prev("tr");
                if (!prevRow.length) return;

                if (isQty) prevRow.find(".qty").focus();
                else if (isRate) prevRow.find(".rate").focus();
                else if (isDiscount) prevRow.find(".discount").focus();
            }
        });

        // ==========================================================
        // 🔹 ADD ROW BUTTON VISIBILITY CONTROL
        // ==========================================================
        function toggleAddRowButton() {
            if ($("#SalesItemBody tr").length > 0) {
                $("#addRow").hide();
            } else {
                $("#addRow").show();
            }
        }


        // ==========================================================
        // 💳 PAYMENT GRID KEYBOARD NAVIGATION
        // Purpose:
        // - Mode → Amount → Reference → Description
        // - Last description Enter → New payment row
        // ==========================================================
        $(document).on(
            "keydown",
            ".paymentMode-dropdown, .paymentAmount, .paymentReferenceNO, .paymentDescription",
            function (e) {

                const row = $(this).closest("tr");
                const input = $(this);

                const isMode = input.hasClass("paymentMode-dropdown");
                const isAmount = input.hasClass("paymentAmount");
                const isRef = input.hasClass("paymentReferenceNO");
                const isDesc = input.hasClass("paymentDescription");

                // ================= ENTER =================
                if (e.key === "Enter") {
                    e.preventDefault();
                    e.stopImmediatePropagation();

                    const paymentMode = row.find(".paymentMode-dropdown").val();

                    // ❌ Payment Mode required
                    if (!paymentMode) {
                        row.find(".paymentMode-dropdown").focus();
                        return;
                    }

                    // ➜ MODE → AMOUNT
                    if (isMode) {
                        const amt = row.find(".paymentAmount");
                        amt.focus();

                        // Remove 0 when entering
                        setTimeout(() => {
                            if (amt.val() === "0") amt.val("");
                        }, 0);
                        return;
                    }

                    // ➜ AMOUNT → REFERENCE
                    if (isAmount) {
                        if (input.val().trim() === "") input.val("0");
                        row.find(".paymentReferenceNO").focus();
                        return;
                    }

                    // ➜ REFERENCE → DESCRIPTION
                    if (isRef) {
                        row.find(".paymentDescription").focus();
                        return;
                    }

                    // ➜ DESCRIPTION → ADD ROW
                    if (isDesc) {
                        const isLastRow = row.is("#PaymentDetailsBody tr:last");

                        if (!isLastRow) return;

                        const amountInput = row.find(".paymentAmount");
                        const amountVal = parseFloat(amountInput.val());

                        // ❌ Amount must be valid (> 0)
                        if (!amountVal || amountVal <= 0) {
                            amountInput.focus();
                            amountInput.select();
                            return;
                        }

                        addPaymentRow();

                        setTimeout(() => {
                            $("#PaymentDetailsBody tr:last .paymentMode-dropdown").focus();
                        }, 150);

                        return;
                    }
                }

                // ================= ARROW NAVIGATION =================
                if (e.key === "ArrowRight") {
                    e.preventDefault();
                    if (isMode) row.find(".paymentAmount").focus();
                    else if (isAmount) row.find(".paymentReferenceNO").focus();
                    else if (isRef) row.find(".paymentDescription").focus();
                }

                if (e.key === "ArrowLeft") {
                    e.preventDefault();
                    if (isDesc) row.find(".paymentReferenceNO").focus();
                    else if (isRef) row.find(".paymentAmount").focus();
                    else if (isAmount) row.find(".paymentMode-dropdown").focus();
                }

                if (e.key === "ArrowDown") {
                    e.preventDefault();
                    const next = row.next("tr");
                    if (!next.length) return;

                    if (isMode) next.find(".paymentMode-dropdown").focus();
                    else if (isAmount) next.find(".paymentAmount").focus();
                    else if (isRef) next.find(".paymentReferenceNO").focus();
                    else if (isDesc) next.find(".paymentDescription").focus();
                }

                if (e.key === "ArrowUp") {
                    e.preventDefault();
                    const prev = row.prev("tr");
                    if (!prev.length) return;

                    if (isMode) prev.find(".paymentMode-dropdown").focus();
                    else if (isAmount) prev.find(".paymentAmount").focus();
                    else if (isRef) prev.find(".paymentReferenceNO").focus();
                    else if (isDesc) prev.find(".paymentDescription").focus();
                }
            }
        );


        // ==========================================================
        // 🔹 PAYMENT "ADD ROW" BUTTON VISIBILITY CONTROL
        // Purpose:
        // - Page load par decide karna ki "Add Payment Row" button
        //   dikhana hai ya nahi
        // - Agar already payment rows exist karti hain,
        //   to button hide rahe (duplicate row avoid karne ke liye)
        // ==========================================================
        $(document).ready(function () {

            // Page load hote hi check karo
            // ki payment table me koi row hai ya nahi
            togglePaymentAddButton();
        });




        // ==========================================================
        // 🔹 Toggle Add Payment Row Button
        // Purpose:
        // - Agar payment grid me kam se kam 1 row ho
        //   → "Add Row" button hide kar do
        // - Agar koi row na ho
        //   → button wapas show karo
        // ==========================================================
        function togglePaymentAddButton() {

             // Check: PaymentDetailsBody ke andar koi <tr> exist karta hai?
            if ($("#PaymentDetailsBody tr").length > 0) {

                // ✅ Row already present → button hide
                $("#addPaymentRow").hide();
            } else {

                // ✅ Row already present → button hide
                $("#addPaymentRow").show();
            }
        }




        // ==========================================================
        // 🔹 APPLY BILLING TYPE LOGIC (Walk-in / Registered)
        // Purpose:
        // - Billing Type ke base par customer fields ko
        //   enable / disable karna
        // - Keyboard navigation flow ko sahi direction dena
        // - Enter-key aur manual change dono cases handle karna
        // ==========================================================
        function applyBillingType(type) {
            debugger;
            setTimeout(() => {

                // 🚶 WALK-IN CUSTOMER
                if (type === "walkin") {

                    // Walk-in billing me customer details required nahi
                    // - Fields clear kar do
                    // - Disable kar do taaki user galti se input na kare
                    $("#mobilenumber, #customer, #customeraddress")
                        .val("")
                        .prop("disabled", true);

                    // Agar billing type Enter key se change nahi hua
                    // (i.e. manual dropdown change)
                    // tab focus Bill Date par hi rakho
                    if (!isEnterNavigation) {
                        $("#BillDate").focus();
                    }

                }
                // 🧾 REGISTERED CUSTOMER
                else if (type === "registered") {
                    // Registered customer ke liye customer details mandatory
                    // - Fields enable karo
                    $("#mobilenumber, #customer, #customeraddress")
                        .prop("disabled", false);

                    // Keyboard-first flow ke liye
                    // Mobile Number par focus set karo
                    $("#mobilenumber").focus();
                }

                // 🔄 Reset flag:
                // Reason:
                // - Next navigation / billing type change
                //   fresh state se start ho
                isEnterNavigation = false;

            }, 100);
        }





        // ==========================================================
        // 🔹 BILLING TYPE CHANGE HANDLER
        // Purpose:
        // - Jab user manually dropdown change kare (mouse / click se)
        // - Tab keyboard-enter flow ko reset karna
        // - Aur selected billing type ka logic apply karna
        // ==========================================================
        $("#billingType").on("change", function () {
            debugger;
            // ❗ User ne manually billing type change kiya
            // Isliye Enter-key navigation flag reset karna zaroori hai
            // (taaki focus galat jagah jump na kare)
            isEnterNavigation = false;

            // Selected billing type ke according
            // customer fields enable / disable + focus manage karo
            applyBillingType(this.value);
        });



        // ==========================================================
        // 🔹 INITIAL PAGE LOAD BILLING SETUP
        // Purpose:
        // - Page load hote hi billing type ke base par
        //   correct UI state set karna
        // - Walk-in → fields disabled
        // - Registered → fields enabled
        // ==========================================================
        $(document).ready(function () {

           // Page load par jo billing type selected hai
           // uska behavior immediately apply karo
           applyBillingType($("#billingType").val());
        });




        // ==========================================================
        // 🔹 BILL DATE → BILLING TYPE DROPDOWN (ENTER KEY HANDLING)
        // Purpose:
        // - Bill Date field par Enter press karte hi
        //   Billing Type dropdown par focus le jana
        // - Dropdown ko open karna bina kisi option ko auto-select kiye
        // - User ko Arrow ↑ ↓ se option choose karne dena
        // ==========================================================
        $(document).on("keydown", "#BillDate", function (e) {
            debugger;
            // Sirf Enter key par hi logic chale
            if (e.key !== "Enter") return;

            // Default Enter behavior (form submit / blur) ko roko
            e.preventDefault();
            e.stopImmediatePropagation();

            // Billing Type dropdown ka reference
            const $select = $("#billingType");

            // ⏩ Focus Billing Type dropdown par le aao
            // Reason:
            // - Keyboard-only workflow maintain karna
            $select.focus();

            // 🔽 Dropdown open karna WITHOUT kisi value ko select kiye
            // Reason:
            // - Auto selection nahi chahiye
            // - User Arrow keys se manually option choose kare
            // - Enter press karke final selection kare
            $select[0].dispatchEvent(
                new KeyboardEvent("keydown", {
                    key: "ArrowDown",   // Browser ko dropdown open karne ka signal
                    bubbles: true       // Event proper propagation ke liye
                })
            );
        });


        // ==========================================================
        // 🔹 BILLING TYPE DROPDOWN - KEYBOARD (ENTER) HANDLING
        // Purpose:
        // - Billing Type dropdown me keyboard navigation support dena
        // - Arrow keys se option change allow karna
        // - Enter press par selection confirm karna
        // - Selection ke baad correct next focus & business flow follow karna
        // ==========================================================
        $(document).on("keydown", "#billingType", function (e) {
            debugger;
            // ⬆️⬇️ Arrow keys ko browser ke default behavior ke liye chhod do
            // Reason:
            // - User dropdown me options upar-niche move kar sake
            if (e.key === "ArrowUp" || e.key === "ArrowDown") return;

            // ⏎ Enter key press handling
            if (e.key === "Enter") {

                // Default Enter behavior (form submit / blur) roko
                e.preventDefault();
                e.stopImmediatePropagation();

                // Selected billing type value
                const type = this.value;


                // ===============================
                // 🔥 BUSINESS LOGIC AFTER SELECTION
                // ===============================

                // Agar "Registered Customer" select hua
                if (type === "registered") {

                    // 🔓 Customer fields enable + focus Mobile No
                    // Reason:
                    // - Mobile number se customer lookup hota hai
                    // - Keyboard-only user ke liye smooth flow
                    $("#mobilenumber")
                        .prop("disabled", false)
                        .focus();
                }
                // Agar "Walk-in Customer" select hua
                else
                {
                    // 🔒 Customer related fields clear + disable
                    // Reason:
                    // - Walk-in billing me customer info optional hoti hai
                    // - Old customer data submit hone se bachana
                    $("#mobilenumber, #customer, #customeraddress")
                        .val("")
                        .prop("disabled", true);

                    // ➜ Direct item grid par focus
                    // Reason:
                    // - Walk-in billing ka main kaam item add karna hota hai
                    // - Extra steps avoid karne ke liye
                    focusItemGrid();
                }
            }
        });


        // ==========================================================
        // 🔹 BILLING TYPE CHANGE HANDLER
        // Purpose:
        // - Billing type ke according customer fields ko enable/disable karna
        // - Walk-in customer me unnecessary customer details avoid karna
        // - Registered customer me customer details allow karna
        // ==========================================================
        $("#billingType").on("change", function () {
            debugger;
            // Agar billing type "Walk-in Customer" select kiya gaya
            if (this.value === "walkin") {

                // 🔒 Customer related fields clear + disable
                // Reason:
                // - Walk-in billing me customer details mandatory nahi hoti
                // - Galti se old customer data submit na ho
                $("#mobilenumber, #customer, #customeraddress")
                    .val("")
                    .prop("disabled", true);

                // ➜ Direct item grid par focus
                // Reason:
                // - Walk-in flow fast hota hai
                // - User turant items scan / add kar sake
                focusItemGrid();
            }
            // Agar billing type "Registered Customer" select kiya gaya
            else
            {
                // 🔓 Customer fields enable
                // Reason:
                // - Registered billing ke liye customer info required hoti hai
                // - Mobile number se customer lookup hota hai
                $("#mobilenumber, #customer, #customeraddress")
                    .prop("disabled", false);
            }
        });



        // ==========================================================
        // 🔹 TOTAL → DISCOUNT → PAYMENT FLOW
        // Purpose:
        // - Total Enter → Discount %
        // - Discount % Enter → Discount Amount
        // - Discount Amount Enter → Payment Grid
        // ==========================================================
        $(document).on(
            "keydown",
            "#Total, #discountPercent, #discountamount",
            function (e) {

                if (e.key !== "Enter") return;

                e.preventDefault();
                e.stopImmediatePropagation();

                const id = this.id;

                switch (id) {

                    // TOTAL → Discount %
                    case "Total":
                        $("#discountPercent").focus().select();
                        break;

                    // Discount % → Discount Amount
                    case "discountPercent":
                        $("#discountamount").focus().select();
                        break;

                    // Discount Amount → Payment Grid
                    case "discountamount":
                        openPaymentGrid();
                        break;
                }
            }
        );

        // ==========================================================
        // 🔹 OPEN PAYMENT GRID & SET INITIAL FOCUS
        // Purpose:
        // - Discount ke baad payment section ko auto-activate karna
        // - User ko manually click karne ki need na pade
        // - First payment mode dropdown par keyboard focus dena
        // ==========================================================
        function openPaymentGrid() {

            setTimeout(() => {

                // 🔍 Check:
                // - Kya payment grid me pehle se koi row exist karti hai?
                // - Agar haan, to usi first row ke payment mode par focus
                const firstPaymentMode =
                    $("#PaymentDetailsBody tr:first .paymentMode-dropdown");

                if (firstPaymentMode.length) {
                    // Existing row found → direct focus
                    firstPaymentMode.focus();
                    return;
                }

                // ❌ No payment row exists
                // ➜ First payment row automatically add karo
                addPaymentRow();

                // New row create hone ke baad
                // - Uske payment mode dropdown par focus set karo
                setTimeout(() => {
                    $("#PaymentDetailsBody tr:first .paymentMode-dropdown").focus();
                }, 150);

            }, 100);
        }
    </script>
}