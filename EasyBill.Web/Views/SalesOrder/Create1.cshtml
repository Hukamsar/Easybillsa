@using EasyBill.Models.ViewModels
@model SalesOrderVM
@{
    ViewData["Title"] = "Create Sales";
}
<hr />
<style>
    .batch-row.selected {
        background-color: #cfe2ff !important;
        border: 2px solid #0d6efd;
    }

    tr.selected {
        background-color: #d2e3fc;
        border: 2px solid green;
    }

    #settingsSidebar {
        box-shadow: -3px 0 5px rgba(0,0,0,0.2);
    }

    #offerTable tbody tr:focus {
        background-color: #198754 !important; /* Bootstrap success green */
        color: #0d6efd;
        border: 2px solid green;
        outline: none;
    }

</style>
 

<h5>Create Salse Order</h5>
<form id="salesOrderForm">
    <input type="hidden" id="SelectedOfferId" asp-for="OfferId" />
    <!-- Hidden field for CustomerId -->
    <input type="hidden" asp-for="CustomerId" id="CustomerId" />
    <input type="hidden" asp-for="PharmacyDoctorId" id="DoctorId" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="container">
        <div class="row">
            <div class="row mb-2">

                <label asp-for="BillNo" class="col-md-2 col-form-label text-start small"> Bill No <i class="redColor">*</i> </label>
                <div class="col-md-2">
                    <input asp-for="BillNo" type="text" class="form-control form-control-sm" required />
                    <span asp-validation-for="BillNo" class="text-danger"></span>
                </div>

@*                 <label class="col-md-2 "> </label>
                <div class="col-md-2"></div> *@

                <label asp-for="BillDate" class="col-md-2 col-form-label text-start small">Bill Date <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input type="date" asp-for="BillDate" class="form-control form-control-sm" required />
                    <span asp-validation-for="BillDate" class="text-danger"></span>
                </div>

                <label class="col-md-2 ">Billing Type</label>
                <div class="col-md-2">
                    <select asp-for="billingType" id="billingType" class="form-control form-control-sm">
                        <option value="walkin">Cash</option>
                        <option value="registered">Customer</option>
                    </select>
                </div>

                <label class="col-md-2 col-form-label text-start small">Mobile No <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input asp-for="MobileNo" type="text" class="form-control form-control-sm" id="mobilenumber" required />
                    <span asp-validation-for="MobileNo" class="text-danger"></span>
                </div>

                <label class="col-md-2 col-form-label text-start small">Customer <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input asp-for="CustomerName" class="form-control form-control-sm" id="customer" required />
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>

                <label class="col-md-2 col-form-label text-start small">Address <i class="redColor">*</i></label>
                <div class="col-md-2 mt-2 mt-md-0">
                    <input asp-for="Address" id="customeraddress" class="form-control form-control-sm" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
 
                    <label class="col-md-2 col-form-label small">Doctor Mobile No</label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorMobileNumber" class="form-control form-control-sm" id="doctorMobile" />
                    </div>

                    <label class="col-md-2 col-form-label small">Doctor</label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorName" class="form-control form-control-sm" id="doctorname" />
                    </div>

                    <label class="col-md-2 col-form-label small">Registration Number</label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorRegNumber" class="form-control form-control-sm" id="doctorregno" />
                    </div>
                
            </div> 
        </div>

        <!-- Items Table -->
        <div style="overflow-x: auto; width: 100%;">
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table custom-header">
                        <tr>
                            <th style="min-width:30%">Item</th>
                            <th style="min-width:30%">Batch</th>
                            <th class="text-center">Expiry</th>
                            <th class="text-center">Mrp</th>
                            <th class="text-center">Qty</th>
                            <th class="text-center">Rate</th>
                            <th class="text-center">Gst %</th>
                            <th class="text-center">Disc %</th>
                            <th class="text-center">Amount</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="SalesOrderItemBody"></tbody>
                    <tfoot>
                        <tr>
                            <th colspan="8">
                                <u id="addRow" style="color:green; cursor:pointer;">Add Row</u>
                            </th>
                        </tr>
                    </tfoot>
                </table>

                <!-- Totals -->
                <div class="row mt-3">
                    <div class="col-md-7">
                        <strong>Payment Details</strong>
                        <table class="table table-bordered table-striped">
                            <thead class="table custom-header">
                                <tr>
                                    <th style="min-width:30%">Payemnt Mode</th>
                                    <th class="text-center">Amount</th>
                                    <th class="text-center">Reference NO</th>
                                    <th class="text-center">Decritption</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="PaymentDetailsBody">
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="float-start">
                                        <u id="addPaymentRow" style="color:green; text-align:right;   cursor:pointer;">Add Row</u>
                                    </th>
                                </tr>

                            </tfoot>

                        </table>

                    </div>
                    <div class="col-md-5">
                        <div class="row mb-2">
                            <label asp-for="Total" class="col-md-3 col-form-label text-start small">Total</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="Total" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label class="col-md-3 col-form-label text-start small">Bill Discount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-2">
                                <input asp-for="discountPercent" id="discountPercent" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <input asp-for="discountAmount" id="discountamount" class="form-control form-control-sm" placeholder="amount" />
                            </div>

                        </div>
                        <div class="row mb-2">
                            <label asp-for="Totaldiscount" class="col-md-3 col-form-label text-start small">Total Discount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="Totaldiscount" id="Totaldiscount" class="form-control form-control-sm" readonly />
                            </div>

                        </div>
                        <div class="row mb-2">
                            <label asp-for="TotalGstAmt" class="col-md-3 col-form-label text-start small">Gst</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="TotalGstAmt" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="TotalPayable" class="col-md-3 col-form-label text-start small">Total Amount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="TotalPayable" id="totalPayable" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="PaidAmount" class="col-md-3 col-form-label text-start small">Paid Amount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="PaidAmount" id="paidAmout" value="0" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="Balance" class="col-md-3 col-form-label text-start small">Balance</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="Balance" id="balance" value="0" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="ReturnAmount" class="col-md-3 col-form-label text-start small">Return Amount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-4">
                                <input asp-for="ReturnAmount" id="returnAmount" value="0" class="form-control form-control-sm" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Buttons -->
        <div class="mt-3 text-end">
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
            <a asp-controller="SalesOrder" asp-action="Index" class="btn btn-sm btn-secondary">Cancel</a> 
        </div>
    </div>
</form>
<div class="modal fade" id="createCustomerModal" tabindex="-1" aria-labelledby="customerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="newCustomerForm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Name</label>
                        <input type="text" name="Name" class="form-control form-control-sm" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Mobile No</label>
                        <input type="text" name="CustomerMobileNo" id="newCustomerMobile" class="form-control form-control-sm" readonly />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Address</label>
                        <input type="text" name="Address" class="form-control form-control-sm" required />
                    </div>
                    <!-- Add more fields as needed -->
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-sm btn-success">Save Customer</button>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="modal fade" id="createDoctorModal" tabindex="-1" aria-labelledby="createDoctorModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="newDoctorForm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Doctor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="text" name="PhoneNo" id="newDoctorPhone" class="form-control form-control-sm mb-2" placeholder="Phone No" readonly />
                    <input type="text" name="Name" class="form-control form-control-sm mb-2" placeholder="Doctor Name" required />
                    <input type="text" name="Address" class="form-control form-control-sm mb-2" placeholder="Address" />
                    <input type="text" name="RegistrationNo" class="form-control form-control-sm mb-2" placeholder="Registration No" />
                    <input type="text" name="Specialized" class="form-control form-control-sm mb-2" placeholder="Specialization" />
                    <input type="number" name="Commission" class="form-control form-control-sm mb-2" placeholder="Commission %" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-sm btn-success">Save</button>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>
<div class="modal fade" id="batchModal" tabindex="-1" aria-labelledby="batchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Batch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <table id="batchTable" class="table mb-0">
                    <thead class="table-light">
                        <tr><th>Batch No</th><th>Expiry</th><th>Rate</th><th>Mrp</th><th>Qty</th></tr>
                    </thead>
                    <tbody id="batchTableBody">
                        <!-- JS will insert batch rows here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="itemModal" tabindex="-1" aria-labelledby="itemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- 🔍 Search input -->
                <div class="mb-2">
                    <input type="text" id="itemSearch" class="form-control" placeholder="Search by item name..." />
                </div>

                <!-- 📋 Table -->
                <div class="table-responsive">
                    <table id="itemTable" class="table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ItemName</th>
                                <th>Qty</th>
                            </tr>
                        </thead>
                        <tbody id="itemTableBody">
                            <!-- Filled dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="settingsSidebar" style="display:none; position:fixed; top:0; right:0; width:300px; height:100%; background:#f8f9fa; border-left:1px solid #ccc; padding:20px; z-index:1050;">
    <h6>Settings</h6>
    <input type="hidden" id="userId" />
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="toggleDoctor">
        <label class="form-check-label" for="toggleDoctor">Show Doctor Info</label>
    </div>
    <div class="mb-3">
        <label class="form-label d-block">Enable Barcode Based Items</label>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="itemBarCodeBase" id="itemBarCodeYes" value="true">
            <label class="form-check-label" for="itemBarCodeYes">Yes</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="itemBarCodeBase" id="itemBarCodeNo" value="false">
            <label class="form-check-label" for="itemBarCodeNo">No</label>
        </div>
    </div>

    <button type="button" class="btn btn-sm btn-primary" id="saveSidebarSettings">Save</button>
    <button type="button" class="btn btn-sm btn-danger" id="closeSidebar">Close</button>
</div>
<iframe id="reportFrame" style="display:none;"></iframe> 

<!-- Optical Details Modal -->
<div class="modal fade" id="opticalPopup" tabindex="-1" aria-labelledby="opticalPopupLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="opticalPopupLabel">Optical Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <table class="table table-bordered" id="opticalTable">
                    <thead>
                        <tr>
                            <th>Rx</th>
                            <th>Sphere</th>
                            <th>Cylinder</th>
                            <th>Axis</th>
                            <th>Prism</th>
                            <th>Add</th> 
                        </tr>
                    </thead>
                    <tbody id="OpticalDetailsBody">
                        <!-- Rows added dynamically in openOpticalPopup() -->
                    </tbody>
                </table>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="saveOpticalBtn" class="btn btn-primary">Save</button>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script>
        let currentRowForCrossItemModal = false;    //if you are close Item Modal then focus on Curren row Item Column..
        let itemSelected = false;
        let salesOrderSelected = false;
        let isEnterNavigation = false;
        let billingDropdownOpened = false;
    </script>



    <script>
        $("#salesOrderForm").on("submit", function (e) {
            e.preventDefault();
            var form = $(this);
            $.ajax({
                type: "POST",
                url: form.attr("action"),
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        if (confirm("Do you want to print the sales report?")) {
                            const reportUrl = "/Report/SalseOrderReport/" + response.saleId;
                            const iframe = document.getElementById('reportFrame');
                            debugger;

                               iframe.onload = function () {
                                   setTimeout(() => {
                                       iframe.contentWindow.focus();
                                       iframe.contentWindow.print(); 
                                   }, 5000); 
                               };

                            iframe.src = reportUrl;
                        }
                        else{
                             window.location.href = "/SalesOrder/Index";
                        }

                    } else {
                        alert("Save failed!");
                    }
                },
                error: function () {
                    alert("An error occurred.");
                }
            });
        });
    </script>
    
    <script>
        $(document).ready(function () {
           
              $(document).on("blur", "#mobilenumber", function () {

                   let mobileNo = $(this).val();
                   if (mobileNo.length < 10) return; // Simple validation

                   $.ajax({
                       url: '/Sales/GetCustomerByMobile',
                       type: 'GET',
                       data: { mobileNo: mobileNo },
                       success: function (res) {
                           if (res.found) {
                               $('#customer').val(res.data.name);
                               $('#CustomerId').val(res.data.id);
                                $('#customeraddress').val(res.data.address);
                               // Fill other fields if you have them
                               toastr.success("Customer found and auto-filled.");
                           } else {
                               if (confirm("Customer not found! Do you want to create a new one?")) {
                                   $('#createCustomerModal').modal('show');
                                   $('#newCustomerMobile').val(mobileNo); // Pre-fill in modal
                               }
                           }
                       },
                       error: function () {
                           alert("An error occurred while searching for the customer.");
                       }
                   });
              });

               $('#newCustomerForm').submit(function (e) {
                   e.preventDefault();

                   const customerData = {
                       Name: $('#newCustomerForm [name="Name"]').val(),
                       PhoneNo: $('#newCustomerForm [name="CustomerMobileNo"]').val(),
                       Address: $('#newCustomerForm [name="Address"]').val()
                   };

                   $.ajax({
                       url: '/Sales/CreateCustomer',
                       type: 'POST',
                       contentType: 'application/json',
                       data: JSON.stringify(customerData),
                       success: function (res) {
                           if (res.success) {
                               debugger
                               // Fill the parent form fields
                               $('#MobileNo').val(res.data.mobileNo);
                               $('#CustomerId').val(res.data.id);
                               $('#customer').val(res.data.name);
                               $('#customeraddress').val(res.data.address);
                               $('#createCustomerModal').modal('hide');
                               toastr.success("Customer created and auto-filled.");
                           } else {
                               toastr.error("Customer not created.");
                           }
                       },
                       error: function () {
                           toastr.error("Error creating customer.");
                       }
                   });
               });

               $('#doctorMobile').on("blur", function () {
                   const mobile = $(this).val();
                   if (mobile.length < 10) return;

                   $.ajax({
                       url: '/PharmacyDoctor/GetDoctorByMobile',
                       type: 'GET',
                       data: { phoneNo: mobile },
                       success: function (res) {
                           if (res.found) {
                               $('#DoctorId').val(res.data.id);
                                $('#doctorname').val(res.data.name);
                                 $('#doctorregno').val(res.data.registrationNo);
                               toastr.success("Doctor found and assigned.");
                           } else {
                               if (confirm("Doctor not found. Do you want to create a new one?")) {
                                   $('#createDoctorModal').modal('show');
                                   $('#newDoctorPhone').val(mobile);
                               }
                           }
                       },
                       error: function () {
                           alert("Error while searching doctor.");
                       }
                   });
               });

              // AJAX Submit for New Doctor
              $('#newDoctorForm').submit(function (e) {
                  e.preventDefault();

                  const formData = {
                      Name: $('#newDoctorForm [name="Name"]').val(),
                      PhoneNo: $('#newDoctorForm [name="PhoneNo"]').val(),
                      Address: $('#newDoctorForm [name="Address"]').val(),
                      RegistrationNo: $('#newDoctorForm [name="RegistrationNo"]').val(),
                      Specialized: $('#newDoctorForm [name="Specialized"]').val(),
                      Commission: parseFloat($('#newDoctorForm [name="Commission"]').val()) || 0
                  };

                  $.ajax({
                      url: '/PharmacyDoctor/CreateDoctor',
                      type: 'POST',
                      contentType: 'application/json',
                      data: JSON.stringify(formData),
                      success: function (res) {
                          if (res.success) {
                              $('#DoctorId').val(res.data.id); // ✅ Set DoctorId
                               $('#doctorname').val(res.data.name);
                               $('#doctorregno').val(res.data.registrationNo);
                              $('#createDoctorModal').modal('hide');
                              toastr.success("Doctor created and assigned.");
                          } else {
                              toastr.error("Doctor not created.");
                          }
                      },
                      error: function () {
                          toastr.error("Error saving doctor.");
                      }
                  });
              });


              let rowIndex = 0;

              $("#addRow").click(function () {
                  window.addNewRow();
              });

             window.addNewRow = function addNewRow(itemId = "", itemName = "", qty = 1,rate = 0) {
                  let newRow = `
                      <tr>
                      <td hidden>  <input name="SalesOrderItemVMs[${rowIndex}].ItemMasterId" class="form-control form-control-sm item-id" value="${itemId}" /> </td>

                      <td style="min-width:250px;"><input type="text" name="SalesOrderItemVMs[${rowIndex}].ItemBarcodeNumber" class="form-control form-control-sm item-barcode" placeholder="Scan/Enter Barcode" value="${itemName}" required /></td>

                          <td><input name="SalesOrderItemVMs[${rowIndex}].Batch" class="form-control form-control-sm batch" /></td>
                          </td>
                          <td> <input type="text" name="SalesOrderItemVMs[${rowIndex}].Expirydate" class="form-control form-control-sm expirydate"  placeholder="MM/YYYY" maxlength="7" /> </td>
                          <td><input name="SalesOrderItemVMs[${rowIndex}].Mrp" class="form-control form-control-sm mrp" /></td>
                          <td><input name="SalesOrderItemVMs[${rowIndex}].Qty" class="form-control form-control-sm qty" value="${qty}" /></td>
                          <td><input name="SalesOrderItemVMs[${rowIndex}].Rate" class="form-control form-control-sm rate" value="${rate}" /></td>
                          <td><input name="SalesOrderItemVMs[${rowIndex}].Gst" class="form-control form-control-sm gst" readonly /></td>
                          <td><input name="SalesOrderItemVMs[${rowIndex}].Discount" class="form-control form-control-sm discount" /></td>
                          <td><input name="SalesOrderItemVMs[${rowIndex}].Amount" class="form-control form-control-sm Amount" readonly /></td>
                          <td><u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u></td>
                      </tr>`;
                  $("#SalesOrderItemBody").append(newRow);
                  rowIndex++;
             } 
              $(document).on("input", "#itemSearch", function () {
                  const searchText = $(this).val().toLowerCase();
             
                  $("#itemTableBody tr").each(function () {
                      const itemName = $(this).find("td:first").text().toLowerCase();
                      $(this).toggle(itemName.includes(searchText));
                  });



              });
               let currentRow = null;
               let currentBatchIndex = -1;
               let currentItemIndex = -1;
               $(document).on("keypress", ".item-barcode", function (e) {
                   if (e.key === "Enter") {
                       e.preventDefault();
                       currentRow = $(this).closest("tr");
                       const barcode = $(this).val().trim();

                       if (barcode === "") {
                           $.get('/Sales/GetAllItems', function (items) {
                               let rows = "";
                               items.forEach(item => {
                                   rows += `
                                       <tr class="item-row" data-barcode="${item.barcode}" data-itemid="${item.id}" data-name="${item.name}" data-gst ="${item.gst}">
                                           <td>${item.name}</td>
                                           <td>${item.qty}</td>
                                       </tr>`;
                               });

                               $("#itemTableBody").html(rows);
                               $("#itemModal").modal("show");

                           });
                       }
