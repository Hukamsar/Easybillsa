<script>
    $(document).on("keydown", ".item-barcode", function (e) {
        const row = $(this).closest("tr");

        if (e.key === "ArrowRight") {
            e.preventDefault();

            // BusinessType 2 + TabletWise → Focus on .tablet-qty
            if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                row.find(".tablet-qty").focus().select();
            } else {
                row.find(".qty").focus().select();
            }
            return;
        }

        if (e.key === "ArrowDown") {
            e.preventDefault();
            const nextRow = row.next("tr");
            if (nextRow.length) {
                nextRow.find(".item-barcode").focus();
            }
            return;
        }

        if (e.key === "ArrowUp") {
            e.preventDefault();
            const prevRow = row.prev("tr");
            if (prevRow.length) {
                prevRow.find(".item-barcode").focus();
            }
        }
    });

    $(document).on("keydown", ".qty, .tablet-qty, .stripe-rate, .rate, .discount", function (e) {
        const row = $(this).closest("tr");
        const input = $(this);

        const isQty = input.hasClass("qty");
        const isTabletQty = input.hasClass("tablet-qty");
        const isRate = input.hasClass("rate");
        const isStripeRate = input.hasClass("stripe-rate");
        const isDiscount = input.hasClass("discount");

        // ================================================================
        // ENTER KEY NAVIGATION
        // ================================================================
        if (e.key === "Enter") {
            e.preventDefault();

            // BusinessType 2 + TabletWise Mode
            if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                if (isTabletQty) {
                    //row.find(".rate").focus().select();
                    row.find(".stripe-rate").focus().select();
                    } else if (isStripeRate) {
                    row.find(".discount").focus().select();
                } else if (isDiscount) {
                    handleDiscountEnter(row);
                }
            }
            // StripWise Mode (Default)
            else {
                if (isQty) {
                  //  row.find(".rate").focus().select();
                      row.find(".stripe-rate").focus().select();
                    } else if (isStripeRate) {
                    row.find(".discount").focus().select();
                } else if (isDiscount) {
                    handleDiscountEnter(row);
                }
            }
            return;
        }

        // ================================================================
        // ARROW RIGHT NAVIGATION
        // ================================================================
        if (e.key === "ArrowRight") {
            e.preventDefault();

            // BusinessType 2 + TabletWise Mode
            if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                if (isTabletQty) {
                   // row.find(".rate").focus().select();
                      row.find(".stripe-rate").focus().select();
                    } else if (isStripeRate) {
                    row.find(".discount").focus().select();
                }
            }
            // StripWise Mode (Default)
            else {
                if (isQty) {
                  //  row.find(".rate").focus().select();
                     row.find(".stripe-rate").focus().select();
                    } else if (isStripeRate) {
                    row.find(".discount").focus().select();
                }
            }
            return;
        }

        // ================================================================
        // ARROW LEFT NAVIGATION
        // ================================================================
        if (e.key === "ArrowLeft") {
            e.preventDefault();

            // BusinessType 2 + TabletWise Mode
            if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                if (isDiscount) {
                  //  row.find(".rate").focus().select();
                       row.find(".stripe-rate").focus().select();
                    } else if (isStripeRate) {
                    row.find(".tablet-qty").focus().select();
                } else if (isTabletQty) {
                    row.find(".item-barcode").focus();
                }
            }
            // StripWise Mode (Default)
            else {
                if (isDiscount) {
                  //  row.find(".rate").focus().select();
                       row.find(".stripe-rate").focus().select();
                } else if (isStripeRate) {
                    row.find(".qty").focus().select();
                } else if (isQty) {
                    row.find(".item-barcode").focus();
                }
            }
            return;
        }

        // ================================================================
        // ARROW DOWN NAVIGATION
        // ================================================================
        if (e.key === "ArrowDown") {
            e.preventDefault();
            const nextRow = row.next("tr");
            if (!nextRow.length) return;

            if (isQty) {
                nextRow.find(".qty").focus().select();
            } else if (isTabletQty) {
                nextRow.find(".tablet-qty").focus().select();
                } else if (isStripeRate) {
               // nextRow.find(".rate").focus().select();
                nextRow.find(".stripe-rate").focus().select();
            } else if (isDiscount) {
                nextRow.find(".discount").focus().select();
            }
            return;
        }

        // ================================================================
        // ARROW UP NAVIGATION
        // ================================================================
        if (e.key === "ArrowUp") {
            e.preventDefault();
            const prevRow = row.prev("tr");
            if (!prevRow.length) return;

            if (isQty) {
                prevRow.find(".qty").focus().select();
            } else if (isTabletQty) {
                prevRow.find(".tablet-qty").focus().select();
                } else if (isStripeRate) {
                    prevRow.find(".stripe-rate").focus().select();
              //  prevRow.find(".rate").focus().select();
            } else if (isDiscount) {
                prevRow.find(".discount").focus().select();
            }
        }
    });

    // ================================================================
    // HELPER FUNCTION - DISCOUNT ENTER KEY LOGIC
    // ================================================================
    function handleDiscountEnter(row) {
        const itemId = row.find(".item-barcode").val();
        const batch = row.find(".batch").val();

        if (!itemId || !batch) {
            toastr.warning("Please select Item and Batch before adding new row.");
            if (!itemId) {
                row.find(".item-barcode").focus();
            } else if (!batch) {
                row.find(".item-barcode").focus();
            }
            return;
        }

        // VALIDATE QUANTITY (TabletWise vs StripWise)
        const $qtyInput = row.find(".qty");
        const qty = parseFloat($qtyInput.val()) || 0;

        if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
            // TabletWise Mode: Check both Qty and TabletQty
            const $qtyTabsInput = row.find(".tablet-qty");
            const qtyTabs = parseFloat($qtyTabsInput.val()) || 0;

            if (qty === 0 && qtyTabs === 0) {
                toastr.warning("Please enter quantity or tablet quantity.");
                $qtyTabsInput.focus().select();
                return;
            }

            if (qty < 0 || qtyTabs < 0) {
                toastr.warning("Quantity cannot be negative.");
                (qty < 0 ? $qtyInput : $qtyTabsInput).focus().select();
                return;
            }
        } else {
            // StripWise Mode: Qty must be >= 1
            if (qty < 1) {
                toastr.warning("Quantity cannot be less than 1.");
                $qtyInput.focus().select();
                return;
            }
        }

        const isLastRow = row.is("#SalesOrderItemBody tr:last");

        if (isLastRow) {
            addNewRow();
            setTimeout(() => {
                $("#SalesOrderItemBody tr:last .item-barcode").focus();
            }, 150);
        } else {
            const nextRow = row.next("tr");
            if (nextRow.length) {
                nextRow.find(".item-barcode").focus();
            }
        }
    }

