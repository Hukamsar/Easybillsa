@using EasyBill.Models.ViewModels
@model SalesOrderVM
@{
    ViewData["Title"] = "Create Sales Order";
}
<link href="~/css/page.css" rel="stylesheet" />
<style>
    /* ===============================
               SETTINGS SIDEBAR
               =============================== */
    #settingsSidebar {
        box-shadow: -3px 0 5px rgba(0,0,0,0.2);
    }

    /* ===============================
               TOGGLE SWITCH
               =============================== */
    .switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 24px;
    }

        .switch input {
            display: none;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 24px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #28a745;
    }

        input:checked + .slider:before {
            transform: translateX(26px);
        }

    .slider.round {
        border-radius: 24px;
    }

    /* ===============================
               OFFER TABLE
               =============================== */
    #offerTable tbody tr:focus {
        background-color: #198754 !important;
        color: #0d6efd;
        border: 2px solid green;
        outline: none;
    }

</style>
<style>
    /* ===============================
               GENERAL TABLE ROW SELECTION
               =============================== */
    tr.selected {
        background-color: #d2e3fc;
        border: 2px solid green;
    }

    /* ===============================
               ITEM MODAL - LAYOUT
               =============================== */
    #itemModal .modal-dialog {
        max-height: 90vh;
    }

    #itemModal .modal-content {
        max-height: 90vh;
        display: flex;
        flex-direction: column;
    }

    /* ===============================
               ITEM MODAL - HEADER
               =============================== */
    #itemModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #itemModal .modal-header .btn-close {
            filter: invert(1);
        }

    /* ===============================
               ITEM MODAL - BODY
               =============================== */
    #itemModal .modal-body {
        padding: 1rem;
        display: flex;
        flex-direction: column;
    }

    /* ===============================
               ITEM MODAL - TABLE WRAPPER
               =============================== */
    .item-table-wrapper {
        min-height: 50px;
        max-height: 350px;
        overflow-y: auto;
    }

        .item-table-wrapper::-webkit-scrollbar {
            width: 6px;
        }

        .item-table-wrapper::-webkit-scrollbar-thumb {
            background: #adb5bd;
            border-radius: 4px;
        }

    /* SalesOrder item dropdown F2/F3 links use the same compact action style as Sales. */
    .shortcut-link {
        font-size: 11px;
        color: #2465c7;
        cursor: pointer;
        text-decoration: none;
        font-weight: 600;
    }

        .shortcut-link:hover {
            text-decoration: underline;
        }

        .shortcut-link.text-danger {
            color: #dc3545;
        }

    /* ===============================
               ITEM MODAL - TABLE HEADER
               =============================== */
    #itemTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* ===============================
               ITEM MODAL - ROW SELECTION
               =============================== */
    .item-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    .item-row:focus {
        outline: none;
    }

    .item-row {
        scroll-margin-top: 50px;
    }

    /* ===============================
               ITEM MODAL - KEYBOARD MODE
               =============================== */
    #itemModal.keyboard-nav .item-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* ===============================
               ITEM MODAL - MOUSE MODE
               =============================== */
    #itemModal.mouse-nav .item-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    /* ===============================
               CUSTOMER LIST MODAL STYLING
               =============================== */
    #customerListModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #customerListModal .modal-header .btn-close {
            filter: invert(1);
        }

    .customer-table-wrapper {
        min-height: 50px;
        max-height: 350px;
        overflow-y: auto;
    }

    #customerTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        z-index: 2;
    }

    .customer-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    #customerListModal.keyboard-nav .customer-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #customerListModal.mouse-nav .customer-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .customer-row {
        scroll-margin-top: 50px;
    }

        .customer-row:focus {
            outline: none;
        }

</style>
<style>
    /* ===============================
               BATCH MODAL - HEADER
               =============================== */
    #batchModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #batchModal .modal-header .btn-close {
            filter: invert(1);
