                $(this).removeClass("is-invalid");
                $(".field-error[data-field='Name']").addClass("d-none").text("");
            }
        });
    </script>

    <!-- ================================================================
         🔹 GLOBAL END KEY SAVE HANDLER
         ================================================================ -->
    <script>
        $(document).on("keydown", function (e) {
            if (e.key !== "End") return;

            e.preventDefault();
            e.stopImmediatePropagation();

            const itemRows = $("#SalesOrderItemBody tr").length;

            if (itemRows === 0) {
                addNewRow();
                setTimeout(() => {
                    $("#SalesOrderItemBody tr:first .item-barcode").focus().select();
                }, 150);
                toastr.warning("Please add at least one item before saving.");
                return;
            }

            $("#salesOrderForm").trigger("submit");
        });
    </script>

    <!-- ================================================================
         🔹 FORM SUBMIT HANDLER (WITH VALIDATION)
         ================================================================ -->
    <script>
        $("#salesOrderForm").on("submit", function (e) {
            e.preventDefault();

            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: 3000,
                extendedTimeOut: 1000,
                preventDuplicates: true
            };

            const mobile = ($("#mobilenumber").val() || "").trim();
            const customerName = ($("#customer").val() || "").trim();

            if (!mobile) {
                toastr.error("Mobile number is required.", "Mobile Required");
                $("#mobilenumber").focus().select();
                return false;
            }

            if (!isValidIndianMobile(mobile)) {
                toastr.error("Please enter a valid 10-digit mobile number.", "Invalid Mobile Number");
                $("#mobilenumber").focus().select();
                return false;
            }

            if (!customerName) {
                toastr.error("Customer name is required.", "Customer Required");
                $("#customer").focus().select();
                return false;
            }

            let hasValidItemRow = false;
            let firstZeroQtyRow = null;
            let firstIncompleteRow = null;

            $("#SalesOrderItemBody tr").each(function () {
                const row = $(this);
                const itemBarcode = (row.find(".item-barcode").val() || "").trim();
                const batch = (row.find(".batch").val() || "").trim();
                const qty = parseFloat(row.find(".qty").val()) || 0;
            
                if (itemBarcode && !batch && !firstIncompleteRow) {
                    firstIncompleteRow = row;
                }
            
                // TabletWise: Check both Qty and TabletQty
                if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                    const tabletQty = parseFloat(row.find(".tablet-qty").val()) || 0;
            
                    if (itemBarcode && qty === 0 && tabletQty === 0 && !firstZeroQtyRow) {
                        firstZeroQtyRow = row;
                    }
            
                    if (itemBarcode && batch && (qty > 0 || tabletQty > 0)) {
                        hasValidItemRow = true;
                    }
                } else {
                    // StripWise: Only check Qty
                    if (itemBarcode && qty <= 0 && !firstZeroQtyRow) {
                        firstZeroQtyRow = row;
                    }
            
                    if (itemBarcode && batch && qty > 0) {
                        hasValidItemRow = true;
                    }
                }
            });

            if (firstIncompleteRow) {
                toastr.error("Please select batch for all items or remove incomplete rows.", "Incomplete Item Row");
                firstIncompleteRow.find(".item-barcode").focus().select();
                return false;
            }

            // if (firstZeroQtyRow) {
            //     toastr.error("Quantity must be at least 1. Please enter valid quantity.", "Invalid Quantity");
            //     firstZeroQtyRow.find(".qty").focus().select();
            //     return false;
            // }

            // TabletWise: Allow Qty = 0 if TabletQty > 0
            if (firstZeroQtyRow) {
                if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                    const tabletQty = parseFloat(firstZeroQtyRow.find(".tablet-qty").val()) || 0;
            
                    if (tabletQty === 0) {
                        toastr.error("Please enter quantity or tablet quantity.", "Invalid Quantity");
                        firstZeroQtyRow.find(".tablet-qty").focus().select();
                        return false;
                    }
                } else {
                    toastr.error("Quantity must be at least 1. Please enter valid quantity.", "Invalid Quantity");
                    firstZeroQtyRow.find(".qty").focus().select();
                    return false;
                }
            }

            if (!hasValidItemRow) {
                toastr.error("Please add at least one item with quantity before saving.", "Item Required");
                const firstRow = $("#SalesOrderItemBody tr:first");
                if (firstRow.length) {
                    firstRow.find(".item-barcode").focus().select();
                }
                return false;
            }

            var form = $(this);

            confirmSave(function (ok) {
                if (!ok) return;

                $.ajax({
                    type: "POST",
                    url: form.attr("action"),
                    data: form.serialize(),
                    success: function (response) {


                        // if (!response.success) {
                        //     toastr.error("Save failed! Please try again.", "Error");
                        //     return;
                        // }

                        // Check for error message in response
                        if (!response.success) {
                            const errorMsg = response.message || "Save failed! Please try again.";
                            toastr.error(errorMsg, "Error");
                            return;
                        }

                        Swal.fire({
                            title: 'Sales Order Action',
                            text: 'What do you want to do with the sales order? (Press Esc to skip)',
                            icon: 'question',
                            showConfirmButton: true,
                            showDenyButton: true,
                            showCancelButton: true,
                            confirmButtonText: '🖨️ Print',
                            denyButtonText: '👁️ Preview',
                            cancelButtonText: '❌ Skip',
                            confirmButtonColor: '#0d6efd',
                            denyButtonColor: '#198754',
                            cancelButtonColor: '#6c757d',
                            reverseButtons: true,
                            allowEscapeKey: true,
                            allowOutsideClick: false
                        }).then((result) => {
                            const reportUrl = "/Report/SalseOrderReport/" + response.saleId;

                            if (result.dismiss === Swal.DismissReason.cancel || result.dismiss === Swal.DismissReason.esc) {
                                resetSalesOrderForm();
                                window.location.href = "/SalesOrder/Create";
                                return;
                            }

                            if (result.isDenied) {
                                window.open(reportUrl, "_blank");
                                resetSalesOrderForm();
                                window.location.href = "/SalesOrder/Create";
                                return;
                            }

                            if (result.isConfirmed) {
                                const iframe = document.getElementById("reportFrame");
                                iframe.onload = function () {
                                    waitingForFocusAfterPrint = true;
                                    iframe.contentWindow.focus();
                                    iframe.contentWindow.print();
                                };
                                iframe.src = reportUrl;
                                resetSalesOrderForm();
                            }
                        });

                        //resetSalesOrderForm();
                    },
                    error: function(xhr, status, error) {
                        hideLoader(); // Hide loader
                        console.error("Save Error:", xhr, error);

                        // Extract actual error message from server response
                        let errorMessage = "An error occurred while saving. Please try again.";

                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            try {
                                const response = JSON.parse(xhr.responseText);
                                errorMessage = response.message || errorMessage;
                            } catch (e) {
                                errorMessage = xhr.responseText;
                            }
                        } else if (xhr.status === 400) {
                            errorMessage = "Invalid data submitted. Please check all fields.";
                        }

                        toastr.error(errorMessage, "Server Error");
                    }
                });
            });
        });
    </script>

    <!-- ================================================================
         🔹 SETTINGS SIDEBAR
         ================================================================ -->
    <script>
        $(document).ready(function () {
            // LOAD SETTINGS ON PAGE LOAD
            loadSalesOrderSettings();
            
            // SETTINGS BUTTON CLICK
            $('#settingsBtn').click(function () {
                $('#settingsSidebar').show();
            });

            // LOAD SETTINGS FUNCTION (Reusable)
            function loadSalesOrderSettings() {
                $.ajax({
                    url: '/SalseSetting/GetSidebarSettings',
                    type: 'GET',
                    success: function (data) {
                        // ✅ SET GLOBAL FLAGS
                        isTabletWiseMode = (data.itemConversion === "TabletWise");
            
                        // APPLY SETTINGS TO FORM
                        $('#toggleDoctor').prop('checked', data.doctorRequired);
                        $('#userId').val(data.applicationUserId);
                        $('#doctorSection').toggle(data.doctorRequired);
                        $('#itemBarCodeYes').prop('checked', data.itemBarCodeBase === true);
                        $('#itemBarCodeNo').prop('checked', data.itemBarCodeBase !== true);
                        $('#tabletWise').prop('checked', data.itemConversion === "TabletWise");
                        $('#stripWise').prop('checked', data.itemConversion === "StripWise");
                        $("#rateRoundUpToggle").prop("checked", data.rateRoundUp === true);
            
                        console.log("✅ Settings Loaded:", {
                            tabletWise: isTabletWiseMode
                        });
            
                        // ✅ APPLY TO EXISTING ROWS
                        $("#SalesOrderItemBody tr").each(function() {
                            applyTabletWiseMode($(this));
                        });
                    },
                    error: function () {
                        console.error("❌ Could not load settings");
                    }
                });
            }

            $('#saveSidebarSettings').click(function () {
                const isChecked = $('#toggleDoctor').is(':checked');
                const userId = $('#userId').val();
                const itemBarCodeBase = $('input[name="itemBarCodeBase"]:checked').val() === 'true';
                const itemConversion = $('input[name="ItemConversion"]:checked').val();
                let rateRoundUp = $("#rateRoundUpToggle").is(":checked");

                $.ajax({
                    url: '/SalseSetting/SaveSidebarSettings',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        applicationUserId: userId,
                        doctorRequired: isChecked,
                        itemBarCodeBase: itemBarCodeBase,
                        itemConversion: itemConversion,
                        RateRoundUp: rateRoundUp
                    }),
                    success: function () {
                        alert('Settings saved successfully.');
                        $('#doctorSection').toggle(isChecked);
                    },
                    error: function () {
                        alert('Failed to save settings.');
                    }
                });
            });

            $('#closeSidebar').click(function () {
                $('#settingsSidebar').hide();
            });
        });
    </script>

    <!-- ================================================================
         🔹 CUSTOMER & DOCTOR MANAGEMENT
         ================================================================ -->
    <script>
        $(document).on("blur", "#mobilenumber", function () {
            if (isCustomerCheckInProgress) return;
            isCustomerCheckInProgress = true;

            let mobileNo = $(this).val();

            if (!isValidIndianMobile(mobileNo)) {
                showPhoneError("Enter a valid 10-digit mobile number");
                isCustomerCheckInProgress = false;
                return;
            }

            $.ajax({
                url: '/Sales/GetCustomerByMobile',
                type: 'GET',
                data: { mobileNo: mobileNo },
                success: function (res) {
                    if (res.found) {
                        $('#customer').val(res.data.name);
                        $('#CustomerId').val(res.data.id);
                        $('#customeraddress').val(res.data.address);
                        toastr.success("Customer found and auto-filled.");
                    } else {
                        Swal.fire({
                            title: 'Customer Not Found',
                            text: 'Do you want to create a new customer?',
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonText: 'Yes, Create',
                            cancelButtonText: 'No',
                            confirmButtonColor: '#198754',
                            cancelButtonColor: '#dc3545',
                            reverseButtons: true
                        }).then((result) => {
                            if (result.isConfirmed) {
                                setTimeout(() => {
                                    $('#createCustomerModal').modal('show');
                                    $('#newCustomerMobile').val(mobileNo);
                                }, 0);
                            }
                        });
                    }
                },
                error: function () {
                    toastr.error("An error occurred while searching for the customer.");
                },
                complete: function () {
                    isCustomerCheckInProgress = false;
                }
            });
        });

        $('#newCustomerForm').submit(function (e) {
            e.preventDefault();

            const accountGroupId = $('#newCustomerForm [name="AccountGroupId"]').val();
            const stateCode = $('#StateCodeHidden').val();
            const category = $('#newCustomerForm [name="Category"]').val();

            const customerData = {
                Name: $('#newCustomerForm [name="Name"]').val(),
                PhoneNo: $('#newCustomerForm [name="CustomerMobileNo"]').val(),
                Address: $('#newCustomerForm [name="Address"]').val(),
                Email: $('#newCustomerForm [name="Email"]').val(),
                PaymentDays: parseInt($('#newCustomerForm [name="PaymentDays"]').val() || "0"),
                Status: parseInt($('#newCustomerForm [name="Status"]').val() || "1"),
                AccountGroupId: accountGroupId ? parseInt(accountGroupId) : null,
                GSTNo: $('#newCustomerForm [name="GSTNo"]').val(),
                StateCode: stateCode ? parseInt(stateCode) : null,
                GSTType: parseInt($('#GSTTypeHidden').val() || "2"),
                Category: category ? parseInt(category) : null
            };

            $.ajax({
                url: '/Sales/CreateCustomer',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(customerData),
                success: function (res) {
                    if (res.success) {
                        $('#mobilenumber').val(res.data.phoneNo);
                        $('#CustomerId').val(res.data.id);
                        $('#customer').val(res.data.name);
                        $('#customeraddress').val(res.data.address);
                        $('#createCustomerModal').modal('hide');
                        toastr.success("Customer created and auto-filled.");

                        // Focus Customer Name AFTER modal fully closes
                        $('#createCustomerModal').one('hidden.bs.modal', function () {
                            setTimeout(() => {
                                $("#customer").focus().select();
                            }, 100);
                        });

                    } else {
                        toastr.error("Customer not created.");
                    }
                },
                error: function (xhr) {
                    if (xhr.responseJSON) {
                        if (xhr.responseJSON.errors) {
                            Object.keys(xhr.responseJSON.errors).forEach(key => {
                                $(`.field-error[data-field="${key}"]`)
                                    .text(xhr.responseJSON.errors[key][0]);
                            });
                        } else if (xhr.responseJSON.message) {
                            toastr.error(xhr.responseJSON.message);
                        }
                    } else {
                        toastr.error("Something went wrong.");
                    }
                }
            });
        });

        $('#doctorMobile').on("blur", function () {
            const mobile = $(this).val();
            if (mobile.length < 10) return;

            $.ajax({
                url: '/PharmacyDoctor/GetDoctorByMobile',
                type: 'GET',
                data: { phoneNo: mobile },
                success: function (res) {
                    if (res.found) {
                        $('#DoctorId').val(res.data.id);
                        $('#doctorname').val(res.data.name);
                        $('#doctorregno').val(res.data.registrationNo);
                        toastr.success("Doctor found and assigned.");
                    } else {
                        if (confirm("Doctor not found. Do you want to create a new one?")) {
                            $('#createDoctorModal').modal('show');
                            $('#newDoctorPhone').val(mobile);
                        }
                    }
                },
                error: function () {
                    alert("Error while searching doctor.");
                }
            });
        });

        $('#newDoctorForm').submit(function (e) {
            e.preventDefault();

            const formData = {
                Name: $('#newDoctorForm [name="Name"]').val(),
                PhoneNo: $('#newDoctorForm [name="PhoneNo"]').val(),
                Address: $('#newDoctorForm [name="Address"]').val(),
                RegistrationNo: $('#newDoctorForm [name="RegistrationNo"]').val(),
                Specialized: $('#newDoctorForm [name="Specialized"]').val(),
                Commission: parseFloat($('#newDoctorForm [name="Commission"]').val()) || 0
            };

            $.ajax({
                url: '/PharmacyDoctor/CreateDoctor',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        $('#DoctorId').val(res.data.id);
                        $('#doctorname').val(res.data.name);
                        $('#doctorregno').val(res.data.registrationNo);
                        $('#createDoctorModal').modal('hide');
                        toastr.success("Doctor created and assigned.");
                    } else {
                        toastr.error("Doctor not created.");
                    }
                },
                error: function () {
                    toastr.error("Error saving doctor.");
                }
            });
        });

        $('#createCustomerModal').on('shown.bs.modal', function () {
            isCustomerModalOpen = true;
            $(this).find("input[name='Name']").focus();
        });

        $('#createCustomerModal').on('hidden.bs.modal', function () {
            isCustomerModalOpen = false;
        });
    </script>

    <!-- ================================================================
         🔹 CUSTOMER F1 LIST
         ================================================================ -->
    <script>
        $(document).on("click", "#btnF1CustomerList", function (e) {
            e.preventDefault();

            showLoader("Loading customers...");

            $.get('/Sales/GetCustomer', function (res) {
                hideLoader();

                if (!res.found || !res.data || res.data.length === 0) {
                    toastr.info("No customer found.");
                    return;
                }

                let rows = "";

                res.data.forEach(customer => {
                    const customerId = customer.id || customer.Id || "";
                    const customerName = customer.name || customer.Name || "";
                    const mobileNo = customer.phoneNo || customer.PhoneNo || "";
                    const address = customer.address || customer.Address || "";

                    rows += `<tr class="customer-row" tabindex="0"
                        data-customerid="${customerId}"
                        data-name="${customerName}"
                        data-phone="${mobileNo}"
                        data-address="${address}">
                        <td>${customerName}</td>
                        <td>${mobileNo}</td>
                    </tr>`;
                });

                $("#customerTableBody").html(rows);
                $("#customerSearch").val("");
                currentCustomerIndex = -1;
                $("#customerListModal").modal("show");
            }).fail(function () {
                hideLoader();
                toastr.error("Error loading customers");
            });
        });

        $(document).on("keydown", "#mobilenumber", function (e) {
            if (e.key !== "F1") return;

            e.preventDefault();
            e.stopImmediatePropagation();

            $("#btnF1CustomerList").trigger("click");
        });

        $(document).on("input", "#customerSearch", function () {
            const searchText = $(this).val().toLowerCase().trim();

            $("#customerTableBody tr").each(function () {
                const customerName = ($(this).data("name") || "").toString().toLowerCase();
                const mobileNo = ($(this).data("phone") || "").toString().toLowerCase();

                $(this).toggle(customerName.includes(searchText) || mobileNo.includes(searchText));
            });

            currentCustomerIndex = -1;
            $("#customerTableBody .customer-row").removeClass("selected");
        });

        $(document).on("keydown", function (e) {
            if (!$("#customerListModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                customerNavMode = "keyboard";
                isKeyboardScrollingCustomerModal = true;
                $("#customerListModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".customer-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentCustomerIndex === -1) {
                    currentCustomerIndex = 0;
                }
                else if (currentCustomerIndex < $rows.length - 1) {
                    currentCustomerIndex++;
                }

                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();

                if (currentCustomerIndex <= 0) return;

                currentCustomerIndex--;

                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
            else if (e.key === "Enter") {
                e.preventDefault();

                if (currentCustomerIndex === -1) {
                    currentCustomerIndex = 0;
                }

                $rows.eq(currentCustomerIndex).trigger("click");
            }
        });

        $(document).on("click", ".customer-row", function (e) {
            e.preventDefault();

            const customerId = $(this).data("customerid");
            const customerName = $(this).data("name") || "";
            const mobileNo = $(this).data("phone") || "";
            const address = $(this).data("address") || "";

            $("#mobilenumber, #customer, #customeraddress").prop("disabled", false);
            $("#CustomerId").val(customerId);
            $("#mobilenumber").val(mobileNo);
            $("#customer").val(customerName);
            $("#customeraddress").val(address);

            hidePhoneError();
            $("#customerListModal").modal("hide");

            setTimeout(() => {
                $("#customer").focus().select();
            }, 150);
        });

        $(document).on("mouseenter", ".customer-row", function () {
            if (!$("#customerListModal").is(":visible")) return;
            if (isKeyboardScrollingCustomerModal) return;

            customerNavMode = "mouse";

            $("#customerListModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".customer-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentCustomerIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#customerListModal", function () {
            isKeyboardScrollingCustomerModal = false;
        });

        $('#customerListModal').on('shown.bs.modal', function () {
            customerNavMode = "keyboard";

            $("#customerListModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".customer-row:visible");

            currentCustomerIndex = -1;

            if ($rows.length) {
                currentCustomerIndex = 0;
                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }

            setTimeout(() => {
                $("#customerSearch").focus().select();
            }, 200);
        });

        $('#customerListModal').on('hidden.bs.modal', function () {
            currentCustomerIndex = -1;
            $("#customerTableBody .customer-row").removeClass("selected");
        });
    </script>

    <!-- ================================================================
         🔹 ITEM MODAL - COMPLETE FUNCTIONALITY
         ================================================================ -->
    <script>
        function openItemSearchModal(searchText = "") {
            // Keep item dropdown closed while SalesOrder embedded Item Master popup is opening/saving.
            if (window.stopAutoItemOpen === true || $("#itemMasterModal").is(":visible")) {
                return;
            }

            showLoader(); // ✅ Show loader

            $.get('/SalesOrder/GetAllItems', function (items) {
                hideLoader(); // ✅ Hide loader

                if (!items || items.length === 0) {
                    toastr.warning("No items found.");
                    return;
                }

                const businessType = @ViewBag.BusinessType;

                let rows = renderSalesOrderItemRows(items, businessType);

                $("#itemTableBody").html(rows);
                $("#itemSearch").val(searchText);
                $("#itemSearch").trigger("input");
                $("#itemModal").modal("show");
            }).fail(function () {
                hideLoader(); // ✅ Hide loader on error
                toastr.error("Error loading items");
            });
        }

        function renderSalesOrderItemRows(items, businessType) {

            let rows = "";

            items.forEach(item => {

                rows += `<tr class="item-row" tabindex="0"
                    data-barcode="${item.barcode}"
                    data-itemid="${item.id}"
                    data-name="${item.name}"
                    data-gst="${item.gst}"
                    data-cess="${item.cess}"
                    data-qty="${item.qty}"
                    data-maxdiscount="${item.maximumdiscount}"
                    data-conversion="${item.conversion || 1}">
                    <td>${item.name}</td>
                    ${
                        businessType === 2
                        ? `
                            <td style="display:none;">${item.qty}</td>
                            <td>${item.displayQty}</td>
                          `
                        : `
                            <td>${item.qty}</td>
                          `
                    }
                </tr>`;
            });

            return rows;
        }

        // ✅ ITEM SEARCH - WORD-BY-WORD MATCHING
        $(document).on("input", "#itemSearch", function () {
            const searchWords = $(this).val()
                .toLowerCase()
                .trim()
                .split(/\s+/);

            $("#itemTableBody tr").each(function () {
                const itemText = $(this).find("td:first").text().toLowerCase();
                const itemWords = itemText.split(/\s+/);

                let match = true;

                for (let i = 0; i < searchWords.length; i++) {
                    if (!itemWords[i] || !itemWords[i].startsWith(searchWords[i])) {
                        match = false;
                        break;
                    }
                }

                $(this).toggle(match);
            });

            // ✅ RESET SELECTION AFTER SEARCH
            currentItemIndex = -1;
            $("#itemTableBody .item-row").removeClass("selected");

            // ✅ AUTO-SELECT FIRST VISIBLE ROW
            const $visibleRows = $("#itemTableBody .item-row:visible");
            if ($visibleRows.length > 0) {
                currentItemIndex = 0;
                highlightItemRow($visibleRows, 0);
            }
        });

        // // ✅ ITEM ROW CLICK
        // $(document).on("click", ".item-row", function (e) {
        //     e.preventDefault();

        //     const itemId = $(this).data("itemid");
        //     const itemName = $(this).data("name");
        //     const gst = $(this).data("gst");
        //     const maxDiscount = parseFloat($(this).data("maxdiscount")) || 0;

        //     if (!itemId || !currentRow) return;

        //     currentRow.find(".item-barcode").val(itemName);
        //     currentRow.find(".item-id").val(itemId);
        //     currentRow.find(".gst").val(gst);
        //     currentRow.attr("data-max-discount", maxDiscount);

        //     itemMaxDiscounts[itemId] = maxDiscount;

        //     calculateRow(currentRow);
        //     $("#itemModal").modal("hide");

        //     processItemId(itemId);
        // });

        $(document).on("click", ".item-row", function (e) {
            e.preventDefault();

            const itemId = $(this).data("itemid");
            const itemName = $(this).data("name");
            const gst = $(this).data("gst");
            const cess = $(this).data("cess");
            const maxDiscount = parseFloat($(this).data("maxdiscount")) || 0;
            const conversion = parseFloat($(this).data("conversion")) || 1; // ✅ NEW

            if (!itemId || !currentRow) return;

            currentRow.find(".item-barcode").val(itemName);
            currentRow.find(".item-id").val(itemId);
            currentRow.find(".gst").val(gst);
            currentRow.find(".cess").val(cess);
            currentRow.attr("data-max-discount", maxDiscount);
            currentRow.attr("data-conversion", conversion); // ✅ NEW

            itemMaxDiscounts[itemId] = maxDiscount;
            itemConversionMap[itemId] = conversion; // ✅ GLOBAL STORE

            calculateRow(currentRow);
            $("#itemModal").modal("hide");

            processItemId(itemId);
        });

        // ✅ ITEM MODAL - KEYBOARD NAVIGATION (FIXED)
        $(document).on("keydown", function (e) {
            if (!$("#itemModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                itemNavMode = "keyboard";
                isKeyboardScrollingItemModal = true;
                $("#itemModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".item-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentItemIndex === -1) {
                    currentItemIndex = 0;
                }
                else if (currentItemIndex < $rows.length - 1) {
                    currentItemIndex++; // ✅ INCREMENT BY 1
                }

                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();

                if (currentItemIndex <= 0) {
                    // Already at top, do nothing
                    return;
                }

                currentItemIndex--;
                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "Enter" && currentItemIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentItemIndex).trigger("click");
            }
        });

        function highlightItemRow($rows, index) {
            $rows.removeClass("selected");
            const $row = $rows.eq(index);
            $row.addClass("selected");

            // Smart scroll - NO GAP
            const container = document.querySelector("#itemModal .item-table-wrapper");
            if (!container || !$row[0]) return;

            const rowRect = $row[0].getBoundingClientRect();
            const containerRect = container.getBoundingClientRect();
            const headerHeight = document.querySelector("#itemTable thead")?.offsetHeight || 40;

            // If row is ABOVE sticky header → Scroll UP (NO GAP)
            if (rowRect.top < containerRect.top + headerHeight) {
                container.scrollTop -= (containerRect.top + headerHeight - rowRect.top);
            }
            // If row is BELOW visible area → Scroll DOWN (NO GAP)
            else if (rowRect.bottom > containerRect.bottom) {
                container.scrollTop += (rowRect.bottom - containerRect.bottom);
            }
        }

        // ITEM MODAL - MOUSE HOVER
        $(document).on("mouseenter", ".item-row", function () {
            if (!$("#itemModal").is(":visible")) return;
            if (isKeyboardScrollingItemModal) return;

            itemNavMode = "mouse";

            $("#itemModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".item-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentItemIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#itemModal", function () {
            isKeyboardScrollingItemModal = false;
        });

        $('#itemModal').on('shown.bs.modal', function () {
            itemNavMode = "keyboard";

            $("#itemModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".item-row:visible");

            currentItemIndex = -1;

            if ($rows.length > 0) {
                currentItemIndex = 0;
                highlightItemRow($rows, 0);
            }

            setTimeout(() => {
                $("#itemSearch").focus().select();
            }, 200);
        });

        // ITEM MODAL - HIDDEN EVENT
        $('#itemModal').on('hidden.bs.modal', function () {
            // F2/F3 closes item search first; do not refocus barcode before Item Master opens.
            if (window.stopAutoItemOpen === true) {
                return;
            }

            setTimeout(() => {
                if (currentRowForCrossItemModal && currentRowForCrossItemModal.length) {
                    const itemInput = currentRowForCrossItemModal.find(".item-barcode");
                    if (itemInput.length) {
                        itemInput.focus().select();
                    }
                }
            }, 150);
        });
    </script>

    <!-- ================================================================
         SALESORDER ITEM MASTER F2/F3 POPUP
         ================================================================ -->
    <script>
        // SalesOrder F2-New loads the existing Sales Item Master partial and saves through the same backend.
        $(document).on('click', '#btnNewItem', function (e) {
            e.preventDefault();
            e.stopPropagation();

            window.stopAutoItemOpen = true;
            showLoader("Loading Item Master...");

            $.get('/ItemMaster/LoadItemMasterPartial', function (data) {
                hideLoader();
                $('#itemMasterContainer').html(data);

                var showSalesOrderItemMaster = function () {
                    window.stopAutoItemOpen = true;
                    $('#itemMasterModal').modal("show");

                    setTimeout(function () {
                        $("#ItemMasterForm input[name='Name']").focus();
                    }, 300);
                };

                if ($("#itemModal").hasClass("show")) {
                    $("#itemModal").one("hidden.bs.modal.salesOrderItemMaster", showSalesOrderItemMaster);
                    $("#itemModal").modal("hide");
                } else {
                    showSalesOrderItemMaster();
                }
            }).fail(function (xhr) {
                window.stopAutoItemOpen = false;
                hideLoader();
                console.log(xhr.responseText);
                toastr.error("Error loading Item Master form");
            });
        });

        // SalesOrder F3-Mod opens the selected/current item in the same embedded Item Master partial.
        $(document).on('click', '#btnModifyItem', function (e) {
            e.preventDefault();
            e.stopPropagation();

            window.stopAutoItemOpen = true;

            const $selectedRow = $(".item-row.selected");
            let selectedItemId = null;

            if ($selectedRow.length) {
                selectedItemId = $selectedRow.data("itemid");
            }

            if (!selectedItemId && currentRow) {
                selectedItemId = currentRow.find(".item-id").val();
            }

            if (!selectedItemId || selectedItemId == "0") {
                window.stopAutoItemOpen = false;
                toastr.warning("Please select an item first", "No Item Selected");
                return;
            }

            showLoader("Loading Item Master...");

            $.get('/ItemMaster/LoadItemMasterEditPartial?id=' + selectedItemId + '&_=' + new Date().getTime(), function (data) {
                hideLoader();
                $('#itemMasterContainer').html(data);

                var showSalesOrderItemMasterEdit = function () {
                    window.stopAutoItemOpen = true;
                    $('#itemMasterModal').modal("show");

                    setTimeout(function () {
                        $("#ItemMasterForm input[name='Name']").focus();
                    }, 300);
                };

                if ($("#itemModal").hasClass("show")) {
                    $("#itemModal").one("hidden.bs.modal.salesOrderItemMasterEdit", showSalesOrderItemMasterEdit);
                    $("#itemModal").modal("hide");
                } else {
                    showSalesOrderItemMasterEdit();
                }
            }).fail(function (xhr) {
                window.stopAutoItemOpen = false;
                hideLoader();
                console.log(xhr.responseText);
                toastr.error("Error loading Item Master edit form");
            });
        });

        // SalesOrder item dropdown keyboard shortcuts follow the same F2/F3 click flow.
        $(document).on('keydown', function (e) {
            if (!$("#itemModal").is(":visible") || $("#itemMasterModal").is(":visible")) return;

            if (e.key === "F2") {
                e.preventDefault();
                e.stopPropagation();
                $("#btnNewItem").trigger("click");
            }
            else if (e.key === "F3") {
                e.preventDefault();
                e.stopPropagation();
                $("#btnModifyItem").trigger("click");
            }
        });

        // SalesOrder row refresh after Item Master save keeps dropdown closed and fills current row.
        function refreshItemSearchAfterCreate(response) {
            showLoader("Refreshing items...");

            $.get('/SalesOrder/GetAllItems', function (items) {
                hideLoader();

                const businessType = @ViewBag.BusinessType;

                let rows = renderSalesOrderItemRows(items, businessType);

                $("#itemTableBody").html(rows);

                itemConversionMap[response.itemId] = parseFloat(response.conversion) || 1;
                itemMaxDiscounts[response.itemId] = parseFloat(response.maximumDiscount) || 0;

                if (currentRow && currentRow.length) {
                    currentRow.find(".item-barcode").val(response.itemName);
                    currentRow.find(".item-id").val(response.itemId);
                    currentRow.find(".gst").val(response.gst);
                    currentRow.find(".cess").val(response.cess);
                    currentRow.attr("data-max-discount", response.maximumDiscount);
                    currentRow.attr("data-conversion", response.conversion);

                    calculateRow(currentRow);

                    window.suppressNextBatchNotFound = true;
                    loadBatches(response.itemId);
                }

                $("#itemSearch").val(response.itemName);
            }).fail(function () {
                hideLoader();
                toastr.error("Error refreshing items");
            });
        }

        // Item Master close should return SalesOrder to normal state without reopening item dropdown.
        $('#itemMasterModal').on('hidden.bs.modal', function () {
            if (window.stopAutoItemOpen === true) {
                setTimeout(function () {
                    window.stopAutoItemOpen = false;
                }, 800);
                return;
            }

            setTimeout(function () {
                if (currentRowForCrossItemModal && currentRowForCrossItemModal.length) {
                    const barcodeInput = currentRowForCrossItemModal.find(".item-barcode");
                    if (barcodeInput.length) {
                        barcodeInput.focus().select();
                    }
                }
            }, 200);
        });
    </script>

    <!-- ================================================================
         🔹 BATCH MODAL - COMPLETE FUNCTIONALITY
         ================================================================ -->
    <script>
        function loadBatches(itemId) {
            showLoader(); // Show loader

            $.get('/SalesOrder/GetBatchesByItemId', { id: itemId }, function (data) {
                hideLoader(); // Hide loader

                if (data.error) {
                    toastr.error(data.error);
                    return;
                }

                if (!data.groupedResult || data.groupedResult.length === 0) {
                    // SalesOrder Item Master save can call batch lookup for a new item; suppress that warning once.
                    if (window.suppressNextBatchNotFound === true || window.stopAutoItemOpen === true) {
                        window.suppressNextBatchNotFound = false;
                        return;
                    }

                    toastr.warning("No batch available for this item.", "Batch Not Found", {
                        closeButton: true,
                        progressBar: true,
                        timeOut: 3000,
                        positionClass: "toast-top-right"
                    });

                    setTimeout(() => {
                        currentRow.find(".item-barcode").focus().select();
                    }, 200);
                    return;
                }

                window.suppressNextBatchNotFound = false;
                currentRow.find(".gst").val(data.gst);
                currentRow.find(".cess").val(data.cess);
                const businessType = @ViewBag.BusinessType;

                let batchRows = '';
                data.groupedResult.forEach(batch => {
                    const expiryDate = new Date(batch.expiry);
                    const month = String(expiryDate.getMonth() + 1).padStart(2, '0');
                    const year = expiryDate.getFullYear();
                    const formattedExpiry = `${month}/${year}`;

                    batch.conversion = batch.conversion || 1;

                    const encoded = encodeURIComponent(JSON.stringify(batch));

                    let qtyColumns = '';
                    
                    if (businessType === 2) {
                        qtyColumns = `
                            <td style="display:none;">${batch.qty}</td>
                            <td>${batch.stripTabsQty || '0:0'}</td>
                        `;
                    } else {
                        qtyColumns = `<td>${batch.qty}</td>`;
                    }

                    batchRows += `<tr class="batch-row" tabindex="0" data-batch="${encoded}">
                        <td>${batch.batch}</td>
                        <td>${formattedExpiry}</td>
                        <td hidden>${batch.rate.toFixed(2)}</td>
                        <td>${batch.striprate.toFixed(2)}</td>
                        <td>${batch.mrp}</td>
                        ${qtyColumns}
                    </tr>`;
                });

                $("#batchTableBody").html(batchRows);

                const $rows = $(".batch-row");
                currentBatchIndex = -1;

                if ($rows.length) {
                    currentBatchIndex = 0;
                    highlightBatchRow($rows, currentBatchIndex);
                }

                $("#batchModal").modal("show");
            }).fail(function () {
                hideLoader(); // Hide loader on error
                toastr.error("Error loading batches");
            });
        }

        $(document).on("click", ".batch-row", function () {
            $(".batch-row").removeClass("selected");
            $(this).addClass("selected");

            const encoded = $(this).attr("data-batch");
            try {
                const batch = JSON.parse(decodeURIComponent(encoded));
                if (currentRow) {
                    currentRow.find(".batch").val(batch.batch);
                    currentRow.find(".rate").val(batch.rate || 0);
                    currentRow.find(".stripe-rate").val(batch.striprate.toFixed(2) || 0);
                    currentRow.find(".mrp").val(batch.mrp || 0);

                    if (batch.expiry) {
                        let date = new Date(batch.expiry);
                        let formatted = ("0" + (date.getMonth() + 1)).slice(-2) + "/" + date.getFullYear();
                        currentRow.find(".expirydate").val(formatted);
                    }

                    // STORE CONVERSION
                    const itemId = currentRow.find(".item-id").val();
                    const conversion = parseFloat(batch.conversion) || 1;
                    currentRow.attr("data-conversion", conversion);
                    itemConversionMap[itemId] = conversion;

                    calculateRow(currentRow);
                }
                $("#batchModal").modal("hide");

                setTimeout(() => {
                    const merged = mergeDuplicateRows(currentRow);
                    if (merged) {
                        const $lastRow = $("#SalesOrderItemBody tr:last");
                        if (isTabletWiseMode) {
                            if (currentRow.find(".tablet-qty").val() == 0) {
                                currentRow.find(".tablet-qty").val(1);
                            }
                            $lastRow.find(".tablet-qty").trigger("input");
                            $lastRow.find(".tablet-qty").focus().select();
                        } else {
                            if (currentRow.find(".qty").val() == 0) {
                                currentRow.find(".qty").val(1);
                            }
                            calculateRow($lastRow);
                            $lastRow.find(".qty").focus().select();
                        }
                    } else {
                        if (isTabletWiseMode) {
                            if (currentRow.find(".tablet-qty").val() == 0) {
                                currentRow.find(".tablet-qty").val(1);
                            }
                            currentRow.find(".tablet-qty").trigger("input");
                            currentRow.find(".tablet-qty").focus().select();
                        } else {
                            if (currentRow.find(".qty").val() == 0) {
                                currentRow.find(".qty").val(1);
                            }
                            calculateRow(currentRow);
                            currentRow.find(".qty").focus().select();
                        }
                    }
                }, 200);

            } catch (err) {
                toastr.error("Invalid batch data.");
                console.error(err);
            }
        });

        // ================================================================
        // 🔹 MERGE DUPLICATE ROWS (Same Item + Same Batch)
        // ================================================================
        function mergeDuplicateRows(newRow) {
            if (!newRow || !newRow.length) return false;

            const newItemId = newRow.find(".item-id").val();
            const newBatch = (newRow.find(".batch").val() || "").trim();
            const newExpiry = (newRow.find(".expirydate").val() || "").trim(); 
            const newMrp = parseFloat(newRow.find(".mrp").val()) || 0;
            const newRate = parseFloat(newRow.find(".rate").val()) || 0;

            if (!newItemId || !newBatch) return false;

            let duplicateFound = false;
            let existingRow = null;

            $("#SalesOrderItemBody tr").each(function () {
                const row = $(this);
                if (row.is(newRow)) return; // Skip current row

                const rowItemId = row.find(".item-id").val();
                const rowBatch = (row.find(".batch").val() || "").trim();
                const rowExpiry = (row.find(".expirydate").val() || "").trim();
                const rowMrp = parseFloat(row.find(".mrp").val()) || 0;
                const rowRate = parseFloat(row.find(".rate").val()) || 0;

                // EXACT MATCH: Item + Batch + Expiry + Mrp + Rate sab same ho
                if (
                    rowItemId === newItemId &&
                    rowBatch === newBatch &&
                    rowExpiry === newExpiry &&
                    rowMrp === newMrp &&
                    rowRate === newRate
                ) {
                    existingRow = row;
                    duplicateFound = true;
                    return false; // break
                }
            });

            if (!duplicateFound || !existingRow) return false;

            // MERGE QTY
            if (isTabletWiseMode) {
                const existingStrips = parseFloat(existingRow.find(".qty").val()) || 0;
                const existingTablets = parseFloat(existingRow.find(".tablet-qty").val()) || 0;
                const newStrips = parseFloat(newRow.find(".qty").val()) || 0;
                const newTablets = parseFloat(newRow.find(".tablet-qty").val()) || 0;

                const itemId = existingRow.find(".item-id").val();
                let conversion = parseFloat(existingRow.attr("data-conversion"));
                if (!conversion || conversion <= 0) {
                    conversion = itemConversionMap[itemId] || 1;
                }

                const totalExistingTablets = (existingStrips * conversion) + existingTablets;
                const totalNewTablets = (newStrips * conversion) + newTablets;
                const combinedTablets = totalExistingTablets + totalNewTablets;

                existingRow.find(".qty").val(Math.floor(combinedTablets / conversion));
                existingRow.find(".tablet-qty").val(combinedTablets % conversion);
            } else {
                const existingQty = parseFloat(existingRow.find(".qty").val()) || 0;
                const newQty = parseFloat(newRow.find(".qty").val()) || 0;
                existingRow.find(".qty").val(existingQty + newQty);
            }

            // Discount keep karo
            const existingDiscount = parseFloat(existingRow.find(".discount").val()) || 0;
            const newDiscount = parseFloat(newRow.find(".discount").val()) || 0;
            if (newDiscount > 0 && existingDiscount === 0) {
                existingRow.find(".discount").val(newDiscount);
            }

            newRow.remove();
            calculateRow(existingRow);
            calculateTotalSummary();
            updateRowIndices();

            toastr.info("Same batch detected! Quantities merged.", "Rows Merged", {
                closeButton: true, progressBar: true, timeOut: 3000
            });

            currentRow = existingRow;
            return true;
        }

        // ================================================================
        // 🔹 UPDATE ROW INDICES (after merge/remove)
        // ================================================================
        function updateRowIndices() {
            rowIndex = 0;
            $("#SalesOrderItemBody tr").each(function () {
                const row = $(this);
                row.find("input, select").each(function () {
                    const name = $(this).attr("name");
                    if (name) {
                        $(this).attr("name", name.replace(/\[\d+\]/, `[${rowIndex}]`));
                    }
                });
                rowIndex++;
            });
        }

