                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>
            <div class="modal-body"
                 id="itemMasterContainer">
            </div>
        </div>
    </div>
</div>

<!-- New Customer Modal -->
