<script>
    function loadNewBillNo() {
        $.ajax({
            url: "/SalesOrder/GetNewBillNo",
            type: "GET",
            success: function (res) {
                if (res.success) {
                    $("#BillNo").val(res.billNo);
                } else {
                    toastr.warning("Unable to generate Bill No");
                }
            },
            error: function () {
                toastr.error("Error while generating Bill No");
            }
        });
    }

    function resetSalesOrderForm() {
        const form = $("#salesOrderForm");
        form[0].reset();

        $("#CustomerId").val("");
        $("#DoctorId").val("");
        $("#OfferId").val("");
        $("#SelectedOfferId").val("");

        $("#customer").val("");
        $("#customeraddress").val("");
        $("#mobilenumber").val("");
        $("#doctorname").val("");
        $("#doctorMobile").val("");
        $("#doctorregno").val("");

        hidePhoneError();

        initializeSalesOrderPage(true);

        toastr.success("Ready for new sales order 🚀");
    }

    function initializeSalesOrderPage(isReset = false) {
        loadNewBillNo();

        if (isReset) {
            const today = new Date().toISOString().split('T')[0];
            $("#BillDate").val(today);
        }

        $("#SalesOrderItemBody").empty();
        rowIndex = 0;
        addNewRow();

        $("#PaymentDetailsBody").empty();
        subrowIndex = 0;
        togglePaymentAddButton();

        $("#Total").val("0");
        $("#discountPercent").val("0");
        $("#discountamount").val("0");
        $("#Totaldiscount").val("0");
        $("#TotalGstAmt").val("0");
        $("#totalPayable").val("0");
        $("#paidAmout").val("0");
        $("#balance").val("0");
        $("#returnAmount").val("0");

        setTimeout(() => {
            $("#BillDate").focus();
        }, 200);
    }

    window.addEventListener("focus", function () {
        if (!waitingForFocusAfterPrint) return;

        waitingForFocusAfterPrint = false;

        if (isSalesOrderFormClean()) {
            setTimeout(() => {
                $("#BillDate").focus().select();
            }, 150);
        }
    });

    function isSalesOrderFormClean() {
        const itemRows = $("#SalesOrderItemBody tr").length;
        if (itemRows > 1) return false;

        let hasItemValue = false;

        $("#SalesOrderItemBody tr").each(function () {
            const row = $(this);
            const itemName = row.find(".item-barcode").val();
            const qty = parseFloat(row.find(".qty").val()) || 0;
            const rate = parseFloat(row.find(".rate").val()) || 0;
            const discount = parseFloat(row.find(".discount").val()) || 0;
            const amount = parseFloat(row.find(".Amount").val()) || 0;

            if (itemName || qty > 1 || rate > 0 || discount > 0 || amount > 0) {
                hasItemValue = true;
                return false;
            }
        });

        if (hasItemValue) return false;

        const headerFields = [
            "#mobilenumber", "#customer", "#customeraddress",
            "#doctorMobile", "#doctorname", "#doctorregno"
        ];

        for (let selector of headerFields) {
            if ($(selector).length && $(selector).val()) {
                return false;
            }
        }

        if (parseFloat($("#Total").val()) > 0 || parseFloat($("#totalPayable").val()) > 0) {
            return false;
        }

        return true;
    }

    function isAnyInputFocused() {
        const active = document.activeElement;
        if (!active) return false;

        return (
            active.tagName === "INPUT" ||
            active.tagName === "SELECT" ||
            active.tagName === "TEXTAREA" ||
            active.isContentEditable === true
        );
    }

    $(document).on("keydown", function (e) {
        if (e.key !== "Enter") return;
        if (isAnyInputFocused()) return;
        if (!isSalesOrderFormClean()) return;
        if (!document.hasFocus()) return;

        e.preventDefault();
        setTimeout(() => {
            $("#BillDate").focus().select();
        }, 0);
    });

    $(document).ready(function () {
        initializeSalesOrderPage(false);
    });
</script>

