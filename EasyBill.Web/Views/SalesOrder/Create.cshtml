        $(document).on(
        "keydown",
        ".item-barcode, .batch, .qty, .tablet-qty, .rate, .discount",
        function (e) {

            if (e.key !== "Tab") return;

            const row = $(this).closest("tr");

            const itemName = (row.find(".item-barcode").val() || "").trim();
            const batch = (row.find(".batch").val() || "").trim();
            const qty = parseFloat(row.find(".qty").val()) || 0;
            const rate = parseFloat(row.find(".rate").val()) || 0;

            // Blank row condition (TabletWise aware)
            let isBlankRow = false;

            if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                const tabletQty = parseFloat(row.find(".tablet-qty").val()) || 0;

                isBlankRow =
                    itemName === "" &&
                    batch === "" &&
                    qty === 0 &&
                    tabletQty === 0 &&
                    rate <= 0;
            } else {
                isBlankRow =
                    itemName === "" &&
                    batch === "" &&
                    rate <= 0;
            }

            if (!isBlankRow) return;

            const totalRows = $("#SalesOrderItemBody tr").length;

            // At least one row must remain
            if (totalRows <= 1) {
                e.preventDefault();
                toastr.error("At least one item row is required");
                return;
            }

            // Remove row on TAB
            e.preventDefault();
            row.remove();

            calculateTotalSummary();
            toggleAddRowButton();

            // Move focus to Bill Discount
            setTimeout(() => {
                $("#discountPercent").focus().select();
            }, 50);
        }
    );
</script>
<script>
    // AUTO-OPEN DROPDOWN WHEN PAYMENT MODE GETS FOCUS
    $(document).on("focus", ".paymentMode-dropdown", function() {
        // Open the dropdown using native DOM
        const select = this;

        // For mouse click focus
        if (document.activeElement === select) {
            setTimeout(() => {
                if ('showPicker' in HTMLSelectElement.prototype) {
                    select.showPicker();
                } else {
                    // Fallback for browsers that don't support showPicker
                    $(select).trigger('click');
                }
            }, 50);
        }
    });



        // ================================================================
    // 🔹 DISCOUNT VALIDATION FUNCTIONS
    // ================================================================

    function validateMaxDiscount(row) {
        const itemId = row.find(".item-id").val();
        const discount = parseFloat(row.find(".discount").val()) || 0;
        const maxDiscount = itemMaxDiscounts[itemId] || 0;

        // ✅ STEP 1: Check current row discount
        if (discount > maxDiscount) {
            toastr.error(
                `Maximum allowed discount is ${maxDiscount}%. Current: ${discount}%`,
                "Discount Limit Exceeded",
                {
                    closeButton: true,
                    progressBar: true,
                    timeOut: 5000,
                    positionClass: "toast-top-right"
                }
            );

            row.find(".discount").val(maxDiscount);
            calculateRow(row);

            setTimeout(() => {
                row.find(".discount").focus().select();
            }, 100);

            return false;
        }

        // ✅ STEP 2: Check total discount across multiple rows
        return validateTotalDiscountForItem(row);
    }

    function validateTotalDiscountForItem(currentRow) {
        const itemId = currentRow.find(".item-id").val();
        if (!itemId) return true;

        const maxDiscount = itemMaxDiscounts[itemId] || 0;

        // ✅ Calculate TOTAL discount used across all rows with same item
        let totalUsedDiscount = 0;

        $("#SalesOrderItemBody tr").each(function() {
            const row = $(this);
            const rowItemId = row.find(".item-id").val();

            if (rowItemId === itemId) {
                const discount = parseFloat(row.find(".discount").val()) || 0;
                totalUsedDiscount += discount;
            }
        });

        // ✅ Check if TOTAL discount exceeds maximum allowed
        if (totalUsedDiscount > maxDiscount) {
            const currentDiscount = parseFloat(currentRow.find(".discount").val()) || 0;
            const remainingDiscount = maxDiscount - (totalUsedDiscount - currentDiscount);

            toastr.error(
                `Maximum discount for this item is ${maxDiscount}%. Already used: ${(totalUsedDiscount - currentDiscount).toFixed(2)}%. Remaining: ${remainingDiscount.toFixed(2)}%`,
                "Discount Limit Exceeded",
                {
                    closeButton: true,
                    progressBar: true,
                    timeOut: 8000,
                    positionClass: "toast-top-right"
                }
            );

            // Reset current row discount to remaining amount
            currentRow.find(".discount").val(Math.max(0, remainingDiscount).toFixed(2));
            calculateRow(currentRow);

            setTimeout(() => {
                currentRow.find(".discount").focus().select();
            }, 100);

            return false;
        }

        return true;
    }
</script>
<script>
    // ================================================================
    // 🔹 TABLET-WISE MODE FUNCTIONS
    // ================================================================
    function applyTabletWiseMode(row) {
        const qtyInput = row.find(".qty");
        const tabletQtyInput = row.find(".tablet-qty");

        if (isTabletWiseMode) {
            // TabletWise: Qty disable, TabletQty enable
            qtyInput.prop("readonly", true).css("background-color", "#e9ecef");
            tabletQtyInput.prop("readonly", false).css("background-color", "#fff");
        } else {
            // StripWise: Qty enable, TabletQty disable + hide
            qtyInput.prop("readonly", false).css("background-color", "#fff");
            tabletQtyInput.prop("readonly", true).val("0").css("background-color", "#e9ecef");
        }
    }

    // Q.TABLET INPUT HANDLER
    $(document).on("input", ".tablet-qty", function () {
        if (!isTabletWiseMode) return;

        const row = $(this).closest("tr");
        const itemId = row.find(".item-id").val();

        let conversion = parseFloat(row.attr("data-conversion"));

        if (!conversion || conversion <= 0) {
            conversion = itemConversionMap[itemId] || 1;
        }

        let tabletQty = parseFloat($(this).val()) || 0;

        // Calculate strips
        let strips = Math.floor(tabletQty / conversion);

        // Update Qty field
        row.find(".qty").val(strips);

        // Recalculate row
        calculateRow(row);
    });

    $(document).on("blur", ".tablet-qty", function () {
        if (!isTabletWiseMode) return;

        const row = $(this).closest("tr");
        const itemId = row.find(".item-id").val();

        let conversion = parseFloat(row.attr("data-conversion"));
        if (!conversion || conversion <= 0) {
            conversion = itemConversionMap[itemId] || 1;
        }

        let tabletQty = parseFloat($(this).val()) || 0;

        // Show only remaining tablets
        let remainingTablets = tabletQty % conversion;

        $(this).val(remainingTablets);

        // RE-CALCULATE ROW
        calculateRow(row);
    });
</script>
<script>
    function confirmCancel(callback) {
        Swal.fire({
            title: 'Confirm Cancel?',
            text: 'Changes will be lost. Do you want to cancel?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '❌ Yes, Cancel',
            cancelButtonText: '↩ No, Stay',
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            reverseButtons: true
        }).then((result) => {
            callback(result.isConfirmed);
        });
    }

    $("#btnCancel").on("click", function (e) {
        e.preventDefault();

        confirmCancel(function (isConfirmed) {
            if (isConfirmed) {
                window.location.href = $("#btnCancel").attr("href");
            }
        });
    });
</script>
