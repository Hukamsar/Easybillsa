    <script>
        $(document).ready(function () {
            $("#addRow").click(function () {
                window.addNewRow();
            });

            window.addNewRow = function addNewRow(
                itemId = "", itemName = "", qty = 0, rate = 0,
                batch = "", expirydate = "", mrp = 0,
                gst = 0, discount = 0, amount = 0
            ) {

                // TABLET-QTY COLUMN (NEW)
                let tabletQtyColumn = '';
                
                if (@ViewBag.BusinessType === 2) {
                    tabletQtyColumn = `
                        <td> <input name="SalesOrderItemVMs[${rowIndex}].TabletQty" class="form-control form-control-sm tablet-qty" value="0" /> </td>
                    `;
                }

                let newRow = $(`
                    <tr>
                        <td hidden> <input name="SalesOrderItemVMs[${rowIndex}].ItemMasterId" class="form-control form-control-sm item-id" value="${itemId}" /> </td>
                        <td style="min-width:250px;"> <input type="text" name="SalesOrderItemVMs[${rowIndex}].ItemBarcodeNumber" class="form-control form-control-sm item-barcode" placeholder="Scan/Enter Barcode" value="${itemName}" /> </td>
                        <td> <input name="SalesOrderItemVMs[${rowIndex}].Batch" class="form-control form-control-sm batch" value="${batch}" readonly /> </td>
                        <td> <input type="text" name="SalesOrderItemVMs[${rowIndex}].Expirydate" class="form-control form-control-sm expirydate" value="${expirydate}" placeholder="MM/YYYY" maxlength="7" readonly /> </td>
                        <td> <input name="SalesOrderItemVMs[${rowIndex}].Mrp" class="form-control form-control-sm mrp" value="${mrp}" readonly /> </td>
                        <td> <input name="SalesOrderItemVMs[${rowIndex}].Qty" class="form-control form-control-sm qty" value="${qty}" /> </td>
                        ${tabletQtyColumn}
                        <td hidden> <input name="SalesOrderItemVMs[${rowIndex}].Rate" class="form-control form-control-sm rate" value="${rate}" /></td>
                        <td> <input name="SalesOrderItemVMs[${rowIndex}].StripRate" class="form-control form-control-sm stripe-rate" /> </td>
                        <td> <input name="SalesOrderItemVMs[${rowIndex}].Gst"  class="form-control form-control-sm gst" readonly value="${gst}" /> </td>
                        <td> <input name="SalesOrderItemVMs[${rowIndex}].Cess"  class="form-control form-control-sm cess" readonly /> </td>
                        <td> <input name="SalesOrderItemVMs[${rowIndex}].Discount" class="form-control form-control-sm discount" value="${discount}"/></td>
                        <td> <input name="SalesOrderItemVMs[${rowIndex}].Amount" class="form-control form-control-sm Amount" readonly value="${amount}" /></td>
                        <td> <u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u> </td>
                    </tr>`);

                $("#SalesOrderItemBody").append(newRow);

                // APPLY TABLET-WISE MODE
                applyTabletWiseMode(newRow);

                calculateRow(newRow);
                rowIndex++;
                toggleAddRowButton();
            }

            $(document).on("keydown", ".item-barcode", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    isEnterNavigation = true;
                    currentRow = $(this).closest("tr");
                    currentRowForCrossItemModal = $(this).closest("tr");

                    const barcode = $(this).val().trim();
                    if (!barcode) {
                        openItemSearchModal("");
                        isEnterNavigation = false;
                        return;
                    }
                    processBarcode(barcode);
                }
            });

            $(document).on("change", ".item-barcode", function () {
                if (isEnterNavigation) {
                    isEnterNavigation = false;
                    return;
                }

                currentRow = $(this).closest("tr");
                let barcode = $(this).val().trim();
                if (!barcode) return;

                processBarcode(barcode);
            });
            $(document).on("input", ".stripe-rate", function () {
                let row = $(this).closest("tr");

                let stripRate = parseFloat($(this).val()) || 0;

                const itemId = row.find(".item-id").val();
                let conversion = parseFloat(row.attr("data-conversion"));

                if (!conversion || conversion <= 0) {
                    conversion = itemConversionMap[itemId] || 1;
                }

                // 👇 reverse calculation
                let tabletRate = stripRate / conversion;

                // 👇 actual rate update karo (hidden field)
                row.find(".rate").val(tabletRate.toFixed(4));

                // 🔥 recalculation trigger
                calculateRow(row);
            });
            $(document).on("input", ".qty, .rate, .discount", function () {
                let row = $(this).closest("tr");

                // Validate discount before calculating
                if ($(this).hasClass("discount")) {
                    if (!validateMaxDiscount(row)) {
                        return; // Stop if invalid
                    }
                }

                calculateRow(row);
            });

            $(document).on("click", ".remove-row-btn", function () {
                $(this).closest("tr").remove();
                calculateTotalSummary();
                toggleAddRowButton();
            });

            $("#discountPercent, #discountamount").on("input", function () {
                calculateTotalSummary();
            });

            function formatExpiryDate(input) {
                let value = $(input).val().replace(/[^\d]/g, '');
                if (value.length >= 3) {
                    value = value.slice(0, 2) + '/' + value.slice(2, 6);
                }
                $(input).val(value.slice(0, 7));
            }

            $(document).on('input', '.expirydate', function () {
                formatExpiryDate(this);
            });

            var percentInput = $("#discountPercent");
            if (parseFloat(percentInput.val()) === "") {
                percentInput.val(0);
            }

            $("form").submit(function () {
                $("#employeeId").prop("disabled", false);
            });
        });

        function processItemId(itemId) {
            $.get('/SalesOrder/GetItemById', { id: itemId }, function (itemResponse) {
                if (!itemResponse || !itemResponse.itemId) {
                    alert("Item not found.");
                    return;
                }

                const itemName = itemResponse.itemname;
                currentRow.find(".item-barcode").val(itemName);
                currentRow.find(".item-id").val(itemResponse.itemId);

                if (itemResponse.category && itemResponse.category.toLowerCase() === "optical") {
                    openOpticalPopup(currentRow, function () {
                        loadBatches(itemId);
                    });
                } else {
                    loadBatches(itemId);
                }
            });
        }

        function processBarcode(barcode) {
            // Ignore barcode lookup while SalesOrder F2/F3 Item Master form is active.
            if (window.stopAutoItemOpen === true || $("#itemMasterModal").is(":visible")) return;

            $.get('/SalesOrder/GetItemByBarcode', { barcode: barcode }, function (itemResponse) {
                if (!itemResponse || !itemResponse.itemId) {
                    openItemSearchModal(barcode);
                    return;
                }

                const itemId = itemResponse.itemId;
                const itemName = itemResponse.itemname;
                const maxDiscount = parseFloat(itemResponse.maximumDiscount) || 0;

                currentRow.find(".item-id").val(itemId);
                currentRow.find(".item-barcode").val(itemName);
                currentRow.attr("data-max-discount", maxDiscount);

                itemMaxDiscounts[itemId] = maxDiscount;

                if (itemResponse.category && itemResponse.category.toLowerCase() === "optical") {
                    openOpticalPopup(currentRow, function () {
                        loadBatches(itemId);
                    });
                } else {
                    loadBatches(itemId);
                }
            });
        }

        function openOpticalPopup(currentRow, onComplete) {
            let tbody = $("#OpticalDetailsBody").empty();
            const itemId = currentRow.find(".item-id").val();
            const form = $("#salesOrderForm");

            const eyes = ["OD", "OS"];
            eyes.forEach(eye => {
                tbody.append(`
                    <tr data-eye="${eye}">
                        <td><strong class="eye-label">${eye}</strong></td>
                        <td><input type="number" step="0.25" class="form-control sphere"></td>
                        <td><input type="number" step="0.25" class="form-control cylinder"></td>
                        <td><input type="number" step="1" class="form-control axis"></td>
                        <td><input type="number" step="0.25" class="form-control prism"></td>
                        <td><input type="number" step="0.25" class="form-control add"></td>
                    </tr>
                `);
            });

            $("#opticalPopup").modal("show");

            $("#saveOpticalBtn").off("click").on("click", function () {
                form.find(`input[data-item='${itemId}']`).remove();

                let startIndex = form.find("input[name^='OpticalVMs']").length / 7;
                let html = "";

                $("#OpticalDetailsBody tr").each(function (i) {
                    const index = startIndex + i;
                    const eyeSide = $(this).data("eye");
                    const sphere = $(this).find(".sphere").val();
                    const cylinder = $(this).find(".cylinder").val();
                    const axis = $(this).find(".axis").val();
                    const prism = $(this).find(".prism").val();
                    const addVal = $(this).find(".add").val();

                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].ItemMasterId" value="${itemId}" />`;
                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].Rx" value="${eyeSide}" />`;
                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].Sphere" value="${sphere}" />`;
                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].Cylinder" value="${cylinder}" />`;
                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].Axis" value="${axis}" />`;
                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].Prism" value="${prism}" />`;
                    html += `<input type="hidden" data-item="${itemId}" name="OpticalVMs[${index}].Add" value="${addVal}" />`;
                });

                form.append(html);
                $("#opticalPopup").modal("hide");

                if (typeof onComplete === "function") {
                    onComplete();
                }
            });
        }

