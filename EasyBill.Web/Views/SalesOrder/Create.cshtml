<script>
    $('#opticalPopup').on('shown.bs.modal', function () {
        isOpticalModalOpen = true;
        setTimeout(() => {
            $("#OpticalDetailsBody tr:first .sphere").focus().select();
        }, 100);
    });

    $('#opticalPopup').on('hidden.bs.modal', function () {
        isOpticalModalOpen = false;
    });

    $(document).on("keydown", "#opticalTable input", function (e) {
        if (!isOpticalModalOpen) return;
        if (e.key !== "Enter") return;

        e.preventDefault();

        const $current = $(this);
        const $allInputs = $("#OpticalDetailsBody input:visible");
        const currentIndex = $allInputs.index($current);

        if (currentIndex === $allInputs.length - 1) {
            $("#saveOpticalBtn").trigger("click");
            return;
        }

        $allInputs.eq(currentIndex + 1).focus().select();
    });

    $(document).on("keydown", "#opticalTable input", function (e) {
        if (!isOpticalModalOpen) return;

        const $current = $(this);
        const $row = $current.closest("tr");
        const currentClass = $current.attr("class").split(" ")[1];

        if (e.key === "ArrowRight") {
            e.preventDefault();
            const $allInputs = $row.find("input");
            const currentIndex = $allInputs.index($current);

            if (currentIndex < $allInputs.length - 1) {
                $allInputs.eq(currentIndex + 1).focus().select();
            }
        }

        if (e.key === "ArrowLeft") {
            e.preventDefault();
            const $allInputs = $row.find("input");
            const currentIndex = $allInputs.index($current);

            if (currentIndex > 0) {
                $allInputs.eq(currentIndex - 1).focus().select();
            }
        }

        if (e.key === "ArrowDown") {
            e.preventDefault();
            const $nextRow = $row.next("tr");

            if ($nextRow.length) {
                $nextRow.find("." + currentClass).focus().select();
            }
        }

        if (e.key === "ArrowUp") {
            e.preventDefault();
            const $prevRow = $row.prev("tr");

            if ($prevRow.length) {
                $prevRow.find("." + currentClass).focus().select();
            }
        }
    });
</script>

