        });

        // SalesOrder Edit F2-New loads the existing Sales Item Master partial in-place.
        $(document).on('click', '#btnNewItem', function (e) {
            e.preventDefault();
            e.stopPropagation();

            window.stopAutoItemOpen = true;
            showLoader("Loading Item Master...");

            $.get('/ItemMaster/LoadItemMasterPartial', function (data) {
                hideLoader();
                $('#itemMasterContainer').html(data);

                var showSalesOrderEditItemMaster = function () {
                    window.stopAutoItemOpen = true;
                    $('#itemMasterModal').modal("show");

                    setTimeout(function () {
                        $("#ItemMasterForm input[name='Name']").focus();
                    }, 300);
                };

                if ($("#itemModal").hasClass("show")) {
                    $("#itemModal").one("hidden.bs.modal.salesOrderEditItemMaster", showSalesOrderEditItemMaster);
                    $("#itemModal").modal("hide");
                } else {
                    showSalesOrderEditItemMaster();
                }
            }).fail(function (xhr) {
                window.stopAutoItemOpen = false;
                hideLoader();
                console.log(xhr.responseText);
                toastr.error("Error loading Item Master form");
            });
        });

        // SalesOrder Edit F3-Mod opens the selected/current item in the same embedded Item Master partial.
        $(document).on('click', '#btnModifyItem', function (e) {
            e.preventDefault();
            e.stopPropagation();

            window.stopAutoItemOpen = true;

            const $selectedRow = $(".item-row.selected");
            let selectedItemId = null;

            if ($selectedRow.length) {
                selectedItemId = $selectedRow.data("itemid");
            }

            if (!selectedItemId && currentRow) {
                selectedItemId = currentRow.find(".item-id").val();
            }

            if (!selectedItemId || selectedItemId == "0") {
                window.stopAutoItemOpen = false;
                toastr.warning("Please select an item first", "No Item Selected");
                return;
            }

            showLoader("Loading Item Master...");

            $.get('/ItemMaster/LoadItemMasterEditPartial?id=' + selectedItemId + '&_=' + new Date().getTime(), function (data) {
                hideLoader();
                $('#itemMasterContainer').html(data);

                var showSalesOrderEditItemMasterEdit = function () {
                    window.stopAutoItemOpen = true;
                    $('#itemMasterModal').modal("show");

                    setTimeout(function () {
                        $("#ItemMasterForm input[name='Name']").focus();
                    }, 300);
                };

                if ($("#itemModal").hasClass("show")) {
                    $("#itemModal").one("hidden.bs.modal.salesOrderEditItemMasterEdit", showSalesOrderEditItemMasterEdit);
                    $("#itemModal").modal("hide");
                } else {
                    showSalesOrderEditItemMasterEdit();
                }
            }).fail(function (xhr) {
                window.stopAutoItemOpen = false;
                hideLoader();
                console.log(xhr.responseText);
                toastr.error("Error loading Item Master edit form");
            });
        });

        // SalesOrder Edit item dropdown keyboard shortcuts trigger the same safe click flow.
        $(document).on('keydown', function (e) {
            if (!$("#itemModal").is(":visible") || $("#itemMasterModal").is(":visible")) return;

            if (e.key === "F2") {
                e.preventDefault();
                e.stopPropagation();
                $("#btnNewItem").trigger("click");
                return;
            }

            if (e.key === "F3") {
                e.preventDefault();
                e.stopPropagation();
                $("#btnModifyItem").trigger("click");
                return;
            }
