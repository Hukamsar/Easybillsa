    $(document).on("keydown", ".item-barcode", function (e) {
        const row = $(this).closest("tr");

        if (e.key === "ArrowRight") {
            e.preventDefault();

            // ✅ BUSINESS TYPE 2: Item → Tabs → Rate → Disc
            if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                row.find(".tablet-qty").focus().select();
            } else {
                row.find(".qty").focus().select();
            }
            return;
        }

        if (e.key === "ArrowDown") {
            e.preventDefault();
            const nextRow = row.next("tr");
            if (nextRow.length) {
                nextRow.find(".item-barcode").focus();
            }
            return;
        }

        if (e.key === "ArrowUp") {
            e.preventDefault();
            const prevRow = row.prev("tr");
            if (prevRow.length) {
                prevRow.find(".item-barcode").focus();
            }
        }
    });

    $(document).on("keydown", ".qty, .tablet-qty, .stripe-rate, .rate, .discount", function (e) {
        const row = $(this).closest("tr");
        const input = $(this);

        const isItemBarcode = input.hasClass("item-barcode");
        const isQty = input.hasClass("qty");
        const isTabletQty = input.hasClass("tablet-qty");
        const isRate = input.hasClass("rate");
        const isStripeRate = input.hasClass("stripe-rate");
        const isDiscount = input.hasClass("discount");

        // ✅ ENTER KEY NAVIGATION
        if (e.key === "Enter") {
            e.preventDefault();

            if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                // ✅ TABLET-WISE MODE: Tabs → Rate → Disc → Next Row
                if (isTabletQty) {
                   // row.find(".rate").focus().select();
                    row.find(".stripe-rate").focus().select();
                } else if (isStripeRate) {
                    row.find(".discount").focus().select();
                } else if (isDiscount) {
                    handleDiscountEnter(row);
                }
            } else {
                // ✅ STRIP-WISE MODE: Qty → Rate → Disc → Next Row
                if (isQty) {
                  //  row.find(".rate").focus().select();
                    row.find(".stripe-rate").focus().select();
                } else if (isStripeRate) {
                    row.find(".discount").focus().select();
                } else if (isDiscount) {
                    handleDiscountEnter(row);
                }
            }
            return;
        }

        // ✅ ARROW RIGHT NAVIGATION
        if (e.key === "ArrowRight") {
            e.preventDefault();

            if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                // ✅ RIGHT: Item → Tabs → Rate → Disc
                if (isItemBarcode) row.find(".tablet-qty").focus().select();
                    else if (isTabletQty)  row.find(".stripe-rate").focus().select(); //row.find(".rate").focus().select();
                    else if (isStripeRate) row.find(".discount").focus().select();
            } else {
                // ✅ RIGHT: Item → Qty → Rate → Disc
                if (isItemBarcode) row.find(".qty").focus().select();
                    else if (isQty) row.find(".stripe-rate").focus().select(); //row.find(".rate").focus().select();
                    else if (isStripeRate) row.find(".discount").focus().select();
            }
            return;
        }

        // ✅ ARROW LEFT NAVIGATION
        if (e.key === "ArrowLeft") {
            e.preventDefault();

            if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                // ✅ LEFT: Item ← Tabs ← Rate ← Disc
                    if (isDiscount) row.find(".stripe-rate").focus().select(); //row.find(".rate").focus().select();
                    else if (isStripeRate) row.find(".tablet-qty").focus().select();
                else if (isTabletQty) row.find(".item-barcode").focus().select();
            } else {
                // ✅ LEFT: Item ← Qty ← Rate ← Disc
                    if (isDiscount) row.find(".stripe-rate").focus().select(); //row.find(".rate").focus().select();
                    else if (isStripeRate) row.find(".qty").focus().select();
                else if (isQty) row.find(".item-barcode").focus().select();
            }
            return;
        }

        // ✅ ARROW DOWN NAVIGATION
        if (e.key === "ArrowDown") {
            e.preventDefault();
            const nextRow = row.next("tr");
            if (!nextRow.length) return;

            if (isItemBarcode) nextRow.find(".item-barcode").focus();
            else if (isQty) nextRow.find(".qty").focus();
            else if (isTabletQty) nextRow.find(".tablet-qty").focus();
                        else if (isStripeRate) nextRow.find(".stripe-rate").focus(); //nextRow.find(".rate").focus();
            else if (isDiscount) nextRow.find(".discount").focus();
            return;
        }

        // ✅ ARROW UP NAVIGATION
        if (e.key === "ArrowUp") {
            e.preventDefault();
            const prevRow = row.prev("tr");
            if (!prevRow.length) return;

            if (isItemBarcode) prevRow.find(".item-barcode").focus();
            else if (isQty) prevRow.find(".qty").focus();
            else if (isTabletQty) prevRow.find(".tablet-qty").focus();
            else if (isStripeRate) prevRow.find(".stripe-rate").focus(); //prevRow.find(".rate").focus();
            else if (isDiscount) prevRow.find(".discount").focus();
        }
    });

    // ================================================================
    // 🔹 HANDLE DISCOUNT ENTER KEY
    // ================================================================
    function handleDiscountEnter(row) {
        const itemId = row.find(".item-id").val();
        const batch = row.find(".batch").val();

        if (!itemId || !batch) {
            toastr.warning("Please select Item and Batch before adding new row.");

            if (!itemId) {
                row.find(".item-barcode").focus();
            } else if (!batch) {
                row.find(".item-barcode").focus();
            }
            return;
        }

        // VALIDATE QUANTITY BASED ON MODE
        if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
            const qty = parseFloat(row.find(".qty").val()) || 0;
            const tabletQty = parseFloat(row.find(".tablet-qty").val()) || 0;

            if (qty === 0 && tabletQty === 0) {
                toastr.warning("Please enter quantity or tablet quantity.");
                row.find(".tablet-qty").focus().select();
                return;
            }
        } else {
            const qty = parseFloat(row.find(".qty").val()) || 0;

            if (qty < 1) {
                toastr.warning("Quantity cannot be less than 1.");
                row.find(".qty").focus().select();
                return;
            }
        }

        // ADD NEW ROW OR MOVE TO NEXT
        const isLastRow = row.is("#SalesOrderItemBody tr:last");

        if (isLastRow) {
            addNewRow();

            setTimeout(() => {
                $("#SalesOrderItemBody tr:last .item-barcode").focus();
            }, 150);
        } else {
            const nextRow = row.next("tr");

            if (nextRow.length) {
                nextRow.find(".item-barcode").focus();
            }
        }
    }

