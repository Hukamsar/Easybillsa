<script>
    // ================================================================
    // 🔹 DISCOUNT VALIDATION FUNCTIONS
    // ================================================================

    function validateMaxDiscount(row) {
        const itemId = row.find(".item-id").val();
        const discount = parseFloat(row.find(".discount").val()) || 0;
        const maxDiscount = itemMaxDiscounts[itemId] || 0;

        // STEP 1: Check current row discount
        if (discount > maxDiscount) {
            toastr.error(
                `Maximum allowed discount is ${maxDiscount}%. Current: ${discount}%`,
                "Discount Limit Exceeded",
                {
                    closeButton: true,
                    progressBar: true,
                    timeOut: 5000,
                    positionClass: "toast-top-right"
                }
            );

            row.find(".discount").val(maxDiscount);
            calculateRow(row);

            setTimeout(() => {
                row.find(".discount").focus().select();
            }, 100);

            return false;
        }

        // STEP 2: Check total discount across multiple rows
        return validateTotalDiscountForItem(row);
    }

    function validateTotalDiscountForItem(currentRow) {
        const itemId = currentRow.find(".item-id").val();
        if (!itemId) return true;

        const maxDiscount = itemMaxDiscounts[itemId] || 0;

        // Calculate TOTAL discount used across all rows with same item
        let totalUsedDiscount = 0;

        $("#SalesOrderItemBody tr").each(function() {
            const row = $(this);
            const rowItemId = row.find(".item-id").val();

            if (rowItemId === itemId) {
                const discount = parseFloat(row.find(".discount").val()) || 0;
                totalUsedDiscount += discount;
            }
        });

        // Check if TOTAL discount exceeds maximum allowed
        if (totalUsedDiscount > maxDiscount) {
            const currentDiscount = parseFloat(currentRow.find(".discount").val()) || 0;
            const remainingDiscount = maxDiscount - (totalUsedDiscount - currentDiscount);

            toastr.error(
                `Maximum discount for this item is ${maxDiscount}%. Already used: ${(totalUsedDiscount - currentDiscount).toFixed(2)}%. Remaining: ${remainingDiscount.toFixed(2)}%`,
                "Discount Limit Exceeded",
                {
                    closeButton: true,
                    progressBar: true,
                    timeOut: 8000,
                    positionClass: "toast-top-right"
                }
            );

            // Reset current row discount to remaining amount
            currentRow.find(".discount").val(Math.max(0, remainingDiscount).toFixed(2));
            calculateRow(currentRow);

            setTimeout(() => {
                currentRow.find(".discount").focus().select();
            }, 100);

            return false;
        }

        return true;
    }
</script>
<script>
    // ================================================================
    // 🔹 LOAD TABLET-WISE SETTINGS
    // ================================================================
    function loadSalesOrderSettings() {
        $.ajax({
            url: '/SalseSetting/GetSidebarSettings',
            type: 'GET',
            success: function (data) {
                isTabletWiseMode = (data.itemConversion === "TabletWise");

                console.log("✅ Settings Loaded. TabletWise:", isTabletWiseMode);

                // ✅ UPDATE TABLE HEADERS
                if (@ViewBag.BusinessType === 2) {
                    if (isTabletWiseMode) {
                        $("#qtyView").text("Strip");
                        $("#qtyTabsView").text("Tabs");
                    } else {
                        $("#qtyView").text("Qty");
                    }
                }

                // ✅ LOAD CONVERSION DATA + APPLY MODE + RECALCULATE
                $.get('/SalesOrder/GetAllItems', function(items) {
                    // Store conversion for all items
                    items.forEach(item => {
                        itemConversionMap[item.id] = parseFloat(item.conversion) || 1;
                        itemMaxDiscounts[item.id] = parseFloat(item.maximumdiscount) || 0;
                    });

                    // Apply mode + set conversion on existing rows
                    $("#SalesOrderItemBody tr").each(function() {
                        const row = $(this);
                        const itemId = row.find(".item-id").val();

                        // ✅ SET CONVERSION FROM MAP
                        if (itemId && itemConversionMap[itemId]) {
                            row.attr("data-conversion", itemConversionMap[itemId]);
                        }

                        // ✅ SET MAX DISCOUNT
                        if (itemId && itemMaxDiscounts[itemId]) {
                            row.attr("data-max-discount", itemMaxDiscounts[itemId]);
                        }

                        applyTabletWiseMode(row);
                    });

                    // ✅ RECALCULATE AFTER SETTINGS + CONVERSION LOADED
                    calculateTotalSummary();
                    calculateTotalPaid();

                    console.log("✅ Conversion map loaded:", itemConversionMap);
                    console.log("✅ Summary recalculated after settings load");

                    hideLoader();
                }).fail(function() {
                    hideLoader();
                    toastr.warning("Could not load item data.");

                    // Fallback: recalculate anyway
                    calculateTotalSummary();
                    calculateTotalPaid();
                });
            },
            error: function () {
                console.error("❌ Could not load settings");
                // Fallback
                calculateTotalSummary();
                calculateTotalPaid();
            }
        });
    }
</script>
<script>
    // ================================================================
    // 🔹 TABLET-WISE MODE FUNCTIONS
    // ================================================================
    function applyTabletWiseMode(row) {
        const qtyInput = row.find(".qty");
        const tabletQtyInput = row.find(".tablet-qty");

        if (@ViewBag.BusinessType !== 2) return;

        if (isTabletWiseMode) {
            // TabletWise: Qty readonly, TabletQty enabled
            qtyInput.prop("readonly", true).css("background-color", "#e9ecef");
            tabletQtyInput.prop("readonly", false).css("background-color", "#fff");
        } else {
            // StripWise: Qty enabled, TabletQty disabled
            qtyInput.prop("readonly", false).css("background-color", "#fff");
            tabletQtyInput.prop("readonly", true).val("0").css("background-color", "#e9ecef");
        }
    }

    // TABLET INPUT HANDLER
    $(document).on("input", ".tablet-qty", function () {
        if (!isTabletWiseMode) return;

        const row = $(this).closest("tr");
        const itemId = row.find(".item-id").val();

        let conversion = parseFloat(row.attr("data-conversion"));

        if (!conversion || conversion <= 0) {
            conversion = itemConversionMap[itemId] || 1;
        }

        let tabletQty = parseFloat($(this).val()) || 0;
        let strips = Math.floor(tabletQty / conversion);

        row.find(".qty").val(strips);
        calculateRow(row);
    });

    // TABLET BLUR HANDLER
    $(document).on("blur", ".tablet-qty", function () {
        if (!isTabletWiseMode) return;

        const row = $(this).closest("tr");
        const itemId = row.find(".item-id").val();

        let conversion = parseFloat(row.attr("data-conversion"));
        if (!conversion || conversion <= 0) {
            conversion = itemConversionMap[itemId] || 1;
        }

        let tabletQty = parseFloat($(this).val()) || 0;
        let remainingTablets = tabletQty % conversion;

        $(this).val(remainingTablets);
        calculateRow(row);
    });
</script>
<script>
    // ================================================================
    // 🔹 MERGE DUPLICATE ROWS (Same Item + Same Batch + Same Expiry + Mrp + Rate)
    // ================================================================
    function mergeDuplicateRows(newRow) {
        if (!newRow || !newRow.length) return false;

        const newItemId = newRow.find(".item-id").val();
        const newBatch  = (newRow.find(".batch").val() || "").trim();
        const newExpiry = (newRow.find(".expirydate").val() || "").trim(); // ✅ Expiry
        const newMrp    = parseFloat(newRow.find(".mrp").val()) || 0;      // ✅ Mrp
        const newRate   = parseFloat(newRow.find(".rate").val()) || 0;     // ✅ Rate

        if (!newItemId || !newBatch) return false;

        let duplicateFound = false;
        let existingRow = null;

        $("#SalesOrderItemBody tr").each(function () {
            const row = $(this);
            if (row.is(newRow)) return; // Skip current row

            const rowItemId = row.find(".item-id").val();
            const rowBatch  = (row.find(".batch").val() || "").trim();
            const rowExpiry = (row.find(".expirydate").val() || "").trim();
            const rowMrp    = parseFloat(row.find(".mrp").val()) || 0;
            const rowRate   = parseFloat(row.find(".rate").val()) || 0;

            // EXACT MATCH: Item + Batch + Expiry + Mrp + Rate sab same ho tabhi merge
            if (
                rowItemId === newItemId &&
                rowBatch  === newBatch  &&
                rowExpiry === newExpiry &&
                rowMrp    === newMrp    &&
                rowRate   === newRate
            ) {
                existingRow = row;
                duplicateFound = true;
                return false; // break
            }
        });

        if (!duplicateFound || !existingRow) return false;

        // MERGE QTY
        if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
            const existingStrips  = parseFloat(existingRow.find(".qty").val()) || 0;
            const existingTablets = parseFloat(existingRow.find(".tablet-qty").val()) || 0;
            const newStrips       = parseFloat(newRow.find(".qty").val()) || 0;
            const newTablets      = parseFloat(newRow.find(".tablet-qty").val()) || 0;

            const itemId = existingRow.find(".item-id").val();
            let conversion = parseFloat(existingRow.attr("data-conversion"));
            if (!conversion || conversion <= 0) {
                conversion = itemConversionMap[itemId] || 1;
            }

            const totalExisting = (existingStrips * conversion) + existingTablets;
            const totalNew      = (newStrips * conversion) + newTablets;
            const combined      = totalExisting + totalNew;

            existingRow.find(".qty").val(Math.floor(combined / conversion));
            existingRow.find(".tablet-qty").val(combined % conversion);
        } else {
            // StripWise: Simple qty add
            const existingQty = parseFloat(existingRow.find(".qty").val()) || 0;
            const newQty      = parseFloat(newRow.find(".qty").val()) || 0;
            existingRow.find(".qty").val(existingQty + newQty);
        }

        // DISCOUNT: New row ka discount rakh lo agar existing mein nahi hai
        const existingDiscount = parseFloat(existingRow.find(".discount").val()) || 0;
        const newDiscount      = parseFloat(newRow.find(".discount").val()) || 0;
        if (newDiscount > 0 && existingDiscount === 0) {
            existingRow.find(".discount").val(newDiscount);
        }

        // REMOVE duplicate row
        newRow.remove();

        // RECALCULATE
        calculateRow(existingRow);
        calculateTotalSummary();
        updateRowIndices();

        toastr.info("Same batch detected! Quantities merged.", "Rows Merged", {
            closeButton: true, progressBar: true, timeOut: 3000,
            positionClass: "toast-top-right"
        });

        currentRow = existingRow;
        return true;
    }
</script>
<script>
    function confirmCancel(callback) {
        Swal.fire({
            title: 'Confirm Cancel?',
            text: 'Changes will be lost. Do you want to cancel?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '❌ Yes, Cancel',
            cancelButtonText: '↩ No, Stay',
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            reverseButtons: true
        }).then((result) => {
            callback(result.isConfirmed);
        });
    }

    $("#btnCancel").on("click", function (e) {
        e.preventDefault();

        confirmCancel(function (isConfirmed) {
            if (isConfirmed) {
                window.location.href = $("#btnCancel").attr("href");
            }
        });
    });
</script>
}
