<script>
    function openOpticalPopup(currentRow, onComplete) {
        const $form = $("#salesOrderForm");
        const salesorderId = $("#salesorderId").val();
        const itemId = currentRow.find(".item-id").val();
        const tbody = $("#OpticalDetailsBody").empty();

        $.get('/SalesOrder/GetOpticalDetails',
            { salesOrderId: salesorderId, itemmasterId: itemId },
            function (existingData) {

            const od = existingData?.find(o => (o.rx || o.Rx) === "OD") || {};
            const os = existingData?.find(o => (o.rx || o.Rx) === "OS") || {};
            const odId = od.id || od.Id || 0;
            const osId = os.id || os.Id || 0;

            tbody.append(`
              <tr data-eye="OD">
                <td><strong class="eye-label">OD</strong></td>
                <td><input type="number" step="0.25" class="form-control sphere"   value="${od.sphere   ?? od.Sphere   ?? ''}"></td>
                <td><input type="number" step="0.25" class="form-control cylinder" value="${od.cylinder ?? od.Cylinder ?? ''}"></td>
                <td><input type="number" step="1"    class="form-control axis"     value="${od.axis     ?? od.Axis     ?? ''}"></td>
                <td><input type="number" step="0.25" class="form-control prism"    value="${od.prism    ?? od.Prism    ?? ''}"></td>
                <td><input type="number" step="0.25" class="form-control add"      value="${od.add      ?? od.Add      ?? ''}"></td>
              </tr>
            `);

            tbody.append(`
              <tr data-eye="OS">
                <td><strong class="eye-label">OS</strong></td>
                <td><input type="number" step="0.25" class="form-control sphere"   value="${os.sphere   ?? os.Sphere   ?? ''}"></td>
                <td><input type="number" step="0.25" class="form-control cylinder" value="${os.cylinder ?? os.Cylinder ?? ''}"></td>
                <td><input type="number" step="1"    class="form-control axis"     value="${os.axis     ?? os.Axis     ?? ''}"></td>
                <td><input type="number" step="0.25" class="form-control prism"    value="${os.prism    ?? os.Prism    ?? ''}"></td>
                <td><input type="number" step="0.25" class="form-control add"      value="${os.add      ?? os.Add      ?? ''}"></td>
              </tr>
            `);

            $("#opticalPopup").modal("show");
            isOpticalModalOpen = true;

            $("#saveOpticalBtn").off("click").on("click", function () {
                const indicesToRemove = new Set();
                $form.find("input[name^='OpticalVMs'][name$='.ItemMasterId']").each(function () {
                    if ($(this).val() == String(itemId)) {
                        const m = this.name.match(/OpticalVMs\[(\d+)\]\.ItemMasterId/);
                        if (m) indicesToRemove.add(m[1]);
                    }
                });
                indicesToRemove.forEach(idx => {
                    $form.find(`input[name^='OpticalVMs[${idx}]']`).remove();
                });

                const existingIdx = [...new Set($form.find("input[name^='OpticalVMs[']")
                    .map(function () {
                        const m = this.name.match(/OpticalVMs\[(\d+)\]/);
                        return m ? parseInt(m[1], 10) : null;
                    }).get().filter(x => x !== null))].sort((a,b)=>a-b);

                let nextIdx = 0;
                for (let i = 0; i < existingIdx.length; i++) {
                    if (existingIdx[i] === nextIdx) nextIdx++;
                    else break;
                }

                $("#opticalTable tbody tr").each(function () {
                    const eyeSide = $(this).data("eye") || $(this).find(".eye-label").text().trim();
                    const sphere  = $(this).find(".sphere").val();
                    const cylinder= $(this).find(".cylinder").val();
                    const axis    = $(this).find(".axis").val();
                    const prism   = $(this).find(".prism").val();
                    const addVal  = $(this).find(".add").val();

                    const thisId = (eyeSide === "OD") ? odId : (eyeSide === "OS" ? osId : 0);

                    const html = `
                      <input type="hidden" class="optical-hidden" name="OpticalVMs[${nextIdx}].Id"            value="${thisId}" />
                      <input type="hidden" class="optical-hidden" name="OpticalVMs[${nextIdx}].ItemMasterId"  value="${itemId}" />
                      <input type="hidden" class="optical-hidden" name="OpticalVMs[${nextIdx}].Rx"            value="${eyeSide}" />
                      <input type="hidden" class="optical-hidden" name="OpticalVMs[${nextIdx}].Sphere"        value="${sphere}" />
                      <input type="hidden" class="optical-hidden" name="OpticalVMs[${nextIdx}].Cylinder"      value="${cylinder}" />
                      <input type="hidden" class="optical-hidden" name="OpticalVMs[${nextIdx}].Axis"          value="${axis}" />
                      <input type="hidden" class="optical-hidden" name="OpticalVMs[${nextIdx}].Prism"         value="${prism}" />
                      <input type="hidden" class="optical-hidden" name="OpticalVMs[${nextIdx}].Add"           value="${addVal}" />
                    `;
                    $form.append(html);

                    nextIdx++;
                });

                $("#opticalPopup").modal("hide");
                isOpticalModalOpen = false;
                if (typeof onComplete === "function") onComplete();
            });
        });
    }

    $('#opticalPopup').on('shown.bs.modal', function () {
        isOpticalModalOpen = true;
        setTimeout(() => $("#OpticalDetailsBody tr:first .sphere").focus().select(), 100);
    });

    $('#opticalPopup').on('hidden.bs.modal', function () {
        isOpticalModalOpen = false;
    });

    $(document).on("keydown", "#opticalTable input", function (e) {
        if (!isOpticalModalOpen) return;

        const $current = $(this);
        const $row = $current.closest("tr");
        const $allInputs = $("#OpticalDetailsBody input:visible");
        const currentIndex = $allInputs.index($current);

        if (e.key === "Enter") {
            e.preventDefault();
            if (currentIndex === $allInputs.length - 1) {
                $("#saveOpticalBtn").trigger("click");
            } else {
                $allInputs.eq(currentIndex + 1).focus().select();
            }
            return;
        }

        if (e.key === "ArrowRight") {
            e.preventDefault();
            if (currentIndex < $allInputs.length - 1) {
                $allInputs.eq(currentIndex + 1).focus().select();
            }
            return;
        }

        if (e.key === "ArrowLeft") {
            e.preventDefault();
            if (currentIndex > 0) {
                $allInputs.eq(currentIndex - 1).focus().select();
            }
            return;
        }

        if (e.key === "ArrowDown") {
            e.preventDefault();
            const $nextRow = $row.next("tr");
            if ($nextRow.length) {
                const colIndex = $row.find("input").index($current);
                $nextRow.find("input").eq(colIndex).focus().select();
            }
            return;
        }

        if (e.key === "ArrowUp") {
            e.preventDefault();
            const $prevRow = $row.prev("tr");
            if ($prevRow.length) {
                const colIndex = $row.find("input").index($current);
                $prevRow.find("input").eq(colIndex).focus().select();
            }
        }
    });
</script>

