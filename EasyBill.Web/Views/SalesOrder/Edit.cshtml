        function calculateRow(row) {
            let qty = parseFloat(row.find(".qty").val()) || 0;
            let rate = parseFloat(row.find(".rate").val()) || 0;
            let gst = parseFloat(row.find(".gst").val()) || 0;
            let cess = parseFloat(row.find(".cess").val()) || 0;
            let discount = parseFloat(row.find(".discount").val()) || 0;
            let stripRate = parseFloat(row.find(".stripe-rate").val()) || 0;
            // TABLET-WISE CALCULATION
            let grossAmount = 0;

            if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                const itemId = row.find(".item-id").val();
                let conversion = parseFloat(row.attr("data-conversion"));

                if (!conversion || conversion <= 0) {
                    conversion = itemConversionMap[itemId] || 1;
                }

                const tabletQty = parseFloat(row.find(".tablet-qty").val()) || 0;

                // TOTAL TABLETS = (Strips × Conversion) + Remaining Tablets
                let totalTablets = (qty * conversion) + tabletQty;

                // RATE IS PER TABLET
              //  grossAmount = totalTablets * rate;
              grossAmount = (totalTablets / conversion) * stripRate;
            } else {
                // STRIP-WISE: Rate is per strip
               // grossAmount = qty * rate;

                const itemId = row.find(".item-id").val();
                let conversion = parseFloat(row.attr("data-conversion"));

                if (!conversion || conversion <= 0) {
                    conversion = itemConversionMap[itemId] || 1;
                }

                let totalTablets = qty * conversion;

                grossAmount = totalTablets * stripRate;
            }

            let discountAmt = (grossAmount * discount) / 100;
            let amountAfterDiscount = grossAmount - discountAmt;
            let gstAmt = (amountAfterDiscount * gst) / 100;
            let cessAmt = (amountAfterDiscount * cess) / 100;
            let total = amountAfterDiscount + gstAmt + cessAmt;

            row.find(".discount-amt").val(discountAmt.toFixed(2));
            row.find(".Amount").val(total.toFixed(2));

            calculateTotalSummary();
        }

        function calculateTotalSummary() {
            let total = 0;
            let totalGst = 0;
            let totalCess = 0;
            let totalDiscount = 0, totalamt = 0;
            let gstRows = [];

            $("#SalesOrderItemBody tr").each(function () {
                let row = $(this);
                let qty = parseFloat(row.find(".qty").val()) || 0;
                let rate = parseFloat(row.find(".rate").val()) || 0;
                let gst = parseFloat(row.find(".gst").val()) || 0;
                let cess = parseFloat(row.find(".cess").val()) || 0;
                let discount = parseFloat(row.find(".discount").val()) || 0;
                let stripRate = parseFloat(row.find(".stripe-rate").val()) || 0;
                // TABLET-WISE CALCULATION
                let grossAmount = 0;

                if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                    const itemId = row.find(".item-id").val();
                    let conversion = parseFloat(row.attr("data-conversion"));

                    if (!conversion || conversion <= 0) {
                        conversion = itemConversionMap[itemId] || 1;
                    }

                    const tabletQty = parseFloat(row.find(".tablet-qty").val()) || 0;

                    // TOTAL TABLETS = (Strips × Conversion) + Remaining Tablets
                    let totalTablets = (qty * conversion) + tabletQty;

                    // RATE IS PER TABLET
                  //  grossAmount = totalTablets * rate;
                  grossAmount = (totalTablets / conversion) * stripRate;
                } else {
                  //  grossAmount = qty * rate;
                     const itemId = row.find(".item-id").val();
                     let conversion = parseFloat(row.attr("data-conversion"));

                     if (!conversion || conversion <= 0) {
                         conversion = itemConversionMap[itemId] || 1;
                     }

                     let totalTablets = qty * conversion;

                     grossAmount = totalTablets * stripRate;
                }

                // rest same...
                let discountAmt = (grossAmount * discount) / 100;
                let amountAfterDiscount = grossAmount - discountAmt;
                let gstAmt = (amountAfterDiscount * gst) / 100;
                let cessAmt = (amountAfterDiscount * cess) / 100;
                total += amountAfterDiscount;
                totalamt += amountAfterDiscount;
                totalGst += gstAmt;
                totalCess += cessAmt;
                totalDiscount += discountAmt;

                gstRows.push({ rate: amountAfterDiscount, gst: gst, cess : cess });
            });

            let percentInput = parseFloat($("#discountPercent").val()) || 0;
            let amountInput = parseFloat($("#discountamount").val()) || 0;

            let globalDiscountPercent = 0;
            let globalDiscountAmt = 0;

            if ($("#discountPercent").is(":focus") || (percentInput > 0 && amountInput === 0)) {
                globalDiscountPercent = percentInput;
                globalDiscountAmt = (total * globalDiscountPercent) / 100;
                $("#discountamount").val(globalDiscountAmt.toFixed(2));
            } else if ($("#discountamount").is(":focus") || (amountInput > 0 && percentInput === 0)) {
                globalDiscountAmt = amountInput;
                globalDiscountPercent = total > 0 ? (globalDiscountAmt / total) * 100 : 0;
                $("#discountPercent").val(globalDiscountPercent.toFixed(2));
            } else if (percentInput > 0 && amountInput > 0) {
                globalDiscountPercent = percentInput;
                globalDiscountAmt = amountInput;

                globalDiscountAmt = (total * globalDiscountPercent) / 100;
                $("#discountamount").val(globalDiscountAmt.toFixed(2));
            }

            if (globalDiscountAmt > 0) {
                totalDiscount += globalDiscountAmt;
                totalamt = total - globalDiscountAmt;

                totalGst = 0;
                totalCess = 0;
                gstRows.forEach(row => {
                    let rowDiscountAmt = (row.rate * globalDiscountPercent) / 100;
                    let rowAfterGlobalDiscount = row.rate - rowDiscountAmt;
                    let gstAmt = (rowAfterGlobalDiscount * row.gst) / 100;
                    let cessAmt = (rowAfterGlobalDiscount * row.cess) / 100;
                    totalGst += gstAmt;
                    totalCess += cessAmt;
                });
            }

            let totalPayable = totalamt + totalGst + totalCess;
            let roundedPayable = Math.round(totalPayable);
            let roundOffAmount = Number((roundedPayable - totalPayable).toFixed(2));

            let paidAmount = 0;
            $(".paymentAmount").each(function () {
                paidAmount += parseFloat($(this).val()) || 0;
            });

            let balance = 0;
            let returnAmount = 0;

            if (paidAmount > roundedPayable) {
                returnAmount = paidAmount - roundedPayable;
                balance = 0;
            } else {
                balance = roundedPayable - paidAmount;
                returnAmount = 0;
            }

            $("[name='Total']").val(total.toFixed(2));
            $("[name='TotalGstAmt']").val(totalGst.toFixed(2));
            $("[name='TotalCessAmt']").val(totalCess.toFixed(2));
            $("[name='Totaldiscount']").val(totalDiscount.toFixed(2));
            $("[name='TotalPayable']").val(roundedPayable);
            $("[name='RoundOffAmount']").val(roundOffAmount);

            $("#paidAmout").val(paidAmount.toFixed(2));
            $("#balance").val(balance.toFixed(2));
            $("#returnAmount").val(returnAmount.toFixed(2));
        }

