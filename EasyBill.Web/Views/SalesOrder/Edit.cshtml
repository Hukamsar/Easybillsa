    <!-- ================================================================
      🔹 FORM SUBMIT VALIDATION
      ================================================================ -->
    <script>
        let isFormSubmitting = false;

        $("#salesOrderForm").on("submit", function (e) {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();

            if (isFormSubmitting) {
                return false;
            }

            const form = this;

            toastr.options = {
                closeButton: true,
                progressBar: true,
                positionClass: "toast-top-right",
                timeOut: 3000,
                extendedTimeOut: 1000,
                preventDuplicates: true
            };

            const mobile = ($("#mobilenumber").val() || "").trim();
            const customerName = ($("#customer").val() || "").trim();

            if (!mobile) {
                toastr.error("Mobile number is required.", "Mobile Required");
                $("#mobilenumber").focus().select();
                return false;
            }

            if (!isValidIndianMobile(mobile)) {
                toastr.error("Please enter a valid 10-digit mobile number.", "Invalid Mobile");
                $("#mobilenumber").focus().select();
                return false;
            }

            if (!customerName) {
                toastr.error("Customer name is required.", "Customer Required");
                $("#customer").focus().select();
                return false;
            }

            const doctorRequired = $("#doctorMobile").length > 0 && $("#doctorMobile").is(":visible");
            if (doctorRequired) {
                const doctorMobile = ($("#doctorMobile").val() || "").trim();
                const doctorName = ($("#doctorname").val() || "").trim();

                if (!doctorMobile) {
                    toastr.error("Doctor mobile number is required.", "Doctor Required");
                    $("#doctorMobile").focus().select();
                    return false;
                }

                if (!doctorName) {
                    toastr.error("Doctor name is required.", "Doctor Required");
                    $("#doctorname").focus().select();
                    return false;
                }
            }

            let hasValidItemRow = false;
            let firstZeroQtyRow = null;
            let firstIncompleteRow = null;

            $("#SalesOrderItemBody tr").each(function () {
                const row = $(this);

                const itemId = (row.find(".item-id").val() || "").trim();
                const batch = (row.find(".batch").val() || "").trim();
                const qty = parseFloat(row.find(".qty").val()) || 0;

                if (!itemId && !batch && qty === 0) {
                    return;
                }

                if (itemId && !batch && !firstIncompleteRow) {
                    firstIncompleteRow = row;
                }

                if (itemId && qty <= 0 && !firstZeroQtyRow) {
                    firstZeroQtyRow = row;
                }

                if (itemId && batch && qty > 0) {
                    hasValidItemRow = true;
                }
            });

            if (firstIncompleteRow) {
                toastr.error("Please select batch for all items.", "Incomplete Item");
                firstIncompleteRow.find(".item-barcode").focus().select();
                return false;
            }

            if (firstZeroQtyRow) {
                toastr.error("Quantity must be at least 1.", "Invalid Quantity");

                const qtyInput = firstZeroQtyRow.find(".qty");
                const originalQty = qtyInput.data("originalQty");

                if (originalQty && originalQty > 0) {
                    qtyInput.val(originalQty);
                } else {
                    qtyInput.val(1);
                }

                calculateRow(firstZeroQtyRow);

                qtyInput.focus().select();
                return false;
            }

            if (!hasValidItemRow) {
                toastr.error("Please add at least one valid item before saving.", "No Items");

                const firstRow = $("#SalesOrderItemBody tr:first");
                if (firstRow.length) {
                    firstRow.find(".item-barcode").focus().select();
                }
                return false;
            }

            confirmSave(function (ok) {
                if (!ok) return;

                showLoader("Updating Sales Order...");
                form.submit();

                isFormSubmitting = true;
            });
        });
    </script>

    <!-- ================================================================
         🔹 PAYMENT GRID MANAGEMENT
         ================================================================ -->
    <script>
                $(document).ready(function () {
                    $("#addPaymentRow").click(function () {
                        addPaymentRow();
                        togglePaymentAddButton();
                    });

                    $(document).on("click", ".remove-paymentrow-btn", function () {
                        $(this).closest("tr").remove();
                        calculateTotalPaid();
                        togglePaymentAddButton();
                    });

                    $(document).on("keyup", ".paymentAmount", function () {
                        calculateTotalPaid();
                    });

                    togglePaymentAddButton();
                });

                function addPaymentRow() {
                    let newRow = `
                        <tr>
                            <td style="min-width:185px;">
                                <select name="SalsePaymentDetails[${subrowIndex}].PaymentModeId"
                                        class="form-control form-control-sm paymentMode-dropdown" required>
                                    <option value="">-- Select --</option>
                                    ${getPaymentOptions()}
                                </select>
                            </td>
                            <td>
                                <input name="SalsePaymentDetails[${subrowIndex}].Amount"
                                       class="form-control form-control-sm paymentAmount" value="0" />
                            </td>
                            <td>
                                <input name="SalsePaymentDetails[${subrowIndex}].ReferenceNo"
                                       class="form-control form-control-sm paymentReferenceNO" />
                            </td>
                            <td>
                                <input name="SalsePaymentDetails[${subrowIndex}].Description"
                                       class="form-control form-control-sm paymentDescription" />
                            </td>
                            <td>
                                <u class="remove-paymentrow-btn text-danger" style="cursor:pointer;">Remove</u>
                            </td>
                        </tr>`;

                    $("#PaymentDetailsBody").append(newRow);

                    // AUTO FILL PAYMENT AMOUNT
                    let rowCount = $("#PaymentDetailsBody tr").length;

                    if (rowCount === 1) {
                        let totalPayable = parseFloat($("#totalPayable").val()) || 0;
                        if (totalPayable > 0) {
                            $("#PaymentDetailsBody tr:last .paymentAmount")
                                .val(totalPayable.toFixed(2));
                        }
                    } else {
                        let balance = parseFloat($("#balance").val()) || 0;
                        if (balance > 0) {
                            $("#PaymentDetailsBody tr:last .paymentAmount")
                                .val(balance.toFixed(2));
                        } else {
                            $("#PaymentDetailsBody tr:last .paymentAmount").val("0");
                        }
                    }

                    subrowIndex++;
                    calculateTotalPaid();
                }

                function getPaymentOptions() {
                    return `@foreach (var item in ViewBag.PaymentMode) {
                        <option value="@item.Value">@item.Text</option>
            }
    `;
        }

        function calculateTotalPaid() {
            let totalPaid = 0;
            $(".paymentAmount").each(function () {
                let val = parseFloat($(this).val()) || 0;
                totalPaid += val;
            });

            $("#paidAmout").val(totalPaid.toFixed(2));
            calculateTotalPaymentSummary();
        }

        function calculateTotalPaymentSummary() {
            let returnAmt = 0;
            let balance = 0;
            var totalPayable = parseFloat($("#totalPayable").val()) || 0;
            var paidAmt = parseFloat($("#paidAmout").val()) || 0;

            if (paidAmt > totalPayable && paidAmt > 0) {
                returnAmt = paidAmt - totalPayable;
                balance = 0;
            } else {
                balance = totalPayable - paidAmt;
            }

            $("#returnAmount").val(returnAmt.toFixed(2));
            $("#balance").val(balance.toFixed(2));
        }

        function togglePaymentAddButton() {
            if ($("#PaymentDetailsBody tr").length > 0) {
                $("#addPaymentRow").hide();
            } else {
                $("#addPaymentRow").show();
            }
        }
</script>

