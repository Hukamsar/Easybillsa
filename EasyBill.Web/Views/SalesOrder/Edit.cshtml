                    const itemInput = currentRowForCrossItemModal.find(".item-barcode");
                    if (itemInput.length) {
                        itemInput.focus().select();
                    }
                }
            }, 200);
        });
    </script>

    <!-- ================================================================
         🔹 BATCH MODAL - COMPLETE FUNCTIONALITY
         ================================================================ -->
    <script>
        function loadBatches(itemId) {
            showLoader(); // ✅ Show loader

            $.get('/SalesOrder/GetBatchesByItemId', { id: itemId }, function (data) {
                hideLoader(); // ✅ Hide loader

                if (data.error) {
                    toastr.error(data.error);
                    return;
                }

                if (!data.groupedResult || data.groupedResult.length === 0) {
                    toastr.warning("No batch available for this item.", "Batch Not Found", {
                        closeButton: true,
                        progressBar: true,
                        timeOut: 3000,
                        positionClass: "toast-top-right"
                    });

                    setTimeout(() => {
                        currentRow.find(".item-barcode").focus().select();
                    }, 200);
                    return;
                }

                currentRow.find(".gst").val(data.gst);
                currentRow.find(".cess").val(data.cess);

                const businessType = @ViewBag.BusinessType;

                let batchRows = '';
                data.groupedResult.forEach(batch => {
                    const expiryDate = new Date(batch.expiry);
                    const month = String(expiryDate.getMonth() + 1).padStart(2, '0');
                    const year = expiryDate.getFullYear();
                    const formattedExpiry = `${month}/${year}`;

                    batch.conversion = batch.conversion || 1;

                    const encoded = encodeURIComponent(JSON.stringify(batch));

                    if (businessType === 2) {
                        qtyColumns = `
                            <td style="display:none;">${batch.qty}</td>
                            <td>${batch.stripTabsQty || '0:0'}</td>
                        `;
                    } else {
                        qtyColumns = `<td>${batch.qty}</td>`;
                    }

                    batchRows += `<tr class="batch-row" tabindex="0" data-batch="${encoded}">
                        <td>${batch.batch}</td>
                        <td>${formattedExpiry}</td>
                        <td hidden>${batch.rate.toFixed(2)}</td>
                        <td>${batch.striprate.toFixed(2)}</td>
                        <td>${batch.mrp}</td>
                        ${qtyColumns}
                    </tr>`;
                });

                $("#batchTableBody").html(batchRows);

                const $rows = $(".batch-row");
                currentBatchIndex = -1;

                if ($rows.length) {
                    currentBatchIndex = 0;
                    highlightBatchRow($rows, currentBatchIndex);
                }

                $("#batchModal").modal("show");
            }).fail(function () {
                hideLoader(); // Hide loader on error
                toastr.error("Error loading batches");
            });
        }

        // BATCH ROW CLICK
        $(document).on("click", ".batch-row", function () {
            $(".batch-row").removeClass("selected");
            $(this).addClass("selected");

            const encoded = $(this).attr("data-batch");
            try {
                const batch = JSON.parse(decodeURIComponent(encoded));
                if (currentRow) {
                    currentRow.find(".batch").val(batch.batch);
                    currentRow.find(".rate").val(batch.rate.toFixed(4) || 0);
                    currentRow.find(".stripe-rate").val(batch.striprate.toFixed(2) || 0);
                    currentRow.find(".mrp").val(batch.mrp || 0);

                    // const qtyInput = currentRow.find(".qty");
                    // const existingQty = parseFloat(qtyInput.val());

                    // if (!existingQty || existingQty <= 0) {
                    //     qtyInput.val(1);
                    // }


                    // STORE CONVERSION
                    const itemId = currentRow.find(".item-id").val();
                    const conversion = parseFloat(batch.conversion) || 1;
                    currentRow.attr("data-conversion", conversion);
                    itemConversionMap[itemId] = conversion;


                    if (batch.expiry) {
                        let date = new Date(batch.expiry);
                        let formatted = ("0" + (date.getMonth() + 1)).slice(-2) + "/" + date.getFullYear();
                        currentRow.find(".expirydate").val(formatted);
                    }
                    calculateRow(currentRow);
                }
                $("#batchModal").modal("hide");

                // setTimeout(() => {
                //     if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                //         currentRow.find(".tablet-qty").focus().select();
                //     } else {
                //         currentRow.find(".qty").focus().select();
                //     }
                // }, 200);

                // CHECK FOR DUPLICATE AFTER BATCH SELECTED
                setTimeout(() => {
                    const merged = mergeDuplicateRows(currentRow);
                
                    if (merged) {
                        const $lastRow = $("#SalesOrderItemBody tr:last");
                        if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                            if (currentRow.find(".tablet-qty").val() == 0) {
                                currentRow.find(".tablet-qty").val(1);
                            }
                            $lastRow.find(".tablet-qty").trigger("input");
                            $lastRow.find(".tablet-qty").focus().select();
                        } else {
                            if (currentRow.find(".qty").val() == 0) {
                                currentRow.find(".qty").val(1);
                            }
                            calculateRow($lastRow);
                            $lastRow.find(".qty").focus().select();
                        }
                    } else {
                        if (@ViewBag.BusinessType === 2 && isTabletWiseMode) {
                            if (currentRow.find(".tablet-qty").val() == 0) {
                                currentRow.find(".tablet-qty").val(1);
                            }
                            currentRow.find(".tablet-qty").trigger("input");
                            currentRow.find(".tablet-qty").focus().select();
                        } else {
                            if (currentRow.find(".qty").val() == 0) {
                                currentRow.find(".qty").val(1);
                            }
                            calculateRow(currentRow);
                            currentRow.find(".qty").focus().select();
                        }
                    }
                }, 200);
            } catch (err) {
                toastr.error("Invalid batch data.");
                console.error(err);
            }
        });

        // ✅ BATCH MODAL - KEYBOARD NAVIGATION (FIXED)
        $(document).on("keydown", function (e) {
            if (!$("#batchModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                batchNavMode = "keyboard";
                isKeyboardScrollingBatchModal = true;

                $("#batchModal").addClass("keyboard-nav").removeClass("mouse-nav");
            }

            const $rows = $(".batch-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentBatchIndex === -1) {
                    currentBatchIndex = 0;
                } else if (currentBatchIndex < $rows.length - 1) {
                    currentBatchIndex++; // INCREMENT BY 1
                }

                highlightBatchRow($rows, currentBatchIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();

                if (currentBatchIndex <= 0) {
                    // Already at top, do nothing
                    return;
                }

                currentBatchIndex--;
                highlightBatchRow($rows, currentBatchIndex);
            }
            else if (e.key === "Enter" && currentBatchIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentBatchIndex).trigger("click");
            }
        });

        function highlightBatchRow($rows, index) {
            $rows.removeClass("selected");

            const $row = $rows.eq(index);
            if (!$row.length) return;

            $row.addClass("selected");

            const container = document.querySelector("#batchModal .batch-table-wrapper");
            if (!container) return;

            const rowRect = $row[0].getBoundingClientRect();
            const containerRect = container.getBoundingClientRect();
            const headerHeight = document.querySelector("#batchTable thead")?.offsetHeight || 50;

            if (rowRect.top < containerRect.top + headerHeight) {
                container.scrollTop -= (containerRect.top + headerHeight - rowRect.top);
            }
            else if (rowRect.bottom > containerRect.bottom) {
                container.scrollTop += (rowRect.bottom - containerRect.bottom);
            }
        }

        // ✅ BATCH MODAL - MOUSE HOVER
        $(document).on("mouseenter", ".batch-row", function () {
            if (!$("#batchModal").is(":visible")) return;
            if (isKeyboardScrollingBatchModal) return;

            batchNavMode = "mouse";

            $("#batchModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".batch-row:visible");
            $rows.removeClass("selected");

            $(this).addClass("selected");
            currentBatchIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#batchModal", function () {
            isKeyboardScrollingBatchModal = false;
        });

        $('#batchModal').on('shown.bs.modal', function () {
            batchNavMode = "keyboard";
            isKeyboardScrollingBatchModal = false;

            $("#batchModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".batch-row:visible");

            currentBatchIndex = -1;

            if ($rows.length > 0) {
                currentBatchIndex = 0;
                highlightBatchRow($rows, 0);
            }
        });

        // BATCH MODAL - HIDDEN EVENT
        $('#batchModal').on('hidden.bs.modal', function () {
            setTimeout(() => {
                if (currentRow && currentRow.length) {
                    if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                        if (currentRow.find(".tablet-qty").val() == 0) {
                            currentRow.find(".tablet-qty").val(1);
                        }
                        currentRow.find(".tablet-qty").focus().select();
                    } else {
                        if (currentRow.find(".qty").val() == 0) {
                            currentRow.find(".qty").val(1);
                        }
                        currentRow.find(".qty").focus().select();
                    }
                }
            }, 150);
        });
    </script>

    <!-- ================================================================
         🔹 ITEM GRID MANAGEMENT
         ================================================================ -->
    <script>
        function addNewRow() {

            updateRowIndices();

            let newRow = `
                <tr data-new-row="true">
                    <td hidden>  <input type="hidden" name="SalesOrderItemVMs[${rowIndex}].Id" value="0" /> </td>
                    <td hidden> <input name="SalesOrderItemVMs[${rowIndex}].ItemMasterId" class="form-control form-control-sm item-id" /> </td>
                    <td style="min-width:250px;"> <input type="text" name="SalesOrderItemVMs[${rowIndex}].ItemBarcodeNumber" class="form-control form-control-sm item-barcode" /> </td>
                    <td> <input name="SalesOrderItemVMs[${rowIndex}].Batch" class="form-control form-control-sm batch" readonly /> </td>
                    <td> <input type="text" name="SalesOrderItemVMs[${rowIndex}].Expirydate" class="form-control form-control-sm expirydate" placeholder="MM/YYYY" maxlength="7" readonly /> </td>
                    <td> <input name="SalesOrderItemVMs[${rowIndex}].Mrp" class="form-control form-control-sm mrp" readonly /> </td>
                    <td> <input name="SalesOrderItemVMs[${rowIndex}].Qty" class="form-control form-control-sm qty" value="0" /> </td>
                    ${@ViewBag.BusinessType === 2 ? `
                        <td>
                            <input name="SalesOrderItemVMs[${rowIndex}].TabletQty"
                                   class="form-control form-control-sm tablet-qty" value="0" />
                        </td>` : ''
                    }
                    <td hidden> <input name="SalesOrderItemVMs[${rowIndex}].Rate" class="form-control form-control-sm rate" /> </td>
                    <td> <input name="SalesOrderItemVMs[${rowIndex}].StripRate" class="form-control form-control-sm stripe-rate" /> </td>
                    <td> <input name="SalesOrderItemVMs[${rowIndex}].Gst" class="form-control form-control-sm gst" readonly />  </td>
                    <td> <input name="SalesOrderItemVMs[${rowIndex}].Cess" class="form-control form-control-sm cess" readonly />  </td>
                    <td> <input type="number" name="SalesOrderItemVMs[${rowIndex}].Discount" class="form-control form-control-sm discount" value="0" /> </td>
                    <td> <input name="SalesOrderItemVMs[${rowIndex}].Amount" class="form-control form-control-sm Amount" readonly /> </td>
                    <td> <u class="remove-row-btn text-danger" style="cursor:pointer;">Remove</u> </td>
                </tr>`;

            $("#SalesOrderItemBody").append(newRow);

            // APPLY TABLET-WISE MODE TO NEW ROW
            const $newRow = $("#SalesOrderItemBody tr:last");
            applyTabletWiseMode($newRow);

            $("#SalesOrderItemBody").find('.expirydate').each(function () {
                formatExpiryDateInput(this);
            });
            rowIndex++;
            //updateRowIndices();
            toggleAddRowButton();
        }

        function formatExpiryDateInput(input) {
            let value = $(input).val().replace(/[^\d]/g, '');

            if (value.length >= 2) {
                let month = value.substring(0, 2);
                let year = value.substring(2, 6);

                if (parseInt(month) > 12) {
                    month = "12";
                } else if (parseInt(month) < 1) {
                    month = "01";
                }

                value = month;
                if (year) {
                    value += '/' + year;
                }
            }

            $(input).val(value.substring(0, 7));
        }

        function updateRowIndices() {
            const rows = document.querySelectorAll('#SalesOrderItemBody tr');
            rowIndex = 0;
            rows.forEach(row => {
                row.querySelectorAll('input, select').forEach(input => {
                    const name = input.name;
                    if (name) input.name = name.replace(/\[\d+\]/, `[${rowIndex}]`);
                });
                rowIndex++;
            });
        }

        function toggleAddRowButton() {
            if ($("#SalesOrderItemBody tr").length > 0) {
                $("#addRow").hide();
            } else {
                $("#addRow").show();
            }
        }

        $(document).ready(function () {
            $("#addRow").click(function () {
                addNewRow();
            });

            $(document).on("keydown", ".item-barcode", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    isEnterNavigation = true;
                    currentRow = $(this).closest("tr");
                    currentRowForCrossItemModal = $(this).closest("tr");

                    const barcode = $(this).val().trim();
                    if (!barcode) {
                        openItemSearchModal("");
                        isEnterNavigation = false;
                        return;
                    }
                    processBarcode(barcode);
                }
            });

            $(document).on("focus", ".qty", function () {
                const val = parseFloat($(this).val());
                $(this).data("originalQty", isNaN(val) ? null : val);
            });
             $(document).on("input", ".stripe-rate", function () {
                let row = $(this).closest("tr");

                let stripRate = parseFloat($(this).val()) || 0;

                const itemId = row.find(".item-id").val();
                let conversion = parseFloat(row.attr("data-conversion"));

                if (!conversion || conversion <= 0) {
                    conversion = itemConversionMap[itemId] || 1;
                }

                // 👇 reverse calculation
                let tabletRate = stripRate / conversion;

                // 👇 actual rate update karo (hidden field)
                row.find(".rate").val(tabletRate.toFixed(4));

                // 🔥 recalculation trigger
                calculateRow(row);
            });
            $(document).on("input", ".qty, .rate, .discount", function () {
                let row = $(this).closest("tr");

                if ($(this).hasClass("discount")) {
                    if (!validateMaxDiscount(row)) {
                        return; // Stop if invalid
                    }
                }

                calculateRow(row);
            });

            $("#discountPercent, #discountamount").on("input", function () {
                calculateTotalSummary();
            });

            $(document).on("click", ".remove-row-btn", function () {
                $(this).closest("tr").remove();
                calculateTotalSummary();
                updateRowIndices();
                toggleAddRowButton();
            });

            $('.expirydate').each(function () {
                let val = $(this).val();
                if (val.includes('-')) {
                    let parts = val.split('-');
                    if (parts.length >= 2) {
                        let formatted = parts[1] + '/' + parts[0];
                        $(this).val(formatted);
                    }
                } else {
                    formatExpiryDateInput(this);
                }
            });

            $(document).on('input click', '.expirydate', function () {
                formatExpiryDateInput(this);
            });

            toggleAddRowButton();
        });

        function processItemId(itemId) {
            $.get('/SalesOrder/GetItemById', { id: itemId }, function (itemResponse) {
                if (!itemResponse || !itemResponse.itemId) {
                    toastr.error("Item not found");
                    return;
                }

                const itemName = itemResponse.itemname;
                currentRow.find(".item-barcode").val(itemName);
                currentRow.find(".item-id").val(itemResponse.itemId);

                if (itemResponse.category && itemResponse.category.toLowerCase() === "optical") {
                    openOpticalPopup(currentRow, function () {
                        loadBatches(itemId);
                    });
                } else {
                    loadBatches(itemId);
                }
            });
        }

        function processBarcode(barcode) {
            $.get('/SalesOrder/GetItemByBarcode', { barcode: barcode }, function (item) {
                if (!item || !item.itemId) {
                    openItemSearchModal(barcode);
                    return;
                }

                const itemName = item.itemname;
                const maxDiscount = parseFloat(item.maximumDiscount) || 0;

                currentRow.find(".item-id").val(item.itemId);
                currentRow.find(".item-barcode").val(itemName);
                currentRow.attr("data-max-discount", maxDiscount);

                itemMaxDiscounts[item.itemId] = maxDiscount;

                if (item.category && item.category.toLowerCase() === "optical") {
                    openOpticalPopup(currentRow, function () {
                        loadBatches(item.itemId);
                    });
                } else {
                    loadBatches(item.itemId);
                }
            });
        }

        // function calculateRow(row) {
        //     let qty = parseFloat(row.find(".qty").val()) || 0;
        //     let rate = parseFloat(row.find(".rate").val()) || 0;
        //     let gst = parseFloat(row.find(".gst").val()) || 0;
        //     let discount = parseFloat(row.find(".discount").val()) || 0;

        //     let grossAmount = qty * rate;
        //     let discountAmt = (grossAmount * discount) / 100;
