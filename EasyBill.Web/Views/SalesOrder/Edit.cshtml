@using EasyBill.Models.ViewModels
@model SalesOrderVM
@{
    ViewData["Title"] = "Create Stock Issue";
}

<link href="~/css/page.css" rel="stylesheet" />
<style>
    /* ===============================
                       GENERAL TABLE ROW SELECTION
                       =============================== */
    tr.selected {
        background-color: #d2e3fc;
        border: 2px solid green;
    }

    /* ===============================
                       ITEM MODAL - LAYOUT
                       =============================== */
    #itemModal .modal-dialog {
        max-height: 90vh;
    }

    #itemModal .modal-content {
        max-height: 90vh;
        display: flex;
        flex-direction: column;
    }

    /* ===============================
                       ITEM MODAL - HEADER
                       =============================== */
    #itemModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #itemModal .modal-header .btn-close {
            filter: invert(1);
        }

    /* ===============================
                       ITEM MODAL - BODY
                       =============================== */
    #itemModal .modal-body {
        padding: 1rem;
        display: flex;
        flex-direction: column;
    }

    /* ===============================
                       ITEM MODAL - TABLE WRAPPER
                       =============================== */
    .item-table-wrapper {
        min-height: 50px;
        max-height: 350px;
        overflow-y: auto;
    }

        .item-table-wrapper::-webkit-scrollbar {
            width: 6px;
        }

        .item-table-wrapper::-webkit-scrollbar-thumb {
            background: #adb5bd;
            border-radius: 4px;
        }

    /* ===============================
                       ITEM MODAL - TABLE HEADER
                       =============================== */
    #itemTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* ===============================
                       ITEM MODAL - ROW SELECTION
                       =============================== */
    .item-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    .item-row:focus {
        outline: none;
    }

    .item-row {
        scroll-margin-top: 50px;
    }

    /* ===============================
                       ITEM MODAL - KEYBOARD MODE
                       =============================== */
    #itemModal.keyboard-nav .item-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* ===============================
                       ITEM MODAL - MOUSE MODE
                       =============================== */
    #itemModal.mouse-nav .item-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    /* ===============================
                       BATCH MODAL - HEADER
                       =============================== */
    #batchModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #batchModal .modal-header .btn-close {
            filter: invert(1);
        }

    /* ===============================
                       BATCH MODAL - TABLE WRAPPER
                       =============================== */
    .batch-table-wrapper {
        max-height: 350px;
        overflow-y: auto;
        position: relative;
    }

    /* ===============================
                       BATCH MODAL - TABLE HEADER
                       =============================== */
    #batchTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* ===============================
                       BATCH MODAL - ROW SELECTION
                       =============================== */
    .batch-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    .batch-row:focus {
        outline: none;
    }

    .batch-row {
        scroll-margin-top: 50px;
    }

    /* ===============================
                       BATCH MODAL - KEYBOARD MODE
                       =============================== */
    #batchModal.keyboard-nav .batch-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* ===============================
                       BATCH MODAL - MOUSE MODE
                       =============================== */
    #batchModal.mouse-nav .batch-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    #itemModal .shortcut-link {
        color: #0d6efd;
        cursor: pointer;
        font-weight: 600;
        text-decoration: none;
        line-height: 1.2;
    }

        #itemModal .shortcut-link:hover {
            text-decoration: underline;
        }

        #itemModal .shortcut-link.text-danger {
            color: #dc3545 !important;
        }

    /* ===============================
               CUSTOMER LIST MODAL STYLING
               =============================== */
    #customerListModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #customerListModal .modal-header .btn-close {
            filter: invert(1);
        }

    .customer-table-wrapper {
        min-height: 50px;
        max-height: 350px;
        overflow-y: auto;
    }

    #customerTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        z-index: 2;
    }

    .customer-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    #customerListModal.keyboard-nav .customer-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #customerListModal.mouse-nav .customer-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .customer-row {
        scroll-margin-top: 50px;
    }

        .customer-row:focus {
            outline: none;
        }
</style>
<style>
    .total-amount {
        font-size: 1.4rem;
        font-weight: 700;
        color: #198754;
    }
</style>
<style>
    #refreshBtn:hover {
        opacity: 0.85;
        transform: rotate(90deg);
        transition: all 0.2s ease;
    }
</style>
<style>
    .custom-header th {
        background: linear-gradient(180deg, #eef3f8, #d8e3ef);
        color: #16202b;
        font-weight: 700;
        text-align: center;
        border-bottom: 0px solid #b6c6d6;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,0.05);
    }
</style>
<div class="card mb-2 shadow-sm" style="border-radius: 6px; overflow: hidden;">
