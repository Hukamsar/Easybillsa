</style>
<style>
    #refreshBtn:hover {
        opacity: 0.85;
        transform: rotate(90deg);
        transition: all 0.2s ease;
    }
</style>
<style>
    .custom-header th {
        background: linear-gradient(180deg, #eef3f8, #d8e3ef);
        color: #16202b;
        font-weight: 700;
        text-align: center;
        border-bottom: 0px solid #b6c6d6;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,0.05);
    }
</style>
<div class="card mb-2 shadow-sm" style="border-radius: 6px; overflow: hidden;">
    <div class="card-header text-white d-flex align-items-center py-1 px-3"
         style="background:#2b6ac9">

        <h6 class="mb-0 me-auto" style="font-size: 0.85rem;">
            Create Sales Return
        </h6>

        <button type="button"
                id="refreshBtn"
                class="btn btn-sm p-1 me-2 border-0 bg-transparent text-white"
                title="Refresh">
            <span class="fs-5">🔄</span>
        </button>
    </div>
</div>
<form asp-controller="StockReturn" asp-action="Create" method="post">
    <input type="hidden" asp-for="CustomerId" id="CustomerId" />
    <input type="hidden" asp-for="PharmacyDoctorId" id="DoctorId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="container">
        <div class="row">
            <div class="row mb-2">

                <label asp-for="ChallanNo" class="col-md-2 col-form-label text-start small"> Challan No <i class="redColor">*</i> </label>
                <div class="col-md-2">
                    <input asp-for="ChallanNo" type="text" class="form-control form-control-sm" required />
                    <span asp-validation-for="ChallanNo" class="text-danger"></span>
                </div>
                 
                <label asp-for="ChallanDate" class="col-md-2 col-form-label text-start small">Challan Date <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input type="date" asp-for="ChallanDate" id="ChallanDate" class="form-control form-control-sm" required />
                    <span asp-validation-for="ChallanDate" class="text-danger"></span>
                </div>
                <label class="col-md-2 ">Billing Type</label>
                <div class="col-md-2">
                    <select asp-for="billingType" id="billingType" class="form-control form-control-sm">
                        <option value="walkin">Cash</option>
                        <option value="registered">Customer</option>
                    </select>
                </div>
                <label class="col-md-2 col-form-label text-start small">Mobile No <i class="redColor">*</i></label>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="w-100">
                        <input asp-for="MobileNo" type="text" class="form-control form-control-sm" id="mobilenumber" />
                        <span asp-validation-for="MobileNo" class="text-danger"></span>
                    </div>
                    <div class="shortcut-box">
                        <span id="btnF1CustomerList" class="shortcut-link">F1 - List</span>
                    </div>
                </div>

                <label class="col-md-2 col-form-label text-start small">Customer <i class="redColor">*</i></label>
                <div class="col-md-2">
                    <input asp-for="CustomerName" class="form-control form-control-sm" id="customer" readonly />
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>

                <label class="col-md-2 col-form-label text-start small">Address <i class="redColor">*</i></label>
                <div class="col-md-2 mt-2 mt-md-0">
                    <input asp-for="Address" id="customeraddress" class="form-control form-control-sm" readonly />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                @if (Model.DoctorRequired)
                {
                    <label class="col-md-2 col-form-label small">Doctor Mobile No <i class="redColor">*</i></label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorMobileNumber" class="form-control form-control-sm" id="doctorMobile" maxlength="10"/>
                    </div>

                    <label class="col-md-2 col-form-label small">Doctor <i class="redColor"></i></label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorName" class="form-control form-control-sm" id="doctorname" />
                    </div>

                    <label class="col-md-2 col-form-label small">Registration Number <i class="redColor"></i></label>
                    <div class="col-md-2">
                        <input type="text" asp-for="DoctorRegNumber" class="form-control form-control-sm" id="doctorregno" />
                    </div>
                }

                <label class="col-md-2 col-form-label text-start small">Type</label>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-check form-switch">
                        <input class="form-check-input"
                               type="checkbox"
                               id="paymentToggle">
                        <label class="form-check-label fw-bold" id="paymentToggleLabel" style="color: green;">
                            Cash
                        </label>
                    </div> 
                    <input type="hidden" asp-for="PaymentType" id="paymentTypeHidden" value="cash" />
                </div>
            </div>


        </div>

        <!-- Items Table -->
        <div style="overflow-x: auto; width: 100%;">
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table custom-header">
                        <tr>
                            <th style="min-width:30%">Item</th>
                            <th style="min-width:30%">Batch</th>
                            <th class="text-center">Expiry</th>
                            <th class="text-center">Mrp</th>
                            @if (ViewBag.BusinessType == 2)
                            {
                                <th class="text-center" id="qtyView">Qty</th>
                                <th class="text-center" id="qtyTabsView">Tabs</th>
                            }
                            else
                            {
                                <th class="text-center">Qty</th>
                            }
                            <th class="text-center">Rate</th>
                            <th class="text-center">Gst %</th>
                            <th class="text-center">Cess</th>
                            <th class="text-center">Disc %</th>
                            <th class="text-center">Amount</th>
                            <th class="text-center">Reason</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="StockReturnItemBody"></tbody>
                    <tfoot>
                        <tr>
                            <th colspan="11">
                                <u id="addRow" style="color:green; cursor:pointer;">Add Row</u>
                            </th>
                        </tr>
                    </tfoot>
                </table>

                <!-- Totals -->
                <div class="row mt-3">

                    <!-- ===============================
                    LEFT : ITEM EXTRA INFO (WIDER)
                    =============================== -->
                    <div class="col-md-8">
                        <div id="itemExtraInfoWrapper" class="border rounded p-2 h-100" style="display:block;">
                            <table class="table table-bordered table-sm mb-0 text-center">
                                <thead class="table-light">
                                    <tr>
                                        <th>BillNo</th>
                                        <th>Batch</th>
                                        <th>SalesQty</th>
                                        <th>ReturnQty</th>
                                        <th>Remaining</th>
                                    </tr>
                                </thead>
                                <tbody id="itemExtraInfoBody">
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ===============================
                    RIGHT : TOTALS (COMPACT)
                    =============================== -->
                    <div class="col-md-4">
                        <div class="row mb-2">
                            <label asp-for="Total" class="col-md-3 col-form-label text-start small">Total</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="Total" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label class="col-md-3 col-form-label text-start small">Bill Discount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-2">
                                <input asp-for="discountPercent" id="discountPercent" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <input asp-for="discountAmount" id="discountamount" class="form-control form-control-sm" placeholder="amount" />
                            </div>

                        </div>
                        <div class="row mb-2">
                            <label asp-for="Totaldiscount" class="col-md-3 col-form-label text-start small">Total Discount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="Totaldiscount" id="Totaldiscount" class="form-control form-control-sm" readonly />
                            </div>

                        </div>

                        <div class="row mb-2">
                            <label asp-for="TotalGstAmt" class="col-md-3 col-form-label text-start small">Gst</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="TotalGstAmt" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="TotalCessAmt" class="col-md-3 col-form-label text-start small">TotalCess Amt</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="TotalCessAmt" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label asp-for="TotalPayable" class="col-md-3 col-form-label text-start small">Total Amount</label>
                            <div class="col-md-4"></div>
                            <div class="col-md-5">
                                <input asp-for="TotalPayable" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Buttons -->
        <div class="mt-3 text-end">
            <button type="submit" class="btn btn-sm btn-primary">End | Save 💾</button>
            <a asp-controller="StockReturn" asp-action="Index" id="btnCancel" class="btn btn-sm btn-secondary">F11 | Cancel ❌</a>
        </div>
    </div>
</form>

