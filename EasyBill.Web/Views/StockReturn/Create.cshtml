        // ==========================================================
        // 🔹 UTILITY FUNCTIONS
        // ==========================================================
        function highlightItemRow($rows, index) {
            $rows.removeClass("selected");
            const $row = $rows.eq(index);
            $row.addClass("selected");
            $row[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
        }

        function highlightBatchRow($rows, index) {
            $rows.removeClass("selected");

            const $row = $rows.eq(index);
            if (!$row.length) return;

            $row.addClass("selected");

            const container = document.querySelector("#batchModal .batch-table-wrapper");
            if (!container) return;

            const rowRect = $row[0].getBoundingClientRect();
            const containerRect = container.getBoundingClientRect();
            const headerHeight = document.querySelector("#batchTable thead")?.offsetHeight || 50;

            if (rowRect.top < containerRect.top + headerHeight) {
                container.scrollTop -= (containerRect.top + headerHeight - rowRect.top);
            }
            else if (rowRect.bottom > containerRect.bottom) {
                container.scrollTop += (rowRect.bottom - containerRect.bottom);
            }
        }

        function loadReturnedQtyData(customerId) {
            $.get(`/StockReturn/GetReturnedQtyData?customerId=${customerId}`, function (data) {
                returnedQtyData = data;
            });
        }

        function fetchItemsByCustomerId(customerId) {
            $.ajax({
                url: '/StockReturn/GetItemsByCustomerId',
                type: 'GET',
                data: { customerId: customerId },
                success: function (res) {
                    if (res.success) {
                        customerItemList = res.items;
                    } else {
                        toastr.warning("No items found for this customer.");
                        customerItemList = [];
                    }
                },
                error: function () {
                    toastr.error("Failed to load items for customer.");
                    customerItemList = [];
                }
            });
        }

        function formatExpiryDate(input) {
            let value = $(input).val().replace(/[^\d]/g, '');

            if (value.length >= 3) {
                value = value.slice(0, 2) + '/' + value.slice(2, 6);
            }
            $(input).val(value.slice(0, 7));
        }

        // ==========================================================
        // 🔹 ITEM MODAL FUNCTIONS
        // ==========================================================
        function openItemModal(searchText = "") {
            showLoader("Loading items...");

            let customerId = $('#CustomerId').val();
            let billingType = $('#billingType').val();
            $.ajax({
                url: '/StockReturn/GetItemsByCustomerId',
                type: 'GET',
                data: { customerId: customerId,  billingType: billingType },
                success: function (res) {
                    hideLoader();

                    if (!res.success || !res.items || res.items.length === 0) {
                        toastr.warning("No items found for this customer.");
                        return;
                    }

                    const businessType = @ViewBag.BusinessType;
                    let rows = "";
                    res.items.forEach(item => {
                        rows += `
                            <tr class="item-row" tabindex="0"
                                data-itemid="${item.value}"
                                data-name="${item.text}"
                                data-conversion="${item.conversion || 1}">
                                <td>${item.text}</td>
                                ${
                                    businessType === 2
                                    ? `
                                        <td style="display:none;">${item.qty || 0}</td>
                                        <td>${item.displayQty}</td>
                                      `
                                    : `
                                        <td>${item.qty || 0}</td>
                                      `
                                }
                                <td>${item.unit || 'N/A'}</td>
                                <td>${item.mrp || 0}</td>
                            </tr>`;
                    });

                    $("#itemTableBody").html(rows);
                    $("#itemSearch").val(searchText);
                    $("#itemSearch").trigger("input");

                    $("#itemModal").modal("show");
                },
                error: function () {
                    hideLoader();
                    toastr.error("Error loading items");
                }
            });
        }

        $(document).on("input", "#itemSearch", function () {
            const searchWords = $(this).val()
                .toLowerCase()
                .trim()
                .split(/\s+/);

            $("#itemTableBody tr").each(function () {
                const itemText = $(this).find("td:first").text().toLowerCase();
                const itemWords = itemText.split(/\s+/);

                let match = true;

                for (let i = 0; i < searchWords.length; i++) {
                    if (!itemWords[i] || !itemWords[i].startsWith(searchWords[i])) {
                        match = false;
                        break;
                    }
                }

                $(this).toggle(match);
            });

            currentItemIndex = -1;
            $("#itemTableBody .item-row").removeClass("selected");
        });

        $(document).on("click", ".item-row", function () {
            const itemId = $(this).data("itemid");
            const itemName = $(this).data("name");
            const customerId = $("#CustomerId").val();
            const conversion = parseFloat($(this).data("conversion")) || 1;

            if (!itemId || !currentRowForItemModal) return;

            currentRowForItemModal.find(".item-id").val(itemId);
            currentRowForItemModal.find(".item-input").val(itemName);
            currentRowForItemModal.attr("data-conversion", conversion);

            // Store in global object
            itemConversionMap[itemId] = conversion;


            $("#itemModal").modal("hide");

            // Load batches for selected item
            loadBatchesForItem(itemId, currentRowForItemModal);
            loadItemSalesReturnSummary(customerId, itemId);
        });

        $(document).on("mouseenter", ".item-row", function () {
            if (!$("#itemModal").is(":visible")) return;
            if (isKeyboardScrollingItemModal) return;

            itemNavMode = "mouse";

            $("#itemModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".item-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentItemIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#itemModal", function () {
            isKeyboardScrollingItemModal = false;
        });

        $('#itemModal').on('shown.bs.modal', function () {
            itemNavMode = "keyboard";

            $("#itemModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".item-row:visible");

            currentItemIndex = -1;

            if ($rows.length) {
                currentItemIndex = 0;
                highlightItemRow($rows, currentItemIndex);
            }

            setTimeout(() => {
                $("#itemSearch").focus().select();
            }, 200);
        });

        $('#itemModal').on('hidden.bs.modal', function () {
            setTimeout(() => {
                if (currentRowForItemModal && currentRowForItemModal.length) {
                    currentRowForItemModal.find(".item-input").focus();
                }
            }, 150);
        });

        // Item Modal Keyboard Navigation
        $(document).on("keydown", function (e) {
            if (!$("#itemModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                itemNavMode = "keyboard";
                isKeyboardScrollingItemModal = true;
                $("#itemModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".item-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentItemIndex === -1) {
                    currentItemIndex = 0;
                }
                else if (currentItemIndex < $rows.length - 1) {
                    currentItemIndex++;
                }

                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();
                if (currentItemIndex <= 0) return;
                currentItemIndex--;
                highlightItemRow($rows, currentItemIndex);
            }
            else if (e.key === "Enter" && currentItemIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentItemIndex).trigger("click");
            }
        });

        // ==========================================================
        // 🔹 BATCH MODAL FUNCTIONS
        // ==========================================================
        function loadBatchesForItem(itemId, row) {
            currentRow = row;
            showLoader("Loading batches...");
            let billingType = $('#billingType').val();
            let customerId = $('#CustomerId').val();
            $.get('/StockReturn/GetBatchesByItemId', { id: itemId, customerId: customerId, billingType: billingType }, function (data) {
                hideLoader();

                if (data.error || !data.groupedResult || data.groupedResult.length === 0) {
                    toastr.info("No batches found for this item");
                    return;
                }

                groupedPurchaseData = data.groupedResult;
                let batchRows = '';
                const businessType = @ViewBag.BusinessType;

                data.groupedResult.forEach(batch => {
                    const expiryDate = new Date(batch.expiry);
                    const month = String(expiryDate.getMonth() + 1).padStart(2, '0');
                    const year = expiryDate.getFullYear();
                    const formattedExpiry = `${month}/${year}`;

                    batch.conversion = batch.conversion || 1;

                    const encoded = encodeURIComponent(JSON.stringify(batch));

                    // CONDITIONAL QTY COLUMNS
                    let qtyColumns = '';
                    if (businessType === 2) {
                        qtyColumns = `
                            <td style="display:none;">${batch.qty}</td>
                            <td>${batch.stripTabsQty}</td>
                        `;
                    } else {
                        qtyColumns = `<td>${batch.qty}</td>`;
                    }

                    batchRows += `
                        <tr class="batch-row" tabindex="0" data-batch="${encoded}">
                            <td>${batch.batch}</td>
                            <td>${formattedExpiry}</td>
                            <td hidden>${batch.rate.toFixed(4)}</td>
                             <td>${batch.striprate.toFixed(2)}</td>
                            <td>${batch.mrp}</td>
                            ${qtyColumns}
                        </tr>`;
                });

                currentRow.find(".gst").val(data.gst);
                currentRow.find(".cess").val(data.cess);
                $("#batchTableBody").html(batchRows);

                const $rows = $(".batch-row");
                currentBatchIndex = -1;

                if ($rows.length) {
                    currentBatchIndex = 0;
                    highlightBatchRow($rows, currentBatchIndex);
                }

                $("#batchModal").modal("show");
            }).fail(function() {
                hideLoader();
                toastr.error("Error loading batches");
            });
        }

