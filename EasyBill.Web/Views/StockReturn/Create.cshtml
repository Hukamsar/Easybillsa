        function calculateRow(row) {
            debugger;
            let qty = parseFloat(row.find(".qty").val()) || 0;
            let rate = parseFloat(row.find(".rate").val()) || 0;
            let gst = parseFloat(row.find(".gst").val()) || 0;
            let cess = parseFloat(row.find(".cess").val()) || 0;
            let discount = parseFloat(row.find(".discount").val()) || 0;
            let stripRate = parseFloat(row.find(".stripe-rate").val()) || 0;
            // ✅ TABLET-WISE CALCULATION
            let grossAmount = 0;
            let totalTablets = qty;

            if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                const itemId = row.find(".item-id").val();
                let conversion = parseFloat(row.attr("data-conversion"));

                if (!conversion || conversion <= 0) {
                    conversion = itemConversionMap[itemId] || 1;
                }

                const tabletQty = parseFloat(row.find(".tablet-qty").val()) || 0;

                // TOTAL TABLETS = (Strips × Conversion) + Remaining Tablets
                totalTablets = (qty * conversion) + tabletQty;

                // RATE IS PER TABLET
              //  grossAmount = totalTablets * rate/conversion;
                grossAmount = (totalTablets / conversion) * stripRate;
            } else {
                // STRIP-WISE: Rate is per strip
              //  grossAmount = qty * rate;
               const itemId = row.find(".item-id").val();
                let conversion = parseFloat(row.attr("data-conversion"));

                if (!conversion || conversion <= 0) {
                    conversion = itemConversionMap[itemId] || 1;
                }

                let totalTablets = qty * conversion;

               // grossAmount = totalTablets * rate;
                grossAmount = totalTablets * stripRate;
            }

            // DISCOUNT
            let discountAmt = (grossAmount * discount) / 100;
            let amountAfterDiscount = grossAmount - discountAmt;

            // GST
            let gstAmt = (amountAfterDiscount * gst) / 100;
            let cessAmt = (amountAfterDiscount * cess) / 100;
            let total = amountAfterDiscount + gstAmt + cessAmt;

            row.find(".discount-amt").val(discountAmt.toFixed(2));
            row.find(".Amount").val(total.toFixed(2));

            calculateTotalSummary();
        }


