@using EasyBill.Models.ViewModels
@model StockReturnVM
@{
    ViewData["Title"] = "Create Stock Return";
}

<style>
    /* ===============================
               ITEM MODAL STYLING
               =============================== */
    #itemModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

    #itemModal .modal-header .btn-close {
        filter: invert(1);
    }

    #itemTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .item-row.selected td {
        background-color: #d4af37 !important; /* GOLD */
        color: #000 !important;
        font-weight: 500;
    }

    /* ❌ Keyboard navigation active → hover disabled */
    #itemModal.keyboard-nav .item-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    /* 🖱️ Mouse navigation active → hover enabled */
    #itemModal.mouse-nav .item-row:hover td {
        background-color: #f1d27a !important; /* LIGHT GOLD */
        color: #000 !important;
        cursor: pointer;
    }

    .item-row:focus {
        outline: none;
    }

    .item-row {
        scroll-margin-top: 50px;
    }

    .item-table-wrapper {
        max-height: 350px;
        overflow-y: auto;
        position: relative;
    }

    .shortcut-box {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        line-height: 14px;
        margin-left: 6px;
    }

    .shortcut-link {
        font-size: 11px;
        color: #2465c7;
        cursor: pointer;
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
    }

        .shortcut-link:hover {
            text-decoration: underline;
        }

    #customerListModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

        #customerListModal .modal-header .btn-close {
            filter: invert(1);
        }

    .customer-table-wrapper {
        min-height: 50px;
        max-height: 350px;
        overflow-y: auto;
    }

    #customerTable thead th {
        position: sticky;
        top: 0;
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        z-index: 2;
    }

    .customer-row.selected td {
        background-color: #d4af37 !important;
        color: #000 !important;
        font-weight: 500;
    }

    #customerListModal.keyboard-nav .customer-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }

    #customerListModal.mouse-nav .customer-row:hover td {
        background-color: #f1d27a !important;
        color: #000 !important;
        cursor: pointer;
    }

    .customer-row {
        scroll-margin-top: 50px;
    }

        .customer-row:focus {
            outline: none;
        }
</style>
<style> 
    #batchModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
    }

    #batchModal .modal-header .btn-close {
        filter: invert(1);
    }

    #batchTable thead th {
        background-color: #2465c7f7 !important;
        color: #fff !important;
        font-weight: 700;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .batch-row.selected td {
        background-color: #d4af37 !important; /* GOLD */
        color: #000 !important;
        font-weight: 500;
    }
     
    #batchModal.keyboard-nav .batch-row:hover td {
        background-color: inherit !important;
        color: inherit !important;
        cursor: default;
    }
     
    #batchModal.mouse-nav .batch-row:hover td {
        background-color: #f1d27a !important; /* LIGHT GOLD */
        color: #000 !important;
        cursor: pointer;
    }

    .batch-row:focus {
        outline: none;
    }

    .batch-row {
        scroll-margin-top: 50px;
    }
     
    .batch-table-wrapper {
        max-height: 350px;
        overflow-y: auto;
        position: relative;
    }
     
    #createDoctorModal .modal-header {
        background-color: #2465c7f7;
        color: #fff;
