        $(document).on("click", ".batch-row", function () {
            $(".batch-row").removeClass("selected");
            $(this).addClass("selected");

            const encoded = $(this).attr("data-batch");
            try {
                const batch = JSON.parse(decodeURIComponent(encoded));

                if (currentRow) {
                    currentRow.find(".batch").val(batch.batch);
                    currentRow.find(".rate").val(batch.rate.toFixed(4) || 0);
                    currentRow.find(".stripe-rate").val(batch.striprate.toFixed(2) || 0);
                    currentRow.find(".mrp").val(batch.mrp || 0);

                    const conversion = parseFloat(batch.conversion) || 1;
                    const qty = parseFloat(batch.qty) || 0;

                    if (isTabletWiseMode) {

                        // 🔹 convert to total tablets and make integer
                        const totalTablets = Math.round(qty * conversion);

                        const strips = Math.floor(totalTablets / conversion);
                        const remainingTabs = totalTablets % conversion;

                        currentRow.find(".qty").val(strips);
                        currentRow.find(".tablet-qty").val(remainingTabs);

                    } else {
                        currentRow.find(".qty").val(qty);
                    }

                    currentRow.attr("data-conversion", conversion);

                    const itemId = currentRow.find(".item-id").val();
                    itemConversionMap[itemId] = conversion;

                    if (batch.expiry) {
                        let date = new Date(batch.expiry);
                        let formatted = ("0" + (date.getMonth() + 1)).slice(-2) + "/" + date.getFullYear();
                        currentRow.find(".expirydate").val(formatted);
                    }

                    calculateRow(currentRow);
                }

                $("#batchModal").modal("hide");

            } catch (err) {
                alert("Invalid batch data.");
                console.error(err);
            }
        });

        // Batch Modal Keyboard Navigation
        $(document).on("keydown", function (e) {
            if (!$("#batchModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                batchNavMode = "keyboard";
                isKeyboardScrollingBatchModal = true;

                $("#batchModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".batch-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentBatchIndex === -1) {
                    currentBatchIndex = 0;
                } else if (currentBatchIndex < $rows.length - 1) {
                    currentBatchIndex++;
                }

                highlightBatchRow($rows, currentBatchIndex);
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();
                if (currentBatchIndex <= 0) return;

                currentBatchIndex--;
                highlightBatchRow($rows, currentBatchIndex);
            }
            else if (e.key === "Enter" && currentBatchIndex >= 0) {
                e.preventDefault();
                $rows.eq(currentBatchIndex).trigger("click");
            }
        });

        $(document).on("mouseenter", ".batch-row", function () {
            if (!$("#batchModal").is(":visible")) return;

            if (isKeyboardScrollingBatchModal) return;

            batchNavMode = "mouse";

            $("#batchModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".batch-row:visible");
            $rows.removeClass("selected");

            $(this).addClass("selected");
            currentBatchIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#batchModal", function () {
            isKeyboardScrollingBatchModal = false;
        });

