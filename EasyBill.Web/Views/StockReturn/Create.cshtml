        function calculateTotalSummary() {
            debugger;
            let total = 0;
            let totalGst = 0;
            let totalCess = 0;
            let totalDiscount = 0;
            let totalamt = 0;
            let gstRows = [];

            $("#StockReturnItemBody tr").each(function () {
                let row = $(this);
                let qty = parseFloat(row.find(".qty").val()) || 0;
                let rate = parseFloat(row.find(".rate").val()) || 0;
                let gst = parseFloat(row.find(".gst").val()) || 0;
                let cess = parseFloat(row.find(".cess").val()) || 0;
                let discount = parseFloat(row.find(".discount").val()) || 0;
                let stripRate = parseFloat(row.find(".stripe-rate").val()) || 0;
                // ✅ TABLET-WISE CALCULATION (SAME AS calculateRow)
                let grossAmount = 0;

                if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                    const itemId = row.find(".item-id").val();
                    let conversion = parseFloat(row.attr("data-conversion"));

                    if (!conversion || conversion <= 0) {
                        conversion = itemConversionMap[itemId] || 1;
                    }

                    const tabletQty = parseFloat(row.find(".tablet-qty").val()) || 0;
                    let totalTablets = (qty * conversion) + tabletQty;
                   // grossAmount = totalTablets * rate /conversion;
                    grossAmount = (totalTablets / conversion) * stripRate;
                } else {
                  //  grossAmount = qty * rate;
                   const itemId = row.find(".item-id").val();
                     let conversion = parseFloat(row.attr("data-conversion"));

                     if (!conversion || conversion <= 0) {
                         conversion = itemConversionMap[itemId] || 1;
                     }

                     let totalTablets = qty * conversion;
                      
                    grossAmount = totalTablets * stripRate;
                }

                let discountAmt = (grossAmount * discount) / 100;
                let amountAfterDiscount = grossAmount - discountAmt;
                let gstAmt = (amountAfterDiscount * gst) / 100;
                let cessAmt = (amountAfterDiscount * cess) / 100;

                total += amountAfterDiscount;
                totalamt += amountAfterDiscount;
                totalGst += gstAmt;
                totalCess += cessAmt;
                totalDiscount += discountAmt;
                gstRows.push({ rate: amountAfterDiscount, gst: gst, cess:cess });
            });



            let percentInput = parseFloat($("#discountPercent").val()) || 0;
            let amountInput = parseFloat($("#discountamount").val()) || 0;

            let globalDiscountPercent = 0;
            let globalDiscountAmt = 0;

            if ($("#discountPercent").is(":focus") || (percentInput > 0 && amountInput === 0)) {
                globalDiscountPercent = percentInput;
                globalDiscountAmt = (total * globalDiscountPercent) / 100;
                $("#discountamount").val(globalDiscountAmt.toFixed(2));
            }
            else if ($("#discountamount").is(":focus") || (amountInput > 0 && percentInput === 0)) {
                globalDiscountAmt = amountInput;
                globalDiscountPercent = (globalDiscountAmt / total) * 100;
                $("#discountPercent").val(globalDiscountPercent.toFixed(2));
            } else if (percentInput > 0 && amountInput > 0) {
                globalDiscountPercent = percentInput;
                globalDiscountAmt = amountInput;

                globalDiscountAmt = (total * globalDiscountPercent) / 100;
                $("#discountamount").val(globalDiscountAmt.toFixed(2));
            }

            if (globalDiscountAmt > 0) {
                totalDiscount += globalDiscountAmt;
                totalamt = total - globalDiscountAmt;

                totalGst = 0;
                totalCess = 0;
                gstRows.forEach(row => {
                    let rowDiscountAmt = (row.rate * globalDiscountPercent) / 100;
                    let rowAfterGlobalDiscount = row.rate - rowDiscountAmt;
                    let gstAmt = (rowAfterGlobalDiscount * row.gst) / 100;
                     let cessAmt = (rowAfterGlobalDiscount * row.cess) / 100;
                    totalGst += gstAmt;
                    totalCess += cessAmt;
                });
            }

            let totalPayable = totalamt + totalGst + totalCess;

            $("[name='Total']").val(totalamt.toFixed(2));
            $("[name='Totaldiscount']").val(totalDiscount.toFixed(2));
            $("[name='TotalGstAmt']").val(totalGst.toFixed(2));
            $("[name='TotalCessAmt']").val(totalCess.toFixed(2));
            $("[name='TotalPayable']").val(totalPayable.toFixed(2));
        }

        // NEW VALIDATION HANDLER (Bill discount validation)
        $("#discountPercent").on("input", function() {
            let value = parseFloat($(this).val()) || 0;

            // HARD LIMIT: Cannot exceed 100%
            if (value > 100) {
                toastr.error("Discount cannot exceed 100%", "Invalid Discount");
                $(this).val(100); // Set to max 100
                return;
            }

            // WARNING: If discount > 50%
            if (value > 50) {
                toastr.warning("High discount alert: " + value + "%", "Review Required");
            }
        });

        function validateQtyPure($input) {
            const $row = $input.closest("tr");

            const itemId = $row.find(".item-id").val();
            const batch = $row.find(".batch").val()?.trim();
            const expiry = $row.find(".expirydate").val()?.trim();
            const mrp = parseFloat($row.find(".mrp").val()) || 0;
            const rate = parseFloat($row.find(".rate").val()) || 0;

            console.group("🧪 validateQtyPure()");
            console.log("Row Values →", { itemId, batch, expiry, mrp, rate });

            if (!expiry || !expiry.includes('/')) {
                console.warn("❌ Expiry missing or invalid");
                console.groupEnd();
                return;
            }

            const [mm, yyyy] = expiry.split('/');
            const formattedExpiry = `${yyyy}-${mm.padStart(2, '0')}-01`;

            console.log("Formatted Expiry →", formattedExpiry);
            console.log("GroupedPurchaseData →", groupedPurchaseData);

            // ================================================================
            // 🔹 STEP 1: FIND MATCHED PURCHASE RECORD
            // ================================================================
            const matched = groupedPurchaseData.find(g => {
                const match =
                    g.itemId == itemId &&
                    g.batch?.toLowerCase() === batch?.toLowerCase() &&
                    g.expiry?.split("T")[0] === formattedExpiry &&
                    parseFloat(g.mrp) === mrp &&
                    parseFloat(g.rate) === rate;

                if (match) {
                    console.log("✅ MATCH FOUND →", g);
                }

                return match;
            });

            console.log("Matched Record →", matched);

            if (!matched) {
                console.error("❌ NO MATCH FOUND");
                toastr.error("No purchase record found for this item group.");
                $input.val('');
                calculateRow($row);
                console.groupEnd();
                return;
            }

            // ================================================================
            // 🔹 STEP 2: GET CONVERSION (for TabletWise mode)
            // ================================================================
            let conversion = 1;

            if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                conversion =
                    parseFloat($row.attr("data-conversion")) ||
                    itemConversionMap[itemId] ||
                    1;

                console.log("🔢 Conversion Factor:", conversion);
            }

            // ================================================================
            // 🔹 STEP 3: CALCULATE TOTAL ALREADY ENTERED (IN TABLETS)
            // ================================================================
            let totalEnteredTablets = 0;
            debugger;
            $("#StockReturnItemBody tr").each(function () {
                const row = $(this);

                const rowItemId = row.find(".item-id").val();
                const rowBatch = row.find(".batch").val()?.trim();
                const rowExpiry = row.find(".expirydate").val()?.trim();
                const rowMrp = parseFloat(row.find(".mrp").val()) || 0;
                const rowRate = parseFloat(row.find(".rate").val()) || 0;

                if (!rowExpiry || !rowExpiry.includes('/')) return;

                const [rmm, ryyyy] = rowExpiry.split('/');
                const rowFormattedExpiry = `${ryyyy}-${rmm.padStart(2, '0')}-01`;

                // ✅ CHECK IF SAME ITEM GROUP
                if (
                    rowItemId == itemId &&
                    rowBatch?.toLowerCase() === batch?.toLowerCase() &&
                    rowFormattedExpiry === formattedExpiry &&
                    rowMrp === mrp &&
                    rowRate === rate
                ) {
                    if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                        // ✅ TABLETWISE: Convert strips + tabs → total tablets
                        let strips = parseFloat(row.find(".qty").val()) || 0;
                        let tabs = parseFloat(row.find(".tablet-qty").val()) || 0;
                        let rowTotalTablets = (strips * conversion) + tabs;

                        totalEnteredTablets += rowTotalTablets;

                        console.log(`Row Contribution: ${strips} strips + ${tabs} tabs = ${rowTotalTablets} tablets`);
                    } else {
                        // ✅ STRIPWISE: Just add qty
                        let rowQty = parseFloat(row.find(".qty").val()) || 0;
                        totalEnteredTablets += rowQty;
                    }
                }
            });

            console.log("📊 Total Entered (Current Grid):", totalEnteredTablets);

            // ================================================================
            // 🔹 STEP 4: GET ALREADY RETURNED QTY (from previous returns)
            // ================================================================
            const alreadyReturned = returnedQtyData.find(r =>
                r.itemMasterId == itemId &&
                r.batch?.toLowerCase() === batch?.toLowerCase() &&
                r.expiry?.split('T')[0] === formattedExpiry &&
                parseFloat(r.mrp) === mrp &&
                parseFloat(r.rate) === rate
            )?.returnedQty || 0;

            console.log("📦 Already Returned (Previous):", alreadyReturned);

            // ================================================================
            // 🔹 STEP 5: CALCULATE AVAILABLE QTY (in tablets)
            // ================================================================
            let totalAvailableTablets = 0;

            if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                // ✅ TABLETWISE: matched.qty is in STRIPS, convert to tablets
                totalAvailableTablets = matched.qty * conversion;

                console.log(`💊 Available: ${matched.qty} strips × ${conversion} = ${totalAvailableTablets} tablets`);
            } else {
                // ✅ STRIPWISE: matched.qty is already in correct unit
                totalAvailableTablets = matched.qty;

                console.log(`📦 Available: ${totalAvailableTablets} qty`);
            }

            // ================================================================
            // 🔹 STEP 6: VALIDATE & SET TO 0 IF EXCEEDED
            // ================================================================

            
            if (totalEnteredTablets > totalAvailableTablets) {

                if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                    // ✅ TABLETWISE: Set both Strip and Tabs to 0

                    toastr.error(
                        `Only ${totalAvailableTablets} tablets available for return. Please enter correct quantity.`,
                        "Quantity Exceeded"
                    );

                    console.log(`❌ Resetting to: Strip=0, Tabs=0`);

                    // ✅ Set both to 0
                    $row.find(".qty").val(0);
                    $row.find(".tablet-qty").val(0);

                    calculateRow($row);
                    console.groupEnd();
                    return;

                } else {
                    // ✅ STRIPWISE: Set to 0 (old behavior)

                    toastr.error(
                        `Only ${totalAvailableTablets} qty available for return. Please enter correct quantity.`,
                        "Quantity Exceeded"
                    );

                    $input.val(0);
                }
            }

            console.groupEnd();
            calculateRow($row);
        }

