@section Scripts {

    <script>
        $(document).on("focus", "#billingType", function() {
            const select = this;

            setTimeout(() => {
                if ('showPicker' in HTMLSelectElement.prototype) {
                    select.showPicker();
                } else {
                    $(select).trigger('click');
                }
            }, 50);
        });
        $(document).ready(function () {
            applyBillingType($("#billingType").val());
        });

        $(document).on("change", "#paymentToggle", function () {
            if ($(this).is(":checked")) {
                $("#paymentToggleLabel").text("Credit");
                $("#paymentTypeHidden").val("credit");
                // Auto change Billing Type to Customer
                $("#billingType").val("registered");
            } else {
                $("#paymentToggleLabel").text("Cash");
                $("#paymentTypeHidden").val("cash");
                // Auto change Billing Type to Cash (walkin)
                $("#billingType").val("walkin");
            }

            // Apply Billing Type behavior (enable/disable fields)
            applyBillingType($("#billingType").val());
        });
        function applyBillingType(type) {
            setTimeout(() => {
                if (type === "walkin") {
                    $("#mobilenumber, #customer, #customeraddress")
                        .val("")
                        .prop("disabled", true);

                    // Hide phone validation error when disabled
                    hidePhoneError();
                } else if (type === "registered") {
                    $("#mobilenumber, #customer, #customeraddress")
                        .prop("disabled", false);
                    $("#mobilenumber").focus();
                }
                isEnterNavigation = false;
            }, 100);
        }
        $("#billingType").on("change", function () {
            isEnterNavigation = false;
            const billingType = this.value;

            // Auto change Payment Type based on Billing Type
            if (billingType === "registered") {
                // $("#paymentToggle").prop("checked", true);
                // $("#paymentToggleLabel").text("Credit");
                // $("#paymentTypeHidden").val("credit");
            } else if (billingType === "walkin") {
                $("#paymentToggle").prop("checked", false);
                $("#paymentToggleLabel").text("Cash");
                $("#paymentTypeHidden").val("cash");
            }
            applyBillingType(this.value);
        });

        $(document).on("keydown", "#ChallanDate", function (e) {
            debugger;
            if (e.key !== "Enter") return;

            e.preventDefault();
            e.stopImmediatePropagation();

            //$("#billingType").focus();
            $("#paymentToggle").focus();
        });

        $(document).on("keydown", "#billingType", function (e) {
            if (e.key === "ArrowUp" || e.key === "ArrowDown") return;

            if (e.key === "Enter") {
                e.preventDefault();
                e.stopImmediatePropagation();

                const type = this.value;

                if (type === "registered") {
                    $("#mobilenumber").prop("disabled", false).focus();
                } else {
                    $("#mobilenumber, #customer, #customeraddress")
                        .val("")
                        .prop("disabled", true);

                    hidePhoneError();

                    if ($("#doctorMobile").length && $("#doctorMobile").is(":visible") &&
                        !$("#doctorMobile").is(":disabled")) {
                        $("#doctorMobile").focus();
                    } else {
                        //focusItemGrid();
                        focusItemGridOrAddRow();
                    }
                }
            }
        });
    </script>

    <script>
        // ================================================================
        // 🔹 PAYMENT TOGGLE NAVIGATION
        // ================================================================
        $(document).on("keydown", "#paymentToggle", function (e) {
            // Arrow Left/Right for toggle
            if (e.key === "ArrowLeft" || e.key === "ArrowRight") {
                e.preventDefault();

                // Toggle the checkbox
                $(this).prop("checked", !$(this).is(":checked")).trigger("change");
                return;
            }

            // Enter key - move to Billing Type
            if (e.key === "Enter") {
                e.preventDefault();
                e.stopImmediatePropagation();

                // Focus on Billing Type and open dropdown
                const billingTypeSelect = document.getElementById("billingType");
                if (billingTypeSelect) {
                    billingTypeSelect.focus();

                    setTimeout(() => {
                        if ('showPicker' in HTMLSelectElement.prototype) {
                            billingTypeSelect.showPicker();
                        } else {
                            $(billingTypeSelect).trigger('click');
                        }
                    }, 50);
                }
            }
        });
    </script>
    <script>
        // ==========================================================
        // 🌐 GLOBAL VARIABLES
        // ==========================================================
        let selectedCustomerId = null;
        let customerItemList = [];
        let returnedQtyData = [];
        let currentRow = null;
        let currentRowForItemModal = null;
        let currentBatchIndex = -1;
        let currentItemIndex = -1;
        let groupedPurchaseData = [];
        let rowIndex = 0;
        let isCustomerChangeInProgress = false;
        let currentCustomerIndex = -1;
        let customerNavMode = "keyboard";
        let isKeyboardScrollingCustomerModal = false;

        // NAVIGATION MODE TRACKING
        let batchNavMode = "keyboard";
        let isKeyboardScrollingBatchModal = false;
        let itemNavMode = "keyboard";
        let isKeyboardScrollingItemModal = false;
        let lastFocusSource = null;

        let isTabletWiseMode = false;
        let itemConversionMap = {};

        let isEnterNavigation = false;
