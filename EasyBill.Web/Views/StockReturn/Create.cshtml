         ================================================================ -->
    <script>
        $(document).on("click", "#btnF1CustomerList", function (e) {
            e.preventDefault();

            showLoader("Loading customers...");

            $.get('/Sales/GetCustomer', function (res) {
                hideLoader();

                if (!res.found || !res.data || res.data.length === 0) {
                    toastr.info("No customer found.");
                    return;
                }

                let rows = "";

                res.data.forEach(customer => {
                    const customerId = customer.id || customer.Id || "";
                    const customerName = customer.name || customer.Name || "";
                    const mobileNo = customer.phoneNo || customer.PhoneNo || "";
                    const address = customer.address || customer.Address || "";

                    rows += `<tr class="customer-row" tabindex="0"
                        data-customerid="${customerId}"
                        data-name="${customerName}"
                        data-phone="${mobileNo}"
                        data-address="${address}">
                        <td>${customerName}</td>
                        <td>${mobileNo}</td>
                    </tr>`;
                });

                $("#customerTableBody").html(rows);
                $("#customerSearch").val("");
                currentCustomerIndex = -1;
                $("#customerListModal").modal("show");
            }).fail(function () {
                hideLoader();
                toastr.error("Error loading customers");
            });
        });

        $(document).on("keydown", "#mobilenumber", function (e) {
            if (e.key !== "F1") return;

            e.preventDefault();
            e.stopImmediatePropagation();

            $("#btnF1CustomerList").trigger("click");
        });

        $(document).on("input", "#customerSearch", function () {
            const searchText = $(this).val().toLowerCase().trim();

            $("#customerTableBody tr").each(function () {
                const customerName = ($(this).data("name") || "").toString().toLowerCase();
                const mobileNo = ($(this).data("phone") || "").toString().toLowerCase();

                $(this).toggle(customerName.includes(searchText) || mobileNo.includes(searchText));
            });

            currentCustomerIndex = -1;
            $("#customerTableBody .customer-row").removeClass("selected");
        });

        $(document).on("keydown", function (e) {
            if (!$("#customerListModal").is(":visible")) return;

            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                customerNavMode = "keyboard";
                isKeyboardScrollingCustomerModal = true;
                $("#customerListModal")
                    .addClass("keyboard-nav")
                    .removeClass("mouse-nav");
            }

            const $rows = $(".customer-row:visible");
            if (!$rows.length) return;

            if (e.key === "ArrowDown") {
                e.preventDefault();

                if (currentCustomerIndex === -1) {
                    currentCustomerIndex = 0;
                }
                else if (currentCustomerIndex < $rows.length - 1) {
                    currentCustomerIndex++;
                }

                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
            else if (e.key === "ArrowUp") {
                e.preventDefault();

                if (currentCustomerIndex <= 0) return;

                currentCustomerIndex--;

                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }
            else if (e.key === "Enter") {
                e.preventDefault();

                if (currentCustomerIndex === -1) {
                    currentCustomerIndex = 0;
                }

                $rows.eq(currentCustomerIndex).trigger("click");
            }
        });

        $(document).on("click", ".customer-row", function (e) {
            e.preventDefault();

            const customerId = $(this).data("customerid");
            const customerName = $(this).data("name") || "";
            const mobileNo = $(this).data("phone") || "";
            const address = $(this).data("address") || "";

            $("#billingType").val("registered");
            $("#mobilenumber, #customer, #customeraddress").prop("disabled", false);
            $("#CustomerId").val(customerId);
            $("#mobilenumber").val(mobileNo);
            $("#customer").val(customerName);
            $("#customeraddress").val(address);

            selectedCustomerId = customerId;

            if (typeof loadReturnedQtyData === "function") {
                loadReturnedQtyData(customerId);
            }

            if (typeof fetchItemsByCustomerId === "function") {
                fetchItemsByCustomerId(customerId);
            }

            hidePhoneError();
            $("#customerListModal").modal("hide");

            setTimeout(() => {
                $("#customer").focus().select();
            }, 150);
        });

        $(document).on("mouseenter", ".customer-row", function () {
            if (!$("#customerListModal").is(":visible")) return;
            if (isKeyboardScrollingCustomerModal) return;

            customerNavMode = "mouse";

            $("#customerListModal")
                .addClass("mouse-nav")
                .removeClass("keyboard-nav");

            const $rows = $(".customer-row:visible");
            $rows.removeClass("selected");
            $(this).addClass("selected");

            currentCustomerIndex = $rows.index(this);
        });

        $(document).on("mousemove", "#customerListModal", function () {
            isKeyboardScrollingCustomerModal = false;
        });

        $('#customerListModal').on('shown.bs.modal', function () {
            customerNavMode = "keyboard";

            $("#customerListModal")
                .addClass("keyboard-nav")
                .removeClass("mouse-nav");

            const $rows = $(".customer-row:visible");

            currentCustomerIndex = -1;

            if ($rows.length) {
                currentCustomerIndex = 0;
                $rows.removeClass("selected");
                $rows.eq(currentCustomerIndex).addClass("selected");
                $rows.eq(currentCustomerIndex)[0]?.scrollIntoView({ block: "nearest", behavior: "smooth" });
            }

            setTimeout(() => {
                $("#customerSearch").focus().select();
            }, 200);
        });

        $('#customerListModal').on('hidden.bs.modal', function () {
            currentCustomerIndex = -1;
            $("#customerTableBody .customer-row").removeClass("selected");
        });
    </script>

    <script>
        function proceedCustomerSearch(mobileNo) {

            showLoader("Searching customer...");

            $.ajax({
                url: '/Sales/GetCustomerByMobile',
                type: 'GET',
                data: { mobileNo: mobileNo },
                success: function (res) {
                    hideLoader();

                    if (res.found) {

                        $('#customer').val(res.data.name);
                        $('#CustomerId').val(res.data.id);
                        $('#customeraddress').val(res.data.address);

                        selectedCustomerId = res.data.id;

                        loadReturnedQtyData(res.data.id);
                        fetchItemsByCustomerId(res.data.id);

                        toastr.success("Customer found and auto-filled.");
                    }
                    else {
                        resetItemGrid();

                        selectedCustomerId = null;
                        $('#CustomerId').val("");
                        $('#customer').val("");
                        $('#customeraddress').val("");

                        Swal.fire({
                            title: 'Customer Not Found',
                            text: 'Do you want to create a new customer?',
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonText: 'Yes, Create',
                            cancelButtonText: 'No',
                            confirmButtonColor: '#198754',
                            cancelButtonColor: '#dc3545',
                            reverseButtons: true,
                            allowEnterKey: true,
                            focusConfirm: true,
                            didOpen: () => {
                                const confirmBtn = document.querySelector('.swal2-confirm');
                                if (confirmBtn) confirmBtn.focus();
                            }
                        }).then((result) => {
                            if (result.isConfirmed) {
                                setTimeout(() => {
                                    $('#createCustomerModal').modal('show');
                                    $('#newCustomerMobile').val(mobileNo);
                                }, 0);
                            }
                        });
                    }
                },
                error: function () {
                    hideLoader();
                    toastr.error("An error occurred while searching for the customer.");

                    // ALSO FOCUS ON ERROR
                    setTimeout(() => {
                        $("#mobilenumber").focus().select();
                    }, 100);
                }
            });
        }

        function loadItemSalesReturnSummary(customerId, itemId) {
            $("#itemExtraInfoWrapper").show();

            $.get(`/StockReturn/GetSalesReturnSummary`, {
                customerId: customerId,
                itemId: itemId
            }, function (res) {

                if (!res || !res.success || !res.data || res.data.length === 0) {
                    $("#itemExtraInfoBody").html(`
                        <tr>
                            <td colspan="5" class="text-warning text-center fw-semibold">
                                No sales / return data found
                            </td>
                        </tr>
                    `);
                    return;
                }

                let rows = "";

                res.data.forEach(x => {
                    rows += `
                        <tr>
                            <td>${x.billNo}</td>
                            <td>${x.batch}</td>
                            <td class="text-end">${x.salesQty}</td>
                            <td class="text-end">${x.returnQty}</td>
                            <td class="text-end fw-semibold">
                                ${x.remainingQty}
                            </td>
                        </tr>
                    `;
                });

                $("#itemExtraInfoBody").html(rows);
            });
        }
    </script>
    <script>
        function confirmCustomerChange(callback) {
            if (typeof Swal !== 'undefined') {
                // ✅ 1. DISABLE background input
                const mobileInput = document.querySelector('#mobilenumber');
                if (mobileInput) {
                    mobileInput.setAttribute('disabled', 'true');
                    mobileInput.blur();
                }

                Swal.fire({
                    title: 'Are you sure?',
                    text: 'Changing mobile number will clear all items and calculations.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, proceed!',
                    cancelButtonText: 'No, cancel',
                    reverseButtons: true,
                    allowEnterKey: true,
                    allowEscapeKey: true,
                    allowOutsideClick: false,
                    backdrop: true,
                    focusConfirm: false,  // ✅ Don't auto-focus
                    focusCancel: false,

                    didOpen: () => {
                        // ✅ 2. MULTIPLE focus attempts on confirm button
                        const confirmBtn = document.querySelector('.swal2-confirm');

                        const focusBtn = () => {
                            if (confirmBtn) {
                                confirmBtn.focus();
                            }
                        };

                        focusBtn();
                        setTimeout(focusBtn, 50);
                        setTimeout(focusBtn, 100);
                    },

                    // ✅ 3. RE-ENABLE after close
                    didClose: () => {
                        if (mobileInput) {
                            mobileInput.removeAttribute('disabled');
                        }
                    }
                }).then((result) => {
                    // ✅ Re-enable before callback
                    if (mobileInput) {
                        mobileInput.removeAttribute('disabled');
                    }

                    callback(result.isConfirmed === true);
                });
            } else {
                // Fallback
                callback(confirm('Changing mobile number will clear all items and calculations. Continue?'));
            }
        }
        // GLOBAL: Block background keyboard events when SweetAlert is visible
        document.addEventListener('keydown', function (e) {
            // Check if SweetAlert is open
            if (typeof Swal !== 'undefined' && Swal.isVisible()) {
                const target = e.target;

                // If event is NOT from SweetAlert buttons, block it
                if (!target.classList.contains('swal2-confirm') &&
                    !target.classList.contains('swal2-cancel') &&
                    !target.closest('.swal2-container')) {

                    // Allow only specific keys
                    const allowedKeys = ['Enter', 'Escape', 'Tab', 'ArrowLeft', 'ArrowRight', 'Space'];

                    if (!allowedKeys.includes(e.key)) {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                    }
                }
            }
        }, true); // ✅ IMPORTANT: Use capture phase
    </script>
    <script>
        function applyTabletWiseMode(row) {
            const qtyInput = row.find(".qty");
            const tabletQtyInput = row.find(".tablet-qty");

            if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                // TabletWise: Qty disable, TabletQty enable
                qtyInput.prop("readonly", true).css("background-color", "#e9ecef");
                tabletQtyInput.prop("readonly", false).css("background-color", "#fff");
            } else {
                // StripWise: Qty enable, TabletQty disable + hide
                qtyInput.prop("readonly", false).css("background-color", "#fff");
                tabletQtyInput.prop("readonly", true).val("0").css("background-color", "#e9ecef");
            }
        }

        // // Q.TABLET INPUT HANDLER
        // $(document).on("input", ".tablet-qty", function () {
        //     if (!isTabletWiseMode) return;

        //     debugger;
        //     const row = $(this).closest("tr");
        //     const itemId = row.find(".item-id").val();

        //     // Get conversion
        //     let conversion = parseFloat(row.attr("data-conversion"));

        //     if (!conversion || conversion <= 0) {
        //         conversion = itemConversionMap[itemId] || 1;
        //     }

        //     console.log("Input - Conversion:", conversion);

        //     let tabletQty = parseFloat($(this).val()) || 0;

        //     // Calculate strips
        //     let strips = Math.floor(tabletQty / conversion);

        //     console.log("TabletQty:", tabletQty, "Strips:", strips);

        //     // Update Qty field
        //     row.find(".qty").val(strips);

        //     // Recalculate row
        //     calculateRow(row);
        // });
        $(document).on("input", ".tablet-qty", function () {
            if (!isTabletWiseMode) return;

            const row = $(this).closest("tr");
            const itemId = row.find(".item-id").val();

            // Get conversion
            let conversion = parseFloat(row.attr("data-conversion"));

            if (!conversion || conversion <= 0) {
                conversion = itemConversionMap[itemId] || 1;
            }

            console.log("Input - Conversion:", conversion);

            let tabletQty = parseFloat($(this).val()) || 0;

            // ✅ STEP 1: Calculate strips
            let strips = Math.floor(tabletQty / conversion);

            // ✅ STEP 2: Calculate REMAINING tablets (modulo)
            let remainingTablets = tabletQty % conversion;

            console.log("TabletQty:", tabletQty, "→ Strips:", strips, "Remaining Tabs:", remainingTablets);

            // ✅ STEP 3: Update BOTH fields
            row.find(".qty").val(strips);
            $(this).val(remainingTablets); // ✅ CRITICAL: Apply modulo immediately

            // ✅ STEP 4: Now validate with correct values
            validateQtyPure($(this));

            // ✅ STEP 5: Recalculate row
            calculateRow(row);
        });

        $(document).on("blur", ".tablet-qty", function () {
            if (!isTabletWiseMode) return;

            const row = $(this).closest("tr");
            const itemId = row.find(".item-id").val();

            let conversion = parseFloat(row.attr("data-conversion"));
            if (!conversion || conversion <= 0) {
                conversion = itemConversionMap[itemId] || 1;
            }

            let tabletQty = parseFloat($(this).val()) || 0;

            // Show only remaining tablets (modulo)
            let remainingTablets = tabletQty % conversion;

            console.log("Blur - Remaining:", remainingTablets);

            $(this).val(remainingTablets);

            // ✅ Validate AFTER ensuring correct value
            validateQtyPure($(this));

            // RE-CALCULATE ROW
            calculateRow(row);
        });
    </script>
    <script>
        // ================================================================
        // 🔹 Q.TABLET FIELD NAVIGATION (TabletWise Mode)
        // ================================================================
        $(document).on("keydown", ".tablet-qty", function (e) {
            const row = $(this).closest("tr");
            const input = $(this);

            // ENTER KEY HANDLER
            if (e.key === "Enter") {
                e.preventDefault();

                // Move to Rate field
                row.find(".qty").focus().select();
                return;
            }

            // ARROW RIGHT
            if (e.key === "ArrowRight") {
                e.preventDefault();
                row.find(".rate").focus().select();
                return;
            }

            // ARROW LEFT
            if (e.key === "ArrowLeft") {
                e.preventDefault();
                row.find(".mrp").focus().select();
                return;
            }

            // ARROW DOWN
            if (e.key === "ArrowDown") {
                e.preventDefault();
                const nextRow = row.next("tr");
                if (!nextRow.length) return;
                nextRow.find(".tablet-qty").focus().select();
                return;
            }

            // ARROW UP
            if (e.key === "ArrowUp") {
                e.preventDefault();
                const prevRow = row.prev("tr");
                if (!prevRow.length) return;
                prevRow.find(".tablet-qty").focus().select();
            }
        });
    </script>
    <script>
        $(document).on("keydown", function (e) {
            // F10 pressed
            if (e.key === "F10") {

                // ❌ Browser refresh band
                e.preventDefault();
                e.stopImmediatePropagation();

                // ❌ Agar koi modal open hai to kuch mat karo
                if ($(".modal.show").length > 0) return;

                $("#refreshBtn").trigger("click");
            }

            // F11 pressed
            if (e.key === "F11") {

                // ❌ Browser refresh band
                e.preventDefault();
                e.stopImmediatePropagation();

                // ❌ Agar koi modal open hai to kuch mat karo
                if ($(".modal.show").length > 0) return;

                $("#btnCancel").trigger("click");
            }
        });

        function confirmCancel(callback) {
            Swal.fire({
                title: 'Confirm Cancel?',
                text: 'Changes will be lost. Do you want to cancel?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: '❌ Yes, Cancel',
                cancelButtonText: '↩ No, Stay',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                reverseButtons: true
            }).then((result) => {
                callback(result.isConfirmed);
            });
        }

        $("#btnCancel").on("click", function (e) {
            e.preventDefault();

            confirmCancel(function (isConfirmed) {
                if (isConfirmed) {
                    window.location.href = $("#btnCancel").attr("href");
                }
            });
        });

        $(document).on("click", "#refreshBtn", function () {
            Swal.fire({
                title: 'Refresh Page?',
                html: `
                    <p class="text-danger mb-2">⚠️ Any unsaved changes will be lost!</p>
                    <p class="mb-0">All items, payments, and customer details will be cleared.</p>
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '🔄 Yes, Refresh',
                cancelButtonText: '❌ No, Stay',
                reverseButtons: true,
                customClass: {
                    confirmButton: 'btn btn-primary',
                    cancelButton: 'btn btn-secondary'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // Show loader while refreshing
                    showLoader("Refreshing page...");
                    location.reload();
                }
            });
        });
    </script>

