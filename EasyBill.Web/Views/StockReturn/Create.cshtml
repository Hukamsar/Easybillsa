                    PhoneNo: $('#newDoctorForm [name="PhoneNo"]').val(),
                    Address: $('#newDoctorForm [name="Address"]').val(),
                    RegistrationNo: $('#newDoctorForm [name="RegistrationNo"]').val(),
                    Specialized: $('#newDoctorForm [name="Specialized"]').val(),
                    Commission: parseFloat($('#newDoctorForm [name="Commission"]').val()) || 0
                };

                showLoader("Creating doctor...");

                $.ajax({
                    url: '/PharmacyDoctor/CreateDoctor',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function (res) {
                        hideLoader();
                        if (res.success) {
                            $('#DoctorId').val(res.data.id);
                            $('#doctorname').val(res.data.name);
                            $('#doctorregno').val(res.data.registrationNo);
                            $('#createDoctorModal').modal('hide');
                            toastr.success("Doctor created and assigned.");
                        } else {
                            toastr.error("Doctor not created.");
                        }
                    },
                    error: function () {
                        hideLoader();
                        toastr.error("Error saving doctor.");
                    }
                });
            });

            // ================================================================
            // 🔹 STEP 5: GRID EVENTS
            // ================================================================

            $("#addRow").click(function () {
                addNewRow();
            });

            $(document).on("keydown", ".item-input", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    const row = $(this).closest("tr");
                    currentRowForItemModal = row;
                    const typedText = $(this).val().trim();
                    openItemModal(typedText);
                }
            });

            $(document).on("input", ".qty", function () {
                validateQtyPure($(this));
            });

            $(document).on("focus", ".qty", function () {
                if ($(this).val()) {
                    validateQtyPure($(this));
                }
            });

            $(document).on('input', '.expirydate', function () {
                formatExpiryDate(this);
            });

            $(document).on("input", ".discount", function () {
                let row = $(this).closest("tr");
                calculateRow(row);
            });

            $("#discountPercent, #discountamount").on("input", function () {
                calculateTotalSummary();
            });

            $(document).on("click", ".remove-row-btn", function () {
                $(this).closest("tr").remove();
                calculateTotalSummary();
                toggleAddRowButton();
            });

            // ================================================================
            // 🔹 STEP 6: FORM SUBMIT
            // ================================================================

            $("form").submit(function (e) {
                const form = this;
               
                $("#employeeId").prop("disabled", false);

                $("#StockReturnItemBody .discount").each(function() {
                    if (!$(this).val() || $(this).val().trim() === '') {
                        $(this).val('0');
                    }
                });

                if (!$("#discountPercent").val() || $("#discountPercent").val().trim() === '') {
                    $("#discountPercent").val('0');
                }

                if (!$("#discountamount").val() || $("#discountamount").val().trim() === '') {
                    $("#discountamount").val('0');
                }

                toastr.options = {
                    closeButton: true,
                    progressBar: true,
                    positionClass: "toast-top-right",
                    timeOut: 3000,
                    extendedTimeOut: 1000,
                    preventDuplicates: true
                };

                const mobile = $("#mobilenumber").val()?.trim();
                const customerName = $("#customer").val()?.trim();
                const billingType = $("#billingType").val();

                if (billingType === "registered") {

                    if (!mobile) {
                        e.preventDefault();
                        toastr.error("Mobile number is required.", "Mobile Required");
                        $("#mobilenumber").focus().select();
                        return false;
                    }
                
                    if (!customerName) {
                        e.preventDefault();
                        toastr.error("Customer name is required.", "Customer Required");
                        $("#customer").focus().select();
                        return false;
                    }
                
                    if (!isValidIndianMobile(mobile)) {
                        e.preventDefault();
                        toastr.error("Please enter a valid 10-digit mobile number.", "Invalid Mobile Number");
                        $("#mobilenumber").focus().select();
                        return false;
                    }
                }
                 
                // if (!mobile) {
                //     e.preventDefault();
                //     toastr.error("Mobile number is required.", "Mobile Required");
                //     $("#mobilenumber").focus().select();
                //     return false;
                // }

                // if (!customerName) {
                //     e.preventDefault();
                //     toastr.error("Customer name is required.", "Customer Required");
                //     $("#mobilenumber").focus().select();
                //     return false;
                // }

                // if (!isValidIndianMobile(mobile)) {
                //     e.preventDefault();
                //     toastr.error("Please enter a valid 10-digit mobile number.", "Invalid Mobile Number");
                //     $("#mobilenumber").focus().select();
                //     return false;
                // }

                let hasValidItemRow = false;
                let firstZeroQtyRow = null;
                let firstIncompleteRow = null;

                // $("#StockReturnItemBody tr").each(function () {
                //     const row = $(this);
                //     const itemId = row.find(".item-id").val();
                //     const qty = parseFloat(row.find(".qty").val()) || 0;
                //     const batch = row.find(".batch").val();

                //     if ((!itemId && !firstIncompleteRow) || (itemId && (!batch || batch.trim() === "") && !firstIncompleteRow)) {
                //         firstIncompleteRow = row;
                //     }

                //     if (itemId && qty <= 0 && !firstZeroQtyRow) {
                //         firstZeroQtyRow = row;
                //     }

                //     if (itemId && qty > 0) {
                //         hasValidItemRow = true;
                //     }
                // });

                $("#StockReturnItemBody tr").each(function () {
                    const row = $(this);
                    const itemId = row.find(".item-id").val();
                    const batch = row.find(".batch").val();
                
                    // CHECK INCOMPLETE ROWS (Item but no Batch)
                    if ((!itemId && !firstIncompleteRow) || (itemId && (!batch || batch.trim() === "") && !firstIncompleteRow)) {
                        firstIncompleteRow = row;
                    }
                
                    // TABLET-WISE QTY VALIDATION
                    let isValidQty = false;
                
                    if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                        const qty = parseFloat(row.find(".qty").val()) || 0;
                        const qtyTabs = parseFloat(row.find(".tablet-qty").val()) || 0;
                
                        // Valid if EITHER Qty > 0 OR TabletQty > 0
                        if (qty > 0 || qtyTabs > 0) {
                            isValidQty = true;
                        }
                
                        // Check for negative values
                        if (qty < 0 || qtyTabs < 0) {
                            isValidQty = false;
                        }
                
                        // Store first invalid row
                        if (!isValidQty && itemId && batch && !firstZeroQtyRow) {
                            firstZeroQtyRow = row;
                        }
                    } else {
                        // STRIP-WISE: Qty must be >= 1
                        const qty = parseFloat(row.find(".qty").val()) || 0;
                
                        if (qty >= 1) {
                            isValidQty = true;
                        }
                
                        // Store first invalid row
                        if (!isValidQty && itemId && batch && !firstZeroQtyRow) {
                            firstZeroQtyRow = row;
                        }
                    }
                
                    // ✅ CHECK IF ROW IS VALID (has item, batch, and valid qty)
                    if (itemId && batch && isValidQty) {
                        hasValidItemRow = true;
                    }
                });


                if (firstIncompleteRow) {
                    e.preventDefault();
                    toastr.error("Please complete or remove all item rows before saving.", "Incomplete Item Row");
                    firstIncompleteRow.find(".item-input").focus();
                    return false;
                }

                // ERROR: INVALID QTY
                if (firstZeroQtyRow) {
                    e.preventDefault();
                
                    if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                        const qty = parseFloat(firstZeroQtyRow.find(".qty").val()) || 0;
                        const qtyTabs = parseFloat(firstZeroQtyRow.find(".tablet-qty").val()) || 0;
                
                        if (qty < 0 || qtyTabs < 0) {
                            toastr.error(
                                "Quantity cannot be negative. Please enter valid quantity.",
                                "Invalid Quantity"
                            );
                
                            if (qty < 0) {
                                firstZeroQtyRow.find(".qty").focus().select();
                            } else {
                                firstZeroQtyRow.find(".tablet-qty").focus().select();
                            }
                        } else if (qty === 0 && qtyTabs === 0) {
                            toastr.error(
                                "Please enter at least 1 strip or tablet.",
                                "Quantity Required"
                            );
                
                            firstZeroQtyRow.find(".tablet-qty").focus().select();
                        }
                    } else {
                        toastr.error(
                            "Quantity cannot be less than 1. Please enter valid quantity.",
                            "Invalid Quantity"
                        );
                
                        firstZeroQtyRow.find(".qty").focus().select();
                    }
                
                    return false;
                }

                // if (firstZeroQtyRow) {
                //     e.preventDefault();
                //     toastr.error("Quantity cannot be less than 1. Please enter valid quantity.", "Invalid Quantity");
                //     firstZeroQtyRow.find(".qty").focus().select();
                //     return false;
                // }

                if (!hasValidItemRow) {
                    e.preventDefault();
                    toastr.error("Please add at least one item with quantity before saving.", "Item Required");
                    return false;
                }

                if (!$(form).data('confirmed')) {
                    e.preventDefault();

                    confirmSave(function(ok) {
                        if (!ok) return;

                        showLoader("Saving stock return...");

                        $.ajax({
                            type: "POST",
                            url: $(form).attr("action"),
                            data: $(form).serialize(),
                            success: function(response) {
                                hideLoader();

                                if (response && response.success === false) {
                                    toastr.error(response.message || "Save failed! Please try again.", "Error");
                                    return;
                                }

                                toastr.success("Stock return saved successfully!", "Success");

                                setTimeout(() => {
                                    window.location.href = "/StockReturn/Index";
                                }, 500);
                            },
                            error: function(xhr, status, error) {
                                hideLoader();
                                console.error("Save Error:", xhr, error);

                                let errorMessage = "An error occurred while saving. Please try again.";

                                if (xhr.responseJSON && xhr.responseJSON.message) {
                                    errorMessage = xhr.responseJSON.message;
                                } else if (xhr.responseText) {
                                    try {
                                        const response = JSON.parse(xhr.responseText);
                                        errorMessage = response.message || errorMessage;
                                    } catch (e) {
                                        errorMessage = xhr.statusText || errorMessage;
                                    }
                                }

                                toastr.error(errorMessage, "Validation Error");
                            }
                        });
                    });

                    return false;
                }
            });

            // ================================================================
            // 🔹 STEP 7: DISCOUNT INITIALIZATION
            // ================================================================

            var percentInput = $("#discountPercent");
            if (parseFloat(percentInput.val()) === 0) {
                percentInput.val(0);
            }
        });
    </script>

    <script>
        /* ============================================================
           🚀 KEYBOARD NAVIGATION
           ============================================================ */

        // Header fields navigation
        $(document).on("keydown",
            "#ChallanNo, #ChallanDate, #mobilenumber, #customer, #customeraddress, #doctorMobile, #doctorname, #doctorregno",
            function (e) {

                if (e.key !== "Enter") return;
                e.preventDefault();

                const id = this.id;

                switch (id) {
                    case "ChallanNo":
                        $("#ChallanDate").focus();
                        break;

                    // case "ChallanDate":
                    //     $("#mobilenumber").focus();
                    //     break;

                    case "mobilenumber":
                        if (!isValidIndianMobile(this.value)) {
                            this.focus();
                            return;
                        }
                        setTimeout(() => {
                            $("#customer").focus();
                        }, 50);
                        break;

                    case "customer":
                        $("#customeraddress").focus();
                        break;

                    case "customeraddress":
                        if ($("#doctorMobile").length && $("#doctorMobile").is(":visible") && !$("#doctorMobile").is(":disabled")) {
                            $("#doctorMobile").focus();
                        } else {
                           focusItemGridOrAddRow();
                          // focusItemGrid();
                        }
                        break;

                    case "doctorMobile":
                        $("#doctorname").focus();
                        break;

                    case "doctorname":
                        $("#doctorregno").focus();
                        break;

                    case "doctorregno":
                        handleRegistrationEnter();
                       // focusItemGrid();
                        break;
                }
            }
        );
       
        function handleRegistrationEnter() {
            const customerId = $("#CustomerId").val();
            const customerName = $("#customer").val().trim();

            if (!customerId || !customerName) {
                toastr.error("Please select or create a valid customer first.");
                $("#mobilenumber").focus();
                return;
            }

            focusItemGridOrAddRow();
        }

        function focusItemGridOrAddRow() {
            setTimeout(() => {
                const existingRows = $("#StockReturnItemBody tr").length;

                if (existingRows > 0) {
                    $("#StockReturnItemBody tr:first .item-input").focus();
                } else {
                    addNewRow();

                    setTimeout(() => {
                        $("#StockReturnItemBody tr:first .item-input").focus();
                    }, 150);
                }
            }, 100);
        }

        // Item input navigation
        $(document).on("keydown", ".item-input", function (e) {
            const row = $(this).closest("tr");

            if (e.key === "ArrowRight") {
                e.preventDefault();
                row.find(".mrp").focus().select();
                return;
            }

            if (e.key === "ArrowDown") {
                e.preventDefault();
                const nextRow = row.next("tr");
                if (nextRow.length) {
                    nextRow.find(".item-input").focus();
                }
                return;
            }

            if (e.key === "ArrowUp") {
                e.preventDefault();
                const prevRow = row.prev("tr");
                if (prevRow.length) {
                    prevRow.find(".item-input").focus();
                } else {
                    $("#customeraddress").focus();
                }
            }
        });
         $(document).on("input", ".stripe-rate", function () {
                let row = $(this).closest("tr");

                let stripRate = parseFloat($(this).val()) || 0;

                const itemId = row.find(".item-id").val();
                let conversion = parseFloat(row.attr("data-conversion"));

                if (!conversion || conversion <= 0) {
                    conversion = itemConversionMap[itemId] || 1;
                }

                // 👇 reverse calculation
                let tabletRate = stripRate / conversion;

                // 👇 actual rate update karo (hidden field)
                row.find(".rate").val(tabletRate.toFixed(4));

                // 🔥 recalculation trigger
                calculateRow(row);
         });
        // Item grid fields navigation
        $(document).on("keydown", ".mrp, .qty, .tablet-qty, .stripe-rate, .discount, .reason", function (e) {
            const row = $(this).closest("tr");
            const input = $(this);

            const isMrp = input.hasClass("mrp");
            const isQty = input.hasClass("qty");
            const isTabletQty = input.hasClass("tablet-qty");
            const isDiscount = input.hasClass("discount");
            const isReason = input.hasClass("reason");

            // ================================================================
            // 🔹 ENTER KEY NAVIGATION
            // ================================================================
            if (e.key === "Enter") {
                e.preventDefault();

                if (isMrp) {
                    // MRP → TabletQty (TabletWise) or Qty (StripWise)
                    if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                        row.find(".tablet-qty").focus().select();
                    } else {
                        row.find(".qty").focus().select();
                    }
                }
                else if (isTabletQty) {
                    // TabletQty → Discount (skip readonly Qty)
                    row.find(".discount").focus().select();
                }
                else if (isQty) {
                    // Qty → Discount
                    row.find(".discount").focus().select();
                }
                else if (isDiscount) {
                    // Discount → Reason
                    row.find(".reason").focus().select();
                }
                else if (isReason) {
                    // Reason → Validation and Next Row Logic
                    const itemId = row.find(".item-id").val();
                    const batch = row.find(".batch").val();

                    if (!itemId || !batch) {
                        toastr.warning("Please select Item and Batch before adding new row.");
                        if (!itemId) {
                            row.find(".item-input").focus();
                        } else if (!batch) {
                            row.find(".item-input").focus();
                        }
                        return;
                    }

                    // Validate quantity
                    const $qtyInput = row.find(".qty");
                    const qty = parseFloat($qtyInput.val()) || 0;

                    if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                        const $qtyTabsInput = row.find(".tablet-qty");
                        const qtyTabs = parseFloat($qtyTabsInput.val()) || 0;

                        if (qty === 0 && qtyTabs === 0) {
                            toastr.warning("Please enter quantity or tablet quantity.");
                            $qtyTabsInput.focus().select();
                            return;
                        }

                        if (qty < 0 || qtyTabs < 0) {
                            toastr.warning("Quantity cannot be negative.");
                            (qty < 0 ? $qtyInput : $qtyTabsInput).focus().select();
                            return;
                        }
                    } else {
                        if (qty < 1) {
                            toastr.warning("Quantity cannot be less than 1.");
                            $qtyInput.focus().select();
                            validateQtyPure($qtyInput);
                            return;
                        }
                    }

                    // Add new row or go to next
                    const isLastRow = row.is("#StockReturnItemBody tr:last");

                    if (isLastRow) {
                        addNewRow();
                        setTimeout(() => {
                            $("#StockReturnItemBody tr:last .item-input").focus();
                        }, 150);
                    } else {
                        const nextRow = row.next("tr");
                        if (nextRow.length) {
                            nextRow.find(".item-input").focus();
                        }
                    }
                }

                return;
            }

            // ================================================================
            // 🔹 ARROW RIGHT NAVIGATION
            // ================================================================
            if (e.key === "ArrowRight") {
                e.preventDefault();

                if (isMrp) {
                    // MRP → TabletQty (TabletWise) or Qty (StripWise)
                    if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                        row.find(".tablet-qty").focus().select();
                    } else {
                        row.find(".qty").focus().select();
                    }
                }
                else if (isTabletQty) {
                    // TabletQty → Discount
                    row.find(".discount").focus().select();
                }
                else if (isQty) {
                    // Qty → Discount
                    row.find(".discount").focus().select();
                }
                else if (isDiscount) {
                    // Discount → Reason
                    row.find(".reason").focus().select();
                }

                return;
            }

            // ================================================================
            // 🔹 ARROW LEFT NAVIGATION
            // ================================================================
            if (e.key === "ArrowLeft") {
                e.preventDefault();

                if (isReason) {
                    // Reason → Discount
                    row.find(".discount").focus().select();
                }
                else if (isDiscount) {
                    // Discount → TabletQty (TabletWise) or Qty (StripWise)
                    if (@ViewBag.BusinessType === 2 && isTabletWiseMode === true) {
                        row.find(".tablet-qty").focus().select();
                    } else {
                        row.find(".qty").focus().select();
                    }
                }
                else if (isTabletQty) {
                    // TabletQty → MRP
                    row.find(".mrp").focus().select();
                }
                else if (isQty) {
                    // Qty → MRP
                    row.find(".mrp").focus().select();
                }
                else if (isMrp) {
                    // MRP → Item
                    row.find(".item-input").focus();
                }

                return;
            }

            // ================================================================
            // 🔹 ARROW DOWN NAVIGATION
            // ================================================================
            if (e.key === "ArrowDown") {
                e.preventDefault();
                const nextRow = row.next("tr");
                if (!nextRow.length) return;

                if (isMrp) {
                    nextRow.find(".mrp").focus().select();
                }
                else if (isTabletQty) {
                    nextRow.find(".tablet-qty").focus().select();
                }
                else if (isQty) {
                    nextRow.find(".qty").focus().select();
                }
                else if (isDiscount) {
                    nextRow.find(".discount").focus().select();
                }
                else if (isReason) {
                    nextRow.find(".reason").focus().select();
                }

                return;
            }

            // ================================================================
            // 🔹 ARROW UP NAVIGATION
            // ================================================================
            if (e.key === "ArrowUp") {
                e.preventDefault();
                const prevRow = row.prev("tr");
                if (!prevRow.length) return;

                if (isMrp) {
                    prevRow.find(".mrp").focus().select();
                }
                else if (isTabletQty) {
                    prevRow.find(".tablet-qty").focus().select();
                }
                else if (isQty) {
                    prevRow.find(".qty").focus().select();
                }
                else if (isDiscount) {
                    prevRow.find(".discount").focus().select();
                }
                else if (isReason) {
                    prevRow.find(".reason").focus().select();
                }
            }
        });

        // TAB KEY FUNCTIONALITY - Reference Code Pattern
        $(document).on("keydown", ".item-input, .mrp, .qty, .discount, .reason", function (e) {
            if (e.key !== "Tab") return;

            const row = $(this).closest("tr");

            const itemId = row.find(".item-id").val();
            const batch = row.find(".batch").val()?.trim();

            const isBlankRow =
                (!itemId || itemId === "") &&
                (!batch || batch === "")

            if (!isBlankRow) return;

            const totalRows = $("#StockReturnItemBody tr").length;

            if (totalRows <= 1) {
                e.preventDefault();
                toastr.error("At least one item row is required", "Validation Error");
                return;
            }

            e.preventDefault();
            row.remove();

            setTimeout(() => {
                $("#discountPercent").focus().select();
            }, 50);
        });

        // Total fields navigation
        $(document).on("keydown", "[name='Total']", function (e) {
            if (["Enter", "ArrowRight", "ArrowDown"].includes(e.key)) {
                e.preventDefault();
                $("#discountPercent").focus().select();
            }
        });

        $(document).on("keydown", "#discountPercent", function (e) {
            if (["Enter", "ArrowRight", "ArrowDown"].includes(e.key)) {
                e.preventDefault();
                $("#discountamount").focus().select();
                return;
            }

            if (["ArrowLeft", "ArrowUp"].includes(e.key)) {
                e.preventDefault();
                $("[name='Total']").focus().select();
            }
        });

        $(document).on("keydown", "#discountamount", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                calculateTotalSummary();
                return;
            }

            if (["ArrowLeft", "ArrowUp"].includes(e.key)) {
                e.preventDefault();
                $("#discountPercent").focus().select();
            }
        });

        // End key save
        $(document).on("keydown", function (e) {
            if (e.key !== "End") return;

            if ($(".modal.show").length > 0) return;

            const active = document.activeElement;
            if (active &&
                (active.tagName === "TEXTAREA" ||
                 active.getAttribute("contenteditable") === "true")) {
                return;
            }

            e.preventDefault();
            e.stopPropagation();

            const $saveBtn = $("form button[type='submit']:visible:first");

            if ($saveBtn.length) {
                console.log("End key → Save button click");
                $saveBtn.trigger("click");
            }
        });
    </script>

