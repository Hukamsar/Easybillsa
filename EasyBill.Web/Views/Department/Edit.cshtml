@model EasyBill.Models.ViewModels.DepartmentVM
@{
    ViewData["Title"] = "Edit Department";
}

<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }
</style>



<div class="container mt-4">
    <div class="card shadow-sm">
            <div class="card-header text-white py-2" style="background-color: #2b6ac9 !important;">
                Edit Department
        </div>
        <div class="card-body">
            <form asp-action="Edit" id="DepartmentEditForm">
                <input type="hidden" asp-for="Id" id="departmentId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="col-md-6 d-flex align-items-center mb-2">
                        <label asp-for="Name" class="me-2 mb-0" style="width: 100px;">
                            Name
                            <i class="text-danger">*</i>
                        </label>
                        <input type="text" id="name" asp-for="Name" class="form-control form-control-sm" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                    <span id="nameMessage" class="text-danger"></span>

                </div>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-primary btnBright-Sky-Blue">Submit</button>
                    <a asp-controller="Department" asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script>
    $(document).ready(function () {
        $("#name").on("blur", function () {
            var name = $(this).val().trim();
            var departmentid = $("departmentId").val();
            if (name === "") return;
            $.ajax({
                url: '/Department/ExistName',
                type: 'GET',
                data: { name: name, id: departmentid  },
                success: function (response) {
                    if (response.exists) {
                        $("#nameMessage").text(name + " is already exist.");
                        //$("#name").val('').focus();
                    } else {
                        $("#name").text('');
                    }
                },
                error: function () {
                    $("#nameMessage").text("An error occurred. Please try again.");
                }
            });
        });
    });
</script>
<script>
    $(document).ready(function () {

        $("#DepartmentEditForm").on("submit", function (e) {
            e.preventDefault();
            let form = this;

            Swal.fire({
                title: 'Confirm Update?',
                text: 'Do you want to update this Department?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Update',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#198754',
                cancelButtonColor: '#dc3545',
                reverseButtons: true,
                focusConfirm: true,
                buttonsStyling: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $("#DepartmentEditForm").off("submit"); // loop avoid
                    form.submit();
                }
            });

        });

    });
</script>
@if (TempData["success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: '@TempData["success"]',
            confirmButtonText: 'OK',
            confirmButtonColor: '#2b6ac9'
        });
    </script>
}