@model EasyBill.Models.ViewModels.CompanyVM
@{
    ViewData["Title"] = "Create";
}

<style>
    table.dataTable thead th {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    .card-header {
        background-color: #2b6ac9 !important;
        color: white !important;
    }

    /* SweetAlert Button Common Style */
    .swal2-confirm,
    .swal2-cancel {
        border-radius: 8px !important;
        padding: 8px 20px !important;
        font-weight: 500 !important;
        transition: all 0.25s ease-in-out !important;
        margin: 0 8px !important; /* 👈 Space between buttons */
    }

        /* Confirm Hover */
        .swal2-confirm:hover {
            background-color: #157347 !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(25, 135, 84, 0.4);
        }

        /* Cancel Hover */
        .swal2-cancel:hover {
            background-color: #bb2d3b !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(220, 53, 69, 0.4);
        }

        /* Focus Effect */
        .swal2-confirm:focus,
        .swal2-cancel:focus {
            outline: none !important;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.4) !important;
        }
</style>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-Cardheader" style="background-color: #2b6ac9 !important;">
            Edit Company
        </div>
        <div class="card-body">

            <form asp-action="Edit" id="companyEditForm">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-4 d-flex align-items-center mb-2">
                        <label asp-for="Name" class="me-2 mb-0" style="width: 100px;">
                            Name
                            <span class="text-danger">*</span>
                        </label>
                        <input type="text" asp-for="Name" class="form-control form-control-sm" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="submit" class="btn btn-sm btn-primary">Submit</button>
                    <a asp-controller="Company" asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        $("#companyEditForm").on("submit", function (e) {

            e.preventDefault();
            let form = this;

            Swal.fire({
                title: 'Confirm Update?',
                text: 'Do you want to update this Country?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Update',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#198754',
                cancelButtonColor: '#dc3545',
                reverseButtons: true,
                focusConfirm: true,
                buttonsStyling: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $("#companyEditForm").off("submit"); // ✅ loop avoid
                    form.submit();
                }
            });

        });

    });
</script>

@if (TempData["success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: '@TempData["success"]',
            confirmButtonText: 'OK',
            confirmButtonColor: '#2b6ac9'
        });
    </script>
}